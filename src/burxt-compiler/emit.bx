// ============================================================================
// emit.bx — part of the Burxt compiler, written in Burxt.
//
// Textual LLVM IR. The runtime is emitted into every module, so a Burxt program needs
// nothing on the machine but a C library.
//
// Assembled by src/burxt-compiler/main.bx, which is the program; everything here is
// declarations, which is what a module may hold.
// ============================================================================

// =============================================================================
// PHASE 5: the backend. Textual LLVM IR, for the reason M4 §1 gives — an
// `external function` returns an Int or a CInt, never a pointer whose ownership Burxt
// cannot describe, so an LLVMBuilderRef is unreachable BY CONSTRUCTION. Emitting
// text is not a workaround: it is string formatting instead of an API, and the
// output is readable, diffable and testable without a debugger.
//
// Slice 1 covers Ints, Bools, String literals, arithmetic with the overflow
// checks the thesis requires, comparisons, `if`, `while`, `break`, `continue`,
// functions, calls and `print`. Decimals, regions and aggregates follow; what is
// not covered is refused by name rather than emitted wrongly.
// =============================================================================

// A local. For a scalar the alloca holds the value; for an aggregate the alloca IS the
// storage and the value is its address.
//
// `aggregate` means "the alloca IS the storage", recorded rather than inferred from
// `cells`. A class with ONE field occupies one cell and is still a class — inferring it
// from the count loaded the field instead of passing the address, and a one-field record
// passed to a method segfaulted. A `mutable self` slot is the mirror case: one cell, holding
// someone else's address, so it reads by LOADING and is marked not-aggregate.
class Slot { start: Int, length: Int, index: Int, cells: Int, aggregate: Int }

// Two buffers per function, joined when it closes. Allocas MUST land in the entry
// block: an `alloca` inside a loop allocates again on every iteration, so a `let` in a
// `while` would grow the stack until it ran out. The entry block is the one place where
// "once per call" is guaranteed.
// The body accumulates in CHUNKS for the same reason the module does: `a += b` copies
// the whole left side, and a function body reaching a hundred kilobytes, appended to a
// hundred thousand times, copies gigabytes. Bounding each copy to the chunk size is what
// keeps the compiler inside its own region.
//
// The entry buffer stays a plain String: allocas are few and short, so it never grows
// enough for the quadratic term to matter.
function (mutable self: Unit) write_body(text: String) -> Int {
    self.body_pending += text;
    if len(self.body_pending) > 128 {
        push(self.body_chunks, self.body_pending);
        self.body_pending = "";
    }
    return 0;
}

// Module-level text — the declarations and the runtime — goes straight to the module,
// not through a function's buffer: `open_function` clears those, and a preamble written into
// one would be discarded when the first function opened.
// The module's text, in CHUNKS of 512 bytes.
//
// The arithmetic is right: with A appends into a buffer flushed at T bytes, the copying is
// about A x T/2, and joining the N/T chunks pairwise costs N per round for log2(N/T) rounds.
//
// **But the measurement that used to sit here was wrong, and it was wrong in the way that
// costs most — a real number attributed to the wrong cause.** It said *"T = 4096 spent about
// 600 MB and ran the region out; T = 512 spends about 95 MB."* Swept 64 -> 4096, the total
// moves by **3 MB** (182.0 / 182.2 / 182.3 / 180.6 / 185.0). This threshold is very nearly
// inert, because `close_function` already hands this function 512-byte pieces, so its appends
// are coarse and the flush almost never fires mid-piece.
//
// That 600 MB was **B29** — `self.globals`, a flat String appended once per string literal and
// quadratic in the literal count — being blamed on the nearest constant. It was measured
// honestly, written down confidently, and then reasoned from for many versions, including as
// evidence that only a large architectural change could reduce this compiler's memory. Chunking
// `globals` took peak RSS from 1,132 MB to 178.
//
// The tuning that DOES matter is `write_body`'s, which is a different function with fine-grained
// appends: 512 -> 128 there was worth 9 MB. Keep the number here; delete the claim.
// `a += b` copies the whole left side, so appending
// fifty thousand times to one growing String copies gigabytes — which is exactly how
// this compiler first exhausted its region while emitting its own source. Chunks bound
// each copy to the chunk size, and the joins at the end are few.
//
// The real fix is a byte buffer that grows in place, which needs a builtin that writes
// one. Recorded rather than pretended away: this is a cost, not a design.
function (mutable self: Unit) write_globals(text: String) -> Int {
    self.globals += text;
    if len(self.globals) > 512 {
        push(self.global_chunks, self.globals);
        self.globals = "";
    }
    return 0;
}

function (mutable self: Unit) finish_globals() -> String {
    if len(self.globals) > 0 {
        push(self.global_chunks, self.globals);
        self.globals = "";
    }
    if len(self.global_chunks) == 0 {
        return "";
    }
    while len(self.global_chunks) > 1 {
        let mutable merged: [String] = [];
        let mutable i: Int = 0;
        while i + 1 < len(self.global_chunks) {
            let pair: String = self.global_chunks[i] + self.global_chunks[i + 1];
            let added: Int = push(merged, pair);
            i += 2;
        }
        if i < len(self.global_chunks) {
            let last: Int = push(merged, self.global_chunks[i]);
        }
        self.global_chunks = merged;
    }
    return self.global_chunks[0];
}

function (mutable self: Unit) write_module(text: String) -> Int {
    self.pending += text;
    if len(self.pending) > 512 {
        push(self.chunks, self.pending);
        self.pending = "";
    }
    return 0;
}

// Joining the chunks PAIRWISE rather than one after another. Appending each chunk to a
// growing result copies the whole result every time — O(n²) in the output size, which is
// what exhausted a 1 GB region the moment the module grew past a megabyte. Merging pairs
// halves the count each round, so the total copying is O(n log n): about eleven megabytes
// for a 1.2 MB module instead of several hundred.
//
// The honest fix is still a byte buffer that grows in place, which needs a builtin that
// writes one. This buys the room to get there.
function (mutable self: Unit) finish() -> String {
    if len(self.pending) > 0 {
        push(self.chunks, self.pending);
        self.pending = "";
    }
    if len(self.chunks) == 0 {
        return "";
    }
    while len(self.chunks) > 1 {
        let mutable merged: [String] = [];
        let mutable i: Int = 0;
        while i + 1 < len(self.chunks) {
            let pair: String = self.chunks[i] + self.chunks[i + 1];
            let added: Int = push(merged, pair);
            i += 2;
        }
        if i < len(self.chunks) {
            let last: Int = push(merged, self.chunks[i]);
        }
        self.chunks = merged;
    }
    return self.chunks[0];
}

function (mutable self: Unit) write_entry(text: String) -> Int {
    self.function_entry += text;
    return 0;
}

function (mutable self: Unit) open_function(header: String) -> Int {
    self.function_entry = "";
    self.body_pending = "";
    self.body_chunks = [];
    return self.write_entry(header);
}

function (mutable self: Unit) close_function(closing: String) -> Int {
    let entry_written: Int = self.write_module(self.function_entry);
    let mutable i: Int = 0;
    while i < len(self.body_chunks) {
        let piece: Int = self.write_module(self.body_chunks[i]);
        i += 1;
    }
    let rest: Int = self.write_module(self.body_pending);
    let closed: Int = self.write_module(closing);
    self.function_entry = "";
    self.body_pending = "";
    self.body_chunks = [];
    return 0;
}

function (mutable self: Unit) fresh() -> String {
    self.next_register += 1;
    return "%t" + to_string(self.next_register);
}

function (mutable self: Unit) fresh_label(stem: String) -> String {
    self.next_label += 1;
    return stem + to_string(self.next_label);
}

// A local's alloca, named by its position in the table rather than by the source
// name, so two blocks that both say `x` cannot collide in the IR.
function (mutable self: Unit) declare_slot(src: String, start: Int, length: Int, cells: Int,
        aggregate: Int) -> Int {
    // The NAME comes from a counter that only grows, not from the table's length. A match
    // arm's bindings leave scope by truncating the table, so lengths repeat — and two
    // allocas called `%v3` in one function is not a program LLVM will accept.
    self.next_slot += 1;
    let index: Int = self.next_slot;
    push(self.slots, Slot { start: start, length: length, index: index, cells: cells,
            aggregate: aggregate });
    let visited: Int = self.write_entry("  %v" + to_string(index) + " = alloca ["
            + to_string(cells) + " x i64]\n");
    return index;
}

// Scratch storage for a value that has no name — a class literal, an array literal.
// In the entry block for the same reason every other alloca is.
function (mutable self: Unit) scratch(cells: Int) -> String {
    self.next_register += 1;
    let name: String = "%scratch" + to_string(self.next_register);
    let visited: Int = self.write_entry("  " + name + " = alloca [" + to_string(cells)
            + " x i64]\n");
    return name;
}

function (self: Unit) slot_is_aggregate(src: String, start: Int, length: Int) -> Bool {
    let mutable i: Int = len(self.slots) - 1;
    while i >= 0 {
        let slot: Slot = self.slots[i];
        if spans_equal(src, slot.start, slot.length, start, length) {
            return slot.aggregate == 1;
        }
        i -= 1;
    }
    return false;
}

// How many i64 cells a value of this type occupies. Everything a Burxt value can be is
// eight bytes wide or an aggregate of things that are — a String and a growable array
// are pointers, a Decimal is a scaled i64 — so a layout is a COUNT, and nothing here
// needs an alignment rule.
function (mutable self: Unit) cells_of(src: String, written: Type) -> Int {
    // A type parameter is whatever it was bound to, and a generic's fields are sized with its
    // ARGUMENTS in scope. Because a layout is a count and not a named LLVM type, nothing is
    // rewritten and no copy of the declaration is made: `Pair<Int>` is 2 cells and
    // `Pair<Point>` is 4 from the same declaration, read twice under different bindings.
    // The same laziness the checker found, applied to size.
    let bound_type: Type = self.resolve_shallow(src, written);
    if bound_type.kind == 46 {
        let found: Int = self.find_type(src, bound_type.name_start, bound_type.name_length);
        if found < 0 {
            return 1;
        }
        let decl: TypeDeclaration = self.types[found];
        let item: Node = self.nodes[decl.node];
        // Installed AFTER the two refusals above, so the only paths that bind are the two
        // that walk, and each of them restores before it answers.
        let restore: Int = self.bind_from_application(src, bound_type);
        if decl.kind == 83 {
            // An enum is a TAG plus room for the widest variant's payload. Every value of
            // the type is the same size, so one may be assigned where another was — which
            // is what makes a variant a value rather than a separate type.
            let mutable widest: Int = 0;
            let mutable v: Int = 0;
            while v < item.b {
                let variant: Node = self.nodes[self.children[item.a + v]];
                let mutable carried: Int = 0;
                let mutable p: Int = 0;
                while p < variant.c {
                    carried += self.cells_of(src, self.declared_type(src, self.nested_children[variant.b + p]));
                    p += 1;
                }
                if carried > widest { widest = carried; }
                v += 1;
            }
            let dropped: Int = truncate(self.type_bindings, restore);
            return 1 + widest;
        }
        if decl.kind != 82 {
            let dropped: Int = truncate(self.type_bindings, restore);
            return 1;
        }
        let mutable total: Int = 0;
        let mutable f: Int = 0;
        while f < item.b {
            let field: Node = self.nodes[self.children[item.a + f]];
            total += self.cells_of(src, self.declared_type(src, field.a));
            f += 1;
        }
        let dropped: Int = truncate(self.type_bindings, restore);
        return total;
    }
    if bound_type.kind == 48 {                               // [T; N]
        return bound_type.contract * self.cells_of(src, self.declared_type(src, bound_type.scale));
    }
    // A tuple is its elements laid end to end, in the order written — the same walk the
    // class branch above does over fields, with the positions standing in for the names.
    // Declaration-order layout is A4.5's rule and a tuple has no other order to choose.
    if bound_type.kind == 53 {
        let mutable total: Int = 0;
        let mutable e: Int = 0;
        while e < bound_type.contract {
            total += self.cells_of(src,
                    self.declared_type(src, self.nested_children[bound_type.scale + e]));
            e += 1;
        }
        return total;
    }
    if bound_type.kind == 49 {
        // An interface object is a FAT POINTER: the value, and the table of the interface's
        // methods. Two cells, always, whatever the concrete type behind it is — which is
        // what lets one `dynamic Priced` hold a Book today and a Meal tomorrow.
        return 2;
    }
    return 1;
}

// Where a field starts, in cells, and -1 when the holder has no such field. The walk is
// the same one `cells_of` does, which is why the two cannot disagree about a layout.
function (mutable self: Unit) offset_of(src: String, holder: Type, name: Token) -> Int {
    // A tuple: the position IS the name, so the walk sums the elements before it rather than
    // comparing spans. Same walk as below, same guarantee that layout and offset cannot
    // disagree — `cells_of` and this function step over the same list in the same order.
    if holder.kind == 53 {
        if name.kind != 2 || name.value < 0 || name.value >= holder.contract {
            return -1;
        }
        let mutable offset: Int = 0;
        let mutable e: Int = 0;
        while e < name.value {
            offset += self.cells_of(src,
                    self.declared_type(src, self.nested_children[holder.scale + e]));
            e += 1;
        }
        return offset;
    }
    let found: Int = self.find_type(src, holder.name_start, holder.name_length);
    if found < 0 {
        return -1;
    }
    let item: Node = self.nodes[self.types[found].node];
    let restore: Int = self.bind_from_application(src, holder);
    let mutable offset: Int = 0;
    let mutable f: Int = 0;
    let mutable answer: Int = 0 - 1;
    while f < item.b && answer < 0 {
        let field: Node = self.nodes[self.children[item.a + f]];
        let field_name: Token = self.tokens[field.token];
        if spans_equal(src, field_name.start, field_name.length, name.start, name.length) {
            answer = offset;
        } else {
            offset += self.cells_of(src, self.declared_type(src, field.a));
        }
        f += 1;
    }
    let dropped: Int = truncate(self.type_bindings, restore);
    return answer;
}

// A field's type with the holder's type ARGUMENTS in scope, so `Pair<Point>.first` is a Point
// and not a `T`. Without this the emitter asked whether a `T` was an aggregate, was told no,
// and stored the value's ADDRESS in the field instead of copying its cells — a class that
// looked the right size and held a pointer where a Point belonged. check.bx's record-literal
// rule does exactly this, which is the argument for it living in one named function.
function (mutable self: Unit) field_type_here(src: String, holder: Type, at: Int) -> Type {
    let base: Int = self.bind_from_application(src, holder);
    let stated: Type = self.field_type(src, holder, at);
    let settled: Type = self.resolve_deep(src, stated, at);
    let dropped: Int = truncate(self.type_bindings, base);
    return settled;
}

// Does a value of this type travel by ADDRESS rather than in a register? Resolved first, because
// a `T` is whatever it was bound to and the answer decides the calling convention.
//
// It did not resolve at first, and the bug that found was precise: a method returning `T` where
// `T = Point` did not set up an sret, while the CALL site — reading the checker's already-resolved
// type — passed a storage pointer as the first argument. The two halves of one call disagreeing
// about the shape of a function is not a wrong answer, it is a wrong frame.
function (self: Unit) is_aggregate_written(src: String, written: Type) -> Bool {
    return self.is_aggregate(self.resolve_shallow(src, written));
}

// `burxt.push`'s third argument, as the operand to write: "1" when a value of this type arrives
// as an ADDRESS, "0" when it arrives as itself. The same question `is_aggregate_written` answers
// for the reader, spelled once so a push and the `xs[i]` that reads it back cannot disagree.
function (self: Unit) by_ref_flag(src: String, element: Type) -> String {
    if self.is_aggregate_written(src, element) {
        return "1";
    }
    return "0";
}

// A tuple is 53, and it belongs here for the same reason a class does: its value IS its
// address, so a mention loads no cells and an assignment copies them. Leaving it out would
// not have been a missing feature — it would have stored the tuple's ADDRESS into a field
// sized for its cells, which is the exact miscompile `field_type_here` was written to stop.
function (self: Unit) is_aggregate(bound_type: Type) -> Bool {
    return bound_type.kind == 46 || bound_type.kind == 48 || bound_type.kind == 49
            || bound_type.kind == 53;
}

function (self: Unit) find_slot(src: String, start: Int, length: Int) -> Int {
    let mutable i: Int = len(self.slots) - 1;
    while i >= 0 {
        let slot: Slot = self.slots[i];
        if spans_equal(src, slot.start, slot.length, start, length) {
            return slot.index;
        }
        i -= 1;
    }
    return -1;
}

// Every byte as a hex escape. LLVM accepts c"\68\69\00", and emitting only escapes
// means no byte needs a character to stand for it — which matters in a language whose
// own `to_string` answers with digits, not letters.
// Join a chunk list into one String by repeated PAIRWISE merging — the same shape
// `finish` and `finish_globals` use, and for the same reason: folding left rebuilds the
// whole prefix on every step, which is the quadratic this exists to avoid.
//
// **B30.** Both string-interning loops built their hex escape with `body += hex_of(...)`,
// one byte at a time. That is quadratic in a SINGLE literal's length: 2,000 bytes cost
// 14 MB, 4,000 cost 32 MB, and 8,000 cost **103 MB for one literal**. It went unseen
// because the compiler's own longest literal is 223 bytes — but a user program embedding
// a 10 KB SQL schema, HTML template or JSON fixture pays about 150 MB for it, and a
// program that embeds one is what a real application looks like.
//
// Same defect as B29, one level down, and found while attributing that one. B29 only ever
// hurt this repository; this one is a cliff under anybody's feet.
function join_chunks(chunks: [String]) -> String {
    if len(chunks) == 0 {
        return "";
    }
    let mutable joined: [String] = chunks;
    while len(joined) > 1 {
        let mutable merged: [String] = [];
        let mutable i: Int = 0;
        while i + 1 < len(joined) {
            let pair: String = joined[i] + joined[i + 1];
            push(merged, pair);
            i += 2;
        }
        if i < len(joined) {
            push(merged, joined[i]);
        }
        joined = merged;
    }
    return joined[0];
}

function hex_of(value: Int) -> String {
    let digits: String = "0123456789abcdef";
    return "\\" + substring(digits, divide_floor(value, 16), 1)
            + substring(digits, remainder(value, 16), 1);
}

// A private constant for these bytes, answering the global's name. The bytes are the
// STRING as the lexer read it, escapes and all, so what the program prints is what the
// source said.
// A constant holding bytes the EMITTER produced — a printf format built for a scale,
// say — rather than bytes quoted from the program. Same escaping, different source.
function (mutable self: Unit) intern_text(text: String) -> String {
    let name: String = "@burxt.k" + to_string(len(self.strings));
    push(self.strings, 0);
    // Measured once. `len` on a String walks it, so leaving it in the condition makes
    // interning cost the square of the literal's length — the same shape that made the
    // lexer quadratic. See at_byte in ast.bx.
    let width: Int = len(text);
    let mutable pieces: [String] = [];
    let mutable body: String = "";
    let mutable i: Int = 0;
    while i < width {
        body += hex_of(byte_at(text, i));
        if len(body) > 128 {
            push(pieces, body);
            body = "";
        }
        i += 1;
    }
    if len(body) > 0 {
        push(pieces, body);
    }
    body = join_chunks(pieces);
    // `{ i64 length, [n+1 x i8] bytes }`, and the operand answered is a GEP past the header, so a
    // literal looks exactly like a region-built String to everything downstream. Without the header
    // `len("hello")` would read whatever the linker placed before the bytes.
    let shape: String = "\{ i64, [" + to_string(width + 1) + " x i8] \}";
    let wrote_global: Int = self.write_globals(name + " = private unnamed_addr constant " + shape + " \{ i64 "
                + to_string(width) + ", [" + to_string(width + 1) + " x i8] c\"" + body + hex_of(0)
            + "\" \}\n");
    // The GEP expression inline, repeated at each use, and that is the MEASURED choice rather than
    // the tidy one. An `alias` naming the byte pointer once looks obviously better — a short name
    // instead of sixty characters — and cost 0.99 s and 968 MB against 0.11 s and 326 MB, because
    // `self.globals` is a growing String and one more append per literal is quadratic in the
    // literal count. The tidier IR was three times slower to produce.
    //
    // Recorded because it is the kind of change that would be made again on principle. If
    // `globals` ever becomes a chunk list like `chunks` and `body_chunks` already are, this is
    // worth re-measuring.
    return "getelementptr inbounds (" + shape + ", ptr " + name + ", i32 0, i32 1)";
}

// Ten to the power of a scale. A scale is at most 18 and 10^18 fits in an i64, so this
// is a literal the emitter can write rather than a computation the program must do.
function power_of_ten(scale: Int) -> Int {
    let mutable n: Int = 1;
    let mutable i: Int = 0;
    while i < scale {
        n = n * 10;
        i += 1;
    }
    return n;
}

function (mutable self: Unit) intern(src: String, start: Int, length: Int) -> String {
    let name: String = "@burxt.s" + to_string(len(self.strings));
    push(self.strings, start);
    let mutable pieces: [String] = [];
    let mutable body: String = "";
    let mutable count: Int = 0;
    let mutable i: Int = 0;
    while i < length {
        let byte: Int = byte_at(src, start + i);
        if byte == 92 && i + 1 < length {            // a backslash: the lexer's escape
            let next: Int = byte_at(src, start + i + 1);
            let mutable resolved: Int = next;
            if next == 110 { resolved = 10; }        // \n
            if next == 114 { resolved = 13; }        // \r
            if next == 116 { resolved = 9; }         // \t
            if next == 48 { resolved = 0; }          // \0
            body += hex_of(resolved);
            count += 1;
            i += 2;
        } else {
            body += hex_of(byte);
            count += 1;
            i += 1;
        }
        if len(body) > 128 {
            push(pieces, body);
            body = "";
        }
    }
    if len(body) > 0 {
        push(pieces, body);
    }
    body = join_chunks(pieces);
    let shape: String = "\{ i64, [" + to_string(count + 1) + " x i8] \}";
    let wrote_global: Int = self.write_globals(name + " = private unnamed_addr constant " + shape + " \{ i64 "
                + to_string(count) + ", [" + to_string(count + 1) + " x i8] c\"" + body + hex_of(0)
            + "\" \}\n");
    return "getelementptr inbounds (" + shape + ", ptr " + name + ", i32 0, i32 1)";
}

// ---- expressions -------------------------------------------------------------
// Each one answers an OPERAND: a register like %t7, or a literal like 42. The caller
// does not care which, which is what keeps the emitter free of a value type.
// The element at `index` of an array whose type is `holder`, given the array's `base`
// register. Shared by `xs[i]` and by `for x in xs`, so the two cannot drift apart —
// which they would, because the slice and fixed-array paths differ.
function (mutable self: Unit) emit_element(src: String, holder: Type, base: String, index: String,
        token: Int) -> String {
    if holder.kind == 47 {
        let element: Type = self.declared_type(src, holder.scale);
        let at: String = self.fresh();
        let found: Int = self.write_body("  " + at + " = call i64 @burxt.slot(i64 " + base
                    + ", i64 " + index + ", i64 "
                + to_string(self.tokens[token].start) + ")\n");
        if self.is_aggregate_written(src, element) {
            return at;
        }
        let as_ptr: String = self.fresh();
        let cast: Int = self.write_body("  " + as_ptr + " = inttoptr i64 " + at + " to ptr\n");
        let reg: String = self.fresh();
        let loaded: Int = self.write_body("  " + reg + " = load i64, ptr " + as_ptr + "\n");
        return reg;
    }
    if holder.kind != 48 {
        let complained: Int = self.complain_at(src, token,
                "the Burxt backend cannot index this");
        return "0";
    }
    let element: Type = self.declared_type(src, holder.scale);
    let stride: Int = self.cells_of(src, element);
    // The bounds check is not optional and not a build mode: an index past the end
    // is a named failure, exit 70, like every other one.
    let checked: Int = self.write_body("  call void @burxt.bounds(i64 " + index + ", i64 "
                + to_string(holder.contract) + ", i64 "
            + to_string(self.tokens[token].start) + ")\n");
    let scaled: String = self.fresh();
    let multiplied: Int = self.write_body("  " + scaled + " = mul i64 " + index + ", "
            + to_string(stride) + "\n");
    let as_ptr: String = self.fresh();
    let cast: Int = self.write_body("  " + as_ptr + " = inttoptr i64 " + base + " to ptr\n");
    let at: String = self.fresh();
    let stepped: Int = self.write_body("  " + at + " = getelementptr i64, ptr " + as_ptr
            + ", i64 " + scaled + "\n");
    if self.is_aggregate_written(src, element) {
        let reg: String = self.fresh();
        let visited: Int = self.write_body("  " + reg + " = ptrtoint ptr " + at + " to i64\n");
        return reg;
    }
    let reg: String = self.fresh();
    let loaded: Int = self.write_body("  " + reg + " = load i64, ptr " + at + "\n");
    return reg;
}
function (mutable self: Unit) emit_expr(src: String, node: Int) -> String {
    let n: Node = self.nodes[node];
    if n.kind == 1 {                                 // an Int literal
        return to_string(n.value);
    }
    if n.kind == 2 {                                 // a Decimal literal
        // Scaled integer, and nothing else: $19.99 IS 1999. But a literal takes the scale
        // of its CONTEXT when that loses nothing — `$5` in a Decimal<2> is 5.00, the
        // integer 500 — and the checker recorded which scale it settled on. Emitting the
        // lexer's raw digits instead printed `$5` as 0.05.
        let settled: Type = self.type_at(node);
        let mutable value: Int = n.value;
        if settled.kind == 45 {
            if settled.scale > n.a {
                value = value * power_of_ten(settled.scale - n.a);
            }
            if settled.scale < n.a {
                // Narrowing, which the checker allowed only because every digit dropped
                // is a zero: `42.0` in a Decimal<0> is 42, and the division is exact.
                value = divide_toward_zero(value, power_of_ten(n.a - settled.scale));
            }
        }
        return to_string(value);
    }
    if n.kind == 4 {                                 // a Bool literal
        if n.value == 1 {
            return "1";
        }
        return "0";
    }
    if n.kind == 3 {                                 // a String literal, or a piece
        if n.c == 1 {
            // A literal run inside an interpolation: the span is the bytes themselves,
            // with no quotes around them.
            let inner: String = self.intern(src, n.a, n.b);
            return "ptrtoint (ptr " + inner + " to i64)";
        }
        let t: Token = self.tokens[n.token];
        // The token's span includes its quotes, and the bytes between them are the
        // string. One place knows that, and it is here.
        let global: String = self.intern(src, t.start + 1, t.length - 2);
        return "ptrtoint (ptr " + global + " to i64)";
    }

    if n.kind == 18 {                                // an interpolated String, as a value
        // The join it stands for, left to right — byte-identical to writing the `+` and
        // `to_string` calls by hand, which is the promise interpolation makes.
        if n.b == 0 {
            return "ptrtoint (ptr " + self.intern_text("") + " to i64)";
        }
        let mutable joined: String = self.emit_piece(src, self.children[n.a]);
        let mutable i: Int = 1;
        while i < n.b {
            let piece: String = self.emit_piece(src, self.children[n.a + i]);
            let next: String = self.fresh();
            let appended: Int = self.write_body("  " + next + " = call i64 @burxt.concat(i64 "
                    + joined + ", i64 " + piece + ")\n");
            joined = next;
            i += 1;
        }
        return joined;
    }
    // Kind 21: the value being returned. No name, so no span, so no slot lookup — it reads the one
    // slot `emit_ensures` declared. That is the whole of what stage-1 needed for a return bracket,
    // and it is smaller than the synthetic token spec/M13 proposed for two versions.
    if n.kind == 21 {
        if self.result_slot < 0 {
            return "0";
        }
        let reg: String = self.fresh();
        let visited: Int = self.write_body("  " + reg + " = load i64, ptr %v"
                + to_string(self.result_slot) + "\n");
        return reg;
    }
    if n.kind == 5 {                                 // a name
        let t: Token = self.tokens[n.token];
        let slot: Int = self.find_slot(src, t.start, t.length);
        if slot < 0 {
            // A const has no slot because it has no storage: it IS a literal, and this is the
            // whole of the backend's part in the feature. No global, no initialisation order,
            // and nothing to load — which is also why a const is legal inside a `pure`
            // function and costs nothing at run time.
            let named: Int = self.find_const(src, t.start, t.length);
            if named >= 0 {
                let held: ConstDecl = self.consts[named];
                if held.bound_type.kind == 40 {
                    // An Int is the only kind whose initialiser may be ARITHMETIC, so it is the
                    // only kind whose value does not survive as a node: `LIMIT * 2` has no
                    // literal node anywhere to point at. The checker computed it and stored it.
                    return to_string(held.value);
                }
