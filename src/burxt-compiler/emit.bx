        }
        if mine.kind != 48 {
            let complained: Int = self.complain_at(src, n.token,
                    "the Burxt backend cannot build this array");
            return "0";
        }
        let element: Type = self.declared_type(src, mine.scale);
        let stride: Int = self.cells_of(src, element);
        let storage: String = self.scratch(self.cells_of(src, mine));
        let mutable i: Int = 0;
        while i < n.b {
            let value: String = self.emit_expr(src, self.children[n.a + i]);
            let at: String = self.fresh();
            let stepped: Int = self.write_body("  " + at + " = getelementptr i64, ptr " + storage
                    + ", i64 " + to_string(i * stride) + "\n");
            if self.is_aggregate_written(src, element) {
                let copied: Int = self.copy_cells(src, at, value, stride);
            } else {
                let stored: Int = self.write_body("  store i64 " + value + ", ptr " + at + "\n");
            }
            i += 1;
        }
        let reg: String = self.fresh();
        let visited: Int = self.write_body("  " + reg + " = ptrtoint ptr " + storage + " to i64\n");
        return reg;
    }
    // `e?` — read the tag; on the failure variant return the failure from the enclosing function,
    // otherwise yield the success payload.
    //
    // **This is the only EXPRESSION in the language that can return**, and that is what makes it
    // interesting rather than long. The shape is the one `&&` and `||` already use — write a
    // branch, open blocks, carry on in the last one — with one simplification the short-circuit
    // operators do not get: the failure block ends in `ret`, so it never rejoins. `&&` needs a
    // cell to merge two answers into; here there is nothing to merge, because control leaves.
    // After this returns, the current block is `try.ok` and the value is simply the payload.
    //
    // The checker proved every fact used below — two variants, a failure named `Error` or `None`,
    // a success carrying exactly one value, an enclosing function whose failure has the same name
    // AND the same payload types. So nothing here re-derives them and nothing here can report:
    // the tags are looked up because a tag is a position in the declaration, which is the shared
    // fact both compilers read rather than record.
