            + "  %tomore = icmp slt i64 %toi, %ton\n"
            + "  br i1 %tomore, label %tobody, label %todone\n"
            + "tobody:\n"
            + "  %toslot = getelementptr i64, ptr %tosrc, i64 %toi\n"
            + "  %toval = load i64, ptr %toslot\n"
            + "  %tolow = icmp slt i64 %toval, 0\n"
            + "  %tohigh = icmp sgt i64 %toval, 255\n"
            + "  %tooff = or i1 %tolow, %tohigh\n"
            + "  br i1 %tooff, label %torange, label %tostore\n"
            + "torange:\n"
            + "  call i32 (i32, ptr, ...) @dprintf(i32 2, ptr @burxt.range_to_msg)\n"
            + "  call void @exit(i32 70)\n"
            + "  unreachable\n"
            + "tostore:\n"
            + "  %tobyte = trunc i64 %toval to i8\n"
            + "  %toat = getelementptr i8, ptr %todst, i64 %toi\n"
            + "  store i8 %tobyte, ptr %toat\n"
            + "  %tonext = add i64 %toi, 1\n"
            + "  store i64 %tonext, ptr %toip\n"
            + "  br label %toloop\n"
            + "todone:\n"
            + "  ret i64 %ton\n\}\n\n"
            // B5. The same state machine stage-0 builds with inkwell, written out here. One loop:
            // the leading byte says how many continuations follow AND the exact range the next one may
            // take, and that one range is what rejects all four of UTF-8's traps — 0xE0 demanding
            // A0..BF kills the overlong three-byte form, 0xED demanding 80..9F kills surrogates,
            // 0xF0 demanding 90..BF kills the overlong four-byte form, 0xF4 demanding 80..8F kills
            // everything above U+10FFFF. 0xC0 and 0xC1 never lead, so the overlong two-byte form
            // cannot start. The leftover count after the loop catches a sequence the buffer cut short.
            //
            // Registers are prefixed `u` throughout: this is emitted once per module alongside other
            // handwritten IR, and a name collision here is a `llc` error a long way from its cause.
            + "define void @burxt.require_utf8(i64 %s, i64 %n, ptr %where) \{\n"
            + "entry:\n"
            + "  %ubytes = inttoptr i64 %s to ptr\n"
            + "  %uip = alloca i64\n"
            + "  %uneedp = alloca i64\n"
            + "  %ulop = alloca i64\n"
            + "  %uhip = alloca i64\n"
            + "  store i64 0, ptr %uip\n"
            + "  store i64 0, ptr %uneedp\n"
            + "  store i64 128, ptr %ulop\n"
            + "  store i64 191, ptr %uhip\n"
            + "  br label %uloop\n"
            + "uloop:\n"
            + "  %ui = load i64, ptr %uip\n"
            + "  %umore = icmp slt i64 %ui, %n\n"
            + "  br i1 %umore, label %ubody, label %udone\n"
            + "ubody:\n"
            + "  %uat = getelementptr i8, ptr %ubytes, i64 %ui\n"
            + "  %uraw = load i8, ptr %uat\n"
            + "  %ub = zext i8 %uraw to i64\n"
            + "  %uneed = load i64, ptr %uneedp\n"
            + "  %umid = icmp sgt i64 %uneed, 0\n"
            + "  br i1 %umid, label %ucont, label %ulead\n"
            + "ulead:\n"
            + "  %uascii = icmp ult i64 %ub, 128\n"
            + "  %ustray = icmp ult i64 %ub, 194\n"
            + "  %unotascii = xor i1 %uascii, true\n"
            + "  %ubadlead = and i1 %unotascii, %ustray\n"
            + "  %uhigh = icmp ugt i64 %ub, 244\n"
            + "  %ureject = or i1 %ubadlead, %uhigh\n"
            + "  %utwo = icmp ult i64 %ub, 224\n"
            + "  %uthree = icmp ult i64 %ub, 240\n"
            + "  %un3 = select i1 %uthree, i64 2, i64 3\n"
            + "  %unm = select i1 %utwo, i64 1, i64 %un3\n"
            + "  %unext = select i1 %uascii, i64 0, i64 %unm\n"
            + "  %uise0 = icmp eq i64 %ub, 224\n"
            + "  %uised = icmp eq i64 %ub, 237\n"
            + "  %uisf0 = icmp eq i64 %ub, 240\n"
            + "  %uisf4 = icmp eq i64 %ub, 244\n"
            + "  %ulo1 = select i1 %uise0, i64 160, i64 128\n"
            + "  %ulo2 = select i1 %uisf0, i64 144, i64 %ulo1\n"
            + "  %uhi1 = select i1 %uised, i64 159, i64 191\n"
            + "  %uhi2 = select i1 %uisf4, i64 143, i64 %uhi1\n"
            + "  store i64 %unext, ptr %uneedp\n"
            + "  store i64 %ulo2, ptr %ulop\n"
            + "  store i64 %uhi2, ptr %uhip\n"
            + "  br i1 %ureject, label %ubad, label %ustep\n"
            + "ucont:\n"
            + "  %ulo = load i64, ptr %ulop\n"
            + "  %uhi = load i64, ptr %uhip\n"
            + "  %uunder = icmp ult i64 %ub, %ulo\n"
            + "  %uover = icmp ugt i64 %ub, %uhi\n"
            + "  %uout = or i1 %uunder, %uover\n"
            + "  %uleft = sub i64 %uneed, 1\n"
            + "  store i64 %uleft, ptr %uneedp\n"
            + "  store i64 128, ptr %ulop\n"
            + "  store i64 191, ptr %uhip\n"
            + "  br i1 %uout, label %ubad, label %ustep\n"
            + "ustep:\n"
            + "  %us = load i64, ptr %uip\n"
            + "  %usn = add i64 %us, 1\n"
            + "  store i64 %usn, ptr %uip\n"
            + "  br label %uloop\n"
            + "udone:\n"
            + "  %uleftover = load i64, ptr %uneedp\n"
            + "  %utrunc = icmp sgt i64 %uleftover, 0\n"
            + "  br i1 %utrunc, label %ubad, label %uok\n"
            + "ubad:\n"
            + "  %uwhere = load i64, ptr %uip\n"
            + "  call i32 (i32, ptr, ...) @dprintf(i32 2, ptr @burxt.utf8_msg, ptr %where, "
            + "i64 %uwhere)\n"
            + "  call void @exit(i32 70)\n"
            + "  unreachable\n"
            + "uok:\n"
            + "  ret void\n\}\n\n"
            + "define i64 @burxt.read_file(i64 %path) \{\n"
            + "entry:\n"
            + "  %p = inttoptr i64 %path to ptr\n"
            + "  %f = call ptr @fopen(ptr %p, ptr @burxt.mode_read)\n"
            + "  %missing = icmp eq ptr %f, null\n"
            + "  br i1 %missing, label %nothing, label %read\n"
            // FAILS rather than answering an empty String. An unreadable file that reads as empty is a
            // wrong answer a program cannot tell from a real empty file — and stage-0 has always
            // refused it. The silent version was the more dangerous of the two divergences this file
            // had, because nothing downstream could detect it.
            + "nothing:\n"
            + "  call i32 (i32, ptr, ...) @dprintf(i32 2, ptr @burxt.no_read_msg)\n"
            + "  call void @exit(i32 70)\n"
            + "  unreachable\n"
            + "read:\n"
            + "  %sought = call i32 @fseek(ptr %f, i64 0, i32 2)\n"
            + "  %size = call i64 @ftell(ptr %f)\n"
            + "  %rewound = call i32 @fseek(ptr %f, i64 0, i32 0)\n"
            // B49. A DIRECTORY opens, and `fseek` to its end answers 9223372036854775807 — so the
            // allocation asked for eight exabytes and the program died saying "region memory
            // exhausted", naming the arena and blaming the wrong thing. The reader had handed a
            // directory to a file reader; nothing about their memory was the problem. Checked BEFORE
            // the allocation, because afterwards the honest answer has been replaced by the arena's.
            + "  %rf_big = icmp ugt i64 %size, 4294967296\n"
            + "  %rf_neg = icmp slt i64 %size, 0\n"
            + "  %rf_bad = or i1 %rf_big, %rf_neg\n"
            + "  br i1 %rf_bad, label %notafile, label %sized\n"
            + "notafile:\n"
            + "  call i32 (i32, ptr, ...) @dprintf(i32 2, ptr @burxt.not_a_file_msg)\n"
            + "  call void @exit(i32 70)\n"
            + "  unreachable\n"
            + "sized:\n"
            + "  %buffer = call i64 @burxt.alloc_string(i64 %size)\n"
            + "  %bp = inttoptr i64 %buffer to ptr\n"
            + "  %got = call i64 @fread(ptr %bp, i64 1, i64 %size, ptr %f)\n"
            + "  %closed = call i32 @fclose(ptr %f)\n"
            // ftell may report more than fread delivers — a text-mode translation, a file that
            // shrank — so the header is corrected to what actually arrived. A length that disagrees
            // with the bytes is exactly what this representation exists to prevent.
            + "  %hdr = sub i64 %buffer, 8\n"
            + "  %hp2 = inttoptr i64 %hdr to ptr\n"
            + "  store i64 %got, ptr %hp2\n"
            + "  %end = getelementptr i8, ptr %bp, i64 %got\n"
            + "  store i8 0, ptr %end\n"
            // B5, and it goes after the header correction on purpose: the length checked has to be the
            // one `fread` DELIVERED, not the one `ftell` promised, or the scan reads past the bytes.
            + "  call void @burxt.require_utf8(i64 %buffer, i64 %got, ptr @burxt.utf8_read_file)\n"
            + "  ret i64 %buffer\n\}\n\n"
            + "define i64 @burxt.write_file(i64 %path, i64 %text) \{\n"
            + "entry:\n"
            + "  %p = inttoptr i64 %path to ptr\n"
            + "  %t = inttoptr i64 %text to ptr\n"
            + "  %f = call ptr @fopen(ptr %p, ptr @burxt.mode_write)\n"
            + "  %missing = icmp eq ptr %f, null\n"
            + "  br i1 %missing, label %refused, label %write\n"
            + "refused:\n  ret i64 0\n"
            + "write:\n"
            + "  %size = call i64 @burxt.len_str(i64 %text)\n"
            + "  %written = call i64 @fwrite(ptr %t, i64 1, i64 %size, ptr %f)\n"
            + "  %closed = call i32 @fclose(ptr %f)\n"
            + "  ret i64 %written\n\}\n\n"
            // `write_bytes(path, buffer)` — the low byte of every element, written out.
            //
            // Elements are i64 because a growable array's element type is one of Burxt's and there is
            // no byte type yet. The narrowing is deliberate: an element outside 0..255 keeps its low
            // eight bits, which is what a byte buffer means. The 8x memory cost of holding bytes in
            // i64s is the price of not adding a type, and it is paid in a buffer that lives for one
            // region.
            //
            // One narrow pass into region memory, then a SINGLE fwrite. Writing byte by byte through
            // the C library would be a million calls for a megabyte, which is the whole reason this
            // builtin exists — see the fixture, which is about not building a String in a loop.
            // The two hash helpers, and they must answer EXACTLY what stage-0's answer. FNV-1a for a
            // String — offset basis 0xcbf29ce484222325, prime 0x100000001b3, one xor and one multiply
            // per byte — and two rounds of xor-shift-multiply for a scalar, so small consecutive Ints
            // do not land in consecutive slots.
            //
            // The sign bit is cleared, so a hash is never negative: every caller turns one into an
            // index with `remainder(h, capacity)`, and `remainder` keeps the sign of its left operand,
            // so a negative hash would mean a negative index and a bounds failure at run time. One
            // instruction here removes that from every caller.
            //
            // Wrapping arithmetic, which is deliberate in a language where `+` panics on overflow: a
            // hash is a bit pattern and not a quantity, so there is nothing to conserve. This is the
            // only place in a Burxt program where that is true, and it is a good reason for hashing to
            // be a builtin rather than something a program writes with `*`.
            + "define i64 @burxt.hash_int(i64 %x) \{\n"
            + "entry:\n"
            + "  %m1 = mul i64 %x, 1099511628211\n"
            + "  %s1 = lshr i64 %m1, 29\n"
            + "  %f1 = xor i64 %m1, %s1\n"
            + "  %m2 = mul i64 %f1, 1099511628211\n"
            + "  %s2 = lshr i64 %m2, 32\n"
            + "  %f2 = xor i64 %m2, %s2\n"
            + "  %out = and i64 %f2, 9223372036854775807\n"
            + "  ret i64 %out\n\}\n\n"
            + "define i64 @burxt.hash_str(i64 %s) \{\n"
            + "entry:\n"
            + "  %sp = inttoptr i64 %s to ptr\n"
            + "  %acc = alloca i64\n"
            + "  %ip = alloca i64\n"
            + "  store i64 -3750763034362895579, ptr %acc\n"
            + "  store i64 0, ptr %ip\n"
            + "  br label %head\n"
            + "head:\n"
            + "  %i = load i64, ptr %ip\n"
            + "  %at = getelementptr i8, ptr %sp, i64 %i\n"
            + "  %byte = load i8, ptr %at\n"
            + "  %more = icmp ne i8 %byte, 0\n"
            + "  br i1 %more, label %body, label %done\n"
            + "body:\n"
            + "  %wide = zext i8 %byte to i64\n"
            + "  %h = load i64, ptr %acc\n"
            + "  %x = xor i64 %h, %wide\n"
            + "  %scaled = mul i64 %x, 1099511628211\n"
            + "  store i64 %scaled, ptr %acc\n"
            + "  %next = add i64 %i, 1\n"
            + "  store i64 %next, ptr %ip\n"
            + "  br label %head\n"
            + "done:\n"
            + "  %raw = load i64, ptr %acc\n"
            + "  %out = and i64 %raw, 9223372036854775807\n"
            + "  ret i64 %out\n\}\n\n"
            + "define i64 @burxt.write_bytes(i64 %path, i64 %xs) \{\n"
            + "entry:\n"
            + "  %h = inttoptr i64 %xs to ptr\n"
            + "  %datap = getelementptr i64, ptr %h, i64 2\n"
            + "  %count = load i64, ptr %h\n"
            + "  %data = load i64, ptr %datap\n"
            + "  %dp = inttoptr i64 %data to ptr\n"
            + "  %flat = call i64 @burxt.alloc(i64 %count)\n"
            + "  %fp = inttoptr i64 %flat to ptr\n"
            + "  %i0 = alloca i64\n"
            + "  store i64 0, ptr %i0\n"
            + "  br label %narrow_head\n"
            + "narrow_head:\n"
            + "  %i = load i64, ptr %i0\n"
            + "  %more = icmp slt i64 %i, %count\n"
            + "  br i1 %more, label %narrow_body, label %narrow_done\n"
            + "narrow_body:\n"
            + "  %src = getelementptr i64, ptr %dp, i64 %i\n"
            + "  %wide = load i64, ptr %src\n"
            + "  %byte = trunc i64 %wide to i8\n"
            + "  %dst = getelementptr i8, ptr %fp, i64 %i\n"
            + "  store i8 %byte, ptr %dst\n"
            + "  %next = add i64 %i, 1\n"
            + "  store i64 %next, ptr %i0\n"
            + "  br label %narrow_head\n"
            + "narrow_done:\n"
            + "  %pp = inttoptr i64 %path to ptr\n"
            + "  %f = call ptr @fopen(ptr %pp, ptr @burxt.mode_wb)\n"
            + "  %missing = icmp eq ptr %f, null\n"
            + "  br i1 %missing, label %refused, label %opened\n"
            // A refusal EXITS rather than answering 0, because stage-0 does: a program that cannot
            // write the file it was told to write has not half-succeeded.
            + "refused:\n"
            + "  call i32 (i32, ptr, ...) @dprintf(i32 2, ptr @burxt.no_write_msg)\n"
            + "  call void @exit(i32 70)\n"
            + "  unreachable\n"
            + "opened:\n"
            + "  %written = call i64 @fwrite(ptr %fp, i64 1, i64 %count, ptr %f)\n"
            + "  %closed = call i32 @fclose(ptr %f)\n"
            + "  ret i64 %written\n\}\n\n"
            // A contract that did not hold. The whole message is built at COMPILE time and interned,
            // so this helper takes one pointer and needs no formatting — and the text it prints is the
            // clause exactly as the programmer wrote it, which is the difference between a message that
            // names the promise and one that says a precondition was violated.
            + "define void @burxt.contract_failed(i64 %msg) \{\n"
            + "entry:\n"
            + "  %m = inttoptr i64 %msg to ptr\n"
            + "  call i32 (i32, ptr, ...) @dprintf(i32 2, ptr @burxt.fmt_str, ptr %m)\n"
            + "  call void @exit(i32 70)\n"
            + "  unreachable\n\}\n\n"
            + "define void @burxt.bounds(i64 %i, i64 %limit, i64 %at) \{\n"
            + "entry:\n"
            + "  %low = icmp slt i64 %i, 0\n"
            + "  %high = icmp sge i64 %i, %limit\n"
            + "  %bad = or i1 %low, %high\n"
            + "  br i1 %bad, label %oops, label %ok\n"
            + "ok:\n  ret void\n"
            + "oops:\n"
            // The numbers, because "out of bounds" leaves a reader to guess which index and how
            // long the array was — and the two together usually name the bug. The THIRD is the
            // last valid index rather than `%at`, the source byte offset this used to print:
            // `%at` answers "where is the expression" and the reader is asking "what was I
            // allowed to pass". Stage-0 has always printed the latter (B19).
            + "  %last = sub i64 %limit, 1\n"
            + "  call i32 (i32, ptr, ...) @dprintf(i32 2, ptr @burxt.bounds_msg, i64 %i, "
            + "i64 %limit, i64 %last)\n"
            + "  call void @exit(i32 70)\n"
            + "  unreachable\n\}\n\n"
            + "define i64 @burxt.divide_toward_zero(i64 %a, i64 %b) \{\n"
            + divide_guard("divtrunc")
            + "ok:\n"
            + "  %q = sdiv i64 %a, %b\n"
            + "  ret i64 %q\n\}\n\n"
            + "define i64 @burxt.divide_floor(i64 %a, i64 %b) \{\n"
            + divide_guard("divfloor")
            + "ok:\n"
            + "  %q = sdiv i64 %a, %b\n"
            + "  %r = srem i64 %a, %b\n"
            + "  %nonzero = icmp ne i64 %r, 0\n"
            + "  %ra = xor i64 %r, %b\n"
            + "  %opposite = icmp slt i64 %ra, 0\n"
            + "  %adjust = and i1 %nonzero, %opposite\n"
            + "  %lower = sub i64 %q, 1\n"
            + "  %answer = select i1 %adjust, i64 %lower, i64 %q\n"
            + "  ret i64 %answer\n\}\n\n";
}

// The two checks every integer division owes, as one block of IR with the message prefix
// substituted. Written once because three helpers need exactly the same guard, and three
// copies is three places to forget one — which is the shape B18 already took: `remainder`
// had the zero check, `divide_toward_zero` had neither, and `divide_floor` had neither.
//
// It leaves the builder positioned at a label `ok:`, which the caller opens.
//
// **Why both checks and not just the zero one.** LLVM leaves BOTH cases undefined, and on
// x86-64 both happen to fault, so a missing check looks like a working one. On aarch64
// neither faults: `sdiv` by zero yields 0, and the most negative Int over -1 yields itself.
// Two silently wrong numbers rather than two named errors.
function divide_guard(prefix: String) -> String {
    return "entry:\n"
            + "  %zero = icmp eq i64 %b, 0\n"
            + "  br i1 %zero, label %oops, label %chk\n"
            + "oops:\n"
            + "  call i32 (i32, ptr, ...) @dprintf(i32 2, ptr @burxt." + prefix + "_msg)\n"
            + "  call void @exit(i32 70)\n"
            + "  unreachable\n"
            + "chk:\n"
            // The most negative Int divided by -1 has no Int answer: the true quotient is one
            // past the top of the range. Stage-0 checks the same pair with the same message.
            + "  %amin = icmp eq i64 %a, -9223372036854775808\n"
            + "  %bneg1 = icmp eq i64 %b, -1\n"
            + "  %bad = and i1 %amin, %bneg1\n"
            + "  br i1 %bad, label %over, label %ok\n"
            + "over:\n"
            + "  call i32 (i32, ptr, ...) @dprintf(i32 2, ptr @burxt." + prefix + "_over_msg)\n"
            + "  call void @exit(i32 70)\n"
            + "  unreachable\n";
}

// One rounding helper per mode, differing only in the tie rule. Written as text with the
// mode's name substituted, because the two bodies are otherwise identical and a copy would
// be two places to fix a bug in.
function round_helper(mode: String) -> String {
    let mutable tie: String = "";
    if mode == "half_even" {
        // A tie goes to the even quotient, so repeated rounding does not drift upward.
        tie = "  %gt = icmp sgt i128 %r2, %absd\n"
                + "  %eq = icmp eq i128 %r2, %absd\n"
                + "  %lsb = and i128 %q, 1\n"
                + "  %odd = icmp ne i128 %lsb, 0\n"
                + "  %toeven = and i1 %eq, %odd\n"
                + "  %bump = or i1 %gt, %toeven\n";
    } else {
        tie = "  %bump = icmp sge i128 %r2, %absd\n";
    }
    return "define i128 @burxt.round." + mode + "(i128 %p, i128 %d) \{\n"
            + "entry:\n"
            + "  %zero = icmp eq i128 %d, 0\n"
            + "  br i1 %zero, label %by_zero, label %divide\n"
            + "by_zero:\n"
            + "  call i32 (i32, ptr, ...) @dprintf(i32 2, ptr @burxt.divzero_msg)\n"
            + "  call void @exit(i32 70)\n"
            + "  unreachable\n"
            + "divide:\n"
            + "  %q = sdiv i128 %p, %d\n"
            + "  %r = srem i128 %p, %d\n"
            + "  %rneg = sub i128 0, %r\n"
            + "  %risneg = icmp slt i128 %r, 0\n"
            + "  %absr = select i1 %risneg, i128 %rneg, i128 %r\n"
            + "  %dneg = sub i128 0, %d\n"
            + "  %disneg = icmp slt i128 %d, 0\n"
            + "  %absd = select i1 %disneg, i128 %dneg, i128 %d\n"
            + "  %r2 = mul i128 %absr, 2\n"
            + tie
            // Away from zero means toward the true quotient's sign, which is sign(p)*sign(d).
            + "  %pneg = icmp slt i128 %p, 0\n"
            + "  %opposite = xor i1 %pneg, %disneg\n"
            + "  %dir = select i1 %opposite, i128 -1, i128 1\n"
            + "  %delta = select i1 %bump, i128 %dir, i128 0\n"
            + "  %answer = add i128 %q, %delta\n"
            + "  ret i128 %answer\n\}\n\n";
}

function overflow_helper(name: String, intrinsic: String) -> String {
    return "define i64 @burxt.checked." + name + "(i64 %a, i64 %b) \{\n"
            + "entry:\n"
            + "  %r = call \{i64, i1\} @llvm." + intrinsic + ".with.overflow.i64(i64 %a, i64 %b)\n"
            + "  %v = extractvalue \{i64, i1\} %r, 0\n"
            + "  %o = extractvalue \{i64, i1\} %r, 1\n"
            + "  br i1 %o, label %overflowed, label %ok\n"
            + "ok:\n  ret i64 %v\n"
            + "overflowed:\n"
            + "  call i32 (i32, ptr, ...) @dprintf(i32 2, ptr @burxt.overflow_msg)\n"
            + "  call void @exit(i32 70)\n"
            + "  unreachable\n\}\n"
            + "declare \{i64, i1\} @llvm." + intrinsic + ".with.overflow.i64(i64, i64)\n\n";
}
