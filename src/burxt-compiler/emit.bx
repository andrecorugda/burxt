        let reg: String = self.fresh();
        if self.slot_is_aggregate(src, t.start, t.length) {
            // An aggregate's value IS its address: the alloca is the storage, and
            // copying happens where a copy is meant, not on every mention.
            let visited: Int = self.write_body("  " + reg + " = ptrtoint ptr %v" + to_string(slot)
                    + " to i64\n");
