// ============================================================================
// parser.bx — part of the Burxt compiler, written in Burxt.
//
// Tokens in, arena AST out. Children by index, contiguous child lists in a side array,
// and no recursive types anywhere.
//
// Assembled by src/burxt-compiler/stage1.bx, which is the program; everything here is
// declarations, which is what a module may hold.
// ============================================================================

// ============================================================================
// PHASE 3: the parser. Tokens in, arena AST out.
// ============================================================================

function (self: Unit) kind_at(offset: Int) -> Int {
    let i: Int = self.position + offset;
    if i < 0 || i >= len(self.tokens) {
        return 0;                                    // past the end
    }
    return self.tokens[i].kind;
}

function (self: Unit) at(kind: Int) -> Bool {
    return self.kind_at(0) == kind;
}

// Is the current token the contextual word `word`? Compared against the source span,
// so it costs no allocation — the same trick keyword lookup uses.
function (self: Unit) at_word(src: String, word: String) -> Bool {
    if self.kind_at(0) != 1 {
        return false;
    }
    let t: Token = self.tokens[self.position];
    return span_equal(src, t.start, t.length, word);
}

function (self: Unit) done() -> Bool {
    return self.position >= self.token_end;
}

function (mutable self: Unit) advance() -> Int {
    self.position += 1;
    return self.position;
}

// Is there another element in this comma-separated list?
//
// A TRAILING COMMA is allowed everywhere, so adding a parameter, an argument, a field or
// a variant is a one-line diff rather than a two-line one. It buys nothing to refuse and
// it costs a reader nothing to allow, which is the whole test. `closer` is the token that
// ends the list — 30 for `)`, 32 for `}`, 34 for `]`.
function (mutable self: Unit) more_in_list(closer: Int) -> Bool {
    if !self.at(22) {                                // ','
        return false;
    }
    let comma: Int = self.advance();
    return !self.at(closer);
}

function (mutable self: Unit) complain(src: String, what: String) -> Int {
    let where: Int = self.position;
    if where < len(self.tokens) {
        let t: Token = self.tokens[where];
        print("parse error: expected " + what + ", found `"
              + substring(src, t.start, t.length) + "`");
    } else {
        print("parse error: expected " + what + ", found the end of the file");
    }
    self.errors += 1;
    return -1;
}

// Consume a token of this kind, or report what was there instead.
function (mutable self: Unit) eat(src: String, kind: Int, what: String) -> Bool {
    if self.at(kind) {
        let n: Int = self.advance();
        return true;
    }
    let bad: Int = self.complain(src, what);
    return false;
}

function (mutable self: Unit) add(kind: Int, a: Int, b: Int, c: Int, value: Int, token: Int) -> Int {
    push(self.nodes, Node { kind: kind, a: a, b: b, c: c, value: value, token: token });
    return len(self.nodes) - 1;
}

// ---- types -------------------------------------------------------------------
// Is this token the name of a type parameter the declaration being parsed put in scope?
//
// Compared by BYTES, because a parameter's name is a span like every other name here — which
// is what lets stage-1 hold a generic without inventing a name it could not point at.
function (self: Unit) names_a_parameter(src: String, token: Int) -> Bool {
    let want: Token = self.tokens[token];
    for held in self.params_in_scope {
        let have: Token = self.tokens[held];
        if spans_equal(src, have.start, have.length, want.start, want.length) {
            return true;
        }
    }
    return false;
}

// `<T>` or `<T: Ordered>` after a declaration's name, or nothing. The names go into scope for
// the rest of the declaration; the caller truncates when it ends.
function (mutable self: Unit) parse_type_params(src: String) -> Int {
    if !self.at(35) {                                // '<'
        return 0;
    }
    let open: Int = self.advance();
    let mutable count: Int = 0;
    while true {
        if !self.at(1) {
            let complained: Int = self.complain(src, "a type parameter name");
            return 0 - 1;
        }
        let name_tok: Int = self.position;
        if self.names_a_parameter(src, name_tok) {
            let complained: Int = self.complain(src, "a type parameter name used only once here");
            return 0 - 1;
        }
        let n: Int = self.advance();
        push(self.params_in_scope, name_tok);
        count += 1;
        // `<T: Ordered>` — one bound per parameter, remembered so the body can be checked
        // against it. The two arrays stay parallel: one bound per parameter, always pushed.
        let mutable bound_tok: Int = 0 - 1;
        if self.at(20) {                             // ':'
            let colon: Int = self.advance();
            if !self.at(1) {
                let complained: Int = self.complain(src, "an interface name after the parameter's `:`");
                return 0 - 1;
            }
            bound_tok = self.position;
            let b: Int = self.advance();
        }
        push(self.pending_bounds, bound_tok);
        if self.more_in_list(36) {
            continue;
        }
        break;
    }
    if !self.eat(src, 36, "`>` closing the type parameters") { return 0 - 1; }
    return count;
}

// Record that `name_tok` is generic over the last `count` parameters put in scope, so the
// checker can find them by the declaration's own name.
function (mutable self: Unit) note_generic(name_tok: Int, count: Int) -> Int {
    if count <= 0 {
        return 0;
    }
    let name: Token = self.tokens[name_tok];
    let type_param_start: Int = len(self.type_parameters);
    let mutable i: Int = len(self.params_in_scope) - count;
    let mutable b: Int = len(self.pending_bounds) - count;
    while i < len(self.params_in_scope) {
        let noted: Int = push(self.type_parameters, self.params_in_scope[i]);
        let bounded: Int = push(self.type_param_bounds, self.pending_bounds[b]);
        i += 1;
        b += 1;
    }
    let cleared: Int = truncate(self.pending_bounds, 0);
    let noted: Int = push(self.generics, Generic { start: name.start, length: name.length,
                                                   type_param_start: type_param_start, type_param_count: count });
    return 1;
}

function (mutable self: Unit) parse_type(src: String) -> Int {
    let here: Int = self.position;
    let k: Int = self.kind_at(0);
    if k == 140 { let n: Int = self.advance(); return self.add(40, 0, 0, 0, 0, here); }
    if k == 141 { let n: Int = self.advance(); return self.add(41, 0, 0, 0, 0, here); }
    if k == 142 { let n: Int = self.advance(); return self.add(42, 0, 0, 0, 0, here); }
    if k == 143 { let n: Int = self.advance(); return self.add(43, 0, 0, 0, 0, here); }
    if k == 144 { let n: Int = self.advance(); return self.add(44, 0, 0, 0, 0, here); }
    if k == 148 { let n: Int = self.advance(); return self.add(51, 0, 0, 0, 0, here); }
    if k == 145 {
        // Decimal<S> or Decimal<S, RoundHalfEven>: the scale and the contract are
        // part of the type, so they are part of the node.
        let n: Int = self.advance();
        if !self.eat(src, 35, "`<` after `Decimal`") { return -1; }
        if !self.at(2) { return self.complain(src, "a scale, e.g. `Decimal<2>`"); }
        let scale: Int = self.tokens[self.position].value;
        let m: Int = self.advance();
        let mutable contract: Int = 0;
        if self.at(22) {                             // ','
            let c: Int = self.advance();
            if self.at(146) { contract = 1; }
            if self.at(147) { contract = 2; }
            if contract == 0 {
                return self.complain(src, "`RoundHalfEven` or `RoundHalfUp`");
            }
            let d: Int = self.advance();
        }
        if !self.eat(src, 36, "`>` closing the type") { return -1; }
        return self.add(45, scale, contract, 0, 0, here);
    }
    if k == 115 {                                    // dynamic
        let n: Int = self.advance();
        if !self.at(1) { return self.complain(src, "an interface name after `dynamic`"); }
        let name_tok: Int = self.position;
        let m: Int = self.advance();
        return self.add(49, 0, 0, 0, 0, name_tok);
    }
    if k == 33 {                                     // '[' — slice or fixed array
        let n: Int = self.advance();
        let elem: Int = self.parse_type(src);
        if elem < 0 { return -1; }
        if self.at(21) {                             // ';' — a fixed length follows
            let semi: Int = self.advance();
            if !self.at(2) { return self.complain(src, "an array length"); }
            let count: Int = self.tokens[self.position].value;
            let m: Int = self.advance();
            if !self.eat(src, 34, "`]` closing the array type") { return -1; }
            return self.add(48, elem, count, 0, 0, here);
        }
        if !self.eat(src, 34, "`]` closing the slice type") { return -1; }
        return self.add(47, elem, 0, 0, 0, here);
    }
    if k == 1 {                                      // a named record, enum or trait
        let name_tok: Int = self.position;
        let n: Int = self.advance();
        // A type PARAMETER, if the declaration being parsed put this name in scope. Kind 50
        // rather than 46, so nothing mistakes `T` for a class called `T`.
        if self.names_a_parameter(src, name_tok) {
            return self.add(50, 0, 0, 0, 0, name_tok);
        }
        // `Option<Int>` — a generic applied. The arguments are type NODES, held in `nested_children`
        // the way every other nested list is, with the start in `a` and the count in `b`.
        if self.at(35) {                             // '<'
            let open: Int = self.advance();
            // Gathered first, appended after — the `commit(base)` shape every other nested list in
            // this parser uses, and for exactly the reason it exists. Taking the start before the
            // loop looks right and is not: a NESTED application pushes its own arguments while this
            // one is still parsing, so the range handed out begins inside the inner list.
            // `Box<Box<Int>>` therefore read its argument as `Int`, and a generic containing a
            // generic silently meant something else.
            let mutable gathered: [Int] = [];
            while true {
                let argument: Int = self.parse_type(src);
                if argument < 0 { return -1; }
                push(gathered, argument);
                if self.more_in_list(36) {           // ',' — a trailing one is allowed
                    continue;
                }
                break;
            }
            if !self.eat(src, 36, "`>` closing the type arguments") { return -1; }
            let args_start: Int = len(self.nested_children);
            let mutable g: Int = 0;
            while g < len(gathered) {
                push(self.nested_children, gathered[g]);
                g += 1;
            }
            return self.add(46, args_start, len(gathered), 0, 0, name_tok);
        }
        return self.add(46, 0, 0, 0, 0, name_tok);
    }
    return self.complain(src, "a type");
}

// The type of `Name.field`, found by walking the class's declaration. Linear, like
// every other lookup here: a class has a handful of fields, and a map would be a
// dependency on machinery the language does not have.
function (self: Unit) field_type(src: String, holder: Type, name_tok: Int) -> Type {
    if holder.kind != 46 {
        return unknown_type();
    }
    let found: Int = self.find_type(src, holder.name_start, holder.name_length);
    if found < 0 {
        return unknown_type();
    }
    let decl: TypeDeclaration = self.types[found];
    if decl.kind != 82 {
        return unknown_type();
    }
    let item: Node = self.nodes[decl.node];
    let wanted: Token = self.tokens[name_tok];
    let mutable i: Int = 0;
    while i < item.b {
        let field: Node = self.nodes[self.children[item.a + i]];
        let field_name: Token = self.tokens[field.token];
        if spans_equal(src, field_name.start, field_name.length, wanted.start, wanted.length) {
            return self.declared_type(src, field.a);
        }
        i += 1;
    }
    return unknown_type();
}

// A builtin's return type. They are not in the function table because they are not
// declared anywhere — the compiler knows them, so the checker must too.
// How many arguments each builtin takes, and -1 for a name that is not one. Kept as a
// table rather than folded into the checks below, because "wrong number of arguments"
// is one message and reporting it once is what stops the type errors that follow it
// from being noise.
function builtin_arity(name: String) -> Int {
    if name == "argument_count" { return 0; }
    if name == "len" { return 1; }
    if name == "to_string" { return 1; }
    if name == "read_file" { return 1; }
    if name == "c_is_null" { return 1; }
    if name == "c_string_at" { return 1; }
    if name == "c_bytes_at" { return 2; }
    if name == "argument" { return 1; }
    if name == "hash" { return 1; }
    if name == "bit_not" { return 1; }
    if name == "bit_and" { return 2; }
    if name == "bit_or" { return 2; }
    if name == "bit_xor" { return 2; }
    if name == "shift_left" { return 2; }
    if name == "shift_right_zeros" { return 2; }
    if name == "shift_right_sign" { return 2; }
    if name == "byte_at" { return 2; }
    if name == "push" { return 2; }
    if name == "truncate" { return 2; }
    if name == "write_file" { return 2; }
    if name == "write_bytes" { return 2; }
    if name == "divide_floor" { return 2; }
    if name == "divide_toward_zero" { return 2; }
    if name == "remainder" { return 2; }
    if name == "substring" { return 3; }
    return -1;
}

function builtin_result(name: String) -> Type {
    if name == "to_string" { return simple_type(42); }
    if name == "read_file" { return simple_type(42); }
    if name == "c_string_at" { return simple_type(42); }
    if name == "c_is_null" { return simple_type(41); }
    if name == "substring" { return simple_type(42); }
    if name == "argument" { return simple_type(42); }
    if name == "len" { return simple_type(40); }
    if name == "byte_at" { return simple_type(40); }
    if name == "push" { return simple_type(40); }
    if name == "truncate" { return simple_type(40); }
    if name == "argument_count" { return simple_type(40); }
    if name == "write_file" { return simple_type(40); }
    if name == "write_bytes" { return simple_type(40); }
    if name == "bit_and" { return simple_type(40); }
    if name == "bit_or" { return simple_type(40); }
    if name == "bit_xor" { return simple_type(40); }
    if name == "bit_not" { return simple_type(40); }
    if name == "shift_left" { return simple_type(40); }
    if name == "shift_right_zeros" { return simple_type(40); }
    if name == "shift_right_sign" { return simple_type(40); }
    if name == "divide_floor" { return simple_type(40); }
    if name == "divide_toward_zero" { return simple_type(40); }
    if name == "remainder" { return simple_type(40); }
    if name == "hash" { return simple_type(40); }
    return unknown_type();
}

// What each builtin will accept. The receiver-shaped ones — `push` and `truncate` —
// also need a MUTABLE binding, because they change the array in place.
function is_bit_builtin(name: String) -> Bool {
    return name == "bit_and" || name == "bit_or" || name == "bit_xor" || name == "bit_not"
        || name == "shift_left" || name == "shift_right_zeros" || name == "shift_right_sign";
}

function (mutable self: Unit) check_builtin_args(src: String, at: Int, called: String, first: Type,
                                       second: Type, first_node: Int,
                                       second_node: Int) -> Int {
    // Exactly the Equatable set — the types `==` works on. A key needs equality and a hash, and
    // the set of types that have equality is the set that can have one, which is why there is no
    // separate `Hashable` bound naming the same four types again.
    // Bit operations work on the bits of an Int. A Decimal has no bit pattern worth exposing: its
    // meaning IS its scale, and shifting it would change the number by a factor of two while the
    // scale went on claiming otherwise.
    if is_bit_builtin(called) {
        if !is_unknown(first) && first.kind != 40 {
            let complained: Int = self.complain_at(src, at,
                "`" + called + "` works on the bits of an Int, but this is "
                + self.show_type(src, first));
        }
        if called != "bit_not" && !is_unknown(second) && second.kind != 40 {
            let complained: Int = self.complain_at(src, at,
                "`" + called + "` works on Ints, but the second argument is "
                + self.show_type(src, second));
        }
        // A shift distance outside 0..=63 has no answer — LLVM leaves it undefined and the
        // hardware silently masks it, so `x << 64` comes back as x. A literal is refused here, the
        // same treatment a literal index out of bounds gets; anything else is checked at runtime.
        if called == "shift_left" || called == "shift_right_zeros" || called == "shift_right_sign" {
            if second_node >= 0 {
                let distance: Node = self.nodes[second_node];
                // NODE kind 1 is an Int literal; 2 is the TOKEN kind it came from. Getting this
                // wrong silently checks nothing, which is why the fail fixture is what found it.
                if distance.kind == 1 {
                    if distance.value < 0 || distance.value > 63 {
                        let complained: Int = self.complain_at(src, at,
                            "`" + called + "` by " + to_string(distance.value)
                            + " has no answer: an Int is 64 bits, so a shift distance is 0 to 63");
                    }
                }
            }
        }
    }
    // The two things that may be done with a CPointer, and the only two. An Int is not a pointer,
    // and letting one become one by writing it down would hand the language exactly the ability the
    // wall exists to withhold.
    if called == "c_is_null" || called == "c_string_at" || called == "c_bytes_at" {
        if !is_unknown(first) && first.kind != 51 {
            let complained: Int = self.complain_at(src, at,
                "`" + called + "` takes a CPointer, the thing an `external function` handed back, "
                + "but this is " + self.show_type(src, first));
        }
    }
    // The count is the caller's CLAIM about how many bytes are there, and nothing in the type can
    // check it — that is the pointer wall's one soft edge, named rather than hidden. What CAN be
    // checked is that it is an Int, and that a literal is not negative: a negative count read as an
    // unsigned size is not a smaller read, it is an enormous one.
    if called == "c_bytes_at" {
        if !is_unknown(second) && second.kind != 40 {
            let complained: Int = self.complain_at(src, at,
                "`c_bytes_at(p, n)` takes a count of bytes as an Int, but this is "
                + self.show_type(src, second));
        }
        if second_node >= 0 {
            let counted: Node = self.nodes[second_node];
            if counted.kind == 1 {
                if counted.value < 0 {
                    let complained: Int = self.complain_at(src, at,
                        "`c_bytes_at(p, " + to_string(counted.value) + ")` asks for a negative "
                        + "number of bytes, which is not a smaller read but an enormous one");
                }
            }
        }
    }
    if called == "hash" {
        // A type PARAMETER is hashable when its bound says so, which is the whole job of a bound:
        // `Map<K: Equatable, V>` hashes its keys inside the generic, before any argument is known.
        // Checked here rather than left to instantiation, because a declaration that cannot be
        // justified is wrong whether or not anyone instantiates it — and stage-0 cannot see this,
        // since it only ever checks copies where `K` is already a concrete type.
        if first.kind == 50 {
            let bound: Int = self.bound_of(src, first.name_start, first.name_length);
            let mutable ok: Bool = false;
            if bound >= 0 {
                let named: Token = self.tokens[bound];
                ok = span_equal(src, named.start, named.length, "Equatable");
            }
            if !ok {
                let complained: Int = self.complain_at(src, at,
                    "`hash` needs an Equatable value, and `"
                    + substring(src, first.name_start, first.name_length)
                    + "` has no such bound: write `"
                    + substring(src, first.name_start, first.name_length)
                    + ": Equatable` in the declaration, which is what lets a key be hashed and "
                    + "compared");
            }
            return 1;
        }
        if !is_unknown(first) && first.kind != 40 && first.kind != 41 && first.kind != 42
           && first.kind != 45 {
            let complained: Int = self.complain_at(src, at,
                "`hash` needs an Equatable value, and " + self.show_type(src, first)
                + " is not one. Equatable is Int, Bool, String and Decimal — the types `==` "
                + "works on. For a compound key, build a String from the parts");
        }
        return 1;
    }
    if called == "len" {
        if !is_unknown(first) && first.kind != 47 && first.kind != 48 && first.kind != 42 {
            let complained: Int = self.complain_at(src, at,
                "`len` counts the elements of an array or the bytes of a String, but "
                + "this is " + self.show_type(src, first));
        }
        return 1;
    }
    if called == "byte_at" || called == "substring" {
        if !is_unknown(first) && first.kind != 42 {
            let complained: Int = self.complain_at(src, at,
                "`" + called + "` reads a String, but this is " + self.show_type(src, first));
        }
        return 1;
    }
    if called == "to_string" {
        if first.kind == 42 {
            let complained: Int = self.complain_at(src, at,
                "`to_string` of a String is a copy with a name that says otherwise");
        }
        if first.kind == 46 || first.kind == 49 || first.kind == 47 || first.kind == 48 {
            let complained: Int = self.complain_at(src, at,
                "`to_string` renders a number, a Bool or a Decimal — " + self.show_type(src, first)
                + " has no one rendering the language can choose for it");
        }
        return 1;
    }
    if called == "divide_floor" || called == "divide_toward_zero" || called == "remainder" {
        if !is_unknown(first) && first.kind != 40 {
            let complained: Int = self.complain_at(src, at,
                "`" + called + "` divides Ints, but the left side is " + self.show_type(src, first));
        }
        if !is_unknown(second) && second.kind != 40 {
            let complained: Int = self.complain_at(src, at,
                "`" + called + "` divides Ints, but the right side is " + self.show_type(src, second));
        }
        return 1;
    }
    if called == "write_bytes" {
        // The bytes of a growable [Int], written out — the way past quadratic string
        // building. `push` fills the buffer; this empties it.
        if !is_unknown(first) && first.kind != 42 {
            let complained: Int = self.complain_at(src, at,
                "a path is a String, but this is " + self.show_type(src, first));
        }
        if !is_unknown(second) && second.kind != 47 {
            let complained: Int = self.complain_at(src, at,
                "`write_bytes` writes the bytes of a growable `[Int]`, but this is "
                + self.show_type(src, second));
        }
        return 1;
    }
    if called == "read_file" || called == "write_file" {
        if !is_unknown(first) && first.kind != 42 {
            let complained: Int = self.complain_at(src, at,
                "a path is a String, but this is " + self.show_type(src, first));
        }
        if called == "write_file" && !is_unknown(second) && second.kind != 42 {
            let complained: Int = self.complain_at(src, at,
                "`write_file` writes a String, but this is " + self.show_type(src, second));
        }
        return 1;
    }
    if called == "argument" {
        if !is_unknown(first) && first.kind != 40 {
            let complained: Int = self.complain_at(src, at, "`argument` takes an Int index");
        }
        return 1;
    }
    if called == "push" || called == "truncate" {
        if !is_unknown(first) && first.kind != 47 {
            let complained: Int = self.complain_at(src, at,
                "`" + called + "` needs a growable array — a `[T]` — but this is "
                + self.show_type(src, first));
            return 1;
        }
        // In place means the binding itself changes, so it must be one that may.
        if first_node >= 0 {
            let base: Node = self.nodes[first_node];
            if base.kind == 5 {
                let t: Token = self.tokens[base.token];
                let found: Int = self.find_binding(src, t.start, t.length);
                if found >= 0 {
                    if self.bindings[found].writable == 0 {
                        let complained: Int = self.complain_at(src, at,
                            "`" + called + "` changes the array in place, so `"
                            + substring(src, t.start, t.length)
                            + "` has to be declared `let mutable`");
                    }
                }
            }
        }
        if called == "push" && !is_unknown(first) {
            let want: Type = self.declared_type(src, first.scale);
            // `fits`, not `same_type` — an element is a DECLARED position, so a rounding contract
            // may be added to a value that has none, exactly as at a `let` or a field. This said
            // `same_type` until v0.0.194, which made `push` the one place in either compiler where
            // the widening did not apply, and it is what kept `vector_normalise` out of
            // lib/vector.bx: a plain Decimal<7> could not be pushed into a contracted array.
            if !is_unknown(second) && !self.fits(src, second, want) {
                let complained: Int = self.complain_at(src, at,
                    "this array holds " + self.show_type(src, want) + ", but the value is "
                    + self.show_type(src, second));
            }
        }
        if called == "truncate" && !is_unknown(second) && second.kind != 40 {
            let complained: Int = self.complain_at(src, at, "`truncate` takes an Int length");
        }
        return 1;
    }
    return 1;
}

// A growable `[Int]`, for `c_bytes_at` to answer with.
//
// A slice Type holds its element type's NODE index in `scale`, so this needs a node. It does not need
// a name: `declared_type` maps node kind 40 straight to Int and never reads the token, so one
// tokenless node serves every call. Created once, on demand.
function (mutable self: Unit) byte_array_type() -> Type {
    if self.int_type_node < 0 {
        self.int_type_node = self.add(40, 0, 0, 0, 0, 0);
    }
    return Type { kind: 47, scale: self.int_type_node, contract: 0,
                name_start: 0, name_length: 0 };
}

function (mutable self: Unit) builtin_type(src: String, name: Token, at: Int, args: Int) -> Type {
    // The arguments are typed here rather than by `check_args`, because their types
    // and their count decide most of the rules below.
    let mutable first: Type = unknown_type();
    let mutable second: Type = unknown_type();
    let mutable count: Int = 0;
    let mutable first_node: Int = -1;
    let mutable second_node: Int = -1;
    let called_is_push: Bool = span_equal(src, name.start, name.length, "push");
    if args >= 0 {
        let list: Node = self.nodes[args];
        count = list.b;
        let mutable i: Int = 0;
        while i < list.b {
            // `push(xs, value)` types the VALUE against the array's element, because a class
            // literal cannot know what it is without being told: `push(table, Entry { ... })`
            // needs `Entry<String, Int>` to reach the literal or its fields stay `K` and `V`.
            //
            // Every builtin argument used to be typed with no expectation at all, which is
            // invisible for a scalar and wrong for anything that infers from context. Stage-0
            // passed the element type from the day `push` existed; this is stage-1 catching up,
            // and the differential test is what it was going to be caught by.
            let mutable want: Type = unknown_type();
            if i == 1 && called_is_push && (first.kind == 47 || first.kind == 48) {
                let written: Type = self.declared_type(src, first.scale);
                want = self.resolve_deep(src, written, self.children[list.a + i]);
            }
            let t: Type = self.type_of(src, self.children[list.a + i], want);
            if i == 0 {
                first = t;
                first_node = self.children[list.a];
            }
            if i == 1 {
                second = t;
                second_node = self.children[list.a + 1];
            }
            i += 1;
        }
    }
    let called: String = substring(src, name.start, name.length);
    let wanted: Int = builtin_arity(called);
    if wanted >= 0 && count != wanted {
        let complained: Int = self.complain_at(src, at,
            "`" + called + "` takes " + to_string(wanted) + " argument(s), but this "
            + "call passes " + to_string(count));
        if called == "c_bytes_at" {
            return self.byte_array_type();
        }
        return builtin_result(called);
    }
    let checked: Int = self.check_builtin_args(src, at, called, first, second, first_node,
                                     second_node);
    // Three builtins hand back a freshly built String, so all three need a region —
    // except `to_string` of a Bool, which renders to one of two literals and so
    // allocates nothing.
    let mutable builds: Bool = span_equal(src, name.start, name.length, "substring")
        || span_equal(src, name.start, name.length, "read_file")
        || span_equal(src, name.start, name.length, "c_string_at");
    if span_equal(src, name.start, name.length, "to_string") && first.kind != 41 {
        builds = true;
    }
    if builds {
        if !self.has_region() {
            let r: Int = self.needs_region(src, at,
                substring(src, name.start, name.length) + "(...)");
        }
    }
    if self.in_pure == 1 {
        if span_equal(src, name.start, name.length, "read_file") {
            let complained: Int = self.not_pure(src, at, "read a file");
        }
        if span_equal(src, name.start, name.length, "write_bytes") {
            let complained: Int = self.not_pure(src, at, "write a file");
        }
        if span_equal(src, name.start, name.length, "write_file") {
            let complained: Int = self.not_pure(src, at, "write a file");
        }
    }
    // One list, not two. This function used to repeat `builtin_result` name for name, and adding
    // `hash` to the other one left this one behind — so `hash(...)` typechecked as "unknown
    // function" while every table said it existed. A fact stored twice is a fact that disagrees
    // with itself eventually; the arity check above already answers from `builtin_result`, so this
    // is the same answer from the same place.
    //
    // One exception, and it is the only builtin whose answer is not a scalar: `c_bytes_at` returns
    // `[Int]`, and a slice Type needs an element NODE, which the table cannot make because it has no
    // `self`. Answered here from `byte_array_type`, which is the same fact from the same place.
    if called == "c_bytes_at" {
        return self.byte_array_type();
    }
    return builtin_result(called);
}

// A `dynamic Trait` value can do exactly what the interface says, so the interface's signature
// is what the call is checked against — no concrete type is involved, which is the
// whole point of the indirection.
function (mutable self: Unit) dynamic_method(src: String, holder: Type, call: Node) -> Type {
    let wanted: Token = self.tokens[call.token];
    let found: Int = self.find_type(src, holder.name_start, holder.name_length);
    if found < 0 {
        let complained: Int = self.complain_at(src, call.token, "no trait of this name is declared");
        return unknown_type();
    }
    let decl: TypeDeclaration = self.types[found];
    let item: Node = self.nodes[decl.node];
    let mutable i: Int = 0;
    while i < item.b {
        let sig: Node = self.nodes[self.children[item.a + i]];
        let named: Token = self.tokens[sig.token];
        if spans_equal(src, named.start, named.length, wanted.start, wanted.length) {
            // An interface signature's parameters live in `nested_children`, after the receiver.
            let list: Node = self.nodes[call.b];
            if list.b != sig.c {
                let complained: Int = self.complain_at(src, call.token,
                    "this call passes " + to_string(list.b) + " argument(s), but the "
                    + "method takes " + to_string(sig.c));
                return self.declared_type(src, sig.a);
            }
            let mutable p: Int = 0;
            while p < sig.c {
                let param: Node = self.nodes[self.nested_children[sig.b + p]];
                let want: Type = self.declared_type(src, param.a);
                let got: Type = self.type_of(src, self.children[list.a + p], want);
                if !is_unknown(got) && !self.fits(src, got, want) {
                    let complained: Int = self.complain_at(src, call.token,
                        "argument " + to_string(p + 1) + " should be " + self.show_type(src, want)
                        + ", but it is " + self.show_type(src, got));
                }
                p += 1;
            }
            return self.declared_type(src, sig.a);
        }
        i += 1;
    }
    let complained: Int = self.complain_at(src, call.token,
        self.show_type(src, holder) + " has no such method");
    return unknown_type();
}

function (self: Unit) find_method_named(src: String, holder_start: Int, holder_len: Int,
                                  name_start: Int, name_length: Int) -> Int {
    let mutable i: Int = 0;
    while i < len(self.methods) {
        let m: Method = self.methods[i];
        if spans_equal(src, m.receiver_start, m.receiver_length, holder_start, holder_len) {
            if spans_equal(src, m.start, m.length, name_start, name_length) {
                return i;
            }
        }
        i += 1;
    }
    return -1;
}

function (self: Unit) find_method(src: String, holder: Type, name_tok: Int) -> Int {
    if holder.kind != 46 {
        return -1;
    }
    let wanted: Token = self.tokens[name_tok];
    return self.find_method_named(src, holder.name_start, holder.name_length,
                                  wanted.start, wanted.length);
}

// `Enum.Variant(payload)`: the variant has to exist, and the payload has to match it.
// A constructor is the mirror of a match arm, so the two read alike on purpose.
function (mutable self: Unit) check_construction(src: String, holder: Type, call: Node) -> Int {
    // If the holder is an application — `Option<Int>` — its arguments bind the variant's
    // parameters, so `Some`'s payload reads as Int rather than T.
    let bound_base: Int = self.bind_from_application(src, holder);
    let variant_name: Token = self.tokens[call.token];
    let found: Int = self.find_type(src, holder.name_start, holder.name_length);
    let item: Node = self.nodes[self.types[found].node];
    let mutable i: Int = 0;
    while i < item.b {
        let variant: Node = self.nodes[self.children[item.a + i]];
        let named: Token = self.tokens[variant.token];
        if spans_equal(src, named.start, named.length, variant_name.start, variant_name.length) {
            let mutable given: Int = 0;
            if call.kind == 14 && call.b >= 0 {
                given = self.nodes[call.b].b;
            }
            if given != variant.c {
                let complained: Int = self.complain_at(src, call.token,
                    "`" + substring(src, named.start, named.length) + "` carries "
                    + to_string(variant.c) + " value(s), but this passes "
                    + to_string(given));
                let dropped: Int = truncate(self.type_bindings, bound_base);
        return 0;
            }
            let list: Node = self.nodes[call.b];
            let mutable p: Int = 0;
            while p < given {
                let stated: Type = self.declared_type(src, self.nested_children[variant.b + p]);
                let want: Type = self.resolve_deep(src, stated, call.token);
                let got: Type = self.type_of(src, self.children[list.a + p], want);
                if !is_unknown(got) && !self.fits(src, got, want) {
                    let complained: Int = self.complain_at(src, call.token,
                        "this variant carries " + self.show_type(src, want) + ", but the value "
                        + "is " + self.show_type(src, got));
                }
                p += 1;
            }
            let dropped: Int = truncate(self.type_bindings, bound_base);
    return 1;
        }
        i += 1;
    }
    let complained: Int = self.complain_at(src, call.token,
        self.show_type(src, holder) + " has no variant of this name");
    return 0;
}

// Every piece of an interpolation, checked as an expression and refused if it has no
// rendering the language could choose. Same rule as `print`, for the same reason.
function (mutable self: Unit) check_pieces(src: String, n: Node) -> Int {
    let mutable i: Int = 0;
    while i < n.b {
        let piece: Int = self.children[n.a + i];
        let shown: Type = self.type_of(src, piece, unknown_type());
        if shown.kind == 46 || shown.kind == 47 || shown.kind == 48 || shown.kind == 49 {
            let complained: Int = self.complain_at(src, self.nodes[piece].token,
                "an interpolated value renders a number, a Bool, a Decimal or a String — "
                + self.show_type(src, shown) + " has none the language can choose for it");
        }
        i += 1;
    }
    return 1;
}

// The payload types of `Enum.Variant`, bound to an arm's names.
function (mutable self: Unit) bind_arm(src: String, holder: Type, arm: Node) -> Int {
    if holder.kind != 46 {
        return 0;
    }
    let found: Int = self.find_type(src, holder.name_start, holder.name_length);
    if found < 0 {
        return 0;
    }
    let decl: TypeDeclaration = self.types[found];
    if decl.kind != 83 {
        return 0;
    }
    let item: Node = self.nodes[decl.node];
    let wanted: Token = self.tokens[arm.token];
    let mutable i: Int = 0;
    while i < item.b {
        let variant: Node = self.nodes[self.children[item.a + i]];
        let variant_name: Token = self.tokens[variant.token];
        if spans_equal(src, variant_name.start, variant_name.length, wanted.start, wanted.length) {
            // Bind each name in the arm to the payload type at the same position.
            if arm.c != variant.c {
                let complained: Int = self.complain_at(src, arm.token,
                    "this arm binds " + to_string(arm.c) + " name(s), but the variant "
                    + "carries " + to_string(variant.c));
            }
            // The scrutinee's type arguments bind the variant's parameters, so matching an
            // `Option<Int>` binds `Some(n)` as an Int rather than as `T`.
            let bound_base: Int = self.bind_from_application(src, holder);
            let mutable p: Int = 0;
            while p < arm.c && p < variant.c {
                let name: Token = self.tokens[self.nested_children[arm.b + p]];
                let stated: Type = self.declared_type(src, self.nested_children[variant.b + p]);
                let payload_type: Type = self.resolve_deep(src, stated, arm.token);
                push(self.bindings, Binding { start: name.start, length: name.length,
                                      bound_type: payload_type, writable: 0, depth: self.depth + 1 });
                p += 1;
            }
            let dropped: Int = truncate(self.type_bindings, bound_base);
            return variant.c;
        }
        i += 1;
    }
    let complained: Int = self.complain_at(src, arm.token, "this enum has no such variant");
    return 0;
}

// Where a value is stored rather than combined, `dynamic Trait` accepts a type that
// implements it. This is the ONLY widening in the language, which is why it is a
// separate question from `same_type`: equality must stay equality.
function (mutable self: Unit) fits(src: String, got: Type, want: Type) -> Bool {
    if self.same_type(src, got, want) {
        return true;
    }
    // A rounding contract may be ADDED to a value that has none. The representation is
    // byte-identical — both are a scaled i64 holding the same integer — and a contract does
    // not reinterpret the value, it constrains what may later be done to it. Dropping one
    // stays refused: that loses a declared intention. (v0.0.86, with stage-0.)
    if got.kind == 45 && want.kind == 45 {
        if got.scale == want.scale && got.contract == 0 && want.contract != 0 {
            return true;
        }
    }
    if want.kind != 49 || got.kind != 46 {
        return false;
    }
    let mutable i: Int = 0;
    while i < len(self.impls) {
        let candidate: Implementation = self.impls[i];
        if spans_equal(src, candidate.trait_start, candidate.trait_len,
                    want.name_start, want.name_length) {
            if spans_equal(src, candidate.type_start, candidate.type_len,
                        got.name_start, got.name_length) {
                return true;
            }
        }
        i += 1;
    }
    return false;
}

// Whether evaluating this expression allocates. The aggregate cases are here for the
// reason v0.0.48 recorded: a class or array holding a built String is itself built,
// and missing that arm let a use-after-free through for four versions.
function (mutable self: Unit) expr_allocates(src: String, node: Int) -> Bool {
    if node < 0 {
        return false;
    }
    let n: Node = self.nodes[node];
    if n.kind == 3 {
        return self.tokens[n.token].interpolated;
    }
    if n.kind == 8 {
        if n.value == 25 && self.type_at(node).kind == 42 {
            return true;                             // joining Strings
        }
        return self.expr_allocates(src, n.a) || self.expr_allocates(src, n.b);
    }
    if n.kind == 6 || n.kind == 7 {
        return self.expr_allocates(src, n.a);
    }
    if n.kind == 17 || n.kind == 19 {                // an array or class literal
        if self.type_at(node).kind == 47 {
            return true;                             // a growable array lives in a region
        }
        let mutable i: Int = 0;
        while i < n.b {
            if self.expr_allocates(src, self.children[n.a + i]) {
                return true;
            }
            i += 1;
        }
        return false;
    }
    if n.kind == 13 {                                // a call
        let name: Token = self.tokens[n.token];
        if span_equal(src, name.start, name.length, "substring")
            || span_equal(src, name.start, name.length, "read_file")
            || span_equal(src, name.start, name.length, "argument") {
            return true;
        }
        if span_equal(src, name.start, name.length, "to_string") {
            // Except of a Bool, which renders to a literal.
            let list: Node = self.nodes[n.a];
            if list.b == 1 {
                return self.type_at(self.children[list.a]).kind != 41;
            }
            return true;
        }
        let found: Int = self.find_function(src, name.start, name.length);
        if found >= 0 {
            return flag_allocates(self.functions[found].flags) == 1;
        }
        // An enum constructor carries its payload, so it is built if the payload is.
        let list: Node = self.nodes[n.a];
        let mutable i: Int = 0;
        while i < list.b {
            if self.expr_allocates(src, self.children[list.a + i]) {
                return true;
            }
            i += 1;
        }
        return false;
    }
    if n.kind == 14 {                                // a method call
        let holder: Type = self.type_at(n.a);
        let found: Int = self.find_method(src, holder, n.token);
        if found >= 0 {
            return flag_allocates(self.methods[found].flags) == 1;
        }
        return false;
    }
    return false;
}

// Whether this statement always leaves the block it is in. Used twice: to find code
// after it that can never run, and to find a function that can fall off its end.
// `while` is deliberately absent — a loop with a `return` inside it may also run zero
// times, and claiming otherwise would be a guess about the condition.
function (self: Unit) stmt_exits(node: Int) -> Bool {
    if node < 0 {
        return false;
    }
    let n: Node = self.nodes[node];
    if n.kind == 63 || n.kind == 64 || n.kind == 67 || n.kind == 68 {
        return true;                                 // return, tail return, break, continue
    }
    if n.kind == 65 {                                // if: only when BOTH sides do
        if n.c < 0 {
            return false;
        }
        return self.block_exits(n.b) && self.block_exits(n.c);
    }
    if n.kind == 69 {                                // region
        return self.block_exits(n.a);
    }
    if n.kind == 71 {                                // match: only when every arm does
        if n.c == 0 {
            return false;
        }
        let mutable i: Int = 0;
        while i < n.c {
            let arm: Node = self.nodes[self.children[n.b + i]];
            if !self.block_exits(arm.a) {
                return false;
            }
            i += 1;
        }
        return true;
    }
    return false;
}

function (self: Unit) block_exits(block: Int) -> Bool {
    if block < 0 {
        return false;
    }
    let b: Node = self.nodes[block];
    if b.kind != 16 {
        // `else if` puts a statement where a block usually goes, so a branch is asked
        // the same question either way rather than the shape deciding the answer.
        return self.stmt_exits(block);
    }
    if b.b == 0 {
        return false;
    }
    return self.stmt_exits(self.children[b.a + b.b - 1]);
}

// Set the `allocates` bit on whichever function or method is being checked, and say whether
// that was news. The flag lives on the STORED signature, which is the same place every call
// site already reads it from — so the inference needs no second table and no lookup path of
// its own. That is the whole reason this is small.
function (mutable self: Unit) note_allocates() -> Int {
    if self.current_method >= 0 {
        let m: Method = self.methods[self.current_method];
        if flag_allocates(m.flags) == 1 {
            return 0;
        }
        self.methods[self.current_method] = Method { receiver_start: m.receiver_start,
            receiver_length: m.receiver_length, start: m.start, length: m.length,
            return_type: m.return_type, parameters: m.parameters, mutating: m.mutating,
            flags: m.flags + 2 };
        self.probe_changes += 1;
        return 1;
    }
    if self.current_function >= 0 {
        let f: DeclaredFunction = self.functions[self.current_function];
        if flag_allocates(f.flags) == 1 {
            return 0;
        }
        self.functions[self.current_function] = DeclaredFunction { start: f.start,
            length: f.length, return_type: f.return_type, parameters: f.parameters,
            flags: f.flags + 2 };
        self.probe_changes += 1;
        return 1;
    }
    // The top level. It has no signature to carry the answer, and it is where the program's
    // own region lives — nothing to record.
    return 0;
}

function (mutable self: Unit) has_region() -> Bool {
    // Probing: refuse nothing, and treat "something wanted a region while none was open"
    // as the definition of "this function allocates in its caller's region". Six sites ask
    // this question; recording here means the inference is one place rather than a sweep —
    // and a sweep is exactly how the vtable ABI bug got two of its three sites right.
    if self.probing == 1 {
        if self.region_depth == 0 {
            let noted: Int = self.note_allocates();
        }
        return true;
    }
    // M14 slice 2: there is ALWAYS somewhere to build.
    //
    // This was `region_depth > 0 || in_caller_region == 1`, and the whole "there is no region
    // open here" family of refusals hung off it. The backend settles it: `burxt.alloc` is a
    // global bump pointer with no region state at all, so nothing ever needed a region in
    // order to allocate. A `region` block is purely a RELEASE mechanism — a saved mark and one
    // store to put the cursor back.
    //
    // Sound because nothing new is released. Only a `region` block releases, and its rule is
    // untouched: a value built inside one still cannot leave it. The cost is memory held for
    // the program's lifetime unless a region is opened, which is the bias M14 chose — a wrong
    // guess must cost memory, never correctness.
    return true;
}

// One sentence, and it offers both ways out — the region at the use, or `allocates`
// on the signature. M1a exists because for a while only the first was available.
function (mutable self: Unit) needs_region(src: String, at: Int, what: String) -> Int {
    let complained: Int = self.complain_at(src, at,
        what + " allocates, so it needs a region: there is none open here. Open one "
        + "with `region r \{ ... \}`");
    return 0;
}

function (mutable self: Unit) not_pure(src: String, at: Int, what: String) -> Int {
    let complained: Int = self.complain_at(src, at,
        "a `pure` function may not " + what + ": a function that can change the "
        + "program is not one whose answer depends on its arguments alone");
    return 0;
}

// `touches files, commands` — the effects a signature admits, as a BITMASK.
//
// A closed set of six, so a bitmask says the whole thing in one Int and a subset test is one `&`-free
// arithmetic check. Stage-0 keeps a Vec<Effect> per name; the answer has to be the same, not the
// representation, and a mask is what stage-1 can hold without a side table.
//
// The mask rides in the flags at bits 6..11 — see `flag_effects`. Bits 0..5 are pure, allocates,
// mutating, external, private and associated, so there was room and no new field was needed.
//
// -1 on a parse error, 0 when there is no `touches` at all.
function (mutable self: Unit) parse_touches(src: String) -> Int {
    if !self.at_word(src, "touches") {
        return 0;
    }
    let word: Int = self.advance();
    let mutable mask: Int = 0;
    let mutable more: Bool = true;
    while more {
        if !self.at(1) {
            return self.complain(src, "an effect name after `touches`");
        }
        let named: Token = self.tokens[self.position];
        let bit: Int = effect_bit(src, named.start, named.length);
        if bit == 0 {
            // A closed vocabulary, and the message says the whole of it — a reader who guessed
            // `net` should not have to go looking for the list.
            return self.complain(src, "one of `files`, `commands`, `clock`, `input`, `network` "
                        + "or `model` — the list is closed, so that scanning a diff for `network` "
                        + "keeps working");
        }
        mask = mask + bit;
        let effect: Int = self.advance();
        more = false;
        if self.at(22) {                             // ','
            let comma: Int = self.advance();
            more = true;
        }
    }
    return mask;
}

// One effect's bit, or 0 for a word that is not an effect. The order is stage-0's declaration order,
// which is also the order docs/guide/06-effects.md lists them.
function effect_bit(src: String, start: Int, length: Int) -> Int {
    if span_equal(src, start, length, "files") { return 1; }
    if span_equal(src, start, length, "commands") { return 2; }
    if span_equal(src, start, length, "clock") { return 4; }
    if span_equal(src, start, length, "input") { return 8; }
    if span_equal(src, start, length, "network") { return 16; }
    if span_equal(src, start, length, "model") { return 32; }
    return 0;
}

// The effect mask out of a flags word: bits 6..11.
function flag_effects(flags: Int) -> Int {
    return remainder(divide_floor(flags, 64), 64);
}

// One effect's NAME, for a message. Takes a single bit.
function effect_name(bit: Int) -> String {
    if bit == 1 { return "files"; }
    if bit == 2 { return "commands"; }
    if bit == 4 { return "clock"; }
    if bit == 8 { return "input"; }
    if bit == 16 { return "network"; }
    return "model";
}

// The markers, unpacked from the bits they ride in.
function flag_pure(flags: Int) -> Int {
    return remainder(flags, 2);
}
function flag_allocates(flags: Int) -> Int {
    return remainder(divide_floor(flags, 2), 2);
}
function flag_external(flags: Int) -> Int {
    return remainder(divide_floor(flags, 8), 2);
}
// `private`, on a method declared inside a class body. Bit 4: 1 is pure, 2 is
// builds-in-caller, 4 is a mutating receiver and 8 is external.
function flag_private(flags: Int) -> Int {
    return remainder(divide_floor(flags, 16), 2);
}
// An ASSOCIATED function — `function open(...)` inside a class body, with no receiver clause.
// Bit 5. It is stored as a method so that the lookup `Account` + `open` finds it, which is the
// whole reason a synthesized name `"Account.open"` turned out not to be needed: stage-1 already
// keys a method by TWO spans, and a qualified name is exactly a name in two parts.
function flag_associated(flags: Int) -> Int {
    return remainder(divide_floor(flags, 32), 2);
}

// ---- expressions -------------------------------------------------------------
// Precedence climbs the way the Rust parser's does: or, and, comparison, additive,
// term, unary, postfix, primary.
function (mutable self: Unit) parse_expr(src: String) -> Int {
    return self.parse_or(src);
}

function (mutable self: Unit) parse_or(src: String) -> Int {
    let mutable left: Int = self.parse_and(src);
    while left >= 0 && self.at(17) {                 // ||
        let here: Int = self.position;
        let n: Int = self.advance();
        let right: Int = self.parse_and(src);
        if right < 0 { return -1; }
        left = self.add(10, left, right, 0, 124, here);
    }
    return left;
}

function (mutable self: Unit) parse_and(src: String) -> Int {
    let mutable left: Int = self.parse_comparison(src);
    while left >= 0 && self.at(16) {                 // &&
        let here: Int = self.position;
        let n: Int = self.advance();
        let right: Int = self.parse_comparison(src);
        if right < 0 { return -1; }
        left = self.add(10, left, right, 0, 38, here);
    }
    return left;
}

function (mutable self: Unit) parse_comparison(src: String) -> Int {
    let left: Int = self.parse_additive(src);
    if left < 0 { return -1; }
    let k: Int = self.kind_at(0);
    if k == 12 || k == 13 || k == 14 || k == 15 || k == 35 || k == 36 {
        let here: Int = self.position;
        let n: Int = self.advance();
        let right: Int = self.parse_additive(src);
        if right < 0 { return -1; }
        // Chained comparisons are not an expression in Burxt, and saying so here
        // beats letting `a < b < c` parse into something surprising.
        let next: Int = self.kind_at(0);
        if next == 12 || next == 13 || next == 14 || next == 15 || next == 35 || next == 36 {
            return self.complain(src, "no second comparison — `a < b < c` does not chain");
        }
        return self.add(9, left, right, 0, k, here);
    }
    return left;
}

function (mutable self: Unit) parse_additive(src: String) -> Int {
    let mutable left: Int = self.parse_term(src);
    while left >= 0 && (self.at(25) || self.at(26)) {  // + -
        let here: Int = self.position;
        let op: Int = self.kind_at(0);
        let n: Int = self.advance();
        let right: Int = self.parse_term(src);
        if right < 0 { return -1; }
        left = self.add(8, left, right, 0, op, here);
    }
    return left;
}

function (mutable self: Unit) parse_term(src: String) -> Int {
    let mutable left: Int = self.parse_unary(src);
    while left >= 0 && (self.at(27) || self.at(28)) {  // * /
        let here: Int = self.position;
        let op: Int = self.kind_at(0);
        let n: Int = self.advance();
        let right: Int = self.parse_unary(src);
        if right < 0 { return -1; }
        left = self.add(8, left, right, 0, op, here);
    }
    return left;
}

function (mutable self: Unit) parse_unary(src: String) -> Int {
    let here: Int = self.position;
    if self.at(26) {                                 // -
        let n: Int = self.advance();
        let inner: Int = self.parse_unary(src);
        if inner < 0 { return -1; }
        return self.add(6, inner, 0, 0, 0, here);
    }
    if self.at(37) {                                 // !
        let n: Int = self.advance();
        let inner: Int = self.parse_unary(src);
        if inner < 0 { return -1; }
        return self.add(7, inner, 0, 0, 0, here);
    }
    return self.parse_postfix(src);
}

// `.field`, `.method(args)` and `[index]`, chained as far as they go.
function (mutable self: Unit) parse_postfix(src: String) -> Int {
    let mutable node: Int = self.parse_primary(src);
    while node >= 0 {
        if self.at(23) {                             // '.'
            let here: Int = self.position;
            let n: Int = self.advance();
            if !self.at(1) {
                return self.complain(src, "a field or method name after `.`");
            }
            let name_tok: Int = self.position;
            let m: Int = self.advance();
            if self.at(29) {                         // '(' — a method call
                let args: Int = self.parse_args(src);
                if args < 0 { return -1; }
                node = self.add(14, node, args, 0, 0, name_tok);
                continue;
            }
            node = self.add(11, node, 0, 0, 0, name_tok);
            continue;
        }
        if self.at(33) {                             // '['
            let here: Int = self.position;
            let n: Int = self.advance();
            let index: Int = self.parse_expr(src);
            if index < 0 { return -1; }
            if !self.eat(src, 34, "`]` closing the index") { return -1; }
            node = self.add(12, node, index, 0, 0, here);
            continue;
        }
        break;
    }
    return node;
}

// An argument list. Returns a node holding (start, count) into `children`.
function (mutable self: Unit) parse_args(src: String) -> Int {
    let here: Int = self.position;
    if !self.eat(src, 29, "`(`") { return -1; }
    // Collect the argument node indices locally first: parsing one appends its whole
    // subtree to `nodes`, but nothing to `children`, so the indices stay contiguous.
    let base: Int = len(self.stack);
    let mutable count: Int = 0;
    while !self.at(30) {                             // until ')'
        let argument: Int = self.parse_expr(src);
        if argument < 0 { return -1; }
        push(self.stack, argument);
        count += 1;
        if self.more_in_list(30) {                   // ',' — a trailing one is allowed
            continue;
        }
        break;
    }
    if !self.eat(src, 30, "`)` closing the arguments") { return -1; }
    let start: Int = self.commit(base);
    return self.add(15, start, count, 0, 0, here);
}

// `"total: {amount} due"` becomes a LIST of pieces — literal runs and expressions — and
// nothing else in the language needs to know it was ever one token. Node kind 18: the
// children are in `children`, alternating as the source did.
//
// The fragments are lexed in place with `run_range` and parsed with the ordinary
// expression parser, because an interpolated expression is an ordinary expression: it can
// be a call, a field access, arithmetic. Anything less would be a second, worse grammar
// living inside string literals — which is the mistake this design exists to avoid.
function (mutable self: Unit) parse_interpolation(src: String, here: Int, t: Token) -> Int {
    let base: Int = len(self.stack);
    let mutable count: Int = 0;
    let inside: Int = t.start + 1;                   // past the opening quote
    let ending: Int = t.start + t.length - 1;        // before the closing one
    let mutable i: Int = inside;
    let mutable run_from: Int = inside;

    while i < ending {
        let b: Int = byte_at(src, i);
        if b == 92 {                                 // an escape: `\{` is a literal brace
            i += 2;
            continue;
        }
        if b == 123 {                                // '{' opens a fragment
            if i > run_from {
                let literal: Int = self.add(3, run_from, i - run_from, 1, 0, here);
                push(self.stack, literal);
                count += 1;
            }
            let mutable close: Int = i + 1;
            while close < ending && byte_at(src, close) != 125 {
                close += 1;
            }
            // Lex and parse the bytes between the braces, then put the cursor back: the
            // fragment's tokens live at the END of the stream, so nothing else moves.
            let resume: Int = self.position;
            let first: Int = len(self.tokens);
            let lexed: Int = self.run_range(src, i + 1, close);
            if len(self.tokens) > first {
                self.position = first;
                let piece: Int = self.parse_expr(src);
                self.position = resume;
                if piece < 0 {
                    return -1;
                }
                push(self.stack, piece);
                count += 1;
            }
            i = close + 1;
            run_from = i;
            continue;
        }
        i += 1;
    }
    if ending > run_from {
        let literal: Int = self.add(3, run_from, ending - run_from, 1, 0, here);
        push(self.stack, literal);
        count += 1;
    }
    let start: Int = self.commit(base);
    return self.add(18, start, count, 0, 0, here);
}

function (mutable self: Unit) parse_primary(src: String) -> Int {
    let here: Int = self.position;
    let k: Int = self.kind_at(0);
    if k == 2 {
        let value: Int = self.tokens[self.position].value;
        let n: Int = self.advance();
        return self.add(1, 0, 0, 0, value, here);
    }
    if k == 3 {
        let t: Token = self.tokens[self.position];
        let n: Int = self.advance();
        // The unscaled integer and the scale, carried exactly as the lexer read them.
        return self.add(2, t.scale, 0, 0, t.value, here);
    }
    if k == 4 {
        let t: Token = self.tokens[self.position];
        let n: Int = self.advance();
        if t.interpolated {
            return self.parse_interpolation(src, here, t);
        }
        return self.add(3, 0, 0, 0, 0, here);
    }
    if k == 120 || k == 121 {                        // true / false
        let n: Int = self.advance();
        let truth: Int = 0;
        if k == 120 { return self.add(4, 0, 0, 0, 1, here); }
        return self.add(4, 0, 0, 0, 0, here);
    }
    if k == 29 {                                     // '(' grouping
        let n: Int = self.advance();
        let inner: Int = self.parse_expr(src);
        if inner < 0 { return -1; }
        if !self.eat(src, 30, "`)` closing the group") { return -1; }
        return inner;
    }
    if k == 33 {                                     // '[' — an array or slice literal
        let n: Int = self.advance();
        let base: Int = len(self.stack);
        let mutable count: Int = 0;
        while !self.at(34) {                         // until ']'
            let item: Int = self.parse_expr(src);
            if item < 0 { return -1; }
            push(self.stack, item);
            count += 1;
            if self.more_in_list(34) {              // ',' — a trailing one is allowed
                continue;
            }
            break;
        }
        if !self.eat(src, 34, "`]` closing the literal") { return -1; }
        let start: Int = self.commit(base);
        return self.add(17, start, count, 0, 0, here);
    }
    if k == 1 || k == 119 || (k >= 140 && k <= 145) {  // a name, `self`, or a type name
        let name_tok: Int = self.position;
        let n: Int = self.advance();
        if self.at(29) {                             // a call
            let args: Int = self.parse_args(src);
            if args < 0 { return -1; }
            return self.add(13, args, 0, 0, 0, name_tok);
        }
        if self.at(31) && self.no_record_literal == 0 {      // `Name { field: value }`
            let m: Int = self.advance();
            let base: Int = len(self.stack);
            let mutable count: Int = 0;
            while !self.at(32) {                     // until '}'
                if !self.at(1) {
                    return self.complain(src, "a field name");
                }
                let field_tok: Int = self.position;
                let f: Int = self.advance();
                // `P { x, y }` is shorthand for `P { x: x, y: y }`: a field taking its value
                // from a variable of the same name. `Order { subtotal: subtotal, country:
                // country }` says nothing twice, and this is the only case where the value
                // can be inferred without inferring a TYPE.
                let mutable value: Int = 0 - 1;
                if self.at(22) || self.at(32) {       // ',' or '}' — the value is the name
                    value = self.add(5, 0, 0, 0, 0, field_tok);
                } else {
                    if !self.eat(src, 20, "`:` after the field name") { return -1; }
                    value = self.parse_expr(src);
                }
                if value < 0 { return -1; }
                // One kid per field: the value, with the field's token on the node.
                let pair: Int = self.add(18, value, 0, 0, 0, field_tok);
                push(self.stack, pair);
                count += 1;
                if self.at(22) {                     // ',' — trailing one allowed
                    let c: Int = self.advance();
                    continue;
                }
                break;
            }
            if !self.eat(src, 32, "`\}` closing the literal") { return -1; }
            let start: Int = self.commit(base);
            return self.add(19, start, count, 0, 0, name_tok);
        }
        // `it` inside a contract bracket IS the subject — spec M13 Decision 2. Resolved here, at the
        // one place a bare name becomes an operand, rather than by walking the parsed expression
        // afterwards: a walker has to know every node that can hold an expression, and forgetting one
        // is a silent miss instead of an error.
        //
        // Outside a bracket `it_token` is -1 and `it_is_result` is 0, and `it` is an ordinary name.
        if span_equal(src, self.tokens[name_tok].start, self.tokens[name_tok].length, "it") {
            if self.it_is_result == 1 {
                self.used_it = 1;
                return self.add(21, 0, 0, 0, 0, name_tok);
            }
            if self.it_token >= 0 {
                self.used_it = 1;
                // A name node at the SUBJECT's token, not at `it`'s. Every lookup downstream compares
                // spans, so pointing at where the parameter is written is the whole of what makes
                // `it` BE that parameter.
                return self.add(5, 0, 0, 0, 0, self.it_token);
            }
        }
        return self.add(5, 0, 0, 0, 0, name_tok);
    }
    return self.complain(src, "an expression");
}

// ---- statements --------------------------------------------------------------
// A block: a node holding (start, count) into `children`, like an argument list.
// Move the scratch stack's entries above `base` into `children`, and answer where they
// landed. Every child list goes through here for one reason: a list built by pushing
// straight into `children` is NOT contiguous, because parsing element two pushes element
// two's own children first. That is the defect this repairs — the scratch stack is a
// stack, so an inner list is committed and popped before an outer one continues, and
// the entries that remain above `base` are exactly this list's, in order.
function (mutable self: Unit) commit(base: Int) -> Int {
    let start: Int = len(self.children);
    let mutable i: Int = base;
    while i < len(self.stack) {
        push(self.children, self.stack[i]);
        i += 1;
    }
    let dropped: Int = truncate(self.stack, base);
    return start;
}

function (mutable self: Unit) parse_block(src: String) -> Int {
    let here: Int = self.position;
    if !self.eat(src, 31, "`\{` opening a block") { return -1; }
    let base: Int = len(self.stack);
    let mutable count: Int = 0;
    while !self.at(32) && !self.done() {             // until '}'
        let stmt: Int = self.parse_stmt(src);
        if stmt < 0 { return -1; }
        push(self.stack, stmt);
        count += 1;
    }
    if !self.eat(src, 32, "`\}` closing a block") { return -1; }
    let start: Int = self.commit(base);
    return self.add(16, start, count, 0, 0, here);
}
function (mutable self: Unit) parse_stmt(src: String) -> Int {
    let here: Int = self.position;
    let k: Int = self.kind_at(0);

    if k == 100 {                                    // let
        let n: Int = self.advance();
        let mutable writable: Int = 0;
        if self.at(101) {                            // mutable
            writable = 1;
            let m: Int = self.advance();
        }
        if !self.at(1) { return self.complain(src, "a name after `let`"); }
        let name_tok: Int = self.position;
        let m2: Int = self.advance();
        // The annotation is optional: without it the type comes from the value, and -1
        // is how a `let` node says "there was none" — the emitter already read it that
        // way. See spec/M10-ERGONOMICS.md §1.
        let mutable type_node: Int = 0 - 1;
        if self.at(20) {
            let colon: Int = self.advance();
            type_node = self.parse_type(src);
            if type_node < 0 { return -1; }
        }
        if !self.eat(src, 24, "`=` and an initial value") { return -1; }
        let value: Int = self.parse_expr(src);
        if value < 0 { return -1; }
        if !self.eat(src, 21, "`;`") { return -1; }
        return self.add(60, type_node, value, 0, writable, name_tok);
    }
    if k == 118 || k == 133 {                        // print, print_error
        // One statement kind with a DESTINATION in `b`, not two kinds: the per-type formatting is
        // the part that must never fork.
        let mutable to_stderr: Int = 0;
        if k == 133 {
            to_stderr = 1;
        }
        let n: Int = self.advance();
        if !self.eat(src, 29, "`(` after `print`") { return -1; }
        let value: Int = self.parse_expr(src);
        if value < 0 { return -1; }
        if !self.eat(src, 30, "`)`") { return -1; }
        if !self.eat(src, 21, "`;`") { return -1; }
        return self.add(62, value, to_stderr, 0, 0, here);
    }
    if k == 103 {                                    // return
        let n: Int = self.advance();
        let mutable kind: Int = 63;
        if self.at(123) {                            // tail
            kind = 64;
            let m: Int = self.advance();
        }
        let value: Int = self.parse_expr(src);
        if value < 0 { return -1; }
        if !self.eat(src, 21, "`;`") { return -1; }
        return self.add(kind, value, 0, 0, 0, here);
    }
    if k == 104 {                                    // if
        let n: Int = self.advance();
        self.no_record_literal += 1;
        let cond: Int = self.parse_expr(src);
        self.no_record_literal -= 1;
        if cond < 0 { return -1; }
        let then_block: Int = self.parse_block(src);
        if then_block < 0 { return -1; }
        let mutable else_block: Int = -1;
        if self.at(105) {                            // else
            let m: Int = self.advance();
            if self.at(104) {
                // `else if` is an else-block holding one if-statement.
                else_block = self.parse_stmt(src);
            } else {
                else_block = self.parse_block(src);
            }
            if else_block < 0 { return -1; }
        }
        return self.add(65, cond, then_block, else_block, 0, here);
    }
    if k == 106 {                                    // while
        let n: Int = self.advance();
        self.no_record_literal += 1;
        let cond: Int = self.parse_expr(src);
        self.no_record_literal -= 1;
        if cond < 0 { return -1; }
        let body: Int = self.parse_block(src);
        if body < 0 { return -1; }
        return self.add(66, cond, body, 0, 0, here);
    }
    // `for x in xs { body }` — a real statement, checked and emitted as one. The first
    // version desugared it in the parser, which worked in stage-0 and cannot work here:
    // every binding is named by its SPAN in the source, and a synthesized index has no
    // span. See spec/M10-ERGONOMICS.md §1b.
    if k == 114 {                                    // for
        let n: Int = self.advance();
        if !self.at(1) { return self.complain(src, "a name after `for`"); }
        let name_tok: Int = self.position;
        let m: Int = self.advance();
        if !self.eat(src, 131, "`in` and the array to walk") { return -1; }
        self.no_record_literal += 1;
        let iterable: Int = self.parse_expr(src);
        self.no_record_literal -= 1;
        if iterable < 0 { return -1; }
        // The loop reads the iterable once per element, so a call would pay its cost per
        // pass. A name and a field path are free to re-read; nothing else is.
        let holder: Node = self.nodes[iterable];
        if holder.kind != 5 && holder.kind != 11 {
            let complained: Int = self.complain_at(src, name_tok,
                "`for` iterates a named array, and this is not a name: its result would "
                + "be recomputed on every pass. Bind it first and iterate that");
            return -1;
        }
        let body: Int = self.parse_block(src);
        if body < 0 { return -1; }
        return self.add(72, iterable, body, 0, 0, name_tok);
    }
    if k == 107 {                                    // break
        let n: Int = self.advance();
        if !self.eat(src, 21, "`;`") { return -1; }
        return self.add(67, 0, 0, 0, 0, here);
    }
    if k == 108 {                                    // continue
        let n: Int = self.advance();
        if !self.eat(src, 21, "`;`") { return -1; }
        return self.add(68, 0, 0, 0, 0, here);
    }
    if k == 111 {                                    // match
        let n: Int = self.advance();
        self.no_record_literal += 1;
        let value: Int = self.parse_expr(src);
        self.no_record_literal -= 1;
        if value < 0 { return -1; }
        if !self.eat(src, 31, "`\{` opening the arms") { return -1; }
        let base: Int = len(self.stack);
        let mutable count: Int = 0;
        while !self.at(32) && !self.done() {         // until '}'
            // `Variant => { ... }`, `Variant(a, b) => { ... }`, or — when the subject is a scalar —
            // a LITERAL and a `_`. Which of the two kinds of match this is settled by the checker
            // from the subject's TYPE, not here, because the parser does not know types.
            //
            // The pattern needs no field on the arm node: the token itself says what it is. Kind 2
            // is an Int literal, 4 a String, 120/121 are `true`/`false`, and kind 1 is a name —
            // which is a variant, or `_`, and its span tells those apart. The information was
            // already there, which is the third time this milestone that noticing so replaced a
            // new representation.
            let pk: Int = self.kind_at(0);
            if pk != 1 && pk != 2 && pk != 4 && pk != 120 && pk != 121 {
                return self.complain(src, "a variant name, or a literal and `_` when the match is "
                            + "on an Int, a String or a Bool");
            }
            let variant_tok: Int = self.position;
            let v: Int = self.advance();
            let bind_start: Int = len(self.nested_children);
            let mutable binds: Int = 0;
            if self.at(29) {                         // '(' bindings
                let p: Int = self.advance();
                while !self.at(30) {
                    if !self.at(1) {
                        return self.complain(src, "a name to bind the payload to");
                    }
                    push(self.nested_children, self.position);
                    binds += 1;
                    let b: Int = self.advance();
                    if self.more_in_list(30) {
                        continue;
                    }
                    break;
                }
                if !self.eat(src, 30, "`)` closing the bindings") { return -1; }
            }
            if !self.eat(src, 11, "`=>` after the variant") { return -1; }
            let body: Int = self.parse_block(src);
            if body < 0 { return -1; }
            let arm: Int = self.add(20, body, bind_start, binds, 0, variant_tok);
            push(self.stack, arm);
            count += 1;
        }
        if !self.eat(src, 32, "`\}` closing the arms") { return -1; }
        let start: Int = self.commit(base);
        return self.add(71, value, start, count, 0, here);
    }
    if k == 117 {                                    // region
        let n: Int = self.advance();
        if !self.at(1) { return self.complain(src, "a name for the region"); }
        let name_tok: Int = self.position;
        let m: Int = self.advance();
        let body: Int = self.parse_block(src);
        if body < 0 { return -1; }
        return self.add(69, body, 0, 0, 0, name_tok);
    }

    // Anything else starts with an expression: an assignment or a call kept for its
    // effect. Parse the expression first and let what follows decide which.
    let target: Int = self.parse_expr(src);
    if target < 0 { return -1; }
    if self.at(24) {                                 // '='
        let n: Int = self.advance();
        let value: Int = self.parse_expr(src);
        if value < 0 { return -1; }
        if !self.eat(src, 21, "`;`") { return -1; }
        return self.add(61, target, value, 0, 0, here);
    }
    // `target += value` expands to `target += value`, sharing the target node as
    // both the place written and the value read. Sharing is safe because Burxt has no
    // expression with a side effect: reading the target twice cannot mean two things.
    if self.at(38) || self.at(39) || self.at(40) {
        let mutable op: Int = 25;                        // `+`
        if self.at(39) { op = 26; }                  // `-`
        if self.at(40) { op = 27; }                  // `*`
        let n: Int = self.advance();
        let value: Int = self.parse_expr(src);
        if value < 0 { return -1; }
        if !self.eat(src, 21, "`;`") { return -1; }
        let combined: Int = self.add(8, target, value, 0, op, here);
        return self.add(61, target, combined, 0, 0, here);
    }
    if !self.eat(src, 21, "`;`") { return -1; }
    return self.add(70, target, 0, 0, 0, here);
}


// ============================================================================
// PHASE 3b: items. function, record, enum, trait, implement, external — with the markers and
// contract clauses that make a Burxt signature say what it promises.
// ============================================================================
//   80 function        81 method    82 record   83 enum   84 trait   85 implement   86 external
//   90 parameter (type in `a`, marshalled in `value`, name token on the node)
//   91 field     92 variant (payload list in (b, c))
//   93 contract clause (expression in `a`, which clause in `value`)

// A parameter list: `(name: Type, name: Type as scaled)`. Returns (start, count).
function (mutable self: Unit) parse_params(src: String) -> Int {
    let here: Int = self.position;
    if !self.eat(src, 29, "`(` opening the parameters") { return -1; }
    let base: Int = len(self.stack);
    let mutable count: Int = 0;
    while !self.at(30) {                             // until ')'
        // `mutable xs: [Int]` — the callee may change the CALLER's value, and the signature says so.
        // Read here rather than as part of the type, because it is a fact about the CROSSING and not
        // about what the value is: two parameters of the same type can differ in it.
        let mutable writable: Int = 0;
        if self.at(101) {                            // mutable
            let m: Int = self.advance();
            writable = 1;
        }
        if !self.at(1) {
            return self.complain(src, "a parameter name");
        }
        let name_tok: Int = self.position;
        let n: Int = self.advance();
        if !self.eat(src, 20, "`:` and the parameter's type") { return -1; }
        let type_node: Int = self.parse_type(src);
        if type_node < 0 { return -1; }
        // `amount: Decimal<2> as scaled` — a boundary marshaller.
        let mutable marshalled: Int = 0;
        if self.at(122) {                            // as
            let a: Int = self.advance();
            if !self.at(1) {
                return self.complain(src, "a marshaller name, e.g. `scaled`");
            }
            marshalled = 1;
            let m: Int = self.advance();
        }
        // AFTER the marshaller, so `as scaled` still reads as part of the type and the contract
        // reads as a statement about the value.
        let bracketed: Int = self.parse_value_contracts(src, name_tok, 0, 126);
        if bracketed < 0 { return -1; }
        let param: Int = self.add(90, type_node, writable, 0, marshalled, name_tok);
        push(self.stack, param);
        count += 1;
        if self.more_in_list(30) {                   // ',' — a trailing one is allowed
            continue;
        }
        break;
    }
    if !self.eat(src, 30, "`)` closing the parameters") { return -1; }
    let start: Int = self.commit(base);
    return self.add(15, start, count, 0, 0, here);
}

// `[> $0.00, (it < $1000.00 || it > -$100.00)]` — M13: a contract on the value it constrains.
//
// The comma is AND: each clause is separate, so a failure names the one that broke rather than a
// conjunction. `||` is OR inside a clause, and parentheses group.
//
// `subject_tok` is the parameter's name token, or -1 for the return type, where the subject is
// `result`. `which` is 126 for a `requires` and 127 for an `ensures` — a bracket on a parameter is
// the first, on the return type the second, and after this point nothing downstream can tell a
// bracket from a written clause. Which is the definition of sugar.
//
// Answers 0 when there was no bracket at all, 1 when it read one, -1 on a parse error.
function (mutable self: Unit) parse_value_contracts(src: String, subject_tok: Int,
                                              is_result: Int, which: Int) -> Int {
    if !self.at(33) {                                // '[' — no bracket here
        return 0;
    }
    let open_tok: Int = self.position;
    let opened: Int = self.advance();
    if self.at(34) {
        // `[]` promises nothing, and a reader who sees brackets expects a constraint. Most likely
        // somebody deleted the clause and left the punctuation, which is the weakening `burxt review`
        // exists to catch — caught a step earlier here.
        return self.complain(src, "a clause inside the brackets — `[> 0]` — or no brackets at all");
    }
    let mutable more: Bool = true;
    while more {
        self.used_it = 0;
        let clause_start: Int = self.position;
        // The ELIDED form: a leading comparison operator, with the subject understood. Told apart
        // from a whole condition by the first token, exactly as stage-0 tells them apart.
        let first: Int = self.kind_at(0);
        let elided: Bool = first == 12 || first == 13 || first == 14 || first == 15
                           || first == 35 || first == 36;
        let mutable cond: Int = -1;
        if elided {
            let op_tok: Int = self.position;
            let op: Int = self.advance();
            // The subject, as an operand. For a parameter it is a name that IS written down, so an
            // ordinary name node at its token does it. For the return type nothing is written, which
            // is why kind 21 exists: an operand meaning "the value being returned", needing no span
            // and no invented name.
            let mutable lhs: Int = -1;
            if is_result == 1 {
                lhs = self.add(21, 0, 0, 0, 0, op_tok);
            } else {
                lhs = self.add(5, 0, 0, 0, 0, subject_tok);
            }
            self.no_record_literal += 1;
            let rhs: Int = self.parse_additive(src);
            self.no_record_literal -= 1;
            if rhs < 0 { return -1; }
            cond = self.add(9, lhs, rhs, 0, first, op_tok);
        } else {
            // A whole condition, and `it` means the subject for exactly its length. Restored rather
            // than left set: outside a bracket `it` is an ordinary name, and `let it: Int = 7;` is a
            // legal program.
            let outer_token: Int = self.it_token;
            let outer_result: Int = self.it_is_result;
            self.it_token = subject_tok;
            self.it_is_result = is_result;
            self.no_record_literal += 1;
            cond = self.parse_expr(src);
            self.no_record_literal -= 1;
            self.it_token = outer_token;
            self.it_is_result = outer_result;
            if cond < 0 { return -1; }
        }
        let last: Token = self.tokens[self.position - 1];
        let began: Token = self.tokens[clause_start];
        let text_start: Int = began.start;
        let text_length: Int = last.start + last.length - began.start;
        // The clause's token is the SUBJECT's for a parameter, so a diagnostic points at the value
        // the claim is about rather than at a bracket, and the opening bracket's for a return.
        let mutable at: Int = open_tok;
        if is_result == 0 {
            at = subject_tok;
        }
        let clause: Int = self.add(93, cond, text_start, text_length, which, at);
        push(self.bracket_clauses, clause);
        // EVERY bracket clause is recorded, not only the ones needing a subject written in. A bracket
        // writes no `requires` or `ensures` word, and the message quotes one — so even a clause
        // written in full needs an entry to say which word goes in front of it. The first version
        // recorded only the elided and `it` forms, and `[balance > amount]` reported without its
        // keyword while every other clause in the language had one.
        let mutable mode: Int = 0;
        if elided { mode = 1; }
        if self.used_it == 1 { mode = 2; }
        let mutable start: Int = 0;
        let mutable length: Int = 0;
        if is_result == 0 {
            let named: Token = self.tokens[subject_tok];
            start = named.start;
            length = named.length;
        }
        push(self.clause_subjects, ClauseSubject { clause: text_start, start: start,
                                      length: length, is_result: is_result, mode: mode });
        if self.used_it == 1 {
            self.it_seen = 1;
        }
        more = false;
        if self.at(22) {                             // ','
            let comma: Int = self.advance();
            more = true;
        }
    }
    if !self.eat(src, 34, "`]` closing the contract") { return -1; }
    return 1;
}

// `requires`, `ensures` and `decreases`, between the signature and the body.
// `return_type` and `receiver_tok` ride in the clause node's two spare slots. A method item
// has five slots and six things to say, and this is the one that costs nothing: the
// clause node exists for every function whether it has clauses or not.
function (mutable self: Unit) parse_clauses(src: String, return_type: Int, receiver_tok: Int) -> Int {
    let here: Int = self.position;
    let base: Int = len(self.stack);
    let mutable count: Int = 0;
    // Bracket clauses FIRST, then what was written below — the order stage-0 uses, so the two
    // compilers report the same clause when a function has both and more than one could fail.
    //
    // They were collected in a side array rather than pushed here directly, because they are parsed
    // while the scratch stack holds the parameter list and `commit` would have swept them into it.
    let mutable b: Int = 0;
    while b < len(self.bracket_clauses) {
        push(self.stack, self.bracket_clauses[b]);
        count += 1;
        b += 1;
    }
    // Cleared for the next signature. Left uncleared, one function's brackets would be checked
    // inside the next — and a contract checked in the wrong function is a wrong answer rather than
    // an error, which is the direction that matters.
    let dropped: Int = truncate(self.bracket_clauses, 0);
    self.it_seen = 0;
    while self.at_word(src, "requires") || self.at_word(src, "ensures")
          || self.at_word(src, "decreases") {
        // Which clause, decided before the word is consumed.
        let mutable which: Int = 126;
        if self.at_word(src, "ensures") { which = 127; }
        if self.at_word(src, "decreases") { which = 128; }
        let clause_start: Int = self.position;
        let n: Int = self.advance();
        // A clause is a condition, so a `{` after it opens the BODY.
        self.no_record_literal += 1;
        let cond: Int = self.parse_expr(src);
        self.no_record_literal -= 1;
        if cond < 0 { return -1; }
        // The clause's TEXT, as a byte span, in the two spare slots. A failure has to quote what
        // the programmer wrote — "a precondition was violated" makes the reader go and find which
        // one, and there is usually more than one. Recorded here because this is the only place
        // that knows where the clause began and ended.
        // `here` is the position before the FIRST clause and is shared by all of them — the node's
        // token has always been that, and the checker points diagnostics at it. So the TEXT span
        // needs its own start, captured per clause, or every clause after the first quotes its
        // predecessors too. It did exactly that until this line existed.
        let opened: Token = self.tokens[clause_start];
        let last: Token = self.tokens[self.position - 1];
        let text_start: Int = opened.start;
        let text_length: Int = last.start + last.length - opened.start;
        let clause: Int = self.add(93, cond, text_start, text_length, which, here);
        push(self.stack, clause);
        count += 1;
    }
    let start: Int = self.commit(base);
    return self.add(15, start, count, return_type, receiver_tok, here);
}

// `function name(params) -> Type [allocates] [clauses] { body }`, or a method when a
// receiver clause follows `function`. `pure` precedes the whole thing.
function (mutable self: Unit) parse_function(src: String, is_pure: Int, owner: Int) -> Int {
    let here: Int = self.position;
    if !self.eat(src, 102, "`function`") { return -1; }

    // `function (self: T) name(...)` and `function (mutable self: T) name(...)` are methods: the
    // `(` right after `function` is the tell, exactly as in the Rust parser.
    let mutable receiver_tok: Int = -1;
    let mutable receiver_mut: Int = 0;
    // `function open(...)` with an OWNER but no receiver clause: an associated function, which is
    // how a class gets a constructor. It is recorded as a method on the owner so that the two-span
    // lookup finds it at `Account.open(...)`, and flagged so that nothing looks for a `self`
    // that was never written.
    let mutable associated: Int = 0;
    if owner >= 0 && !self.at(29) {
        associated = 1;
        receiver_tok = owner;
    }
    if self.at(29) {
        let n: Int = self.advance();
        if self.at(101) {                            // mutable
            receiver_mut = 1;
            let m: Int = self.advance();
        }
        if !self.eat(src, 119, "`self` in the receiver clause") { return -1; }
        // `function (self) name()` inside an `implement` — the header already said which type, so
        // `owner` is that type's token and repeating it on every method buys nothing.
        // Outside an implementation `owner` is -1 and the annotation stays required, because there
        // nothing says which type it is.
        if self.at(30) {
            if owner < 0 {
                return self.complain(src,
                    "the receiver's type: outside an `implement` block nothing says which "
                    + "one, so write `function (self: Type) name(...)`");
            }
            receiver_tok = owner;
        } else {
            if !self.eat(src, 20, "`:` and the receiver's type") { return -1; }
            if !self.at(1) {
                return self.complain(src, "a class name after `self:`");
            }
            receiver_tok = self.position;
            let r: Int = self.advance();
            // `self: Stack<T>` — the receiver names the class's parameters, which are
            // then in scope for the rest of the signature and the body.
            let receiver_params: Int = self.parse_type_params(src);
            if receiver_params < 0 { return -1; }
        }
        if !self.eat(src, 30, "`)` closing the receiver clause") { return -1; }
    }

    if !self.at(1) {
        return self.complain(src, "a function name");
    }
    let name_tok: Int = self.position;
    let n2: Int = self.advance();
    // `function largest<T: Ordered>(...)`. A method declares none of its own — its
    // receiver already named the class's — so this adds nothing there.
    let declared_params: Int = self.parse_type_params(src);
    if declared_params < 0 { return -1; }
    let noted: Int = self.note_generic(name_tok, declared_params);
    let params: Int = self.parse_params(src);
    if params < 0 { return -1; }
    if !self.eat(src, 10, "`->` and a return type — every Burxt function returns one") {
        return -1;
    }
    let return_type: Int = self.parse_type(src);
    if return_type < 0 { return -1; }
    // A bracket on the RETURN type is an `ensures`, and its subject is `result` — the same name a
    // written `ensures` binds, so the two forms are the same clause by the time anything checks them.
    let returns_bracketed: Int = self.parse_value_contracts(src, 0 - 1, 1, 127);
    if returns_bracketed < 0 { return -1; }
    // The collision rule, checked once the whole signature is read because a bracket on parameter one
    // cannot know about a parameter three called `it`. Not a keyword — a program may still name
    // something `it` — but a function with both has two meanings for one word, and picking either
    // would be a silent shadow. The rule `result` already follows inside `ensures`.
    if self.it_seen == 1 {
        let list: Node = self.nodes[params];
        let mutable p: Int = 0;
        while p < list.b {
            let param: Node = self.nodes[self.children[list.a + p]];
            let named: Token = self.tokens[param.token];
            if span_equal(src, named.start, named.length, "it") {
                return self.complain(src, "a parameter not called `it`, on a function whose "
                            + "contract bracket says `it` — `it` would mean two things in one "
                            + "signature. Rename the parameter, or write its name in the clause");
            }
            p += 1;
        }
    }
    let mutable builds_in_caller: Int = 0;
    let mutable claims_nothing: Int = 0;
    if self.at_word(src, "allocates") {              // contextual: only here does the
        builds_in_caller = 1;                        // word mean the marker.
        let a: Int = self.advance();
        // `allocates nothing` is the opposite claim, and stage-1 PARSES it without checking it.
        //
        // That is a deliberate asymmetry rather than an oversight, and worth stating because the
        // usual rule here is the reverse. Stage-0 checks the claim against its allocation fixpoint;
        // stage-1 has no such fixpoint — the whole inference is stage-0's, and stage-1 has always
        // required the marker rather than deriving it (M14 slice 1 shipped stage-0 v0.0.142 and
        // stage-1 v0.0.144, two versions apart, for the same reason).
        //
        // Recognising the word costs nothing and keeps the two compilers accepting the same
        // programs, which is what the differential measures. Checking it needs the fixpoint, and
        // that is per-block release's other half. Until then a claim stage-1 cannot verify is one it
        // does not pretend to: it reads the word and moves on, and stage-0 is where the refusal
        // lives. `spec/M14-IMPLICIT-REGIONS.md` §8 predicted exactly this staging.
        if self.at_word(src, "nothing") {
            builds_in_caller = 0;
            claims_nothing = 1;
            let n: Int = self.advance();
        }
    }
    // `touches files, commands` — what this function reaches outside itself, as a bitmask riding in
    // the flags. Parsed AND enforced since v0.0.183; before that it was read and thrown away, which
    // could not miscompile anything but meant the two compilers disagreed about what a program means.
    let reaches: Int = self.parse_touches(src);
    if reaches < 0 { return -1; }
    let clauses: Int = self.parse_clauses(src, return_type, receiver_tok);
    if clauses < 0 { return -1; }
    let body: Int = self.parse_block(src);
    if body < 0 { return -1; }

    // The markers ride in `value` as bits: pure, allocates, mutating receiver.
    let mutable flags: Int = 0;
    if is_pure == 1 { flags += 1; }
    if builds_in_caller == 1 { flags += 2; }
    if receiver_mut == 1 { flags += 4; }
    if associated == 1 { flags += 32; }
    flags += reaches * 64;                           // the effect mask, at bits 6..11
    if receiver_tok >= 0 {
        // A method: `c` is the clause node, which holds the receiver and the return
        // type both, so a method item has the same shape a function's does.
        let m: Int = self.add(81, params, body, clauses, flags, name_tok);
        return m;
    }
    let f: Int = self.add(80, params, body, clauses, flags, name_tok);
    return f;
}

// `class Name { field: Type, ..., function (self) method() -> T { ... } }`
//
// Fields and methods in one block, which is what the word `class` is for. A method here is
// parsed by `parse_function` with the class's name token as its OWNER — the same mechanism
// `implement Trait for Type` already used, so `function (self) price()` needs no repeated
// type — and then pushed straight into `self.items`, which makes it indistinguishable from a
// method written outside the class. Nothing downstream learns anything new: the checker, the
// emitter and the layout walk all see the method list they already saw.
function (mutable self: Unit) parse_record(src: String) -> Int {
    if !self.eat(src, 109, "`class`") { return -1; }
    if !self.at(1) { return self.complain(src, "a class name"); }
    let name_tok: Int = self.position;
    let n: Int = self.advance();
    // `record Name<T> { ... }` — the parameters are in scope for the fields or variants.
    let declared_params: Int = self.parse_type_params(src);
    if declared_params < 0 { return -1; }
    let noted: Int = self.note_generic(name_tok, declared_params);
    // `class FlatTax implements Tax, Priced` — one impl item per interface named, each carrying
    // NO methods of its own: the class's own methods are what satisfy it, and the checker looks
    // them up in the method table. Emitted as items so the vtable pass sees them exactly as it
    // sees a standalone `implement Tax for FlatTax { }`.
    if self.at(133) {
        let word: Int = self.advance();
        let mutable more: Bool = true;
        while more {
            if !self.at(1) {
                return self.complain(src, "an interface name after `implements`");
            }
            let interface_tok: Int = self.position;
            let n2: Int = self.advance();
            // kind 85 is an implementation block; 0 children, and `value` marks it as
            // declared on the class so the checker knows where to find the methods.
            let block: Int = self.add(85, 0, 0, name_tok, 1, interface_tok);
            push(self.items, block);
            more = false;
            if self.at(22) {                             // ','
                let comma: Int = self.advance();
                more = true;
            }
        }
    }
    if !self.eat(src, 31, "`\{` opening the fields") { return -1; }
    let base: Int = len(self.stack);
    let mutable count: Int = 0;
    while !self.at(32) && !self.done() {
        // A method, not a field. `pure` is refused with the same sentence a free-standing
        // one gets, because a method cannot carry the marker yet.
        if self.at(124) {
            return self.complain(src, "a method cannot be declared `pure` yet — the marker "
                        + "goes on a free function for now");
        }
        // `private` applies to whichever of the two follows it. Recorded in the field node's
        // spare slot for a field, and in the method item's flags for a method.
        let mutable is_private: Int = 0;
        if self.at(132) {
            let p: Int = self.advance();
            is_private = 1;
        }
        // `function name(...)` with no receiver clause: an ASSOCIATED function, which is how a
        // class gets a constructor. Stage-0 stores it under the qualified name `Account.open`
        // and emits `bx.Account.open`; stage-1 records it as a method on this class with bit 32
        // set, because a method here is already keyed by (receiver span, name span) and a
        // qualified name is a name in two parts. Passing the class's token as the OWNER is the
        // whole change — `parse_function` sees an owner with no receiver clause and knows.
        if self.at(102) && self.kind_at(1) != 29 {
            let associated: Int = self.parse_function(src, 0, name_tok);
            if associated < 0 { return -1; }
            push(self.items, associated);
            continue;
        }
        if self.at(102) {
            let method: Int = self.parse_function(src, 0, name_tok);
            if method < 0 { return -1; }
            if is_private == 1 {
                // Set the bit on the item that was just built. `parse_function` assembles the
                // flags itself and has no reason to know about class bodies.
                let m: Node = self.nodes[method];
                self.nodes[method] = Node { kind: m.kind, a: m.a, b: m.b, c: m.c,
                                        value: m.value + 16, token: m.token };
            }
            push(self.items, method);
            continue;
        }
        if !self.at(1) { return self.complain(src, "a field name or a `function`"); }
        let field_tok: Int = self.position;
        let f: Int = self.advance();
        if !self.eat(src, 20, "`:` and the field's type") { return -1; }
        let type_node: Int = self.parse_type(src);
        if type_node < 0 { return -1; }
        let field: Int = self.add(91, type_node, 0, 0, is_private, field_tok);
        push(self.stack, field);
        count += 1;
        if self.more_in_list(32) {
            continue;
        }
        // No comma: either the block ends here, or a method follows the last field. Both are
        // legal, so the loop keeps going and the `}` check below is what actually ends it.
        if self.at(102) || self.at(124) {
            continue;
        }
        break;
    }
    if !self.eat(src, 32, "`\}` closing the class") { return -1; }
    let start: Int = self.commit(base);
    return self.add(82, start, count, 0, 0, name_tok);
}

// `enum Name { Variant, Variant(Type, Type), ... }`
function (mutable self: Unit) parse_enum(src: String) -> Int {
    if !self.eat(src, 110, "`enum`") { return -1; }
    if !self.at(1) { return self.complain(src, "an enum name"); }
    let name_tok: Int = self.position;
    let n: Int = self.advance();
    // `enum Name<T> { ... }` — the parameters are in scope for the fields or variants.
    let declared_params: Int = self.parse_type_params(src);
    if declared_params < 0 { return -1; }
    let noted: Int = self.note_generic(name_tok, declared_params);
    if !self.eat(src, 31, "`\{` opening the variants") { return -1; }
    let base: Int = len(self.stack);
    let mutable count: Int = 0;
    while !self.at(32) && !self.done() {
        if !self.at(1) { return self.complain(src, "a variant name"); }
        let variant_tok: Int = self.position;
        let v: Int = self.advance();
        let payload_start: Int = len(self.nested_children);
        let mutable payload: Int = 0;
        if self.at(29) {                             // '(' — a payload
            let p: Int = self.advance();
            while !self.at(30) {
                let type_node: Int = self.parse_type(src);
                if type_node < 0 { return -1; }
                push(self.nested_children, type_node);
                payload += 1;
                if self.more_in_list(30) {
                    continue;
                }
                break;
            }
            if !self.eat(src, 30, "`)` closing the payload") { return -1; }
        }
        let variant: Int = self.add(92, 0, payload_start, payload, 0, variant_tok);
        push(self.stack, variant);
        count += 1;
        if self.more_in_list(32) {
            continue;
        }
        break;
    }
    if !self.eat(src, 32, "`\}` closing the variants") { return -1; }
    let start: Int = self.commit(base);
    return self.add(83, start, count, 0, 0, name_tok);
}

// `trait Name { function sig(self) -> Type }` — signatures only, no bodies.
function (mutable self: Unit) parse_trait(src: String) -> Int {
    if !self.eat(src, 112, "`interface`") { return -1; }
    if !self.at(1) { return self.complain(src, "an interface name"); }
    let name_tok: Int = self.position;
    let n: Int = self.advance();
    if !self.eat(src, 31, "`\{` opening the interface") { return -1; }
    let base: Int = len(self.stack);
    let mutable count: Int = 0;
    while !self.at(32) && !self.done() {
        if !self.eat(src, 102, "`function` — an interface holds signatures") { return -1; }
        if !self.at(1) { return self.complain(src, "a method name"); }
        let method_tok: Int = self.position;
        let m: Int = self.advance();
        if !self.eat(src, 29, "`(` and a receiver") { return -1; }
        let mutable receiver_mut: Int = 0;
        if self.at(101) {
            receiver_mut = 1;
            let mu: Int = self.advance();
        }
        if !self.eat(src, 119, "`self`") { return -1; }
        // An interface signature may take parameters after `self`.
        let extra_start: Int = len(self.nested_children);
        let mutable extra: Int = 0;
        while self.at(22) {                          // ',' more parameters
            let c: Int = self.advance();
            if !self.at(1) { return self.complain(src, "a parameter name"); }
            let pname: Int = self.position;
            let pn: Int = self.advance();
            if !self.eat(src, 20, "`:` and the parameter's type") { return -1; }
            let type_node: Int = self.parse_type(src);
            if type_node < 0 { return -1; }
            let param: Int = self.add(90, type_node, 0, 0, 0, pname);
            push(self.nested_children, param);
            extra += 1;
        }
        if !self.eat(src, 30, "`)`") { return -1; }
        if !self.eat(src, 10, "`->` and a return type") { return -1; }
        let return_type: Int = self.parse_type(src);
        if return_type < 0 { return -1; }
        let sig: Int = self.add(94, return_type, extra_start, extra, receiver_mut, method_tok);
        push(self.stack, sig);
        count += 1;
    }
    if !self.eat(src, 32, "`\}` closing the interface") { return -1; }
    let start: Int = self.commit(base);
    return self.add(84, start, count, 0, 0, name_tok);
}

// `implement Trait for Type { methods }`
function (mutable self: Unit) parse_impl(src: String) -> Int {
    if !self.eat(src, 113, "`implement`") { return -1; }
    if !self.at(1) { return self.complain(src, "an interface name"); }
    let trait_tok: Int = self.position;
    let t: Int = self.advance();
    if !self.eat(src, 114, "`for`") { return -1; }
    if !self.at(1) { return self.complain(src, "the type implementing the interface"); }
    let type_tok: Int = self.position;
    let type_node: Int = self.advance();
    if !self.eat(src, 31, "`\{` opening the implementation") { return -1; }
    let base: Int = len(self.stack);
    let mutable count: Int = 0;
    while !self.at(32) && !self.done() {
        let method: Int = self.parse_function(src, 0, type_tok);
        if method < 0 { return -1; }
        push(self.stack, method);
        count += 1;
    }
    if !self.eat(src, 32, "`\}` closing the implementation") { return -1; }
    let start: Int = self.commit(base);
    return self.add(85, start, count, type_tok, 0, trait_tok);
}

// `external function name(params) -> Type;` — no body, and none allowed.
function (mutable self: Unit) parse_extern(src: String) -> Int {
    if !self.eat(src, 116, "`external`") { return -1; }
    if !self.eat(src, 102, "`function` after `external`") { return -1; }
    if !self.at(1) { return self.complain(src, "a function name"); }
    let name_tok: Int = self.position;
    let n: Int = self.advance();
    if self.at(35) {                                 // '<'
        let complained: Int = self.complain_at(src, name_tok,
            "an `external function` cannot be generic: C has no type parameters, and there "
            + "would be no symbol to link against");
        return -1;
    }
    let params: Int = self.parse_params(src);
    if params < 0 { return -1; }
    if !self.eat(src, 10, "`->` and a return type") { return -1; }
    let return_type: Int = self.parse_type(src);
    if return_type < 0 { return -1; }
    // `touches ...` on an extern is where an effect ENTERS the program: there is no body to reason
    // about, so the declaration is the only thing that can say what a C function reaches. An extern
    // declaring nothing is taken at its word — right for `strlen`, a lie for `system`, which is why
    // lib/os.bx declares its own.
    let reaches: Int = self.parse_touches(src);
    if reaches < 0 { return -1; }
    if !self.eat(src, 21, "`;` — an external declaration has no body") { return -1; }
    // `c` carries the effect mask. An extern node uses `a` for its parameters and `b` for the return
    // type, and `c` was 0 — the one free slot, and the reason this needed no side table.
    return self.add(86, params, return_type, reaches, 0, name_tok);
}

// One item, or a top-level statement: the same dispatch the Rust parser makes.
function (mutable self: Unit) parse_item(src: String) -> Int {
    // Type parameters belong to one declaration. Cleared here rather than at every exit
    // inside the declaration parsers, of which there are dozens and each one a chance to
    // forget — the same argument `commit(base)` makes for child lists.
    let dropped: Int = truncate(self.params_in_scope, 0);
    let k: Int = self.kind_at(0);
    if k == 124 {                                    // pure function
        let n: Int = self.advance();
        return self.parse_function(src, 1, 0 - 1);
    }
    if k == 102 { return self.parse_function(src, 0, 0 - 1); }
    if k == 109 { return self.parse_record(src); }
    if k == 110 { return self.parse_enum(src); }
    if k == 112 { return self.parse_trait(src); }
    if k == 113 { return self.parse_impl(src); }
    if k == 116 { return self.parse_extern(src); }
    return self.parse_stmt(src);
}

// Step over an item without reading it: phase 3b parses these, and until then the
// driver must not mistake a function body for top-level code.
function (mutable self: Unit) skip_item() -> Int {
    let mutable braces: Int = 0;
    let mutable nesting: Int = 0;
    let mutable seen_brace: Bool = false;
    while !self.done() {
        let k: Int = self.kind_at(0);
        if k == 31 {
            braces += 1;
            seen_brace = true;
        }
        if k == 32 { braces -= 1; }
        // Parentheses and brackets are counted too, and the reason is a bug this
        // caught: `function f(xs: [Int; 3])` contains a SEMICOLON, inside the array type.
        // Treating any semicolon as the end of a bodyless `external` declaration
        // stopped the skip in the middle of a signature.
        if k == 29 || k == 33 { nesting += 1; }
        if k == 30 || k == 34 { nesting -= 1; }
        let n: Int = self.advance();
        if seen_brace && braces == 0 {
            break;
        }
        if !seen_brace && k == 21 && nesting == 0 {
            break;
        }
    }
    return self.position;
}
