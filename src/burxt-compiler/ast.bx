// ============================================================================
// ast.bx — the shapes: tokens, nodes, types, and the arenas that hold them.
//
// **This was the first half of `ast.bx` until v0.0.233, and the rename is the point.**
// Andre, reading `src/burxt-compiler/`: *"why is there no ast for .bx?"* There was — 475
// lines of it — inside a file named for neither of the two jobs it did. `ast.bx` was
// `ast.bx` and `lexer.bx` glued together, and "types" described one section of the first
// half.
//
// It is the third time a name here outlived what it described: the compiler filed under
// `examples/` (v0.0.214), `stage1.bx` for a bootstrap stage that no longer exists
// (v0.0.215), and this. All three were found by a human reading a directory listing, which
// is why `the_repository_layout_is_declared` now exists — and why it still cannot catch this
// one. A test can check that a file is in a declared home; only a reader can notice that its
// NAME describes half of it. See `spec/A7.0-NAMING.md`.
//
// The split was clean rather than negotiated, and that is worth recording because it is the
// evidence the two halves were never one thing:
//
//   - the AST half called **nothing** in the lexer half — zero references, measured.
//   - the lexer half uses `Token` and `Unit` from here, so the dependency is one-way, which
//     is the direction `lexer.rs` depends on `ast.rs` on the Rust side.
//
// So `src/burxt-compiler/` and `src/rust-compiler/` now map one file to one file, and the
// parity map in `tests/runner.rs` loses the only row that pointed two Rust modules at one
// Burxt file and had to explain itself.
// ============================================================================

// Nothing here uses a map, because Burxt has none: the keyword table and the symbol table are
// arrays searched linearly, which is what a compiler's lookups cost anyway. That line survives
// from the file's original banner, which also said *"one file, because Burxt has no module
// system yet"* — true at v0.0.52, untrue since v0.0.82, and still sitting at the top of the
// file eleven versions after this compiler was split into five. A banner is as prone to
// outliving its subject as a filename is.

// ---- token kinds -----------------------------------------------------------
// Codes rather than an enum: a 60-variant enum would force a 60-arm `match` at
// every use, and the payloads differ per kind. The names live in `kind_name`.
//   1 identifier      2 Int literal      3 Decimal literal     4 String literal
//   10..49 punctuation                   100.. keywords
class Token {
    kind: Int,
    start: Int,
    length: Int,
    // Int literals: the value. Decimals: the unscaled integer, with `scale` places.
    value: Int,
    scale: Int,
    // A string literal containing `{` opens an interpolation; splitting the pieces
    // is the parser's job, so the lexer only classes that there is one.
    interpolated: Bool,
}

class Keyword { word: String, code: Int }
// ---- the AST -----------------------------------------------------------------
// Children by INDEX, not by pointer: v0.0.22 proved an arena needs no recursive
// types, and an index is a number a class field can hold.
//
// Expression kinds:
//   1 Int literal        2 Decimal literal      3 String literal    4 Bool literal
//   5 name               6 unary minus          7 not
//   8 binary (a op b, op in `value`)             9 comparison
//  10 logical            11 field access        12 index
//  13 call               14 method call
//  21 the value being returned, for a contract bracket on the return type
//  22 `e?` — the success payload, or return the failure from the enclosing function (inner in `a`)
// Type kinds:
//  40 Int  41 Bool  42 String  43 CInt  44 CDouble  51 CPointer
//  45 Decimal (scale in `a`, contract in `b`)   46 named   47 slice   48 array
//  49 dynamic   50 type parameter
//  A named type may be a generic APPLICATION: `a` is the start of its type-argument
//  nodes in `nested_children` and `b` is how many.
// Statement kinds:
//  60 let (name token in `token`, type in `a`, value in `b`, writable in `value`)
//  61 assign            62 print               63 return            64 tail return
//  65 if                66 while               67 break             68 continue
//  69 region            70 expression statement
//  71 match             72 for (name token in `token`, iterable in `a`, body in `b`)
class Node {
    kind: Int,
    // Child indices, or payload. Meaning depends on `kind`, documented above.
    a: Int,
    b: Int,
    c: Int,
    // The operator byte, a flag, or a literal's value — whatever the kind needs.
    value: Int,
    // The token this node started at, so a message can point at the source.
    token: Int,
}

// One compilation unit: its tokens, its keyword table, and its AST.
//
// `children` is where child LISTS live — the arguments of a call, the statements of a
// block. A node stores a start offset and a count into it, rather than a linked list
// through the nodes themselves.
//
// That is not a workaround for the two gaps found writing this file (Burxt has no
// `xs[i].field = v`, and no writing to a growable array element through a field): it
// is the better design regardless. Children pushed into a side array land
// CONTIGUOUSLY even though their subtrees interleave in `nodes`, so nothing needs
// back-patching, and a list is two integers instead of a chain of cells.
// A declared type: `Int`, `Decimal<2, RoundHalfEven>`, `[Int]`, a class name.
// A class rather than an enum, because it is compared and copied constantly and a
// payload enum would need a match at every use.
class Type {
    // The node kinds the parser produces: 40 Int, 41 Bool, 42 String, 43 CInt, 51 CPointer,
    // 44 CDouble, 45 Decimal, 46 named, 47 slice, 48 array, 49 dynamic,
    // 50 type PARAMETER. 0 is unknown, which never equals anything — including
    // another unknown.
    kind: Int,
    // Decimal: the scale. Slice or array: the ELEMENT type's node. A named type that
    // is a generic APPLICATION — `Option<Int>` — holds the start of its type arguments
    // in `nested_children`, and how many in `contract`; both are 0 for a plain named type, which
    // is why no field had to be added. Type arguments are node indices, exactly as a
    // slice's element already is.
    scale: Int,
    contract: Int,
    // For a named type or a parameter, the span of its name in the source. A parameter's
    // name is a real span — `T` is written down — which is the whole reason stage-1 can
    // hold generics at all without inventing names it cannot point at.
    name_start: Int,
    name_length: Int,
}

// A binding in scope: its name as a SPAN, so the checker allocates nothing to
// remember a variable.
// `in_region` is 1 when this name was declared while a `region` block was open, and it exists to
// answer one question: may region storage be assigned to this name?
//
// A name declared INSIDE the region may hold it — the value and the name die together at the
// closing brace, which is correct. A name declared outside may not: the bytes are released and the
// name then reads whatever the region hands out next. Stage-0 keeps the same fact as a
// `region_scope: HashSet<String>`; here it rides on the binding, which is cheaper and needs no
// second table to keep in step with this one.
//
// **It is on `Binding` rather than on `Unit` for a reason that is a constraint, not a preference:**
// a new `Unit` field would have to be added to the `Unit { ... }` literal in `main.bx`, and that
// file belongs to another change in flight. A `Binding` literal is only ever built where a name is
// declared, all of which is in `check.bx` and `parser.bx`. Fewer files, and the fact lives on the
// thing it is about.
// `holds_region` is 1 when this name was GIVEN region storage — its initializer, or a later
// assignment inside the region, built something in the region's bytes. Stage-0's `region_locals`,
// and the two marks answer different questions that are easy to conflate:
//
//   in_region     MAY this name hold region storage?      (declared inside the region)
//   holds_region  DOES it?                                (something built in the region went in)
//
// `holds_region` is what makes `return kept` a refusal after `kept` was filled in a region, and it
// is why `expr_allocates` has to treat a bare NAME as allocating: `let s = "a" + "b"; return s;`
// launders the built value through a binding, and a rule that only looked at the expression shape
// would see a plain name and wave it through. Set only while a region is open, exactly as stage-0
// only populates `region_locals` when `current_region.is_some()` — so an ordinary `let` outside a
// region is untouched and the allocation inference does not move.
class Binding { start: Int, length: Int, bound_type: Type, writable: Int, depth: Int,
                in_region: Int, holds_region: Int }
// What a type parameter stands for, while a generic's call is being checked. Its name is a
// SPAN, like every other name here, so a binding needs no synthesized identifier.
//
// Resolution is LAZY and shallow: nothing rewrites a `[T]` into a `[Int]`, because a slice
// holds its element as a node index and there would be no node to point at. Instead every
// recursive walk over types — comparison, rendering, layout — resolves each level as it
// reaches it. That is what lets stage-1 hold generics with no new arena entries at all.
class TypeBinding { name_start: Int, name_length: Int, bound: Type }

// The SUBJECT of a bracket contract, keyed by the clause node it belongs to.
//
// A side table rather than two more fields on the node, because a clause node's six slots are all
// spoken for — kind, condition, text start, text length, which clause, token. And a side table is
// what stage-1 reaches for whenever a declaration needs one more fact than a node can hold; see
// `generics` and `type_param_bounds`.
//
// `is_result` is 1 for a bracket on the RETURN type, where the subject is the word `result` and no
// program that writes the bracket form ever spells it — so there is no span, and the renderer uses
// the constant instead. That is the whole of the obstacle spec/M13 spent two versions on.
//
// `mode` says what the message has to DO, because the three bracket shapes differ:
//   0  written in full — `[balance > amount]`. The text already names its subject; only the
//      `requires`/`ensures` word has to go in front, because a bracket does not write one.
//   1  elided — `[> $0.00]`. The text starts at the operator, so the subject goes in front of it.
//   2  used `it` — `[it * 2 > 0]`. The text names a subject in the wrong spelling, so `it` is
//      replaced rather than prepended.
//
// `clause` is the clause's TEXT START, not its node index: two clauses cannot begin at the same byte,
// and the emitter is handed a Node rather than an index. A key that is already unique beats threading
// an extra argument through every call site.
class ClauseSubject { clause: Int, start: Int, length: Int, is_result: Int, mode: Int }

// Which declaration is generic over which parameters. A side table, looked up by name span
// like every other declaration here, because every field of a node is already spoken for.
// `type_param_start`/`type_param_count` index `type_parameters`, which holds the TOKEN of each parameter's name —
// so a parameter is a span, exactly as a class name or a variable is.
// One instantiation of a generic function: which declaration, and what its parameters stand
// for. Two calls with the same arguments are the same instance and share one machine function,
// which is what `find_instance` is for — otherwise a generic called twice would be defined
// twice and the linker would refuse the module.
class Instance { generic: Int, args_start: Int, args_count: Int }

class Generic { start: Int, length: Int, type_param_start: Int, type_param_count: Int }

// A declared function: its name span, its return type, and its parameter list node.
class DeclaredFunction { start: Int, length: Int, return_type: Type, parameters: Int, flags: Int }
// A declared record or enum: its name span and the item node that declared it.
class TypeDeclaration { start: Int, length: Int, kind: Int, node: Int }
// A declared method, keyed by the receiver's name and its own.
class Method {
    receiver_start: Int, receiver_length: Int,
    start: Int, length: Int,
    return_type: Type, parameters: Int, mutating: Int, flags: Int,
}

class Unit {
    tokens: [Token],
    keywords: [Keyword],
    nodes: [Node],
    children: [Int],
    // A SECOND child array, for lists nested inside another list: a match arm's
    // bindings, an enum variant's payload types, an interface signature's parameters.
    //
    // Not tidiness — correctness. Pushing bindings and arms into one array
    // interleaves them, and the design's whole premise is that a list is contiguous.
    // The first version did exactly that and indexed past the end; the cross-check
    // test caught it on tests/pass/enum_match_flow.bx.
    nested_children: [Int],
    // Top-level items, in source order, for the checker to walk.
    items: [Int],
    bindings: [Binding],
    functions: [DeclaredFunction],
    stack: [Int],
    methods: [Method],
    types: [TypeDeclaration],
    // Block depth, so a binding leaves scope at the closing brace.
    depth: Int,
    problems: Int,
    // Where the parser is in the token array.
    position: Int,
    // Nonzero while parsing an `if`/`while` condition, where a `{` opens the BODY
    // rather than a class literal. The Rust parser carries the same flag.
    impls: [Implementation],
    // Every expression's type, indexed by node. See check.bx's type_at for why it is
    // indexed rather than searched.
    typed: [Type],
    // How many regions are open, and whether the function being checked declared
    // `allocates` — which means the caller's region is the region in effect. Together
    // these answer M1's one question: is there somewhere to allocate?
    region_depth: Int,
    in_caller_region: Int,
    in_pure: Int,
    loop_depth: Int,
    in_contract: Int,
    in_ensures: Int,
    // The type parameters of the declaration being parsed, as TOKEN indices, so
    // `parse_type` can tell `T` from a class called `T`. Truncated when the
    // declaration ends. Token indices rather than spans because that is what the
    // parser has in hand, and one comparison away from the bytes either way.
    params_in_scope: [Int],
    // Every generic declaration, and the parameter-name tokens they index into.
    generics: [Generic],
    type_bindings: [TypeBinding],
    // One machine function per instantiation of a generic. This is the only part of generics
    // that genuinely needs a COPY: a layout is a cell count and resolves lazily, but a BODY
    // whose parameter may be one cell or four compiles to different instructions.
    //
    // Also the work list. Emitting `echo$Int` discovers that `identity$Int` is wanted, so the
    // list grows while it is being drained — which is what makes a generic calling a generic
    // work, and why draining is a `while` over a growing array rather than a `for`.
    // An index over `functions`, so declaring N functions is not N scans of a growing array.
    //
    //   function_buckets — 1024 slots, each the head of a chain, or -1 for empty
    //   function_chain   — parallel to `functions`: the next entry in the same bucket, or -1
    //
    // A chain and not open addressing, because entries are only ever added and the chain costs one
    // Int per function rather than a table that has to be grown and re-placed. Buckets are a power
    // of two so the fold is a `remainder` of a positive number, which is all `span_hash` promises.
    function_buckets: [Int],
    function_chain: [Int],
    // The `ensures` clauses of the function being emitted, as a range into `children`, plus the
    // name to quote. `ensures` fires at EVERY return — verified against stage-0, which checks each
    // return path rather than one exit — so the return statement needs them, and it is nowhere near
    // the signature that declared them.
    // `old(expr)` inside an `ensures`: the expression is evaluated at function ENTRY and read at the
    // return, so a conservation law can compare after against before. These two arrays are the
    // mapping from the `old` CALL NODE to the slot holding its entry value — parallel, because a
    // pair of Ints is cheaper than a class copied at every lookup.
    // The `decreases` measure of the function being emitted. A measure is checked in TWO places —
    // at entry it must not be negative, and at every recursive call the new measure must be
    // strictly smaller — so the call site needs to know about a clause written in the signature.
    //
    // Without the second check the guarantee does not merely fail to fire: the program recurses
    // until the stack goes. An unbounded loop is a worse answer than an error.
    measure_clause: Int,
    measure_slot: Int,
    measure_parameters: Int,
    measure_owner: String,
    old_nodes: [Int],
    old_slots: [Int],
    ensures_start: Int,
    ensures_count: Int,
    ensures_owner: String,
    // ---- M13: a contract written on the value it constrains ------------------------------
    //
    // `function f(p: Type [> 0, <= q]) -> T [>= 0]`. Pure sugar: each bracket is a `requires`, or an
    // `ensures` on the return type, with the SUBJECT synthesized in.
    //
    // The clause nodes cannot go on the scratch stack when they are parsed, because the stack is
    // holding the parameter list at that moment and `commit` would sweep them into it. So they are
    // collected here and prepended to the written clauses by `parse_clauses` — which also gives the
    // order stage-0 uses: brackets first, then what was written below.
    bracket_clauses: [Int],
    // A bracket clause's SUBJECT, which is not contiguous with its text: in
    // `balance: Decimal<2> [> $0.00]` the type sits between them, so no single span can spell
    // `balance > $0.00`. The same answer as v0.0.165's qualified names — a thing that is not one
    // span may still be two — and this is the second span.
    clause_subjects: [ClauseSubject],
    // What `it` stands for while a bracket clause is being parsed, and only then: the TOKEN of the
    // subject's name, or -1 outside a bracket, where `it` is an ordinary name.
    //
    // A token rather than a span, because a name node takes its name from its token like every other
    // name in the language — so `it` becomes a node pointing at where the parameter is written, and
    // every span comparison downstream then works with no new representation at all.
    //
    // Set and RESTORED around each clause. A capability left switched on is the bug shape stage-1's
    // first `current_receiver` had, and this one would make `it` mean the last parameter anywhere in
    // the program.
    it_token: Int,
    it_is_result: Int,
    // Two flags, not one. `used_it` is per CLAUSE, so the message knows whether to resolve one;
    // `it_seen` is per SIGNATURE, for the collision check — a parameter may still be called `it`,
    // and a bracket saying `it` on such a function is an error rather than a silent shadow.
    //
    // Stage-0's first attempt used one flag and computed "did this clause use it" as a CHANGE across
    // the clause. Since the flag has to survive for the collision check it is monotonic, so that
    // answered false for every clause after the first, and a return bracket with two `it` clauses
    // reported the second one unresolved.
    used_it: Int,
    it_seen: Int,
    // The return type's NODE while a signature's clauses are being checked, or -1 outside one. Node
    // kind 21 — `it` or the elided subject on a return bracket, meaning "the value being returned" —
    // answers this. A node rather than a Type, because a Type field would need a value in main.bx's
    // Unit literal and `declared_type` already turns a node into one.
    result_type_node: Int,
    // The slot holding the value being returned, while `ensures` clauses are emitted. Kind 21 loads
    // it directly, because the bracket form writes the word `result` nowhere and so has no span for
    // the ordinary name lookup to find. The longhand form still resolves through the span, and both
    // land on the same slot because `emit_ensures` declares exactly one.
    result_slot: Int,
    // The declared RETURN type's node of the function being emitted, or -1 outside one. A `return`
    // whose function answers with an interface has to build a fat pointer, and that is the fourth of
    // the four places a concrete value crosses into an interface object — the other three are a call
    // argument, a method argument and an associated function's argument.
    returns_node: Int,
    // The cycle guard for `embeds_by_value`: the declaration index of each type already entered while
    // deciding whether an enum contains itself by value. Truncated on the way out of each level, like
    // `type_bindings`. A field rather than a parameter because Burxt has no writable parameters.
    walked_types: [Int],
    // Where the CURRENT generic call's type bindings begin. `resolve_shallow` looks no further back
    // than this, which is what keeps a nested call to the same generic from seeing the enclosing
    // call's answer for `T`.
    //
    // Without it, `option_or(code(option_or(...)), 0)` bound T = Int for the outer call and then the
    // INNER call's `unify` found T already bound and refused to make it Colour. The bindings were
    // scoped correctly on the way OUT — a base taken before, truncated after — and not on the way
    // IN, which is the half nobody had needed until two calls to one generic nested.
    type_binding_floor: Int,
    // The effects the function being checked ADMITS, as a bitmask, and whose signature said so.
    //
    // ALL SIX at the top level — 63, every bit set — because top-level code may reach anything. There
    // is no signature there for a reviewer to read, since the file itself is what they are reading, so
    // nothing is hidden by allowing it; and forbidding it would mean no program could do I/O at its
    // entry point. docs/guide/06-effects.md states this as design, and stage-0 does the same.
    //
    // The first version here set 0 at the top level, reasoning that nothing declared means nothing
    // permitted — and stage-1 then refused its OWN source at `argument_count()`. The rule reads
    // plausibly and is wrong: it would make `touches` a tax on every program's entry point rather
    // than information in a signature.
    allowed_effects: Int,
    effects_owner: String,
    instances: [Instance],
    // The type arguments of every instance, laid end to end. `Instance` carries a start and a
    // count into this, the same shape `nested_children` and `type_parameters` use.
    instance_arguments: [Type],
    type_parameters: [Int],
    // Each parameter's bound, as the token of the interface's name, or -1 for none. Parallel to
    // `type_parameters`, because a parameter has exactly one bound and two arrays are cheaper
    // than a class that is copied at every lookup.
    type_param_bounds: [Int],
    // Bounds seen while a parameter list is being parsed, before the declaration is noted.
    pending_bounds: [Int],
    // Which generic declaration's body is being checked, or -1. A parameter's bound has to be
    // looked up in ITS OWN declaration: three generics may each call their parameter `T`, and
    // searching by name alone found the first one's bound for all of them.
    current_generic: Int,
    // Which function is being checked, so a `tail` call can be compared with the
    // signature it must replace. -1 at top level and inside a method.
    current_function: Int,
    // Which METHOD is being checked, as an index into `methods`. -1 unless a method body
    // is open. It exists for the same reason `current_function` does — something has to
    // know who to credit — and it arrived with the `allocates` inference, which credits a
    // method exactly as it credits a function.
    current_method: Int,
    // ---- working out `allocates` instead of asking for it (M14) --------------
    //
    // 1 during the probe rounds, which refuse nothing. While set, `has_region` classes
    // that something wanted a region and answers yes, so a round reaches the end of every
    // body instead of stopping at the first allocation — and `complain_at` says nothing,
    // because a probe's complaints are about a question it has not finished answering yet.
    probing: Int,
    // How many `allocates` flags this round newly set. Zero ends the fixpoint: the set only
    // grows, over a finite number of functions, so it has to stop growing.
    probe_changes: Int,
    // The backend's state: the IR text, the constants it referred to, a counter for
    // registers and one for labels, the locals' allocas, and the enclosing loops'
    // labels so `break` and `continue` know where to jump.
    chunks: [String],
    pending: String,
    globals: String,
    // The caller's storage for an aggregate return, while a function that has one is
    // being emitted, and how many cells it holds.
    sret: String,
    sret_cells: Int,
    function_entry: String,
    body_chunks: [String],
    body_pending: String,
    next_register: Int,
    next_slot: Int,
    next_label: Int,
    slots: [Slot],
    strings: [Int],
    // Extern symbols already declared in the emitted module, so a symbol two modules
    // both wrap is declared once.
    declared: [String],
    loop_condition_labels: [String],
    loop_end_labels: [String],
    in_function: Int,
    // Where the program's tokens end, which is not where the token ARRAY ends: an
    // interpolation fragment appends its own, and the parser must not walk into them.
    token_end: Int,
    no_record_literal: Int,
    // Set while typing the operands of `*`. Multiplication combines a quantity with a
    // rate, so its operand scales differ by nature: a literal that cannot narrow to
    // the result's scale keeps its own instead of being refused. Stage-0 reaches the
    // same answer by re-checking both operands with no expected type.
    in_multiply: Int,
    // Which stream the print statement being emitted goes to. A flag rather than a parameter
    // threaded through the formatter's eight writes, because none of those has any other reason to
    // know. Saved and restored around each statement, so nothing leaks into the next one.
    print_to_stderr: Int,
    // The node index of a synthetic `Int` type, created on demand so `c_bytes_at`'s `[Int]` result
    // can be spelled. A slice Type carries its ELEMENT's node index in `scale`, so a builtin that
    // answers `[Int]` needs a node to point at — and unlike a NAME, a node needs no source span:
    // `declared_type` maps kind 40 to Int and never looks at the token. That is the distinction the
    // four "needs a synthesized name" walls turned on, and it is why this is three lines rather than
    // a buffer. -1 until first asked for.
    int_type_node: Int,
    errors: Int,
    // M9: counters, so the hot path is measured rather than guessed at. The first attempt
    // at this milestone fixed the obvious quadratic and bought 1.5%, which is what a
    // hypothesis is worth here.
    type_of_calls: Int,
    find_binding_calls: Int,
    find_function_calls: Int,
    show_type_calls: Int,
    expr_allocates_calls: Int,
    type_at_calls: Int,
}

function is_alpha(b: Int) -> Bool {
    return (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || b == 95;
}

function is_digit(b: Int) -> Bool {
    return b >= 48 && b <= 57;
}

function is_name_byte(b: Int) -> Bool {
    return is_alpha(b) || is_digit(b);
}

function is_space(b: Int) -> Bool {
    return b == 32 || b == 9 || b == 10 || b == 13;
}

// The byte at `i`, or -1 if that is outside the range being lexed. The bound is
// PASSED rather than measured: `len` on a String is `strlen`, so asking for it here
// would walk the whole source on every single byte, and the lexer would cost the
// square of the file's size. It did, for eleven versions — 133 KB of comments took
// 36 seconds — and nothing about the code looked wrong, because the loop that pays
// is written the way everyone writes it: `while i < len(src)`.
//
// Passing the bound is also the more correct answer. Interpolation lexes a SLICE of
// the source, and a slice has no business peeking at the bytes after it.
function at_byte(src: String, i: Int, stop: Int) -> Int {
    if i < 0 || i >= stop {
        return -1;
    }
    return byte_at(src, i);
}

// Compare two spans of the source directly. The obvious way to write this is
// `span_equal(src, a, alen, substring(src, b, blen))` — and the compiler refused it,
// because `substring` allocates and a comparison has no business needing a region.
// Comparing in place is both cheaper and what the checker wanted anyway.
function spans_equal(src: String, a: Int, a_len: Int, b: Int, b_len: Int) -> Bool {
    if a_len != b_len {
        return false;
    }
    let mutable i: Int = 0;
    while i < a_len {
        if byte_at(src, a + i) != byte_at(src, b + i) {
            return false;
        }
        i += 1;
    }
    return true;
}

// Compare a span of the source against a whole word, without allocating.
function span_equal(src: String, start: Int, length: Int, word: String) -> Bool {
    if length != len(word) {
        return false;
    }
    let mutable i: Int = 0;
    while i < length {
        if byte_at(src, start + i) != byte_at(word, i) {
            return false;
        }
        i += 1;
    }
    return true;
}
