// ============================================================================
// layout.bx — `burxt layout <file.bx>`, written in Burxt. The counterpart of
// `layout_report` in `src/rust-compiler/codegen.rs`.
//
// It prints, for every declared class, its size and alignment and the byte offset of every
// field:
//
//     LineItem: size 24 align 8
//       +0 String (8 bytes)
//       +8 Decimal<2> (8 bytes)
//       +16 Int (8 bytes)
//
// ---- why a compiler ships this at all --------------------------------------------------
//
// `spec/A4.5-AGGREGATE-ABI.md` §3 is a DECISION, in those words: *"layout IS exactly the
// declared fields, no hidden header, ever — no type tag, no vtable pointer, no refcount, no
// hidden header word."* That is a promise a reader has to be able to CHECK, and this is how
// they check it. `codegen.rs` says the same thing about its own copy: *"this makes the
// no-hidden-header guarantee OBSERVABLE — the object model depends on it."*
//
// So the subject of this report is the LANGUAGE's object model, and that turns out to be the
// one decision this file had to get right before writing a line of it.
//
// ---- the decision: whose layout does `layout` report? ---------------------------------
//
// **The two compilers deliberately disagree about the ABI**, and say so. `codegen.rs`:
// *"A `Slice` is stage-0's three-field {ptr, len, cap} struct, which is three cells and NOT
// the one cell stage-1 uses — the two compilers agree on behaviour, never on ABI."* Measured,
// three ways:
//
//   |                | stage-0 `layout_of` | stage-1 `cells_of` |
//   | `[T]`          | 24 bytes, align 8   | 1 cell  = 8 bytes  |
//   | `dynamic Tr`   | 8 bytes             | 2 cells = 16 bytes |
//   | `CInt`         | 4 bytes, align 4    | 1 cell  = 8 bytes  |
//
// So there are two different true answers, and reporting stage-1's would put this file in
// disagreement with `burxt layout` on **20 of the 76 corpus sources that declare a class** —
// measured, not estimated — with neither side wrong.
//
// **This reports the SPEC's layout**, which is stage-0's, and the reason is not that parity is
// convenient. `A4.5` §3 says *"declared fields, standard alignment, no hidden header"* —
// standard alignment is a claim about the C-shaped layout a foreign caller sees, and it is the
// thing a reader wants checked. Stage-1's all-8-byte cell count is an INTERNAL representation
// of its own emitter, correct for its own code and not a statement about the object model;
// `A4.5` §4's forward note anticipates exactly that for a growable array. A `layout` that
// printed cell counts would be answering a different question than `burxt layout` answers, and
// then the two are not the same tool.
//
// **The cost, stated rather than buried:** this file does not describe the memory the
// Burxt-built backend actually lays out. If someone ever needs THAT, it is a different
// subcommand with a different name, not a quiet change of meaning here.
//
// ---- two size functions, and a third would be a bug -----------------------------------
//
// `layout_bytes` measures BYTES WITH ALIGNMENT — the report's subject. `layout_cells` counts
// 8-BYTE CELLS WITH NO PADDING, and exists for exactly one thing: an enum is a tag plus room
// for its widest variant, and that width is a cell count. `codegen.rs` carries the same pair
// (`layout_of` and `payload_cells`) for the same reason, above a comment that is worth quoting
// because it is a warning: *"One source of truth now. If a third size computation ever
// appears, it is this bug again."* Counting where it should have been measuring made
// `burxt.alloc` ask for 16 bytes for a 32-byte enum and corrupt whatever came next. So: two,
// each with one job, and the enum arm is the only place the second one is reached from.
//
// ---- the one thing it does NOT do, measured ---------------------------------------------
//
// **One source, `examples/generics.bx`, and it is the CHECKER rather than this file.** It writes
// `let held = Holder { one: 42 };` with NO annotation, so `Holder<Int>` is an instantiation that
// appears nowhere in the program — stage-0 infers it from the literal's field value. stage-1's
// checker cannot, and says so: *"cannot tell what Holder holds from this value: write the type,
// as in `let x: Holder<Int> = ...`"*. It refuses the whole program with four errors, so `layout`
// answers 1 where `burxt layout` answers 0.
//
// Isolated by measurement rather than argued: with the checker's verdict ignored, this file
// reproduces three of that program's four rows byte-identically and misses exactly one —
// `Holder$Int`, the instantiation that exists only by inference. So the gap is a front-end
// capability (generic arguments inferred from a record literal), not a layout defect, and it
// closes in `check.bx` for every tool at once rather than here.
//
// Everything else about generics IS handled, and it took more than mangling. See `layout_print`
// for the depth-first walk and why `map_library.bx` is the fixture that forced it: `Map<K, V>`
// has a field of type `[MapEntry<K, V>]`, so `MapEntry$String$Int` is an instantiation the
// program never writes and stage-0 creates while substituting.
//
// **A diagnostic.** A program that does not typecheck exits 1 with nothing on stdout, which is
// what `burxt layout` does — but the WORDING of the refusal is stage-1's, and converging the
// two compilers' diagnostics is its own task (task 15: 2 of 231 identical today). This file
// makes no attempt at it and does not pretend to.
//
// ---- the stream, checked per line ------------------------------------------------------
//
// `main.rs` reaches this through `print!("{}", cg.layout_report(&typed))` — **stdout**, with
// `print!` and not `println!`, because every line of the report already ends in a newline. On
// success it prints nothing at all on stderr, and a program with no class prints nothing at
// all anywhere and exits 0. All three were measured, not assumed; the same check caught the two
// compilers disagreeing on a program with no errors in v0.0.220.
//
// ---- dependencies ----------------------------------------------------------------------
//
// `emit.bx` is a FORCED dependency and not a choice: `Unit` has a field `slots: [Slot]` and
// `Slot` is declared in `emit.bx`, so anything that can spell `Unit` links the code generator.
// Reported by `review.bx` before this and worth repeating — `Slot` belongs in `ast.bx`, and
// moving it would let every tool read an AST without the backend.
//
// `check.bx` is needed for more than `show_type`: the type TABLE is what tells a class from an
// enum, and what turns a bare interface name into `dynamic Priced`. That table is filled by
// `check`, so unlike `review.bx` — which must NOT typecheck, to stay byte-identical — this one
// must. The two files reaching opposite conclusions from the same question is the useful kind
// of asymmetry: it follows from what each report is about.
// ============================================================================

use "ast.bx";
use "lexer.bx";
use "parser.bx";
use "check.bx";
use "modules.bx";
use "emit.bx";

// Round `value` up to a multiple of `to`, which is what padding a field to its own alignment
// means. `to` is a power of two here — 1, 4 or 8 — but the arithmetic does not need it to be,
// and `divide_floor` is exact, so this is the same expression `codegen.rs` writes as
// `(size + align - 1) / align * align`.
pure function round_up(value: Int, to: Int) -> Int {
    if to <= 1 {
        return value;
    }
    return divide_floor(value + to - 1, to) * to;
}

// How many 8-BYTE CELLS a value occupies with no padding anywhere.
//
// Reached only from the enum arm of `layout_bytes` — see the header on why there are two of
// these and why a third would be a returning bug. It mirrors `payload_cells` in `codegen.rs`
// arm for arm, including the two places it parts company with `layout_bytes`: a slice is
// THREE cells here (stage-0's {ptr, len, cap}) and an interface object is TWO (data plus
// vtable), where the byte layout calls them 24 and 8.
function (mutable self: Unit) layout_cells(src: String, given: Type) -> Int {
    let written: Type = self.resolve_shallow(src, given);
    if written.kind == 47 {                          // [T] — {ptr, len, cap}
        return 3;
    }
    if written.kind == 49 {                          // dynamic Trait — {data, vtable}
        return 2;
    }
    if written.kind == 48 {                          // [T; N]
        return written.contract
               * self.layout_cells(src, self.declared_type(src, written.scale));
    }
    if written.kind == 46 {
        let found: Int = self.find_type(src, written.name_start, written.name_length);
        if found < 0 {
            return 1;
        }
        let declaration: TypeDeclaration = self.types[found];
        let item: Node = self.nodes[declaration.node];
        // A generic's fields are sized with its ARGUMENTS in scope, and nothing is rewritten:
        // `Pair<Int>` is 2 cells and `Pair<Point>` is 4 from one declaration read twice. Bound
        // AFTER the two refusals above, so every path that binds also truncates.
        let restore: Int = self.bind_from_application(src, written);
        if declaration.kind == 82 {                  // a class: the sum of its fields
            let mutable total: Int = 0;
            let mutable f: Int = 0;
            while f < item.b {
                let field: Node = self.nodes[self.children[item.a + f]];
                total += self.layout_cells(src, self.declared_type(src, field.a));
                f += 1;
            }
            let dropped: Int = truncate(self.type_bindings, restore);
            return total;
        }
        if declaration.kind == 83 {                  // an enum: a tag plus the widest variant
            let widest: Int = self.layout_widest_variant(src, item);
            let dropped: Int = truncate(self.type_bindings, restore);
            return 1 + widest;
        }
        let dropped: Int = truncate(self.type_bindings, restore);
        return 1;
    }
    // Int, Bool, Decimal, String, CInt, CDouble, CPointer, a type parameter — one cell each.
    // CInt is ONE CELL here and FOUR BYTES in `layout_bytes`, exactly as `codegen.rs` has it:
    // inside an enum's payload area everything is cell-aligned, and only the byte layout of a
    // class has a reason to pack it narrower.
    return 1;
}

// The payload area of an enum, in cells: the widest variant, where a variant's width is the
// sum of its payload types.
//
// A separate function only because the class arm above and the enum arm below both want it and
// a `while` inside a `while` inside an `if` is where a reader loses the thread.
function (mutable self: Unit) layout_widest_variant(src: String, item: Node) -> Int {
    let mutable widest: Int = 0;
    let mutable v: Int = 0;
    while v < item.b {
        let variant: Node = self.nodes[self.children[item.a + v]];
        let mutable carried: Int = 0;
        let mutable p: Int = 0;
        while p < variant.c {
            carried += self.layout_cells(src,
                           self.declared_type(src, self.nested_children[variant.b + p]));
            p += 1;
        }
        if carried > widest {
            widest = carried;
        }
        v += 1;
    }
    return widest;
}

// A type's natural alignment in bytes.
//
// Everything in this language is 8-byte aligned except `CInt`, which is C's 32-bit int and
// exists only so that an FFI boundary can be honest about width — and an array, which aligns
// like its element. A class aligns like its widest-aligning field, which for a class of `CInt`
// alone is 4 and otherwise 8.
function (mutable self: Unit) layout_align(src: String, given: Type) -> Int {
    let written: Type = self.resolve_shallow(src, given);
    if written.kind == 43 {                          // CInt
        return 4;
    }
    if written.kind == 48 {                          // [T; N] aligns like its element
        return self.layout_align(src, self.declared_type(src, written.scale));
    }
    if written.kind == 46 {
        let found: Int = self.find_type(src, written.name_start, written.name_length);
        if found < 0 {
            return 8;
        }
        let declaration: TypeDeclaration = self.types[found];
        if declaration.kind != 82 {
            return 8;                                // an enum is a run of cells
        }
        let item: Node = self.nodes[declaration.node];
        let restore: Int = self.bind_from_application(src, written);
        let mutable widest: Int = 1;
        let mutable f: Int = 0;
        while f < item.b {
            let field: Node = self.nodes[self.children[item.a + f]];
            let mine: Int = self.layout_align(src, self.declared_type(src, field.a));
            if mine > widest {
                widest = mine;
            }
            f += 1;
        }
        let dropped: Int = truncate(self.type_bindings, restore);
        return widest;
    }
    return 8;
}

// A type's size in bytes, per `spec/A4.5-AGGREGATE-ABI.md` §3: the declared fields, standard
// alignment, and no hidden header.
//
// A class is walked field by field — pad up to the field's own alignment, place it, advance —
// and then the whole aggregate is rounded up to its own alignment, which is what makes an
// array of it correctly strided. Identical to `layout_of` in `codegen.rs`, arm for arm.
//
// A String is EIGHT, and that is the one number here that is a target fact rather than a
// language one: stage-0 asks LLVM for the pointer width. Every target this compiler builds for
// is 64-bit, so 8 is right today and would be wrong on a 32-bit one — where stage-0 would say
// 4 and this would still say 8. Named because it is the only place the two could drift without
// anybody changing either file.
function (mutable self: Unit) layout_bytes(src: String, given: Type) -> Int {
    let written: Type = self.resolve_shallow(src, given);
    if written.kind == 47 {                          // [T] — {ptr, len, cap}
        return 24;
    }
    if written.kind == 43 {                          // CInt
        return 4;
    }
    if written.kind == 48 {                          // [T; N] — stride times length
        let element: Type = self.declared_type(src, written.scale);
        let stride: Int = round_up(self.layout_bytes(src, element),
                                  self.layout_align(src, element));
        return stride * written.contract;
    }
    if written.kind == 46 {
        let found: Int = self.find_type(src, written.name_start, written.name_length);
        if found < 0 {
            return 8;
        }
        let declaration: TypeDeclaration = self.types[found];
        let item: Node = self.nodes[declaration.node];
        let restore: Int = self.bind_from_application(src, written);
        if declaration.kind == 83 {                  // an enum: a tag plus the widest variant
            let widest: Int = self.layout_widest_variant(src, item);
            let dropped: Int = truncate(self.type_bindings, restore);
            return 8 * (1 + widest);
        }
        if declaration.kind != 82 {
            let dropped: Int = truncate(self.type_bindings, restore);
            return 8;
        }
        let mutable size: Int = 0;
        let mutable f: Int = 0;
        while f < item.b {
            let field: Node = self.nodes[self.children[item.a + f]];
            let mine: Type = self.declared_type(src, field.a);
            size = round_up(size, self.layout_align(src, mine));
            size += self.layout_bytes(src, mine);
            f += 1;
        }
        let whole: Int = round_up(size, self.layout_align(src, written));
        let dropped: Int = truncate(self.type_bindings, restore);
        return whole;
    }
    // Int, Bool, Decimal, CDouble, CPointer, dynamic, a type parameter — and String, per the
    // note above. `dynamic` is EIGHT here and two cells in `layout_cells`, because that is what
    // `layout_of` answers: its `_` arm catches `Dyn` and gives it one word.
    return 8;
}

// ---- monomorphised names -------------------------------------------------------------
//
// `burxt layout` reports a generic class once per INSTANTIATION, under the mangled name the
// typechecker gave it: `Pair$Int`, `Nested$Point`, `Box$Box_Int`. So this file has to spell
// those names, and the rule is `mangle` in `typeck.rs`:
//
//   > the name, then for each argument a `$` and the argument RENDERED AS THE AUTHOR WOULD
//   > WRITE IT, with every byte that is not a letter or a digit replaced by `_`.
//
// That is why `Decimal<2>` becomes `Decimal_2_` and `[Int]` becomes `_Int_`. And it is why a
// nested application composes: by the time `Box<Box<Int>>` is named, its argument is already
// the instantiation `Box$Int`, whose `$` is not alphanumeric — so it flattens to `Box_Int` and
// the whole is `Box$Box_Int`. Measured against the fixture rather than derived from the source.
//
// **stage-1 mangles differently on purpose** — `emit.bx`'s `mangle_type` builds `Decimal2r0` and
// `slice.Int` — and neither is wrong, because a symbol is internal. This report prints a name,
// so it prints stage-0's. Reusing `mangle_type` would have been the plausible wrong move.

// Every byte that is not a letter or a digit becomes `_`. ASCII-only, which is exact here: the
// input is a rendered type, and a type's name comes from an identifier, which `is_alpha` admits
// only ASCII into.
pure function layout_flatten(text: String) -> String {
    let mutable out: String = "";
    let mutable i: Int = 0;
    while i < len(text) {
        let b: Int = byte_at(text, i);
        if (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) {
            out = out + substring(text, i, 1);
        } else {
            out = out + "_";
        }
        i += 1;
    }
    return out;
}

// A type as this report names it: the mangled instantiation name for a generic class applied to
// arguments, and what the author wrote for everything else.
//
// The recursion resolves at every level, like `layout_cells` and like `mangle_type` — so a field
// of type `Pair<T>` inside `Nested<Point>` names itself `Pair$Point`, with `T` looked up rather
// than substituted. That laziness is the whole reason stage-1 needs no new arena nodes for a
// generic, and it is what lets this name one without inventing a declaration.
function (self: Unit) layout_type_name(src: String, given: Type) -> String {
    let written: Type = self.resolve_shallow(src, given);
    // A slice or an array is rendered by RECURSING rather than by `show_type`, and that is not
    // tidiness: `show_type` renders a slice's element straight from its node, so a `[T]` inside
    // `Bag<String>` came out as `[T]` — the binding in scope never consulted. `mangle_type` in
    // `emit.bx` resolves at every level for exactly this reason.
    if written.kind == 47 {
        return "[" + self.layout_type_name(src, self.declared_type(src, written.scale)) + "]";
    }
    if written.kind == 48 {
        return "[" + self.layout_type_name(src, self.declared_type(src, written.scale)) + "; "
               + to_string(written.contract) + "]";
    }
    if written.kind != 46 || written.contract <= 0 {
        return self.show_type(src, written);
    }
    if self.generic_named(src, written.name_start, written.name_length) < 0 {
        return self.show_type(src, written);
    }
    let mutable out: String = substring(src, written.name_start, written.name_length);
    let mutable i: Int = 0;
    while i < written.contract {
        let argument: Type = self.declared_type(src, self.nested_children[written.scale + i]);
        out = out + "$" + layout_flatten(self.layout_type_name(src, argument));
        i += 1;
    }
    return out;
}

// Are all of this application's arguments CONCRETE?
//
// `class Nested<T> { inner: Pair<T>, tag: Int }` puts a `Pair<T>` node in the arena, and that is
// not an instantiation of anything — stage-0 makes a record only when it has real arguments, so
// `Pair$T` is a row `burxt layout` never prints. It printed three of them before this existed.
//
// Asked AFTER `resolve_shallow`, so an argument that is a parameter with a binding in scope
// counts as concrete: inside `Nested<Point>`, `Pair<T>`'s argument resolves to Point.
function (self: Unit) layout_is_concrete(src: String, applied: Type) -> Bool {
    let mutable i: Int = 0;
    while i < applied.contract {
        let argument: Type = self.resolve_shallow(src,
                                 self.declared_type(src, self.nested_children[applied.scale + i]));
        if argument.kind == 50 {
            return false;
        }
        if argument.kind == 46 && argument.contract > 0 {
            if !self.layout_is_concrete(src, argument) {
                return false;
            }
        }
        i += 1;
    }
    return true;
}

// ---- which instantiations, and in what order ------------------------------------------
//
// `typeck.rs` assembles the report's subject as `structs.extend(made_record_order)`: **every
// non-generic class first, in declaration order, then every instantiation in the order the
// checker created it.** Measured on a fixture written for the purpose — two generic and two
// plain classes interleaved — because reading it off the source would have been a guess about
// which pass runs when.
//
// The creation order falls out of the ARENA for free, and this is the nice part. A type node's
// arguments are parsed before the node itself, so an application has a HIGHER index than its
// arguments; and nodes are created in source order. So walking type nodes by ascending index
// visits every application in source order, inner before outer — which is exactly the order a
// checker instantiating depth-first as it walks statements produces. `Nested<Point>` therefore
// lands after the `Pair<Point>` that an earlier line already asked for, and `Box<Box<Int>>`
// after `Box<Int>`, with no dependency pass of its own.
//
// Deduplicated by the mangled NAME rather than by node, because two source positions writing
// `Pair<Int>` are one instantiation — the report shows it once.
// (The walk itself is INLINED into `layout_print` below. It wants to fill a caller's array and
// to be a method on `Unit` at the same time, and Burxt allows a `mutable` parameter only on a
// free function — so it is one loop in the one place that needs it rather than a Unit field
// nothing else would ever read.)

// Bind a generic declaration's parameters to argument types held in an array rather than read
// from an application node.
//
// `bind_from_application` in `check.bx` binds from a NODE, which is what the checker and the
// emitter always have. An instantiation discovered by substitution has no node: nobody writes
// `MapEntry<String, Int>` anywhere in `map_library.bx` — it exists because `Map<String, Int>`
// has a field of type `[MapEntry<K, V>]`. So its arguments live in an array, and this is the
// same binding from the other direction. Answers the base to truncate back to.
function (mutable self: Unit) layout_bind_args(src: String, name_start: Int, name_length: Int,
                                              held: [Type], from: Int, count: Int) -> Int {
    let base: Int = len(self.type_bindings);
    let generic: Int = self.generic_named(src, name_start, name_length);
    if generic < 0 {
        return base;
    }
    let declaration: Generic = self.generics[generic];
    let mutable i: Int = 0;
    while i < declaration.type_param_count && i < count {
        let named: Token = self.tokens[self.type_parameters[declaration.type_param_start + i]];
        push(self.type_bindings, TypeBinding { name_start: named.start,
                                              name_length: named.length, bound: held[from + i] });
        i += 1;
    }
    return base;
}

// The mangled name of an instantiation whose arguments are held in an array — the naming half of
// the same asymmetry `layout_bind_args` describes.
function (self: Unit) layout_name_with(src: String, name_start: Int, name_length: Int,
                                      held: [Type], from: Int, count: Int) -> String {
    let mutable out: String = substring(src, name_start, name_length);
    let mutable i: Int = 0;
    while i < count {
        out = out + "$" + layout_flatten(self.layout_type_name(src, held[from + i]));
        i += 1;
    }
    return out;
}

// One class's rows: the header line, then a line per field. `holder` is the type to size, and
// `name` is what to call it — the two differ for an instantiation, which is sized as
// `Pair<Point>` and called `Pair$Point`.
function (mutable self: Unit) layout_one(src: String, name: String, holder: Type,
                                        item: Node) -> Int {
    print(name + ": size " + to_string(self.layout_bytes(src, holder)) + " align "
          + to_string(self.layout_align(src, holder)));
    let restore: Int = self.bind_from_application(src, holder);
    let mutable offset: Int = 0;
    let mutable f: Int = 0;
    while f < item.b {
        let field: Node = self.nodes[self.children[item.a + f]];
        let mine: Type = self.declared_type(src, field.a);
        offset = round_up(offset, self.layout_align(src, mine));
        print("  +" + to_string(offset) + " " + self.layout_type_name(src, mine)
              + " (" + to_string(self.layout_bytes(src, mine)) + " bytes)");
        offset += self.layout_bytes(src, mine);
        f += 1;
    }
    let dropped: Int = truncate(self.type_bindings, restore);
    return f;
}

// Is this class's declaration generic? A generic class is skipped, for the reason in the
// header: `burxt layout` prints its INSTANTIATIONS under a mangling this side spells
// differently, and printing the uninstantiated declaration would be a row the Rust build never
// emits. Looked up by name span in `self.generics`, which is where `note_generic` put it.
function (self: Unit) layout_is_generic(src: String, name: Token) -> Bool {
    let mutable i: Int = 0;
    while i < len(self.generics) {
        let declaration: Generic = self.generics[i];
        if declaration.type_param_count > 0
           && spans_equal(src, declaration.start, declaration.length,
                          name.start, name.length) {
            return true;
        }
        i += 1;
    }
    return false;
}

// The report itself.
//
// Two passes, because that is the order `typeck.rs` assembles it in — `structs.extend(
// made_record_order)`: **every NON-GENERIC class in declaration order, then every INSTANTIATION
// in the order the checker created it.** Measured on a fixture written for the purpose, two
// generic and two plain classes interleaved, because reading it off the source would have been a
// guess about which pass runs when. A generic DECLARATION is never printed: by the time
// `layout_report` runs, the typechecker has replaced every application with a `Named` type.
//
// Enums are absent from both passes — `layout_report` walks `prog.structs`. An enum has no field
// offsets, so there is nothing for the no-hidden-header guarantee to be observable ABOUT; its
// size still shows up wherever a class holds one.
//
// ---- why the instantiation walk is a DEPTH-FIRST one with an explicit stack ---------------
//
// The seeds are easy: every generic application WRITTEN in the program, which is every kind-46
// node with arguments, and walking nodes by ascending index gives source order with a node's
// arguments before the node — so `Box<Int>` precedes `Box<Box<Int>>` for free.
//
// The seeds are not enough, and `map_library.bx` is the proof. `Map<K, V>` has a field of type
// `[MapEntry<K, V>]`, so `MapEntry$String$Int` is an instantiation the program NEVER WRITES —
// it exists only because `Map<String, Int>` does. Stage-0 creates it while substituting, which
// is why its report has six classes where a scan of the source finds three.
//
// And the order those come out in is DFS, not by layer: `MapEntry$String$Int`, `Map$String$Int`,
// `MapEntry$Int$Int`, `Map$Int$Int`, ... — each dependency immediately before its dependent. A
// worklist that appended everything ready-to-go each round would have grouped all three
// `MapEntry`s first and been wrong in a way that only shows up on a program with two
// instantiations of one nested generic. So: post-order DFS, dependencies emitted first.
//
// It is ITERATIVE with an explicit stack rather than recursive, and that is the language rather
// than taste: a recursive walk would have to hand its growing list to itself, Burxt allows a
// `mutable` parameter only on a free function, and every step here needs `Unit`'s arena. An
// explicit stack keeps all of it local to the one function that has both.
function (mutable self: Unit) layout_print(src: String) -> Int {
    let mutable shown: Int = 0;
    let mutable i: Int = 0;
    while i < len(self.items) {
        let item: Node = self.nodes[self.items[i]];
        if item.kind == 82 {
            let named: Token = self.tokens[item.token];
            if !self.layout_is_generic(src, named) {
                // A class ITEM is not a type node, so the holder is built from the name span:
                // kind 46 with no arguments, which is what a plain class name is.
                let whole: Type = Type { kind: 46, scale: 0, contract: 0,
                                        name_start: named.start, name_length: named.length };
                let fields: Int = self.layout_one(src,
                                     substring(src, named.start, named.length), whole, item);
                shown += 1;
            }
        }
        i += 1;
    }

    // Each pending or finished instantiation, as (declaration, arguments): the class's name span,
    // and a range into `held`. Four parallel arrays and not a class, because a class holding
    // arrays cannot be handed to a helper here anyway — see the header note on `mutable`.
    let mutable done_start: [Int] = [];
    let mutable done_length: [Int] = [];
    let mutable done_from: [Int] = [];
    let mutable done_count: [Int] = [];
    let mutable done_name: [String] = [];
    let mutable held: [Type] = [];
    // The DFS stack, parallel the same way, plus `opened`: 0 means its dependencies have not been
    // pushed yet, 1 means they have and the next visit emits it. The two-visit shape is what
    // makes this post-order without recursion.
    let mutable stack_start: [Int] = [];
    let mutable stack_length: [Int] = [];
    let mutable stack_from: [Int] = [];
    let mutable stack_count: [Int] = [];
    let mutable opened: [Int] = [];

    let mutable node: Int = 0;
    while node < len(self.nodes) {
        let n: Node = self.nodes[node];
        // Kind 46 with arguments is a generic APPLICATION. `declared_type` turns the node into
        // the Type carrying them, and it also maps a bare interface name to `dynamic`, which
        // cannot be a generic class and so falls out here.
        if n.kind == 46 && n.b > 0 {
            let applied: Type = self.declared_type(src, node);
            if applied.kind == 46
               && self.generic_named(src, applied.name_start, applied.name_length) >= 0 {
                let declared: Int = self.find_type(src, applied.name_start, applied.name_length);
                if declared >= 0 && self.types[declared].kind == 82
                   && self.layout_is_concrete(src, applied) {
                    // Seeded onto the stack with its arguments copied into `held`, so that a seed
                    // and a discovered dependency are the same shape from here on.
                    let from: Int = len(held);
                    let mutable a: Int = 0;
                    while a < applied.contract {
                        push(held, self.resolve_shallow(src,
                                 self.declared_type(src, self.nested_children[applied.scale + a])));
                        a += 1;
                    }
                    push(stack_start, applied.name_start);
                    push(stack_length, applied.name_length);
                    push(stack_from, from);
                    push(stack_count, applied.contract);
                    push(opened, 0);
                }
            }
        }
        node += 1;
    }

    // The stack is currently the seeds in source order, and a stack pops from the END — so it is
    // reversed once here rather than being built backwards, which would have made the scan above
    // read against the grain.
    let mutable lo: Int = 0;
    let mutable hi: Int = len(stack_start) - 1;
    while lo < hi {
        let s0: Int = stack_start[lo];  let l0: Int = stack_length[lo];
        let f0: Int = stack_from[lo];   let c0: Int = stack_count[lo];
        stack_start[lo] = stack_start[hi];   stack_length[lo] = stack_length[hi];
        stack_from[lo] = stack_from[hi];     stack_count[lo] = stack_count[hi];
        stack_start[hi] = s0;  stack_length[hi] = l0;
        stack_from[hi] = f0;   stack_count[hi] = c0;
        lo += 1;
        hi -= 1;
    }

    while len(stack_start) > 0 {
        let top: Int = len(stack_start) - 1;
        let name_start: Int = stack_start[top];
        let name_length: Int = stack_length[top];
        let from: Int = stack_from[top];
        let count: Int = stack_count[top];
        let name: String = self.layout_name_with(src, name_start, name_length, held, from, count);

        // Already emitted? Two source positions writing `Pair<Int>` are one instantiation, and a
        // dependency shared by two dependents is one too.
        let mutable seen: Bool = false;
        let mutable d: Int = 0;
        while d < len(done_name) {
            if done_name[d] == name {
                seen = true;
            }
            d += 1;
        }
        if seen {
            let cut: Int = truncate(stack_start, top);
            let cut2: Int = truncate(stack_length, top);
            let cut3: Int = truncate(stack_from, top);
            let cut4: Int = truncate(stack_count, top);
            let cut5: Int = truncate(opened, top);
            continue;
        }

        if opened[top] == 0 {
            opened[top] = 1;
            // Its dependencies: every field type that is itself a concrete generic class
            // application once this instantiation's arguments are in scope. Pushed AFTER this
            // entry, so they pop — and emit — first.
            let declared: Int = self.find_type(src, name_start, name_length);
            if declared >= 0 {
                let item: Node = self.nodes[self.types[declared].node];
                let restore: Int = self.layout_bind_args(src, name_start, name_length,
                                                        held, from, count);
                let mutable f: Int = 0;
                while f < item.b {
                    let field: Node = self.nodes[self.children[item.a + f]];
                    // Through a slice or an array too: `Map`'s entries are `[MapEntry<K, V>]`,
                    // and the instantiation is inside the brackets.
                    let mutable inner: Type = self.resolve_shallow(src,
                                                  self.declared_type(src, field.a));
                    while inner.kind == 47 || inner.kind == 48 {
                        inner = self.resolve_shallow(src, self.declared_type(src, inner.scale));
                    }
                    if inner.kind == 46 && inner.contract > 0
                       && self.generic_named(src, inner.name_start, inner.name_length) >= 0
                       && self.layout_is_concrete(src, inner) {
                        let sub: Int = self.find_type(src, inner.name_start, inner.name_length);
                        if sub >= 0 && self.types[sub].kind == 82 {
                            let at: Int = len(held);
                            let mutable a: Int = 0;
                            while a < inner.contract {
                                push(held, self.resolve_shallow(src, self.declared_type(src,
                                             self.nested_children[inner.scale + a])));
                                a += 1;
                            }
                            push(stack_start, inner.name_start);
                            push(stack_length, inner.name_length);
                            push(stack_from, at);
                            push(stack_count, inner.contract);
                            push(opened, 0);
                        }
                    }
                    f += 1;
                }
                let dropped: Int = truncate(self.type_bindings, restore);
            }
            continue;
        }

        // Second visit: every dependency is emitted, so this one is next.
        let declared: Int = self.find_type(src, name_start, name_length);
        if declared >= 0 {
            let item: Node = self.nodes[self.types[declared].node];
            let restore: Int = self.layout_bind_args(src, name_start, name_length,
                                                    held, from, count);
            let whole: Type = Type { kind: 46, scale: 0, contract: 0,
                                    name_start: name_start, name_length: name_length };
            let fields: Int = self.layout_one(src, name, whole, item);
            let dropped: Int = truncate(self.type_bindings, restore);
            shown += 1;
        }
        push(done_name, name);
        push(done_start, name_start);
        push(done_length, name_length);
        push(done_from, from);
        push(done_count, count);
        let cut: Int = truncate(stack_start, top);
        let cut2: Int = truncate(stack_length, top);
        let cut3: Int = truncate(stack_from, top);
        let cut4: Int = truncate(stack_count, top);
        let cut5: Int = truncate(opened, top);
    }
    return shown;
}

// `burxt layout <file.bx>`: the front end, then the report. Answers the exit code — 0 when it
// reported, 1 when the program does not compile — so the caller is a guard and an `exit`, the
// same shape `mcp_schema` and `review` take.
//
// The whole front end runs first, including `check`, because a layout is only meaningful for a
// program that is legal: a field whose type does not exist has no size. `burxt layout` reaches
// the report through the same path for the same reason, and a program with no class at all is
// silent and successful in both.
function layout(path: String) -> Int touches files {
    let src: String = load_program(path);
    let mutable unit: Unit = Unit { tokens: [], keywords: [], nodes: [], children: [], nested_children: [], items: [], bindings: [], consts: [], functions: [], stack: [], methods: [], types: [], params_in_scope: [], generics: [], type_parameters: [], type_param_bounds: [], pending_bounds: [], current_generic: 0 - 1, current_method: 0 - 1, probing: 0, probe_changes: 0, grow_parameters: [], grow_self: [], type_bindings: [], measure_clause: 0 - 1, measure_slot: 0, measure_parameters: 0 - 1, measure_owner: "", old_nodes: [], old_slots: [], ensures_start: 0, ensures_count: 0, ensures_owner: "", bracket_clauses: [], clause_subjects: [], it_token: 0 - 1, it_is_result: 0, used_it: 0, it_seen: 0, result_type_node: 0 - 1, result_slot: 0 - 1, returns_node: 0 - 1, walked_types: [], type_binding_floor: 0, allowed_effects: 63, effects_owner: "", function_buckets: [], function_chain: [], instances: [], instance_arguments: [], impls: [], typed: [], region_depth: 0, region_token: 0 - 1, in_caller_region: 0, in_pure: 0, loop_depth: 0, in_contract: 0, in_ensures: 0, current_function: -1, chunks: [], pending: "", globals: "", global_chunks: [], sret: "", sret_cells: 0, function_entry: "", body_chunks: [], body_pending: "", next_register: 0, next_slot: 0, next_label: 0, slots: [], strings: [], declared: [], loop_condition_labels: [], loop_end_labels: [], region_mark: "", region_loop_depth: 0, in_function: 0, depth: 0, problems: 0, diagnose: 0, problem_start: 0 - 1, problem_length: 0, problem_message: "", position: 0, token_end: 0, no_record_literal: 0, in_extern_signature: 0, range_bounds: 0, in_multiply: 0, print_to_stderr: 0, int_type_node: 0 - 1, errors: 0, type_of_calls: 0, find_binding_calls: 0, find_function_calls: 0, show_type_calls: 0, expr_allocates_calls: 0, type_at_calls: 0 };
    let installed: Int = unit.install_keywords();
    let total: Int = unit.run(src);
    if unit.errors > 0 {
        return 1;
    }
    while !unit.done() {
        let item: Int = unit.parse_item(src);
        if item < 0 {
            return 1;
        }
        push(unit.items, item);
    }
    if unit.errors > 0 {
        return 1;
    }
    let problems: Int = unit.check(src);
    if problems > 0 || unit.errors > 0 {
        return 1;
    }
    let shown: Int = unit.layout_print(src);
    return 0;
}
