// ============================================================================
// modules.bx — part of the Burxt compiler, written in Burxt.
//
// `use "path";`, resolved before lexing and blanked out afterwards.
//
// Assembled by src/burxt-compiler/main.bx, which is the program; everything here is
// declarations, which is what a module may hold.
// ============================================================================

// =============================================================================
// MODULES: `use "path";` resolved before lexing.
//
// The imports are found by scanning the LEADING lines of a file — blank lines,
// comments and `use` lines, stopping at the first item — and then blanked out:
// replaced by spaces of the same length, so every byte offset after them is
// unchanged and the lexer, parser and typechecker learn nothing about modules.
//
// Stage-0 does exactly this, and the two must agree: a program that compiles with
// one and not the other is the disagreement the differential test exists to catch.
// =============================================================================

// The bound is passed, not measured. `len` on a String is `strlen`, so leaving it in
// this condition walks the whole file on every byte, and reading a file's header costs
// the square of the file's size. See at_byte in ast.bx — the same shape, found the
// same way, at the same time.
function end_of_line(text: String, from: Int, width: Int) -> Int {
    let mutable i: Int = from;
    while i < width && byte_at(text, i) != 10 {
        i += 1;
    }
    return i;
}

function first_non_space(text: String, from: Int, stop: Int) -> Int {
    let mutable i: Int = from;
    while i < stop && (byte_at(text, i) == 32 || byte_at(text, i) == 9) {
        i += 1;
    }
    return i;
}

function starts_with_at(text: String, at: Int, prefix: String, width: Int) -> Bool {
    let n: Int = len(prefix);
    if at + n > width {
        return false;
    }
    let mutable i: Int = 0;
    while i < n {
        if byte_at(text, at + i) != byte_at(prefix, i) {
            return false;
        }
        i += 1;
    }
    return true;
}

// The quoted path in `use "..."`, or the empty String if this line is not one.
function import_on_line(text: String, at: Int, stop: Int) -> String {
    let begin: Int = first_non_space(text, at, stop);
    if !starts_with_at(text, begin, "use ", stop) {
        return "";
    }
    let mutable i: Int = first_non_space(text, begin + 4, stop);
    if i >= stop || byte_at(text, i) != 34 {
        return "";
    }
    i += 1;
    let from: Int = i;
    while i < stop && byte_at(text, i) != 34 {
        i += 1;
    }
    if i >= stop {
        return "";
    }
    return substring(text, from, i - from);
}

// The directory a path lives in, with its trailing slash, so an import resolves
// relative to the file that wrote it rather than to wherever the compiler was run.
function directory_of(path: String) -> String {
    let mutable cut: Int = 0 - 1;
    let mutable i: Int = 0;
    while i < len(path) {
        if byte_at(path, i) == 47 {
            cut = i;
        }
        i += 1;
    }
    if cut < 0 {
        return "";
    }
    return substring(path, 0, cut + 1);
}

// A file's text with its `use` lines blanked out: the bytes become spaces, the
// newlines stay, and every offset after them is exactly where it was.
//
// Only the HEADER is rewritten. The body is appended in one piece, because building a
// six-thousand-line file line by line means six thousand copies of a growing String —
// which is how splitting this compiler into modules first exhausted its own region.
function spaces(count: Int) -> String {
    let mutable out: String = "";
    let mutable i: Int = 0;
    while i < count {
        out += " ";
        i += 1;
    }
    return out;
}

function blank_imports(text: String) -> String {
    let width: Int = len(text);
    // Only the `use` lines change, so only they are rebuilt. Everything else travels in
    // whole spans: `copied` is how far the answer has been filled in, and the gap from
    // there to the next import goes out in one `substring`.
    //
    // The first version walked the header a line at a time and appended each one, which
    // is one copy of a growing String per line. Since a comment counts as header, every
    // file in this compiler opens with a banner, and a file of nothing but comments cost
    // 24 of its 29 seconds here — quadratic in the file's size, for a pass that changes
    // a handful of lines.
    let mutable out: String = "";
    let mutable copied: Int = 0;
    let mutable at: Int = 0;
    let mutable in_header: Bool = true;
    while at < width && in_header {
        let stop: Int = end_of_line(text, at, width);
        let begin: Int = first_non_space(text, at, stop);
        if begin >= stop || starts_with_at(text, begin, "//", stop) {
            at = stop + 1;                           // blank or comment: kept verbatim
        } else {
            if len(import_on_line(text, at, stop)) > 0 {
                out += substring(text, copied, at - copied);
                out += spaces(stop - at);            // exactly as wide, so no offset moves
                copied = stop;
                at = stop + 1;
            } else {
                in_header = false;
            }
        }
    }
    return out + substring(text, copied, width - copied);
}

// Every file a program uses, in dependency order, each one once — which is also what
// makes a cycle harmless. Burxt has no writable parameters, so the accumulating buffer
// and the seen-list live on a class and the walk is a method on it.
// `paths`, `starts` and `lengths` are the SOURCE MAP, and they are three arrays rather than an
// array of records because Burxt has no tuples and a `class` per row would allocate one per file for
// nothing. Index `i` of each describes one file: where its bytes begin in `buffer`, and how many.
//
// Added in v0.0.239 to fix a wrong ANSWER, not to tidy anything. A diagnostic's span is an offset
// into the concatenated buffer, and without a map back to the files, a problem in a program that
// `use`s a library reported **line 1543 of a 13-line file** — measured on
// `tests/fail/vector_store_needs_the_files_effect.bx`. The message was byte-identical to stage-0's;
// only the position was nonsense, which is the shape of bug that survives review because the words
// look right.
//
// stage-0 has had this since M6 (`SourceFile` and `locate_file` in `main.rs`) and this side simply
// never grew it — because until `burxt check` learned to print a position at all, nothing on this
// side ever asked which file an offset fell in.
class Loader { seen: [String], buffer: String, paths: [String], starts: [Int], lengths: [Int],
               package: Package }

function (mutable self: Loader) load(path: String) -> Int touches files {
    for seen in self.seen {
        if seen == path {
            return 0;                            // read once already; cycles are fine
        }
    }
    let noted: Int = push(self.seen, path);

    let text: String = read_file(path);
    let here: String = directory_of(path);

    let width: Int = len(text);
    let mutable at: Int = 0;
    let mutable in_header: Bool = true;
    while at < width && in_header {
        let stop: Int = end_of_line(text, at, width);
        let begin: Int = first_non_space(text, at, stop);
        if begin >= stop || starts_with_at(text, begin, "//", stop) {
            at = stop + 1;
        } else {
            let named: String = import_on_line(text, at, stop);
            if len(named) == 0 {
                in_header = false;
            } else {
                // C2. An import whose first segment names a declared dependency is a PACKAGE
                // import; everything else is what it has always been, a path relative to the file
                // doing the importing.
                let relative: String = here + named;
                let via_package: String = manifest_resolve(self.package, named);
                let mutable target: String = relative;
                if len(via_package) > 0 {
                    // Both readings exist. Picking one silently makes resolution depend on the
                    // shape of a directory tree, so the program would compile here and fail on
                    // somebody else's machine — refused where it is written instead.
                    if manifest_readable(relative) {
                        print_error("error: `use \"" + named + "\"` in " + path
                                    + " could mean two things: the dependency declared in "
                                    + "burxt.package, or the file at " + relative
                                    + ". Rename one of them — a dependency's name is the first "
                                    + "segment of every import that reaches it.");
                        exit(2);
                    }
                    target = via_package;
                }
                let done: Int = self.load(target);
                at = stop + 1;
            }
        }
    }

    // A newline BETWEEN files, never after the last: it stops one file's final token
    // running into the next file's first, and after the last there is nothing to run into.
    if len(self.buffer) > 0 {
        self.buffer += "\n";
    }
    // Recorded BEFORE appending, because the start is where this file's bytes are about to begin.
    let began: Int = len(self.buffer);
    let blanked: String = blank_imports(text);
    let noted_path: Int = push(self.paths, path);
    let noted_start: Int = push(self.starts, began);
    let noted_length: Int = push(self.lengths, len(blanked));
    self.buffer += blanked;
    return 1;
}

// `touches files`, and it was missing until v0.0.183 — which is the point of the rule rather than a
// blemish on it. `Loader.load` reads files; this wraps it and said nothing, so a reader of
// `load_program`'s signature could not tell that compiling a program touches the disk. Stage-0's
// effect check never looked at method calls, so nothing caught it for twenty-four versions.
function load_program(path: String) -> String touches files {
    // C2. Found ONCE, from the root source file, and every package import in the program is
    // answered from it — a dependency of a dependency is resolved by its own manifest, and mixing
    // the two would let a nested package rebind a name its parent had already bound.
    let package: Package = manifest_discover(path);
    let mutable loader: Loader = Loader { seen: [], buffer: "", paths: [], starts: [], lengths: [],
                                          package: package };
    let done: Int = loader.load(path);
    return loader.buffer;
}

// ---- the source map -------------------------------------------------------------------
//
// Which FILE a buffer offset fell in, and where in that file. Two functions rather than one
// returning both, because Burxt has no tuples — and rather than a record, because a caller wants one
// or the other and a record would allocate for the half it discards.
//
// **Inclusive at the end**, and that is copied from stage-0's `locate_file` along with its reason: a
// diagnostic about the END of a file — "expected `;`, found the end of the file" — points one past
// its last byte, and that position belongs to the file it ended rather than to the separator after
// it. An exclusive test reports the next file, or nothing.
//
// Reloading the program to answer this is the honest cost of having no way to return the arrays: a
// `Loader` is region storage, so `load_program` cannot hand one back, and a second read of a handful
// of files is cheaper than the machinery to avoid it. Stated rather than hidden, per the region
// model's own terms.
function file_at_offset(root: String, offset: Int) -> String touches files {
    let mutable loader: Loader = Loader { seen: [], buffer: "", paths: [], starts: [], lengths: [],
                                          package: manifest_discover(root) };
    let done: Int = loader.load(root);
    let mutable i: Int = 0;
    while i < len(loader.paths) {
        if offset >= loader.starts[i] && offset <= loader.starts[i] + loader.lengths[i] {
            return loader.paths[i];
        }
        i += 1;
    }
    return root;
}

// The same offset, measured from the start of the file it fell in.
function offset_within_file(root: String, offset: Int) -> Int touches files {
    let mutable loader: Loader = Loader { seen: [], buffer: "", paths: [], starts: [], lengths: [],
                                          package: manifest_discover(root) };
    let done: Int = loader.load(root);
    let mutable i: Int = 0;
    while i < len(loader.paths) {
        if offset >= loader.starts[i] && offset <= loader.starts[i] + loader.lengths[i] {
            return offset - loader.starts[i];
        }
        i += 1;
    }
    return offset;
}
