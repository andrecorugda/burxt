// ============================================================================
// lexer.bx — source text in, a flat stream of tokens out.
//
// Split out of `ast.bx` in v0.0.233, where it had been the second half of a file named
// after the first. `ast.bx` has the story and `spec/A7.0-NAMING.md` has the rule.
//
// It depends on `ast.bx` and `ast.bx` does not depend on it — the same one-way arrow
// `lexer.rs` has to `ast.rs`. The shapes are declared where the shapes live; the scanning
// happens here.
//
// The methods below are declared on `Unit`, whose `class` is in `ast.bx`. That works because
// `use` is a textual pre-pass, so both files are one buffer by the time anything is checked —
// and `parser.bx` has relied on it since v0.0.82.
// ============================================================================

use "ast.bx";

// ---- the keyword table -----------------------------------------------------
// Codes from 100. Order does not matter; the lookup is a scan.
function (mutable self: Unit) add_word(word: String, code: Int) -> Int {
    push(self.keywords, Keyword { word: word, code: code });
    return len(self.keywords);
}

function (mutable self: Unit) install_keywords() -> Int {
    let mutable n: Int = 0;
    n = self.add_word("let", 100);
    n = self.add_word("mutable", 101);
    // `const NAME: Type = <literal>;` — a name for a compile-time value. A keyword rather
    // than a contextual word, because it opens an ITEM where a statement may also start and
    // telling `const A: Int = 1;` from `const_of(x);` would take three tokens of lookahead.
    // Code 134: 125..129 are taken by contract-clause markers in the parser and 130..133 by
    // `is`, `in`, `private` and the pair below, so this is the next free number.
    //
    // (This comment used to end by reporting that 133 was used TWICE, by `implements` and
    // `print_error` — told apart by position, nothing broken, "a collision waiting for a third
    // use". v0.0.244 moved `print_error` to 135 rather than leaving the report standing: a hazard
    // named and left in place is a hazard, and the next person to need a free code would have had
    // to rediscover the same thing.)
    n = self.add_word("const", 134);
    n = self.add_word("function", 102);
    n = self.add_word("return", 103);
    n = self.add_word("if", 104);
    n = self.add_word("else", 105);
    n = self.add_word("while", 106);
    n = self.add_word("break", 107);
    n = self.add_word("continue", 108);
    n = self.add_word("class", 109);
    n = self.add_word("enum", 110);
    n = self.add_word("match", 111);
    n = self.add_word("interface", 112);
    n = self.add_word("implement", 113);
    // `class X implements Y` — a separate word from `implement`, because it appears where a `{`
    // is otherwise expected and a contextual reading would need lookahead.
    n = self.add_word("implements", 133);
    n = self.add_word("for", 114);
    n = self.add_word("dynamic", 115);
    n = self.add_word("external", 116);
    n = self.add_word("region", 117);
    n = self.add_word("print", 118);
    // `print_error` writes to stderr. A separate keyword rather than a builtin function, because it
    // has to reach the SAME per-type formatter `print` uses — two formatters would print the same
    // value differently the first time one of them learned about a new type.
    // **135, and it was 133 until v0.0.244 — the same code `implements` uses.** They were told
    // apart by POSITION: `parser.bx` read 133 as `print_error` where a statement was expected and
    // as `implements` where a class header was, and a class header cannot appear where a statement
    // can. Correct, and correct for a reason that is nowhere near the two `add_word` calls.
    //
    // Nothing was broken. What was broken was the NEXT change: a third word taking 133, or either
    // of these moving, and the failure is a keyword silently parsing as another keyword — which no
    // type error can catch because both are grammar. Found by the subagent adding `const`, which
    // needed a free code and counted the table.
    n = self.add_word("print_error", 135);
    n = self.add_word("self", 119);
    n = self.add_word("true", 120);
    n = self.add_word("false", 121);
    n = self.add_word("as", 122);
    n = self.add_word("tail", 123);
    n = self.add_word("pure", 124);
    // C2. `public`, spelled out — every other name in this language is. Code 125 sits beside
    // `pure` because both are declaration markers rather than parts of a type or a statement.
    n = self.add_word("public", 125);
    // `allocates`, `requires`, `ensures` and `decreases` are deliberately NOT here:
    // stage-0 made them contextual in v0.0.55, so they are ordinary identifiers and
    // the parser recognises them by position. A lexer that disagreed with stage-0
    // about this would reject `let allocates: Int = 0;` — which the cross-check test
    // caught within a minute of the change.
    n = self.add_word("is", 130);
    // `for x in xs`. `for` is already a keyword (114) from `implement Trait for Type`.
    n = self.add_word("in", 131);
    // `private` on a class's field or method. A real keyword rather than a contextual word,
    // because it appears where a field NAME is expected — `private balance: Decimal<2>` — and a
    // contextual reading could not tell the two apart without lookahead.
    n = self.add_word("private", 132);
    // Type names are keywords too: the parser needs them distinguished from
    // ordinary identifiers, exactly as the Rust lexer does.
    n = self.add_word("Int", 140);
    n = self.add_word("Bool", 141);
    n = self.add_word("String", 142);
    n = self.add_word("CInt", 143);
    // The four sized C integers, roadmap A7. Codes 149..152, chosen after CPointer's 148 rather
    // than beside CInt's 143 because the numbers are a wire format between this table and
    // `parse_type` — renumbering to keep them tidy would be a silent change to both.
    //
    // Lexed as KEYWORDS, and that is the whole bug being fixed here. Without these four lines the
    // words fall through to the identifier path and become NAMED types, so `let n: u8 = 5;` was
    // refused with *"declared u8, but the value is Int"* — an accidental refusal from a type
    // mismatch, which reads exactly like agreement with stage-0 and is not. A fail fixture cannot
    // tell those apart: it checks that a program is refused, never why.
    n = self.add_word("i32", 149);
    n = self.add_word("u8", 150);
    n = self.add_word("u32", 151);
    n = self.add_word("u64", 152);
    n = self.add_word("CDouble", 144);
    // An opaque pointer from C. A type keyword rather than a library name, because the checker
    // has to refuse `==`, `print` and arithmetic on it — and a library cannot refuse anything.
    n = self.add_word("CPointer", 148);
    n = self.add_word("Decimal", 145);
    n = self.add_word("RoundHalfEven", 146);
    n = self.add_word("RoundHalfUp", 147);
    return n;
}

// An identifier's span, or a keyword code if the table has it.
function (self: Unit) keyword_code(src: String, start: Int, length: Int) -> Int {
    let mutable i: Int = 0;
    while i < len(self.keywords) {
        if span_equal(src, start, length, self.keywords[i].word) {
            return self.keywords[i].code;
        }
        i += 1;
    }
    return 1;
}

function (mutable self: Unit) emit(kind: Int, start: Int, length: Int) -> Int {
    push(self.tokens, Token {
            kind: kind, start: start, length: length,
            value: 0, scale: 0, interpolated: false,
    });
    return len(self.tokens);
}

function (mutable self: Unit) emit_number(kind: Int, start: Int, length: Int, value: Int, scale: Int) -> Int {
    push(self.tokens, Token {
            kind: kind, start: start, length: length,
            value: value, scale: scale, interpolated: false,
    });
    return len(self.tokens);
}

function (mutable self: Unit) emit_string(start: Int, length: Int, interpolated: Bool) -> Int {
    push(self.tokens, Token {
            kind: 4, start: start, length: length,
            value: 0, scale: 0, interpolated: interpolated,
    });
    return len(self.tokens);
}

// ---- whitespace and comments ----------------------------------------------
function skip_trivia(src: String, from: Int, stop: Int) -> Int {
    let mutable i: Int = from;
    while true {
        let mutable moved: Bool = false;
        while i < stop && is_space(byte_at(src, i)) {
            i += 1;
            moved = true;
        }
        // Tested against `stop` first, then read directly rather than through `at_byte`,
        // which would re-derive a bound this function was handed. Worth 5% of the lexer
        // and no more: `byte_at`'s own check still measures the string, and see
        // spec/1.0/M9-PERFORMANCE.md §3 for why only an O(1) length removes that.
        if i + 1 < stop && byte_at(src, i) == 47 && byte_at(src, i + 1) == 47 {
            while i < stop && byte_at(src, i) != 10 {
                i += 1;
            }
            moved = true;
        }
        if !moved {
            break;
        }
    }
    return i;
}

// ---- numbers ---------------------------------------------------------------
// `19.99` is the unscaled integer 1999 with scale 2 — accumulated digit by digit,
// never through a float. `$19.99` is the same. `8.25%` is two places finer.
function (mutable self: Unit) scan_number(src: String, from: Int, stop: Int) -> Int {
    let mutable i: Int = from;
    let money: Bool = byte_at(src, i) == 36;         // '$'
    if money {
        i += 1;
    }
    // `0x...` — hexadecimal, for bit work. A mask, a CRC polynomial or a protocol field is written
    // in hex wherever it is SPECIFIED, and a reviewer checking one against the standard that defines
    // it should be comparing the same characters. No hex Decimal: a scale counts DECIMAL places.
    //
    // Accumulated as a signed Int, which is the same thing as parsing unsigned and reinterpreting,
    // because sixteen hex digits fill the register exactly — so `0xFFFFFFFFFFFFFFFF` is -1 and equals
    // `bit_not(0)`. Overflow past sixteen digits is what stage-0 refuses; here it wraps, and the
    // differential is what would catch a program that relied on the difference.
    if !money && byte_at(src, i) == 48 && (at_byte(src, i + 1, stop) == 120
            || at_byte(src, i + 1, stop) == 88) {
        i += 2;
        let mutable hex: Int = 0;
        let mutable digits: Int = 0;
        while i < stop {
            let b: Int = byte_at(src, i);
            let mutable d: Int = 0 - 1;
            if is_digit(b) { d = b - 48; }
            if b >= 97 && b <= 102 { d = b - 87; }   // a-f
            if b >= 65 && b <= 70 { d = b - 55; }    // A-F
            if b == 95 {                              // `0xFFFF_FFFF` reads better
                i += 1;
                continue;
            }
            if d < 0 {
                break;
            }
            // `shift_left`/`bit_or` rather than `hex * 16 + d`, and the reason is the nicest kind:
            // sixteen hex digits FILL a signed Int, so `0xFFFFFFFFFFFFFFFF` is -1 — and `* 16`
            // overflows on the way there and traps, correctly, because multiplication in this
            // language does not wrap. A shift is the operation that may lose the top bits, which is
            // exactly what building a bit pattern means. So the bit builtins added in v0.0.199 are
            // first used by the lexer that reads the literals they exist to serve.
            hex = bit_or(shift_left(hex, 4), d);
            digits += 1;
            i += 1;
        }
        if digits == 0 {
            print("error: `0x` needs hexadecimal digits after it, e.g. `0xFF`");
            self.errors += 1;
        }
        // Past sixteen digits the value cannot be what was written, and the shift above would
        // quietly drop the front of it. stage-0 refuses the same literal by failing to parse it.
        if digits > 16 {
            print("error: a hexadecimal literal holds at most sixteen digits — an Int is 64 bits");
            self.errors += 1;
        }
        let n: Int = self.emit_number(2, from, i - from, hex, 0);
        return i;
    }
    let mutable value: Int = 0;
    while i < stop && is_digit(byte_at(src, i)) {
        value = value * 10 + (byte_at(src, i) - 48);
        i += 1;
    }
    let mutable scale: Int = 0;
    if at_byte(src, i, stop) == 46 && is_digit(at_byte(src, i + 1, stop)) {
        i += 1;
        while i < stop && is_digit(byte_at(src, i)) {
            value = value * 10 + (byte_at(src, i) - 48);
            scale += 1;
            i += 1;
        }
    }
    // A Decimal IS an unscaled i64 plus a scale, so 18 fractional digits is the ceiling: the
    // nineteenth does not fit and `value * 10` above has already wrapped by the time anyone could
    // notice. Refused here rather than at the type, because the LITERAL is where the digits were
    // written — `0.0000000000000000000001` names no type at all.
    //
    // The `%` case below adds two more places, and it is checked against the same ceiling after
    // that addition for the same reason: `1.0000000000000000005%` is scale 20, not 18.
    if scale > 18 {
        print("error: this decimal literal has " + to_string(scale)
                + " fractional digits, but Decimal supports at most 18 — a scaled i64 holds no more");
        self.errors += 1;
    }
    if at_byte(src, i, stop) == 37 {                 // '%'
        i += 1;
        // A percent is the number divided by a hundred: two more places, exactly.
        if scale + 2 > 18 && scale <= 18 {
            print("error: this decimal literal has " + to_string(scale + 2)
                    + " fractional digits, but Decimal supports at most 18 — a scaled i64 holds no more");
            self.errors += 1;
        }
        let n: Int = self.emit_number(3, from, i - from, value, scale + 2);
        return i;
    }
    if money || scale > 0 {
        let n: Int = self.emit_number(3, from, i - from, value, scale);
        return i;
    }
    let n: Int = self.emit_number(2, from, i - from, value, 0);
    return i;
}

// ---- strings ---------------------------------------------------------------
function (mutable self: Unit) scan_string(src: String, from: Int, stop: Int) -> Int {
    let mutable i: Int = from + 1;
    let mutable interpolated: Bool = false;
    // Whether a `{` is currently open. One flag and not a depth, because interpolations do not
    // nest: a string literal cannot appear inside one, so there is no second `{` to count.
    let mutable in_interpolation: Bool = false;
    while true {
        if i >= stop {
            print("error: unterminated string literal");
            self.errors += 1;
            break;
        }
        let b: Int = byte_at(src, i);
        // A raw NUL. Refused rather than carried, because a Burxt String is NUL-TERMINATED at
        // runtime: the byte would end the string early and everything after it would vanish with
        // no error anywhere. Silent data loss is the one outcome this language will not produce,
        // so the byte cannot appear at all.
        //
        // Stage-1 accepted it until v0.0.222, and the reason it went unnoticed is the shape worth
        // recording: the differential ratchet counts programs stage-1 REFUSES, so a fixture
        // stage-0 rejects and stage-1 waves through moves no number. A floor cannot see the
        // ceiling fall.
        if b == 0 {
            print("error: a raw NUL byte cannot appear in a string literal — Burxt "
                    + "strings are NUL-terminated");
            self.errors += 1;
            i += 1;
            continue;
        }
        if b == 92 {                                 // '\' — an escape
            // VALIDATED, not skipped. The old two-byte skip accepted `A` as the pair `\u`
            // followed by literal `0041`, which is not what anyone writing it meant — a program
            // asking for a codepoint escape got four stray digits and no complaint. There is no
            // `\u` in Burxt (spec/A4.4), so the answer is a refusal naming the whole escape set.
            if i + 1 >= stop {
                print("error: unterminated string literal");
                self.errors += 1;
                break;
            }
            let after: Int = byte_at(src, i + 1);
            // A backslash at the end of a line means the string never closed, and saying
            // "unknown escape" for it would send the reader hunting the wrong thing.
            if after == 10 {
                print("error: unterminated string literal — close it with `\"` before the "
                        + "end of the line");
                self.errors += 1;
                break;
            }
            // The set stage-0 accepts, and nothing else: `\\ \" \n \r \t \0 \{ \}`.
            if after != 92 && after != 34 && after != 110 && after != 114 && after != 116
                    && after != 48 && after != 123 && after != 125 {
                print("error: unknown escape `\\" + substring(src, i + 1, 1)
                        + "` — Burxt strings support \\\\, \\\", \\n, \\r, \\t, \\0, \\\{ and \\\}");
                self.errors += 1;
            }
            i += 2;
            continue;
        }
        // ---- braces: three refusals stage-1 did not have -----------------------------------
        //
        // A `{` OPENS an interpolation and a `}` closes one, so both are structural and neither can
        // stand for itself — a literal brace is `\{` or `\}`, handled by the escape branch above and
        // therefore never seen here. That makes the three mistakes below exactly the three states
        // this loop can be in when it meets a brace, which is why one flag answers all of them.
        //
        // Stage-1 tracked only WHETHER a `{` appeared, so it could tell the parser there was an
        // interpolation to split — and never checked that the braces balanced or that anything was
        // between them. `"bare } brace"`, `"empty {}"` and `"open {n"` all lexed clean.
        if b == 123 {                                // '{'
            // `{}` promises a value and supplies none. The same shape as `[]` in a contract
            // bracket, refused for the same reason: brackets a reader can see, with nothing in them.
            if i + 1 < stop && byte_at(src, i + 1) == 125 {
                print("error: empty interpolation `\{\}` — put an expression inside it, or write "
                        + "`\\\{` and `\\\}` for literal braces");
                self.errors += 1;
            }
            interpolated = true;
            in_interpolation = true;
            i += 1;
            continue;
        }
        if b == 125 {                                // '}'
            if !in_interpolation {
                print("error: a literal `\}` in a string must be written `\\\}` — a bare `\}` only "
                        + "closes a `\{expr\}` interpolation");
                self.errors += 1;
            }
            in_interpolation = false;
            i += 1;
            continue;
        }
        if b == 34 {                                 // '"' closes it
            // Reached with an interpolation still open: the `{` was never closed. Reported as the
            // brace's problem rather than the quote's, because that is the byte the writer has to
            // change — an unescaped `{` is what started this.
            if in_interpolation {
                print("error: a literal `\{` in a string must be written `\\\{` — an unescaped "
                        + "`\{` starts a `\{expr\}` interpolation");
                self.errors += 1;
            }
            i += 1;
            break;
        }
        i += 1;
    }
    let n: Int = self.emit_string(from, i - from, interpolated);
    return i;
}

// ---- punctuation -----------------------------------------------------------
// Two-character forms are tried first: `-` and `->` differ by one byte and mean
// entirely different things.
function (mutable self: Unit) scan_punct(src: String, from: Int, stop: Int) -> Int {
    let one: Int = byte_at(src, from);
    // Same as skip_trivia: the bound is already known, so it is tested rather than
    // measured. A punctuation mark is roughly one token in three.
    let mutable two: Int = 0 - 1;
    if from + 1 < stop {
        two = byte_at(src, from + 1);
    }
    // `..` — the range in `for i in 0..n`, and its only legal position. Tried BEFORE the
    // one-byte `.` below, like every other two-byte form here.
    //
    // **Code 42, and the number was checked rather than assumed.** A6 was first written where
    // 41 was free; `?` took 41 before this landed, and two lexemes sharing one code is exactly
    // the hazard v0.0.244 removed from the KEYWORD table one screen above — nothing complains,
    // and whichever reader runs first decides which lexeme wins. 42 is the next free
    // PUNCTUATION code, and it cannot collide with `const`'s 134 or `print_error`'s 135 either:
    // punctuation lives in 10..49 and keywords in 100.., disjoint by construction (see the
    // token-kind map at the top of ast.bx). Verified by grep, not by reading.
    //
    // The conflict with a decimal literal is settled entirely in `scan_number`, which claims
    // a `.` only when a DIGIT follows it. So `0..3` leaves the number at `0` and control
    // arrives here with both dots unread, while `0.5` never reaches this function at all.
    // Nothing about decimal lexing had to change; the lookahead that already existed is the
    // lookahead that resolves this. Measured against `1.0..2.0`, which must lex into three
    // tokens and then be refused by the CHECKER, not here.
    if one == 46 && two == 46 {
        // `..=` and `...` are the two spellings of an inclusive range in other languages, so
        // both arrive as an honest guess and both get an answer instead of a broken parse.
        // Burxt has ONE range form: see the `for` range in check.bx for why a second form
        // differing by a single character is a reading hazard rather than a convenience.
        let three: Int = at_byte(src, from + 2, stop);
        if three == 61 || three == 46 {              // '=' or '.'
            print("error: a Burxt range is exclusive and spelled `..` — there is no `..=` or "
                    + "`...`. `0..3` is 0, 1, 2; for 0 through 3 write `0..4`.");
            self.errors += 1;
            return from + 3;
        }
        let n: Int = self.emit(42, from, 2);
        return from + 2;
    }
    if one == 45 && two == 62 { let n: Int = self.emit(10, from, 2); return from + 2; }  // ->
    if one == 61 && two == 62 { let n: Int = self.emit(11, from, 2); return from + 2; }  // =>
    if one == 61 && two == 61 { let n: Int = self.emit(12, from, 2); return from + 2; }  // ==
    if one == 33 && two == 61 { let n: Int = self.emit(13, from, 2); return from + 2; }  // !=
    if one == 60 && two == 61 { let n: Int = self.emit(14, from, 2); return from + 2; }  // <=
    if one == 62 && two == 61 { let n: Int = self.emit(15, from, 2); return from + 2; }  // >=
    if one == 38 && two == 38 { let n: Int = self.emit(16, from, 2); return from + 2; }  // &&
    if one == 124 && two == 124 { let n: Int = self.emit(17, from, 2); return from + 2; } // ||
    // `+= -= *=` are sugar: the parser expands them into `target = target <op> value`, so
    // nothing after it knows they exist. There is deliberately no `++`: an expression with
    // a side effect is what this language refuses, and `+= 1` is the brevity without it.
    if one == 43 && two == 61 { let n: Int = self.emit(38, from, 2); return from + 2; }  // +=
    if one == 45 && two == 61 { let n: Int = self.emit(39, from, 2); return from + 2; }  // -=
    if one == 42 && two == 61 { let n: Int = self.emit(40, from, 2); return from + 2; }  // *=

    if one == 58 { let n: Int = self.emit(20, from, 1); return from + 1; }   // :
    if one == 59 { let n: Int = self.emit(21, from, 1); return from + 1; }   // ;
    if one == 44 { let n: Int = self.emit(22, from, 1); return from + 1; }   // ,
    if one == 46 { let n: Int = self.emit(23, from, 1); return from + 1; }   // .
    if one == 61 { let n: Int = self.emit(24, from, 1); return from + 1; }   // =
    if one == 43 { let n: Int = self.emit(25, from, 1); return from + 1; }   // +
    if one == 45 { let n: Int = self.emit(26, from, 1); return from + 1; }   // -
    if one == 42 { let n: Int = self.emit(27, from, 1); return from + 1; }   // *
    if one == 47 { let n: Int = self.emit(28, from, 1); return from + 1; }   // /
    if one == 40 { let n: Int = self.emit(29, from, 1); return from + 1; }   // (
    if one == 41 { let n: Int = self.emit(30, from, 1); return from + 1; }   // )
    if one == 123 { let n: Int = self.emit(31, from, 1); return from + 1; }  // {
    if one == 125 { let n: Int = self.emit(32, from, 1); return from + 1; }  // }
    if one == 91 { let n: Int = self.emit(33, from, 1); return from + 1; }   // [
    if one == 93 { let n: Int = self.emit(34, from, 1); return from + 1; }   // ]
    if one == 60 { let n: Int = self.emit(35, from, 1); return from + 1; }   // <
    if one == 62 { let n: Int = self.emit(36, from, 1); return from + 1; }   // >
    if one == 33 { let n: Int = self.emit(37, from, 1); return from + 1; }   // !
    // `?` — error propagation. There is no two-character form to try first, and no `??`: a
    // default for a failure is `match` or a named function, not a second operator whose
    // precedence a reviewer has to remember.
    //
    // Worth recording WHY this line arrived so late, because the lesson is about the test suite
    // rather than the lexer. `?` shipped in stage-0 and stage-1 had NOTHING — not a token, not a
    // node, not a rule — and the suite reported 142 of 142 passing, because no `tests/pass/`
    // fixture used it and the front-end sweep listed seven example paths BY HAND with
    // `examples/absence.bx` not among them. A whole feature had zero coverage on one side. It
    // surfaced only when `burxt mcp-schema` was run over every example and one file answered
    // `byte 63 starts no token`. A hand-written list of what to check is a list of what you
    // already thought of; the sweep now walks the directory.
    if one == 63 { let n: Int = self.emit(41, from, 1); return from + 1; }   // ?

    // `&` and `|` alone are the two bytes people arrive with, so they get an answer rather than a
    // byte number. Same message stage-0 gives, for the same reason: the bit operations are NAMED,
    // because `a & b == c` means `a & (b == c)` in C and a precedence table a reviewer has to
    // remember is the opposite of what this language is for.
    if one == 38 {
        print("error: Burxt has no bitwise `&` — write `bit_and(a, b)`, or did you mean `&&` "
                + "(logical and)?");
        self.errors += 1;
        return from + 1;
    }
    if one == 124 {
        print("error: Burxt has no bitwise `|` — write `bit_or(a, b)`, or did you mean `||` "
                + "(logical or)?");
        self.errors += 1;
        return from + 1;
    }
    print("error: byte " + to_string(one) + " starts no token");
    self.errors += 1;
    return from + 1;
}

// ---- the loop --------------------------------------------------------------
function (mutable self: Unit) run(src: String) -> Int {
    let count: Int = self.run_range(src, 0, len(src));
    // Where the PROGRAM's tokens end. An interpolation fragment is lexed later and its
    // tokens are appended, so without this the parser would walk off the end of the
    // program and try to read `n` from `"{n}"` as a top-level statement.
    self.token_end = len(self.tokens);
    return count;
}

// Lexing a SLICE of the source rather than all of it. Interpolation needs this: the
// bytes between `{` and `}` are real Burxt, and the honest way to read them is with the
// lexer that reads everything else. The tokens are appended, and their spans are absolute,
// so nothing already parsed shifts and every diagnostic still points at the right byte.
function (mutable self: Unit) run_range(src: String, from: Int, until: Int) -> Int {
    let mutable i: Int = from;
    while true {
        i = skip_trivia(src, i, until);
        if i >= until {
            break;
        }
        let b: Int = byte_at(src, i);
        if is_alpha(b) {
            let start: Int = i;
            while i < until && is_name_byte(byte_at(src, i)) {
                i += 1;
            }
            let code: Int = self.keyword_code(src, start, i - start);
            let n: Int = self.emit(code, start, i - start);
            continue;
        }
        if is_digit(b) || (b == 36 && is_digit(at_byte(src, i + 1, until))) {
            i = self.scan_number(src, i, until);
            continue;
        }
        if b == 34 {
            i = self.scan_string(src, i, until);
            continue;
        }
        i = self.scan_punct(src, i, until);
    }
    return len(self.tokens);
}
