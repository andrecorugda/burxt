// ============================================================================
// check.bx — part of the Burxt compiler, written in Burxt.
//
// The rules. Types, scales, rounding contracts, regions, purity, contracts, exhaustiveness
// — the same refusals stage-0 makes, which is what the differential test compares.
//
// Assembled by src/burxt-compiler/main.bx, which is the program; everything here is
// declarations, which is what a module may hold.
// ============================================================================

// ============================================================================
// PHASE 4: the typechecker. Types in, refusals out — the same rules the Rust
// compiler enforces, applied to the AST the parser just built.
// ============================================================================

function unknown_type() -> Type {
    return Type { kind: 0, scale: 0, contract: 0, name_start: 0, name_length: 0 };
}

function simple_type(kind: Int) -> Type {
    return Type { kind: kind, scale: 0, contract: 0, name_start: 0, name_length: 0 };
}

// A sized C integer, roadmap A7 — kind 52, with the BIT COUNT in `scale` and signedness in
// `contract`. The same two slots a Decimal uses, and the same choice stage-0 makes with one
// `Type::Width { bits, signed }` variant: no rule below cares which of the four it is, only what
// the bounds are and how many bits to truncate to.
function width_type(bits: Int, signed: Int) -> Type {
    return Type { kind: 52, scale: bits, contract: signed, name_start: 0, name_length: 0 };
}

// Is this a sized C integer? Asked by name so the four call sites cannot each get `kind == 52`
// slightly wrong, which is how `CPointer`'s kind 51 was left out of `declared_type` for a version.
function is_width(t: Type) -> Bool {
    return t.kind == 52;
}

// C's widths as Burxt sees them at the boundary. See N1-BOUNDARY-EXACTNESS: the
// exactness rule lives in `as scaled`, and the widths themselves are C's business.
//
// A width joins CInt and CDouble here, and that is the half of A7 a caller sees: Burxt code passes
// and receives an ordinary Int, and the narrowing to `u8` or the widening from `i32` happens at the
// call in the emitter. So a width is never the type of a Burxt expression — the same fact the
// boundary refusal enforces from the other side.
function as_burxt_sees(t: Type) -> Type {
    if t.kind == 43 || t.kind == 44 || t.kind == 52 {
        return simple_type(40);
    }
    return t;
}

// Is this expression node the call `exit(...)`? Asked by name, because `exit` is a statement rather
// than a builtin: the emitter has to recognise it in the same place the checker does, and a fact
// stored twice is a fact that disagrees with itself eventually.
function (self: Unit) is_exit_call(src: String, node: Int) -> Bool {
    if node < 0 {
        return false;
    }
    let call: Node = self.nodes[node];
    if call.kind != 13 {
        return false;
    }
    let named: Token = self.tokens[call.token];
    return span_equal(src, named.start, named.length, "exit");
}

// The types that cross as a POINTER rather than in a register: a class, a slice, a fixed array, an
// interface object. Only these may be `mutable` parameters, because only these have a caller-side
// home the callee can reach.
function is_aggregate_type(t: Type) -> Bool {
    return t.kind == 46 || t.kind == 47 || t.kind == 48 || t.kind == 49 || t.kind == 53;
}

function decimal_type(scale: Int, contract: Int) -> Type {
    return Type { kind: 45, scale: scale, contract: contract, name_start: 0, name_length: 0 };
}

// An unknown type never equals anything, including another unknown: one bad
// expression must not make every later comparison succeed. The stage-1 checker in
// examples/checker.bx learned this the hard way, and so did stage-0's recovery.
function is_unknown(t: Type) -> Bool {
    return t.kind == 0;
}

// Is this expression node an integer LITERAL — node kind 1, or a unary minus (kind 6) over
// one? Deliberately not a constant folder: `2 + 1`, a binding and a `const` name all answer
// false.
//
// Used for exactly one rule, `for i in 3..0`, where a wrong answer in either direction would
// be worse than no answer at all: a false `true` refuses a correct program. Negation is
// followed through because stage-0 folds `-3` into a literal in its checker, and the two
// compilers refusing DIFFERENT programs is the failure mode the differential test exists for.
function (self: Unit) is_literal_int(node: Int) -> Bool {
    if node < 0 {
        return false;
    }
    let n: Node = self.nodes[node];
    if n.kind == 1 {
        return true;
    }
    if n.kind == 6 && n.a >= 0 {
        return self.nodes[n.a].kind == 1;
    }
    return false;
}

// The value of a node `is_literal_int` said yes to. Asking on anything else is a caller bug,
// and answering 0 is the least surprising thing to do about one — it cannot be mistaken for a
// real reading, because the caller was told to ask first.
function (self: Unit) literal_int_value(node: Int) -> Int {
    if node < 0 {
        return 0;
    }
    let n: Node = self.nodes[node];
    if n.kind == 1 {
        return n.value;
    }
    if n.kind == 6 && n.a >= 0 {
        return 0 - self.nodes[n.a].value;
    }
    return 0;
}

// An interface implementation: a pair of names, which is all `dynamic` dispatch needs to know.
// The method table already knows what the type can do.
// `implement Mapper<Int> for D` — which interface, implemented by which type, AT WHICH
// ARGUMENTS. Roadmap A9.
//
// `trait_args`/`trait_arg_count` index `nested_children` and hold the interface's type-argument
// NODES, the same shape a generic application already uses. Both are 0 for a plain interface,
// which is why the two spans above did not have to change meaning.
//
// Stage-1 never mangles an instantiation into a name — it has none to spell, since every name
// here is a span in the source. It compares `Mapper<Int>` against `Mapper<String>` STRUCTURALLY,
// name span first and then argument by argument, which is what `same_instantiation` does. That is
// the one real difference from stage-0, which monomorphises to `Mapper$Int` and compares strings;
// the two agree on every answer, and the fixtures are what say so.
class Implementation { trait_start: Int, trait_len: Int, type_start: Int, type_len: Int,
        trait_args: Int, trait_arg_count: Int }

// The type arguments an `implement` header wrote, keyed by the item node they were written on.
//
// A side table because a node holds six slots and kind 85 spends all six — kind, the method
// list's start and count, the implementing type's token, the declared-on-class flag, and the
// interface's own token. This is the shape stage-1 already reaches for when a declaration needs
// one more fact than a node can hold; `generics`, `type_param_bounds` and `clause_subjects` are
// the same answer to the same question.
class ImplTrait { item: Int, args_start: Int, args_count: Int }

// How many type arguments the `implement` header on this item wrote, and where they start.
// Zero and zero for a plain interface, which is almost every one of them.
//
// Two functions rather than one answering a pair, because stage-1 has no tuples in its own
// source: it is compiled by stage-0, which has had them since v0.0.276, but the FIXPOINT
// requires stage-1 to compile this file too and stage-1 is what is being taught tuples nowhere
// in this milestone. A linear scan over the impl headers a program wrote, which is a handful.
function (self: Unit) trait_arguments_of(item: Int) -> Int {
    for held in self.impl_traits {
        if held.item == item {
            return held.args_count;
        }
    }
    return 0;
}

function (self: Unit) trait_argument_start(item: Int) -> Int {
    for held in self.impl_traits {
        if held.item == item {
            return held.args_start;
        }
    }
    return 0;
}

// ---- B25: one `mutable` parameter that a function GROWS -----------------------------------------
//
// `owner` indexes `functions`, `parameter` is the position in its parameter list. Per PARAMETER and
// not per function, because `function move(mutable from: [Int], mutable into: [Int])` may grow one
// and only read the other, and a rule that refused both would refuse a program that says exactly
// what it does.
//
// The fact this records is the one a call site cannot work out for itself: the growth happens in
// the callee's body, on a name the callee chose, and only the CALLER knows whose binding was handed
// over. So the callee's body records "parameter 0 grows" and the call site turns that into "`xs`
// grows" — which is why this needs a fixpoint rather than a walk, and why B20's local rule could
// not see it.
class ParameterGrowth { owner: Int, parameter: Int }




// The same, for the types whose ELEMENT has to be read out of the arena. A method, because a
// slice holds its element as a node index and rendering it needs the nodes.
//
// Rendering a slice used to say the keywords "a growable array" and nothing more, so the first
// message this file produced
// after element comparison started working read "argument 1 should be a growable array, but it
// is a growable array". A refusal a reader cannot act on is barely better than no refusal.
function (self: Unit) show_type(src: String, t: Type) -> String {
    if t.kind == 47 {
        return "[" + self.show_type(src, self.declared_type(src, t.scale)) + "]";
    }
    if t.kind == 48 {
        return "[" + self.show_type(src, self.declared_type(src, t.scale)) + "; "
                + to_string(t.contract) + "]";
    }
    // A tuple: its elements, in parentheses. Stage-0 gets this from `Type::Tuple`'s
    // `Display`, and the two spellings have to match to the byte — a `.stderr` fixture pins
    // one text and both compilers produce it.
    if t.kind == 53 {
        let mutable spelled: String = "(";
        let mutable e: Int = 0;
        while e < t.contract {
            if e > 0 { spelled += ", "; }
            spelled += self.show_type(src, self.declared_type(src, self.nested_children[t.scale + e]));
            e += 1;
        }
        return spelled + ")";
    }
    if t.kind == 46 && t.contract > 0 {
        // A generic application: the name, then its arguments.
        let mutable out: String = substring(src, t.name_start, t.name_length) + "<";
        let mutable i: Int = 0;
        while i < t.contract {
            if i > 0 { out += ", "; }
            out += self.show_type(src, self.declared_type(src, self.nested_children[t.scale + i]));
            i += 1;
        }
        return out + ">";
    }
    if t.kind == 0 { return "?"; }
    if t.kind == 40 { return "Int"; }
    if t.kind == 41 { return "Bool"; }
    if t.kind == 42 { return "String"; }
    if t.kind == 43 { return "CInt"; }
    // Spelled back exactly as it was written. Built from the two numbers rather than a table of
    // four, so a width that ever gains a fifth spelling cannot be rendered wrong here.
    if t.kind == 52 {
        if t.contract == 1 {
            return "i" + to_string(t.scale);
        }
        return "u" + to_string(t.scale);
    }
    if t.kind == 51 { return "CPointer"; }
    if t.kind == 44 { return "CDouble"; }
    if t.kind == 45 {
        if t.contract == 1 {
            return "Decimal<" + to_string(t.scale) + ", RoundHalfEven>";
        }
        if t.contract == 2 {
            return "Decimal<" + to_string(t.scale) + ", RoundHalfUp>";
        }
        return "Decimal<" + to_string(t.scale) + ">";
    }
    // `dynamic Mapper<Int>` — the arguments are part of the name a reader wrote, so they are part
    // of what a message shows. Roadmap A9. Stage-0 reaches the same text by a different road: it
    // mangled the instantiation to `Mapper$Int` and `show` looks the arguments back up in
    // `instance_of` to spell them. Both must print `dynamic Mapper<Int>`, because a `.stderr`
    // fixture pins one text and both compilers are held to it.
    if t.kind == 49 {
        if t.contract > 0 {
            let mutable spelled: String = "dynamic " + substring(src, t.name_start, t.name_length)
                    + "<";
            let mutable i: Int = 0;
            while i < t.contract {
                if i > 0 { spelled += ", "; }
                spelled += self.show_type(src,
                        self.declared_type(src, self.nested_children[t.scale + i]));
                i += 1;
            }
            return spelled + ">";
        }
        return "dynamic " + substring(src, t.name_start, t.name_length);
    }
    if t.kind == 50 { return substring(src, t.name_start, t.name_length); }
    return substring(src, t.name_start, t.name_length);
}

// Read a type NODE into a Type.
// Two types are the same only if their ELEMENTS are.
//
// This has to be a METHOD: a slice or array holds its element type as a NODE INDEX, so
// comparing those two integers compares positions rather than types, and reading the element
// back needs the arena. It used to be a free function that could not reach the nodes, so it
// fell through to `true` for both kinds — which meant `[Int]` and `[String]` were the same
// type to stage-1 for eleven versions, and it accepted `takes_ints(keywords)` where stage-0
// refused it.
//
// Nothing caught it because the differential test's rejection count is a FLOOR, not an
// equality: stage-1 rejecting less than stage-0 kept the ratchet green. Found by trying to
// build generic unification on top of it, which needed element comparison to mean something.
// What a type parameter stands for right now, or the type unchanged if it is not one.
//
// Shallow on purpose: it looks at ONE level. Every recursive walk over types calls it as it
// descends, so `[T]` resolves when its element is reached rather than being rewritten — which
// it could not be, since a slice holds its element as a node index and a substituted element
// would have no node.
// Bind a generic's type parameters from the arguments at a call site.
//
// Each declared parameter type is matched against the argument's actual type; a parameter that
// no argument mentions cannot be inferred, and says so. The bound is checked here too, where
// the type argument is chosen — which is the point of a bound, and the same place stage-0
// checks it.
function (mutable self: Unit) bind_type_arguments(src: String, generic: Int, args: Int,
        params: Int, at: Int) -> Int {
    let declaration: Generic = self.generics[generic];
    let given: Node = self.nodes[args];
    let wanted: Node = self.nodes[params];
    let mutable i: Int = 0;
    while i < wanted.b && i < given.b {
        let parameter: Node = self.nodes[self.children[wanted.a + i]];
        let declared: Type = self.declared_type(src, parameter.a);
        // A bare `T`, a slice, an array — or a generic APPLICATION like `Option<T>`, which is kind 46
        // and was skipped here. `unify` has handled applications since generics landed; this was the
        // only place that did not ask it to.
        //
        // It went unnoticed because a parameter reachable ONLY through an application —
        // `option_is_some(o: Option<T>) -> Bool`, whose single parameter mentions T nowhere else —
        // happened to find `T` already bound by an enclosing call. Scoping the lookup to the current
        // call (see `type_binding_floor`) removed that accident and the gap showed immediately, which
        // is the useful shape of a fix: it made a second bug visible rather than hiding it.
        // 53 — a TUPLE parameter, `first<T>(p: (T, Int))`. The same omission the comment above
        // records for kind 46, one type along and found the same way: `unify` had grown its
        // tuple arm and this list had not, so `T` was never bound and the call's return type
        // stayed `T`. The list is what decides which parameters are even ASKED about, which is
        // why a gap in it is silent — nothing complains, the type simply never settles.
        // 49 — a `dynamic Mapper<T, U>` parameter, roadmap A9. **The third instance of the
        // omission the two paragraphs above record**, and it behaved exactly as they predict:
        // `unify` had grown its arm for kind 49 and this list had not, so `U` never settled and
        // the call was refused with "cannot tell what `U` is" — while stage-0 compiled the same
        // program. A divergence in what is ACCEPTED, caught by running a pass fixture on both
        // compilers rather than on the one just changed.
        if declared.kind == 50 || declared.kind == 47 || declared.kind == 48
                || declared.kind == 46 || declared.kind == 53 || declared.kind == 49 {
            let actual: Type = self.type_of(src, self.children[given.a + i], unknown_type());
            if !is_unknown(actual) {
                let matched: Bool = self.unify(src, declared, actual);
                if !matched {
                    let complained: Int = self.complain_at(src, at,
                                "argument " + to_string(i + 1) + " does not fit "
                                + self.show_type(src, declared) + ": it is "
                            + self.show_type(src, actual));
                }
            }
        }
        i += 1;
    }
    // Every parameter has to have been settled by something, and to satisfy its bound.
    let mutable p: Int = 0;
    while p < declaration.type_param_count {
        let slot: Int = declaration.type_param_start + p;
        let named: Token = self.tokens[self.type_parameters[slot]];
        // "Settled" means a binding EXISTS, not that it is concrete. A generic calling a
        // generic binds `T` to the enclosing `T` — still abstract, and correct: the copy
        // appears when the outer generic is instantiated. Asking whether the resolved kind is
        // still 50 cannot tell that from "nobody said", which is why this asks the table.
        let settled: Bool = self.has_binding(src, named.start, named.length);
        let stands_for: Type = self.resolve_shallow(src,
                    Type { kind: 50, scale: 0, contract: 0,
                name_start: named.start, name_length: named.length });
        if !settled {
            let complained: Int = self.complain_at(src, at,
                        "cannot tell what `" + substring(src, named.start, named.length)
                    + "` is from this call: no argument mentions it");
        } else if stands_for.kind != 50 {
            let satisfied: Int = self.check_bound(src, self.type_param_bounds[slot],
                    stands_for, named, at);
        }
        p += 1;
    }
    return 1;
}

// Does this type argument satisfy the bound the signature declared?
//
// The two the language ships mirror exactly what it already allows: `Ordered` is Int, Decimal
// and String — the types `<` works on, String by BYTE order since v0.0.202 — and `Equatable`
// adds Bool, the types `==` works on. A bound cannot promise more than the language delivers.
function (mutable self: Unit) check_bound(src: String, bound: Int, argument: Type,
        parameter: Token, at: Int) -> Int {
    if bound < 0 {
        return 0;
    }
    let named: Token = self.tokens[bound];
    if span_equal(src, named.start, named.length, "Ordered") {
        if argument.kind != 40 && argument.kind != 45 && argument.kind != 42 {
            let complained: Int = self.complain_at(src, at,
                        "`" + substring(src, parameter.start, parameter.length)
                        + ": Ordered` needs a type with an order, and " + self.show_type(src, argument)
                    + " has none: Ordered is Int, Decimal and String");
        }
        return 1;
    }
    if span_equal(src, named.start, named.length, "Equatable") {
        if argument.kind != 40 && argument.kind != 41 && argument.kind != 42
                && argument.kind != 45 {
            let complained: Int = self.complain_at(src, at,
                        "`" + substring(src, parameter.start, parameter.length)
                        + ": Equatable` needs a type two values of which can be compared, and "
                    + self.show_type(src, argument) + " is not one");
        }
        return 1;
    }
    // Any other bound names a declared trait, and satisfying it means having an implementation.
    // Interfaces are registered in the same table classes and enums are, so one lookup covers all
    // three — and a bound naming a class rather than an interface fails the implementation check
    // below, which is the honest place for it.
    if self.find_type(src, named.start, named.length) < 0 {
        let complained: Int = self.complain_at(src, at,
                    "`" + substring(src, parameter.start, parameter.length) + ": "
                    + substring(src, named.start, named.length)
                + "` names something that is not an interface this program declares");
        return 1;
    }
    if argument.kind != 46 {
        let complained: Int = self.complain_at(src, at,
                    self.show_type(src, argument) + " cannot implement an interface — only a class or an "
                + "enum can");
        return 1;
    }
    let mutable i: Int = 0;
    while i < len(self.impls) {
        let candidate: Implementation = self.impls[i];
        if spans_equal(src, candidate.trait_start, candidate.trait_len, named.start, named.length) {
            if spans_equal(src, candidate.type_start, candidate.type_len,
                    argument.name_start, argument.name_length) {
                return 1;
            }
        }
        i += 1;
    }
    let complained: Int = self.complain_at(src, at,
                self.show_type(src, argument) + " does not implement `"
                + substring(src, named.start, named.length)
            + "`: conformance is declared, never inferred");
    return 1;
}

// The bound declared for this type parameter, as the token of the interface's name, or -1.
// Looked up by the parameter's own name span, which is unique within the declaration that
// owns it.
// A node that denotes this type, so a resolved element can be pointed AT.
//
// The inverse of `declared_type`, and the one place stage-1 does synthesize an arena entry. A
// slice holds its element as a node index, so turning `[T]` into `[Int]` means there has to BE
// a node for `Int` — and until a use asks, there is not. The token is borrowed from `at`, so a
// diagnostic about a synthesized type still points at the source that caused it.
function (mutable self: Unit) node_for(t: Type, at: Int) -> Int {
    if t.kind == 45 {
        return self.add(45, t.scale, t.contract, 0, 0, at);
    }
    if t.kind == 46 || t.kind == 49 || t.kind == 50 {
        // A named type's node identifies its name by TOKEN and a Type carries only the span,
        // so the token has to be found. Every name came from the source, so one exists.
        let token: Int = self.token_starting_at(t.name_start);
        if token < 0 {
            return 0 - 1;
        }
        return self.add(t.kind, t.scale, t.contract, 0, 0, token);
    }
    return self.add(t.kind, t.scale, t.contract, 0, 0, at);
}

function (self: Unit) token_starting_at(start: Int) -> Int {
    let mutable i: Int = 0;
    while i < len(self.tokens) {
        if self.tokens[i].start == start {
            return i;
        }
        i += 1;
    }
    return 0 - 1;
}

// This type with every parameter replaced, all the way down — the deep form of
// `resolve_shallow`, for the places that must hand back a self-contained answer rather than
// resolve as they go. A field's type is one: `Stack<Int>.items` has to BE `[Int]`, because
// whoever receives it no longer has the bindings.
//
// Nothing is rebuilt unless it changed, so an ordinary type costs no arena entry.
// The same Type, field for field. NOT `same_type`, which resolves both sides before comparing
// and would therefore call a `T` and the Point it stands for equal — exactly the question being
// asked here, so the answer has to be about what is WRITTEN and not what it means.
function type_identical(a: Type, b: Type) -> Bool {
    return a.kind == b.kind && a.scale == b.scale && a.contract == b.contract
            && a.name_start == b.name_start && a.name_length == b.name_length;
}

function (mutable self: Unit) resolve_deep(src: String, t: Type, at: Int) -> Type {
    let here: Type = self.resolve_shallow(src, t);
    // A generic inside a generic: `Nested<Point>.inner` is written `Pair<T>`, and whoever
    // receives it has no bindings left, so the argument has to travel down into the
    // application. Its arguments are node indices, so a changed one means a fresh argument
    // list — the one place laziness runs out, and it costs entries only when it fires.
    if here.kind == 46 && here.contract > 0 {
        let mutable changed: Bool = false;
        let mutable i: Int = 0;
        while i < here.contract {
            let written: Type = self.declared_type(src, self.nested_children[here.scale + i]);
            let settled: Type = self.resolve_deep(src, written, at);
            if !type_identical(settled, written) {
                changed = true;
            }
            i += 1;
        }
        if !changed {
            return here;
        }
        let start: Int = len(self.nested_children);
        i = 0;
        while i < here.contract {
            let written: Type = self.declared_type(src, self.nested_children[here.scale + i]);
            let settled: Type = self.resolve_deep(src, written, at);
            let node: Int = self.node_for(settled, at);
            if node < 0 {
                return here;                         // no token to point at: leave it written
            }
            let noted: Int = push(self.nested_children, node);
            i += 1;
        }
        return Type { kind: 46, scale: start, contract: here.contract,
                name_start: here.name_start, name_length: here.name_length };
    }
    // A tuple whose elements mention a parameter: `(T, Int)` inside `zip<T, U>` has to BECOME
    // `(String, Int)` for whoever receives it, because they no longer hold the bindings. The
    // same walk the generic application above does, and it is here because leaving it out was
    // measured rather than reasoned: `zip` type-checked in stage-0 and in stage-1 answered
    // `(T, U)` at the CALL SITE, so `p.0 + " is "` was refused as "cannot combine T and
    // String". A field of `Pair<String>` declared `(T, Int)` failed the same way.
    if here.kind == 53 {
        let mutable changed: Bool = false;
        let mutable i: Int = 0;
        while i < here.contract {
            let written: Type = self.declared_type(src, self.nested_children[here.scale + i]);
            let settled: Type = self.resolve_deep(src, written, at);
            if !type_identical(settled, written) {
                changed = true;
            }
            i += 1;
        }
        if !changed {
            return here;
        }
        let start: Int = len(self.nested_children);
        i = 0;
        while i < here.contract {
            let written: Type = self.declared_type(src, self.nested_children[here.scale + i]);
            let settled: Type = self.resolve_deep(src, written, at);
            let node: Int = self.node_for(settled, at);
            if node < 0 {
                return here;                         // no token to point at: leave it written
            }
            let noted: Int = push(self.nested_children, node);
            i += 1;
        }
        return Type { kind: 53, scale: start, contract: here.contract,
                name_start: 0, name_length: 0 };
    }
    if here.kind != 47 && here.kind != 48 {
        return here;
    }
    let declared: Type = self.declared_type(src, here.scale);
    let element: Type = self.resolve_deep(src, declared, at);
    // `type_identical` and NOT `same_type`, which resolves both sides before comparing and would
    // therefore call a resolved `String` and the `K` it came from equal — the exact question being
    // asked. `[K]` then answered `[K]` and a method returning `[K]` did not resolve at its call
    // site. The nested-application branch above learned this first; this one had the same bug and
    // kept it two versions longer.
    if type_identical(element, declared) {
        return here;
    }
    let node: Int = self.node_for(element, at);
    if node < 0 {
        return here;
    }
    return Type { kind: here.kind, scale: node, contract: here.contract,
            name_start: 0, name_length: 0 };
}

// Bind a generic type's parameters from an APPLICATION's arguments: `Stack<Int>` binds `T`.
// Answers the base to truncate back to, so the caller's bindings survive.
function (mutable self: Unit) bind_from_application(src: String, holder: Type) -> Int {
    let base: Int = len(self.type_bindings);
    // Kind 49 as well as 46, because A9 gave `dynamic Mapper<Int>` the SAME two slots a generic
    // application already used — arguments in `scale`, count in `contract`. So a dynamic type is
    // a named type that dispatches, and binding its arguments is this function unchanged rather
    // than a second copy of it that could disagree.
    if holder.kind != 46 && holder.kind != 49 {
        return base;
    }
    if holder.contract <= 0 {
        return base;
    }
    let generic: Int = self.generic_named(src, holder.name_start, holder.name_length);
    if generic < 0 {
        return base;
    }
    let declaration: Generic = self.generics[generic];
    let mutable i: Int = 0;
    while i < declaration.type_param_count && i < holder.contract {
        let named: Token = self.tokens[self.type_parameters[declaration.type_param_start + i]];
        let written: Type = self.declared_type(src, self.nested_children[holder.scale + i]);
        // Resolved BEFORE it is pushed, under the bindings already in scope. `Nested<Point>`
        // holds a `Pair<T>`, and binding Pair's `T` to the literal `T` would shadow the
        // Nested binding that says what `T` is — resolve_shallow searches backwards and stops
        // at the first match, so the innermost binding must already be the answer.
        // `Pair<Point>` was 2 cells instead of 4 for exactly this reason.
        let argument: Type = self.resolve_shallow(src, written);
        push(self.type_bindings, TypeBinding { name_start: named.start,
                name_length: named.length, bound: argument });
        i += 1;
    }
    return base;
}

// Is there a binding for this parameter at all? Distinct from asking what it resolves to: a
// parameter bound to ANOTHER parameter resolves to something still abstract, and that is
// settled, not missing.
function (self: Unit) has_binding(src: String, start: Int, length: Int) -> Bool {
    let mutable i: Int = 0;
    while i < len(self.type_bindings) {
        let binding: TypeBinding = self.type_bindings[i];
        if spans_equal(src, binding.name_start, binding.name_length, start, length) {
            return true;
        }
        i += 1;
    }
    return false;
}

function (self: Unit) bound_of(src: String, start: Int, length: Int) -> Int {
    if self.current_generic < 0 {
        return 0 - 1;
    }
    let declaration: Generic = self.generics[self.current_generic];
    let mutable i: Int = 0;
    while i < declaration.type_param_count {
        let at: Int = declaration.type_param_start + i;
        let named: Token = self.tokens[self.type_parameters[at]];
        if spans_equal(src, named.start, named.length, start, length) {
            return self.type_param_bounds[at];
        }
        i += 1;
    }
    return 0 - 1;
}

function (self: Unit) resolve_shallow(src: String, t: Type) -> Type {
    if t.kind != 50 {
        return t;
    }
    // Backwards to the FLOOR, not to zero. The floor is where the current generic call's bindings
    // begin, so a nested call to the same generic starts with `T` unbound rather than inheriting the
    // enclosing call's answer — see `type_binding_floor`.
    let mutable i: Int = len(self.type_bindings) - 1;
    while i >= self.type_binding_floor {
        let binding: TypeBinding = self.type_bindings[i];
        if spans_equal(src, binding.name_start, binding.name_length, t.name_start, t.name_length) {
            return binding.bound;
        }
        i -= 1;
    }
    return t;                                        // still abstract: inside the generic itself
}

// Match a declared parameter type against an argument's actual type, binding type parameters
// as it goes. The whole of stage-1's inference: structural, one direction, no backtracking —
// the same shape stage-0 uses, so the two agree by construction rather than by coincidence.
function (mutable self: Unit) unify(src: String, declared: Type, actual: Type) -> Bool {
    if declared.kind == 50 {
        let already: Type = self.resolve_shallow(src, declared);
        if already.kind != 50 {
            return self.same_type(src, already, actual);   // bound once, so it must agree
        }
        let noted: Int = push(self.type_bindings,
                    TypeBinding { name_start: declared.name_start, name_length: declared.name_length,
                bound: actual });
        return true;
    }
    if declared.kind != actual.kind {
        return false;
    }
    if declared.kind == 47 {
        return self.unify(src, self.declared_type(src, declared.scale),
                self.declared_type(src, actual.scale));
    }
    if declared.kind == 48 {
        if declared.contract != actual.contract {
            return false;
        }
        return self.unify(src, self.declared_type(src, declared.scale),
                self.declared_type(src, actual.scale));
    }
    // A tuple, element by element — `(T, Int)` against `(String, Int)` binds `T`.
    //
    // **The two compilers pay very different prices for this arm, and that is worth
    // recording because it nearly became a divergence.** Here the elements are simply
    // there: stage-1 never monomorphises, so a tuple stays a tuple with its element nodes
    // beside it. Stage-0 has already replaced `(String, Int)` with the anonymous class it
    // made of it, so its `unify` had to be given a second map to find the elements again —
    // and the first version of A8 left that unbuilt and had stage-0 REFUSE instead. That
    // would have been a difference in what is ACCEPTED, which is §B15's direction. The map
    // was cheaper than the divergence.
    if declared.kind == 53 {
        if declared.contract != actual.contract {
            return false;
        }
        let mutable e: Int = 0;
        while e < declared.contract {
            let want: Type = self.declared_type(src, self.nested_children[declared.scale + e]);
            let got: Type = self.declared_type(src, self.nested_children[actual.scale + e]);
            if !self.unify(src, want, got) {
                return false;
            }
            e += 1;
        }
        return true;
    }
    // A named APPLICATION, argument by argument: `Map<K, V>` against `Map<String, Int>` binds both.
    // Without this, unify handled slices and stopped, so a parameter reachable only through a type
    // argument could not be inferred — which is every constructor, since `-> Map<K, V>` mentions
    // its parameters only there.
    // Kind 49 rides this arm too: `dynamic Mapper<T, U>` against `dynamic Mapper<Int, String>`
    // binds both, and it is the same walk because A9 gave a dynamic type the same two slots.
    // Roadmap A9.
    //
    // **This was a measured divergence, not a precaution.** With the arm restricted to 46,
    // stage-0 compiled `map<T, U>(xs: [T], f: dynamic Mapper<T, U>)` and stage-1 refused it with
    // "cannot tell what `U` is from this call" — a difference in what is ACCEPTED, which is
    // §B15's direction. `tests/pass/a_free_generic_maps_with_a_generic_interface.bx` is the
    // program that caught it, and it caught it because a pass fixture was run on both compilers
    // rather than on the one that had just been changed.
    if declared.kind == 46 || declared.kind == 49 {
        if declared.contract <= 0 {
            return self.same_type(src, declared, actual);
        }
        if declared.contract != actual.contract {
            return false;
        }
        if !spans_equal(src, declared.name_start, declared.name_length,
                actual.name_start, actual.name_length) {
            return false;
        }
        let mutable i: Int = 0;
        while i < declared.contract {
            let want: Type = self.declared_type(src, self.nested_children[declared.scale + i]);
            let got: Type = self.declared_type(src, self.nested_children[actual.scale + i]);
            if !self.unify(src, want, got) {
                return false;
            }
            i += 1;
        }
        return true;
    }
    return self.same_type(src, declared, actual);
}

// A TYPE NODE for a type that was inferred rather than written, or -1 when there can be none.
//
// This is the whole difficulty of A3's fourth shape, and it is a representation problem rather than
// an inference one. Stage-1 spells a generic application as `kind 46` with `scale` = a start into
// `nested_children` and `contract` = a count — and those entries are NODE INDICES. A type nobody
// wrote down has no node, so `Option` with `T = Int` inferred from a `5` cannot be said at all.
//
// Except for the kinds `declared_type` reads WITHOUT looking at the token, which is exactly the
// trick `int_type_node` in `ast.bx` already uses for `c_bytes_at`'s `[Int]`: a scalar node carries
// its whole meaning in its KIND, so one can be created with no span and nothing will ever ask where
// it was written. A Decimal carries scale and rounding in `a` and `b`. A slice or an array already
// holds its element as a node index, so it recurses onto something real.
//
// A NAMED type cannot: `declared_type` reads `self.tokens[n.token]` to get the name's span, and
// there is no token whose bytes spell `Point` at the point of inference. So this answers -1 there,
// the caller settles nothing, and the program stays REFUSED.
//
// **Refused, and that is the conservative half on purpose.** Binding the parameter without a node
// the EMITTER can read looked like it worked — the checker was happy and `match Option.Some(p)`
// type-checked — and then the compiled program SEGFAULTED, because the binding lived in the
// checker's table and the emitter runs long after it is gone, so the payload's width was read off
// an unresolved `T`. A refusal is safe and a miscompile is not, and that trade is the reason this
// function exists instead of a `unify` call on its own.
function (mutable self: Unit) inferred_type_node(src: String, t: Type) -> Int {
    if t.kind == 40 || t.kind == 41 || t.kind == 42 || t.kind == 43 || t.kind == 44
            || t.kind == 51 {
        return self.add(t.kind, 0, 0, 0, 0, 0);
    }
    if t.kind == 45 {                                // Decimal<scale, rounding>
        return self.add(45, t.scale, t.contract, 0, 0, 0);
    }
    if t.kind == 47 || t.kind == 48 {
        // A slice or an array already points at its element's real node, so this needs no new one
        // for the element — only for the wrapper.
        return self.add(t.kind, t.scale, t.contract, 0, 0, 0);
    }
    return 0 - 1;                                    // named, interface, or still a parameter
}

// Bind a generic enum's type parameters from the ARGUMENTS of a variant being constructed, and
// answer where the resulting type arguments start in `nested_children` — or -1 if they cannot be
// spelled.
//
// The fourth way a variant learns what its parameter is, and the one stage-1 was missing. The other
// three all put the answer somewhere a Type could already be read from — a declared return type, an
// annotation, a concrete instantiation — and `type_of`'s constructor branch took the whole answer
// from `expected` because of it. `match Option.Some(5) { ... }` writes the answer nowhere: the only
// thing that knows `T` is `Int` is the `5`.
//
// `unify` is what reads it, which is why the inference itself is four lines: walk the variant's
// declared payload types against the actual argument types and let `unify` push a binding for every
// parameter it meets. `Pair2.Both(4, "four")` settles `A = Int` and `B = String` in one pass,
// because `unify` is structural and does not care which position it is in.
//
// The bindings are then READ BACK and turned into nodes, and dropped before this returns. Nothing
// leaks, and the answer is a real application — which matters because the EMITTER has to resolve
// the payload's width later, with no binding table of its own. See `inferred_type_node` for why
// that is possible for some argument types and not others, and what happened when it was skipped.
function (mutable self: Unit) infer_variant_arguments(src: String, declared: Int,
        call: Node) -> Int {
    if call.kind != 14 || call.b < 0 {
        return 0 - 1;                                // `Option.None`: no argument to read
    }
    let holder_name: Token = self.tokens[self.nodes[call.a].token];
    let generic: Int = self.generic_named(src, holder_name.start, holder_name.length);
    if generic < 0 {
        return 0 - 1;                                // not generic: nothing to settle
    }
    let item: Node = self.nodes[self.types[declared].node];
    let wanted: Token = self.tokens[call.token];
    let list: Node = self.nodes[call.b];
    let base: Int = len(self.type_bindings);
    let mutable i: Int = 0;
    while i < item.b {
        let variant: Node = self.nodes[self.children[item.a + i]];
        let named: Token = self.tokens[variant.token];
        if spans_equal(src, named.start, named.length, wanted.start, wanted.length) {
            let mutable p: Int = 0;
            while p < variant.c && p < list.b {
                let stated: Type = self.declared_type(src, self.nested_children[variant.b + p]);
                // Only a payload that MENTIONS a parameter can settle one. Asking the others would
                // type an argument twice — here and again in `check_construction` — and double
                // every complaint the argument itself deserves.
                if self.mentions_parameter(src, stated) {
                    let actual: Type = self.type_of(src, self.children[list.a + p],
                            unknown_type());
                    if !is_unknown(actual) {
                        let matched: Bool = self.unify(src, stated, actual);
                    }
                }
                p += 1;
            }
        }
        i += 1;
    }
    // Every parameter the declaration has, in order, read back out of the bindings and turned into
    // a node. All or nothing: a partly-spelled application would be worse than none, because the
    // emitter would resolve some arguments and guess at the rest.
    let declaration: Generic = self.generics[generic];
    let mutable nodes: [Int] = [];
    let mutable settled: Bool = declaration.type_param_count > 0;
    let mutable q: Int = 0;
    while q < declaration.type_param_count {
        let parameter: Token = self.tokens[self.type_parameters[declaration.type_param_start + q]];
        let stands_for: Type = self.resolve_shallow(src,
                    Type { kind: 50, scale: 0, contract: 0,
                name_start: parameter.start, name_length: parameter.length });
        let made: Int = self.inferred_type_node(src, stands_for);
        if made < 0 {
            settled = false;
        } else {
            push(nodes, made);
        }
        q += 1;
    }
    let dropped: Int = truncate(self.type_bindings, base);
    if !settled {
        return 0 - 1;
    }
    let start: Int = len(self.nested_children);
    let mutable k: Int = 0;
    while k < len(nodes) {
        push(self.nested_children, nodes[k]);
        k += 1;
    }
    return start;
}

// Does this type mention a type PARAMETER anywhere inside it? `T` does, `[T]` does, `Option<T>`
// does, `Int` does not. The same question `mentions_param` asks in `typeck.rs`, and it is asked for
// the same reason: a payload with no parameter in it can settle nothing, so reading the argument
// would be work with no answer in it.
function (self: Unit) mentions_parameter(src: String, t: Type) -> Bool {
    if t.kind == 50 {
        return true;
    }
    if t.kind == 47 || t.kind == 48 {
        return self.mentions_parameter(src, self.declared_type(src, t.scale));
    }
    if t.kind == 46 || t.kind == 49 {
        let mutable i: Int = 0;
        while i < t.contract {
            if self.mentions_parameter(src, self.declared_type(src,
                    self.nested_children[t.scale + i])) {
                return true;
            }
            i += 1;
        }
    }
    return false;
}

// The generic declaration this name belongs to, or -1.
// ---- `?`: the four questions it asks about an enum ---------------------------------------

// "a" or "an", so a message reads as English — "an Int", "a Bool". Stage-0 keeps this on `Type`
// as `article`; here it is a free function because a Burxt class holds no methods of its own in
// this compiler and every other type predicate is a free function too.
function article_for(t: Type) -> String {
    if t.kind == 40 {
        return "an";
    }
    return "a";
}

// Which variant of this enum is the FAILURE — the one called `Error` or `None` — or -1.
//
// By NAME, which is stage-0's rule and the one that makes `?` work on an enum a program declared
// itself. Order does not matter: a declaration may put the failure first or second, and
// `lib/option.bx` and `lib/result.bx` disagree about that, which is exactly why this searches
// rather than assuming a position.
function (self: Unit) failure_variant_index(src: String, holder: Type) -> Int {
    let found: Int = self.find_type(src, holder.name_start, holder.name_length);
    if found < 0 || self.types[found].kind != 83 {
        return -1;
    }
    let item: Node = self.nodes[self.types[found].node];
    let mutable v: Int = 0;
    while v < item.b {
        let variant: Node = self.nodes[self.children[item.a + v]];
        let named: Token = self.tokens[variant.token];
        if span_equal(src, named.start, named.length, "Error")
                || span_equal(src, named.start, named.length, "None") {
            return v;
        }
        v += 1;
    }
    return -1;
}

// Which variant of this enum ITEM carries this name, or -1. Split out from
// `failure_variant_index` because the second lookup asks a different question: not "which one is
// the failure" but "does the function I am returning from spell its failure the same way".
function (self: Unit) variant_named(src: String, item: Node, wanted: Token) -> Int {
    let mutable v: Int = 0;
    while v < item.b {
        let variant: Node = self.nodes[self.children[item.a + v]];
        let named: Token = self.tokens[variant.token];
        if spans_equal(src, named.start, named.length, wanted.start, wanted.length) {
            return v;
        }
        v += 1;
    }
    return -1;
}

// One variant's payload types, resolved under its enum's type arguments and rendered as
// `Int, String` — stage-0's `type_list`, and only ever used in a message.
//
// The bind/resolve/unbind is not decoration: `Result<Int, String>`'s `Error` carries `E`, and a
// refusal that said "this one carries E" would name a letter the reader would have to go and
// look up. Stage-0 has no such step because it MONOMORPHISES — `Result<Int, String>` becomes a
// nominal enum whose payloads are already concrete — while stage-1 resolves lazily. Different
// mechanism, identical text, which is the only part a reader sees.
function (mutable self: Unit) payload_list(src: String, holder: Type, variant: Node) -> String {
    let restore: Int = self.bind_from_application(src, holder);
    let mutable out: String = "";
    let mutable p: Int = 0;
    while p < variant.c {
        if p > 0 {
            out = out + ", ";
        }
        out = out + self.show_type(src,
                self.resolve_shallow(src, self.declared_type(src, self.nested_children[variant.b + p])));
        p += 1;
    }
    let dropped: Int = truncate(self.type_bindings, restore);
    return out;
}

// Do these two variants carry exactly the same payload? Length and every type, which is what
// stage-0's `!=` on two `Vec<Type>` compares.
//
// **The two sides are bound and unbound SEPARATELY, and that is the whole subtlety.** Both enums
// name their parameters `T` or `E`, and `resolve_shallow` searches the bindings backwards and
// stops at the first hit — so binding the second application on top of the first would shadow
// it, and `Result<Int, String>` propagated into `Result<Int, Int>` would compare `String` against
// `String` and be accepted. That is a miscompile rather than a wrong message: the payload would
// then be copied into a cell of the wrong type.
function (mutable self: Unit) payloads_agree(src: String, mine: Type, my_variant: Node,
        theirs: Type, their_variant: Node) -> Bool {
    if my_variant.c != their_variant.c {
        return false;
    }
    let mutable p: Int = 0;
    while p < my_variant.c {
        let here: Int = self.bind_from_application(src, mine);
        let a: Type = self.resolve_shallow(src,
                self.declared_type(src, self.nested_children[my_variant.b + p]));
        let dropped_here: Int = truncate(self.type_bindings, here);
        let there: Int = self.bind_from_application(src, theirs);
        let b: Type = self.resolve_shallow(src,
                self.declared_type(src, self.nested_children[their_variant.b + p]));
        let dropped_there: Int = truncate(self.type_bindings, there);
        if !self.same_type(src, a, b) {
            return false;
        }
        p += 1;
    }
    return true;
}

// What the body being checked answers with, or unknown at the top level.
//
// Two tables because a method is not a function in this compiler's symbol tables, and exactly one
// of the two indices is set inside a body — `check_item` clears both and sets whichever applies,
// then restores. Derived rather than tracked in a third field, for the reason `inside_class`
// records: a field that has to be set and restored is a field that can leak.
function (self: Unit) enclosing_return_type() -> Type {
    if self.current_method >= 0 {
        return self.methods[self.current_method].return_type;
    }
    if self.current_function >= 0 {
        return self.functions[self.current_function].return_type;
    }
    return unknown_type();
}

// ---- the C boundary ------------------------------------------------------------------------
//
// Everything a value has to survive to cross into C, checked at the DECLARATION rather than at a
// call. A crossing that cannot work does not become workable because nobody called it yet, and the
// declaration is the line a reader can fix.
//
// **Why this group matters more than its size suggests.** These rules are what stop a `Decimal<2>`
// reaching C as a float. A Decimal is an exact scaled integer; a C `double` cannot hold most money
// amounts, so a crossing that let one through would lose cents silently — which is the failure the
// whole language exists to refuse, at the one boundary where the type system stops. Stage-1 parsed
// `external` and `as scaled` since they landed and checked neither, so all five refusals below were
// stage-0's alone: five of the 43 gaps, in the group where being wrong costs most.

// May this type come back from C?
//
// Int, CInt and CPointer, and nothing else. `CDouble` and `String` get their own messages because
// the two mistakes have different answers — one is about precision, the other about ownership.
function (mutable self: Unit) check_extern_return(src: String, at: Int, named: String,
        answered: Type) -> Int {
    // A sized width joins Int, CInt and CPointer, roadmap A7 — the return side of the boundary
    // admission, and the mirror of `check_extern_param` below. Stage-0 accepted `-> i32` from the
    // version widths landed; stage-1 refused it, which is a divergence in what is ACCEPTED and the
    // direction that matters most (§B15).
    if answered.kind == 40 || answered.kind == 43 || answered.kind == 51 || is_width(answered) {
        return 0;
    }
    if answered.kind == 44 {                         // CDouble
        let complained: Int = self.complain_at(src, at,
                    "external function `" + named + "` returns CDouble, but Burxt has no float type to "
                    + "receive it exactly — a double cannot hold most decimal amounts. Have the C function "
                + "return the scaled integer (declare `-> Int`), or return it as text.");
        return 1;
    }
    let complained: Int = self.complain_at(src, at,
                "external function `" + named + "` returns " + self.show_type(src, answered)
                + ", but only Int, CInt, a sized width (i32, u8, u32, u64) or CPointer may cross the C "
                + "boundary as a return — a "
                + self.show_type(src, answered) + " is a Burxt value with an owner, and C cannot say whose "
                + "it is. If the C function returns a pointer, declare `-> CPointer` and read it with "
                + "`c_string_at`, which copies. (If it returns a 32-bit `int`, declare `-> CInt` or `-> i32` "
            + "so the sign survives.)");
    return 1;
}

// **The parameter half of the boundary admission, and `check_extern_return` above has called it
// "the mirror of `check_extern_param` below" since it was written. There was no such function.**
//
// A comment naming a function nobody wrote, and the effect was not cosmetic: stage-1 admitted ANY
// type as an extern's parameter. Measured, stage-0 refusing each and stage-1 silent —
//
//     external function e(b: Bool) -> CInt;          a Burxt value C cannot hold
//     external function e(xs: [Int]) -> CInt;        region storage, with an owner
//     external function e(p: Point) -> CInt;         a class, likewise
//     external function e(x: Nope) -> CInt;          a type that does not exist at all
//
// — four acceptance divergences behind one missing arm, and the last of them is why this was found:
// closing stage-1's silence about unknown types in a signature left the extern case answering with
// the wrong sentence, because the right sentence had nowhere to come from.
//
// Decimal is admitted here and judged by `check_marshalling`, which asks the different question:
// not *may this cross* but *has the crossing said how it is encoded*. Keeping them separate is what
// lets the Decimal message name the fix — `as scaled` — instead of listing what C can hold.
//
// Stage-0's sentence to the byte. `typeck.rs` puts this on the same path and the same list, and the
// widths join it here and nowhere else, which IS the boundary rule (roadmap A7).
function (mutable self: Unit) check_extern_param(src: String, at: Int, label: String,
        own: String, declared: Type) -> Int {
    // Int, String, CInt, CDouble, CPointer, a sized width — and a Decimal, whose separate question
    // `check_marshalling` asks.
    if declared.kind == 40 || declared.kind == 42 || declared.kind == 43 || declared.kind == 44
            || declared.kind == 51 || declared.kind == 45 || is_width(declared) {
        return 0;
    }
    let complained: Int = self.complain_at(src, at,
                "in " + label + ", parameter `" + own + "` has type "
                + self.show_type(src, declared) + ", but only Int, CInt, a sized width (i32, u8, u32, u64), "
                + "CDouble, String and a marshalled Decimal may cross the C boundary for now — C has no "
            + self.show_type(src, declared) + ", and the raw value would silently lose its meaning.");
    return 1;
}

// The marshalling rules, which are two halves of one fact: `as scaled` says how a Decimal is
// encoded for a foreign callee, so it is REQUIRED on a Decimal crossing into C and MEANINGLESS
// anywhere else.
//
// `foreign` decides which half applies, so one function serves both and the two cannot drift into
// disagreeing about what a marshaller is for.
function (mutable self: Unit) check_marshalling(src: String, params: Int, foreign: Int,
        label: String) -> Int {
    if params < 0 {
        return 0;
    }
    let list: Node = self.nodes[params];
    let mutable p: Int = 0;
    while p < list.b {
        let param: Node = self.nodes[self.children[list.a + p]];
        let named: Token = self.tokens[param.token];
        let own: String = substring(src, named.start, named.length);
        let declared: Type = self.declared_type(src, param.a);
        if foreign == 0 {
            // A Burxt-to-Burxt call passes the value itself, exactly. There is no foreign encoding
            // on the other side, so there is nothing to marshal INTO.
            if param.value == 1 {
                let complained: Int = self.complain_at(src, param.token,
                            "in " + label + ", parameter `" + own + "` is marked `as scaled`, but "
                            + "marshalling only exists where there is a foreign encoding to marshal into. "
                            + "A Burxt-to-Burxt call passes the value itself, exactly — drop the "
                        + "`as scaled`.");
            }
        } else {
            // May this type cross at all — asked before how it is encoded, because "C has no Bool"
            // and "say how this Decimal is scaled" are answers to different questions and the
            // second is meaningless for a type that cannot cross.
            let admitted: Int = self.check_extern_param(src, param.token, label, own, declared);
            if declared.kind == 45 && param.value == 0 {
                let complained: Int = self.complain_at(src, param.token,
                            "in " + label + ", parameter `" + own + "` is "
                            + self.show_type(src, declared) + " and C has no decimal type, so the crossing "
                            + "has to say how the value is encoded. Declare `" + own + ": "
                            + self.show_type(src, declared) + " as scaled` to pass the exact unscaled "
                        + "integer, or take a String and pass `to_string(" + own + ")` as text.");
            }
            if declared.kind != 45 && param.value == 1 {
                let complained: Int = self.complain_at(src, param.token,
                            "in " + label + ", parameter `" + own + "` is "
                            + self.show_type(src, declared) + ", which C holds directly — `as scaled` only "
                        + "means something for a Decimal, whose scale C has no way to carry.");
            }
        }
        p += 1;
    }
    return 1;
}

// ---- lvalues: what a write actually names --------------------------------------------------

// The ROOT name of an assignment target. `a[0]`, `item.price` and `grid[i].cells[j]` all write
// into ONE binding, and it is that binding's mutability that decides whether the write is allowed
// — so the rule has to walk down to the name rather than look at the outermost node.
//
// -1 when the target bottoms out in something that is not a name, which is how
// `Account { ... }.balance = 1` is told from `acct.balance = 1`: there is no binding to ask about.
function (self: Unit) lvalue_root(node: Int) -> Int {
    let mutable at: Int = node;
    while at >= 0 {
        let n: Node = self.nodes[at];
        if n.kind == 5 {
            return at;
        }
        if n.kind == 11 || n.kind == 12 {            // .field, [index]
            at = n.a;
        } else {
            return -1;
        }
    }
    return -1;
}

// The target as the programmer wrote it — `item.price`, `a[...]` — for the message. An index is
// shown as `[...]` rather than evaluated, which is stage-0's spelling too: the index may be any
// expression and quoting it back would make the message longer without making it clearer.
function (self: Unit) lvalue_text(src: String, node: Int) -> String {
    let n: Node = self.nodes[node];
    if n.kind == 5 || n.kind == 11 {
        let named: Token = self.tokens[n.token];
        let own: String = substring(src, named.start, named.length);
        if n.kind == 5 {
            return own;
        }
        return self.lvalue_text(src, n.a) + "." + own;
    }
    if n.kind == 12 {
        return self.lvalue_text(src, n.a) + "[...]";
    }
    return "this";
}

// How to make `bindings[found]` writable — the advice half of every "declared immutable"
// message. Stage-0's `how_to_make_writable`, to the byte.
//
// One function because there are several of those messages and the wrong half of each is the
// same: "declare it `let mutable x`" names a `let` that a PARAMETER does not have and cannot be
// given. Stage-1 could not even ask the question — nothing recorded which bindings were
// parameters — so it said the unfollowable thing every time, and the divergence from stage-0 was
// invisible because no fixture put a parameter in front of one of these rules. `param_depth`
// exists for this and nothing else.
//
// **Three sentences, and which one is right is decided by two facts**: whether the name is a
// parameter, and whether the type crosses by pointer or by copy. On a scalar parameter even
// `mutable` would not help — the value is copied at the boundary — so the advice is to take a
// copy here on purpose, which is what the reader actually wants.
function (self: Unit) writable_advice(src: String, found: Int) -> String {
    let held: Binding = self.bindings[found];
    let named: String = substring(src, held.start, held.length);
    let shown: String = self.show_type(src, held.bound_type);
    // The RECEIVER first, and it is the branch that made this function necessary in BOTH
    // compilers rather than one: `self` is pushed at `param_depth` here, so without this arm
    // stage-1 called it a parameter while stage-0 called it a `let`, and both were unfollowable.
    if named == "self" {
        return "It is the RECEIVER: declare the method `function (mutable self: " + shown
                + ") ...` to allow it.";
    }
    if held.depth != self.param_depth {
        return "Declare it `let mutable " + named + ": " + shown + "` to allow it.";
    }
    if is_aggregate_type(held.bound_type) {
        return "It is a PARAMETER, and a parameter is a copy unless the signature says "
                + "otherwise: declare it `mutable " + named + ": " + shown + "`, which also tells "
                + "every caller that this call changes what they passed.";
    }
    let mutable article: String = "a";
    if held.bound_type.kind == 40 {
        article = "an";
    }
    return "It is a PARAMETER, and " + article + " " + shown + " is copied when it crosses — so "
            + "changing it here could not reach the caller anyway. Take a copy you own: "
            + "`let mutable own: " + shown + " = " + named + ";`";
}

// Refuse a write through an immutable name. Answers 1 when it complained.
//
// Stage-1 checked mutability for `name = value` and NOWHERE else until v0.0.223, so `a[0] = 9` and
// `item.price = 2.00` on immutable bindings both compiled — two of the 43 fixtures stage-0 refused
// and stage-1 waved through. The rule was there; it only looked at one shape of target.
function (mutable self: Unit) refuse_immutable_write(src: String, target: Int) -> Int {
    let root: Int = self.lvalue_root(target);
    if root < 0 {
        return 0;
    }
    let base: Token = self.tokens[self.nodes[root].token];
    let found: Int = self.find_binding(src, base.start, base.length);
    // `== 1`, not `!= 0`: 1 is the only code that means writable, and `!= 0` here would read a
    // `for` range's counter (code 2) as writable. See `Binding` in ast.bx.
    if found < 0 || self.bindings[found].writable == 1 {
        return 0;
    }
    let named: String = substring(src, base.start, base.length);
    let complained: Int = self.complain_at(src, self.nodes[root].token,
                "cannot assign to `" + self.lvalue_text(src, target) + "`: `" + named
            + "` was declared immutable. " + self.writable_advice(src, found));
    return 1;
}

// ---- inferring a generic class's type arguments from a literal ----------------------------
//
// `let held = Holder { one: 42 };` with no annotation. Stage-0 reads `T = Int` off the field
// VALUE; stage-1 could not, and the consequence was the worse direction of divergence — it
// **refused a valid program**, three errors deep, and `examples/generics.bx` documents the feature
// in prose two lines above the line that would not compile.
//
// Why it went unseen is the reusable part: the front-end sweep asserted `errors: 0` and
// `parse errors: 0` and never read `type errors:`, which was in the same output all along. A
// missed refusal lets a bad program through; an invented refusal makes the compiler unusable, and
// only one of the two directions was being measured.

// A real token whose span is exactly this one, or -1.
//
// Needed because a generic application holds its arguments as type NODES, and a node names a type
// through its TOKEN — so representing an inferred `Int` needs somewhere in the source that says
// `Int`. Every inferred argument came from a field value whose type was written down, so the token
// exists; -1 means it did not, and the caller then infers nothing rather than inventing a span.
function (self: Unit) token_at_span(start: Int, length: Int) -> Int {
    let mutable i: Int = 0;
    while i < len(self.tokens) {
        let t: Token = self.tokens[i];
        if t.start == start && t.length == length {
            return i;
        }
        i += 1;
    }
    return -1;
}

// A type NODE standing for a type the checker worked out, or -1 when it cannot be represented.
//
// The arena is the only representation a generic application has for its arguments, so an inferred
// argument has to become a node like a written one. Synthesising nodes during checking is already
// how `[Int]` is built for `c_bytes_at` — see `int_type_node` in parser.bx — so this is an existing
// habit rather than a new liberty.
//
// A slice or array is REUSED rather than rebuilt: its `scale` already holds its element's node, so
// the same element serves. Returning -1 for anything else is the safe direction — no inference, and
// the caller falls back to the message that asks for an annotation.
function (mutable self: Unit) type_as_node(src: String, t: Type) -> Int {
    if t.kind == 40 || t.kind == 41 || t.kind == 42 || t.kind == 43 || t.kind == 44
            || t.kind == 51 {
        // These read nothing but `kind` back out of the node, so the token is never consulted.
        return self.add(t.kind, 0, 0, 0, 0, 0);
    }
    if t.kind == 45 {
        return self.add(45, t.scale, t.contract, 0, 0, 0);
    }
    if t.kind == 47 || t.kind == 48 {
        return self.add(t.kind, t.scale, t.contract, 0, 0, 0);
    }
    if t.kind == 46 || t.kind == 49 || t.kind == 50 {
        let tok: Int = self.token_at_span(t.name_start, t.name_length);
        if tok < 0 {
            return -1;
        }
        return self.add(t.kind, t.scale, t.contract, 0, 0, tok);
    }
    return -1;
}

// `Holder { one: 42 }` with nothing said about `T`: read each parameter off the field that IS it.
//
// Answers `plain` — the bare `Holder`, with no arguments — when any parameter cannot be settled,
// which leaves the existing "cannot tell what Holder holds" refusal to fire. That is deliberate and
// it is what the example documents: `Stack` names its type because `items: [T]` initialised with
// `[]` says nothing, while `one: T` given `42` says everything.
//
// Only a field whose declared type IS the parameter is read. A field declared `[T]` or `Pair<T>`
// would need structural unification, and stage-0 has it — but inferring from a shape stage-1 cannot
// invert would be guessing, and guessing here produces a wrong TYPE rather than a missing message.
// The narrower rule refuses more programs than stage-0 and mis-types none, which is the direction
// to be wrong in; the cases it declines are named here rather than discovered later.
function (mutable self: Unit) infer_class_arguments(src: String, node: Int, name: Token,
        plain: Type) -> Type {
    let g: Int = self.generic_named(src, name.start, name.length);
    if g < 0 {
        return plain;                                // not generic: nothing to infer
    }
    let declaration: Generic = self.generics[g];
    if declaration.type_param_count <= 0 {
        return plain;
    }
    let found: Int = self.find_type(src, name.start, name.length);
    if found < 0 || self.types[found].kind != 82 {
        return plain;
    }
    let item: Node = self.nodes[self.types[found].node];
    let literal: Node = self.nodes[node];
    let args_start: Int = len(self.nested_children);
    let mutable p: Int = 0;
    while p < declaration.type_param_count {
        let param: Token = self.tokens[self.type_parameters[declaration.type_param_start + p]];
        let mutable arg: Int = 0 - 1;
        let mutable f: Int = 0;
        while f < item.b && arg < 0 {
            let field: Node = self.nodes[self.children[item.a + f]];
            let stated: Type = self.declared_type(src, field.a);
            if stated.kind == 50 && spans_equal(src, stated.name_start, stated.name_length,
                    param.start, param.length) {
                let field_name: Token = self.tokens[field.token];
                let mutable q: Int = 0;
                while q < literal.b && arg < 0 {
                    let pair: Node = self.nodes[self.children[literal.a + q]];
                    let pair_name: Token = self.tokens[pair.token];
                    if spans_equal(src, pair_name.start, pair_name.length,
                            field_name.start, field_name.length) {
                        // The value's own type, with nothing expected — there is nothing to expect
                        // yet, since what `T` is is the question being answered. A parameter that
                        // resolves to another parameter settles nothing, so it is declined.
                        let actual: Type = self.type_of(src, pair.a, unknown_type());
                        if !is_unknown(actual) && actual.kind != 50 {
                            arg = self.type_as_node(src, actual);
                        }
                    }
                    q += 1;
                }
            }
            f += 1;
        }
        if arg < 0 {
            // Unwound, so a half-filled argument list cannot be read by anything: the arguments of
            // an application must be contiguous, and a partial answer is worse than none.
            let unwound: Int = truncate(self.nested_children, args_start);
            return plain;
        }
        let noted: Int = push(self.nested_children, arg);
        p += 1;
    }
    // The application becomes a real NODE, not just a Type, and that is not tidiness — it is what
    // makes the instantiation VISIBLE. `burxt layout` seeds its walk from every kind-46 node with
    // arguments, so an inferred `Holder<Int>` that existed only as a Type was sized by the checker
    // and then absent from the report: stage-0 listed `Holder$Int` and stage-1 listed nothing, which
    // is the same divergence one level along. Stage-0 creates the instantiation when it
    // monomorphises; this is the lazy equivalent, created once where it is discovered.
    //
    // The Type is then read back OFF the node rather than built beside it, so the two cannot
    // disagree about what was inferred.
    let application: Int = self.add(46, args_start, declaration.type_param_count, 0, 0,
            self.nodes[node].token);
    return self.declared_type(src, application);
}

// Is this name one somebody's `<T>` introduced?
//
// The parser gives a type parameter node kind 50 where it can tell, and where it cannot — a `T`
// written inside a generic class's field, reached before the enclosing declaration is in scope —
// it stays kind 46 and looks exactly like a class nobody declared. So the unknown-type refusal in
// `check_type_shape` has to ask this before it speaks, or `class Holder<T> { one: T }` becomes an
// error about a missing `class T`.
//
// A scan rather than a set, because `type_parameters` is a handful of tokens per program and a
// program with enough generics for this to matter does not exist yet. It answers about ANY
// declaration's parameters rather than the enclosing one's, which is deliberately looser than
// scope: this predicate exists to stop a false refusal, and being too permissive costs a missed
// refusal in a program stage-0 also has to catch, while being too strict invents an error in a
// program that is fine. Wrong in the safe direction, said out loud.
function (self: Unit) names_a_type_parameter(src: String, start: Int, length: Int) -> Bool {
    let mutable i: Int = 0;
    while i < len(self.type_parameters) {
        let named: Token = self.tokens[self.type_parameters[i]];
        if spans_equal(src, named.start, named.length, start, length) {
            return true;
        }
        i += 1;
    }
    return false;
}

function (self: Unit) generic_named(src: String, start: Int, length: Int) -> Int {
    let mutable i: Int = 0;
    while i < len(self.generics) {
        let g: Generic = self.generics[i];
        if spans_equal(src, g.start, g.length, start, length) {
            return i;
        }
        i += 1;
    }
    return 0 - 1;
}

function (self: Unit) same_type(src: String, a: Type, b: Type) -> Bool {
    // Resolved at every level rather than rewritten: a type parameter becomes what it stands
    // for exactly where the comparison reaches it. See resolve_shallow.
    let left: Type = self.resolve_shallow(src, a);
    let right: Type = self.resolve_shallow(src, b);
    if left.kind == 0 || right.kind == 0 {
        return false;
    }
    if left.kind != right.kind {
        return false;
    }
    if left.kind == 47 {
        return self.same_type(src, self.declared_type(src, left.scale),
                self.declared_type(src, right.scale));
    }
    if left.kind == 48 {
        // A fixed array's length is part of its type, and so is its element's type.
        if left.contract != right.contract {
            return false;
        }
        return self.same_type(src, self.declared_type(src, left.scale),
                self.declared_type(src, right.scale));
    }
    if left.kind == 45 {
        // The rounding contract is part of the type, so it is part of equality.
        return left.scale == right.scale && left.contract == right.contract;
    }
    if left.kind == 46 || left.kind == 49 || left.kind == 50 {
        if !spans_equal(src, left.name_start, left.name_length,
                right.name_start, right.name_length) {
            return false;
        }
        // The ARGUMENTS are part of the type, exactly as a tuple's elements are in the arm below
        // and a fixed array's length is in the arm above. Roadmap A9 needs it — `Mapper<Int>` and
        // `Mapper<String>` must not be interchangeable, or a value reaches the wrong vtable — but
        // **the hole was older and wider than A9, and it was a silent miscompile.**
        //
        // Measured on a pristine v0.0.276 stage-1: `let a: Holder<Int> = ...; let b: Holder<String>
        // = a; print(b.item);` compiled and SEGFAULTED, where stage-0 refuses it as a type
        // mismatch. Comparing the name alone made every instantiation of a generic the same type,
        // for classes and interfaces alike, so an Int was read back as a String pointer.
        //
        // Nothing caught it because the differential test's rejection count is a FLOOR: stage-1
        // refusing LESS than stage-0 keeps the ratchet green. The same sentence `same_type`'s
        // element-comparison note already records, one type constructor along.
        if left.contract != right.contract {
            return false;
        }
        let mutable g: Int = 0;
        while g < left.contract {
            if !self.same_type(src, self.declared_type(src, self.nested_children[left.scale + g]),
                    self.declared_type(src, self.nested_children[right.scale + g])) {
                return false;
            }
            g += 1;
        }
        return true;
    }
    // A tuple is STRUCTURAL: two tuples are the same type when their elements are, position
    // by position. There is no name to compare, which is the whole difference from kind 46.
    //
    // **This arm is load-bearing and its absence would have been silent.** The fall-through
    // below is `return true` — it exists for the scalar kinds, where the kind IS the type —
    // so without this `(Int, String)` and `(String, Int)` would be the same type, and so
    // would `(Int, Int)` and `(Int, Int, Int)`. The count is checked FIRST for that second
    // pair: `(Int, Int)` against `(Int, Int, Int)` agrees on every element it has.
    if left.kind == 53 {
        if left.contract != right.contract {
            return false;
        }
        let mutable e: Int = 0;
        while e < left.contract {
            if !self.same_type(src, self.declared_type(src, self.nested_children[left.scale + e]),
                    self.declared_type(src, self.nested_children[right.scale + e])) {
                return false;
            }
            e += 1;
        }
        return true;
    }
    return true;
}

function (self: Unit) declared_type(src: String, node: Int) -> Type {
    if node < 0 {
        return unknown_type();
    }
    let n: Node = self.nodes[node];
    if n.kind == 45 {
        return decimal_type(n.a, n.b);
    }
    if n.kind == 46 || n.kind == 49 || n.kind == 50 {
        // A named type, an interface object, or a type PARAMETER — all three carry the span of a
        // name written in the source, which is why a parameter needs no invented identifier.
        // A generic application also carries its arguments: `a` is their start in
        // `nested_children` and `b` is how many.
        let t: Token = self.tokens[n.token];
        // A BARE INTERFACE NAME means a dynamic one — `item: Priced` is `item: dynamic Priced`
        // (stage-0 v0.0.155, stage-1 v0.0.175). `dynamic` was Rust's `dyn`, and requiring it put a
        // word on every polymorphic parameter that a reviewer had to decode and an agent had to
        // remember. `dynamic Priced` stays legal and identical; the static path `<T: Priced>` is
        // untouched and still pays no vtable.
        //
        // These three lines were held back for two versions, and the reason is worth keeping: with
        // them alone stage-1 ACCEPTED `item: Priced` and emitted a binary that SEGFAULTED, because
        // its emitter coerced a concrete value into a `{data, vtable}` pair in only three places —
        // a field initializer, a `let` and an assignment. A call argument, a method argument, an
        // associated function's argument and a `return` all went out uncoerced.
        //
        // A refusal is safe and a miscompile is not, so the sugar waited for the four crossings.
        // See tests/pass/dyn_param_takes_a_concrete_value.bx, which is the case no fixture in
        // either compiler's suite had: every other one launders the value through a binding first,
        // where the coercion already happened.
        if n.kind == 46 {
            let named: Int = self.find_type(src, t.start, t.length);
            if named >= 0 {
                if self.types[named].kind == 84 {
                    return Type { kind: 49, scale: n.a, contract: n.b,
                            name_start: t.start, name_length: t.length };
                }
            }
        }
        return Type { kind: n.kind, scale: n.a, contract: n.b,
                name_start: t.start, name_length: t.length };
    }
    // A sized C integer carries its two numbers, exactly as a Decimal carries scale and contract.
    // **This arm is why A7 is not a silent no-op in stage-1.** The block below says it in general
    // and it is worth saying again at the type it was written for: a node kind this function does
    // not recognise becomes UNKNOWN, an unknown type silences every rule downstream, and the result
    // is a checker that agrees because it stopped asking.
    if n.kind == 52 {
        return width_type(n.a, n.b);
    }
    if n.kind == 47 || n.kind == 48 {
        // `scale` holds the ELEMENT type's node for a slice or an array, and
        // `contract` the declared length. Reusing two fields rather than widening a
        // record that is copied at every comparison in the checker.
        return Type { kind: n.kind, scale: n.a, contract: n.b,
                name_start: 0, name_length: 0 };
    }
    // A tuple, roadmap A8 — `scale` is the start of its ELEMENT type nodes in
    // `nested_children` and `contract` is how many, the same two slots a generic
    // application uses for its arguments. It needs its own arm for the reason the block
    // below spells out: 53 is outside the 40..48 run, so without this every tuple would be
    // UNKNOWN and every rule about one would go quiet — which is exactly what happened to
    // CPointer at kind 51.
    if n.kind == 53 {
        return Type { kind: 53, scale: n.a, contract: n.b,
                name_start: 0, name_length: 0 };
    }
    // 51 is CPointer, which sits outside the 40..48 run because the scalar kinds were numbered
    // before it existed. Getting this wrong was instructive rather than merely wrong: a type node
    // this function does not recognise becomes UNKNOWN, and an unknown type SILENCES every rule
    // downstream — so stage-1 accepted every CPointer program for one version, including the ones
    // it was supposed to refuse, and looked like it agreed with stage-0. It emitted correct code
    // too, because everything here is an i64 anyway. A checker that agrees because it stopped
    // asking is the failure mode the differential test exists to catch, and this is the shape of it.
    if (n.kind >= 40 && n.kind <= 48) || n.kind == 51 {
        return simple_type(n.kind);
    }
    return unknown_type();
}

function (mutable self: Unit) complain_at(src: String, token: Int, message: String) -> Int {
    // A probe round is silent. It refuses nothing, so anything it found is about a question
    // still being answered — and this function PRINTS, so without the guard the user would
    // read complaints that the real pass then does not make. The real pass reports
    // everything, in its own order, exactly as it did before the inference existed.
    if self.probing == 1 {
        return 0;
    }
    let t: Token = self.tokens[token];
    // Recorded before it is printed, and only the FIRST: this is the span `diag.bx` renders a caret
    // block and a JSON line from, and stage-0 answers with one diagnostic rather than a list.
    if self.problem_start < 0 {
        self.problem_start = t.start;
        self.problem_length = t.length;
        self.problem_message = message;
    }
    // `diagnose` means the CALLER will render it. Stage-0 prints the caret block instead of a plain
    // line, never both, so the plain line has to go rather than be joined.
    if self.diagnose == 0 {
        print("error: " + message + " (at `" + substring(src, t.start, t.length) + "`)");
    }
    self.problems += 1;
    return 0;
}

// ---- declarations ------------------------------------------------------------
// Refuse a call that reaches further than this signature admits.
//
// Written once, because the messages ARE the agent's instruction set and two wordings for one rule is
// how a language starts feeling arbitrary. Word for word stage-0's, which is not a courtesy — the
// .stderr fixtures pin one text and two compilers must produce it.
function (self: Unit) effect_refusal(callee: String, bit: Int) -> String {
    let named: String = effect_name(bit);
    if len(self.effects_owner) == 0 {
        return "`" + callee + "` touches " + named + ", and top-level code declares nothing it "
                + "touches. Call it from a function that says `touches " + named + "`, where a reader "
                + "can see it.";
    }
    return "`" + callee + "` touches " + named + ", but `" + self.effects_owner + "` does not say "
            + "it does. Add `touches " + named + "` to `" + self.effects_owner + "`'s signature — so "
            + "anyone reading it can see what this call can reach — or stop calling `" + callee + "`.";
}

// Every effect `reaches` claims that this signature does not admit, complained about in the closed
// set's order so two programs differing only in clause order report identically.
function (mutable self: Unit) check_effects(src: String, at: Int, callee: String,
        reaches: Int) -> Int {
    let mutable bit: Int = 1;
    while bit <= 32 {
        if remainder(divide_floor(reaches, bit), 2) == 1 {
            if remainder(divide_floor(self.allowed_effects, bit), 2) == 0 {
                let complained: Int = self.complain_at(src, at,
                        self.effect_refusal(callee, bit));
            }
        }
        bit = bit * 2;
    }
    return 0;
}

// The lowest set bit of a mask, so a message names one effect rather than a list. The first one is
// enough: fixing it brings the reader back for the next.
function lowest_effect(mask: Int) -> Int {
    let mutable bit: Int = 1;
    while bit <= 32 {
        if remainder(divide_floor(mask, bit), 2) == 1 {
            return bit;
        }
        bit = bit * 2;
    }
    return 1;
}

// What a BUILTIN reaches. Kept beside the effect rule rather than as a second rule for builtins that
// would have to be held in step with the first — the same list stage-0 carries.
//
// `print` is deliberately absent: it would be on almost every function, and an annotation that appears
// on everything tells a reviewer nothing, which is the lesson `allocates` taught.
function builtin_effects(name: String) -> Int {
    if name == "read_file" { return 1; }             // files
    if name == "write_file" { return 1; }
    if name == "write_bytes" { return 1; }
    if name == "argument" { return 8; }              // input: the command line
    if name == "argument_count" { return 8; }
    return 0;
}

// May the code being checked right now see `holder`'s private members?
//
// The CLASS is the scope, not the file — so the question is only ever "is the enclosing method's
// receiver this same class". A free function has no receiver and top-level code has no enclosing
// anything, so both answer false, which is the whole rule.
//
// No new state, and that is deliberate: `current_method` is already saved and restored around every
// body. Stage-0's first version of this kept its own `current_receiver`, set it and never restored
// it, and the top level inherited the LAST class's privileges — a private method called from
// outside compiled cleanly. A leaked capability is the dangerous direction of that bug, so the
// answer here is derived from state that cannot leak rather than tracked again.
function (self: Unit) inside_class(src: String, holder: Type) -> Bool {
    if self.current_method < 0 {
        return false;
    }
    if holder.kind != 46 {
        return false;
    }
    let m: Method = self.methods[self.current_method];
    return spans_equal(src, m.receiver_start, m.receiver_length,
            holder.name_start, holder.name_length);
}

// Is this field of this class declared `private`? The field node's spare slot carries it, set by
// the parser. 0 for a public field and for a name that is no field at all — "no such field" is a
// better message than a privacy one, and it is already reported elsewhere.
function (self: Unit) field_is_private(src: String, holder: Type, name_tok: Int) -> Bool {
    if holder.kind != 46 {
        return false;
    }
    let found: Int = self.find_type(src, holder.name_start, holder.name_length);
    if found < 0 {
        return false;
    }
    let decl: TypeDeclaration = self.types[found];
    if decl.kind != 82 {
        return false;
    }
    let item: Node = self.nodes[decl.node];
    let wanted: Token = self.tokens[name_tok];
    let mutable i: Int = 0;
    while i < item.b {
        let field: Node = self.nodes[self.children[item.a + i]];
        let field_name: Token = self.tokens[field.token];
        if spans_equal(src, field_name.start, field_name.length, wanted.start, wanted.length) {
            return field.value == 1;
        }
        i += 1;
    }
    return false;
}

// `Account.open(...)` — is this method call actually a call to an ASSOCIATED function? The index
// of the method if so, -1 otherwise.
//
// Three questions, in the order that makes each cheap. The base has to be a bare name (kind 5), so
// `sale.total.round()` never reaches the rest. That name must not be a BINDING — a local called
// `Account` shadows the class, exactly as it does everywhere else in the language, and getting this
// order wrong would let a variable's method call be resolved against a class. And it must be a
// declared type, so a typo answers "unknown name" rather than "no such method".
//
// The receiver's span comes straight from the source, which is the point: `Account` is written at
// the call site and written again at the declaration, so two spans compare equal with no name
// having to be built. That is why stage-1 needed no synthesized-name machinery for constructors.
function (mutable self: Unit) associated_at(src: String, node: Int) -> Int {
    let n: Node = self.nodes[node];
    let base: Node = self.nodes[n.a];
    if base.kind != 5 {
        return -1;
    }
    let holder: Token = self.tokens[base.token];
    if self.find_binding(src, holder.start, holder.length) >= 0 {
        return -1;
    }
    if self.find_type(src, holder.start, holder.length) < 0 {
        return -1;
    }
    let wanted: Token = self.tokens[n.token];
    let found: Int = self.find_method_named(src, holder.start, holder.length,
            wanted.start, wanted.length);
    if found < 0 {
        return -1;
    }
    if flag_associated(self.methods[found].flags) == 0 {
        // A real method reached through the class name rather than a value. Not this rule's
        // business: fall through and let the ordinary path say what it says.
        return -1;
    }
    return found;
}

function (mutable self: Unit) find_binding(src: String, start: Int, length: Int) -> Int {
    self.find_binding_calls += 1;
    // Backwards: the innermost binding with this name is the one in scope.
    let mutable i: Int = len(self.bindings) - 1;
    while i >= 0 {
        if spans_equal(src, self.bindings[i].start, self.bindings[i].length, start, length) {
            return i;
        }
        i -= 1;
    }
    return -1;
}

// FNV-1a over a SPAN, without building a String from it.
//
// The point is what it does not do: `hash(substring(src, start, length))` would allocate once per
// lookup, in a region, in a compiler — which trades a quadratic for a leak. This reads the bytes
// where they are.
//
// Kept under 2^30 so the multiply cannot overflow: `*` panics on overflow in Burxt, deliberately,
// and a hash is the one place that would be an unwelcome surprise rather than a caught bug. 2^30
// times 16777619 is about 2^54, which fits an i64 with room to spare.
function span_hash(src: String, start: Int, length: Int) -> Int {
    let mutable h: Int = 2166136261;
    let mutable i: Int = 0;
    while i < length {
        h = remainder((h + byte_at(src, start + i)) * 16777619, 1073741824);
        i += 1;
    }
    return remainder(h, 1024);
}

// Note the function just declared, so `find_function` can reach it without a scan.
function (mutable self: Unit) index_fun(src: String, start: Int, length: Int) -> Int {
    if len(self.function_buckets) == 0 {
        let mutable b: Int = 0;
        while b < 1024 {
            let blank: Int = push(self.function_buckets, 0 - 1);
            b += 1;
        }
    }
    let at: Int = span_hash(src, start, length);
    let linked: Int = push(self.function_chain, self.function_buckets[at]);
    self.function_buckets[at] = len(self.function_chain) - 1;
    return 1;
}

// The declared function of this name, through the index.
//
// Was a scan of every function declared so far, which made DECLARING n functions cost O(n^2) — the
// duplicate-name check is a lookup, so the table is walked once per declaration while it grows.
// 3200 declarations took 5.5 seconds and nothing else in the compiler was superlinear.
//
// The chain is walked NEWEST first, which matters: `find_function` answered the first match in
// declaration order before, and a chain built by prepending answers the last. Both are the same
// answer, because a duplicate name is refused — and that refusal is the reason this is a lookup at
// all.
function (mutable self: Unit) find_function(src: String, start: Int, length: Int) -> Int {
    self.find_function_calls += 1;
    if len(self.function_buckets) == 0 {
        return -1;                                   // nothing declared yet
    }
    let mutable i: Int = self.function_buckets[span_hash(src, start, length)];
    while i >= 0 {
        if spans_equal(src, self.functions[i].start, self.functions[i].length, start, length) {
            return i;
        }
        i = self.function_chain[i];
    }
    return -1;
}

// Which dependency owns the byte at `at`, or "" for the root package. C2.
function (self: Unit) package_at(at: Int) -> String {
    let mutable i: Int = 0;
    while i < len(self.package_names) {
        if at >= self.package_starts[i] && at <= self.package_ends[i] {
            return self.package_names[i];
        }
        i += 1;
    }
    return "";
}

// If `name` is a dependency's private declaration and we are not inside that dependency, the
// sentence to refuse with — otherwise "". C2, and the wording is stage-0's, word for word.
//
// **Asked before the lookup, never instead of it.** A package's private helper is real and
// perfectly usable inside that package, so it cannot be removed from the tables. Stage-0's first
// attempt did exactly that and broke the dependency's own code, which is the useful way to learn
// that privacy is a RELATION between the use and the declaration rather than a property of one.
function (self: Unit) package_private_refusal(src: String, name: String, at: Int) -> String {
    let mutable i: Int = 0;
    while i < len(self.private_names) {
        if self.private_names[i] == name {
            let owner: String = self.private_owners[i];
            if self.package_at(at) == owner {
                return "";
            }
            return "`" + name + "` is declared in the package `" + owner
                    + "` but not `public`, so this package cannot reach it. A package exposes what "
                    + "it means to support — if `" + name + "` is meant to be part of that, the fix "
                    + "belongs in `" + owner + "`, by writing `public` in front of its declaration.";
        }
        i += 1;
    }
    return "";
}

// C2. A dependency's private CLASS or ENUM, refused where it is named. Mirrors stage-0's check at
// the top of `validate_type`: every type a program writes down — parameter, `let`, field, return —
// comes through `declared_type`, so one place answers for all of them.
function (mutable self: Unit) refuse_private_type(src: String, node: Int) -> Int {
    if node < 0 || node >= len(self.nodes) {
        return 0;
    }
    let held: Node = self.nodes[node];
    if held.kind != 46 {
        return 0;
    }
    let named: Token = self.tokens[held.token];
    let refusal: String = self.package_private_refusal(src,
            substring(src, named.start, named.length), named.start);
    if len(refusal) > 0 {
        let complained: Int = self.complain_at(src, held.token, refusal);
        return 1;
    }
    return 0;
}

function (self: Unit) find_type(src: String, start: Int, length: Int) -> Int {
    let mutable i: Int = 0;
    while i < len(self.types) {
        if spans_equal(src, self.types[i].start, self.types[i].length, start, length) {
            return i;
        }
        i += 1;
    }
    return -1;
}

// Every signature first, so functions may be declared in any order and call each
// other — the same two-pass shape stage-0 uses.
// The names a program may not take: the builtins, `old`, and the two the runtime
// owns. Stage-0 refuses these because a call site cannot tell a shadowed builtin from
// the builtin, and a reader cannot either.
function is_reserved_name(src: String, start: Int, length: Int) -> Bool {
    return span_equal(src, start, length, "print")
            || span_equal(src, start, length, "len")
            || span_equal(src, start, length, "byte_at")
            || span_equal(src, start, length, "push")
            || span_equal(src, start, length, "truncate")
            || span_equal(src, start, length, "substring")
            || span_equal(src, start, length, "to_string")
            || span_equal(src, start, length, "read_file")
            || span_equal(src, start, length, "c_is_null")
            || span_equal(src, start, length, "c_string_at")
            || span_equal(src, start, length, "c_bytes_at")
            || span_equal(src, start, length, "c_bytes_to")
            || span_equal(src, start, length, "byte_as_string")
            || span_equal(src, start, length, "bit_and")
            || span_equal(src, start, length, "bit_or")
            || span_equal(src, start, length, "bit_xor")
            || span_equal(src, start, length, "bit_not")
            || span_equal(src, start, length, "shift_left")
            || span_equal(src, start, length, "shift_right_zeros")
            || span_equal(src, start, length, "shift_right_sign")
            || span_equal(src, start, length, "write_file")
            || span_equal(src, start, length, "write_bytes")
            || span_equal(src, start, length, "argument")
            || span_equal(src, start, length, "argument_count")
            || span_equal(src, start, length, "divide_floor")
            || span_equal(src, start, length, "divide_toward_zero")
            || span_equal(src, start, length, "remainder")
            || span_equal(src, start, length, "hash")
            || span_equal(src, start, length, "old")
            || span_equal(src, start, length, "result")
            || span_equal(src, start, length, "main")
            || span_equal(src, start, length, "exit");
}

// The `self` token of the receiver clause that ends just before `from`. -1 if there is
// none, which the caller treats as a program that is not a method.
function (self: Unit) self_token(from: Int) -> Int {
    // Scans back to the clause's opening `(` rather than counting tokens. A fixed budget of
    // six was enough for `(self)`, `(self: T)` and `(mut self: T)` and one short for
    // `(self: Stack<T>)`, which is seven — so a generic receiver returned -1 and the caller
    // indexed the token array with it. A bound that depends on the shape of what it is
    // scanning is a bound that breaks when the shape grows.
    let mutable i: Int = from - 1;
    while i >= 0 {
        if self.tokens[i].kind == 119 {                // `self`
            return i;
        }
        if self.tokens[i].kind == 29 {                 // `(` — the clause started here
            return 0 - 1;
        }
        i -= 1;
    }
    return 0 - 1;
}

function (mutable self: Unit) collect_method(src: String, index: Int) -> Int {
    let item: Node = self.nodes[index];
    let name: Token = self.tokens[item.token];
    let signature: Node = self.nodes[item.c];
    let receiver: Token = self.tokens[signature.value];
    let mutating: Int = flag_mutating(item.value);
    // ---- A4: `pure` on a method ---------------------------------------------------------
    //
    // This used to refuse outright — *"a receiver is state, and a claim about a function of its
    // arguments cannot be made about one"* — and the premise was wrong: the receiver IS an
    // argument. `self.x` is a read of a value the caller handed over, which is exactly what
    // purity permits. What a pure method may NOT have is a way to change that value, or an
    // effect, or an impure callee, and those are the three rules below.
    if flag_pure(item.value) == 1 {
        if mutating == 1 {
            let complained: Int = self.complain_at(src, item.token,
                        "`pure function (mutable self: "
                        + substring(src, receiver.start, receiver.length) + ") "
                        + substring(src, name.start, name.length)
                        + "` cannot be both: `pure` means the answer depends on the arguments and "
                        + "nothing else, and `mutable self` says this call changes the receiver. Drop "
                        + "one of the two. (It matters more than it looks: a contract clause may call a "
                        + "`pure` method, so this would let a precondition rewrite the value it is "
                    + "checking.)");
        }
        if flag_effects(item.value) > 0 {
            let complained: Int = self.complain_at(src, item.token,
                        "`pure function " + substring(src, receiver.start, receiver.length) + "."
                        + substring(src, name.start, name.length)
                        + "` cannot also `touches`: `pure` means the answer depends on the arguments and "
                    + "nothing else, which is the same thing as touching nothing. Drop one of the two.");
        }
        // A generic receiver is refused BY NAME, not left to be discovered as a confusing
        // acceptance. `pure` over a type parameter is fine in itself — purity is about what the
        // answer depends on — but a method on a generic class is checked once per instantiation,
        // so one promise would have to stand for every copy at once, and nothing here checks that
        // the copies agree. A question about which copy owns the promise, not about purity.
        if self.generic_named(src, receiver.start, receiver.length) >= 0 {
            let complained: Int = self.complain_at(src, item.token,
                        "`pure function (self: " + substring(src, receiver.start, receiver.length)
                        + "<...>) " + substring(src, name.start, name.length)
                        + "` is not available yet: a method on a generic class is checked once per "
                        + "instantiation, so one `pure` promise would have to stand for every copy at "
                    + "once. `pure` on a method of a NON-generic class works today");
        }
    }
    if self.find_method_named(src, receiver.start, receiver.length,
            name.start, name.length) >= 0 {
        let complained: Int = self.complain_at(src, item.token, "this method is declared twice");
        return 0;
    }
    // `mutable` on a METHOD's parameter is not available yet, and the refusal is the honest form of
    // a limit rather than a rule: the emitter passes a method's arguments by value, so the marker
    // would be a promise the backend does not keep. I met this exact refusal from stage-0 while
    // writing `schema.bx` — it is why the skipped-clause count there is a second walk instead of a
    // `mutable skipped: [Int]` out-parameter — and stage-1 accepted the same signature silently,
    // which means the two compilers disagreed about whether that program exists.
    // `self: Point<T>` names type parameters, and `Point` may not have any. Read from the TOKEN
    // AFTER the receiver's name — `<` iff the receiver wrote type arguments — which is the same
    // question `parse_type_params` asked and therefore cannot drift from it. A side table would have
    // been the alternative and the parser records nothing here, so the token is both cheaper and the
    // only thing available.
    //
    // Checked HERE rather than in the parser because a generic class may be declared AFTER a method
    // that names it: at parse time `generic_named` would answer "not generic" for a class that is,
    // and refuse a correct program. By this pass every declaration has been collected.
    if self.tokens[signature.value + 1].kind == 35 {
        if self.generic_named(src, receiver.start, receiver.length) < 0 {
            let complained: Int = self.complain_at(src, item.token,
                        "`self: " + substring(src, receiver.start, receiver.length)
                        + "<...>` names type parameters, and `"
                    + substring(src, receiver.start, receiver.length) + "` is not generic.");
        }
    }
    let declared_params: Node = self.nodes[item.a];
    let mutable q: Int = 0;
    while q < declared_params.b {
        let param: Node = self.nodes[self.children[declared_params.a + q]];
        if param.b == 1 {
            let param_name: Token = self.tokens[param.token];
            let complained: Int = self.complain_at(src, param.token,
                        "in `" + substring(src, receiver.start, receiver.length) + "."
                        + substring(src, name.start, name.length) + "`, parameter `"
                        + substring(src, param_name.start, param_name.length)
                        + "` is declared `mutable`, which is not available on a METHOD yet — only on a free "
                        + "function. If the method should change its own receiver, write "
                    + "`function (mutable self) ...`.");
        }
        q += 1;
    }
    // B47. The same two refusals a free function gets, in the method spelling. They were written
    // once, for `function f() -> [Int; 3]`, and a method's declaration is checked HERE by different
    // code — so `function (self: Box) same(...) -> [Int; 3]` was accepted by stage-1 and refused by
    // stage-0, and the two compilers disagreed about whether the program exists.
    //
    // B37 fixed the free-function spelling and this one stayed open, which is the shape that keeps
    // recurring: a rule applied where somebody wrote it and silent where nobody did. It is the same
    // miss as B7's stack guard going into `gen_fn` and not `gen_method`, two days ago, in the other
    // compiler.
    let method_return: Type = self.declared_type(src, signature.c);
    if method_return.kind == 48 {
        let complained: Int = self.complain_at(src, item.token,
                    "method `" + substring(src, receiver.start, receiver.length) + "."
                    + substring(src, name.start, name.length)
                + "` cannot return an array yet — the same limit as free functions.");
    }
    // B53. The interface-object refusal free functions already get. It was deliberately NOT added
    // at v0.0.289, because stage-0 accepted the method spelling and copying the arm would have
    // closed one divergence by opening another. The ruling came at v0.0.297 and went the
    // conservative way — both refuse — so this arm is now the agreeing one.
    if method_return.kind == 49 {
        let complained: Int = self.complain_at(src, item.token,
                    "method `" + substring(src, receiver.start, receiver.length) + "."
                    + substring(src, name.start, name.length)
                    + "` cannot return an interface object — it borrows the value it "
                    + "refers to, which would not outlive the call. Return the concrete type, or a "
                + "class holding it.");
    }
    push(self.methods, Method {
            receiver_start: receiver.start, receiver_length: receiver.length,
            start: name.start, length: name.length,
            return_type: method_return, parameters: item.a,
            mutating: mutating, flags: item.value,
    });
    return 1;
}

// ---- const: a name for a compile-time value ---------------------------------
//
// The largest and smallest an Int can be, which is the pair this whole feature was filed to
// make nameable — and the pair that proves the folding was not decoration. `INT_MIN` CANNOT
// be written as a literal: `-9223372036854775808` lexes as a negation of
// 9223372036854775808, which is `integer literal too large`, so the only spelling is a
// subtraction the compiler folds. A literal-only `const` would have shipped without it.
//
// These two are also the dogfood: they are the compiler's own use of its own new feature, so
// `burxt_compiles_burxt_and_reaches_the_fixpoint` exercises stage-1's const path — parse,
// fold and EMIT — on every run. Nothing else could: the backend's fixture programs live
// inside tests/runner.rs, which this work was not allowed to touch.
const INT_MAX: Int = 9223372036854775807;
const INT_MIN: Int = -9223372036854775807 - 1;

// A const by name, or -1. Linear over a handful of entries, like every other table here.
function (self: Unit) find_const(src: String, start: Int, length: Int) -> Int {
    let mutable i: Int = 0;
    while i < len(self.consts) {
        if spans_equal(src, self.consts[i].start, self.consts[i].length, start, length) {
            return i;
        }
        i += 1;
    }
    return -1;
}

// Fold every `const` down to a value, in the order they are written — which is the order in
// which one may refer to another, and the only order a reader can see.
//
// Runs before any body is read, because a function 200 lines below may use a const and the
// answer has to exist by then. The same argument `infer_allocates` makes for `allocates`.
function (mutable self: Unit) fold_consts(src: String) -> Int {
    let mutable i: Int = 0;
    while i < len(self.items) {
        let item: Node = self.nodes[self.items[i]];
        if item.kind == 73 {
            let folded: Int = self.fold_const(src, self.items[i]);
        }
        i += 1;
    }
    return len(self.consts);
}

// One `const`: its name checked, its type checked, its value folded.
//
// A refusal registers the const ANYWAY, at its declared type with a zero value. Without that
// one bad `const` becomes an `unknown name` at every use site and the real error is the
// smallest thing on screen — the same reason stage-0's `recover_from` binds an annotated
// `let` whose initialiser failed.
function (mutable self: Unit) fold_const(src: String, index: Int) -> Int {
    let item: Node = self.nodes[index];
    let name: Token = self.tokens[item.token];
    let declared: Type = self.declared_type(src, item.a);
    if is_reserved_name(src, name.start, name.length) {
        let complained: Int = self.complain_at(src, item.token,
                "this is a built-in name and cannot be declared as a `const`");
    }
    if self.find_const(src, name.start, name.length) >= 0 {
        let complained: Int = self.complain_at(src, item.token,
                "this name is already declared as a `const` — Burxt does not shadow");
    }
    // A const's type is one of the four that HAVE a literal, and that is not an arbitrary
    // shortlist: a const IS a literal with a name, so a type with no literal form has
    // nothing a const could hold. One rule covers CInt, CDouble, CPointer, arrays, classes
    // and enums, which is better for a reader than six separate refusals.
    let holdable: Bool = declared.kind == 40 || declared.kind == 41
            || declared.kind == 42 || declared.kind == 45;
    if !holdable {
        let complained: Int = self.complain_at(src, item.token,
                    "a `const` may be an Int, a Decimal, a String or a Bool: it is a literal with a "
                + "name, and " + self.show_type(src, declared) + " has no literal to name");
        push(self.consts, ConstDecl { start: name.start, length: name.length,
                bound_type: declared, value: 0, value_node: item.b });
        return 1;
    }
    // SHAPE first, TYPE second. The order is not tidiness: `type_of` on a name that is not a
    // const says "unknown name", and on a call to a function that does not exist says "unknown
    // function" — both true, both about the wrong thing, and both reported IN ADDITION to the
    // sentence the author needs. Gating on the shape means one mistake gets one message, which
    // is what stage-0 does by returning early.
    let shaped: Bool = self.const_shape_ok(src, item.b, declared);
    if !shaped {
        push(self.consts, ConstDecl { start: name.start, length: name.length,
                bound_type: declared, value: 0, value_node: item.b });
        return 1;
    }
    // The value against the annotation, by the same rule `let` uses — and this call is also
    // what settles a Decimal literal's scale and caches it, which is how the emitter later
    // writes the const out with no scale question left to ask. It is also what refuses `/` on
    // two Ints, which is why `/` needs no case of its own below.
    let actual: Type = self.type_of(src, item.b, declared);
    let mutable value: Int = 0;
    if is_unknown(actual) {
        // Already complained about, by `type_of`.
        value = 0;
    } else {
        if !self.fits(src, actual, declared) {
            let complained: Int = self.complain_at(src, item.token,
                        "declared " + self.show_type(src, declared) + ", but the value is "
                    + self.show_type(src, actual));
        } else {
            if declared.kind == 40 {
                value = self.fold_const_int(src, item.b);
            }
        }
    }
    push(self.consts, ConstDecl { start: name.start, length: name.length,
            bound_type: declared, value: value, value_node: item.b });
    return 1;
}

// Is this expression something a `const` may hold at all? One walk, before any typing.
//
// Arithmetic is Int-only, and the reasons differ per type. A Decimal `*` narrows and so would
// need a rounding contract, which would put a rounding mode somewhere other than a signature
// for the first time; `+` would then be the only Decimal operator allowed, and "one of them
// works" is a worse rule to remember than "none do". A String `+` folds perfectly well, but
// `+` on Strings MEANS allocate, and a reader meeting `const G: String = A + B;` would rightly
// ask where it lives. Every item this feature was filed to unblock is an Int.
function (mutable self: Unit) const_shape_ok(src: String, node: Int, declared: Type) -> Bool {
    let n: Node = self.nodes[node];
    if n.kind >= 1 && n.kind <= 4 {
        return true;
    }
    if n.kind == 5 {
        let t: Token = self.tokens[n.token];
        if self.find_const(src, t.start, t.length) >= 0 {
            return true;
        }
        let complained: Int = self.complain_at(src, n.token,
                    "this cannot be used in a `const`: an initialiser holds literals and consts "
                + "declared ABOVE it, and nothing else");
        return false;
    }
    if n.kind == 6 {                                 // -x
        if declared.kind != 40 && declared.kind != 45 {
            let complained: Int = self.complain_at(src, n.token, const_int_only());
            return false;
        }
        return self.const_shape_ok(src, n.a, declared);
    }
    if n.kind == 8 {                                 // a + b, a - b, a * b, a / b
        if declared.kind != 40 {
            let complained: Int = self.complain_at(src, n.token, const_int_only());
            return false;
        }
        if !self.const_shape_ok(src, n.a, declared) {
            return false;
        }
        return self.const_shape_ok(src, n.b, declared);
    }
    let complained: Int = self.complain_at(src, n.token,
                "a `const` is folded at compile time, so its value may only hold literals, consts "
            + "declared above it, and `+ - *` over Ints");
    return false;
}

function const_int_only() -> String {
    return "arithmetic in a `const` is `+ - *` over Ints: a Decimal `*` would need a rounding "
            + "contract, and `+` on Strings means allocate";
}

// Evaluate an Int const expression. CHECKED at every step: an overflow is a compile error.
//
// Only reached after `const_shape_ok` said yes and the type matched, so every node here is one
// of the four it admits and nothing needs a fallback message.
//
// The overflow check has to happen HERE and nowhere else. By the time the program runs a folded
// constant is a literal, so there is no `add` instruction left for the runtime's overflow trap
// to fire on — a fold that wrapped would put a wrong number in the binary with nothing
// downstream able to notice. And the check cannot be "compute it and look at the sign", because
// Burxt's own `+` PANICS on overflow: this compiler would exit 70 instead of reporting the
// mistake it was asked to report.
function (mutable self: Unit) fold_const_int(src: String, node: Int) -> Int {
    let n: Node = self.nodes[node];
    if n.kind == 1 {
        return n.value;
    }
    if n.kind == 5 {
        let t: Token = self.tokens[n.token];
        let found: Int = self.find_const(src, t.start, t.length);
        if found < 0 {
            return 0;
        }
        return self.consts[found].value;
    }
    if n.kind == 6 {                                 // -x
        let inner: Int = self.fold_const_int(src, n.a);
        if inner == INT_MIN {
            let complained: Int = self.complain_at(src, n.token, const_overflow("negating"));
            return 0;
        }
        return 0 - inner;
    }
    if n.kind == 8 {                                 // a + b, a - b, a * b
        let left: Int = self.fold_const_int(src, n.a);
        let right: Int = self.fold_const_int(src, n.b);
        if n.value == 25 {
            if !add_is_safe(left, right) {
                let complained: Int = self.complain_at(src, n.token, const_overflow("adding"));
                return 0;
            }
            return left + right;
        }
        if n.value == 26 {
            if !sub_is_safe(left, right) {
                let complained: Int = self.complain_at(src, n.token,
                        const_overflow("subtracting"));
                return 0;
            }
            return left - right;
        }
        if n.value == 27 {
            if !mul_is_safe(left, right) {
                let complained: Int = self.complain_at(src, n.token,
                        const_overflow("multiplying"));
                return 0;
            }
            return left * right;
        }
        // `/` reaches here only if Int division stops being refused. Silent rather than a
        // wrong number: `type_of` already produced the "which rounding did you mean" message,
        // and this file must not invent a second answer to a question the language refuses.
        return 0;
    }
    return 0;
}

// Written once, and worded so a reader knows WHICH operation blew up: "arithmetic overflow"
// in a folded constant is otherwise a hunt through the expression.
function const_overflow(doing: String) -> String {
    return "this `const` overflows an Int while " + doing
            + " — a constant is folded at compile time, and folding cannot wrap: by the time the "
            + "program runs there is no arithmetic left to trap on";
}

// The three overflow predicates, asked BEFORE the operation rather than after.
//
// `a + b` in Burxt panics on overflow, so "compute it and check the sign" — the trick C
// programmers reach for — would take the compiler down instead of reporting the mistake. Each
// of these divides or subtracts in the direction that cannot itself overflow, which is the
// whole of the technique.
function add_is_safe(a: Int, b: Int) -> Bool {
    if b > 0 {
        return a <= INT_MAX - b;
    }
    if b < 0 {
        return a >= INT_MIN - b;
    }
    return true;
}

function sub_is_safe(a: Int, b: Int) -> Bool {
    if b < 0 {
        return a <= INT_MAX + b;
    }
    if b > 0 {
        return a >= INT_MIN + b;
    }
    return true;
}

// Four quadrants, because the bound a product may not cross depends on both signs. Each
// division is by the operand that cannot make it trap: never INT_MIN / -1.
function mul_is_safe(a: Int, b: Int) -> Bool {
    if a == 0 || b == 0 {
        return true;
    }
    if a > 0 && b > 0 {
        return a <= divide_toward_zero(INT_MAX, b);
    }
    if a < 0 && b < 0 {
        return a >= divide_toward_zero(INT_MAX, b);
    }
    if a < 0 {
        return a >= divide_toward_zero(INT_MIN, b);
    }
    return b >= divide_toward_zero(INT_MIN, a);
}

// Can the class at `decl` reach `target` by VALUE, following only whole-class fields? B40.
//
// Stage-1's containment check caught only DIRECT self-containment — `class A { a: A }` — so
// `class A { b: B }  class B { a: A }` was accepted and 24,780 bytes of IR were emitted for a type
// whose size has no finite answer. Stage-0 refuses it. Measured.
//
// **A depth bound rather than stage-0's trail**, and the reason is a language limit worth naming: a
// method may not take a `mutable` parameter, so a growing trail cannot be threaded through a
// recursive method the way `check_struct_finite` threads a `Vec`. The bound is not a heuristic —
// a simple path from a class back to itself visits at most as many classes as there are, so
// searching deeper than that can find nothing new. Complete, and it needs no scratch storage.
//
// Only whole-class fields are followed, which is stage-0's rule too: recursion THROUGH a slice is a
// pointer and terminates, and is how a tree or a JSON value is written. Infinite width comes from
// containing a value, not from referring to one.
function (self: Unit) reaches_class(src: String, decl: Int, target: Int, depth: Int) -> Bool {
    if depth > len(self.types) {
        return false;
    }
    if decl < 0 || decl >= len(self.types) {
        return false;
    }
    if self.types[decl].kind != 82 {
        return false;
    }
    let holder: Node = self.nodes[self.types[decl].node];
    let mutable f: Int = 0;
    while f < holder.b {
        let field: Node = self.nodes[self.children[holder.a + f]];
        let held: Node = self.nodes[field.a];
        if held.kind == 46 {
            let held_name: Token = self.tokens[held.token];
            let inner: Int = self.find_type(src, held_name.start, held_name.length);
            if inner == target {
                return true;
            }
            if inner >= 0 && self.reaches_class(src, inner, target, depth + 1) {
                return true;
            }
        }
        f += 1;
    }
    return false;
}

function (mutable self: Unit) collect_declarations(src: String) -> Int {
    let mutable i: Int = 0;
    while i < len(self.items) {
        let index: Int = self.items[i];
        let item: Node = self.nodes[index];
        let name: Token = self.tokens[item.token];
        if item.kind == 83 {
            if item.b == 0 {
                let complained: Int = self.complain_at(src, item.token,
                            "an enum with no variants describes nothing, and no value of it "
                        + "could ever be made");
            }
            let mutable v: Int = 0;
            while v < item.b {
                let variant: Node = self.nodes[self.children[item.a + v]];
                let named: Token = self.tokens[variant.token];
                let mutable later: Int = v + 1;
                while later < item.b {
                    let other: Node = self.nodes[self.children[item.a + later]];
                    let other_name: Token = self.tokens[other.token];
                    if spans_equal(src, named.start, named.length,
                            other_name.start, other_name.length) {
                        let complained: Int = self.complain_at(src, other.token,
                                "this variant is declared twice");
                    }
                    later += 1;
                }
                v += 1;
            }
        }
        if item.kind == 82 {                         // record: fields
            let mutable f: Int = 0;
            while f < item.b {
                let field: Node = self.nodes[self.children[item.a + f]];
                let shaped: Int = self.check_type_shape(src, field.a, field.token);
                let held: Node = self.nodes[field.a];
                if held.kind == 46 {
                    let held_name: Token = self.tokens[held.token];
                    if spans_equal(src, held_name.start, held_name.length,
                            name.start, name.length) {
                        // By value, always: a class that contains itself has no size.
                        let complained: Int = self.complain_at(src, field.token,
                                    "a class cannot contain itself: its size would have to be "
                                + "bigger than itself");
                    }
                }
                f += 1;
            }
        }
        if item.kind == 83 {                         // enum: payloads
            let mutable v: Int = 0;
            while v < item.b {
                let variant: Node = self.nodes[self.children[item.a + v]];
                let mutable p: Int = 0;
                while p < variant.c {
                    let payload: Int = self.nested_children[variant.b + p];
                    let shaped: Int = self.check_type_shape(src, payload, variant.token);
                    // The FINITE WIDTH check that used to stand here has moved to the SECOND
                    // pass below, and definition order is why it had to. `find_type` answers -1
                    // for a declaration this pass has not reached yet, so
                    //
                    //     enum E { V(F) }   class F { e: E }      accepted, and IR was emitted
                    //     class F { e: E }  enum E { V(F) }       refused
                    //
                    // were the same program with two lines swapped. Its neighbour's comment
                    // already named this trap; the check standing next to it was inside it.
                    p += 1;
                }
                v += 1;
            }
        }
        if item.kind == 82 || item.kind == 83 {
            if self.find_type(src, name.start, name.length) >= 0 {
                let complained: Int = self.complain_at(src, item.token, "this type is declared twice");
            } else {
                push(self.types, TypeDeclaration { start: name.start, length: name.length,
                        kind: item.kind, node: index });
            }
        }
        if item.kind == 81 {                         // a method
            let m: Int = self.collect_method(src, index);
        }
        if item.kind == 84 {                         // trait
            push(self.types, TypeDeclaration { start: name.start, length: name.length,
                    kind: item.kind, node: index });
        }
        if item.kind == 85 {                         // implement Trait for Type { ... }
            let target: Token = self.tokens[item.c];
            // The `<Int>` of `implement Mapper<Int> for D`, if the header wrote one. Roadmap A9.
            let written: Int = self.trait_arguments_of(index);
            push(self.impls, Implementation { trait_start: name.start, trait_len: name.length,
                            type_start: target.start, type_len: target.length,
                            trait_args: self.trait_argument_start(index),
                    trait_arg_count: written });
            // The methods inside an implementation are declared exactly as free-standing ones
            // are, so they are collected by the same code rather than by a copy of it.
            let mutable k: Int = 0;
            while k < item.b {
                let m: Int = self.collect_method(src, self.children[item.a + k]);
                k += 1;
            }
        }
        if item.kind == 80 || item.kind == 86 {
            if is_reserved_name(src, name.start, name.length) {
                let complained: Int = self.complain_at(src, item.token,
                            "`" + substring(src, name.start, name.length) + "` is a name the "
                        + "language owns, so a program may not declare it");
            }
            let already: Int = self.find_function(src, name.start, name.length);
            let mutable clash: Bool = already >= 0;
            if already >= 0 && item.kind == 86 {
                // An `external function` declares an external FACT, not a definition, so two
                // modules may both declare it — `lib/files.bx` and `lib/os.bx` both need
                // `system`, and neither can know the other did. Stage-0 allows this when
                // the signatures match, and the two must agree.
                if flag_external(self.functions[already].flags) == 1 {
                    clash = false;
                }
            }
            if clash {
                let complained: Int = self.complain_at(src, item.token, "this function is declared twice");
            } else {
                let mutable return_type: Type = unknown_type();
                if item.kind == 80 {
                    let signature: Node = self.nodes[item.c];
                    return_type = self.declared_type(src, signature.c);
                } else {
                    return_type = self.declared_type(src, item.b);   // an external holds it directly
                    // **NOT asked for an external, deliberately.** `check_marshalling` and
                    // `check_extern_return` already refuse every type that cannot cross the C
                    // boundary, which necessarily includes one that does not exist — and their
                    // message is the better one: *C has no Nope, and the raw value would silently
                    // lose its meaning* tells an author writing an `external function` what is
                    // actually wrong, where "declare it with `class Nope`" suggests a fix that
                    // would not help. Stage-0 orders it the same way, and asking here first would
                    // have made stage-1 give the worse of the two answers.
                    // CInt and CDouble are C's widths, not Burxt types: a Burxt caller
                    // passes and receives an Int. So an external's signature is recorded
                    // as Burxt sees it, which is why `strcmp(a, b) < 0` compares two
                    // Ints rather than mixing a CInt with one.
                    return_type = as_burxt_sees(return_type);
                }
                // `pure` and `touches` are the same claim from opposite ends: pure means the answer
                // depends on the arguments and nothing else, which IS touching nothing. Saying both is
                // a contradiction rather than a refinement, and refusing it at the DECLARATION is what
                // makes the message name the contradiction instead of some later call.
                if flag_pure(item.value) == 1 && flag_effects(item.value) > 0 {
                    let complained: Int = self.complain_at(src, item.token,
                                "`pure function " + substring(src, name.start, name.length)
                                + "` cannot also `touches "
                                + effect_name(lowest_effect(flag_effects(item.value)))
                                + "`: `pure` means the answer depends on the arguments and nothing else, "
                            + "which is the same thing as touching nothing. Drop one of the two.");
                }
                // The C boundary, at the declaration. `external` picks which marshalling half
                // applies; a plain function only ever gets the "there is nothing to marshal into"
                // half. See `check_extern_return` and `check_marshalling`.
                if item.kind == 86 {
                    // The DECLARED return type, read again from the node rather than taken from
                    // `return_type` above — `as_burxt_sees` has already folded CInt and CDouble into
                    // the Int a Burxt caller receives, which is right for every other rule and wrong
                    // for this one: it is precisely `-> CDouble` that has to be refused, and by then
                    // it no longer says CDouble. The first version of this check read the converted
                    // type and silently passed the one fixture it existed for.
                    let returned: Int = self.check_extern_return(src, item.token,
                                substring(src, name.start, name.length),
                            self.declared_type(src, item.b));
                    let marshalled: Int = self.check_marshalling(src, item.a, 1,
                            "external function `" + substring(src, name.start, name.length) + "`");
                } else {
                    let marshalled: Int = self.check_marshalling(src, item.a, 0,
                            "`function " + substring(src, name.start, name.length) + "`");
                }
                // Returning a FIXED array is not available yet: handing one back needs
                // whole-array binding, which arrives with collections. The limit is stage-0's and it
                // is named rather than half-supported — stage-1 accepted the signature and the
                // backend then had no way to pass the block, so the two disagreed about whether the
                // program exists.
                // An interface OBJECT is a fat pointer that BORROWS the value behind it, so
                // returning one hands back a reference to storage the call is about to drop. The
                // same reasoning that refuses returning a region value, one level of indirection out.
                if return_type.kind == 49 {
                    let complained: Int = self.complain_at(src, item.token,
                                "function `" + substring(src, name.start, name.length)
                                + "` cannot return an interface object — it borrows the value it refers to, "
                                + "which would not outlive the call. Return the concrete type, or a class "
                            + "holding it.");
                }
                if return_type.kind == 48 {
                    let complained: Int = self.complain_at(src, item.token,
                                "function `" + substring(src, name.start, name.length)
                                + "` cannot return an array yet — returning one needs whole-array binding, "
                                + "which arrives with collections. Return a class holding it, or fill an "
                            + "array the caller owns.");
                }
                let mutable flags: Int = item.value;
                if item.kind == 86 {
                    // The external marker, plus the effect mask the extern declared. An extern's
                    // `touches` is where an effect ENTERS the program — there is no body to reason
                    // about, so the declaration is the only source.
                    flags = 8 + item.c * 64;
                }
                push(self.functions, DeclaredFunction { start: name.start, length: name.length,
                        return_type: return_type, parameters: item.a, flags: flags });
                let indexed: Int = self.index_fun(src, name.start, name.length);
            }
        }
        i += 1;
    }
    // C2. Which declarations a DEPENDENCY kept to itself. Recorded in the same second pass as
    // B40's cycle check, because both need the declaration table complete and neither needs
    // anything else.
    let mutable pc: Int = 0;
    while pc < len(self.types) {
        let holder: Node = self.nodes[self.types[pc].node];
        let named: Token = self.tokens[holder.token];
        let owner: String = self.package_at(named.start);
        if len(owner) > 0 && flag_public(holder.value) == 0 {
            let noted: Int = push(self.private_names, substring(src, named.start, named.length));
            let owned: Int = push(self.private_owners, owner);
        }
        pc += 1;
    }
    let mutable pf: Int = 0;
    while pf < len(self.functions) {
        let declared: DeclaredFunction = self.functions[pf];
        let owner: String = self.package_at(declared.start);
        if len(owner) > 0 && flag_public(declared.flags) == 0 {
            let noted: Int = push(self.private_names,
                    substring(src, declared.start, declared.length));
            let owned: Int = push(self.private_owners, owner);
        }
        pf += 1;
    }
    // B40, and it has to be a SECOND pass: `self.types` is filled by the loop above, so asking
    // `find_type` during it answers -1 for every class and the check silently does nothing. The
    // direct self-containment check higher up works only because it compares source TEXT rather
    // than looking a declaration up — which is why it never noticed the difference.
    //
    // `class A { b: B }` with `class B { a: A }` has no finite size, stage-0 refuses it, and
    // stage-1 emitted 24,780 bytes of IR for it. One step further out than the check that existed.
    let mut_types: Int = len(self.types);
    let mutable c: Int = 0;
    while c < mut_types {
        if self.types[c].kind == 82 && self.reaches_class(src, c, c, 0) {
            let holder: Node = self.nodes[self.types[c].node];
            let named: Token = self.tokens[holder.token];
            let complained: Int = self.complain_at(src, holder.token,
                        "a `" + substring(src, named.start, named.length)
                        + "` cannot contain a `" + substring(src, named.start, named.length)
                    + "` — it would have no finite size");
        }
        // The same question for an ENUM's payloads, moved here from the declaration pass so a
        // forward-declared carrier is seen. The rule is FINITE WIDTH, not "no enum payload": a
        // width is unbounded only when a type contains ITSELF by value, and recursion through a
        // slice is a pointer that terminates — which is most recursive data, a tree, a JSON
        // document, an AST. `embeds_by_value` follows classes and arrays too, since either can
        // carry the enum on.
        if self.types[c].kind == 83 {
            let holder: Node = self.nodes[self.types[c].node];
            let named: Token = self.tokens[holder.token];
            let mutable v: Int = 0;
            while v < holder.b {
                let variant: Node = self.nodes[self.children[holder.a + v]];
                let mutable p: Int = 0;
                while p < variant.c {
                    let payload: Int = self.nested_children[variant.b + p];
                    if self.nodes[payload].kind == 46 {
                        let carried: Type = self.declared_type(src, payload);
                        if self.embeds_by_value(src, carried, named.start, named.length) {
                            let complained: Int = self.complain_at(src, variant.token,
                                        "this variant carries `"
                                        + substring(src, named.start, named.length)
                                        + "` by value, so its size would have to be bigger than itself. "
                                        + "Carry it behind a slice — `["
                                        + substring(src, named.start, named.length)
                                        + "]` — which is a pointer, so the size is finite and the recursion "
                                    + "still works");
                        }
                    }
                    p += 1;
                }
                v += 1;
            }
        }
        c += 1;
    }
    return len(self.functions);
}

// ---- expressions -------------------------------------------------------------
// `expected` carries the declared type inward, which is how a Decimal product can
// know whether a rounding contract was supplied — exactly as in stage-0.
// Every expression's type, recorded as it is decided. The escape check asks about
// expressions the checker has already seen — whether a `+` joined two Strings, say —
// and re-walking them would report every complaint a second time.
function (mutable self: Unit) type_of(src: String, node: Int, expected: Type) -> Type {
    self.type_of_calls += 1;
    let t: Type = self.type_of_inner(src, node, expected);
    // The cache is a slot per NODE. It grows to reach the node being recorded, which costs
    // one push per node over a whole compile, and the last answer for a node stands — a
    // retyped operand (multiplication does that) settles on its second reading.
    while len(self.typed) <= node {
        let filled: Int = push(self.typed, unknown_type());
    }
    self.typed[node] = t;
    return t;
}

function (self: Unit) type_at(node: Int) -> Type {
    // Indexed BY NODE, so a lookup is one load.
    //
    // This was a backwards linear scan until v0.0.87, over a list that grew with every
    // typed expression — O(n²) over a compile, noted at the time as "fine at bootstrap
    // scale". It stopped being fine at 46,000 tokens: the compiler took three and a half
    // minutes on its own source and then exhausted its region, and the language could not
    // grow further until this changed. The lesson is the placeholder, not the algorithm —
    // "fine for now" needs a number attached, or nobody notices when now ends.
    if node < 0 || node >= len(self.typed) {
        return unknown_type();
    }
    return self.typed[node];
}

function (mutable self: Unit) type_of_inner(src: String, node: Int, expected: Type) -> Type {
    if node < 0 {
        return unknown_type();
    }
    let n: Node = self.nodes[node];

    if n.kind == 1 { return simple_type(40); }
    if n.kind == 2 {                                 // a decimal, money or percent
        if expected.kind != 45 {
            return decimal_type(n.a, 0);
        }
        if expected.scale >= n.a {
            // Widening a literal is exact: $5 in a Decimal<2> context is 5.00. The
            // contract comes from the context too, and never rounds the literal —
            // a literal that needed rounding would be refused below.
            return decimal_type(expected.scale, expected.contract);
        }
        // Narrowing: allowed only when every digit dropped is a zero.
        let mutable factor: Int = 1;
        let mutable drop: Int = n.a - expected.scale;
        while drop > 0 {
            factor = factor * 10;
            drop -= 1;
        }
        if remainder(n.value, factor) == 0 {
            return decimal_type(expected.scale, expected.contract);
        }
        if self.in_multiply == 1 {
            return decimal_type(n.a, 0);
        }
        let complained: Int = self.complain_at(src, n.token,
                    "this literal needs " + to_string(n.a) + " decimal places but the context "
                    + "has only " + to_string(expected.scale) + ", and dropping digits from "
                + "money is refused");
        return unknown_type();
    }
    if n.kind == 3 {                                 // a String literal, or a piece of one
        return simple_type(42);
    }

    if n.kind == 18 {                                // an interpolated String
        // Interpolation IS `to_string` plus `+`, so as a VALUE it allocates and needs a
        // region. As the argument of a `print` it does not — the pieces go out in order
        // and nothing is joined — which is why the print statement checks it separately.
        if !self.has_region() {
            let r: Int = self.needs_region(src, n.token, "this interpolated String");
        }
        let checked: Int = self.check_pieces(src, n);
        return simple_type(42);
    }
    if n.kind == 4 { return simple_type(41); }

    if n.kind == 5 {                                 // a name
        let t: Token = self.tokens[n.token];
        let found: Int = self.find_binding(src, t.start, t.length);
        if found < 0 {
            // A const is looked for only after the bindings, so the common path pays one
            // extra scan of an almost-always-empty array and no more. There is nothing to
            // disambiguate: a `let`, a `for` binding, a parameter and a pattern binding are
            // all refused if they reuse a const's name, so at most one table can hold it.
            let named: Int = self.find_const(src, t.start, t.length);
            if named >= 0 {
                return self.consts[named].bound_type;
            }
            let complained: Int = self.complain_at(src, n.token, "unknown name");
            return unknown_type();
        }
        return self.bindings[found].bound_type;
    }

    if n.kind == 6 {                                 // -x
        let inner: Type = self.type_of(src, n.a, expected);
        // Negation needs a NUMBER. `-"nope"` and `-true` are not arithmetic on an odd type, they are
        // not arithmetic at all — and stage-1 typed `-x` as simply the type of `x`, so both took the
        // type of their operand and travelled on. Int, Decimal, CInt and CDouble are the four things
        // a minus sign means something for.
        if !is_unknown(inner) && inner.kind != 40 && inner.kind != 45 && inner.kind != 43
                && inner.kind != 44 {
            let complained: Int = self.complain_at(src, n.token,
                    "`-` needs a number, but this has type " + self.show_type(src, inner));
        }
        return inner;
    }
    if n.kind == 7 {                                 // !x
        let inner: Type = self.type_of(src, n.a, simple_type(41));
        if !is_unknown(inner) && inner.kind != 41 {
            let complained: Int = self.complain_at(src, n.token,
                    "`!` needs a Bool, but this is " + self.show_type(src, inner));
        }
        return simple_type(41);
    }

    if n.kind == 8 {                                 // a + b, a * b
        let outer: Int = self.in_multiply;
        if n.value == 27 { self.in_multiply = 1; }
        let left: Type = self.type_of(src, n.a, expected);
        let right: Type = self.type_of(src, n.b, expected);
        self.in_multiply = outer;
        if is_unknown(left) || is_unknown(right) {
            return unknown_type();
        }
        // No pointer arithmetic. This is the operation that turns a pointer from a token into a way
        // to read arbitrary memory, so refusing it is most of what makes a CPointer safe to hold.
        if left.kind == 51 || right.kind == 51 {
            let complained: Int = self.complain_at(src, n.token,
                        "a CPointer has no arithmetic: it is a token to hand back to C, not an address to "
                    + "walk. `c_string_at(p)` copies what it points at, and that is the only way in");
            return unknown_type();
        }
        // `*` combines a quantity with a rate, so the scales may differ — but the
        // product's scale is their SUM, and landing it needs a declared contract.
        if n.value == 27 {
            if left.kind == 45 && right.kind == 45 {
                // The product's TRUE scale is the sum of the operands'. At that scale
                // nothing rounds, so nothing needs declaring — and a contract demanded
                // where no rounding happens teaches the reader that contracts are
                // ceremony. They are not: one appears exactly where a value narrows.
                //
                // A scaled i64 holds 18 fractional digits, so a wider sum must narrow
                // whatever the author wanted. (Relaxed in v0.0.91, with stage-0.)
                let exact: Int = left.scale + right.scale;
                let representable: Bool = exact <= 18;
                if expected.kind == 45 && expected.contract != 0 {
                    return expected;                 // a contract says how it narrows
                }
                if expected.kind == 45 {
                    if representable && expected.scale == exact {
                        return decimal_type(exact, 0);  // the product's own width: exact
                    }
                    let complained: Int = self.complain_at(src, n.token,
                                "`*` on " + self.show_type(src, left) + " and " + self.show_type(src, right)
                                + " has an exact product with " + to_string(exact)
                                + " decimal places, and reaching " + self.show_type(src, expected)
                                + " means rounding it: say how with a rounding contract, or take "
                            + "the exact answer");
                    return unknown_type();
                }
                // Nothing asked for it. Identical operands that carry a contract land the
                // product at their OWN scale — the context does not have to repeat what the
                // operands already say, so `print(a * b)` on money answers in money.
                if self.same_type(src, left, right) && left.contract != 0 {
                    return left;
                }
                if representable {
                    return decimal_type(exact, 0);
                }
                let complained: Int = self.complain_at(src, n.token,
                            "`*` on " + self.show_type(src, left) + " and " + self.show_type(src, right)
                            + " has an exact product with " + to_string(exact)
                            + " decimal places, which does not fit a scaled i64: bind it to a "
                        + "Decimal with a rounding contract");
                return unknown_type();
            }
            if left.kind == 45 && right.kind == 40 { return left; }
            if left.kind == 40 && right.kind == 45 { return right; }
        }
        if n.value == 28 {                           // `/`
            if left.kind == 40 && right.kind == 40 {
                let complained: Int = self.complain_at(src, n.token,
                            "`/` on two Ints would have to round, and one operator cannot say "
                        + "which way — use divide_floor, divide_toward_zero or remainder");
                return unknown_type();
            }
            // A quotient can fall between two representable values — 1.00 / 3 — so
            // unlike `*`, division needs a contract even when the scales match, and
            // the contract has to be on the value being divided.
            if left.kind == 45 && (right.kind == 45 || right.kind == 40) {
                if right.kind == 45 && !self.same_type(src, left, right) {
                    let complained: Int = self.complain_at(src, n.token,
                                "cannot divide " + self.show_type(src, left) + " by " + self.show_type(src, right)
                            + ": division needs the same type, scale included");
                    return unknown_type();
                }
                if left.contract == 0 {
                    let complained: Int = self.complain_at(src, n.token,
                                "`/` on " + self.show_type(src, left) + " needs a rounding contract, "
                                + "because the exact quotient can have more than "
                            + to_string(left.scale) + " decimal places");
                    return unknown_type();
                }
                return left;
            }
        }
        if n.value == 25 && left.kind == 42 && right.kind == 42 {
            if !self.has_region() {
                let r: Int = self.needs_region(src, n.token, "joining two Strings");
            }
            return left;
        }
        if left.kind == 45 && right.kind == 45 {
            // Addition and subtraction never round, so the SCALES must match and the
            // contracts need not: one side carrying a contract and the other none leaves
            // exactly one answer to "if this ever rounds, which way", and the result carries
            // it. Two DIFFERENT contracts is a real ambiguity and stays refused.
            // (Relaxed in v0.0.86, together with stage-0.)
            if left.scale != right.scale {
                let complained: Int = self.complain_at(src, n.token,
                            "cannot combine " + self.show_type(src, left) + " and " + self.show_type(src, right)
                        + ": scales must match. Burxt does not silently rescale money");
                return unknown_type();
            }
            if left.contract != 0 && right.contract != 0 && left.contract != right.contract {
                let complained: Int = self.complain_at(src, n.token,
                            "cannot combine " + self.show_type(src, left) + " and " + self.show_type(src, right)
                            + ": these are two different rounding contracts, and picking one would "
                        + "be a decision nobody wrote down");
                return unknown_type();
            }
            if left.contract != 0 {
                return left;
            }
            return right;
        }
        // `+` and `-` combine like quantities: every other type must match exactly.
        if !self.same_type(src, left, right) {
            let complained: Int = self.complain_at(src, n.token,
                        "cannot combine " + self.show_type(src, left) + " and " + self.show_type(src, right)
                    + ": addition and subtraction need the same type, scale included");
            return unknown_type();
        }
        return left;
    }

    if n.kind == 9 {                                 // a comparison
        let left: Type = self.type_of(src, n.a, unknown_type());
        let right: Type = self.type_of(src, n.b, left);
        // A CPointer is a token to hand back to C, not a value to compare — and pointer ORDERING
        // says even less than pointer equality. The question people mean has a name.
        if left.kind == 51 || right.kind == 51 {
            let complained: Int = self.complain_at(src, n.token,
                        "a CPointer has no comparison: it is a token to hand back to C, not a value to "
                        + "compare. To test whether the call failed, use `c_is_null(p)`; to read what it "
                    + "points at, `c_string_at(p)`, which copies");
            return simple_type(41);
        }
        if !is_unknown(left) && !is_unknown(right) && !self.same_type(src, left, right) {
            let complained: Int = self.complain_at(src, n.token,
                        "cannot compare " + self.show_type(src, left) + " with " + self.show_type(src, right)
                    + ": one equality, no coercion");
        }
        // A Bool is not ORDERED. `true < false` has to pick which of the two is smaller, and there is
        // no answer that is not a convention — so `==` and `!=` apply and the four ordering operators
        // do not. Stage-1 allowed all six, because the rule above only asks whether the two SIDES
        // agree, and two Bools agree.
        let ordering_only: Bool = n.value != 12 && n.value != 13;   // not `==`, not `!=`
        if ordering_only && left.kind == 41 {
            let complained: Int = self.complain_at(src, n.token,
                    "Bools have no order: `<` does not apply; only `==` and `!=` do");
        }
        // A CLASS gets `==` field by field and no ordering at all, and the asymmetry is the point.
        // Equality has one obvious meaning — every field equal — so it is derived. Ordering does not:
        // `<` on a two-field class would have to decide which field is compared first, and nothing in
        // the declaration says. Deriving it would be inventing a convention and hiding it inside an
        // operator, which is the opposite of what this language is for.
        if left.kind == 46 && !is_unknown(left) {
            let decl: Int = self.find_type(src, left.name_start, left.name_length);
            // B43. An ENUM has no `==` yet, and this arm asked only about classes — kind 82 — so
            // `a == Shade.Light` fell straight through and stage-1 compiled a program stage-0
            // refuses. No region anywhere, so it has nothing to do with the escape family: it was
            // UNMASKED by B36's narrowing, which had been over-refusing and hiding it.
            //
            // The reason the feature is absent is worth keeping in the message rather than saying
            // "not supported": two variants can carry different payloads, so equality has to
            // compare the TAG first and then only the payload that variant holds. `match` already
            // expresses exactly that, which is why this is a deferral and not a gap.
            if decl >= 0 && self.types[decl].kind == 83 {
                let complained: Int = self.complain_at(src, n.token,
                            "`==` on the enum `" + self.show_type(src, left) + "` is not available yet: "
                            + "two variants can carry different payloads, so equality has to compare the "
                        + "TAG first and then only the payload that variant holds. Use `match`.");
            }
            if decl >= 0 && self.types[decl].kind == 82 {
                if ordering_only {
                    let complained: Int = self.complain_at(src, n.token,
                                "`<` on `" + self.show_type(src, left) + "` would have to decide which "
                            + "field comes first, and nothing says which. Compare the fields you mean.");
                } else {
                    // Derived equality is only as available as its FIELDS are. A growable array
                    // field is the case that stops it: `==` on one is a separate question — same
                    // contents, or same storage — that nobody has answered, so a class holding one
                    // cannot borrow an answer it does not have.
                    let holder: Node = self.nodes[self.types[decl].node];
                    let restore: Int = self.bind_from_application(src, left);
                    let mutable f: Int = 0;
                    while f < holder.b {
                        let field: Node = self.nodes[self.children[holder.a + f]];
                        let held: Type = self.resolve_shallow(src,
                                self.declared_type(src, field.a));
                        if held.kind == 47 {
                            let field_named: Token = self.tokens[field.token];
                            let complained: Int = self.complain_at(src, n.token,
                                        "`==` on `" + self.show_type(src, left) + "` needs every field to "
                                        + "be comparable, and `" + self.show_type(src, left) + "."
                                        + substring(src, field_named.start, field_named.length)
                                        + "` is a growable array, and `==` on one is a separate question "
                                    + "— same contents, or same storage — that nothing here answers.");
                        }
                        f += 1;
                    }
                    let dropped: Int = truncate(self.type_bindings, restore);
                }
            }
        }
        // Two values of a type PARAMETER: whether this is allowed is entirely what the bound
        // says. Without one, a parameter can be stored, copied, passed and returned and
        // nothing else — the body is checked against the signature's promise, not against
        // whatever the instantiations happen to permit.
        let abstract_left: Type = self.resolve_shallow(src, left);
        if abstract_left.kind == 50 {
            let bound: Int = self.bound_of(src, abstract_left.name_start, abstract_left.name_length);
            let ordering: Bool = n.value != 12 && n.value != 13;   // not `==` and not `!=`
            if bound < 0 {
                let complained: Int = self.complain_at(src, n.token,
                            "`" + substring(src, abstract_left.name_start, abstract_left.name_length)
                            + "` is a type parameter with no bound, so two values of it cannot be "
                        + "compared: say so in the signature with a bound");
            } else {
                let named: Token = self.tokens[bound];
                let is_ordered: Bool = span_equal(src, named.start, named.length, "Ordered");
                let is_equatable: Bool = span_equal(src, named.start, named.length, "Equatable");
                if !is_ordered && (ordering || !is_equatable) {
                    let complained: Int = self.complain_at(src, n.token,
                                "comparing two values of `"
                                + substring(src, abstract_left.name_start, abstract_left.name_length)
                            + "` needs `Ordered`, or `Equatable` for `==` and `!=`");
                }
            }
        }
        return simple_type(41);
    }

    if n.kind == 10 {                                // && ||
        let left: Type = self.type_of(src, n.a, simple_type(41));
        let right: Type = self.type_of(src, n.b, simple_type(41));
        if !is_unknown(left) && left.kind != 41 {
            let complained: Int = self.complain_at(src, n.token, "this operator needs a Bool");
        }
        if !is_unknown(right) && right.kind != 41 {
            let complained: Int = self.complain_at(src, n.token, "this operator needs a Bool");
        }
        return simple_type(41);
    }

    // `Enum.Variant` and `Enum.Variant(payload)` — the base names a TYPE, not a
    // variable, so typing it as one reported an unknown name. An enum constructor
    // looks exactly like a field access or a method call until you check the base.
    if n.kind == 11 || n.kind == 14 {
        let base: Node = self.nodes[n.a];
        if base.kind == 5 {
            let base_name: Token = self.tokens[base.token];
            let declared: Int = self.find_type(src, base_name.start, base_name.length);
            if declared >= 0 {
                if self.types[declared].kind == 83 {
                    let mutable holder: Type = Type { kind: 46, scale: 0, contract: 0,
                                name_start: base_name.start,
                            name_length: base_name.length };
                    // A generic enum's arguments come from the context: `Option.Some(3)` is an
                    // `Option<Int>` because something said so, and `Option.None` has nothing
                    // else to go on.
                    if expected.kind == 46 && expected.contract > 0
                            && spans_equal(src, expected.name_start, expected.name_length,
                            base_name.start, base_name.length) {
                        holder = expected;
                    } else {
                        // ...and when the context says NOTHING, the ARGUMENT says it.
                        // `match Option.Some(5) { ... }` names no type anywhere — no annotation, no
                        // declared return type, no parameter it is passed to — and the `5` settles
                        // `T` on its own. Stage-0 has always read it, because it works out the
                        // arguments from the payload FIRST and asks the context second; stage-1
                        // only ever asked the context, so it compared `T` against `Int` and refused
                        // a program stage-0 accepts.
                        //
                        // This is the FOURTH shape of one question, and the three before it all
                        // went through the branch above — a declared return type, an annotated
                        // `let`, and a concrete instantiation. Passing those three was taken as
                        // evidence the whole question was answered. It was not, and the standing
                        // note applies: a checker that agrees may have stopped asking.
                        let arguments: Int = self.infer_variant_arguments(src, declared, n);
                        if arguments >= 0 {
                            let count: Int = len(self.nested_children) - arguments;
                            holder = Type { kind: 46, scale: arguments, contract: count,
                                        name_start: base_name.start,
                                    name_length: base_name.length };
                        }
                    }
                    let checked: Int = self.check_construction(src, holder, n);
                    return holder;
                }
            }
        }
    }

    if n.kind == 17 {                                // an array literal
        if expected.kind != 47 && expected.kind != 48 {
            let visited: Int = self.visit_children(src, node);
            return unknown_type();
        }
        let want: Type = self.declared_type(src, expected.scale);
        if expected.kind == 47 && !self.has_region() {
            let r: Int = self.needs_region(src, n.token, "a growable array");
        }
        if expected.kind == 48 && n.b != expected.contract {
            let complained: Int = self.complain_at(src, n.token,
                        "this array holds " + to_string(expected.contract) + " element(s), and "
                        + "the literal has " + to_string(n.b) + ": a fixed array's length is "
                    + "part of its type");
        }
        let mutable i: Int = 0;
        while i < n.b {
            let got: Type = self.type_of(src, self.children[n.a + i], want);
            if !is_unknown(got) && !self.fits(src, got, want) {
                let complained: Int = self.complain_at(src, n.token,
                            "element " + to_string(i + 1) + " should be " + self.show_type(src, want)
                        + ", but it is " + self.show_type(src, got));
            }
            i += 1;
        }
        return expected;
    }

    // `(1, "a")` — a tuple literal, roadmap A8. Its type comes from its ELEMENTS, which is
    // the difference from an array literal above: an array literal needs the declared type
    // to know what it is, a tuple literal is its own answer and `let p = (1, "a");` works
    // with no annotation at all.
    //
    // `expected` is still pushed down element-wise, and that is not a nicety: a decimal
    // literal takes its scale from the type it is stored into, so without it
    // `let p: (Decimal<2>, String) = (1.50, "x");` would settle on `Decimal<2>` by luck
    // rather than by contract, and `(1.5, "x")` into a `Decimal<2>` would be a scale
    // mismatch instead of the widening it is.
    if n.kind == 23 {
        let mutable elements: [Int] = [];
        let mutable i: Int = 0;
        while i < n.b {
            let mutable want: Type = unknown_type();
            if expected.kind == 53 && expected.contract == n.b {
                want = self.declared_type(src, self.nested_children[expected.scale + i]);
            }
            let got: Type = self.type_of(src, self.children[n.a + i], want);
            // A type nobody wrote down has no node, and a tuple holds its elements AS
            // nodes — the same wall `node_for` was built for when a slice's element had to
            // be resolved. An element with no node leaves the tuple untypeable, and an
            // unknown type is the safe answer because it silences the rules that would
            // otherwise be guessing.
            let stored: Int = self.node_for(got, n.token);
            if stored < 0 {
                return unknown_type();
            }
            push(elements, stored);
            i += 1;
        }
        let start: Int = len(self.nested_children);
        let mutable e: Int = 0;
        while e < len(elements) {
            let noted: Int = push(self.nested_children, elements[e]);
            e += 1;
        }
        return Type { kind: 53, scale: start, contract: n.b, name_start: 0, name_length: 0 };
    }

    if n.kind == 12 {                                // xs[i]
        let holder: Type = self.type_of(src, n.a, unknown_type());
        let index: Type = self.type_of(src, n.b, simple_type(40));
        if !is_unknown(index) && index.kind != 40 {
            let complained: Int = self.complain_at(src, n.token, "an index must be an Int");
        }
        if is_unknown(holder) {
            return unknown_type();
        }
        if holder.kind == 42 {
            let complained: Int = self.complain_at(src, n.token,
                    "a String is indexed with byte_at(s, i), which says it reads a BYTE");
            return unknown_type();
        }
        if holder.kind != 47 && holder.kind != 48 {
            let complained: Int = self.complain_at(src, n.token,
                    "indexing needs an array, but this is " + self.show_type(src, holder));
            return unknown_type();
        }
        if holder.kind == 48 {
            let index_node: Node = self.nodes[n.b];
            if index_node.kind == 1 {
                // A literal index is known now, so the bounds check is a compile error
                // rather than an exit 70 later. The runtime check stays for the rest.
                if index_node.value >= holder.contract || index_node.value < 0 {
                    let complained: Int = self.complain_at(src, n.token,
                                "this array holds " + to_string(holder.contract)
                                + " element(s), so " + to_string(index_node.value)
                            + " is past its end");
                }
            }
        }
        return self.declared_type(src, holder.scale);
    }

    // Kind 21: the value being returned, which is what an elided `[>= $0.00]` on a return type
    // compares against, and what `it` means there. It answers the enclosing signature's return type
    // and has no name at all — which is the point. The word `result` appears in no program that uses
    // the bracket form, so there is no span for a name node to carry, and inventing one was the wall
    // spec/M13 spent two versions describing.
    if n.kind == 21 {
        if self.result_type_node < 0 {
            let complained: Int = self.complain_at(src, n.token,
                    "the value being returned is only meaningful in a contract on the return type");
            return unknown_type();
        }
        return self.declared_type(src, self.result_type_node);
    }

    // ---- `e?` — M-ABSENCE: the value, or return the failure from here --------------------
    //
    // Sugar with teeth. It reads as though nothing can go wrong while the compiler still knows
    // it can, which is the whole trade: `let mean = divide(a + b, n)?;` in a function answering
    // `Result<Int, String>` is `match divide(a + b, n) { Error(e) => return Result.Error(e),
    // Ok(v) => v }`, written once instead of at every call.
    //
    // **Failure is recognised by the variant's NAME — `Error` or `None`.** Not by position, not
    // by a marker on the declaration, not by a trait. That is stage-0's rule and it is worth
    // stating because it is the load-bearing decision: it means `?` works on an enum a program
    // declared itself, with no ceremony, as long as it spells its failure the way the standard
    // library does. The cost is that a two-variant enum whose failure is called `Missing` gets a
    // refusal naming the two words, which is the message below.
    //
    // **`?` does NOT convert between failure payloads.** A `Result<Int, String>` cannot be
    // propagated out of a function answering `Result<Int, Int>` even though both fail with
    // `Error`. Converting would need a rule for HOW, and every such rule is a decision nobody
    // wrote down — so the refusal names both payloads and says to write the `match`.
    //
    // Every message here is copied from `typeck.rs` word for word, because the messages are part
    // of the parity: two compilers that refuse the same program for reasons a reader would
    // describe differently are two languages.
    if n.kind == 22 {
        let value: Type = self.type_of(src, n.a, unknown_type());
        // Already reported. A second complaint about the same expression teaches nothing and
        // buries the first, which is the house rule everywhere `is_unknown` is guarded on.
        if is_unknown(value) {
            return unknown_type();
        }
        let shown: String = self.show_type(src, value);
        if value.kind != 46 {
            let complained: Int = self.complain_at(src, n.token,
                        "`?` needs a value that is either a success or a failure, and this is "
                        + article_for(value) + " " + shown
                    + ". It works on an enum with two variants, one of them `Error` or `None`.");
            return unknown_type();
        }
        let found: Int = self.find_type(src, value.name_start, value.name_length);
        if found < 0 || self.types[found].kind != 83 {
            let complained: Int = self.complain_at(src, n.token,
                    "`?` needs an enum with two variants, and " + shown + " is not an enum.");
            return unknown_type();
        }
        let item: Node = self.nodes[self.types[found].node];
        if item.b != 2 {
            let complained: Int = self.complain_at(src, n.token,
                        "`?` needs an enum with exactly two variants — a success and a failure — and "
                    + shown + " has " + to_string(item.b) + ". Use `match`.");
            return unknown_type();
        }
        let fail_at: Int = self.failure_variant_index(src, value);
        if fail_at < 0 {
            let complained: Int = self.complain_at(src, n.token,
                        "`?` recognises a failure by the variant's NAME — `Error` or `None` — and "
                    + shown + " has neither. Rename the failing variant, or use `match`.");
            return unknown_type();
        }
        // Exactly two variants, so the success is the other one. Subtraction rather than a
        // second search, which is also how stage-0 gets it.
        let ok_at: Int = 1 - fail_at;
        let ok_variant: Node = self.nodes[self.children[item.a + ok_at]];
        let ok_named: Token = self.tokens[ok_variant.token];
        if ok_variant.c != 1 {
            let complained: Int = self.complain_at(src, n.token,
                        "`?` yields the success variant's value, and `" + shown + "."
                        + substring(src, ok_named.start, ok_named.length) + "` carries "
                    + to_string(ok_variant.c) + ". It must carry exactly one.");
            return unknown_type();
        }
        // What `?` ANSWERS: the success payload, under the type arguments this value was written
        // with. `Option<Int>`'s `Some` carries `T`, and `T` is only `Int` while the application's
        // bindings are in scope — hence the bind/resolve/unbind, which is the same three lines
        // every walk over a generic's insides uses. Resolving is not optional: without it
        // `let head = position_of(xs, 5)?;` gives `head` the type `T`, and the next line's
        // arithmetic on it is checked against nothing.
        let restore: Int = self.bind_from_application(src, value);
        let yielded: Type = self.resolve_shallow(src,
                self.declared_type(src, self.nested_children[ok_variant.b]));
        let dropped: Int = truncate(self.type_bindings, restore);

        // The enclosing function has to fail the SAME WAY, because that is what `?` does with
        // the failure: it returns it from here, unchanged.
        if self.in_function == 0 {
            let complained: Int = self.complain_at(src, n.token,
                        "`?` returns the failure from the enclosing function, and a top-level "
                        + "statement has none to return from. Put it in a `function` that answers "
                    + "with a failure of its own, or use `match`.");
            return yielded;
        }
        let fail_variant: Node = self.nodes[self.children[item.a + fail_at]];
        let fail_named: Token = self.tokens[fail_variant.token];
        let fail_name: String = substring(src, fail_named.start, fail_named.length);
        let answers: Type = self.enclosing_return_type();
        let ret_shown: String = self.show_type(src, answers);
        let ret_found: Int = self.find_type(src, answers.name_start, answers.name_length);
        if answers.kind != 46 || ret_found < 0 || self.types[ret_found].kind != 83 {
            let complained: Int = self.complain_at(src, n.token,
                        "`?` returns the failure from the enclosing function, which answers with "
                        + ret_shown + " — not something that can carry a failure. Give it a return "
                    + "type with an `" + fail_name + "` variant, or use `match`.");
            return yielded;
        }
        let ret_item: Node = self.nodes[self.types[ret_found].node];
        let ret_fail_at: Int = self.variant_named(src, ret_item, fail_named);
        if ret_fail_at < 0 {
            let complained: Int = self.complain_at(src, n.token,
                        "`?` returns `" + fail_name + "` from the enclosing function, and " + ret_shown
                    + " has no `" + fail_name + "` variant. Make the two agree, or use `match`.");
            return yielded;
        }
        let ret_fail: Node = self.nodes[self.children[ret_item.a + ret_fail_at]];
        if !self.payloads_agree(src, value, fail_variant, answers, ret_fail) {
            let complained: Int = self.complain_at(src, n.token,
                        "`?` does not convert between failures: this one carries "
                        + self.payload_list(src, value, fail_variant)
                        + ", and the enclosing function's `" + fail_name + "` carries "
                        + self.payload_list(src, answers, ret_fail)
                    + ". Write the `match`, or make the two agree.");
        }
        return yielded;
    }

    if n.kind == 14 {                                // a method call on a value
        // `Account.open(...)` — an ASSOCIATED function, which reads exactly like a method call and
        // is told apart the same way stage-0 tells one: by what the name in FRONT of the dot is. A
        // class name that is not also a binding, holding a method flagged associated.
        //
        // Checked before `type_of` on the base, because `Account` on its own is not an expression
        // and asking for its type is what produced "unknown name" for every constructor call.
        let associated: Int = self.associated_at(src, node);
        if associated >= 0 {
            let m: Method = self.methods[associated];
            if flag_allocates(m.flags) == 1 && !self.has_region() {
                let r: Int = self.needs_region(src, n.token,
                        "`" + substring(src, m.start, m.length) + "`");
            }
            if self.in_pure == 1 && flag_pure(m.flags) == 0 {
                let complained: Int = self.not_pure(src, n.token,
                        "call `" + substring(src, m.start, m.length) + "`, which is not `pure`");
            }
            let ok: Int = self.check_against_params(src, n.token, n.b, m.parameters, "method");
            // The node is marked so the emitter needs none of this reasoning again: `c` is unused
            // on a method call, and a second copy of "is this associated" in the backend is how
            // two answers to one question drift apart.
            self.nodes[node] = Node { kind: n.kind, a: n.a, b: n.b, c: 1,
                    value: n.value, token: n.token };
            return m.return_type;
        }
        let holder: Type = self.type_of(src, n.a, unknown_type());
        if is_unknown(holder) {
            let visited: Int = self.check_args(src, n.b);
            return unknown_type();
        }
        if holder.kind == 49 {                       // dynamic Trait
            return self.dynamic_method(src, holder, n, 1);
        }
        // A method on a BOUNDED type parameter — `<T: Priced>` calling `item.price()`. The method
        // lives on the BOUND, not on `T`, so the lookup goes to the interface's signatures. Stage-1
        // looked for a class named `T`, found none, and said "T has no such method" — refusing
        // `examples/generics.bx`'s own demonstration of static dispatch, which is the file written
        // to teach the feature.
        //
        // `borrowed` is 0: this is monomorphised, so the receiver is the caller's value and a
        // mutating method is legitimately reachable, unlike through an interface object.
        if holder.kind == 50 {
            let bound: Int = self.bound_of(src, holder.name_start, holder.name_length);
            if bound >= 0 {
                let bound_name: Token = self.tokens[bound];
                let declared: Int = self.find_type(src, bound_name.start, bound_name.length);
                if declared >= 0 && self.types[declared].kind == 84 {
                    let as_bound: Type = Type { kind: 49, scale: 0, contract: 0,
                                name_start: bound_name.start,
                            name_length: bound_name.length };
                    return self.dynamic_method(src, as_bound, n, 0);
                }
            }
        }
        let found: Int = self.find_method(src, holder, n.token);
        if found < 0 {
            let visited: Int = self.check_args(src, n.b);
            let complained: Int = self.complain_at(src, n.token,
                    self.show_type(src, holder) + " has no such method");
            return unknown_type();
        }
        let m: Method = self.methods[found];
        if self.in_pure == 0 {
            let reaches: Int = flag_effects(m.flags);
            if reaches > 0 {
                let checked: Int = self.check_effects(src, n.token,
                            self.show_type(src, holder) + "." + substring(src, m.start, m.length),
                        reaches);
            }
        }
        // A MUTATING method writes through its receiver, so the receiver needs the same permission
        // an assignment to it would need: it must be a variable, and that variable must be
        // `let mutable`. Two refusals rather than one, because the two mistakes are different —
        // `Account { ... }.deposit(1.00)` has nowhere for the change to land at all, while
        // `acct.deposit(1.00)` has somewhere that was declared not to change.
        //
        // Stage-1 checked neither until v0.0.223, which is the same hole the write-through rule had:
        // `mutable` was enforced on `x = v` and on nothing else, so a method declared
        // `function (mutable self: Account)` could be called on an immutable binding and quietly
        // rewrite it. Both are in the 43 stage-0 refused and stage-1 accepted.
        if m.mutating == 1 {
            let root: Int = self.lvalue_root(n.a);
            if root < 0 {
                let complained: Int = self.complain_at(src, n.token,
                            "`" + substring(src, m.start, m.length)
                            + "` is a mutating method (`function (mutable self: "
                            + self.show_type(src, holder) + ") ...`); it can only be called on a "
                        + "variable, not an expression.");
            } else {
                let base: Token = self.tokens[self.nodes[root].token];
                let bound: Int = self.find_binding(src, base.start, base.length);
                // `!= 1`: 1 is the only code that means writable, and `== 0` here would read a
                // `for` range's counter (code 2) as writable. See `Binding` in ast.bx.
                if bound >= 0 && self.bindings[bound].writable != 1 {
                    let named: String = substring(src, base.start, base.length);
                    let complained: Int = self.complain_at(src, n.token,
                                "cannot call the mutating method `" + substring(src, m.start, m.length)
                                + "` on `" + named + "`: it was declared immutable. "
                            + self.writable_advice(src, bound));
                }
                // B25 through `self`, which is the same hole wearing the receiver's name:
                // `function (mutable self: Bag) add(v: Int) { push(self.items, v); }` called on an
                // outer `bag` inside a region grows storage the region will release. Recorded
                // before the refusal, so the growth travels one link further out — a method that
                // calls it on its OWN `mutable self` grows too.
                //
                // The root is the name with nothing to walk, and the check just above is what
                // guarantees that: a mutating method can only be called on a variable.
                if self.grows_self(found) {
                    let passed: Int = self.record_parameter_growth(src, base.start, base.length);
                    if self.region_depth > 0 && bound >= 0
                            && self.bindings[bound].in_region == 0 {
                        let complained: Int = self.complain_at(src, n.token,
                                    self.growing_an_outer_binding(src,
                                        substring(src, base.start, base.length),
                                        self.show_type(src, holder) + "."
                                + substring(src, m.start, m.length) + "(...)"));
                    }
                }
            }
        }
        if flag_private(m.flags) == 1 && !self.inside_class(src, holder) {
            let complained: Int = self.complain_at(src, n.token,
                        "`" + self.show_type(src, holder) + "."
                        + substring(src, m.start, m.length)
                        + "()` is private: it is callable only from `"
                    + self.show_type(src, holder) + "`'s own methods");
        }
        if flag_allocates(m.flags) == 1 && !self.has_region() {
            let r: Int = self.needs_region(src, n.token,
                    "`" + substring(src, m.start, m.length) + "`");
        }
        // A4: purity is transitive through a method call, exactly as through a function call.
        // The comment here used to read *"not 'a method that is not pure': `pure` is refused ON
        // methods, so a method call from a pure function can never be allowed"* — true while the
        // marker was unspellable, and now the question is whether THIS method carries it.
        //
        // This is the rule that makes A4 worth having. A contract clause is checked with
        // `in_pure` set, so `requires self.sum() > 0` was refused by the blanket version — and the
        // contract machinery needed no change at all, only a method that could answer yes.
        if self.in_pure == 1 && flag_pure(m.flags) == 0 {
            let complained: Int = self.not_pure(src, n.token,
                    "call `" + substring(src, m.start, m.length) + "`, which is not `pure`");
        }
        // The receiver's arguments are in scope for the whole call: a parameter declared `T`
        // has to accept a Point when the receiver is a `Pair<Point>`, and the answer has to BE
        // a Point, because whoever receives it no longer has the bindings. The same shape the
        // field rule below uses — a method is a field's worth of resolution plus arguments.
        let base: Int = self.bind_from_application(src, holder);
        let ok: Int = self.check_against_params(src, n.token, n.b, m.parameters, "method");
        let answer: Type = self.resolve_deep(src, m.return_type, n.token);
        let dropped: Int = truncate(self.type_bindings, base);
        return answer;
    }

    if n.kind == 11 {                                // a field access
        let holder: Type = self.type_of(src, n.a, unknown_type());
        if is_unknown(holder) {
            return unknown_type();
        }
        // The field's type as the HOLDER sees it: `Stack<Int>.items` is `[Int]`, not `[T]`,
        // because whoever receives this answer no longer has the bindings.
        let base: Int = self.bind_from_application(src, holder);
        let declared: Type = self.field_type(src, holder, n.token);
        let field: Type = self.resolve_deep(src, declared, n.token);
        let dropped: Int = truncate(self.type_bindings, base);
        if is_unknown(field) {
            // A tuple has POSITIONS, not names, and the message has to say so: `has no such
            // field` would send a reader looking for a `class` declaration that was never
            // written, and it is also the only answer someone who wrote `pair.first` would
            // get — which does not tell them a NAME is the wrong shape of thing here.
            if holder.kind == 53 {
                let mutable positions: String = "";
                let mutable e: Int = 0;
                while e < holder.contract {
                    if e > 0 { positions += ", "; }
                    positions += "`." + to_string(e) + "`";
                    e += 1;
                }
                let named: Token = self.tokens[n.token];
                let complained: Int = self.complain_at(src, n.token,
                            "`" + self.show_type(src, holder) + "` is a tuple of "
                            + to_string(holder.contract) + " values, so it has no `."
                            + substring(src, named.start, named.length) + "`. Its positions are "
                        + positions + ", counting from zero.");
                return unknown_type();
            }
            let complained: Int = self.complain_at(src, n.token,
                    self.show_type(src, holder) + " has no such field");
        }
        if self.field_is_private(src, holder, n.token) && !self.inside_class(src, holder) {
            let complained: Int = self.complain_at(src, n.token,
                        "`" + self.show_type(src, holder) + "."
                        + substring(src, self.tokens[n.token].start, self.tokens[n.token].length)
                        + "` is private: it is reachable only from `"
                    + self.show_type(src, holder) + "`'s own methods");
        }
        return field;
    }

    if n.kind == 19 {                                // a class literal
        let name: Token = self.tokens[n.token];
        let found: Int = self.find_type(src, name.start, name.length);
        if found < 0 {
            let complained: Int = self.complain_at(src, n.token, "unknown type");
            let visited: Int = self.visit_children(src, node);
            return unknown_type();
        }
        let mutable holder: Type = Type { kind: 46, scale: 0, contract: 0,
                name_start: name.start, name_length: name.length };
        if expected.kind == 46 && expected.contract > 0
                && spans_equal(src, expected.name_start, expected.name_length,
                name.start, name.length) {
            holder = expected;                       // `Holder<Int>` said what T is
        } else {
            // Nothing said what `T` is, so read it off the field values — `Holder { one: 42 }`.
            // Answers the bare `Holder` unchanged when the literal does not say enough, which
            // leaves the refusal that asks for an annotation exactly where it was.
            holder = self.infer_class_arguments(src, node, name, holder);
        }
        let mutable i: Int = 0;
        while i < n.b {
            let pair: Node = self.nodes[self.children[n.a + i]];
            let base: Int = self.bind_from_application(src, holder);
            let stated: Type = self.field_type(src, holder, pair.token);
            let want: Type = self.resolve_deep(src, stated, pair.token);
            let dropped: Int = truncate(self.type_bindings, base);
            if is_unknown(want) {
                let complained: Int = self.complain_at(src, pair.token,
                        self.show_type(src, holder) + " has no such field");
            }
            // A private field a literal could still set from outside would be half a boundary:
            // `private` would protect reading and writing but not CONSTRUCTION, and every
            // `requires` on the class's constructor would be a suggestion. This is the rule that
            // turns the other two into a wall.
            if self.field_is_private(src, holder, pair.token) && !self.inside_class(src, holder) {
                let complained: Int = self.complain_at(src, n.token,
                            "`" + self.show_type(src, holder) + "."
                            + substring(src, self.tokens[pair.token].start,
                            self.tokens[pair.token].length)
                            + "` is private, so `" + self.show_type(src, holder)
                            + "` cannot be built here: a literal may set a private field only inside `"
                        + self.show_type(src, holder) + "`");
            }
            let got: Type = self.type_of(src, pair.a, want);
            if !is_unknown(got) && !is_unknown(want) && !self.fits(src, got, want) {
                let complained: Int = self.complain_at(src, pair.token,
                            "this field is " + self.show_type(src, want) + ", but the value is "
                        + self.show_type(src, got));
            }
            i += 1;
        }
        // Every field, not just the ones a writer remembered: a class with a hole in
        // it has no value the compiler could invent that would be right.
        let decl: TypeDeclaration = self.types[found];
        let item: Node = self.nodes[decl.node];
        let mutable f: Int = 0;
        while f < item.b {
            let field: Node = self.nodes[self.children[item.a + f]];
            let field_name: Token = self.tokens[field.token];
            let mutable given: Bool = false;
            let mutable g: Int = 0;
            while g < n.b {
                let pair: Node = self.nodes[self.children[n.a + g]];
                let pair_name: Token = self.tokens[pair.token];
                if spans_equal(src, pair_name.start, pair_name.length,
                        field_name.start, field_name.length) {
                    given = true;
                }
                g += 1;
            }
            if !given {
                let complained: Int = self.complain_at(src, n.token,
                            "this literal leaves out `"
                        + substring(src, field_name.start, field_name.length) + "`");
            }
            f += 1;
        }
        return holder;
    }

    if n.kind == 13 {                                // a call
        let t: Token = self.tokens[n.token];
        // C2. At the TOP of the call branch, before any of the paths below can answer. Placing it
        // beside `find_function` was wrong: several branches above return first — `result` inside
        // an `ensures`, a one-argument builtin — so the check ran for some calls and not others,
        // which is the shape of defect this whole section exists to remove.
        //
        // Asked before the lookup, never instead of it: a package's private helper is real and
        // usable inside that package, so it cannot be removed from the tables.
        let private_refusal: String = self.package_private_refusal(src,
                substring(src, t.start, t.length), t.start);
        if len(private_refusal) > 0 {
            let complained: Int = self.complain_at(src, n.token, private_refusal);
            return unknown_type();
        }
        // The effect check, at the TOP of the arm and before the builtin dispatch.
        //
        // Placement is the whole of it, and stage-0 records getting this wrong: further down, past the
        // builtins, `read_file` was invisible to the rule that exists to catch exactly that.
        //
        // Silent inside a `pure` function, so the purity rule speaks instead. Both are true there — a
        // pure function declares no effects and may reach none — but "`pure function f` may not read a
        // file" names the PROMISE being broken, and the effect message would only name the
        // bookkeeping. One rule speaks per situation and the more specific one wins.
        if self.in_pure == 0 {
            let called: String = substring(src, t.start, t.length);
            let mutable reaches: Int = builtin_effects(called);
            let declared_fn: Int = self.find_function(src, t.start, t.length);
            if declared_fn >= 0 {
                reaches = flag_effects(self.functions[declared_fn].flags);
            }
            if reaches > 0 {
                let checked: Int = self.check_effects(src, n.token, called, reaches);
            }
        }
        if span_equal(src, t.start, t.length, "old") {
            // `old(e)` is the pre-state, hoisted to the function's entry. It means
            // nothing where there is no exit to compare against.
            if self.in_ensures == 0 {
                let complained: Int = self.complain_at(src, n.token,
                            "`old(...)` is the value on entry, so it only means something in "
                        + "an `ensures` clause");
            }
            let list: Node = self.nodes[n.a];
            if list.b != 1 {
                let complained: Int = self.complain_at(src, n.token, "`old` takes one expression");
                return unknown_type();
            }
            let inner: Int = self.children[list.a];
            let held: Node = self.nodes[inner];
            if held.kind == 5 {
                let named: Token = self.tokens[held.token];
                if span_equal(src, named.start, named.length, "result") {
                    let complained: Int = self.complain_at(src, n.token,
                                "`old(result)` is a contradiction: the result does not exist "
                            + "on entry");
                    return unknown_type();
                }
            }
            let got: Type = self.type_of(src, inner, unknown_type());
            if got.kind == 46 || got.kind == 47 || got.kind == 48 || got.kind == 49
                    || got.kind == 53 {
                let complained: Int = self.complain_at(src, n.token,
                            "`old` of " + self.show_type(src, got) + " would need a copy of the whole "
                        + "value at entry, which is not built: name the fields instead");
                return unknown_type();
            }
            return got;
        }
        let found: Int = self.find_function(src, t.start, t.length);
        if found < 0 {
            // A builtin, or a name nobody declared. The compiler knows the builtins,
            // so the checker knows them too rather than staying silent about calls.
            let builtin: Type = self.builtin_type(src, t, n.token, n.a);
            if is_unknown(builtin) {
                // B48. NAMES the function, because stage-0 does and the two must say the same
                // thing. This divergence runs the other way from every other text row this week:
                // stage-1 adopts stage-0's wording rather than the reverse, and it is the better
                // message — `complain_at` appends "(at `nofunc`)", so the bare form said the name
                // once, in a suffix, and left the sentence itself unable to stand alone in a log.
                let complained: Int = self.complain_at(src, n.token,
                        "unknown function: " + substring(src, t.start, t.length));
            }
            return builtin;
        }
        let signature: DeclaredFunction = self.functions[found];
        if flag_allocates(signature.flags) == 1 && !self.has_region() {
            let r: Int = self.needs_region(src, n.token,
                    "`" + substring(src, signature.start, signature.length) + "`");
        }
        if self.in_pure == 1 && flag_pure(signature.flags) == 0 {
            let complained: Int = self.not_pure(src, n.token,
                        "call `" + substring(src, signature.start, signature.length)
                    + "`, which is not `pure`");
        }
        // A generic call: bind each type parameter from the arguments, then check exactly as
        // an ordinary call is checked. Nothing below this line knows generics exist — the
        // bindings do their work through `same_type`, which resolves as it recurses.
        let base: Int = len(self.type_bindings);
        // This call's bindings begin here, and `resolve_shallow` looks no further back while it is in
        // effect. Saved and restored, so a nested call gets its own clean view of `T` and this one gets
        // its view back afterwards.
        let outer_floor: Int = self.type_binding_floor;
        self.type_binding_floor = base;
        let generic: Int = self.generic_named(src, t.start, t.length);
        if generic >= 0 {
            // Anything the arguments cannot settle is read from the EXPECTATION first, so that
            // `let m: Map<String, Int> = map_new();` works: a type parameter appearing only in the
            // return type has no argument to infer from, and the annotation already says what it
            // is, in the place this language says a type belongs. Better than a turbofish, which
            // would ask a question the context has already answered.
            //
            // Bound BEFORE the arguments are matched, so an argument that disagrees still fails
            // where it should — `unify` refuses to rebind a parameter to something that does not
            // agree with what it already stands for.
            // Only when there IS an expectation. `print(identity(3))` has none, and binding `T`
            // to "unknown" before the arguments are looked at poisoned it — the argument then
            // disagreed with a parameter nobody had settled, and nine valid programs were refused.
            if !is_unknown(expected) {
                let from_context: Bool = self.unify(src, signature.return_type, expected);
            }
            let bound: Int = self.bind_type_arguments(src, generic, n.a, signature.parameters,
                    n.token);
        }
        let ok: Int = self.check_against_params(src, n.token, n.a, signature.parameters,
                "function");
        // B25: this callee grows one of its `mutable` parameters, so the growth is really a growth
        // of whatever THIS call handed over — and only here is it known whose binding that is.
        // After `check_against_params` rather than inside it, because that function is shared with
        // the two method forms and only the free-function form has a per-parameter answer to look
        // up. See `check_growing_arguments`.
        let grown: Int = self.check_growing_arguments(src, n.token, n.a, signature.parameters,
                found);
        // DEEPLY, not shallowly. `resolve_shallow` only answers for a bare parameter, so a
        // function returning `Map<K, V>` answered `Map<K, V>` — with the parameters still in it —
        // and whoever received that had no bindings left to make sense of them. The emitter reads
        // this cached answer to pick which copy to call, so a half-resolved one meant a call to an
        // unmangled `@map_new` that nothing defines.
        let answer: Type = self.resolve_deep(src, signature.return_type, n.token);
        // The bindings belong to this call. A nested generic call pushed its own on top and
        // truncating restores ours, which is why the base is taken before and not after.
        let dropped: Int = truncate(self.type_bindings, base);
        self.type_binding_floor = outer_floor;
        return answer;
    }

    // Anything else — fields, method calls, indexing, record and array literals —
    // is phase 4b. Its children are still visited so unknown names are still found.
    let visited: Int = self.visit_children(src, node);
    return unknown_type();
}

// Walk an expression's children without judging the node itself.
function (mutable self: Unit) visit_children(src: String, node: Int) -> Int {
    let n: Node = self.nodes[node];
    if n.kind == 11 || n.kind == 6 || n.kind == 7 {
        let a: Type = self.type_of(src, n.a, unknown_type());
        return 1;
    }
    if n.kind == 12 || n.kind == 14 {
        let a: Type = self.type_of(src, n.a, unknown_type());
        if n.kind == 12 {
            let b: Type = self.type_of(src, n.b, simple_type(40));
        }
        return 1;
    }
    if n.kind == 17 || n.kind == 19 {                // array or class literal
        let mutable i: Int = 0;
        while i < n.b {
            let child: Int = self.children[n.a + i];
            let field: Node = self.nodes[child];
            if n.kind == 19 {
                let v: Type = self.type_of(src, field.a, unknown_type());
            } else {
                let v: Type = self.type_of(src, child, unknown_type());
            }
            i += 1;
        }
        return 1;
    }
    return 0;
}

// Arity and argument types against a declared parameter list. Shared by function and
// method calls, because what the reader needs to be told is the same either way.
function (mutable self: Unit) check_against_params(src: String, at: Int, list_node: Int,
        params_node: Int, what: String) -> Int {
    let list: Node = self.nodes[list_node];
    let params: Node = self.nodes[params_node];
    if list.b != params.b {
        let complained: Int = self.complain_at(src, at,
                    "this call passes " + to_string(list.b) + " argument(s), but the "
                + what + " takes " + to_string(params.b));
        return 0;
    }
    let mutable i: Int = 0;
    while i < list.b {
        let param: Node = self.nodes[self.children[params.a + i]];
        let want: Type = as_burxt_sees(self.declared_type(src, param.a));
        let outer: Int = self.in_multiply;
        self.in_multiply = 0;                             // an argument is its own context
        let got: Type = self.type_of(src, self.children[list.a + i], want);
        self.in_multiply = outer;
        if !is_unknown(got) && !self.fits(src, got, want) {
            let complained: Int = self.complain_at(src, at,
                        "argument " + to_string(i + 1) + " should be " + self.show_type(src, want)
                    + ", but it is " + self.show_type(src, got));
        }
        // `mutable xs: [Int]` says the CALL changes the caller's value, so the argument needs the
        // same two things an assignment target needs: somewhere for the change to land, and
        // permission to land it. Two refusals, because the two mistakes have different answers —
        // `reverse([1, 2])` has nowhere at all, while `reverse(frozen)` has somewhere that was
        // declared not to change.
        //
        // Checked HERE rather than at each call kind, because this function is the one place both a
        // function call and a method call compare arguments against parameters — which is what its
        // header already says it is for. The rule shipped in v0.0.201 and stage-1 never learned to
        // refuse either misuse: two of the 43, and both silent, since the callee then writes through
        // a pointer to something the caller believes is fixed.
        if param.b == 1 {
            let argument: Int = self.children[list.a + i];
            let root: Int = self.lvalue_root(argument);
            if root < 0 {
                let complained: Int = self.complain_at(src, at,
                            "argument " + to_string(i + 1) + " of this call is declared `mutable`, so the "
                            + "call changes what it is given — and this is not something that can be "
                        + "changed. Pass a `let mutable` variable.");
            } else {
                let base: Token = self.tokens[self.nodes[root].token];
                let bound: Int = self.find_binding(src, base.start, base.length);
                // `!= 1`: 1 is the only code that means writable, and `== 0` here would read a
                // `for` range's counter (code 2) as writable. See `Binding` in ast.bx.
                if bound >= 0 && self.bindings[bound].writable != 1 {
                    let named: String = substring(src, base.start, base.length);
                    let complained: Int = self.complain_at(src, at,
                                "argument " + to_string(i + 1) + " is declared `mutable`, so this call can "
                                + "change it — cannot modify `" + named + "`: it was declared immutable. "
                            + self.writable_advice(src, bound));
                }
            }
        }
        i += 1;
    }
    return 1;
}

function (mutable self: Unit) check_args(src: String, list_node: Int) -> Int {
    if list_node < 0 {
        return 0;
    }
    let list: Node = self.nodes[list_node];
    let mutable i: Int = 0;
    while i < list.b {
        let argument: Type = self.type_of(src, self.children[list.a + i], unknown_type());
        i += 1;
    }
    return list.b;
}

// ---- B27: a pattern binding and a loop binding are bindings, and carried no taint -------------
//
// `match w { Some(s) => ... }` and `for n in made { ... }` each introduce a name that ALIASES the
// value it was read out of: a payload is a pointer into the enum's own cells and an aggregate
// element is a pointer into the array's, which is the same fact `expr_allocates`'s `?` arm already
// records — *"`e?` hands back a value read out of `e`'s OWN cells, and for an aggregate payload that
// value is a pointer into them, not a copy."* So when the subject holds region storage, the new name
// holds it too.
//
// The note at the `let` said the other five binding sites "pass 0, and that cannot cause a false
// refusal because none of them is assignable" — true, and beside the point: the escape rules ask
// `expr_allocates` about the VALUE, and a name with no taint answers false wherever it is read, not
// only where it is written. So
//
//     region r { let w = W.Some("a" + "b"); match w { Some(s) => { kept = s; } } }
//
// with `kept` declared outside was ACCEPTED, printed `ab`, and printed the next allocation's bytes
// after the region closed — while the same program with `kept = w_payload_expression` was refused.
//
// Nothing here has to know about the `let` relay: `let t: String = s;` asks `expr_allocates` about
// `s`, which reads this bit off `Binding.holds_region`, so tainting the ROOT carries through any
// number of relays. That half was already right, and it is why `m5` in the audit corpus was refused
// while `x3` was not — the same rule, reached from a root that had nothing to say.
//
// `base` is the index the pattern or the header pushed from, which both callers already hold because
// both already `truncate` back to it. Written back as whole `Binding`s because Burxt has no
// `xs[i].field = v` — the shape the two assignment arms already use to set `holds_region`.
function (mutable self: Unit) taint_aliased_bindings(src: String, base: Int, source: Int) -> Int {
    if self.region_depth == 0 {
        return 0;
    }
    // `in_region` and `holds_region` are set on exactly the conditions the `let` sets them on:
    // declared while a region was open, and given something the region built. Mirrored rather than
    // invented, because a second answer to "is this name region storage" is how the two halves of
    // this rule came apart in the first place.
    let built: Bool = self.expr_allocates(src, source);
    let mutable i: Int = base;
    while i < len(self.bindings) {
        let was: Binding = self.bindings[i];
        let mutable holds: Int = was.holds_region;
        if built {
            holds = 1;
        }
        self.bindings[i] = Binding { start: was.start, length: was.length,
                    bound_type: was.bound_type, writable: was.writable,
                    depth: was.depth, in_region: 1, holds_region: holds,
                dyn_owner: was.dyn_owner };
        i += 1;
    }
    return 1;
}

// ---- statements --------------------------------------------------------------
function (mutable self: Unit) check_block_nodes(src: String, block: Int, return_type: Type) -> Int {
    if block < 0 {
        return 0;
    }
    let node: Node = self.nodes[block];
    self.depth += 1;
    let mutable i: Int = 0;
    while i < node.b {
        let stmt: Int = self.children[node.a + i];
        let checked: Int = self.check_stmt_node(src, stmt, return_type);
        // Anything after a statement that always leaves the block can never run, and
        // a reader who wrote it believed otherwise. Reported once, at the first one.
        if self.stmt_exits(stmt) && i + 1 < node.b {
            let next: Node = self.nodes[self.children[node.a + i + 1]];
            let complained: Int = self.complain_at(src, next.token,
                    "this can never run: the statement before it always leaves the block");
            i = node.b;
        }
        i += 1;
    }
    // Everything declared inside the block leaves scope at the closing brace. One
    // `truncate` rather than a loop: the bindings a block made are the ones on top.
    let mutable keep: Int = len(self.bindings);
    while keep > 0 && self.bindings[keep - 1].depth >= self.depth {
        keep -= 1;
    }
    let dropped: Int = truncate(self.bindings, keep);
    self.depth -= 1;
    return node.b;
}

function (mutable self: Unit) check_stmt_node(src: String, stmt: Int, return_type: Type) -> Int {
    if stmt < 0 {
        return 0;
    }
    let n: Node = self.nodes[stmt];

    if n.kind == 60 {                                // let
        // Two paths, and only the first line differs: with an annotation the value is
        // checked AGAINST a type, without one the value IS the type. Inference removes
        // typing, not checking. See spec/1.0/M10-ERGONOMICS.md §1.
        let mutable declared: Type = unknown_type();
        if n.a >= 0 {
            // C2. A `let` naming a dependency's private class. `declared_type` cannot refuse — it
            // takes an immutable `self` and has no way to report — so the question is asked here,
            // where the annotation is read and the checker can still speak.
            let private_named: Int = self.refuse_private_type(src, n.a);
            declared = self.declared_type(src, n.a);
            let actual: Type = self.type_of(src, n.b, declared);
            // An interface object BORROWS the storage of the value it refers to, so there has to be
            // a value with storage to borrow. `let d: dynamic Priced = Book { cost: 1.00 };` points
            // at a temporary that is gone by the next statement — a dangling fat pointer, accepted
            // silently until now, and the same escape shape as returning one.
            if declared.kind == 49 && self.lvalue_root(n.b) < 0 {
                let complained: Int = self.complain_at(src, n.token,
                            "a `" + self.show_type(src, declared) + "` must come from a variable — an "
                            + "interface object borrows the storage of the value it refers to, and an "
                            + "expression has none that outlives this statement. Bind it first, then take "
                        + "the interface object.");
            }
            if !is_unknown(actual) && !self.fits(src, actual, declared) {
                // Pointed at the VALUE, not at the name. The name is fine — it is the value that
                // does not fit — and `let b: Bool = 2;` should underline the `2`.
                //
                // It said `n.token`, the binding, because that is the token a `let` node carries,
                // and for as long as the message ended in ``(at `b`)`` nobody could tell. Rendering
                // a caret block made the column visible and made this wrong in a way a reader sees:
                // stage-0 underlines column 15 and this underlined column 5. The only class of
                // divergence where stage-0's choice is the better one, measured over 137 differing
                // spans — everywhere else stage-1 points at the more specific token.
                let complained: Int = self.complain_at(src, self.nodes[n.b].token,
                            "declared " + self.show_type(src, declared) + ", but the value is "
                        + self.show_type(src, actual));
            }
        } else {
            declared = self.type_of(src, n.b, unknown_type());
            // An ARRAY LITERAL does not say whether the array is fixed or growable, and the two are
            // different types with different storage: `[Int; 3]` is a contiguous block, `[Int]` lives
            // in a region and can grow. Inference removes typing, not deciding — there is nothing
            // here to read the answer off, so the annotation is required rather than guessed.
            let value_node: Node = self.nodes[n.b];
            if value_node.kind == 17 {
                let complained: Int = self.complain_at(src, n.token,
                            "an array literal does not say whether the array is fixed or growable, so an "
                            + "array binding names its type: `let xs: [Int; 3] = ...` for a fixed one, or "
                        + "`let mutable xs: [Int] = ...` for a growable one.");
            }
            // `let nothing = Option.None;` and `let b = Bag { items: [] };` name a generic
            // and settle nothing: the value carries no type to read `T` off. With an
            // annotation both are fine, so the fix is to write one, and the message says so
            // rather than reporting the missing type as a mystery later.
            if self.unsettled_generic(src, declared) {
                let complained: Int = self.complain_at(src, n.token,
                            "cannot tell what " + self.show_type(src, declared)
                            + " holds from this value: write the type, as in "
                        + "`let x: " + self.show_type(src, declared) + "<Int> = ...`");
            }
        }
        let name: Token = self.tokens[n.token];
        // Shadowing is refused, so a second `let` of the same name is an error.
        if self.find_binding(src, name.start, name.length) >= 0 {
            let complained: Int = self.complain_at(src, n.token,
                    "this name is already declared — Burxt does not shadow");
        }
        if self.find_const(src, name.start, name.length) >= 0 {
            let complained: Int = self.complain_at(src, n.token,
                        "this name is already declared as a `const`, which is in scope in every "
                    + "function — Burxt does not shadow");
        }
        // `in_region`: declared while a `region` was open, so region storage may be assigned to it
        // — it dies with the region, which is correct. This is the ONLY site that marks, mirroring
        // stage-0, where `region_scope.insert` happens on `Let` and nowhere else. The other five
        // binding sites — a `for` element, a match payload, `self`, a parameter, `result` — pass 0,
        // and that cannot cause a false refusal because none of them is assignable.
        let mutable declared_in_region: Int = 0;
        let mutable given_region_bytes: Int = 0;
        if self.region_depth > 0 {
            declared_in_region = 1;
            // The same question the escape rules ask about a `return`, remembered instead of
            // discarded: did this initializer build something in the region? If so the NAME is
            // region storage from here on, and `return name` has to be refused exactly as
            // `return <that expression>` already is. Stage-0's `region_locals.insert` on `Let`.
            if self.expr_allocates(src, n.b) {
                given_region_bytes = 1;
            }
        }
        // A11. An interface object borrows the storage of the value behind it, so this `let`
        // gives that value a SECOND NAME, and the two facts that follow are settled here because
        // this is the only place that knows both the source and the new binding's `mutable`.
        //
        // **The permission may not be upgraded.** `let mutable it: dynamic I = d` with `d`
        // immutable would hand out through `it` exactly the write `d.method()` is refused — the
        // same bytes, one word of laundering. The other direction stays legal: an immutable `let`
        // over a mutable value simply cannot write.
        //
        // **The source is remembered**, in `dyn_owner`, because from here on the reader writes
        // `it` and every escape rule is about a name. See `Binding` in ast.bx.
        let mutable borrows: Int = 0 - 1;
        if declared.kind == 49 {
            let root: Int = self.lvalue_root(n.b);
            if root >= 0 {
                let from: Token = self.tokens[self.nodes[root].token];
                let source: Int = self.find_binding(src, from.start, from.length);
                if source >= 0 {
                    let held: Binding = self.bindings[source];
                    // Already an interface object: no coercion happens, the fat pointer is
                    // copied, and the copy reaches the same value — so the source travels with
                    // it. Without this the rule below is one `let` away from being stepped
                    // around, which is B27's shape exactly.
                    borrows = source;
                    if held.bound_type.kind == 49 {
                        borrows = held.dyn_owner;
                    }
                    // `!= 1`: 1 is the only code that means writable. See `Binding` in ast.bx.
                    if n.value == 1 && held.writable != 1 {
                        let named: String = substring(src, from.start, from.length);
                        let mine: String = substring(src, name.start, name.length);
                        if held.bound_type.kind == 49 {
                            let complained: Int = self.complain_at(src, n.token,
                                        "`let mutable " + mine + ": " + self.show_type(src, declared)
                                        + "` would copy `" + named + "`, which was declared immutable — "
                                        + "both names reach the one value behind the interface object, so "
                                        + "a `mutable` copy could change what `" + named + "` may not. "
                                        + self.writable_advice(src, source) + " Or drop `mutable` from `"
                                    + mine + "`.");
                        } else {
                            let complained: Int = self.complain_at(src, n.token,
                                        "`let mutable " + mine + ": " + self.show_type(src, declared)
                                        + "` would borrow `" + named + "`, which was declared immutable — "
                                        + "an interface object points at the storage of the value behind "
                                        + "it, so a `mutable` one could change `" + named + "` through `"
                                        + mine + "`. " + self.writable_advice(src, source)
                                    + " Or drop `mutable` from `" + mine + "`.");
                        }
                    }
                }
            }
        }
        push(self.bindings, Binding { start: name.start, length: name.length,
                        bound_type: declared, writable: n.value, depth: self.depth,
                        in_region: declared_in_region,
                holds_region: given_region_bytes, dyn_owner: borrows });
        // A `let` bound to relayed storage relays it. The rule is not "a pattern binding relays" —
        // `json_at` needs both hops in one function, `Object(fields)` and then
        // `let f: Field = fields[i]`, and teaching only the pattern moves the failure one statement
        // later rather than fixing it.
        let bound_from: Int = self.record_relay_aliases(len(self.bindings) - 1, n.b);
        return 1;
    }

    if n.kind == 72 {                                // for x in xs
        let holder: Type = self.type_of(src, n.a, unknown_type());
        let name: Token = self.tokens[n.token];
        if is_unknown(holder) {
            let skipped: Int = self.check_block_nodes(src, n.b, return_type);
            return 1;
        }
        if holder.kind == 42 {
            let complained: Int = self.complain_at(src, n.token,
                        "`for` iterates an array, and a String is bytes: use byte_at(s, i), "
                    + "which says BYTE so the byte-versus-character question cannot hide");
            return 1;
        }
        if holder.kind != 47 && holder.kind != 48 {
            let complained: Int = self.complain_at(src, n.token,
                    "`for` iterates an array, and this is " + self.show_type(src, holder));
            return 1;
        }
        if self.find_binding(src, name.start, name.length) >= 0 {
            let complained: Int = self.complain_at(src, n.token,
                        "this name is already declared — Burxt does not shadow, and a `for` "
                    + "binding is a binding");
        }
        if self.find_const(src, name.start, name.length) >= 0 {
            let complained: Int = self.complain_at(src, n.token,
                        "this name is already declared as a `const`, which is in scope in every "
                    + "function — Burxt does not shadow");
        }
        // The element is a COPY, and immutable: nothing may be written back through it.
        let element: Type = self.declared_type(src, holder.scale);
        let base: Int = len(self.bindings);
        self.depth += 1;
        push(self.bindings, Binding { start: name.start, length: name.length, bound_type: element,
                        writable: 0, depth: self.depth, in_region: 0, holds_region: 0,
                dyn_owner: 0 - 1 });
        // B27: the element aliases the array's storage, so it is region storage when the array is.
        // `n.a` is the holder, already typed just above, so the answer comes off the `typed` cache.
        let tainted: Int = self.taint_aliased_bindings(src, base, n.a);
        self.loop_depth += 1;
        let body: Int = self.check_block_nodes(src, n.b, return_type);
        self.loop_depth -= 1;
        self.depth -= 1;
        let dropped: Int = truncate(self.bindings, base);
        return 1;
    }

    if n.kind == 74 {                                // for i in a..b
        // ---- the five A6 decisions, enforced here and stated once ------------------------
        //
        // 1. The end is EXCLUSIVE, and there is no inclusive form at all. `0..3` is 0, 1, 2.
        //    (a) The idiom this replaces is `while i < len(xs)`, and `0..len(xs)` is the same
        //    bound written the same way; an inclusive range would need `0..=len(xs) - 1`, which
        //    puts an arithmetic correction into the most-written line in the language. (b)
        //    Half-open ranges tile: `a..b` and `b..c` cover `a..c` with no overlap and no gap,
        //    which is why `substring(s, from, LENGTH)` and every slice in `lib/` are already
        //    half-open. (c) Two forms differing by ONE character, where that character changes
        //    the number of iterations, is exactly the defect a reviewer's eye slides over —
        //    and reviewability is what this language is FOR. The cost is named: a loop that
        //    must touch `n` writes `0..n + 1`, a visible `+ 1` instead of an invisible `=`.
        //    `..=` and `...` are refused in the lexer, with that sentence.
        //
        // 2. A range is not a VALUE — `let r = 0..3;` is refused in `parse_expr`. A range value
        //    wants an iterator protocol; the half version buildable today would be two fields
        //    with no `next` and no laziness, and the real one would then have to keep or break
        //    it. Cost: no range parameter, no `for i in r`, and no `range(n)` in `lib/` yet.
        //
        // 3. Both bounds are Ints. A Decimal range would have to invent a step and a String
        //    range an order, so `1.0..2.0` — which LEXES perfectly, see `scan_punct` — is
        //    refused here, where the types are known, rather than truncated anywhere.
        //
        // 4. The counter is IMMUTABLE. It is a fresh value each pass, so an assignment to it
        //    could only be discarded, and a writable loop variable is how an off-by-one hides.
        //    Bound with `writable: 2` — see `Binding` in ast.bx for why a third code beats a
        //    fourth field, and what it costs at every other `writable` test.
        //
        // 5. Reversed LITERAL bounds are refused; reversed computed bounds run zero times.
        //    `for i in 3..0` can only be a mistake and both values are in hand. `for i in a..b`
        //    with `a > b` runs zero times, because the lowering is `i = a; while i < b` — and
        //    `for i in 0..len(xs)` over an empty array MUST run zero times rather than trap.
        //    A compiler refuses what it can SEE; a range it cannot see is not an error.
        //    `0..0` is allowed. Only strictly-decreasing literals are refused.
        let name: Token = self.tokens[n.token];
        let start_type: Type = self.type_of(src, n.a, simple_type(40));
        let end_type: Type = self.type_of(src, n.c, simple_type(40));
        if !is_unknown(start_type) && start_type.kind != 40 {
            let complained: Int = self.complain_at(src, n.token,
                        "a `for` range counts, so its start must be an Int, and this is "
                        + self.show_type(src, start_type)
                        + ". Ranges are Int-only on purpose: a Decimal range would have to invent a "
                    + "step, and a String range an order");
        }
        if !is_unknown(end_type) && end_type.kind != 40 {
            let complained: Int = self.complain_at(src, n.token,
                        "a `for` range counts, so its end must be an Int, and this is "
                        + self.show_type(src, end_type)
                        + ". Ranges are Int-only on purpose: a Decimal range would have to invent a "
                    + "step, and a String range an order");
        }
        // Two functions rather than one answering "the value, or absent", because Burxt has no
        // tuples yet (roadmap A8) and no `Option<Int>` from a free function yet — so the
        // one-function form would need a sentinel, and a sentinel that can also be a real bound
        // is the bug this rule exists to catch.
        if self.is_literal_int(n.a) && self.is_literal_int(n.c) {
            let start_value: Int = self.literal_int_value(n.a);
            let end_value: Int = self.literal_int_value(n.c);
            if start_value > end_value {
                let complained: Int = self.complain_at(src, n.token,
                            "`" + to_string(start_value) + ".." + to_string(end_value)
                            + "` counts down, and a `for` range only counts up — it would run zero "
                            + "times. Both bounds are literals here, so this cannot be anything but a "
                            + "mistake. To walk backwards, count up and subtract: `for k in 0.."
                            + to_string(start_value - end_value) + " \{ let i = "
                        + to_string(start_value) + " - 1 - k; ... \}`.");
            }
        }
        if self.find_binding(src, name.start, name.length) >= 0 {
            let complained: Int = self.complain_at(src, n.token,
                        "this name is already declared — Burxt does not shadow, and a `for` "
                    + "binding is a binding");
        }
        // A `const` is in scope in every function, so a counter may not take its name either.
        // Copied from the array `for` above rather than invented: A2 added that check after A6
        // was first written, and a second `for` form that forgot it would be a rule stage-0 has
        // and stage-1 does not — which is exactly what the checker equality exists to catch.
        // Stage-0 was the one that had forgotten it; see the note in its `ForRange` arm.
        if self.find_const(src, name.start, name.length) >= 0 {
            let complained: Int = self.complain_at(src, n.token,
                        "this name is already declared as a `const`, which is in scope in every "
                    + "function — Burxt does not shadow");
        }
        let base: Int = len(self.bindings);
        self.depth += 1;
        push(self.bindings, Binding { start: name.start, length: name.length,
                        bound_type: simple_type(40), writable: 2, depth: self.depth,
                in_region: 0, holds_region: 0, dyn_owner: 0 - 1 });
        self.loop_depth += 1;
        let body: Int = self.check_block_nodes(src, n.b, return_type);
        self.loop_depth -= 1;
        self.depth -= 1;
        let dropped: Int = truncate(self.bindings, base);
        return 1;
    }

    if n.kind == 61 {                                // assignment
        let target: Node = self.nodes[n.a];
        let want: Type = self.type_of(src, n.a, unknown_type());
        let got: Type = self.type_of(src, n.b, want);
        if !is_unknown(got) && !is_unknown(want) && !self.fits(src, got, want) {
            let complained: Int = self.complain_at(src, n.token,
                    "cannot assign " + self.show_type(src, got) + " to " + self.show_type(src, want));
        }
        // B44. Assigning a WHOLE fixed array — `kept = h.xs` — is deferred in stage-0 and was
        // accepted here, so the two compilers disagreed about whether the program exists. Region-
        // free, like B43, and unmasked by the same B36 narrowing that had been over-refusing.
        //
        // Only a bare NAME on the left: `xs[0] = 9` is an element write and is fine, and it is the
        // spelling the message points at. Kinds 11 and 12 are field and index access, so a target
        // that is neither is the whole-name case.
        if target.kind != 11 && target.kind != 12 && want.kind == 48 {
            let named: Token = self.tokens[target.token];
            let complained: Int = self.complain_at(src, n.token,
                        "whole-array assignment is deferred — assign elements individually: "
                    + substring(src, named.start, named.length) + "[0] = ...");
        }
        // A write THROUGH a name — `a[0] = 9`, `item.price = 2.00` — needs the same permission a
        // write TO it does. The binding is the thing that was declared immutable, whichever way the
        // write reaches it.
        if target.kind == 11 || target.kind == 12 {
            let refused: Int = self.refuse_immutable_write(src, n.a);
            // ---- B21: and the same is true of the REGION rule --------------------------------
            //
            // The escape rule below has been on whole-name assignment since v0.0.222 and was never
            // extended to the three spellings that reach a place through a field or an index. Not a
            // weak check — there was none, in either compiler — so
            //
            //     region r { b.name = "hello-" + "world"; }
            //
            // compiled clean and `b.name` afterwards read the next allocation's bytes.
            //
            // Asked about the ROOT binding, because `g.items[0] = v` is a write into `g` and the
            // question is only ever about a NAME: was it declared inside the open region, where the
            // bytes and the binding die together, or outside it, where the binding outlives them.
            // One question answers all four spellings, which is why stage-0 grew `place_root` for
            // this and stage-1 already had `lvalue_root`.
            let place: Int = self.lvalue_root(n.a);
            // NOT gated on a region being open, and B25 is why: in
            // `function rename(mutable b: Box, tag: String) { b.name = "n-" + tag; }` there is no
            // region at all, and the storage still lands in the caller's `b`. The refusal below is
            // still gated; the RECORDING is not. Stage-0 restructured these three arms the same way
            // and for the same reason.
            if place >= 0 && self.expr_allocates(src, n.b) {
                let root: Token = self.tokens[self.nodes[place].token];
                let owner: Int = self.find_binding(src, root.start, root.length);
                let named: String = substring(src, root.start, root.length);
                let grown: Int = self.record_parameter_growth(src, root.start, root.length);
                // "field" for `b.name`, "element" for anything reached through an index — including
                // `g.items[0]`, where the write is through a field AND an index and the thing
                // written is still an element. Stage-0 chooses the word the same way.
                let mutable part: String = "element";
                if target.kind == 11 {
                    part = "field";
                }
                if self.region_depth > 0 && owner >= 0 && self.bindings[owner].in_region == 0 {
                    let complained: Int = self.complain_at(src, self.nodes[place].token,
                                "`" + named + "` was declared outside " + self.open_region(src)
                                + ", so its " + part + " cannot be assigned a value built inside it — the "
                                + "bytes are released at the closing brace and `" + named
                                + "` would read whatever the region hands out next. Declare `" + named
                            + "` inside the region, or build the value outside it.");
                }
                if self.region_depth > 0 && owner >= 0 && self.bindings[owner].in_region == 1 {
                    // Declared inside the region, so the store is fine — but the binding now HOLDS
                    // region storage, and `return b` has to be refused exactly as `return b.name`
                    // already is. The whole-name arm records this; without the same line the taint
                    // is lost the moment it arrives through a field.
                    let was: Binding = self.bindings[owner];
                    self.bindings[owner] = Binding { start: was.start, length: was.length,
                                bound_type: was.bound_type, writable: was.writable,
                                depth: was.depth, in_region: was.in_region,
                            holds_region: 1, dyn_owner: was.dyn_owner };
                }
            }
        }
        // Only a `let mutable` binding may be assigned to.
        if target.kind == 5 {
            let name: Token = self.tokens[target.token];
            let found: Int = self.find_binding(src, name.start, name.length);
            // Code 2 first, because a `for` range's counter is immutable AND cannot be made
            // otherwise, so the ordinary advice ("declare it `let mutable`") would name a `let`
            // that does not exist. The two branches test 2 and 0 by hand rather than sharing a
            // `!= 1`, because they give DIFFERENT messages — the one place among the five where
            // the codes have to be told apart rather than merely not confused.
            //
            // Word for word stage-0's message from "the counter of" on: the two compilers'
            // messages ARE the language's instruction set, and two wordings for one rule is how
            // a language starts feeling arbitrary. The opening differs only because
            // `complain_at` quotes the name at the END — the same shape the "declared immutable"
            // message below already has. See `Binding` in ast.bx for the codes.
            if found >= 0 && self.bindings[found].writable == 2 {
                let complained: Int = self.complain_at(src, target.token,
                            "this is the counter of a `for` range, and the loop recomputes it on "
                            + "every pass — an assignment here would be silently thrown away. "
                            + "Assigning to a loop variable is a bug, not a feature. Change the "
                        + "range, or copy it into a `let mutable`");
            }
            if found >= 0 && self.bindings[found].writable == 0 {
                let complained: Int = self.complain_at(src, target.token,
                        "this was declared immutable — declare it `let mutable` to allow it");
            }
            // A const is not a binding, so without this the immutability check above simply
            // did not fire and `LIMIT = 5;` was ACCEPTED. Exactly the shape the note on the
            // rejection equality warns about: a rule that never runs looks like one that passes.
            if found < 0 && self.find_const(src, name.start, name.length) >= 0 {
                let complained: Int = self.complain_at(src, target.token,
                            "this is a `const`: a name for a literal, not a place to store one. There "
                            + "is nothing to assign to — by the time the program runs, every use of it "
                        + "IS the literal");
            }
            // ---- M1: region storage cannot be assigned OUTWARD -----------------------------
            //
            // Region storage may be assigned to a name declared INSIDE the region — it dies with
            // the region, which is correct — but never to one declared outside it. Stage-0 gained
            // this rule in v0.0.222 and stage-1 accepted the program until this line existed, so
            // the two compilers disagreed about whether a use-after-free is a program.
            //
            // **What it looked like before the rule**, and it is worth writing down because it is
            // the outcome this whole language exists to prevent:
            //
            //     let mutable kept: String = "";
            //     region one_turn { let made: String = "turn " + to_string(turn); kept = made; }
            //     print("after turn " + to_string(turn) + ": " + kept);
            //
            // printed `after turn 0: after turn 0` — `kept` reading back as the print statement's
            // own concatenation buffer, because the region released its bytes at the closing brace
            // and handed the same address out for the next allocation. It compiled clean, printed a
            // plausible answer, and said nothing.
            //
            // Stage-0's version of this bug is the sharper lesson: its checker ALREADY marked
            // `kept` as region storage, so `return kept` was refused — but the mark was cleared
            // when the region closed, so the read afterwards was unguarded. **Marking a hazard is
            // not refusing it**, and a rule one line away from being enforced is not a rule.
            //
            // The message NAMES the region, as stage-0's has since v0.0.222. It used to say
            // `this region`, and the note here explained why — the name lives on the `region`
            // node and reaching it needed a `Unit` field — and then left the divergence in place
            // on the grounds that `tests/fail/` compares stage-1 by whether it refuses rather
            // than by its wording. That reasoning is what made it permanent: the messages ARE
            // the language's instruction set, so two wordings for one rule is a divergence
            // whether or not a fixture measures it. `Unit.region_token` is the field, and it is
            // three lines.
            if self.region_depth > 0 && found >= 0 && self.expr_allocates(src, n.b) {
                if self.bindings[found].in_region == 0 {
                    let complained: Int = self.complain_at(src, target.token,
                                "`" + substring(src, name.start, name.length) + "` was declared outside "
                                + self.open_region(src)
                                + ", so it cannot be assigned a value built inside it — the "
                                + "bytes are released at the closing brace and `"
                                + substring(src, name.start, name.length) + "` would read whatever the "
                                + "region hands out next. Declare `"
                                + substring(src, name.start, name.length) + "` inside the region, or "
                            + "build the value outside it.");
                } else {
                    // Legal — the name lives inside the region and dies with it — but it now HOLDS
                    // region storage, so `return` of it must still be refused. Written back as a
                    // whole `Binding` because Burxt has no `xs[i].field = v`; the same shape
                    // `parse_record` uses to set a method's private bit. Stage-0's
                    // `region_locals.insert` on the assignment path, and the half whose absence was
                    // the v0.0.222 bug: it marked and then cleared, so the mark met nothing.
                    let was: Binding = self.bindings[found];
                    self.bindings[found] = Binding { start: was.start, length: was.length,
                                bound_type: was.bound_type, writable: was.writable,
                                depth: was.depth, in_region: was.in_region,
                            holds_region: 1, dyn_owner: was.dyn_owner };
                }
            }
            // A11, the `let`'s rules asked at the second place a program can ask them: `d = other`
            // re-points an interface object. B20/B21's shape is exactly this — one of the ways to
            // reach a place had the rule and the others did not — so the assignment gets both
            // halves, the refusal and the re-recording of what `d` now borrows.
            //
            // Only for a binding that is actually writable: an immutable one was refused above,
            // and complaining twice about one statement names the wrong cause second.
            if found >= 0 && self.bindings[found].writable == 1
                    && self.bindings[found].bound_type.kind == 49 {
                let mutable now: Int = 0 - 1;
                let root: Int = self.lvalue_root(n.b);
                if root >= 0 {
                    let from: Token = self.tokens[self.nodes[root].token];
                    let source: Int = self.find_binding(src, from.start, from.length);
                    if source >= 0 {
                        let held: Binding = self.bindings[source];
                        now = source;
                        if held.bound_type.kind == 49 {
                            now = held.dyn_owner;
                        }
                        if held.writable != 1 {
                            let mine: String = substring(src, name.start, name.length);
                            let named: String = substring(src, from.start, from.length);
                            let mutable what: String = "change `" + named + "`";
                            if held.bound_type.kind == 49 {
                                what = "change what `" + named + "` may not";
                            }
                            let complained: Int = self.complain_at(src, target.token,
                                        "`" + mine + "` may be written through, so it may not be pointed "
                                        + "at `" + named + "`, which was declared immutable — the "
                                        + "assignment would let `" + mine + "` " + what + ". "
                                    + self.writable_advice(src, source));
                        }
                    }
                }
                let was: Binding = self.bindings[found];
                self.bindings[found] = Binding { start: was.start, length: was.length,
                            bound_type: was.bound_type, writable: was.writable,
                            depth: was.depth, in_region: was.in_region,
                        holds_region: was.holds_region, dyn_owner: now };
            }
        }
        return 1;
    }

    if n.kind == 62 {                                // print
        if self.in_pure == 1 {
            let complained: Int = self.not_pure(src, n.token, "print");
        }
        // A printed type PARAMETER, found without typing the expression. Calling `type_of`
        // here would fill the cache that the rules below read, and those rules have been
        // switching on `unknown` — so making them live rejected nine programs stage-0
        // accepts. That is a real gap in this branch, recorded rather than fixed blind:
        // the rules were written against an assumption this file no longer holds.
        let printed: Node = self.nodes[n.a];
        if printed.kind == 5 {
            let referenced: Token = self.tokens[printed.token];
            let where: Int = self.find_binding(src, referenced.start, referenced.length);
            if where >= 0 && self.bindings[where].bound_type.kind == 50 {
                let named: Type = self.bindings[where].bound_type;
                let complained: Int = self.complain_at(src, n.token,
                            "`" + substring(src, named.name_start, named.name_length)
                            + "` is a type parameter with no bound, so a value of it can be stored, "
                            + "copied, passed and returned — not printed, which needs to know what "
                        + "the value IS");
            }
        }
        let shown: Type = self.type_at(n.a);
        if shown.kind == 50 {
            let complained: Int = self.complain_at(src, n.token,
                        "`" + substring(src, shown.name_start, shown.name_length)
                        + "` is a type parameter with no bound, so a value of it can be stored, "
                        + "copied, passed and returned — not printed, which needs to know what the "
                    + "value IS");
        }
        // 53 is a tuple, and it belongs in this list for exactly the reason a class does: it
        // holds more than one value and the language has no rendering to choose between them.
        // Stage-0 refuses it through its `Named` arm, because by then the tuple IS a class;
        // here it is still a tuple, so it has to be named. Its absence was found by the
        // differential test, not by reading: stage-1 ACCEPTED `print(pair)` and printed the
        // tuple's ADDRESS.
        if shown.kind == 46 || shown.kind == 49 || shown.kind == 47 || shown.kind == 48
                || shown.kind == 53 {
            let complained: Int = self.complain_at(src, n.token,
                        "`print` renders a number, a Bool, a Decimal or a String — "
                        + self.show_type(src, shown) + " has no one rendering the language can choose "
                    + "for it");
        }
        // Not "not yet" — never. An address differs between runs, so a program that printed one
        // would not be reproducible, and that is the property everything else here protects.
        if shown.kind == 51 {
            let complained: Int = self.complain_at(src, n.token,
                        "print does not show a CPointer, and never will: an address differs between runs, "
                        + "so printing one would make this program's output different every time. Ask "
                    + "`c_is_null(p)` whether the call failed, or `c_string_at(p)` for what it points at");
        }
        let target: Node = self.nodes[n.a];
        if target.kind == 18 {
            // Printing an interpolated string writes its pieces in order, so no String is
            // built and no region is needed. Used as a VALUE it is a join, and that does.
            let checked: Int = self.check_pieces(src, target);
            return 1;
        }
    }
    if n.kind == 70 && self.is_exit_call(src, n.a) {
        // `exit(code)` — a STATEMENT, and not a builtin call, because a builtin has to answer with a
        // type and this one never answers. Typing it `Int` would be a small lie in a language whose
        // argument is that it does not tell them.
        if self.in_pure == 1 {
            let complained: Int = self.not_pure(src, n.token, "exit");
        }
        let call: Node = self.nodes[n.a];
        let list: Node = self.nodes[call.a];
        if list.b != 1 {
            let complained: Int = self.complain_at(src, n.token,
                    "`exit(code)` takes one Int — the status a shell reads");
            return 1;
        }
        let status: Type = self.type_of(src, self.children[list.a], simple_type(40));
        if !is_unknown(status) && status.kind != 40 {
            let complained: Int = self.complain_at(src, n.token,
                    "`exit(code)` takes an Int, but this is " + self.show_type(src, status));
        }
        // 0..=255, because that is what a status IS. POSIX hands the shell only the low eight bits,
        // so `exit(256)` arrives as 0 — a program reporting SUCCESS while trying to report failure,
        // which is the worst direction for this mistake to go.
        let written: Node = self.nodes[self.children[list.a]];
        if written.kind == 1 {
            if written.value < 0 || written.value > 255 {
                let complained: Int = self.complain_at(src, n.token,
                            "`exit(" + to_string(written.value) + ")` cannot be reported: a process status "
                        + "is 0 to 255, and a shell reads only the low eight bits");
            }
        }
        return 1;
    }
    if n.kind == 62 || n.kind == 70 {                // print, expression statement
        let value: Type = self.type_of(src, n.a, unknown_type());
        return 1;
    }

    if n.kind == 63 || n.kind == 64 {                // return, return tail
        if self.in_function == 0 {
            let complained: Int = self.complain_at(src, n.token,
                        "there is nothing here to return from: top-level code runs, it does "
                    + "not answer");
            let visited: Type = self.type_of(src, n.a, unknown_type());
            return 1;
        }
        let value: Type = self.type_of(src, n.a, return_type);
        if !is_unknown(value) && !is_unknown(return_type) && !self.fits(src, value, return_type) {
            let complained: Int = self.complain_at(src, n.token,
                        "this function returns " + self.show_type(src, return_type) + ", but the value is "
                    + self.show_type(src, value));
        }
        if n.kind == 64 {
            let checked: Int = self.check_tail(src, n, return_type);
        }
        // B32, and it goes BEFORE the escape rule rather than inside it, for two reasons that are
        // easy to get wrong. A relay does not allocate, so `expr_allocates` below answers false on
        // exactly the returns this has to see. And the probing branch inside it `return`s, so
        // anything written after it is skipped on the rounds that are the only ones recording.
        let relayed: Int = self.record_return_relay(src, n.a);
        // The escape rule, and the whole of M1 in one condition: a built value may
        // leave a function ONLY when it was built in the CALLER's region — which means
        // `allocates`, and no region of this function's own open around the return.
        // A `region` block ends at its closing brace, so anything built inside it
        // would outlive its storage.
        if self.expr_allocates(src, n.a) {
            // Probing: the SECOND way a function turns out to allocate, and missing it made
            // the inference silently incomplete rather than wrong. `has_region` catches the
            // first way — something in the body wanted a region — but a function can allocate
            // purely by RETURNING built data it never bound. `lib/map.bx`'s `map_new` returns
            // `Map { entries: [], slots: [], live: 0 }` straight out, with no `let` anywhere,
            // so nothing ever asked and the probe credited nothing. Asking here classes it,
            // and classes it in the one place that knows how.
            if self.probing == 1 {
                let asked: Bool = self.has_region();
                return 1;
            }
            // The escape rule, and after slice 2 it is the ONLY one left: a value built
            // inside a `region` block cannot leave it, because that block releases at its
            // closing brace. Outside one there is nothing to escape from — the bytes live in
            // the program's arena and outlive every call. The `in_caller_region` half is gone
            // with the word that fed it.
            // The TYPE gate, matching stage-0. `region_depth > 0` says a region is open; it does
            // not say the value being returned lives in it. An `Int` points at nothing, so it
            // outlives anything — and this refused `let n: Int = measure(text); return n;` where
            // `measure` builds a String and answers its length, telling the author to "return a
            // scalar summary", which is exactly what they had written.
            //
            // Stage-0 had the same hole and was fixed in the same change. It is the substitution
            // this project has now made three times in three passes: asking what a function DID
            // where the question is what the VALUE IS.
            if self.region_depth > 0 && self.may_be_region_storage(src, self.type_at(n.a)) {
                // Naming the TYPE, as stage-0 does — `cannot return this String`. Found by
                // comparing the two compilers' text on the escape fixtures while closing B25:
                // both refuse, so no fixture and no differential could see it, and one rule
                // still had two wordings. The same divergence the region name was, in the
                // sibling rule, and it survived because "does it refuse" was the only
                // question anything asked.
                let built: Type = self.type_at(n.a);
                let complained: Int = self.complain_at(src, n.token,
                            "cannot return this " + self.show_type(src, built)
                            + ": it was built inside a `region` block, which "
                            + "releases at its closing brace, so its storage would not outlive "
                            + "the call. Move the allocation out of the `region` block, or return "
                        + "a scalar summary.");
            }
        }
        return 1;
    }

    if n.kind == 65 {                                // if
        let cond: Type = self.type_of(src, n.a, simple_type(41));
        if !is_unknown(cond) && cond.kind != 41 {
            let complained: Int = self.complain_at(src, n.token, "an `if` condition must be a Bool");
        }
        let t: Int = self.check_block_nodes(src, n.b, return_type);
        if n.c >= 0 {
            let other: Node = self.nodes[n.c];
            if other.kind == 16 {
                let f: Int = self.check_block_nodes(src, n.c, return_type);
            } else {
                let f: Int = self.check_stmt_node(src, n.c, return_type);
            }
        }
        return 1;
    }

    if n.kind == 66 {                                // while
        let cond: Type = self.type_of(src, n.a, simple_type(41));
        if !is_unknown(cond) && cond.kind != 41 {
            let complained: Int = self.complain_at(src, n.token, "a `while` condition must be a Bool");
        }
        self.loop_depth += 1;
        let body: Int = self.check_block_nodes(src, n.b, return_type);
        self.loop_depth -= 1;
        return 1;
    }

    if n.kind == 67 || n.kind == 68 {                // break, continue
        if self.loop_depth == 0 {
            let complained: Int = self.complain_at(src, n.token,
                        "there is no loop here to leave: `break` and `continue` only mean "
                    + "something inside `while`");
        }
        return 1;
    }

    if n.kind == 69 {                                // region
        if self.region_depth > 0 {
            let complained: Int = self.complain_at(src, n.token,
                        "regions do not nest: the inner one would end while the outer is still "
                    + "open, and one bump pointer cannot serve two marks");
        }
        // A region's name and a variable's name live in one namespace as far as a READER is
        // concerned: `region tx { ... }` under `let tx: Int = 1;` gives one word two meanings, and
        // the reader has to know which is which to know what the block does. Refused rather than
        // shadowed, which is the rule `let` already follows — Burxt does not shadow.
        let region_named: Token = self.tokens[n.token];
        if self.find_binding(src, region_named.start, region_named.length) >= 0 {
            let complained: Int = self.complain_at(src, n.token,
                        "`" + substring(src, region_named.start, region_named.length)
                        + "` is already a variable, so it cannot name a region too — pick a different "
                    + "name.");
        }
        // The NAME, published for the refusals inside. Saved and restored rather than set, so the
        // arm reads the same whether or not regions nest — the refusal above is what makes them
        // not, and a rule and the state it relies on should not have to be read together to be
        // sure of either.
        let outer_region: Int = self.region_token;
        self.region_token = n.token;
        self.region_depth += 1;
        let body: Int = self.check_block_nodes(src, n.a, return_type);
        self.region_depth -= 1;
        self.region_token = outer_region;
        return 1;
    }

    if n.kind == 71 {                                // match
        let value: Type = self.type_of(src, n.a, unknown_type());
        let mutable enum_decl: Int = -1;
        if value.kind == 46 {
            let declared: Int = self.find_type(src, value.name_start, value.name_length);
            if declared >= 0 {
                if self.types[declared].kind == 83 { enum_decl = declared; }
            }
        }
        // A SCALAR match — on an Int, a String or a Bool. A different set of rules, and they are the
        // OPPOSITE of the enum ones on purpose: an enum match refuses `_` because listing every
        // variant is the point, and a scalar match REQUIRES it because `Int` cannot be enumerated and
        // a match without a catch-all would be a hole with no error to mark it. Both messages say
        // which rule they are, because two rules for one keyword that differ will otherwise read as
        // arbitrary.
        if value.kind == 40 || value.kind == 41 || value.kind == 42 {
            let checked: Int = self.check_scalar_match(src, n, value, return_type);
            return 1;
        }
        if !is_unknown(value) && enum_decl < 0 {
            let complained: Int = self.complain_at(src, n.token,
                        "`match` chooses between an enum's variants or a scalar, and "
                    + self.show_type(src, value) + " is neither. Use `if` to branch on anything else");
        }
        if enum_decl >= 0 {
            // `_` on an ENUM match, said as itself. The parser accepts `_` as an arm pattern now
            // (a scalar match requires one), so an enum match with a wildcard reaches here — and
            // without this it was reported as "no arm for `Stop`", which names a symptom and sends
            // the reader to add a variant they already handled. The rule being broken is the
            // wildcard, so the message is about the wildcard.
            let mutable w: Int = 0;
            while w < n.c {
                let arm: Node = self.nodes[self.children[n.b + w]];
                let pattern: Token = self.tokens[arm.token];
                if span_equal(src, pattern.start, pattern.length, "_") {
                    let complained: Int = self.complain_at(src, arm.token,
                                "Burxt has no `_` wildcard arm on an enum: it would silently absorb "
                                + "variants added later, which is the one thing exhaustive matching exists "
                            + "to prevent. List the remaining variants");
                }
                w += 1;
            }
            // Every variant needs an arm, and no variant twice: exhaustiveness is what
            // makes a match an answer rather than a guess, and there is no `_` to hide
            // behind. Both questions are the same walk.
            let decl: Node = self.nodes[self.types[enum_decl].node];
            let mutable v: Int = 0;
            while v < decl.b {
                let variant: Node = self.nodes[self.children[decl.a + v]];
                let named: Token = self.tokens[variant.token];
                let mutable seen: Int = 0;
                let mutable a: Int = 0;
                while a < n.c {
                    let arm: Node = self.nodes[self.children[n.b + a]];
                    let arm_name: Token = self.tokens[arm.token];
                    if spans_equal(src, arm_name.start, arm_name.length,
                            named.start, named.length) {
                        seen += 1;
                    }
                    a += 1;
                }
                if seen == 0 {
                    let complained: Int = self.complain_at(src, n.token,
                                "this match has no arm for `"
                            + substring(src, named.start, named.length) + "`");
                }
                if seen > 1 {
                    let complained: Int = self.complain_at(src, n.token,
                                "`" + substring(src, named.start, named.length)
                            + "` has more than one arm, and only the first could ever run");
                }
                v += 1;
            }
        }
        let mutable i: Int = 0;
        while i < n.c {
            let arm: Node = self.nodes[self.children[n.b + i]];
            // The arm's bindings take the variant's payload types, and leave scope
            // with the arm — which is what `truncate` is for.
            let base: Int = len(self.bindings);
            let bound: Int = self.bind_arm(src, value, arm);
            // B27: a payload name aliases the subject's cells, so it is region storage when the
            // subject is — `match wrap(1) { ... }` included, where the subject is a call and never
            // had a name of its own. `n.a` is the subject, typed at the top of this arm.
            let tainted: Int = self.taint_aliased_bindings(src, base, n.a);
            // The payload names point into the subject's cells, so they RELAY whatever it relays.
            // Without this a `return Maybe.Just(s)` out of a `match` on a parameter records no
            // relay, and the release then frees storage the caller still holds.
            let aliased: Int = self.record_relay_aliases(base, n.a);
            let body: Int = self.check_block_nodes(src, arm.a, return_type);
            let unaliased: Int = self.drop_relay_aliases(base);
            let dropped: Int = truncate(self.bindings, base);
            i += 1;
        }
        return 1;
    }

    return 0;
}

// A `match` on an Int, a String or a Bool.
//
// The arms are literals and a `_`, and every rule here is the mirror of the enum ones. `_` is
// REQUIRED and must be LAST — an arm after it could never run, and silently unreachable code is
// exactly what a reviewer should not have to spot.
//
// Equality is the ordinary one: no coercion, so an Int literal does not match a String subject. That
// is not a special rule for `match`, it is the one rule `==` follows everywhere, which is why it
// needed no new machinery.
function (mutable self: Unit) check_scalar_match(src: String, n: Node, value: Type,
        return_type: Type) -> Int {
    let mutable wildcards: Int = 0;
    let mutable i: Int = 0;
    while i < n.c {
        let arm: Node = self.nodes[self.children[n.b + i]];
        let pattern: Token = self.tokens[arm.token];
        let is_wildcard: Bool = pattern.kind == 1
                && span_equal(src, pattern.start, pattern.length, "_");
        if arm.c > 0 {
            let complained: Int = self.complain_at(src, arm.token,
                    "a literal carries nothing to name — payload names belong to an enum variant");
        }
        if is_wildcard {
            wildcards += 1;
            if wildcards > 1 {
                let complained: Int = self.complain_at(src, arm.token,
                        "this `match` has two `_` arms");
            }
        } else {
            if wildcards > 0 {
                let complained: Int = self.complain_at(src, arm.token,
                        "this arm comes after the `_` arm, so it could never run. Put `_` last");
            }
            // The literal's type, from the token the parser left. A name that is not `_` is a
            // variant name, which a scalar match cannot have.
            let mutable literal: Int = 0;
            if pattern.kind == 2 { literal = 40; }
            if pattern.kind == 4 { literal = 42; }
            if pattern.kind == 120 || pattern.kind == 121 { literal = 41; }
            if literal == 0 {
                let complained: Int = self.complain_at(src, arm.token,
                            "this `match` is on " + self.show_type(src, value) + ", so `"
                            + substring(src, pattern.start, pattern.length)
                            + "` is not a pattern it can have — a scalar match takes literals and `_`, "
                        + "not variant names");
            } else {
                // An Int literal against a Decimal subject is the one crossing allowed, the same way
                // `price * 3` is: an Int is exact at any scale.
                let mutable fits: Bool = literal == value.kind;
                if value.kind == 45 && literal == 40 {
                    fits = true;
                }
                if !fits {
                    let complained: Int = self.complain_at(src, arm.token,
                                "this `match` is on " + self.show_type(src, value) + ", but `"
                                + substring(src, pattern.start, pattern.length) + "` is "
                                + self.show_type(src, simple_type(literal))
                            + ". There is one equality in Burxt and it never converts");
                }
                // No literal twice, for the same reason no variant may have two arms: only the
                // first could ever run, and the second is a claim the reader would trust.
                let mutable k: Int = 0;
                while k < i {
                    let earlier: Node = self.nodes[self.children[n.b + k]];
                    let seen: Token = self.tokens[earlier.token];
                    if spans_equal(src, seen.start, seen.length, pattern.start, pattern.length) {
                        let complained: Int = self.complain_at(src, arm.token,
                                    "`" + substring(src, pattern.start, pattern.length)
                                + "` is matched twice in this `match`");
                    }
                    k += 1;
                }
            }
        }
        let body: Int = self.check_block_nodes(src, arm.a, return_type);
        i += 1;
    }
    if wildcards == 0 {
        let complained: Int = self.complain_at(src, n.token,
                    "this `match` on " + self.show_type(src, value) + " has no `_` arm. A scalar cannot be "
                    + "enumerated, so a match without a catch-all would leave values with nowhere to go — "
                    + "which is the opposite of an enum match, where `_` is refused because listing every "
                + "variant is the point");
    }
    return 1;
}

// ---- B25: growth THROUGH a `mutable` parameter -------------------------------------------------
//
// `region r { grow(xs, 11); }` where `grow(mutable dst: [Int], v: Int) { push(dst, v); }` is B20 one
// call away, and it was silent in stage-1 while stage-0 refused it. The receiver check sees a CALL,
// not a `push` on `xs`, so the growth is invisible where the binding is known and the binding is
// invisible where the growth is.
//
// **A `mutable` parameter is a hole in every rule that reasons about where a value is built, and
// there are two such rules.** B22/B23 was that hole in `allocates nothing`; this is the same hole in
// the escape rule. Both are closed by the same move — credit the OWNER of the storage, not the
// syntax in front of you — and both need the fixpoint because the credit travels along calls.
//
// This is the recording half: "something grew the current body's parameter N", written where the
// growth is. The refusal is at the call site, which is the only place that knows whose binding
// parameter N received.
function (mutable self: Unit) record_parameter_growth(src: String, root_start: Int,
        root_length: Int) -> Int {
    // Only a probe round records. The real pass reads what the rounds settled, exactly as it reads
    // the `allocates` bits, so the answer cannot depend on how far the real pass has got.
    if self.probing == 0 {
        return 0;
    }
    if self.current_method >= 0 {
        // A method, and the only thing tracked here is its own `mutable self`. An ordinary
        // `mutable` parameter of a method is NOT tracked — stage-0 does not track it either, and
        // this mirrors that rather than improving on it, because the two compilers refusing
        // different programs is the one failure the differential exists to catch. Recorded as a
        // known hole in BOTH: `function (self: Bag) fill(mutable dst: [Int])` growing `dst` is the
        // spelling neither compiler credits.
        if span_equal(src, root_start, root_length, "self") {
            if self.methods[self.current_method].mutating == 1 {
                let noted: Int = self.note_grow_self(self.current_method);
            }
        }
        return 0;
    }
    if self.current_function < 0 {
        return 0;                                    // the top level owns its storage
    }
    let owner: DeclaredFunction = self.functions[self.current_function];
    let params: Node = self.nodes[owner.parameters];
    let mutable i: Int = 0;
    while i < params.b {
        let param: Node = self.nodes[self.children[params.a + i]];
        let named: Token = self.tokens[param.token];
        // `b` is the `mutable` flag. Only a `mutable` parameter can carry a change back to the
        // caller, so only one of those is worth recording — an ordinary parameter is a copy, and
        // growing a copy reaches nobody.
        if param.b == 1 && spans_equal(src, named.start, named.length, root_start, root_length) {
            let noted: Int = self.note_grow_parameter(self.current_function, i);
            return 1;
        }
        i += 1;
    }
    return 0;
}

// Both notes count into `probe_changes`, which is what makes the ordinary `allocates` fixpoint
// converge on these too: the sets only ever grow, over a finite number of (function, parameter)
// pairs, so a round that adds nothing new is a round that ends the loop.
function (mutable self: Unit) note_grow_parameter(owner: Int, parameter: Int) -> Int {
    if self.grows_parameter(owner, parameter) {
        return 0;
    }
    push(self.grow_parameters, ParameterGrowth { owner: owner, parameter: parameter });
    self.probe_changes += 1;
    return 1;
}

function (mutable self: Unit) note_grow_self(method: Int) -> Int {
    if self.grows_self(method) {
        return 0;
    }
    push(self.grow_self, method);
    self.probe_changes += 1;
    return 1;
}

function (self: Unit) grows_parameter(owner: Int, parameter: Int) -> Bool {
    for known in self.grow_parameters {
        if known.owner == owner && known.parameter == parameter {
            return true;
        }
    }
    return false;
}

function (self: Unit) grows_self(method: Int) -> Bool {
    for known in self.grow_self {
        if known == method {
            return true;
        }
    }
    return false;
}

// ---- B32: the RELAY property, and why it is a fourth property rather than a seventh arm --------
//
// Six arms went into `expr_allocates` in two days — an interpolated string, a dyn call, a `?`, a
// field read, an element read, three builtins — and each was correct. This one cannot be an arm,
// and the reason is worth stating precisely: an arm answers *"does evaluating this expression
// allocate"*, and `pass(built)` **does not allocate**. It hands back storage that was already
// built. The rules were asking about ALLOCATION when the fact they need is ALIASING — does this
// value point into the region, however it got there — and no number of allocation arms reaches a
// function whose whole job is to allocate nothing.
//
// So: which parameters may a function's return value point at. The callee's body records it,
// because that is where the `return` is; the CALL SITE turns "parameter 0 is relayed" into "this
// argument's taint is now the result's taint", because only the caller knows what it passed. The
// same division of labour as `record_parameter_growth`, and the same reason it needs the fixpoint:
// a relay through a relay is only visible once the inner one is known.
//
// **What it is NOT:** a flat "this function is dangerous". `substring(s, 0, 3)` builds a fresh
// String out of `s` and relays nothing, so `kept = substring(built, 0, 3)` keeps working — it is
// refused, but by the arm that already refused it, for allocating. `to_string(x)` likewise. The
// property is only ever recorded when a `return` walks down to a parameter through links that
// share storage, so a function that COPIES is untouched.
// Does this function hand back storage that arrived as a PARAMETER, through any of them?
//
// **The identity case, and the reason the escape rule needed a second question.** The rule refuses
// returning region data unless the function allocates — because an allocation goes into the
// CALLER's region and so outlives the call. That argument is right and it is not the only way for
// storage to belong to the caller: a parameter's storage is the caller's already, by construction,
// with nothing allocated at all.
//
// Asking only about allocation made the rule a PROXY, and it was measurably wrong both ways.
// `f(xs) -> [Int] { return xs; }` was refused, while the same function with a junk allocation the
// answer never touches was accepted — so the check was satisfied by a line unrelated to what came
// back, and deleting the dead line broke the build.
//
// Nothing new is inferred. `relay_parameters` has held exactly this since B32, per index; the
// index is what the call-site taint rules need and what this one does not.
function (self: Unit) relays_any_parameter(owner: Int) -> Bool {
    for known in self.relay_parameters {
        if known.owner == owner {
            return true;
        }
    }
    return false;
}

function (self: Unit) relays_parameter(owner: Int, parameter: Int) -> Bool {
    for known in self.relay_parameters {
        if known.owner == owner && known.parameter == parameter {
            return true;
        }
    }
    return false;
}

function (self: Unit) relays_self(method: Int) -> Bool {
    for known in self.relay_self {
        if known == method {
            return true;
        }
    }
    return false;
}

function (self: Unit) relays_method_parameter(method: Int, parameter: Int) -> Bool {
    for known in self.relay_method_parameters {
        if known.owner == method && known.parameter == parameter {
            return true;
        }
    }
    return false;
}

// Both notes count into `probe_changes`, so the fourth property converges in `infer_allocates`'s
// existing rounds rather than in a loop of its own. Two loops over one call graph would have to
// agree about when to stop, which is the argument the B25 note above already makes.
function (mutable self: Unit) note_relay_parameter(owner: Int, parameter: Int) -> Int {
    if self.relays_parameter(owner, parameter) {
        return 0;
    }
    push(self.relay_parameters, ParameterGrowth { owner: owner, parameter: parameter });
    self.probe_changes += 1;
    return 1;
}

// Record that every binding added since `base` carries whatever `subject` carries.
//
// Called where a construct introduces names bound to storage it did not create — a `match` arm's
// payloads, a `let`. The SUBJECT NODE is stored rather than a resolved source, so `note_relay_root`
// recurses on it and the one walk answers for both. A second copy of source resolution is how the
// two halves of a rule come apart.
function (mutable self: Unit) record_relay_aliases(base: Int, subject: Int) -> Int {
    if subject < 0 {
        return 0;
    }
    let mutable i: Int = base;
    while i < len(self.bindings) {
        push(self.relay_aliases, RelayAlias { binding: i, subject: subject });
        i += 1;
    }
    return 1;
}

// Drop the aliases whose binding has left scope. Paired with every `truncate(self.bindings, base)`,
// for the reason `taint_aliased_bindings` gives about the taint it removes: a second arm may bind
// the same name to a payload that relays nothing, and it must not inherit this arm's answer.
function (mutable self: Unit) drop_relay_aliases(base: Int) -> Int {
    let mutable kept: [RelayAlias] = [];
    for alias in self.relay_aliases {
        if alias.binding < base {
            let added: Int = push(kept, alias);
        }
    }
    self.relay_aliases = kept;
    return 1;
}

// The binding for this name that existed BEFORE `ceiling`, or -1.
//
// **The ceiling is what makes the alias walk terminate.** An alias's subject was evaluated before
// its binding existed, so a name inside that subject can only mean an EARLIER binding. Without the
// bound, a `let` that shadows a name — `let text: String = substring(text, 0, 3)` over a parameter
// called `text` — resolves the inner `text` to the binding just pushed, whose subject contains
// `text`, and the walk never ends. It showed up as stage-1 exhausting its stack on four library
// fixtures rather than as a wrong answer, which is the good direction for it to fail in.
function (self: Unit) find_binding_below(src: String, start: Int, length: Int, ceiling: Int) -> Int {
    let mutable i: Int = ceiling - 1;
    while i >= 0 {
        let candidate: Binding = self.bindings[i];
        if spans_equal(src, candidate.start, candidate.length, start, length) {
            return i;
        }
        i -= 1;
    }
    return 0 - 1;
}

// What this bound name carries, if anything — the subject it was bound from.
function (self: Unit) relay_alias_subject(binding: Int) -> Int {
    for alias in self.relay_aliases {
        if alias.binding == binding {
            return alias.subject;
        }
    }
    return 0 - 1;
}

function (mutable self: Unit) note_relay_self(method: Int) -> Int {
    if self.relays_self(method) {
        return 0;
    }
    push(self.relay_self, method);
    self.probe_changes += 1;
    return 1;
}

function (mutable self: Unit) note_relay_method_parameter(method: Int, parameter: Int) -> Int {
    if self.relays_method_parameter(method, parameter) {
        return 0;
    }
    push(self.relay_method_parameters, ParameterGrowth { owner: method, parameter: parameter });
    self.probe_changes += 1;
    return 1;
}

// The recording half: walk a returned expression down to whatever storage it points AT, and if
// that turns out to be a parameter of the body being walked, say so.
//
// The links walked are exactly the ones that SHARE storage rather than copy it, and they are the
// same set `expr_allocates` recurses through for the same reason: a field read, an element read
// and `?` all hand back a pointer into cells something else owns. `+` is absent, and its absence
// is the whole guarantee against over-refusal — `return "seen: " + s` builds a new String and
// relays nothing, so a function that formats its argument is not a relay.
//
// A call is walked through the property being computed, which is what makes it transitive:
// `return pass(s)` reaches `s` only once `pass` is known to relay parameter 0, one round later.
//
// Aggregate LITERALS are deliberately absent — `return Box { name: s }` does hand back a record
// pointing at `s`, and it is a real hole, left open because closing it here would credit the
// parameter for a record the caller may only ever read scalars out of, and B36 records what
// type-blindness in this family already costs. Named rather than fixed, so the next reader does
// not have to rediscover it.
function (mutable self: Unit) record_return_relay(src: String, node: Int) -> Int {
    // Only a probe round records, exactly as `record_parameter_growth` does: the real pass reads
    // what the rounds settled, so an answer cannot depend on how far the real pass has got.
    if self.probing == 0 {
        return 0;
    }
    // ---- What is handed back has to be a POINTER for any of this to matter --------------------
    //
    // A value that is copied into the caller's cell cannot dangle, so relaying one is not an
    // escape: `function count_of(p: Pair) -> Int { return p.n; }` hands back seven, not a pointer
    // into `p`. Everything excluded here is one i64 cell — `emit.bx`'s layout note says it in one
    // line, *"a Decimal is a scaled i64"* — so the list is a fact about the representation rather
    // than a guess.
    //
    // **This test is why the property adds no false refusals, and it was found by probing rather
    // than by reading.** Without it, `total = count_of(p)` inside a region was refused for an Int
    // that could not dangle: measured, on three shapes — an Int field, an Int element, a Bool
    // field — all three accepted by stage-0 and by stage-1 before this change.
    //
    // It does NOT narrow B36. `total = p.n` written out directly is still refused by both
    // compilers, because that is the field/element ARM being type-blind and B36 says to narrow
    // that in both or neither. The two are different mechanisms and this one is simply declining
    // to widen the other: B36's arm stays exactly as wide as it is today.
    //
    // Kind 50 is a type PARAMETER and deliberately records. `identity<T>(x: T) -> T` is not known
    // to hand back a scalar, and a generic identity relay is one of the shapes that has to stay
    // caught — `L6` in the audit corpus. Kind 0 is unknown and records for the same reason.
    let handed: Type = self.type_at(node);
    if handed.kind == 40 || handed.kind == 41 || handed.kind == 43 || handed.kind == 44
            || handed.kind == 45 || handed.kind == 51 || handed.kind == 52 {
        return 0;                                    // Int, Bool, CInt, CDouble, Decimal, CPointer
    }
    // The alias walk starts able to see every binding in scope, and lowers the ceiling as it
    // follows one — see `find_binding_below` for why it has to decrease.
    self.relay_ceiling = len(self.bindings);
    return self.note_relay_root(src, node);
}

function (mutable self: Unit) note_relay_root(src: String, node: Int) -> Int {
    if node < 0 {
        return 0;
    }
    let n: Node = self.nodes[node];
    if n.kind == 5 {                                 // a bare name: the root of the chain
        let named: Token = self.tokens[n.token];
        if self.current_method >= 0 {
            // A method's receiver. NOT gated on `mutable self`, and that is the difference from
            // `note_grow_self`: growing a receiver needs permission to write it, and reading a
            // field off one does not. `function (self: Box) name_of() -> String { return
            // self.name; }` is a plain shared receiver and it relays.
            if span_equal(src, named.start, named.length, "self") {
                return self.note_relay_self(self.current_method);
            }
            // A method's ORDINARY parameters, and they are tracked — unlike growth, where
            // `record_parameter_growth` skips them to mirror a hole stage-0 has.
            //
            // **This arm was missing and it was a live use-after-free**, found by probing rather
            // than by the corpus, which has no program of this shape:
            //
            //     function (self: Bag) take(x: String) -> String { return x; }
            //     region r { kept = bag.take("secret-" + "value"); }   // prints secret-value, then 0
            //
            // The reason growth can skip these and relaying cannot is worth stating rather than
            // leaving as an inconsistency: growth needs permission to WRITE through the parameter,
            // so only a `mutable` one can carry anything back, and stage-0 declines to track those.
            // Relaying needs nothing but the pointer, which every parameter has.
            let holder: Method = self.methods[self.current_method];
            let mparams: Node = self.nodes[holder.parameters];
            let mutable mi: Int = 0;
            while mi < mparams.b {
                let mparam: Node = self.nodes[self.children[mparams.a + mi]];
                let mname: Token = self.tokens[mparam.token];
                if spans_equal(src, mname.start, mname.length, named.start, named.length) {
                    return self.note_relay_method_parameter(self.current_method, mi);
                }
                mi += 1;
            }
            return 0;
        }
        if self.current_function < 0 {
            return 0;                                // the top level returns nothing
        }
        let owner: DeclaredFunction = self.functions[self.current_function];
        let params: Node = self.nodes[owner.parameters];
        let mutable i: Int = 0;
        while i < params.b {
            let param: Node = self.nodes[self.children[params.a + i]];
            let pname: Token = self.tokens[param.token];
            // No `mutable` test here, unlike growth: a parameter is a copy of a POINTER, so
            // handing the pointer back reaches the caller's storage whether or not the callee was
            // allowed to write through it.
            if spans_equal(src, pname.start, pname.length, named.start, named.length) {
                return self.note_relay_parameter(self.current_function, i);
            }
            i += 1;
        }
        // Not a parameter. It may still be a name BOUND to storage that came from one — a `match`
        // payload or a `let` — in which case it relays whatever that subject relays. Recursing on
        // the stored node reuses this walk instead of resolving sources a second way.
        let found: Int = self.find_binding_below(src, named.start, named.length, self.relay_ceiling);
        if found >= 0 {
            let subject: Int = self.relay_alias_subject(found);
            if subject >= 0 {
                // The ceiling drops to this binding for the walk of its subject, and is restored
                // after. Strictly decreasing, so the recursion is bounded by the number of
                // bindings in scope.
                let outer: Int = self.relay_ceiling;
                self.relay_ceiling = found;
                let carried: Int = self.note_relay_root(src, subject);
                self.relay_ceiling = outer;
                return carried;
            }
        }
        return 0;
    }
    if n.kind == 11 || n.kind == 22 {
        return self.note_relay_root(src, n.a);       // a field, a `?` payload
    }
    if n.kind == 12 {                                // an element: the base AND the index
        // The index is walked because stage-0 walks it, and the two compilers agreeing matters
        // more here than the one case being reachable. It is inert in practice — an index is an
        // Int, so it cannot be region storage — but "inert in practice" is the reasoning that put
        // `sdiv` on arm64 in B18, and mirroring costs one line.
        let base: Int = self.note_relay_root(src, n.a);
        return base + self.note_relay_root(src, n.b);
    }
    // ---- An aggregate built HERE is fresh; what it HOLDS is not ------------------------------
    //
    // `return Box { name: s }` hands the caller a record whose field points at `s`'s bytes. The
    // record is new, so `expr_allocates` was right that nothing of the CALLER's was allocated —
    // and the pointer inside it is the caller's problem all the same. Proven, both compilers
    // accepted it before this arm and it printed `secret-value` and then `0`.
    //
    // This is the array-literal and class-literal pair that `expr_allocates` already walks two
    // files over, asked in the opposite direction: that one asks whether a child was BUILT, this
    // one asks whether a child was GIVEN. A form is in exactly one of the two.
    if n.kind == 17 {                                // an array literal: children ARE the values
        let mutable noted: Int = 0;
        let mutable i: Int = 0;
        while i < n.b {
            noted += self.note_relay_root(src, self.children[n.a + i]);
            i += 1;
        }
        return noted;
    }
    if n.kind == 19 {                                // a class literal: children are field PAIRS
        let mutable noted: Int = 0;
        let mutable i: Int = 0;
        while i < n.b {
            let pair: Node = self.nodes[self.children[n.a + i]];
            noted += self.note_relay_root(src, pair.a);
            i += 1;
        }
        return noted;
    }
    if n.kind == 13 {                                // a call: transitive through the property
        let name: Token = self.tokens[n.token];
        let callee: Int = self.find_function(src, name.start, name.length);
        if callee < 0 {
            // Not a declared function, so either a builtin or nothing this compiler knows.
            //
            // A BUILTIN relays nothing: `substring` and `to_string` build fresh storage, which is
            // the same list `expr_allocates` keeps and the reason that one answers `true` for them
            // where this one answers nothing.
            //
            // The walk below mirrors `expr_allocates`'s enum-constructor fallthrough, and **it is
            // unreachable for enums, measured**: `return Some(s)` does not parse — `unknown
            // function` — because a variant is always written `Wrapped.Some(s)`, which is a
            // METHOD-CALL node and is handled in the kind 14 arm below. It is kept for the shape
            // rather than the catch, and said to be unexercised rather than left looking load-
            // bearing, so nobody reads it as covering a case the kind 14 arm is actually covering.
            if builtin_arity(substring(src, name.start, name.length)) >= 0 {
                return 0;
            }
            let payload: Node = self.nodes[n.a];
            let mutable carried: Int = 0;
            let mutable p: Int = 0;
            while p < payload.b {
                carried += self.note_relay_root(src, self.children[payload.a + p]);
                p += 1;
            }
            return carried;
        }
        let list: Node = self.nodes[n.a];
        let mutable noted: Int = 0;
        let mutable i: Int = 0;
        while i < list.b {
            if self.relays_parameter(callee, i) {
                noted += self.note_relay_root(src, self.children[list.a + i]);
            }
            i += 1;
        }
        return noted;
    }
    if n.kind == 14 {                                // a method call
        // `Enum.Variant(payload)` is a method-call node too — the base is a type name rather than
        // a value — and a variant carries its payload. Told apart the way `expr_allocates` tells
        // it apart: a bare name that resolves to an enum declaration.
        let base: Node = self.nodes[n.a];
        if base.kind == 5 {
            let base_name: Token = self.tokens[base.token];
            let declared: Int = self.find_type(src, base_name.start, base_name.length);
            if declared >= 0 && self.types[declared].kind == 83 {
                let payload: Node = self.nodes[n.b];
                let mutable carried: Int = 0;
                let mutable p: Int = 0;
                while p < payload.b {
                    carried += self.note_relay_root(src, self.children[payload.a + p]);
                    p += 1;
                }
                return carried;
            }
        }
        let holder: Type = self.type_at(n.a);
        // A call through a `dynamic`: the interface names no body, so the answer is whether ANY
        // implementation relays — the same shape `any_implementation_allocates` already has for
        // allocation, and stage-0's `dyn_call_relays`.
        if holder.kind == 49 {
            let mutable noted: Int = 0;
            if self.any_implementation_relays_self(src, holder, self.tokens[n.token]) {
                noted += self.note_relay_root(src, n.a);
            }
            let list: Node = self.nodes[n.b];
            let mutable i: Int = 0;
            while i < list.b {
                if self.any_implementation_relays_parameter(src, holder,
                        self.tokens[n.token], i) {
                    noted += self.note_relay_root(src, self.children[list.a + i]);
                }
                i += 1;
            }
            return noted;
        }
        let found: Int = self.find_method(src, holder, n.token);
        if found < 0 {
            return 0;
        }
        let mutable noted: Int = 0;
        if self.relays_self(found) {
            noted += self.note_relay_root(src, n.a);
        }
        let list: Node = self.nodes[n.b];
        let mutable i: Int = 0;
        while i < list.b {
            if self.relays_method_parameter(found, i) {
                noted += self.note_relay_root(src, self.children[list.a + i]);
            }
            i += 1;
        }
        return noted;
    }
    return 0;
}

// B25's refusal: B20's sentence with the CALL named as the cause instead of `push`, because the call
// is what the reader is looking at — the growth is in a body somewhere else. Word for word stage-0's
// `growing_an_outer_binding`.
function (self: Unit) growing_an_outer_binding(src: String, named: String,
        callee: String) -> String {
    return "`" + named + "` was declared outside " + self.open_region(src)
            + ", so it cannot grow inside it — `" + callee + "` grows it, and the bytes are released "
            + "at the closing brace, leaving `" + named + "` reading whatever the region hands out "
            + "next. Declare `" + named + "` inside the region, or grow it outside it.";
}

// The argument half: for each `mutable` parameter the callee GROWS, the growth belongs to whatever
// the caller passed. Recorded first, then refused — the record is the link that makes the fixpoint
// transitive, and a body that gets refused must still be classed, because a probe round discards
// errors and carries on.
//
// Only free functions. A method's ordinary `mutable` parameters are not tracked; see the note in
// `record_parameter_growth`.
function (mutable self: Unit) check_growing_arguments(src: String, at: Int, list_node: Int,
        params_node: Int, callee: Int) -> Int {
    let list: Node = self.nodes[list_node];
    let params: Node = self.nodes[params_node];
    if list.b != params.b {
        return 0;                                    // already refused, and the pairing is broken
    }
    let mutable i: Int = 0;
    while i < params.b {
        let param: Node = self.nodes[self.children[params.a + i]];
        if param.b == 1 && self.grows_parameter(callee, i) {
            let place: Int = self.lvalue_root(self.children[list.a + i]);
            if place >= 0 {
                let root: Token = self.tokens[self.nodes[place].token];
                let passed: Int = self.record_parameter_growth(src, root.start, root.length);
                if self.region_depth > 0 {
                    let owner: Int = self.find_binding(src, root.start, root.length);
                    if owner >= 0 && self.bindings[owner].in_region == 0 {
                        let complained: Int = self.complain_at(src, at,
                                    self.growing_an_outer_binding(src,
                                        substring(src, root.start, root.length),
                                        substring(src, self.functions[callee].start,
                                self.functions[callee].length) + "(...)"));
                    }
                }
            }
        }
        i += 1;
    }
    return 1;
}

// ---- B23: `allocates nothing`, and saying WHY -------------------------------------------------
//
// A few words for the thing that allocates, or "" when it cannot be named simply.
//
// Whether the claim is broken is decided by `infer_allocates` and by nothing here — this only puts
// a name to the first cause, so a refusal is a fix rather than a search. Best effort by design: a
// body this cannot describe is still refused, with the shorter sentence.
//
// Word for word stage-0's `describe_allocation`, arm for arm, because the .stderr fixtures pin one
// text and two compilers must produce it.
function (mutable self: Unit) describe_allocation(src: String, node: Int) -> String {
    if node < 0 {
        return "";
    }
    let n: Node = self.nodes[node];
    // The `dynamic` arm comes BEFORE the `expr_allocates` guard, for stage-0's reason at the same
    // place: the inference reaches a dyn call through `has_region()` being asked at the call site,
    // not through `expr_allocates`, which has no arm for it and would answer false — losing the one
    // path that is hardest to find by reading.
    if n.kind == 14 {
        let holder: Type = self.type_at(n.a);
        if holder.kind == 49 {
            let method: Token = self.tokens[n.token];
            return "`." + substring(src, method.start, method.length)
                    + "(...)` through a `dynamic "
                    + substring(src, holder.name_start, holder.name_length)
                    + "` allocates — and the claim has to hold for EVERY implementation, so one that "
                    + "allocates is enough to break it";
        }
    }
    // `push` before the guard too, and for the same kind of reason: stage-1's `expr_allocates`
    // answers false for a `push` call, because a builtin's answer is decided by the builtin and
    // `push` answers an Int. It is credited through `has_region()` at the call site instead — see
    // B22 in parser.bx — so asking the guard first would leave the commonest cause unnamed.
    if n.kind == 13 {
        let called: Token = self.tokens[n.token];
        if span_equal(src, called.start, called.length, "push") {
            return "`push(...)` may grow the array";
        }
    }
    if !self.expr_allocates(src, node) {
        return "";
    }
    if n.kind == 8 {
        if n.value == 25 && self.type_at(n.a).kind == 42 {
            return "joining two Strings builds a new one";
        }
    }
    // An INTERPOLATED String — node kind 18 — is a join, and stage-0 says so because it lowers one
    // into `+` before anything describes it. Stage-1 keeps it whole, so without this arm the two
    // compilers refused the same program and gave different reasons: measured on `"${n}"`,
    // `"a${n}"`, `"${n}${n}"` and `"${n}b"`, stage-0 says "joining two Strings builds a new one"
    // for all four and stage-1 said nothing at all. The same sentence, because it is the same fact
    // about the same program — the difference was only where each compiler was standing.
    //
    // Chasing this wording is what found the missing `expr_allocates` arm for kind 18, which was a
    // use-after-free rather than a message. Worth recording: the reason text is a READOUT of the
    // inference, so the two compilers disagreeing about a reason is evidence about the rule.
    if n.kind == 18 {
        return "joining two Strings builds a new one";
    }
    if n.kind == 13 {
        let called: Token = self.tokens[n.token];
        let name: String = substring(src, called.start, called.length);
        if name == "substring" { return "`substring(...)` builds a new String"; }
        if name == "byte_as_string" { return "`byte_as_string(...)` builds a one-byte String"; }
        if name == "to_string" { return "`to_string(...)` builds a String"; }
        if name == "read_file" { return "`read_file(...)` builds a String"; }
        if name == "c_string_at" { return "`c_string_at(...)` copies C's bytes into a String"; }
        if name == "c_bytes_at" { return "`c_bytes_at(...)` copies C's bytes into an array"; }
        if name == "c_bytes_to" { return "`c_bytes_to(...)` writes bytes into C's memory"; }
        if builtin_arity(name) >= 0 { return ""; }
        return "`" + name + "(...)` builds its answer in the caller's region";
    }
    if n.kind == 14 {
        let receiver: Node = self.nodes[n.a];
        let method: Token = self.tokens[n.token];
        if receiver.kind == 5 {
            let base: Token = self.tokens[receiver.token];
            return "`" + substring(src, base.start, base.length) + "."
                    + substring(src, method.start, method.length)
                    + "(...)` builds its answer in the caller's region";
        }
        return "";
    }
    if n.kind == 17 {
        return "a growable array is built here";
    }
    return "";
}

// The first nameable allocation in a block, in source order, or "".
function (mutable self: Unit) first_allocation(src: String, block: Int) -> String {
    if block < 0 {
        return "";
    }
    let b: Node = self.nodes[block];
    // An `else if` puts a statement where a block usually goes, exactly as `block_exits` allows,
    // so a branch is asked the same question either way.
    if b.kind != 16 {
        return self.first_allocation_in(src, block);
    }
    let mutable i: Int = 0;
    while i < b.b {
        let found: String = self.first_allocation_in(src, self.children[b.a + i]);
        if found != "" {
            return found;
        }
        i += 1;
    }
    return "";
}

function (mutable self: Unit) first_allocation_in(src: String, node: Int) -> String {
    if node < 0 {
        return "";
    }
    let n: Node = self.nodes[node];
    // The statements that carry one value: `let`, an assignment, `print`, `return`, and a bare
    // expression. Stage-0's arm list, with stage-1's kind numbers.
    if n.kind == 60 || n.kind == 61 {
        return self.describe_allocation(src, n.b);
    }
    if n.kind == 62 || n.kind == 63 || n.kind == 70 {
        return self.describe_allocation(src, n.a);
    }
    if n.kind == 65 {                                // if: the condition, then both branches
        let cond: String = self.describe_allocation(src, n.a);
        if cond != "" {
            return cond;
        }
        let taken: String = self.first_allocation(src, n.b);
        if taken != "" {
            return taken;
        }
        return self.first_allocation(src, n.c);
    }
    // `while`, `for` and `for` over a range: the body. A range's BOUNDS cannot allocate — both are
    // Ints — and stage-0 does not walk a `for`'s iterable either.
    if n.kind == 66 || n.kind == 72 || n.kind == 74 {
        return self.first_allocation(src, n.b);
    }
    if n.kind == 69 {                                // region: the body is in `a`
        return self.first_allocation(src, n.a);
    }
    if n.kind == 71 {                                // match: every arm, in order
        let mutable i: Int = 0;
        while i < n.c {
            let arm: Node = self.nodes[self.children[n.b + i]];
            let found: String = self.first_allocation(src, arm.a);
            if found != "" {
                return found;
            }
            i += 1;
        }
        return "";
    }
    return "";
}

// ---- the pass ----------------------------------------------------------------
// A function or method body, with its parameters — and a method's `self` — in scope.
function (mutable self: Unit) check_body(src: String, index: Int) -> Int {
    let item: Node = self.nodes[index];
    let base: Int = len(self.bindings);
    self.depth += 1;
    // A11's half of the depth bookkeeping: everything pushed at THIS depth is a parameter or a
    // receiver, and the body's own block goes one deeper. That is the only way to tell a
    // parameter from a local here, and one sentence needs it — see `writable_advice`.
    let outer_param_depth: Int = self.param_depth;
    self.param_depth = self.depth;
    // The markers are the body's rules: `allocates` means the caller's region is in
    // effect throughout, `pure` means the world is off limits.
    let outer_caller: Int = self.in_caller_region;
    let outer_pure: Int = self.in_pure;
    // From the node's flags for now; corrected below to the STORED signature's flags once
    // this body's owner is known. The stored one is what the probe updates, so reading the
    // node here alone would mean an inferred `allocates` never reached the body it was
    // inferred for — the body would still refuse what the signature now permits.
    self.in_caller_region = flag_allocates(item.value);
    self.in_pure = flag_pure(item.value);
    let signature: Node = self.nodes[item.c];
    // An ASSOCIATED function is stored as a method so the two-span lookup finds it, but it has no
    // receiver clause and therefore no `self` anywhere in its text. Binding one would send
    // `self_token` scanning backwards for a word that was never written, and it would find some
    // earlier method's — a wrong span rather than a refusal, which is the dangerous direction.
    if item.kind == 81 && flag_associated(item.value) == 0 {
        // `self` is a name like any other once it is bound: the receiver's type is
        // written in the clause node, so a method body needs no special rule.
        let receiver: Token = self.tokens[signature.value];
        // Where the word `self` is. Counting back from the receiver's TYPE token stopped
        // working when `function (self) name()` became legal inside an `implement`, because there the
        // type token is the implementation HEADER's and lives far away. The clause always sits
        // immediately before the method's name, in one of three shapes — `(self)`,
        // `(self: T)`, `(mutable self: T)` — so scanning back for it is both shorter and
        // right for all three.
        let self_tok: Int = self.self_token(item.token);
        let word: Token = self.tokens[self_tok];
        // `mutable self` and nothing else. Read with the accessor rather than `>= 4`; see
        // `flag_mutating` for what that magnitude test cost.
        let writable: Int = flag_mutating(item.value);
        push(self.bindings, Binding { start: word.start, length: word.length,
                        bound_type: Type { kind: 46, scale: 0, contract: 0,
                            name_start: receiver.start,
                        name_length: receiver.length },
                        writable: writable, depth: self.depth, in_region: 0,
                holds_region: 0, dyn_owner: 0 - 1 });
    }
    let params: Node = self.nodes[item.a];
    let mutable p: Int = 0;
    while p < params.b {
        let param: Node = self.nodes[self.children[params.a + p]];
        let name: Token = self.tokens[param.token];
        let declared: Type = self.declared_type(src, param.a);
        // `pure` and `mutable` are a contradiction: `pure` promises the answer depends on the
        // arguments and nothing else, which is the same promise as changing nothing. It matters more
        // than it looks — a contract clause may call a `pure` function, so without this a
        // precondition could rewrite the data it was checking.
        if param.b == 1 && flag_pure(item.value) == 1 {
            let complained: Int = self.complain_at(src, param.token,
                        "a `pure function` cannot take a `mutable` parameter: `pure` means the answer "
                        + "depends on the arguments and nothing else, which is the same thing as changing "
                    + "nothing — and `mutable` says this call changes what the caller passed");
        }
        // `b` holds the `mutable` flag the parser read. Only an AGGREGATE may carry it: a scalar is
        // copied when it crosses, so the word could only mean "you get your own copy to change" —
        // a fact about the body rather than the call, and one word meaning two things decided by the
        // type is what this language is arranged against.
        if param.b == 1 && !is_aggregate_type(declared) {
            let complained: Int = self.complain_at(src, param.token,
                        "`mutable " + substring(src, name.start, name.length) + ": "
                        + self.show_type(src, declared) + "` says the caller's value may change, and a "
                        + self.show_type(src, declared) + " is copied when it crosses — so there would be "
                        + "nothing for the caller to see. Take a copy where the copy is: `let mutable own: "
                    + self.show_type(src, declared) + " = ...;`");
        }
        // A parameter may not take a const's name. Without this the parameter would win the
        // name inside one body and the const would be invisible there — a reader's eye goes to
        // the declaration at the top of the file and reads the wrong value, which is the
        // silent-wrongness this language exists to refuse.
        if self.find_const(src, name.start, name.length) >= 0 {
            let complained: Int = self.complain_at(src, param.token,
                        "this name is already declared as a `const`, which is in scope in every "
                    + "function — Burxt does not shadow");
        }
        push(self.bindings, Binding { start: name.start, length: name.length,
                        bound_type: declared, writable: param.b,
                        depth: self.depth, in_region: 0, holds_region: 0,
                dyn_owner: 0 - 1 });
        p += 1;
    }
    let return_type: Type = self.declared_type(src, signature.c);
    // Which generic this is, so a parameter's bound is looked up in its own declaration.
    //
    // For a METHOD the answer is its RECEIVER's declaration, not its own name: `Map<K: Equatable,
    // V>.probe` is an ordinary name, and the bound that justifies `entry.key == key` inside it was
    // written on the class. Looking only at the method's own name found no bound and refused a
    // program that says exactly what it needs — and stage-0 never noticed, because it checks
    // instantiated COPIES where `K` is already String.
    let outer_generic: Int = self.current_generic;
    let named_here: Token = self.tokens[item.token];
    let mutable enclosing: Int = self.generic_named(src, named_here.start, named_here.length);
    if item.kind == 81 && enclosing < 0 {
        let receiver: Token = self.tokens[signature.value];
        enclosing = self.generic_named(src, receiver.start, receiver.length);
    }
    self.current_generic = enclosing;
    // Which declaration this body IS, settled BEFORE the clauses are checked rather than after.
    //
    // It used to be after, and privacy is what exposed the ordering: `requires amount <=
    // self.balance` reads a private field, and while `current_method` was still the previous
    // body's the clause was being checked as though it stood outside the class. A contract is part
    // of the method, so it has to be checked knowing which method it belongs to — the false
    // positive was the honest signal that it was not.
    let outer_fn: Int = self.current_function;
    let outer_method: Int = self.current_method;
    self.current_function = -1;
    self.current_method = -1;
    if item.kind == 80 {
        self.current_function = self.find_function(src, self.tokens[item.token].start,
                self.tokens[item.token].length);
    }
    if item.kind == 81 {
        let receiver_token: Token = self.tokens[signature.value];
        self.current_method = self.find_method_named(src, receiver_token.start,
                    receiver_token.length, self.tokens[item.token].start,
                self.tokens[item.token].length);
    }
    // Now that the owner is known, take `allocates` from the signature the probe updates
    // rather than from the node it was parsed with. See the note above.
    if self.current_function >= 0 {
        self.in_caller_region = flag_allocates(self.functions[self.current_function].flags);
    }
    if self.current_method >= 0 {
        self.in_caller_region = flag_allocates(self.methods[self.current_method].flags);
    }
    // What this body may reach, and whose signature said so. Read from the STORED signature for the
    // same reason `allocates` is — the node's flags are what was parsed, and the stored one is what
    // the rest of the checker agrees on.
    let outer_effects: Int = self.allowed_effects;
    let outer_owner: String = self.effects_owner;
    self.allowed_effects = flag_effects(item.value);
    self.effects_owner = substring(src, self.tokens[item.token].start,
            self.tokens[item.token].length);
    let clauses: Int = self.check_clauses(src, index, signature, return_type);
    let outer_function: Int = self.in_function;
    let outer_loop: Int = self.loop_depth;
    self.in_function = 1;
    self.loop_depth = 0;
    let body: Int = self.check_block_nodes(src, item.b, return_type);
    // ---- B23: `allocates nothing` is a CLAIM, and until v0.0.264 stage-1 threw it away ---------
    //
    // The word was parsed into `claims_nothing` and nothing ever read it, so stage-1 answered `no
    // errors` on a function whose first statement joins two Strings while stage-0 refused it. One
    // field and one comparison, because the hard half — the fixpoint — has been here since
    // v0.0.144; the comment in parser.bx that said otherwise is what kept this open.
    //
    // Checked against the STORED signature, which is what the probe updates, and at the END of the
    // body, because the body is what decides. And against the TRANSITIVE answer, because a claim
    // that stopped at the first call would be worth nothing: a function that calls something that
    // allocates does allocate.
    //
    // Functions only, as in stage-0 — a method there cannot carry the claim, because its parser
    // reads `allocates` and stops. That asymmetry is stage-0's and predates this.
    if item.kind == 80 && self.current_function >= 0 {
        let declared: DeclaredFunction = self.functions[self.current_function];
        if flag_claims_nothing(declared.flags) == 1 && flag_allocates(declared.flags) == 1 {
            let owner: Token = self.tokens[item.token];
            let mutable why: String = "";
            let named: String = self.first_allocation(src, item.b);
            if named != "" {
                why = " — " + named;
            }
            let complained: Int = self.complain_at(src, item.token,
                        "`function " + substring(src, owner.start, owner.length)
                        + "` claims `allocates nothing`, and it does allocate" + why
                        + ". Either drop the claim, or move the building into a function that does not "
                    + "make it.");
        }
    }
    if !self.block_exits(item.b) {
        // Every Burxt function returns a value, so falling off the end is not a
        // silent zero — it is a missing answer, and the compiler says which function.
        let complained: Int = self.complain_at(src, item.token,
                    "this function can reach its closing brace without returning, and every "
                + "Burxt function answers with a value");
    }
    self.in_function = outer_function;
    self.loop_depth = outer_loop;
    self.current_function = outer_fn;
    self.current_method = outer_method;
    self.allowed_effects = outer_effects;
    self.effects_owner = outer_owner;
    let dropped: Int = truncate(self.bindings, base);
    self.depth -= 1;
    self.param_depth = outer_param_depth;
    self.in_caller_region = outer_caller;
    self.in_pure = outer_pure;
    self.current_generic = outer_generic;
    return 1;
}

// `requires`, `ensures`, `decreases`. All three are checked under the `pure` rule,
// for the reason A5 gives: a contract that can change the program is not a check, it
// is a second program that only runs when someone is looking.
function (mutable self: Unit) check_clauses(src: String, index: Int, signature: Node,
        return_type: Type) -> Int {
    let item: Node = self.nodes[index];
    let outer_pure: Int = self.in_pure;
    self.in_pure = 1;
    self.in_contract = 1;
    // The return type's node, for kind 21 — the operand a return bracket's elided subject becomes.
    // Saved and restored, because clauses of one function must not answer with another's return type.
    let outer_result_node: Int = self.result_type_node;
    self.result_type_node = signature.c;
    let mutable measures: Int = 0;
    let mutable i: Int = 0;
    while i < signature.b {
        let clause: Node = self.nodes[self.children[signature.a + i]];
        let base: Int = len(self.bindings);
        if clause.value == 127 {                     // ensures
            // `result` is bound here and nowhere else. It is not a keyword: a
            // parameter may still be called `result`, and then it collides, which is
            // an error about the collision rather than a silent shadowing.
            if return_type.kind == 46 || return_type.kind == 47 || return_type.kind == 48
                    || return_type.kind == 53 {
                let complained: Int = self.complain_at(src, clause.token,
                            "`ensures` cannot see the result of a function returning "
                            + self.show_type(src, return_type) + ": it travels through the caller's storage, "
                        + "and binding `result` to it needs care a scalar does not");
            }
            self.in_ensures = 1;
            let spelling: Int = find_text(src, "result");
            if spelling >= 0 {
                push(self.bindings, Binding { start: spelling, length: 6,
                                bound_type: return_type, writable: 0, depth: self.depth,
                        in_region: 0, holds_region: 0, dyn_owner: 0 - 1 });
            }
        }
        let got: Type = self.type_of(src, clause.a, simple_type(41));
        if clause.value == 128 {                     // decreases
            measures += 1;
            if !is_unknown(got) && got.kind != 40 {
                let complained: Int = self.complain_at(src, clause.token,
                            "a `decreases` measure counts, so it must be an Int: a Decimal "
                        + "measure invites a descent that shrinks forever without arriving");
            }
            if item.kind == 81 {
                let complained: Int = self.complain_at(src, clause.token,
                            "`decreases` is not available on a method yet, and a clause that "
                        + "is not checked would be worse than none");
            }
            if !self.body_calls(src, item.b, self.tokens[item.token]) {
                let complained: Int = self.complain_at(src, clause.token,
                            "`decreases` claims a recursion ends, and this function never "
                        + "calls itself, so there is nothing to check");
            }
        } else {
            if !is_unknown(got) && got.kind != 41 {
                let complained: Int = self.complain_at(src, clause.token,
                            "a contract is a claim, so it must be a Bool, but this is "
                        + self.show_type(src, got));
            }
        }
        self.in_ensures = 0;
        let dropped: Int = truncate(self.bindings, base);
        i += 1;
    }
    if measures > 1 {
        let complained: Int = self.complain_at(src, item.token,
                    "one `decreases` per function: two measures would need a rule for which "
                + "one descends, and one integer covers the cases that exist");
    }
    self.in_contract = 0;
    self.in_pure = outer_pure;
    self.result_type_node = outer_result_node;
    return 1;
}

// Where these bytes first appear in the source. A symbol is a span, so binding a name
// the program did not write — `result` inside an `ensures` — needs a span whose bytes
// spell it. Any occurrence will do, since only the bytes are compared. If the word
// appears nowhere, nothing can refer to it, and there is nothing to bind.
function find_text(src: String, needle: String) -> Int {
    let n: Int = len(needle);
    // `len` on a String is strlen, so both bounds are hoisted. Leaving `len(src)` in the
    // condition walked the whole source on every iteration — O(source²) for one call, on a
    // two-hundred-kilobyte source. The first of four of this shape; the one that mattered
    // was not in Burxt at all, and spec/1.0/M9-PERFORMANCE.md tells that story.
    let stop: Int = len(src) - n;
    let mutable i: Int = 0;
    while i <= stop {
        let mutable k: Int = 0;
        let mutable same: Bool = true;
        while k < n {
            if byte_at(src, i + k) != byte_at(needle, k) {
                same = false;
                k = n;
            } else {
                k += 1;
            }
        }
        if same {
            return i;
        }
        i += 1;
    }
    return -1;
}

// `return tail f(...)` is a guarantee, not a hope: the frame is REPLACED. Everything
// below is a condition for that being possible at all, which is why each one is a
// compile error rather than a quiet fallback to an ordinary call.
function (mutable self: Unit) check_tail(src: String, n: Node, return_type: Type) -> Int {
    let value: Node = self.nodes[n.a];
    if value.kind != 13 {
        let complained: Int = self.complain_at(src, n.token,
                "`tail` names the call whose frame replaces this one, and this is not a call");
        return 0;
    }
    if self.region_depth > 0 {
        let complained: Int = self.complain_at(src, n.token,
                    "a `tail` call inside a `region` would jump past the region's close, and "
                + "the bytes would never be released");
    }
    // 53 — a tuple. The most consequential of the three lists this sweep added it to: the other
    // two are diagnostics, and this one is SOUNDNESS. A tuple returns through the caller's sret
    // storage exactly as a class does, and a `tail` call replaces the frame that owns it.
    // Stage-0 refuses; stage-1 accepted, which is a miscompile rather than a missing message.
    if return_type.kind == 46 || return_type.kind == 47 || return_type.kind == 48
            || return_type.kind == 53 {
        let complained: Int = self.complain_at(src, n.token,
                    "a `tail` call cannot return " + self.show_type(src, return_type) + ": an aggregate travels "
                    + "through the caller's storage, and the frame that owns it is the one being "
                + "replaced");
    }
    let called: Token = self.tokens[value.token];
    let target: Int = self.find_function(src, called.start, called.length);
    if target < 0 {
        let complained: Int = self.complain_at(src, n.token,
                "`tail` calls a Burxt function, and this is not one");
        return 0;
    }
    let callee: DeclaredFunction = self.functions[target];
    if flag_external(callee.flags) == 1 {
        let complained: Int = self.complain_at(src, n.token,
                    "`tail` into C is not a tail call: the C side has its own calling "
                + "convention, and nothing here can guarantee the frame is replaced");
        return 0;
    }
    if self.current_function < 0 {
        return 0;
    }
    let here: DeclaredFunction = self.functions[self.current_function];
    if !self.same_type(src, callee.return_type, here.return_type) {
        let complained: Int = self.complain_at(src, n.token,
                    "a `tail` call must answer what this function answers: " + self.show_type(src, here.return_type)
                + ", not " + self.show_type(src, callee.return_type));
    }
    let mine: Node = self.nodes[here.parameters];
    let theirs: Node = self.nodes[callee.parameters];
    if mine.b != theirs.b {
        let complained: Int = self.complain_at(src, n.token,
                    "a `tail` call replaces this frame, so the signatures must match: this "
                    + "function takes " + to_string(mine.b) + " parameter(s), and that one takes "
                + to_string(theirs.b));
        return 0;
    }
    let mutable i: Int = 0;
    while i < mine.b {
        let want: Type = self.declared_type(src, self.nodes[self.children[mine.a + i]].a);
        let got: Type = self.declared_type(src, self.nodes[self.children[theirs.a + i]].a);
        if !self.same_type(src, got, want) {
            let complained: Int = self.complain_at(src, n.token,
                        "parameter " + to_string(i + 1) + " is " + self.show_type(src, want) + " here and "
                    + self.show_type(src, got) + " there, and a replaced frame has one shape");
        }
        i += 1;
    }
    return 1;
}

// Whether a body calls this name — the token scan is exact, because Burxt has no
// first-class functions, so a name followed by `(` inside the body is a call to the
// one function that has it. The range is the body's braces, counted.
function (self: Unit) body_calls(src: String, body: Int, name: Token) -> Bool {
    if body < 0 {
        return false;
    }
    let mutable i: Int = self.nodes[body].token;
    let mutable depth: Int = 0;
    let mutable opened: Bool = false;
    while i < len(self.tokens) {
        let t: Token = self.tokens[i];
        if t.kind == 31 {
            depth += 1;
            opened = true;
        }
        if t.kind == 32 {
            depth -= 1;
            if opened && depth == 0 {
                return false;
            }
        }
        if t.kind == 1 && spans_equal(src, t.start, t.length, name.start, name.length) {
            if i + 1 < len(self.tokens) {
                if self.tokens[i + 1].kind == 29 {     // '('
                    return true;
                }
            }
        }
        i += 1;
    }
    return false;
}

// An `implement` answers an interface exactly: every signature, no extras, same shapes. An interface
// is a promise a `dynamic` value makes on the implementor's behalf, so a mismatch here is a
// promise nobody keeps.
function (mutable self: Unit) check_impl(src: String, index: Int) -> Int {
    let item: Node = self.nodes[index];
    let trait_name: Token = self.tokens[item.token];
    let found: Int = self.find_type(src, trait_name.start, trait_name.length);
    if found < 0 {
        let complained: Int = self.complain_at(src, item.token, "no trait of this name is declared");
        return 0;
    }
    let decl: TypeDeclaration = self.types[found];
    if decl.kind != 84 {
        let complained: Int = self.complain_at(src, item.token,
                "`implement` implements an interface, and this name belongs to a type");
        return 0;
    }
    let declared: Node = self.nodes[decl.node];
    // `implement Mapper<Int> for D` — bind the interface's own `T` to `Int` for the whole of
    // this check. Roadmap A9.
    //
    // Every comparison below already goes through `same_type`, which resolves both sides against
    // `type_bindings`, so binding here is the whole of what conformance needed: `apply(self, x: T)
    // -> T` becomes `apply(self, x: Int) -> Int` at every one of the four sites that compare a
    // signature, including the two on the `class X implements Y` path — which is the point of
    // doing it HERE and not in each of them. That path had already shipped once with a rule the
    // other path had and it did not, and this milestone was not going to be the second time.
    let bind_base: Int = self.bind_interface_arguments(src, index, decl.node);
    // `class X implements Y` sets `value` to 1 and carries no children: the class's OWN methods
    // satisfy the interface, so conformance is checked against the method table. A class may also
    // have methods the interface never mentions, which is normal — so the "no extras" rule that
    // applies to a standalone `implement` block does not apply here.
    if item.value == 1 {
        let holder: Token = self.tokens[item.c];
        let mutable s: Int = 0;
        while s < declared.b {
            let sig: Node = self.nodes[self.children[declared.a + s]];
            let sig_name: Token = self.tokens[sig.token];
            let found_method: Int = self.find_method_named(src, holder.start, holder.length,
                    sig_name.start, sig_name.length);
            if found_method < 0 {
                let complained: Int = self.complain_at(src, item.token,
                            "this class does not have `" + substring(src, sig_name.start, sig_name.length)
                        + "`, which the interface it implements requires");
            } else {
                // A method with the right NAME is not conformance. This path checked only that one
                // existed, so `function (self) price() -> Int` satisfied an interface declaring
                // `-> Decimal<2>` — and the vtable then held a function returning the wrong width.
                // The `implement Trait for Type` path had checked the whole signature all along;
                // `class X implements Y` shares the interface and did not share the rule.
                let mine: Method = self.methods[found_method];
                let want_ret: Type = self.declared_type(src, sig.a);
                if !self.same_type(src, mine.return_type, want_ret) {
                    let complained: Int = self.complain_at(src, item.token,
                                "in `class " + substring(src, holder.start, holder.length)
                                + " implements " + substring(src, trait_name.start, trait_name.length)
                                + "`, method `" + substring(src, sig_name.start, sig_name.length)
                                + "` returns " + self.show_type(src, mine.return_type)
                            + " but the interface declares " + self.show_type(src, want_ret) + ".");
                }
                if mine.mutating != sig.value {
                    let complained: Int = self.complain_at(src, item.token,
                                "in `class " + substring(src, holder.start, holder.length)
                                + " implements " + substring(src, trait_name.start, trait_name.length)
                                + "`, method `" + substring(src, sig_name.start, sig_name.length)
                                + "` writes its receiver differently from the interface: `self` and "
                            + "`mutable self` are different promises.");
                }
                let mine_params: Node = self.nodes[mine.parameters];
                if mine_params.b != sig.c {
                    let complained: Int = self.complain_at(src, item.token,
                                "in `class " + substring(src, holder.start, holder.length)
                                + " implements " + substring(src, trait_name.start, trait_name.length)
                                + "`, method `" + substring(src, sig_name.start, sig_name.length)
                                + "` takes " + to_string(mine_params.b)
                            + " parameter(s), and the interface declares " + to_string(sig.c) + ".");
                }
            }
            s += 1;
        }
        let dropped: Int = truncate(self.type_bindings, bind_base);
        return 0;
    }
    let mutable i: Int = 0;
    while i < declared.b {
        let sig: Node = self.nodes[self.children[declared.a + i]];
        let sig_name: Token = self.tokens[sig.token];
        let mutable matched: Int = -1;
        let mutable k: Int = 0;
        while k < item.b {
            let candidate: Int = self.children[item.a + k];
            let named: Token = self.tokens[self.nodes[candidate].token];
            if spans_equal(src, named.start, named.length, sig_name.start, sig_name.length) {
                matched = candidate;
            }
            k += 1;
        }
        if matched < 0 {
            let complained: Int = self.complain_at(src, item.token,
                        "this implement leaves out `" + substring(src, sig_name.start, sig_name.length)
                    + "`, which the interface requires");
        } else {
            let method: Node = self.nodes[matched];
            let mutating: Int = flag_mutating(method.value);
            if mutating != sig.value {
                let complained: Int = self.complain_at(src, method.token,
                            "the interface writes this receiver differently: `self` and `mutable self` "
                        + "are different promises");
            }
            let params: Node = self.nodes[method.a];
            if params.b != sig.c {
                let complained: Int = self.complain_at(src, method.token,
                            "the interface's signature takes " + to_string(sig.c)
                        + " parameter(s), and this takes " + to_string(params.b));
            } else {
                let mutable p: Int = 0;
                while p < sig.c {
                    let want: Type = self.declared_type(src, self.nodes[self.nested_children[sig.b + p]].a);
                    let got: Type = self.declared_type(src, self.nodes[self.children[params.a + p]].a);
                    if !self.same_type(src, got, want) {
                        let complained: Int = self.complain_at(src, method.token,
                                    "parameter " + to_string(p + 1) + " is " + self.show_type(src, want)
                                + " in the interface, and " + self.show_type(src, got) + " here");
                    }
                    p += 1;
                }
            }
            let want_ret: Type = self.declared_type(src, sig.a);
            let got_ret: Type = self.declared_type(src, self.nodes[method.c].c);
            if !self.same_type(src, got_ret, want_ret) {
                let complained: Int = self.complain_at(src, method.token,
                            "the interface returns " + self.show_type(src, want_ret) + ", and this returns "
                        + self.show_type(src, got_ret));
            }
        }
        i += 1;
    }
    let mutable k: Int = 0;
    while k < item.b {
        let method: Node = self.nodes[self.children[item.a + k]];
        let named: Token = self.tokens[method.token];
        let mutable known: Bool = false;
        let mutable i2: Int = 0;
        while i2 < declared.b {
            let sig: Node = self.nodes[self.children[declared.a + i2]];
            let sig_name: Token = self.tokens[sig.token];
            if spans_equal(src, named.start, named.length, sig_name.start, sig_name.length) {
                known = true;
            }
            i2 += 1;
        }
        if !known {
            let complained: Int = self.complain_at(src, method.token,
                        "the interface has no method of this name, and an implementation is an answer to a "
                    + "trait rather than a place to add to a type");
        }
        k += 1;
    }
    let dropped: Int = truncate(self.type_bindings, bind_base);
    return 1;
}

// Bind a generic interface's parameters from what an `implement` header wrote: `implement
// Mapper<Int> for D` binds the interface's `T` to `Int`. Roadmap A9.
//
// Answers the base to truncate back to, exactly as `bind_from_application` does — the bindings
// are scoped to one check and must not leak into the next declaration.
//
// **The arity check lives here** rather than beside the other conformance rules, because this is
// the one place that knows both numbers: what the header wrote and what the declaration takes.
function (mutable self: Unit) bind_interface_arguments(src: String, item: Int,
        declaration: Int) -> Int {
    let base: Int = len(self.type_bindings);
    let node: Node = self.nodes[declaration];
    let named: Token = self.tokens[node.token];
    let generic: Int = self.generic_named(src, named.start, named.length);
    let written: Int = self.trait_arguments_of(item);
    if generic < 0 {
        if written > 0 {
            let complained: Int = self.complain_at(src, self.nodes[item].token,
                        "`" + substring(src, named.start, named.length)
                        + "` is not generic, so it takes no type arguments — write `"
                    + substring(src, named.start, named.length) + "` on its own.");
        }
        return base;
    }
    let declared: Generic = self.generics[generic];
    if written != declared.type_param_count {
        let complained: Int = self.complain_at(src, self.nodes[item].token,
                    "`" + substring(src, named.start, named.length) + "` takes "
                    + to_string(declared.type_param_count) + " type argument(s), but "
                + to_string(written) + " were given");
        return base;
    }
    let start: Int = self.trait_argument_start(item);
    let mutable i: Int = 0;
    while i < declared.type_param_count {
        let parameter: Token = self.tokens[self.type_parameters[declared.type_param_start + i]];
        let argument: Type = self.declared_type(src, self.nested_children[start + i]);
        push(self.type_bindings, TypeBinding { name_start: parameter.start,
                        name_length: parameter.length,
                bound: self.resolve_shallow(src, argument) });
        i += 1;
    }
    return base;
}

// The shapes a type may not have. Both refusals are about storage: a nested array would
// need a layout rule for arrays of arrays that M1 does not have, and a zero-length array
// describes nothing. A growable array inside a class is fine — stage-1's own Unit is
// made of them — and what it costs is that the class must be built in a region.
// ---- every type a DECLARATION names must exist, and this is the pass that asks ---------------
//
// Stage-1 validated no type name in a signature at all: `function b(x: Nope) -> Int` compiled here
// and stage-0 refused it. `parser.bx` recorded the hole in a comment, measured on v0.0.276 and
// still true four milestones later, and `check_type_shape`'s own comment recorded the other half —
// that it reached four positions where stage-0's `validate_type` reaches nine. **They were one
// defect**: a funnel that did not ask, called from places that did not call it.
//
// TEN POSITIONS DIVERGED and they are one shape. Measured, stage-0 refusing and stage-1 silent:
//
//     function parameter · function return · method parameter · method return
//     class field · enum payload · [Nope] · extern parameter, in four flavours
//
// Return types, `let`s and method returns LOOKED like they agreed and did not. Stage-1 caught them
// INCIDENTALLY — `this function returns Nope, but the value is Int`, a value mismatch against a
// type it never confirmed exists. **A declaration position with no value to mismatch against slid
// straight through**, which is the rule, and why fixing the positions one at a time would have left
// the next one open.
//
// **A PASS OF ITS OWN, AND THE ORDER IS THE RULE.** The first version asked inside
// `collect_declarations`, which refused `enum Json { List([Json]) }` — a recursive enum naming
// itself before its own declaration was pushed. Nine tests went red on the standard library, which
// is the right outcome for that mistake and the reason this is not a line in the collection loop:
// **a type may name any type the program declares, including itself, so nothing can be judged until
// every declaration is in.** `check_return_storage` is here for the same reason two versions on.
//
// Before the bodies, because `complain_at` keeps the FIRST problem and stage-0 refuses at the
// declaration — so a program with a bad signature must be told about the signature rather than
// about the first call that trips over it.
//
// **The return type's caret still differs from stage-0's, and that is stage-1's convention rather
// than this pass's choice.** Stage-0 points a declaration-level message at the declaration's first
// token; stage-1 points it at the declaration's NAME, because `item.token` is the name and no node
// carries the `function` keyword. Measured on messages that predate this pass — `this function is
// declared twice` is 2:1 against 2:10 the same way — so it is one systematic difference across
// every declaration-level message in both compilers, reported rather than patched here. Fixing it
// in one pass would make this the odd one out in stage-1 instead of the odd one out against
// stage-0, which is not an improvement.
function (mutable self: Unit) check_declared_type_names(src: String) -> Int {
    let mutable i: Int = 0;
    while i < len(self.items) {
        let index: Int = self.items[i];
        let item: Node = self.nodes[index];
        // A function or a method: its parameters, each pointing at ITSELF so a signature with six
        // parameters and one bad type says which one, and its return, pointing at the declaration.
        //
        // An `external function` (kind 86) is NOT here. `check_extern_param` and
        // `check_extern_return` already refuse every type that cannot cross the C boundary, which
        // necessarily includes one that does not exist, and their message is the better one: *C has
        // no Nope, and the raw value would silently lose its meaning* tells the author of an
        // `external function` what is actually wrong, where "declare it with `class Nope`" suggests
        // a fix that would not help. Stage-0 orders it the same way.
        if item.kind == 80 || item.kind == 81 {
            let signature: Node = self.nodes[item.c];
            let named: Int = self.check_type_names_in(src, item.a, signature.c, item.token);
        }
        // The methods inside an `implement Trait for Type { ... }` are declared exactly as
        // free-standing ones are, so they are asked exactly the same question.
        if item.kind == 85 {
            let mutable k: Int = 0;
            while k < item.b {
                let inner: Node = self.nodes[self.children[item.a + k]];
                let signature: Node = self.nodes[inner.c];
                let named: Int = self.check_type_names_in(src, inner.a, signature.c, inner.token);
                k += 1;
            }
        }
        if item.kind == 82 {                             // a class: its fields
            let mutable f: Int = 0;
            while f < item.b {
                let field: Node = self.nodes[self.children[item.a + f]];
                let named: Int = self.check_type_name(src, field.a,
                        self.type_node_token(field.a, field.token));
                f += 1;
            }
        }
        // An enum's payloads. **The slots are `variant.c` and `nested_children[variant.b + p]`,
        // and the first version of this used `variant.b` and `children[variant.a + p]` — so the
        // loop ran zero times and the branch did nothing at all.** It looked correct and was
        // reported as covering enum payloads; nothing failed, because a walk over no elements
        // cannot. The tell was measuring it: `enum E { A(Nope) }` was accepted, which the branch
        // above it would have refused.
        //
        // Worth stating because it is the day's shape one more time — a branch asserting work is
        // not evidence the work happens — and because the mistake is invisible in review: two
        // plausible field names, no error, no warning, and a green suite.
        if item.kind == 83 {
            let mutable v: Int = 0;
            while v < item.b {
                let variant: Node = self.nodes[self.children[item.a + v]];
                let mutable pay: Int = 0;
                while pay < variant.c {
                    let payload: Int = self.nested_children[variant.b + pay];
                    let named: Int = self.check_type_name(src, payload,
                            self.type_node_token(payload, variant.token));
                    pay += 1;
                }
                v += 1;
            }
        }
        i += 1;
    }
    return self.problems;
}

// The token a type node was written at, or the fallback when there is no node.
function (self: Unit) type_node_token(node: Int, fallback: Int) -> Int {
    if node < 0 {
        return fallback;
    }
    return self.nodes[node].token;
}

// A signature's parameters and its return.
function (mutable self: Unit) check_type_names_in(src: String, params: Int, returned: Int,
        at: Int) -> Int {
    if params >= 0 {
        let list: Node = self.nodes[params];
        let mutable i: Int = 0;
        while i < list.b {
            let parameter: Node = self.nodes[self.children[list.a + i]];
            let named: Int = self.check_type_name(src, parameter.a,
                    self.type_node_token(parameter.a, parameter.token));
            i += 1;
        }
    }
    if returned >= 0 {
        let named: Int = self.check_type_name(src, returned, at);
    }
    return self.problems;
}

// One type, recursively: a slice's element, an array's element, a tuple's members and a generic
// application's arguments are all types a declaration names, and a name that declares nothing is
// refused wherever it sits. `[Nope]` was one of the ten.
//
// Stage-0's sentence to the byte, so one `.stderr` fixture pins both compilers.
function (mutable self: Unit) check_type_name(src: String, node: Int, at: Int) -> Int {
    if node < 0 {
        return 0;
    }
    let n: Node = self.nodes[node];
    if n.kind == 47 || n.kind == 48 {
        return self.check_type_name(src, n.a, at);
    }
    // `dynamic I` asks a DIFFERENT question and gets a different sentence: not *does this name
    // exist* but *does it name an interface*. Stage-0 says `unknown interface` for both a name
    // nobody declared and a name that is a class, because "declare it with `class Point`" would be
    // useless advice to somebody who already has one.
    //
    // It is the fifteenth position and it was found by asking whether the pass was a FUNNEL or
    // fourteen cases — the answer being that it covered every type node kind it had been tested
    // against, which is not the same thing. Three acceptance divergences hid here: an unknown name
    // in a parameter, the same in a field, and `dynamic` naming a class.
    if n.kind == 49 {
        let interface_named: Token = self.tokens[n.token];
        let found: Int = self.find_type(src, interface_named.start, interface_named.length);
        // 84 is a declared interface. A class or an enum found here is the second case above.
        if found >= 0 && self.types[found].kind == 84 {
            return 0;
        }
        let name: String = substring(src, interface_named.start, interface_named.length);
        // The caret goes on `dynamic`, where stage-0 puts it, rather than on the name after it.
        // The keyword is always the token immediately before — the grammar is `dynamic Name`, with
        // nothing permitted between — so this is exact rather than a guess, and it is checked
        // rather than assumed in case a future form puts something there.
        let mutable caret: Int = at;
        if n.token > 0 {
            let before: Token = self.tokens[n.token - 1];
            if spans_equal(src, before.start, before.length, 0, 0) == false
                    && substring(src, before.start, before.length) == "dynamic" {
                caret = n.token - 1;
            }
        }
        let complained: Int = self.complain_at(src, caret,
                "unknown interface `" + name + "` — declare it with `interface " + name + " \{ ... \}`");
        return 1;
    }
    if n.kind != 46 {
        return 0;
    }
    let named: Token = self.tokens[n.token];
    if self.find_type(src, named.start, named.length) >= 0 {
        return 0;
    }
    // **The caret is the CALLER's to choose, and stage-0 chooses differently by position.** A
    // parameter or a field points at the type the author wrote — and at the OUTER type, so `[Nope]`
    // points at the `[` rather than at the element inside it. A return points at the declaration.
    // Deciding it here instead would get one of the two wrong, and a message that is right with the
    // caret in the wrong place is the shape that reads as correct in a diff and misleads in a
    // terminal.
    // A `<T>` somebody introduced. The parser gives a type parameter node kind 50 where it can
    // tell, and where it cannot — a `T` in a generic class's field, reached before the enclosing
    // declaration is in scope — it stays kind 46 and looks exactly like a class nobody declared.
    if self.generic_named(src, named.start, named.length) >= 0
            || self.names_a_type_parameter(src, named.start, named.length) {
        return 0;
    }
    let name: String = substring(src, named.start, named.length);
    let complained: Int = self.complain_at(src, at,
                "unknown type `" + name + "` — declare it with `class " + name
            + " \{ ... \}` or `enum " + name + " \{ ... \}`");
    return 1;
}

function (mutable self: Unit) check_type_shape(src: String, node: Int, at: Int) -> Int {
    // C2. A dependency's private class or enum, refused where it is NAMED. This funnel used to have
    // four callers where stage-0's `validate_type` has nine, and that gap was recorded here as the
    // one place the two compilers differ in reach. It was not only a C2 gap: the same missing calls
    // meant no signature type was checked to EXIST either. Both close together, because they were
    // one hole seen from two sides.
    let private_named: Int = self.refuse_private_type(src, node);
    if node < 0 {
        return 0;
    }
    let n: Node = self.nodes[node];
    if n.kind != 47 && n.kind != 48 {
        return 0;
    }
    if n.kind == 48 && n.b <= 0 {
        let complained: Int = self.complain_at(src, at,
                "an array of no elements describes nothing, and nothing can be read from it");
    }
    let element: Node = self.nodes[n.a];
    if element.kind == 47 || element.kind == 48 {
        let complained: Int = self.complain_at(src, at,
                    "arrays do not nest yet: an array of arrays needs a layout rule the memory "
                + "model does not have");
        return 0;
    }
    return self.check_type_shape(src, n.a, at);
}

// Does this program use generics? Stage-1 READS them — the parser handles type parameters,
// applications, bounds and generic receivers — and its checker does not yet monomorphise
// them. Refused here, once, with the reason: a checker that half-understood a generic would
// answer differently from stage-0, and the differential test exists to stop exactly that.
//
// A clean refusal, not a crash. Before this guard the checker walked a type-parameter node,
// looked its name up as a class, got -1, and indexed an array with it. Saying "not yet" is
// the honest answer and the cheap one. See spec/1.0/M7-GENERICS.md §5 for the design that
// replaces it.
// The one thing left that needs a COPY rather than a resolution: a function whose body is sized
// by a type parameter. `identity<T>` compiles to different code for `T = Int` (one cell) and
// `T = Point` (two), so there must be one machine function per instantiation — mangling, a work
// list, and a call site that names the copy. Classes and enums need none of that, because their
// layout is a count read under the arguments in scope.
//
// Answers the declaration node so the message can point at it, or -1 when there is none.

function (self: Unit) generic_function(src: String) -> Int {
    let mutable at: Int = 0;
    while at < len(self.nodes) {
        let n: Node = self.nodes[at];
        if n.kind == 80 || n.kind == 81 {
            let name: Token = self.tokens[n.token];
            if self.generic_named(src, name.start, name.length) >= 0 {
                return at;
            }
        }
        at += 1;
    }
    return 0 - 1;
}

// Every generic APPLICATION written in the program, checked against the declaration it names:
// the name must be generic, and the argument count must match. Done in one sweep because an
// application can appear in any type position, and a rule spread over every position is a rule
// with a hole in it.
// A named type whose declaration takes type parameters, written with none of them — which is
// only ever a question the program has not answered.
function (self: Unit) unsettled_generic(src: String, t: Type) -> Bool {
    if t.kind != 46 && t.kind != 49 {
        return false;
    }
    if t.contract > 0 {                               // arguments were given
        return false;
    }
    let named: Int = self.generic_named(src, t.name_start, t.name_length);
    if named < 0 {
        return false;
    }
    let declaration: Generic = self.generics[named];
    return declaration.type_param_count > 0;
}

// Does `carried` embed the type named by `(target_start, target_length)` — its own bytes, directly or
// through anything it contains?
//
// **By value is the whole of the question.** A width is unbounded only when a type contains ITSELF: a
// variant carrying `[Json]` carries a pointer, a length and a capacity no matter how wide a `Json` is,
// so recursion through a slice always terminates. An ARRAY does embed its element, so it recurses.
//
// This replaces the rule both compilers used to state — "a variant may not carry an enum" — which was
// a proxy for this one and wrong whenever the recursion went through a pointer. Stage-0 did not obey
// its own proxy either: the same shape reached through `Option<Json>` was allowed and worked.
//
// `self.walked_types` is the cycle guard, holding the DECLARATION INDEX of each type already entered —
// which is what makes the walk terminate on the very shapes it exists to refuse. Without it,
// `enum A { Go(B) }` / `enum B { Back(A) }` recurses forever while deciding that it recurses forever.
//
// A field rather than a parameter because Burxt has no writable parameters — the same constraint that
// made `lib/map.bx` method-based — and truncated on the way out, exactly as `type_bindings` is.
function (mutable self: Unit) embeds_by_value(src: String, carried: Type, target_start: Int,
        target_length: Int) -> Bool {
    // A pointer, whatever it points at. This is the case the old rule got wrong.
    if carried.kind == 47 || carried.kind == 49 {
        return false;
    }
    if carried.kind == 48 {                          // an array DOES embed its element
        let element: Type = self.declared_type(src, carried.scale);
        return self.embeds_by_value(src, element, target_start, target_length);
    }
    if carried.kind != 46 {
        return false;
    }
    if spans_equal(src, carried.name_start, carried.name_length, target_start, target_length) {
        return true;
    }
    let found: Int = self.find_type(src, carried.name_start, carried.name_length);
    if found < 0 {
        return false;
    }
    let mutable w: Int = 0;
    while w < len(self.walked_types) {
        if self.walked_types[w] == found {
            return false;                            // already entered; not a fresh path
        }
        w += 1;
    }
    let depth: Int = len(self.walked_types);
    let added: Int = push(self.walked_types, found);
    let decl: TypeDeclaration = self.types[found];
    let item: Node = self.nodes[decl.node];
    let mutable answer: Bool = false;
    if decl.kind == 82 {                             // a class: every field
        let mutable f: Int = 0;
        while f < item.b {
            let field: Node = self.nodes[self.children[item.a + f]];
            let held: Type = self.declared_type(src, field.a);
            if self.embeds_by_value(src, held, target_start, target_length) {
                answer = true;
            }
            f += 1;
        }
    }
    if decl.kind == 83 {                             // an enum: every variant's every payload
        let mutable v: Int = 0;
        while v < item.b {
            let variant: Node = self.nodes[self.children[item.a + v]];
            let mutable p: Int = 0;
            while p < variant.c {
                let held: Type = self.declared_type(src, self.nested_children[variant.b + p]);
                if self.embeds_by_value(src, held, target_start, target_length) {
                    answer = true;
                }
                p += 1;
            }
            v += 1;
        }
    }
    let dropped: Int = truncate(self.walked_types, depth);
    return answer;
}

// A variant payload must be a scalar, and for a generic enum that is a rule about the
// INSTANTIATION rather than the declaration: `Option<T>`'s payload is a parameter, which is
// neither scalar nor aggregate until an argument says. So the rule is checked where the
// argument is written, once per application, with the arguments in scope.
//
// The rule itself is a cut, not a principle — an aggregate payload reopens the question of how
// wide a variant is when the widest one holds a class. Stage-0 draws the same line, and the
// two must draw it in the same place or a program compiles with one compiler and not the other.
function (mutable self: Unit) check_payloads(src: String, application: Int) -> Int {
    let applied: Type = self.declared_type(src, application);
    let found: Int = self.find_type(src, applied.name_start, applied.name_length);
    if found < 0 {
        return 0;
    }
    let decl: TypeDeclaration = self.types[found];
    if decl.kind != 83 {                              // classes may hold anything
        return 0;
    }
    let item: Node = self.nodes[decl.node];
    let base: Int = self.bind_from_application(src, applied);
    let mutable v: Int = 0;
    while v < item.b {
        let variant: Node = self.nodes[self.children[item.a + v]];
        let mutable p: Int = 0;
        while p < variant.c {
            let written: Type = self.declared_type(src, self.nested_children[variant.b + p]);
            let carried: Type = self.resolve_shallow(src, written);
            // A class or an array payload is allowed since v0.0.118: `cells_of` already sums a
            // variant's payload cells, so the layout question this rule deferred was already
            // answered here — stage-1 was refusing something its own emitter could do.
            //
            // An enum payload is allowed when its width is FINITE, which is the rule this used to
            // approximate by refusing every enum payload. What makes a width unbounded is a type
            // containing ITSELF by value; recursion through a slice is a pointer and terminates.
            // `dynamic Trait` is still refused — its two cells hold a pointer into storage a
            // variant's payload area does not own, which is an ownership question rather than a
            // width one.
            // TWO refusals, and they had one message between them — which sent the reader to
            // the wrong one. `dynamic Trait` is refused because a variant's payload area does not
            // own the storage the two cells point at: an OWNERSHIP question. Containment is
            // refused because the width has no finite answer: a SIZE question, whose fix is a
            // slice. The old wording said "has no layout here. A variant carries a scalar, a
            // String, a class or an array" for both — and for `class Node { next: Option<Node> }`
            // that is false advice twice over, since a variant may carry a class and the thing
            // with no layout is `Node` itself, not the variant.
            let variant_name: Token = self.tokens[variant.token];
            if carried.kind == 49 {
                let complained: Int = self.complain_at(src, self.nodes[application].token,
                            "`" + self.show_type(src, applied) + "` cannot be made: `"
                            + substring(src, applied.name_start, applied.name_length) + "."
                            + substring(src, variant_name.start, variant_name.length)
                            + "` would carry " + self.show_type(src, carried)
                            + ", which has no layout here. A variant carries a scalar, a String, a "
                        + "class or an array");
            }
            if carried.kind == 46 {
                if self.embeds_by_value(src, carried, applied.name_start, applied.name_length) {
                    let complained: Int = self.complain_at(src, self.nodes[application].token,
                                "`" + self.show_type(src, applied) + "` cannot be made: `"
                                + substring(src, applied.name_start, applied.name_length) + "."
                                + substring(src, variant_name.start, variant_name.length)
                                + "` would carry " + self.show_type(src, carried)
                                + ", which contains " + self.show_type(src, applied)
                                + " by value — so it would have to be wider than itself. Hold it "
                                + "behind a slice — `[" + self.show_type(src, carried)
                                + "]` — which is a pointer, so the size is finite and the recursion "
                            + "still works");
                }
            }
            p += 1;
        }
        v += 1;
    }
    let dropped: Int = truncate(self.type_bindings, base);
    return 1;
}

function (mutable self: Unit) check_applications(src: String) -> Int {
    let mutable at: Int = 0;
    while at < len(self.nodes) {
        let n: Node = self.nodes[at];
        if n.kind == 46 && n.b > 0 {
            let named: Token = self.tokens[n.token];
            let generic: Int = self.generic_named(src, named.start, named.length);
            if generic < 0 {
                let complained: Int = self.complain_at(src, n.token,
                            "`" + substring(src, named.start, named.length)
                        + "` is not generic, so it takes no type arguments");
            } else {
                let declaration: Generic = self.generics[generic];
                if declaration.type_param_count != n.b {
                    let complained: Int = self.complain_at(src, n.token,
                                "`" + substring(src, named.start, named.length) + "` takes "
                                + to_string(declaration.type_param_count) + " type argument(s), and "
                            + to_string(n.b) + " were given");
                } else {
                    let checked: Int = self.check_payloads(src, at);
                }
            }
        }
        at += 1;
    }
    return 1;
}

// ---- B37: does a value of this type have its STORAGE in a region? ------------------------------
//
// A different question from `expr_allocates`, which asks about an expression: this one asks about a
// TYPE, and it is the one the return rule below needs, because a signature is checked before any
// body is read and there is no expression yet to ask about.
//
// A growable array IS the region — `[Int]` is a pointer into arena bytes, which is why the array
// literal arm of `expr_allocates` answers `true` on kind 47 without looking at what is in it. A
// String is NOT: a literal lives in `.rodata` and a join lives in a region, and both are `String`,
// so this must answer `no` for it or every `-> String` in the standard library stops compiling.
// That asymmetry is stage-0's `region_allocated`, mirrored line for line, and it is the reason
// stage-0 refuses `-> [Int]` and accepts `-> String`. Measured, both.
//
// A class is tainted by any FIELD that is: `class Bag { items: [Int] }` returned by value hands
// back the pointer inside it. An ENUM is not, and neither is a generic APPLICATION — stage-0 looks
// only in its `structs` table and has no arm for `Type::Generic`, so `Holder<T>` holding `[T]` is
// accepted there and must be accepted here. Both measured against stage-0 before this was written,
// which is the only reason the two exclusions are here rather than a recursion that looked tidier.
//
// **The generic exclusion is stage-0's approximation and is kept, not endorsed.** The same blind
// spot in the neighbouring `may_be_region_storage` IS a hole — see the proof on that function — and
// this one is left matching stage-0 only because B37 is about giving stage-1 a rule it did not have,
// where agreeing on the verdict is the whole deliverable. The one shape tried against it,
// `function make() -> Bag<Int>` building inside an inner region, is refused by both compilers
// through the return-statement rule instead, so the gap is not reachable there. That is one probe,
// not a proof.
//
// The `walked_types` guard is `embeds_by_value`'s, for the same reason and with the same shape.
// Stage-0 has no guard because a containment cycle never reaches it — but stage-1 does not refuse a
// MUTUAL cycle (`class A { b: B }  class B { a: A }` hangs stage-1 today, and stage-0 refuses it
// with `containment cycle: A -> B -> A`; reported, not fixed here). A guard that costs six lines
// beats a walk that recurses forever on a program the compiler already mishandles.
function (mutable self: Unit) region_allocated(src: String, t: Type) -> Bool {
    if t.kind == 47 {
        return true;                                 // a growable array lives in a region
    }
    if t.kind == 48 {                                // a fixed array is tainted by its element
        return self.region_allocated(src, self.declared_type(src, t.scale));
    }
    // A tuple is tainted by any element, exactly as a class is by any field — it IS a class
    // with positions instead of names. `(Int, [Int])` is always region storage because the
    // growable array is; `(Int, String)` is not, because a String may be a literal in
    // `.rodata`. That last distinction is the whole reason this predicate and
    // `may_be_region_storage` below are two functions and not one.
    //
    // **DEFENCE IN DEPTH, and explicitly NOT claimed as measured** — the same standing this
    // file's sibling gives B39's `Generic` arm. This predicate has ONE caller,
    // `check_return_storage`, which is skipped whenever the function is `allocates`; and any
    // function that BUILDS a tuple holding a growable array is inferred `allocates`, so no
    // program reaches here with a tuple. Mutation-tested and it survived, which is the honest
    // result: the arm is correct and currently unreachable. It is kept because the day the
    // rule is asked earlier — of a parameter, a field, a method return — a missing arm would
    // answer "not region storage" in silence, which is how B39's two holes lived.
    if t.kind == 53 {
        let mutable e: Int = 0;
        while e < t.contract {
            if self.region_allocated(src, self.declared_type(src, self.nested_children[t.scale + e])) {
                return true;
            }
            e += 1;
        }
        return false;
    }
    if t.kind != 46 || t.contract > 0 {
        return false;                                // not a named type, or a generic application
    }
    let found: Int = self.find_type(src, t.name_start, t.name_length);
    if found < 0 {
        // NO, where `may_be_region_storage` below answers YES to the same question, and the
        // asymmetry is deliberate. That one gates a refusal OFF, so an unknown answering no would
        // silence a rule. This one gates a refusal ON, so an unknown answering yes would invent
        // one — on a program that is already refused for naming a type that does not exist.
        return false;
    }
    let decl: TypeDeclaration = self.types[found];
    if decl.kind != 82 {
        return false;                                // an enum or a trait: stage-0 asks only classes
    }
    let mutable w: Int = 0;
    while w < len(self.walked_types) {
        if self.walked_types[w] == found {
            return false;                            // already entered; not a fresh path
        }
        w += 1;
    }
    let depth: Int = len(self.walked_types);
    let added: Int = push(self.walked_types, found);
    let item: Node = self.nodes[decl.node];
    let mutable answer: Bool = false;
    let mutable f: Int = 0;
    while f < item.b {
        let field: Node = self.nodes[self.children[item.a + f]];
        if self.region_allocated(src, self.declared_type(src, field.a)) {
            answer = true;
        }
        f += 1;
    }
    let dropped: Int = truncate(self.walked_types, depth);
    return answer;
}

// ---- B36: COULD a value of this type be region storage? ----------------------------------------
//
// A different question from `region_allocated` above, and the difference is `String`: a literal
// lives in `.rodata` and a join lives in a region, and both are `String`. `region_allocated` asks
// whether the type is ALWAYS in a region and must answer NO for a String, or every `-> String`
// signature stops compiling. This one asks whether it COULD be, and must answer YES for the same
// String, or `kept = b.name` reads bytes the region released. Two questions, two answers, one type.
//
// The same shape as stage-0's `may_be_region_storage`, and **not a port of a call site** — stage-0
// had no gate at the field/index arm either, so B36 is one NEW question asked in two places rather
// than one compiler catching up with the other. Stage-0's own comment says what the shape is for:
// *"only to keep the taint OFF names that cannot dangle... false positives are as much a failure as
// false negatives here."* A type parameter and a `dynamic` answer YES because neither says what the
// storage is, which is M14 §10: a wrong guess must cost memory rather than correctness.
//
// ---- the generic application, and why it asks the DECLARATION with the arguments put in --------
//
// The arguments alone are not enough. A field that is a String whatever T is never appears among
// them, and the first version of this predicate — arguments only — accepted a use-after-free.
// Measured, built and run:
//
//     class Wrapper<T> { t: T, note: String }      class Outer { inner: Wrapper<Int> }
//     region r { let o: Outer = Outer { inner: Wrapper { t: 1, note: "hello-" + "world" } };
//                kept = o.inner; }                 // `Wrapper<Int>`: every ARGUMENT is an Int
//     region second { let noise: String = "XXXXXXXXXXXX" + "YYYYYYYYYYYY"; print(noise); }
//     print(kept.note);                            // printed the SECOND region's bytes
//
// The declaration is not enough either, and reading it UNSUBSTITUTED is a false refusal rather than
// a hole — `class Holder<T> { one: T }` read as `Holder<Int>` has a field of kind 50, which answers
// yes on its own, so the second version refused a program stage-0 accepts. Measured too, and it is
// why `bind_from_application` is here: the arguments are bound, the fields are read THROUGH those
// bindings by `resolve_shallow` at the top of this function, and `one: T` becomes `one: Int`.
//
// Both halves are stage-0's as well, reached by a different road, and the difference is worth
// knowing: **stage-0 never sees a generic application here at all.** By the time its
// `expr_allocates` runs, `Wrapper<Int>` has been monomorphised to `Named("Wrapper$Int")`, so it
// takes the `Named` path and its `Type::Generic` arm is dead at this site — which is why the same
// bug is a `fields_of` lookup there and a substitution here. `b32-stage0` established that by
// measurement after I had misattributed it to their `Generic` arm; `a12-stage0` had already written
// the underlying reason beside `could_hold_storage`, that an INSTANTIATION resolves through a
// different table, so the naive lookup answers "holds nothing" and `lib/json.bx` printed a
// truncated document until that stopped being believed. Three finds, one predicate.
//
// The `walked_types` guard is keyed on the DECLARATION where stage-0 keys on the formatted type, so
// `Holder<Int>` nested inside `Holder<String>` stops one step earlier here. The two can only differ
// on a type that contains ITSELF by value, which both compilers refuse before this runs.
//
// **Kind 0 is UNKNOWN and answers YES**, and so does a name `find_type` cannot resolve. A type the
// checker could not work out must not silence a rule: an unknown that answered `no` would turn every
// unresolved field read into an acceptance, which is exactly how the hole above stayed invisible.
// Stage-0 reached the same conclusion in its own words — *"unresolvable answering NO is exactly how
// the two holes above stayed invisible."*
function (mutable self: Unit) may_be_region_storage(src: String, written: Type) -> Bool {
    // FIRST, so every arm below sees what the parameter stands for rather than the parameter. A
    // field declared `one: T` inside a `Holder<Int>` is an Int here, and reaching the kind 50 arm
    // with it unresolved is the false refusal described above.
    let t: Type = self.resolve_shallow(src, written);
    if t.kind == 42 || t.kind == 47 {
        return true;                                 // a String, a growable array
    }
    if t.kind == 49 || t.kind == 50 || t.kind == 0 {
        return true;                                 // a `dynamic`, an ABSTRACT parameter, an unknown
    }
    if t.kind == 48 {                                // a fixed array: its element decides
        return self.may_be_region_storage(src, self.declared_type(src, t.scale));
    }
    // A tuple: any element decides, exactly as any field of a class does.
    //
    // **This arm is the B39 hole in A8's shape, and it had to be written rather than
    // inherited.** The line below answers `false` for every kind it does not name, and 53 is
    // not 46 — so without this a `(Int, String)` matched out of a `region` would have been
    // "one i64 cell, copied", the taint would never have been applied, and the program would
    // have run and printed the next region's bytes. Proven by mutation in both compilers:
    // break this arm and `tests/fail/a_tuple_holding_a_string_escapes_its_region.bx` is
    // ACCEPTED and runs.
    if t.kind == 53 {
        let mutable e: Int = 0;
        while e < t.contract {
            if self.may_be_region_storage(src, self.declared_type(src, self.nested_children[t.scale + e])) {
                return true;
            }
            e += 1;
        }
        return false;
    }
    if t.kind != 46 {
        return false;                                // Int, Bool, CInt, CDouble, Decimal, CPointer,
    }                                                // a sized width — one i64 cell, copied
    // Taken BEFORE anything is pushed, and every exit below truncates back to it.
    let bindings_base: Int = len(self.type_bindings);
    if t.contract > 0 {
        // A generic application asks the DECLARATION with the arguments bound, and asks the
        // arguments themselves NOT AT ALL. That is not an omission — an argument that reaches the
        // storage reaches it through a field, and the binding puts it there; an argument that
        // reaches no field is a PHANTOM parameter, absent from the layout, and asking about it is a
        // false refusal. Measured, and it is the last thing the two compilers disagreed on:
        //
        //     class Tagged<T> { n: Int }    class Outer { inner: Tagged<String>, s: String }
        //     region r { ... kept = o.inner; }        // `Tagged<String>` is one Int, copied
        //
        // stage-0 ACCEPTS that and an arguments-first version of this refused it. Stage-0 reaches
        // the same answer by a different road: by the time its `expr_allocates` sees the read, the
        // type has been monomorphised to `Tagged$String`, so it takes the `Named` path through
        // `fields_of` and its `Type::Generic` arm — which does ask the arguments — never runs.
        //
        // No floor move: `bind_from_application` resolves each argument under the bindings ALREADY
        // in scope before pushing it, which is what makes `Nested<Point>` holding a `Pair<T>` come
        // out as `Pair<Point>` rather than rebinding `T` to itself. The match-arm caller binds it
        // exactly this way.
        let bound: Int = self.bind_from_application(src, t);
    }
    let found: Int = self.find_type(src, t.name_start, t.name_length);
    if found < 0 {
        let dropped: Int = truncate(self.type_bindings, bindings_base);
        return true;                                 // a name this compiler cannot resolve
    }
    let decl: TypeDeclaration = self.types[found];
    let mutable w: Int = 0;
    while w < len(self.walked_types) {
        if self.walked_types[w] == found {
            let dropped: Int = truncate(self.type_bindings, bindings_base);
            return false;                            // already entered; not a fresh path
        }
        w += 1;
    }
    let depth: Int = len(self.walked_types);
    let added: Int = push(self.walked_types, found);
    let item: Node = self.nodes[decl.node];
    let mutable answer: Bool = false;
    if decl.kind == 82 {                             // a class: every field
        let mutable f: Int = 0;
        while f < item.b {
            let field: Node = self.nodes[self.children[item.a + f]];
            if self.may_be_region_storage(src, self.declared_type(src, field.a)) {
                answer = true;
            }
            f += 1;
        }
    }
    if decl.kind == 83 {                             // an enum: every variant's every payload
        let mutable v: Int = 0;
        while v < item.b {
            let variant: Node = self.nodes[self.children[item.a + v]];
            let mutable p: Int = 0;
            while p < variant.c {
                let carried: Type = self.declared_type(src, self.nested_children[variant.b + p]);
                if self.may_be_region_storage(src, carried) {
                    answer = true;
                }
                p += 1;
            }
            v += 1;
        }
    }
    let dropped: Int = truncate(self.walked_types, depth);
    let unbound: Int = truncate(self.type_bindings, bindings_base);
    return answer;
}

// ---- B37: a function may not hand its region back, and stage-1 had no such rule ----------------
//
// `function same(xs: [String]) -> [String] { return xs; }` was ACCEPTED by stage-1 and refused by
// stage-0 at the declaration — a whole rule missing rather than a wording difference, and verified
// with **no `region` anywhere in the program**, so it is independent of the escape family that
// `expr_allocates` serves. The direction is worth holding on to: stage-0 is the stricter one here,
// which is the opposite of B33 and B34. Neither compiler is reliably the conservative one.
//
// UNLESS the function allocates. `allocates` says the storage belongs to the CALLER's region and
// therefore outlives the call by construction, so `function make() -> [Int] allocates` is fine —
// and so is one that plainly builds its answer without saying the word, because `infer_allocates`
// works that out. That is why this is a PASS of its own between the inference and the bodies
// rather than a line in `collect_declarations`: the answer does not exist yet when declarations are
// collected, and stage-0 has exactly the same ordering problem, solved with `!self.probing` on a
// declaration pass it runs twice.
//
// Before the bodies, because `complain_at` records only the FIRST problem and that is the one
// `diag.bx` renders. `L15_relay_returns_a_slice_param` in the audit corpus was refused by both
// compilers for DIFFERENT reasons — stage-0 by this rule at the declaration, stage-1 by the relay
// rule at the assignment inside the body — and running this pass first is what makes the two agree
// on the reason as well as the verdict.
//
// Functions only. A method returning `[Int]` is accepted by BOTH compilers, measured — stage-0's
// rule lives in `for f in &prog.fns` and never sees a method or an `external`. Widening it here
// would be stage-1 being cleverer alone, which is the thing B36 and B37 both exist to stop.
function (mutable self: Unit) check_return_storage(src: String) -> Int {
    let mutable i: Int = 0;
    while i < len(self.items) {
        let index: Int = self.items[i];
        let item: Node = self.nodes[index];
        if item.kind == 80 {
            let name: Token = self.tokens[item.token];
            let found: Int = self.find_function(src, name.start, name.length);
            if found >= 0 {
                // The STORED signature, not the node's flags: the probe writes `allocates` back
                // there, and reading the node would see only what was literally written.
                let declared: DeclaredFunction = self.functions[found];
                if flag_allocates(declared.flags) == 0
                        && self.relays_any_parameter(found) == false
                        && self.region_allocated(src, declared.return_type) {
                    let complained: Int = self.complain_at(src, item.token,
                                "function `" + substring(src, name.start, name.length)
                                + "` cannot return " + self.show_type(src, declared.return_type)
                                + ", because its storage lives in a region and would not outlive it. "
                            + "Fill an array the caller owns, or return a scalar summary.");
                }
            }
        }
        i += 1;
    }
    return self.problems;
}

// ================================================================================================
// A12 / M14 slice 3 — per-block release
// ================================================================================================
//
// One question, asked once per block instead of once per assignment:
//
//     does anything allocated inside this block reach a binding declared outside it?
//
// If the answer is no, the block's node is marked in `block_release` and `emit_block` takes a bump
// mark at the opening brace and puts the cursor back at the closing one. If the answer is yes — or
// if this pass does not RECOGNISE the construct well enough to answer — the block is left exactly
// as it was, which is the behaviour before A12 existed. That asymmetry is the whole safety
// argument: a wrong guess costs memory, never correctness (spec/1.0/M14-IMPLICIT-REGIONS.md §10, "no
// guessing inward"), and it is why every unhandled arm below taints rather than falling through.
//
// ALL-OR-NOTHING PER BLOCK, per §9b Decision 3. A bump allocator is LIFO, so there is no way to
// place one value below the current mark while the block keeps allocating above it; the moment one
// value escapes, restoring the cursor would free it along with everything else. So a block that
// fails the proof does not release at all.
//
// This is a POST-pass over the already-checked bodies, and deliberately not a set of lines added to
// the checking arms. **It cannot complain.** Nothing here calls `complain_at`, nothing here reads
// `self.problems`, and it runs after every body is checked — so acceptance item 3 (*every existing
// `tests/pass` program compiles unchanged*) is true by construction rather than by testing, and the
// tests then confirm it. That is the shape stage-0 chose two versions ago, mirrored here for the
// same reason it chose it: an explicit `region` inside an implicitly-releasing block is not
// "nesting" as far as the checker is concerned, so the rule that refuses nested regions needed no
// change in either compiler.
//
// **The proof obligation is not a new analysis.** B20–B45 built it — does a value allocated here
// reach a binding declared outside, by assignment, growth, a field, an element, `return`, a
// `mutable` parameter, a `dynamic`, a pattern binding, a field read, or a relay — and `expr_allocates`
// is where it is asked. This pass asks that same function, with `placing` set so a bare name reads
// this pass's scope instead of the checker's; see the arm in parser.bx.

// How deep the walk is, as an index into `rel_frames`. The innermost open block.
function (self: Unit) rel_depth() -> Int {
    return len(self.rel_frames) - 1;
}

// Mark every block INSIDE `owner` as unable to release. An allocation that lands in storage owned
// by block *k* has to survive until *k* ends, so every block nested in it must leave the cursor
// alone. -1 — the caller's storage, or a `return` — taints the whole function.
function (mutable self: Unit) rel_taint(owner: Int) -> Int {
    let mutable from: Int = 0;
    if owner >= 0 {
        from = owner + 1;
    }
    let mutable i: Int = from;
    while i < len(self.rel_frames) {
        let was: ReleaseFrame = self.rel_frames[i];
        self.rel_frames[i] = ReleaseFrame { leaks: 1, allocates: was.allocates, base: was.base };
        i += 1;
    }
    return 1;
}

// Something was built. Every open frame at once, which is why `rel_close` needs no propagation
// step: an ancestor already knows about anything its children built.
function (mutable self: Unit) rel_mark_allocates() -> Int {
    let mutable i: Int = 0;
    while i < len(self.rel_frames) {
        let was: ReleaseFrame = self.rel_frames[i];
        self.rel_frames[i] = ReleaseFrame { leaks: was.leaks, allocates: 1, base: was.base };
        i += 1;
    }
    return 1;
}

function (mutable self: Unit) rel_declare(start: Int, length: Int, owner: Int,
        allocated: Int) -> Int {
    push(self.rel_names, OwnedName { start: start, length: length, owner: owner,
            allocated: allocated });
    return 1;
}

// The innermost name with this span, or -1. Backwards, so an inner block's name wins — Burxt does
// not shadow, so in practice there is at most one, and searching from the top is what makes that a
// property of the search rather than a thing to rely on.
function (self: Unit) rel_find(src: String, start: Int, length: Int) -> Int {
    let mutable i: Int = len(self.rel_names);
    while i > 0 {
        i -= 1;
        let known: OwnedName = self.rel_names[i];
        if spans_equal(src, known.start, known.length, start, length) {
            return i;
        }
    }
    return 0 - 1;
}

// Whose storage does this name hold? -1 for a name this pass never declared — which means a
// parameter, or something it did not recognise — and that is the answer that permits nothing.
//
// A `const` is the one exception, and it is what makes the two compilers agree rather than a
// relaxation of anything. **Stage-0's release pass never meets a const as a name**: `check_expr`
// replaces the `Var` with the folded literal, so by the time its `place_owner` runs the const is a
// `StrLit`. Stage-1 keeps the name and emits the literal at the use, so without this line a const
// would read as a name from outside the function — and one later store into a binding built from
// it would stop the whole body releasing, on a value that lives in `.rodata` and can neither be
// released nor alias anything that can.
function (self: Unit) rel_owner_of(src: String, start: Int, length: Int) -> Int {
    let found: Int = self.rel_find(src, start, length);
    if found >= 0 {
        return self.rel_names[found].owner;
    }
    if self.find_const(src, start, length) >= 0 {
        return self.rel_depth();
    }
    return 0 - 1;
}

// What `expr_allocates` reads for a bare name while this pass runs.
function (self: Unit) rel_allocated(src: String, start: Int, length: Int) -> Bool {
    let found: Int = self.rel_find(src, start, length);
    if found < 0 {
        return false;
    }
    return self.rel_names[found].allocated == 1;
}

function (mutable self: Unit) rel_mark_allocated(src: String, start: Int, length: Int) -> Int {
    let found: Int = self.rel_find(src, start, length);
    if found < 0 {
        return 0;
    }
    let was: OwnedName = self.rel_names[found];
    self.rel_names[found] = OwnedName { start: was.start, length: was.length, owner: was.owner,
            allocated: 1 };
    return 1;
}

// The shorter of two lifetimes, with -1 (outside the function) the shortest of all from this pass's
// point of view — it is the one that permits nothing.
function rel_shorter(a: Int, b: Int) -> Int {
    if a < 0 || b < 0 {
        return 0 - 1;
    }
    if a < b {
        return a;
    }
    return b;
}

// Whose storage could this expression be pointing INTO? The current block, unless it mentions a
// name that belongs further out — in which case it may well be an alias of that name's buffer, and
// growing it grows theirs.
function (mutable self: Unit) rel_place_owner(src: String, node: Int) -> Int {
    return self.rel_owner_in(src, node, self.rel_depth());
}

// Every name this expression reads, folded into the shortest lifetime among them. Used only to
// place storage conservatively, so over-collecting costs a release opportunity and never
// correctness — and the final arm, which answers -1 for a node kind this walk does not know, is
// that principle written down: an unrecognised expression is assumed to reach outside.
function (mutable self: Unit) rel_owner_in(src: String, node: Int, acc: Int) -> Int {
    if node < 0 || acc < 0 {
        return acc;
    }
    let n: Node = self.nodes[node];
    if n.kind == 1 || n.kind == 2 || n.kind == 3 || n.kind == 4 || n.kind == 21 {
        return acc;                                  // a literal, or the value being returned
    }
    if n.kind == 5 {                                 // a name
        let named: Token = self.tokens[n.token];
        return rel_shorter(acc, self.rel_owner_of(src, named.start, named.length));
    }
    if n.kind == 6 || n.kind == 7 || n.kind == 11 || n.kind == 22 {
        return self.rel_owner_in(src, n.a, acc);     // -e, !e, e.field, e?
    }
    if n.kind == 8 || n.kind == 9 || n.kind == 10 || n.kind == 12 {
        let left: Int = self.rel_owner_in(src, n.a, acc);
        return self.rel_owner_in(src, n.b, left);
    }
    if n.kind == 13 {                                // a call: its arguments
        return self.rel_owner_in_list(src, n.a, acc);
    }
    if n.kind == 14 {                                // a method call: the receiver and the arguments
        let base: Int = self.rel_owner_in(src, n.a, acc);
        return self.rel_owner_in_list(src, n.b, base);
    }
    if n.kind == 17 || n.kind == 18 {                // an array literal, an interpolated String
        let mutable folded: Int = acc;
        let mutable i: Int = 0;
        while i < n.b {
            folded = self.rel_owner_in(src, self.children[n.a + i], folded);
            i += 1;
        }
        return folded;
    }
    // A class literal. Its children are field PAIRS — kind 18 with the value in `a` and `b` at zero
    // — not the values themselves, which is one level deeper than an array literal's and the same
    // trap `expr_allocates` records: reading the pair as if it were the value walks nothing.
    if n.kind == 19 {
        let mutable folded: Int = acc;
        let mutable i: Int = 0;
        while i < n.b {
            let pair: Node = self.nodes[self.children[n.a + i]];
            folded = self.rel_owner_in(src, pair.a, folded);
            i += 1;
        }
        return folded;
    }
    return 0 - 1;
}

function (mutable self: Unit) rel_owner_in_list(src: String, list_node: Int, acc: Int) -> Int {
    if list_node < 0 {
        return acc;
    }
    let list: Node = self.nodes[list_node];
    let mutable folded: Int = acc;
    let mutable i: Int = 0;
    while i < list.b {
        folded = self.rel_owner_in(src, self.children[list.a + i], folded);
        i += 1;
    }
    return folded;
}

// A store THROUGH `place` — the argument of a `push`, a `mutable` parameter, a mutating receiver.
// Whoever owns that buffer keeps the growth, so the cursor cannot go back past it until they are
// done; and the name now holds storage built here, so reading it later is reading region storage.
function (mutable self: Unit) rel_written_through(src: String, place: Int) -> Int {
    let owner: Int = self.rel_place_owner(src, place);
    let tainted: Int = self.rel_taint(owner);
    let root: Int = self.lvalue_root(place);
    if root >= 0 {
        let named: Token = self.tokens[self.nodes[root].token];
        let marked: Int = self.rel_mark_allocated(src, named.start, named.length);
    }
    return 1;
}

// A store INTO `name`, reached however. If what is stored was built here, then whoever owns
// `name`'s storage keeps it, and no block inside them may release.
function (mutable self: Unit) rel_store(src: String, name_start: Int, name_length: Int,
        value: Int) -> Int {
    if !self.expr_allocates(src, value) {
        return 0;
    }
    let owner: Int = self.rel_owner_of(src, name_start, name_length);
    let tainted: Int = self.rel_taint(owner);
    return self.rel_mark_allocated(src, name_start, name_length);
}

// Walk an expression for the ways it can hand storage to somebody who outlives this block, and
// class what it builds.
function (mutable self: Unit) rel_scan(src: String, node: Int) -> Int {
    if node < 0 {
        return 0;
    }
    let n: Node = self.nodes[node];
    if self.expr_allocates(src, node) {
        let built: Int = self.rel_mark_allocates();
    }
    if n.kind == 13 {
        return self.rel_scan_call(src, node, n);
    }
    if n.kind == 14 {
        return self.rel_scan_method(src, node, n);
    }
    // `?` leaves the function from the middle of a block, carrying an error value the callee built
    // — which means built HERE, above this block's mark. Releasing on the way out would hand back
    // freed bytes.
    if n.kind == 22 {
        let leaves: Int = self.rel_taint(0 - 1);
        return self.rel_scan(src, n.a);
    }
    if n.kind == 1 || n.kind == 2 || n.kind == 3 || n.kind == 4 || n.kind == 5 || n.kind == 21 {
        return 1;                                    // a literal, a name, the returned value
    }
    if n.kind == 6 || n.kind == 7 || n.kind == 11 {
        return self.rel_scan(src, n.a);
    }
    if n.kind == 8 || n.kind == 9 || n.kind == 10 || n.kind == 12 {
        let left: Int = self.rel_scan(src, n.a);
        return self.rel_scan(src, n.b);
    }
    if n.kind == 17 || n.kind == 18 {
        let mutable i: Int = 0;
        while i < n.b {
            let walked: Int = self.rel_scan(src, self.children[n.a + i]);
            i += 1;
        }
        return 1;
    }
    if n.kind == 19 {
        let mutable i: Int = 0;
        while i < n.b {
            let pair: Node = self.nodes[self.children[n.a + i]];
            let walked: Int = self.rel_scan(src, pair.a);
            i += 1;
        }
        return 1;
    }
    // A node kind this pass has never met. Refuse to guess: taint the function, and every block in
    // it stops releasing. §10's direction, and it is what makes adding an expression kind safe —
    // the new kind costs memory until someone teaches this walk about it, rather than silently
    // inheriting "reaches nobody".
    return self.rel_taint(0 - 1);
}

// A call. Three things can carry storage outward through one: `push` growing its first argument,
// a `mutable` parameter the callee writes into, and the C boundary, where nothing can be proven.
function (mutable self: Unit) rel_scan_call(src: String, node: Int, n: Node) -> Int {
    let name: Token = self.tokens[n.token];
    let list: Node = self.nodes[n.a];
    // `push` grows the buffer behind its first argument. Stage-0 has this as its own expression
    // kind; here it is a builtin call, and it is the one builtin that writes through an argument.
    if span_equal(src, name.start, name.length, "push") && list.b == 2 {
        let wrote: Int = self.rel_written_through(src, self.children[list.a]);
        let built: Int = self.rel_mark_allocates();
        return self.rel_scan_arguments(src, n.a);
    }
    let found: Int = self.find_function(src, name.start, name.length);
    if found >= 0 {
        // Across the C boundary nothing can be proven: the callee may keep the pointer we handed it
        // for as long as it likes.
        if flag_external(self.functions[found].flags) == 1 {
            let opaque: Int = self.rel_taint(0 - 1);
            return self.rel_scan_arguments(src, n.a);
        }
        let params: Node = self.nodes[self.functions[found].parameters];
        let mutable i: Int = 0;
        while i < list.b && i < params.b {
            let param: Node = self.nodes[self.children[params.a + i]];
            if param.b == 1 {                        // `b` is the `mutable` flag
                let wrote: Int = self.rel_written_through(src, self.children[list.a + i]);
            }
            i += 1;
        }
        return self.rel_scan_arguments(src, n.a);
    }
    // A builtin other than `push` answers a value it computed and writes through nothing:
    // `truncate` only shrinks, and the rest read. Anything else is a callee this pass cannot find,
    // and an unfindable callee is assumed to write into everything it was given.
    if builtin_arity(substring(src, name.start, name.length)) < 0 {
        let unknown: Int = self.rel_taint(0 - 1);
    }
    return self.rel_scan_arguments(src, n.a);
}

// A method call, which is also how an enum variant is constructed and how a `dynamic` is reached.
function (mutable self: Unit) rel_scan_method(src: String, node: Int, n: Node) -> Int {
    let base: Node = self.nodes[n.a];
    // `Enum.Variant(payload)` — the base is a type name rather than a value, so there is no
    // receiver to write through. Told apart the way `expr_allocates` tells it apart.
    if base.kind == 5 {
        let base_name: Token = self.tokens[base.token];
        let declared: Int = self.find_type(src, base_name.start, base_name.length);
        if declared >= 0 && self.types[declared].kind == 83 {
            return self.rel_scan_arguments(src, n.b);
        }
    }
    let holder: Type = self.type_at(n.a);
    // Behind a vtable, so no call site can see which implementation runs. The receiver is the only
    // thing an interface signature can say `mutable` about that this pass can place, and the
    // implementations may disagree about the rest — so the honest answer is the conservative one.
    if holder.kind == 49 {
        let opaque: Int = self.rel_taint(0 - 1);
        let walked: Int = self.rel_scan(src, n.a);
        return self.rel_scan_arguments(src, n.b);
    }
    let found: Int = self.find_method(src, holder, n.token);
    if found < 0 {
        let unknown: Int = self.rel_taint(0 - 1);
        let walked: Int = self.rel_scan(src, n.a);
        return self.rel_scan_arguments(src, n.b);
    }
    if self.methods[found].mutating == 1 {
        let wrote: Int = self.rel_written_through(src, n.a);
    }
    let params: Node = self.nodes[self.methods[found].parameters];
    let list: Node = self.nodes[n.b];
    let mutable i: Int = 0;
    while i < list.b && i < params.b {
        let param: Node = self.nodes[self.children[params.a + i]];
        if param.b == 1 {
            let wrote: Int = self.rel_written_through(src, self.children[list.a + i]);
        }
        i += 1;
    }
    let walked: Int = self.rel_scan(src, n.a);
    return self.rel_scan_arguments(src, n.b);
}

function (mutable self: Unit) rel_scan_arguments(src: String, list_node: Int) -> Int {
    if list_node < 0 {
        return 0;
    }
    let list: Node = self.nodes[list_node];
    let mutable i: Int = 0;
    while i < list.b {
        let walked: Int = self.rel_scan(src, self.children[list.a + i]);
        i += 1;
    }
    return 1;
}

// ---- the blocks ------------------------------------------------------------------------------

function (mutable self: Unit) rel_open() -> Int {
    push(self.rel_frames, ReleaseFrame { leaks: 0, allocates: 0, base: len(self.rel_names) });
    return 1;
}

// The closing brace. Drops the names the block declared, and records the verdict on its node.
//
// `may_release` is 0 for the body of a `region` the programmer wrote, which already releases at
// exactly this point — a second mark and a second store would do nothing — and for the top level,
// which has nothing after it to release into and whose arena the process exit reclaims whole.
function (mutable self: Unit) rel_close(block: Int, may_release: Int) -> Int {
    let last: Int = len(self.rel_frames) - 1;
    let frame: ReleaseFrame = self.rel_frames[last];
    let popped: Int = truncate(self.rel_frames, last);
    let dropped: Int = truncate(self.rel_names, frame.base);
    if may_release == 1 && frame.allocates == 1 && frame.leaks == 0 {
        return self.note_release(block);
    }
    return 0;
}

function (mutable self: Unit) note_release(block: Int) -> Int {
    if block < 0 || block >= len(self.block_release) {
        return 0;
    }
    self.block_release[block] = 1;
    return 1;
}

// What `emit_block` asks. Out of range is 0, so a Unit that never ran the pass — the LSP's, the
// schema tool's — emits exactly what it emitted before A12.
function (self: Unit) block_releases(block: Int) -> Bool {
    if block < 0 || block >= len(self.block_release) {
        return false;
    }
    return self.block_release[block] == 1;
}

function (mutable self: Unit) rel_walk_block(src: String, block: Int) -> Int {
    if block < 0 {
        return 0;
    }
    let node: Node = self.nodes[block];
    if node.kind != 16 {
        return self.rel_stmt(src, block);
    }
    let mutable i: Int = 0;
    while i < node.b {
        let walked: Int = self.rel_stmt(src, self.children[node.a + i]);
        i += 1;
    }
    return node.b;
}

// A nested block with no bindings of its own: an `if` arm, a `while` body, a `region` body.
function (mutable self: Unit) rel_block(src: String, block: Int, may_release: Int) -> Int {
    let opened: Int = self.rel_open();
    let walked: Int = self.rel_walk_block(src, block);
    return self.rel_close(block, may_release);
}

function (mutable self: Unit) rel_stmt(src: String, stmt: Int) -> Int {
    if stmt < 0 {
        return 0;
    }
    let here: Int = self.rel_depth();
    let n: Node = self.nodes[stmt];

    if n.kind == 60 {                                // let
        let scanned: Int = self.rel_scan(src, n.b);
        let owner: Int = self.rel_place_owner(src, n.b);
        let mutable built: Int = 0;
        if self.expr_allocates(src, n.b) {
            built = 1;
        }
        let named: Token = self.tokens[n.token];
        return self.rel_declare(named.start, named.length, owner, built);
    }

    if n.kind == 61 {                                // assignment
        let scanned: Int = self.rel_scan(src, n.b);
        let target: Node = self.nodes[n.a];
        // The INDEX of `xs[i] = v` is an ordinary expression and may itself build something.
        if target.kind != 5 {
            let walked: Int = self.rel_scan(src, n.a);
        }
        let root: Int = self.lvalue_root(n.a);
        if root < 0 {
            // A write with no name behind it is not something this pass can place.
            return self.rel_taint(0 - 1);
        }
        let named: Token = self.tokens[self.nodes[root].token];
        // A whole-name assignment may make the name ALIAS something older than it is; a write
        // through a field or an index does not rebind the name, so its owner stands.
        if target.kind == 5 {
            let found: Int = self.rel_find(src, named.start, named.length);
            if found >= 0 {
                let was: OwnedName = self.rel_names[found];
                self.rel_names[found] = OwnedName { start: was.start, length: was.length,
                            owner: rel_shorter(was.owner,
                            self.rel_place_owner(src, n.b)),
                        allocated: was.allocated };
            }
        }
        return self.rel_store(src, named.start, named.length, n.b);
    }

    if n.kind == 62 {                                // print
        // An interpolation ARGUMENT of a `print` is not joined — the pieces go out in order — so
        // the pieces are scanned rather than the node, which would answer "this allocates" for a
        // statement that allocates nothing. Stage-0's `PrintInterp` walks its parts the same way.
        if n.a < 0 {
            return 0;
        }
        let printed: Node = self.nodes[n.a];
        if printed.kind == 18 {
            let mutable i: Int = 0;
            while i < printed.b {
                let walked: Int = self.rel_scan(src, self.children[printed.a + i]);
                i += 1;
            }
            return 1;
        }
        return self.rel_scan(src, n.a);
    }

    if n.kind == 63 {                                // return
        let scanned: Int = self.rel_scan(src, n.a);
        if self.expr_allocates(src, n.a) {
            return self.rel_taint(0 - 1);            // whatever is handed back outlives every block
        }
        return 1;
    }

    // `musttail` requires the call to sit immediately before the `ret`, with nothing in between —
    // and a release is something in between. So no block containing one may release.
    if n.kind == 64 {                                // return tail
        let scanned: Int = self.rel_scan(src, n.a);
        return self.rel_taint(0 - 1);
    }

    if n.kind == 65 {                                // if
        let scanned: Int = self.rel_scan(src, n.a);
        let then_side: Int = self.rel_block(src, n.b, 1);
        if n.c >= 0 {
            let else_side: Int = self.rel_block(src, n.c, 1);
        }
        return 1;
    }

    if n.kind == 66 {                                // while
        let scanned: Int = self.rel_scan(src, n.a);
        return self.rel_block(src, n.b, 1);
    }

    if n.kind == 67 || n.kind == 68 {                // break, continue
        return 1;
    }

    // A `region` the programmer wrote already releases at this exact point, so there is nothing for
    // a second wrapper to do — but its body is still a block, and names declared in it belong to it.
    if n.kind == 69 {
        return self.rel_block(src, n.a, 0);
    }

    if n.kind == 70 {                                // an expression statement
        return self.rel_scan(src, n.a);
    }

    if n.kind == 71 {                                // match
        let scanned: Int = self.rel_scan(src, n.a);
        // A payload name ALIASES the subject's cells — B27's rule — so it takes the subject's owner
        // and the subject's taint, not this block's.
        let owner: Int = self.rel_place_owner(src, n.a);
        let mutable built: Int = 0;
        if self.expr_allocates(src, n.a) {
            built = 1;
        }
        let mutable i: Int = 0;
        while i < n.c {
            let arm: Node = self.nodes[self.children[n.b + i]];
            let opened: Int = self.rel_open();
            let mutable p: Int = 0;
            while p < arm.c {
                let bound: Token = self.tokens[self.nested_children[arm.b + p]];
                let named: Int = self.rel_declare(bound.start, bound.length, owner, built);
                p += 1;
            }
            let walked: Int = self.rel_walk_block(src, arm.a);
            let closed: Int = self.rel_close(arm.a, 1);
            i += 1;
        }
        return 1;
    }

    if n.kind == 72 {                                // for x in xs
        let scanned: Int = self.rel_scan(src, n.a);
        let owner: Int = self.rel_place_owner(src, n.a);
        let mutable built: Int = 0;
        if self.expr_allocates(src, n.a) {
            built = 1;
        }
        let named: Token = self.tokens[n.token];
        let opened: Int = self.rel_open();
        let bound: Int = self.rel_declare(named.start, named.length, owner, built);
        let walked: Int = self.rel_walk_block(src, n.b);
        return self.rel_close(n.b, 1);
    }

    if n.kind == 74 {                                // for i in a..b
        let start: Int = self.rel_scan(src, n.a);
        let stop: Int = self.rel_scan(src, n.c);
        let named: Token = self.tokens[n.token];
        let opened: Int = self.rel_open();
        // The counter is an Int copied into the binding's own slot, so it owns nothing and holds
        // nothing — `here` rather than the subject's owner, because there is no subject.
        let bound: Int = self.rel_declare(named.start, named.length, here, 0);
        let walked: Int = self.rel_walk_block(src, n.b);
        return self.rel_close(n.b, 1);
    }

    // `const` is an item, not a statement, and nothing else reaches here.
    return 0;
}

// One body. `params` are the names that arrived from outside — their storage is the caller's, so
// nothing this body does to them may be released here.
function (mutable self: Unit) rel_body(src: String, index: Int) -> Int {
    let item: Node = self.nodes[index];
    let opened: Int = self.rel_open();
    if item.kind == 81 && flag_associated(item.value) == 0 {
        let word: Token = self.tokens[self.self_token(item.token)];
        let receiver: Int = self.rel_declare(word.start, word.length, 0 - 1, 0);
    }
    let params: Node = self.nodes[item.a];
    let mutable p: Int = 0;
    while p < params.b {
        let param: Node = self.nodes[self.children[params.a + p]];
        let name: Token = self.tokens[param.token];
        let declared: Int = self.rel_declare(name.start, name.length, 0 - 1, 0);
        p += 1;
    }
    let walked: Int = self.rel_walk_block(src, item.b);
    return self.rel_close(item.b, 1);
}

// Every body, and then the top level. Runs LAST, once every table this reads is final: the
// `allocates` flags and the relay and growth sets are filled by `infer_allocates`, and asking any
// earlier would ask half the program.
function (mutable self: Unit) place_releases(src: String) -> Int {
    // One slot per node, filled once rather than grown at each answer.
    let dropped: Int = truncate(self.block_release, 0);
    let mutable n: Int = 0;
    while n < len(self.nodes) {
        let filled: Int = push(self.block_release, 0);
        n += 1;
    }
    let cleared: Int = truncate(self.rel_frames, 0);
    let forgotten: Int = truncate(self.rel_names, 0);
    self.placing = 1;
    // The top level is a block for scoping and NOT for release: there is nothing after it to
    // release into, and the process exit reclaims the arena whole. Its inner blocks are, which is
    // where §3's loop lives.
    let opened: Int = self.rel_open();
    let mutable i: Int = 0;
    while i < len(self.items) {
        let index: Int = self.items[i];
        let item: Node = self.nodes[index];
        if item.kind == 80 || item.kind == 81 {
            let placed: Int = self.rel_body(src, index);
        }
        if item.kind == 85 {                         // an implementation block's methods
            let mutable k: Int = 0;
            while k < item.b {
                let placed: Int = self.rel_body(src, self.children[item.a + k]);
                k += 1;
            }
        }
        if (item.kind >= 60 && item.kind <= 72) || item.kind == 74 {
            let walked: Int = self.rel_stmt(src, index);
        }
        i += 1;
    }
    let closed: Int = self.rel_close(0 - 1, 0);
    self.placing = 0;
    return 1;
}

// Work out which functions and methods allocate, so `allocates` need not be written.
//
// A least fixpoint, and it iterates rather than asking once because the answer travels along
// the call graph: `a` allocates because it calls `b`, which allocates because it calls `c`.
// One round per link, plus one to confirm nothing new — a 4-deep forwarding chain takes 5,
// and the compiler's own 8,300 lines take 2, because nearly everything that allocates does
// so directly.
//
// Rounds are safe to repeat, which is not luck but two properties worth naming:
//   * the `typed` cache is a slot per NODE and the last answer for a node stands, so a
//     second reading overwrites rather than appends;
//   * `complain_at` is silent while probing, so nothing a round found is reported.
// Bindings are already truncated per body by `check_body`.
//
// Terminates because the flags only ever go from 0 to 1, over a finite number of signatures.
// The ceiling is a backstop for that argument being wrong, not an expectation.
function (mutable self: Unit) infer_allocates(src: String) -> Int {
    self.probing = 1;
    let ceiling: Int = len(self.functions) + len(self.methods) + 1;
    // Where the binding stack stood before any round ran.
    //
    // `check_body` truncates back to its own base, so a FUNCTION body leaves nothing behind
    // — but a top-level statement declares into the same stack and nothing pops it, because
    // in a single pass nothing ever needed to. Two passes, and the real one met every
    // top-level name already declared: `this name is already declared — Burxt does not
    // shadow`, on 68 of 109 programs. The rounds have to leave the stack where they found it.
    let base: Int = len(self.bindings);
    let mutable round: Int = 0;
    while round < ceiling {
        self.probe_changes = 0;
        let swept: Int = self.check_bodies(src);
        let dropped: Int = truncate(self.bindings, base);
        if self.probe_changes == 0 {
            break;
        }
        round += 1;
    }
    self.probing = 0;
    return round;
}

function (mutable self: Unit) check(src: String) -> Int {
    // The consts first: a body anywhere may read one, so the value has to exist before the
    // first name is resolved.
    let folded: Int = self.fold_consts(src);
    let collected: Int = self.collect_declarations(src);
    // Every type a DECLARATION names must exist, and it can only be asked once every declaration
    // is in: a type may name any type the program declares, including itself. See the pass.
    let names: Int = self.check_declared_type_names(src);
    let applications: Int = self.check_applications(src);
    // Before anything is refused: a body may call a function declared 200 lines below it, so
    // the answer has to exist before the first body is read. That ordering is the only reason
    // `allocates` was ever required — the compiler always computed it.
    let inferred: Int = self.infer_allocates(src);
    // B37, and the ORDER is the rule: after the inference, because `allocates` excuses the
    // signature; before the bodies, because stage-0 refuses at the declaration and only the first
    // problem is the one a reader is shown.
    let returns: Int = self.check_return_storage(src);
    let checked: Int = self.check_bodies(src);
    // A12, and it is LAST for two reasons. It reads what the inference settled, so anything earlier
    // would ask half the program; and it decides only WHERE storage is released, so a program with
    // an error has nothing for it to decide — the emitter never runs.
    if self.problems == 0 {
        let placed: Int = self.place_releases(src);
    }
    return self.problems;
}

function (mutable self: Unit) check_bodies(src: String) -> Int {
    let mutable i: Int = 0;
    while i < len(self.items) {
        let index: Int = self.items[i];
        let item: Node = self.nodes[index];
        if item.kind == 80 || item.kind == 81 {
            let checked: Int = self.check_body(src, index);
        }
        if item.kind == 85 {                         // an implementation block's methods
            let answered: Int = self.check_impl(src, index);
            let mutable k: Int = 0;
            while k < item.b {
                let checked: Int = self.check_body(src, self.children[item.a + k]);
                k += 1;
            }
        }
        // `|| == 74` rather than `<= 74`: 73 is `const`, an ITEM, and the comment on statement
        // kind 73 in ast.bx says explicitly that it must stay outside this run. Widening the
        // bound would have compiled and swept it in.
        if (item.kind >= 60 && item.kind <= 72) || item.kind == 74 {  // a top-level statement
            let checked: Int = self.check_stmt_node(src, index, unknown_type());
        }
        i += 1;
    }
    return self.problems;
}

// ---- reporting -------------------------------------------------------------
function kind_name(kind: Int) -> String {
    if kind == 1 { return "ident"; }
    if kind == 2 { return "int"; }
    if kind == 3 { return "decimal"; }
    if kind == 4 { return "string"; }
    if kind >= 140 { return "type"; }
    if kind >= 100 { return "keyword"; }
    return "punct";
}

function (self: Unit) report(src: String, limit: Int) -> Int {
    let mutable i: Int = 0;
    while i < len(self.tokens) && i < limit {
        let t: Token = self.tokens[i];
        let text: String = substring(src, t.start, t.length);
        if t.kind == 3 {
            print("  decimal " + text + " -> unscaled " + to_string(t.value)
                    + " scale " + to_string(t.scale));
        } else {
            print("  " + kind_name(t.kind) + " `" + text + "`");
        }
        i += 1;
    }
    return i;
}

function (self: Unit) count_of(kind: Int) -> Int {
    let mutable found = 0;
    for t in self.tokens {
        if t.kind == kind {
            found += 1;
        }
    }
    return found;
}
