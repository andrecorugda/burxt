// ============================================================================
// The test suite, in Burxt.
//
//     burxt build tests/runner.bx -o /tmp/burxt-runner
//     /tmp/burxt-runner [compiler] [work-dir] [only]
//
// `only` is empty for everything, `pass` for one kind, `pass/name` for one fixture, `invariant`
// for every invariant, or `invariant/name` for one of those.
//
// It runs the same fixtures `tests/runner.rs` runs, and a Rust test asserts the
// two agree — so this is a second implementation of the harness, not a
// replacement for it, the same relationship stage-1 has with stage-0.
//
// Three kinds of fixture, and the directory says which:
//   tests/pass/NAME.bx   + NAME.stdout   must compile, run, and print that
//   tests/fail/NAME.bx   + NAME.stderr   must be REFUSED, with that text in the message
//   tests/panic/NAME.bx  + NAME.stderr   must compile, then die with that text
//
// Everything it needs from the machine goes through one C function. Burxt cannot
// yet list a directory — `opendir` returns a pointer, and the memory model has
// nothing to say about who owns it — so the shell lists it and the answer comes
// back through a file. That is a real limit, honestly worked around rather than
// pretended away, and it is the first thing the standard library will hide.
// ============================================================================

external function system(command: String) -> CInt;

// Whether a path can be opened for reading. **The only guard there is**: `read_file` does not
// answer a failure, it ENDS THE PROCESS — `burxt runtime error: cannot open file for reading`.
//
// It is here because of a measured hole, not a hypothetical one. A fixture whose `.stdout` was
// missing killed this runner outright: no verdict, no summary, and the crash line arrived BEFORE
// the banner because the abort discarded stdout's buffer. A contributor adding `foo.bx` and
// forgetting `foo.stdout` got a dead runner instead of "foo has no .stdout". For a file that is
// about to become the suite's primary authority that is the wrong failure shape — an authority
// must report, not die.
external function fopen(path: String, mode: String) -> CPointer touches files;
external function fclose(stream: CPointer) -> CInt touches files;

// B5. `read_file` answers a String, and from v0.0.284 a String is CHECKED to be UTF-8 where it
// enters. The mascot is a GIF, so it can no longer come in that way — which is the stated cost of
// enforcing the invariant, arriving here first because this file is the only thing in the tree that
// reads a binary format.
//
// So the bytes get their own door. `fread` into a buffer and `c_bytes_at` to copy it out is exactly
// what `lib/files.bx`'s `file_read_bytes` does; it is spelled again here rather than imported
// because this runner reaches the machine through its own externals on purpose — it is the second
// implementation of the harness, and a second implementation that borrows the first's library is
// not independent of it.
external function malloc(size: Int) -> CPointer;
external function fread(into: CPointer, size: Int, count: Int, stream: CPointer) -> Int touches files;

function read_bytes(path: String) -> [Int] touches files {
    let empty: [Int] = [];
    let f: CPointer = fopen(path, "rb");
    if c_is_null(f) {
        return empty;
    }
    // One generous buffer rather than seek-and-tell: the two files this reads are ~108 KB and
    // fixed, and `fread` reports what it DELIVERED, so the count is measured rather than promised.
    // That is the same lesson `string_length.bx` pins — `ftell` promises, `fread` delivers.
    let room: Int = 1048576;
    let buffer: CPointer = malloc(room);
    if c_is_null(buffer) {
        let shut: Int = fclose(f);
        return empty;
    }
    let got: Int = fread(buffer, 1, room, f);
    let closed: Int = fclose(f);
    if got <= 0 {
        return empty;
    }
    return c_bytes_at(buffer, got);
}

function readable(path: String) -> Bool touches files {
    let f: CPointer = fopen(path, "r");
    if c_is_null(f) {
        return false;
    }
    let closed: Int = fclose(f);
    return true;
}

// Fixtures and invariants are counted APART, and that is not bookkeeping tidiness.
//
// `the_suite_also_runs_on_burxt` in `tests/runner.rs` asserts this program prints
// `ran N, passed N, failed 0` where N is the number of `.bx` files in `tests/{pass,fail,panic}`.
// Folding two invariants into that total made it 449 against 447 on disk and would have failed
// the Rust cross-check — correctly, because the number no longer meant what its name says. They
// are also genuinely different claims: a fixture is a program with a recorded answer, an
// invariant is a statement about the repository. One total for both would be the kind of summary
// that hides which half went red.
class Outcome { ran: Int, passed: Int, failed: Int,
                claims: Int, claims_passed: Int, claims_failed: Int }

// ---- talking to the machine -------------------------------------------------

// Every name in a directory, one per line, via the shell. `ls` is the only thing
// here that is not Burxt, and it is doing what a directory read would do.
function listing_of(directory: String, into: String) -> String touches files {
    let command: String = "ls " + directory + " > " + into + " 2>/dev/null";
    let status: Int = system(command);
    return read_file(into);
}

// Every name in a directory INCLUDING the dotfiles, which `ls` hides by default. `-A` rather
// than `-a` because `.` and `..` are not entries anyone means. Needed by the repository-root
// invariant: `.gitignore` and `.github` are exactly the kind of thing that belongs there, and a
// listing that cannot see them would call a stray root file clean.
function listing_all_of(directory: String, into: String) -> String touches files, commands {
    let command: String = "ls -A " + directory + " > " + into + " 2>/dev/null";
    let status: Int = system(command);
    return read_file(into);
}

// Every file under `directory` whose name matches `pattern`, one per line, RECURSIVELY.
//
// The shared helper the document invariants needed. `ls` cannot recurse and Burxt cannot walk a
// tree — `opendir` answers a pointer the memory model has nothing to say about — so `find` does
// what a recursive read would, and the answer comes back through a file. Exactly the shape of
// `listing_of` above, one level further out, and the same honest workaround rather than a
// pretended-away limit.
function find_of(directory: String, pattern: String, into: String) -> String touches files, commands {
    let command: String = "find " + directory + " -type f -name '" + pattern + "' > " + into
        + " 2>/dev/null";
    let status: Int = system(command);
    return read_file(into);
}

// Run a command, capturing everything it says, and answer its exit code.
// `system` reports the wait status, and the exit code is the high byte of it.
function run_capturing(command: String, output: String) -> Int {
    let status: Int = system(command + " > " + output + " 2>&1");
    return divide_floor(status, 256);
}

// The same, but keeping the two streams APART: only stdout is captured, and stderr is discarded.
//
// Needed once `print_error` existed (v0.0.203). A pass fixture is compared against its `.stdout`, so
// merging the streams made anything written to stderr look like a difference — this runner reported
// `tests/pass/print_error.bx` as failing while the Rust runner, which reads the two separately, passed
// it. The merge was invisible for as long as nothing could write to stderr on purpose.
//
// Compiling still uses the merged form: there the diagnostics ARE the output being checked.
function run_capturing_stdout(command: String, output: String) -> Int {
    let status: Int = system(command + " > " + output + " 2>/dev/null");
    return divide_floor(status, 256);
}

// ---- reading the listing ----------------------------------------------------

function line_end(text: String, from: Int) -> Int {
    let mutable i: Int = from;
    while i < len(text) && byte_at(text, i) != 10 {
        i += 1;
    }
    return i;
}

function ends_with_bx(name: String) -> Bool {
    let n: Int = len(name);
    if n < 3 {
        return false;
    }
    return byte_at(name, n - 3) == 46 && byte_at(name, n - 2) == 98
        && byte_at(name, n - 1) == 120;
}

function without_extension(name: String) -> String {
    return substring(name, 0, len(name) - 3);
}

// ---- comparing ---------------------------------------------------------------

// Whether `haystack` contains `needle`. A fail fixture classes the text the error
// must CONTAIN rather than the whole message, so a reworded diagnostic does not
// break a test that is really about the rule.
function contains(haystack: String, needle: String) -> Bool {
    let n: Int = len(needle);
    if n == 0 {
        return true;
    }
    let mutable i: Int = 0;
    while i + n <= len(haystack) {
        let mutable k: Int = 0;
        let mutable same: Bool = true;
        while k < n {
            if byte_at(haystack, i + k) != byte_at(needle, k) {
                same = false;
                k = n;
            } else {
                k += 1;
            }
        }
        if same {
            return true;
        }
        i += 1;
    }
    return false;
}

// The recorded text, with the trailing newline a file always has removed.
function trimmed(text: String) -> String {
    let mutable n: Int = len(text);
    while n > 0 && byte_at(text, n - 1) == 10 {
        n -= 1;
    }
    return substring(text, 0, n);
}

// ---- the three kinds of check -----------------------------------------------

// One verdict per fixture, named, on stdout.
//
// **A summary is not evidence and a count cannot see a fixture change hands.** `ran 447, passed
// 447` is true of a runner that examined 447 fixtures and equally true of one that examined 446
// and one of them twice. So every fixture says its own name and its own answer, and
// `tests/support/runner_agreement.bx` compares that SET against the directory rather than
// comparing two totals — which is the whole reason this line exists.
//
// `ok` / `not ok` is TAP's spelling, chosen because it is a format other tools already read, and
// because a fixture's name is the only stable identifier the suite has.
function (mutable self: Outcome) note(passed: Bool, kind: String, name: String,
                                      why: String) -> Int {
    if kind == "invariant" {
        self.claims += 1;
        if passed {
            self.claims_passed += 1;
        } else {
            self.claims_failed += 1;
        }
    } else {
        self.ran += 1;
        if passed {
            self.passed += 1;
        } else {
            self.failed += 1;
        }
    }
    if passed {
        print("ok " + kind + "/" + name);
        return 0;
    }
    print("not ok " + kind + "/" + name + ": " + one_line(why));
    return 0;
}

// A reason, flattened to one line.
//
// **A verdict that spans lines is not machine-readable, and finding that out cost a confusing
// hour.** `printed X, expected Y` embeds a fixture's own output, and `tests/pass/rounding_negative`
// prints three lines — so its failure verdict was five lines, of which only the first began with
// `not ok`. Every consumer that reads this stream a line at a time then miscounts: the agreement
// harness reported a fixture as NOT EXAMINED when it had been examined and had failed.
//
// So the newline becomes a visible `\n` and the verdict is one line by construction. Carriage
// returns go too, because a `.stdout` recorded on Windows would otherwise split a line at the
// terminal without splitting it in the file.
function one_line(why: String) -> String {
    let mutable out: String = "";
    let mutable i: Int = 0;
    while i < len(why) {
        let b: Int = byte_at(why, i);
        if b == 10 {
            out += "\\n";
        } else if b == 13 {
            out += "\\r";
        } else {
            out += substring(why, i, 1);
        }
        i += 1;
    }
    return out;
}

function (mutable self: Outcome) check_pass(compiler: String, name: String, work: String)
    -> Int touches files
{
    let source: String = "tests/pass/" + name + ".bx";
    let expectation: String = "tests/pass/" + name + ".stdout";
    if !readable(expectation) {
        let noted: Int = self.note(false, "pass", name,
            "has no .stdout — a fixture must state what it expects");
        return 0;
    }
    let expected: String = trimmed(read_file(expectation));
    let binary: String = work + "/" + name;
    let log: String = work + "/out";

    let built: Int = run_capturing(compiler + " build " + source + " -o " + binary, log);
    if built != 0 {
        let noted: Int = self.note(false, "pass", name, "did not compile: " + trimmed(read_file(log)));
        return 0;
    }
    // In the WORK directory, not `tests/pass`: a fixture may read a file next to it,
    // and a fixture may also WRITE one — running in the source tree is how
    // `tests/pass/` came to hold three of its own outputs, two of them committed.
    let ran: Int = run_capturing_stdout("cd " + work + " && " + binary, log);
    let printed: String = trimmed(read_file(log));
    if ran != 0 {
        let noted: Int = self.note(false, "pass", name, "exited " + to_string(ran));
        return 0;
    }
    if printed == expected {
        let noted: Int = self.note(true, "pass", name, "");
        return 0;
    }
    let noted: Int = self.note(false, "pass", name,
        "printed " + printed + ", expected " + expected);
    return 0;
}

function (mutable self: Outcome) check_fail(compiler: String, name: String, work: String)
    -> Int touches files
{
    let source: String = "tests/fail/" + name + ".bx";
    let expectation: String = "tests/fail/" + name + ".stderr";
    if !readable(expectation) {
        let noted: Int = self.note(false, "fail", name,
            "has no .stderr — a fixture must state what it expects");
        return 0;
    }
    let wanted: String = trimmed(read_file(expectation));
    let log: String = work + "/out";

    // `check` rather than `build`: a refusal needs no linker, and this is the only
    // thing the fixture is about.
    let status: Int = run_capturing(compiler + " check " + source, log);
    let said: String = read_file(log);
    if status == 0 {
        let noted: Int = self.note(false, "fail", name, "was accepted, and should not be");
        return 0;
    }
    if contains(said, wanted) {
        let noted: Int = self.note(true, "fail", name, "");
        return 0;
    }
    let noted: Int = self.note(false, "fail", name,
        "refused it for the wrong reason: " + trimmed(said));
    return 0;
}

function (mutable self: Outcome) check_panic(compiler: String, name: String, work: String)
    -> Int touches files
{
    let source: String = "tests/panic/" + name + ".bx";
    let expectation: String = "tests/panic/" + name + ".stderr";
    if !readable(expectation) {
        let noted: Int = self.note(false, "panic", name,
            "has no .stderr — a fixture must state what it expects");
        return 0;
    }
    let wanted: String = trimmed(read_file(expectation));
    let binary: String = work + "/" + name;
    let log: String = work + "/out";

    let built: Int = run_capturing(compiler + " build " + source + " -o " + binary, log);
    if built != 0 {
        let noted: Int = self.note(false, "panic", name, "did not compile, and should have");
        return 0;
    }
    // Also in the work directory. This one ran wherever the runner happened to be
    // standing, which is the repository ROOT, so a panic fixture that writes a file
    // left it there — caught by `the_repository_root_holds_only_what_belongs_there`
    // the moment B5 needed a fixture that writes one.
    let ran: Int = run_capturing("cd " + work + " && " + binary, log);
    let said: String = read_file(log);
    if ran == 0 {
        let noted: Int = self.note(false, "panic", name, "ran to completion, and should have died");
        return 0;
    }
    if contains(said, wanted) {
        let noted: Int = self.note(true, "panic", name, "");
        return 0;
    }
    let noted: Int = self.note(false, "panic", name,
        "died for the wrong reason: " + trimmed(said));
    return 0;
}


// ---- invariants ---------------------------------------------------------------------------
//
// A fixture is a program with a recorded answer. An INVARIANT is a claim about the repository
// that no single program can carry — that the root holds nothing stray, that every example still
// typechecks. `tests/runner.rs` has 72 of them and gets four services from `cargo test` for
// free: naming, selection, isolation, and parallelism. This section supplies the first three.
//
// **Dispatch is a chain of `if`s and the list of names is written separately, which is a real
// hazard worth naming rather than hiding.** Burxt has no function values, so an invariant cannot
// be put in an array — and that means an implemented invariant missing from `invariant_names`
// would simply never run, silently, which is this project's oldest failure shape. Two things
// guard it: an unknown name answers `?unknown invariant` and is reported as a failure rather
// than skipped, and `tests/support/runner_agreement.bx` compares this list against the `#[test]`
// names in `runner.rs` and prints the shortfall as a number. A number can be ratcheted; a
// forgotten `push` cannot.

// The `runner.rs` invariants this file answers WITHOUT a named invariant of its own — because the
// fixture walk already does exactly their work. Listed rather than inferred, so the coverage
// number in `tests/support/runner_agreement.bx` credits real work instead of understating it, and
// so that adding a name here is a visible claim someone can check rather than a silent bump.
function answered_by_the_fixture_sweep() -> [String] {
    let mutable all: [String] = [];
    push(all, "pass_programs_produce_expected_stdout");
    push(all, "fail_programs_are_rejected_with_expected_error");
    push(all, "panic_programs_die_cleanly_at_runtime");
    return all;
}

function invariant_names() -> [String] {
    let mutable all: [String] = [];
    push(all, "the_repository_root_holds_only_what_belongs_there");
    push(all, "every_example_still_typechecks");
    push(all, "every_log_file_is_linked_from_its_index");
    push(all, "no_html_page_is_written_in_markdown");
    push(all, "the_mascot_plays_once");
    push(all, "every_source_and_document_is_in_version_control");
    push(all, "the_refusals_page_is_not_stale");
    push(all, "the_repository_layout_is_declared");
    push(all, "editor_grammar_knows_every_keyword_the_compiler_does");
    push(all, "the_web_highlighter_knows_every_keyword_the_compiler_does");
    return all;
}

// What may sit at the repository root. Word for word `runner.rs`'s two lists, and they are one
// list here because Burxt has no `const [&str; N]` and the distinction between "file" and
// "directory" does no work in the comparison.
function allowed_at_root(name: String) -> Bool {
    if name == "Cargo.toml" { return true; }
    if name == "Cargo.lock" { return true; }
    if name == ".cargo" { return true; }
    if name == ".git" { return true; }
    if name == ".gitignore" { return true; }
    if name == ".gitattributes" { return true; }
    if name == ".vscode" { return true; }
    // The agent harness's worktree directory, added in v0.0.240 — and adding it HERE as well as in
    // `runner.rs` is the point rather than a chore. The moment a rule lives in both runners, a change
    // to one is a change to both, and the Burxt runner caught this: `runner.rs` went green and
    // `the_suite_also_runs_on_burxt` printed `not ok invariant/... : .claude`. **That is the parity
    // discipline working on the SUITE rather than on the compiler**, and it is the first time the
    // Burxt runner has disagreed with the Rust one about anything.
    if name == ".claude" { return true; }
    if name == "target" { return true; }
    if name == "README.md" { return true; }
    if name == "DESIGN.md" { return true; }
    if name == "CONTRIBUTING.md" { return true; }
    if name == "CODE_OF_CONDUCT.md" { return true; }
    if name == "LICENSE-MIT" { return true; }
    if name == "LICENSE-APACHE" { return true; }
    if name == "src" { return true; }
    if name == "spec" { return true; }
    if name == "tests" { return true; }
    if name == "examples" { return true; }
    if name == "editors" { return true; }
    if name == "assets" { return true; }
    if name == "docs" { return true; }
    if name == "lib" { return true; }
    if name == "scripts" { return true; }
    if name == "dist" { return true; }
    if name == ".github" { return true; }
    if name == ".devcontainer" { return true; }
    return false;
}

function root_holds_only_what_belongs(work: String) -> String touches files, commands {
    let names: String = listing_all_of(".", work + "/root-listing");
    let mutable strays: String = "";
    let mutable at: Int = 0;
    while at < len(names) {
        let stop: Int = line_end(names, at);
        let entry: String = substring(names, at, stop - at);
        if len(entry) > 0 && !allowed_at_root(entry) {
            if len(strays) > 0 {
                strays += ", ";
            }
            strays += entry;
        }
        at = stop + 1;
    }
    if len(strays) == 0 {
        return "";
    }
    return "these do not belong at the repository root — build with `-o <path>` and move sources "
        + "into a directory: " + strays;
}

// Every `examples/*.bx` must still typecheck. `check` rather than `build`, exactly as the Rust
// one does: an example is about the language, not about the linker.
//
// The floor is `runner.rs`'s — at least three — and it is here for the reason the floor exists
// there: an empty `examples/` would otherwise make this invariant pass by having nothing to say.
function examples_typecheck(compiler: String, work: String) -> String touches files, commands {
    let names: String = listing_of("examples", work + "/examples-listing");
    let log: String = work + "/out";
    let mutable checked: Int = 0;
    let mutable failures: String = "";
    let mutable at: Int = 0;
    while at < len(names) {
        let stop: Int = line_end(names, at);
        let entry: String = substring(names, at, stop - at);
        if ends_with_bx(entry) {
            let status: Int = run_capturing(compiler + " check examples/" + entry, log);
            checked += 1;
            if status != 0 {
                if len(failures) > 0 {
                    failures += "; ";
                }
                failures += entry + ": " + trimmed(read_file(log));
            }
        }
        at = stop + 1;
    }
    if checked < 3 {
        return "expected several examples, checked only " + to_string(checked);
    }
    if len(failures) > 0 {
        return failures;
    }
    return "";
}


// How many lines `text` holds. `DESIGN.md` growing back into a log is measured, not felt.
function count_lines(text: String) -> Int {
    let mutable lines: Int = 0;
    let mutable i: Int = 0;
    while i < len(text) {
        if byte_at(text, i) == 10 {
            lines += 1;
        }
        i += 1;
    }
    return lines;
}

// The milestone log is split across files, so the index and the files must agree. Two ways to
// drift and both silent: a log file nobody links to, and a link to a file that was renamed.
// Checked in BOTH directions for that reason — the Rust one does, and a one-way check would pass
// a log whose index lists nothing.
function log_files_are_linked(work: String) -> String touches files, commands {
    if !readable("docs/log/README.md") {
        return "docs/log/README.md is missing, and it is the log's index";
    }
    let index: String = read_file("docs/log/README.md");
    let names: String = listing_of("docs/log", work + "/log-listing");
    let mutable found: Int = 0;
    let mutable unlinked: String = "";
    let mutable at: Int = 0;
    while at < len(names) {
        let stop: Int = line_end(names, at);
        let entry: String = substring(names, at, stop - at);
        if len(entry) > 3 && entry != "README.md"
            && substring(entry, len(entry) - 3, 3) == ".md" {
            found += 1;
            if !contains(index, entry) {
                if len(unlinked) > 0 {
                    unlinked += ", ";
                }
                unlinked += entry;
            }
        }
        at = stop + 1;
    }
    if found < 8 {
        return "the log lost files: only " + to_string(found) + " entries beside the index";
    }
    if len(unlinked) > 0 {
        return "docs/log/README.md does not link: " + unlinked;
    }
    // The other direction: every link in the index must resolve. A markdown link is `](target)`,
    // and only local `.md` targets are checked — `../` leaves the log and a `#` is a fragment
    // within a page, neither of which is this invariant's business.
    let mutable missing: String = "";
    let mutable i: Int = 0;
    while i < len(index) {
        if byte_at(index, i) == 40 {                 // '('
            let mutable j: Int = i + 1;
            while j < len(index) && byte_at(index, j) != 41 {
                j += 1;
            }
            let target: String = substring(index, i + 1, j - i - 1);
            if len(target) > 3 && substring(target, len(target) - 3, 3) == ".md"
                && !starts_with_at_runner(target, 0, "../") && !contains(target, "#") {
                if !readable("docs/log/" + target) {
                    if len(missing) > 0 {
                        missing += ", ";
                    }
                    missing += target;
                }
            }
            i = j + 1;
        } else {
            i += 1;
        }
    }
    if len(missing) > 0 {
        return "docs/log/README.md links files that do not exist: " + missing;
    }
    // `DESIGN.md` must POINT AT the log rather than hold it: the split is the whole point, and a
    // document that grows back into a log has quietly undone it.
    let design: String = read_file("DESIGN.md");
    if !contains(design, "docs/log/") {
        return "DESIGN.md must link the log";
    }
    if count_lines(design) >= 1200 {
        return "DESIGN.md is growing back into a log: " + to_string(count_lines(design)) + " lines";
    }
    return "";
}

// Markdown in a `.html` page reaches the live site verbatim, because kramdown never runs on one.
//
// Two exclusions, and both are in the Rust twin for reasons worth keeping. `_layouts` and
// `_includes` are templates rather than pages and hold no prose. And HTML COMMENTS are stripped
// before the scan, because a page explaining this very rule would otherwise fail it — the first
// version of the Rust test tripped on the sentence in `404.html` telling authors not to write
// `markdown="1"`. That is the prose-versus-pattern trap, and mirroring the fix matters more than
// mirroring the check.
function html_pages_are_not_markdown(work: String) -> String touches files, commands {
    let listing: String = find_of("docs", "*.html", work + "/html-listing");
    let mutable wrong: String = "";
    let mutable seen: Int = 0;
    let mutable at: Int = 0;
    while at < len(listing) {
        let stop: Int = line_end(listing, at);
        let path: String = substring(listing, at, stop - at);
        if len(path) > 0 && !contains(path, "_layouts") && !contains(path, "_includes") {
            seen += 1;
            let body: String = without_comments(after_front_matter(read_file(path)));
            let mutable line_no: Int = 1;
            let mutable k: Int = 0;
            while k < len(body) {
                let end: Int = line_end(body, k);
                if starts_with_at_runner(body, k, "# ") || starts_with_at_runner(body, k, "## ")
                    || starts_with_at_runner(body, k, "- ") || starts_with_at_runner(body, k, "|") {
                    if len(wrong) > 0 {
                        wrong += "; ";
                    }
                    wrong += path + ":" + to_string(line_no) + " is markdown in an .html page";
                }
                line_no += 1;
                k = end + 1;
            }
            if contains(body, "markdown=\"1\"") {
                if len(wrong) > 0 {
                    wrong += "; ";
                }
                wrong += path + " sets markdown=\"1\", which does nothing in an .html page";
            }
        }
        at = stop + 1;
    }
    // **A floor of 2, which is the measured count and not a guess — the first version said 3 and
    // failed honestly on a site that has two pages.** `docs/` holds four `.html` files and two of
    // them are in `_layouts`/`_includes`.
    //
    // The Rust twin has no floor here and does not need one: `walk` starts with
    // `fs::read_dir(dir).unwrap()`, so a missing `docs/` panics there. `find` prints nothing and
    // exits quietly, so the same mistake would make this invariant pass by having no pages to be
    // wrong about. **The floor is not mirroring the Rust check, it is paying for the difference
    // between an in-process walk and a shell one.**
    if seen < 2 {
        return "expected the two .html pages under docs/, examined only " + to_string(seen);
    }
    if len(wrong) > 0 {
        return wrong;
    }
    return "";
}

// The text after a page's YAML front matter. A `#` in there is a YAML comment and entirely
// correct, so scanning it for markdown headings would report every page.
function after_front_matter(text: String) -> String {
    if !starts_with_at_runner(text, 0, "---") {
        return text;
    }
    let mutable i: Int = 3;
    while i + 4 <= len(text) {
        if byte_at(text, i) == 10 && starts_with_at_runner(text, i + 1, "---") {
            return substring(text, i + 4, len(text) - i - 4);
        }
        i += 1;
    }
    return text;
}

// The same text with every `<!-- ... -->` removed. See `html_pages_are_not_markdown` for why.
function without_comments(text: String) -> String {
    let mutable out: String = "";
    let mutable i: Int = 0;
    while i < len(text) {
        if starts_with_at_runner(text, i, "<!--") {
            let mutable j: Int = i + 4;
            while j + 3 <= len(text) && !starts_with_at_runner(text, j, "-->") {
                j += 1;
            }
            if j + 3 > len(text) {
                return out;                          // unterminated: nothing after it is code
            }
            i = j + 3;
        } else {
            out += substring(text, i, 1);
            i += 1;
        }
    }
    return out;
}


// Where `needle` starts in `haystack`, or -1. `contains` answers whether; this answers where, and
// the GIF check needs the offset.
function index_of(haystack: String, needle: String) -> Int {
    let n: Int = len(needle);
    if n == 0 {
        return 0;
    }
    let mutable i: Int = 0;
    while i + n <= len(haystack) {
        let mutable k: Int = 0;
        let mutable same: Bool = true;
        while k < n {
            if byte_at(haystack, i + k) != byte_at(needle, k) {
                same = false;
                k = n;
            } else {
                k += 1;
            }
        }
        if same {
            return i;
        }
        i += 1;
    }
    return 0 - 1;
}

// The hero's mark must play ONCE and rest.
//
// **This one reads a BINARY file, and that capability was probed before a line of it was written.**
// Burxt can inspect a binary format, and this invariant is not a text check pretending: on
// `assets/burxt-ember.gif` it reads 108599 bytes, `71 73 70 56 57 97` for `GIF89a`, and finds
// `NETSCAPE2.0` at offset 784 with a loop count of 1 — byte for byte what Python reports for the
// same file.
//
// It used to read that through `read_file`, whose String preserved every byte including NULs.
// **B5 (v0.0.284) ended that**: a String is UTF-8 and is now checked to be, at the door, so a GIF
// cannot arrive as one. This invariant is where that cost landed first, and it is the cost the
// roadmap row named in advance rather than a surprise. Reading it as `[Int]` is the honest
// replacement and arguably what it should always have been — the old version relied on a String
// tolerating bytes that are not text, which is precisely the property the language now denies.
//
// The loop count lives in the NETSCAPE application extension: the eleven bytes `NETSCAPE2.0`, then
// `0x03 0x01`, then two little-endian bytes. 0 means forever. The animation ends with the ember
// hidden, so exactly one play leaves a still logo — which is the whole design, and why the number
// is 1 rather than "small".
// The three byte-array helpers the mascot check needs now that it reads bytes rather than text.
// `needle` stays a String because every caller writes a literal, and a String IS its bytes —
// `byte_at` reads them without a conversion step that could disagree.
function starts_with_bytes(data: [Int], needle: String) -> Bool {
    if len(data) < len(needle) {
        return false;
    }
    let mutable i: Int = 0;
    while i < len(needle) {
        if data[i] != byte_at(needle, i) {
            return false;
        }
        i += 1;
    }
    return true;
}

// The offset of `needle` in `data`, or -1. Plain search rather than anything clever: it runs twice,
// over 108 KB, once per suite.
function find_bytes(data: [Int], needle: String) -> Int {
    let n: Int = len(data);
    let m: Int = len(needle);
    if m == 0 || n < m {
        return -1;
    }
    let mutable i: Int = 0;
    while i <= n - m {
        let mutable k: Int = 0;
        let mutable matched: Bool = true;
        while matched && k < m {
            if data[i + k] != byte_at(needle, k) {
                matched = false;
            }
            k += 1;
        }
        if matched {
            return i;
        }
        i += 1;
    }
    return -1;
}

function same_bytes(a: [Int], b: [Int]) -> Bool {
    if len(a) != len(b) {
        return false;
    }
    let mutable i: Int = 0;
    while i < len(a) {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    return true;
}

function mascot_plays_once() -> String touches files {
    let mutable wrong: String = "";
    let marker: String = "NETSCAPE2.0";
    // Both copies, because `docs/assets/` exists only so Pages can serve it, and a divergence
    // between them means the site shows something the brand folder does not.
    let here: String = "assets/burxt-ember.gif";
    let served: String = "docs/assets/burxt-ember.gif";
    if !readable(here) || !readable(served) {
        return "the mascot is missing from assets/ or docs/assets/";
    }
    let a: [Int] = read_bytes(here);
    let b: [Int] = read_bytes(served);
    let mutable which: Int = 0;
    while which < 2 {
        let mutable copy: [Int] = a;
        let mutable named: String = here;
        if which == 1 {
            copy = b;
            named = served;
        }
        if !starts_with_bytes(copy, "GIF89a") {
            if len(wrong) > 0 { wrong += "; "; }
            wrong += named + " is not an animated GIF";
        } else {
            let at: Int = find_bytes(copy, marker);
            if at < 0 {
                if len(wrong) > 0 { wrong += "; "; }
                wrong += named + " has no NETSCAPE extension, so it has no loop count";
            } else {
                let low: Int = copy[at + len(marker) + 2];
                let high: Int = copy[at + len(marker) + 3];
                let loops: Int = low + high * 256;
                if loops != 1 {
                    if len(wrong) > 0 { wrong += "; "; }
                    wrong += named + " is set to loop " + to_string(loops)
                        + " times — patch the two bytes after `NETSCAPE2.0\\x03\\x01` to 1 rather "
                        + "than re-encoding, which would recompress every frame";
                }
            }
        }
        which += 1;
    }
    if !same_bytes(a, b) {
        if len(wrong) > 0 { wrong += "; "; }
        wrong += "assets/ and docs/assets/ hold different copies of the mascot";
    }
    // A GIF cannot be paused by CSS, so the only way to honour a reduced-motion preference is to
    // hand over a different file.
    if !readable("assets/burxt-ember-still.png") || !readable("docs/assets/burxt-ember-still.png") {
        if len(wrong) > 0 { wrong += "; "; }
        wrong += "the reduced-motion poster is missing from assets/ or docs/assets/";
    }
    let mutable page: Int = 0;
    while page < 2 {
        let mutable named: String = "docs/index.md";
        if page == 1 {
            named = "docs/404.html";
        }
        if readable(named) {
            let text: String = read_file(named);
            if contains(text, "burxt-ember.gif") {
                if !contains(text, "prefers-reduced-motion: reduce")
                    || !contains(text, "burxt-ember-still.png") {
                    if len(wrong) > 0 { wrong += "; "; }
                    wrong += named + " shows the mascot with no reduced-motion source offering "
                        + "burxt-ember-still.png";
                }
                // Width and height, or the page reflows when 106 KB finishes arriving.
                if !contains(text, "width=\"174\" height=\"222\"") {
                    if len(wrong) > 0 { wrong += "; "; }
                    wrong += named + " does not give the mascot its intrinsic size, so it will "
                        + "shift the layout as it loads";
                }
            }
        }
        page += 1;
    }
    if len(wrong) > 0 {
        return wrong;
    }
    return "";
}


// An absolute path for something the caller may have named relatively.
//
// **The third time this exact class of bug has cost me a debugging round**, so it is a named
// function now rather than a fix at each site. `refused.py` launches the compiler from the panel
// directory, so `./target/release/burxt` — a perfectly good path from the repository root — became
// `FileNotFoundError: './target/release/burxt'`. The Rust twin never sees this because
// `CARGO_BIN_EXE_burxt` is absolute. **A relative path is a different path the moment anything
// changes directory, and a test harness changes directory constantly.**
function absolute_path(path: String, work: String) -> String touches files, commands {
    let answer: String = output_of("realpath " + path, work + "/abs");
    let mutable n: Int = len(answer);
    while n > 0 && byte_at(answer, n - 1) == 10 {
        n -= 1;
    }
    if n == 0 {
        return path;                                 // not on disk; let the caller fail loudly
    }
    return substring(answer, 0, n);
}

// Whatever `command` printed. The general form of `listing_of` and `find_of`, for the two
// invariants below that need a shell answer those two cannot express.
function output_of(command: String, into: String) -> String touches files, commands {
    let status: Int = system(command + " > " + into + " 2>/dev/null");
    return read_file(into);
}

// Whether `text` holds `line` as a WHOLE line. Substring containment is wrong here: `lib/os.bx`
// is a substring of nothing, but `docs/index.md` is a substring of `docs/index.md.bak`, and a
// tracked-file check that answered yes to a near-miss would be worse than none.
function holds_line(text: String, line: String) -> Bool {
    let mutable at: Int = 0;
    while at < len(text) {
        let stop: Int = line_end(text, at);
        if stop - at == len(line) && substring(text, at, stop - at) == line {
            return true;
        }
        at = stop + 1;
    }
    return false;
}

// **`.gitignore` here is a whitelist, so a new directory is ignored until it is re-admitted** —
// which means a whole directory of source can go missing with `git status` clean. That is not
// hypothetical: `docs/` was invisible until v0.0.105 for exactly this reason.
//
// The walk's rules are the Rust twin's, and **the `find` below was checked against a replication
// of that walk before this invariant was written**: both answer 707 files, zero differences. That
// mattered because the rules are fiddly in a way that hides mistakes — dot-directories are skipped
// EXCEPT the four that carry real configuration (`.cargo`, `.devcontainer`, `.github`, `.vscode`),
// each of which is a file whose loss would be silent and each of which is tracked only because
// `!/*.*` in `.gitignore` happens to match a leading dot.
//
// The extension list stops where the site does. It used to stop at `py`, which covered the
// generators and not one line of what they generate into — so `docs/assets/site.js` and the layouts
// could each have vanished unnoticed.
function everything_is_tracked(work: String) -> String touches files, commands {
    let tracked: String = output_of("git ls-files", work + "/tracked");
    let mutable count: Int = 0;
    let mutable at: Int = 0;
    while at < len(tracked) {
        let stop: Int = line_end(tracked, at);
        if stop > at {
            count += 1;
        }
        at = stop + 1;
    }
    // A floor, and here it pays for the same difference as every other one in this file: the Rust
    // twin asserts `git ls-files` SUCCEEDED, and a Burxt `system` reports a wait status this
    // function does not read. An empty index and a git that is not installed look identical from
    // here, and both would make the comparison below vacuously true.
    if count < 100 {
        return "expected a populated git index, got " + to_string(count)
            + " tracked paths — is this a git checkout?";
    }
    let found: String = output_of(
        "find . -mindepth 1 -type d \\( -name .git -o -name target -o -name dist "
        + "-o -name node_modules -o \\( -name \".*\" ! -name .cargo ! -name .devcontainer "
        + "! -name .github ! -name .vscode \\) \\) -prune -o -type f \\( -name \"*.bx\" "
        + "-o -name \"*.md\" -o -name \"*.rs\" -o -name \"*.toml\" -o -name \"*.json\" "
        + "-o -name \"*.sh\" -o -name \"*.py\" -o -name \"*.css\" -o -name \"*.js\" "
        + "-o -name \"*.html\" -o -name \"*.yml\" \\) -print | sed 's|^\\./||'",
        work + "/sources");
    let mutable examined: Int = 0;
    let mutable untracked: String = "";
    let mutable i: Int = 0;
    while i < len(found) {
        let stop: Int = line_end(found, i);
        let path: String = substring(found, i, stop - i);
        if len(path) > 0 {
            examined += 1;
            if !holds_line(tracked, path) {
                if len(untracked) > 0 {
                    untracked += ", ";
                }
                untracked += path;
            }
        }
        i = stop + 1;
    }
    // The other half of the same guard: a `find` that matched nothing would report every file as
    // tracked, which is the direction that looks like success.
    if examined < 100 {
        return "expected hundreds of source and document files, examined only "
            + to_string(examined);
    }
    if len(untracked) > 0 {
        return "these source or documentation files are not in version control — `.gitignore` is "
            + "a whitelist, so a new directory is ignored until it is re-admitted: " + untracked;
    }
    return "";
}

// The refusals page shows programs the language will not accept. **A panel that starts COMPILING
// becomes an advertisement for something Burxt no longer refuses**, which is worse than having no
// page — so the generator is re-run in check mode and the page is read for the word it writes when
// a panel was accepted.
//
// `python3 scripts/refused.py --check` is the generator, and it is the Rust twin's dependency too.
// Burxt cannot regenerate the page itself; that would mean porting the generator, which is a
// different task from moving this invariant.
function refusals_page_is_current(compiler: String, work: String) -> String
    touches files, commands
{
    if !readable("scripts/refused.py") {
        return "scripts/refused.py is missing, and it is what keeps the page honest";
    }
    let log: String = work + "/refused";
    let status: Int = run_capturing("BURXT=" + absolute_path(compiler, work)
                                   + " python3 scripts/refused.py --check", log);
    if status != 0 {
        return "the refusals page is stale: " + trimmed(read_file(log));
    }
    if !readable("examples/refused/README.md") {
        return "examples/refused/README.md is missing";
    }
    let page: String = read_file("examples/refused/README.md");
    if contains(page, "ACCEPTED") {
        return "a panel in examples/refused/ now COMPILES — either the refusal was lost, or the "
            + "example needs rewriting to still demonstrate one";
    }
    // One panel per `## `, and the floor is the Rust twin's ten.
    let mutable panels: Int = 0;
    let mutable at: Int = 0;
    while at < len(page) {
        let stop: Int = line_end(page, at);
        if starts_with_at_runner(page, at, "## ") {
            panels += 1;
        }
        at = stop + 1;
    }
    if panels < 10 {
        return "examples/refused/ lost panels: " + to_string(panels) + " left";
    }
    return "";
}


// Every directory that may exist. The purpose is not decoration — **it is what a future me is
// supposed to read BEFORE inventing a sibling.** `tests/tools/` was created in v0.0.216 beside a
// `tests/support/` that had been doing the same job since v0.0.204, and this list is the answer to
// that: a new home is a claim that no existing one fits, and the claim is almost always wrong.
// `spec/A7.0-NAMING.md` §10.
//
// The purposes are not carried over from the Rust twin, only the NAMES — a Burxt copy of nineteen
// English sentences would be two places to edit one fact, and the sentences are not what this
// invariant compares. What it compares is the set.
function declared_home(path: String) -> Bool {
    if path == "assets" { return true; }
    if path == "dist" { return true; }
    if path == "docs" { return true; }
    if path == "editors" { return true; }
    if path == "examples" { return true; }
    // The eight under `examples/`, and I missed every one of them by copying the table from what
    // was visible on screen instead of extracting it. The invariant then reported all eight as
    // undeclared, which is the honest failure — but the lesson is the same one that produced the
    // invented floor: **read the whole list, do not transcribe the part you can see.**
    if path == "examples/inputs" { return true; }
    if path == "examples/bmx" { return true; }
    if path == "examples/mcp" { return true; }
    if path == "examples/negative" { return true; }
    if path == "examples/pos" { return true; }
    if path == "examples/pos-php" { return true; }
    if path == "examples/pos-python" { return true; }
    if path == "examples/pos-rust" { return true; }
    if path == "examples/refused" { return true; }
    if path == "examples/wasm" { return true; }
    if path == "lib" { return true; }
    if path == "scripts" { return true; }
    if path == "spec" { return true; }
    if path == "src" { return true; }
    if path == "target" { return true; }
    if path == "tests" { return true; }
    if path == "tests/pass" { return true; }
    if path == "tests/fail" { return true; }
    if path == "tests/panic" { return true; }
    if path == "tests/review" { return true; }
    // The BMX format's own conformance suite, vendored. Judged by somebody else's rules, which
    // is why it is neither `tests/support` (harnesses we wrote) nor a verdict directory.
    if path == "tests/bmx-conformance" { return true; }
    if path == "tests/support" { return true; }
    if path == "src/rust-compiler" { return true; }
    if path == "src/burxt-compiler" { return true; }
    return false;
}

// Every home that must exist on disk. `dist` and `target` are build output, so they are allowed to
// be absent — everything else being absent means the map cites a place nothing is at.
function home_must_exist(path: String) -> Bool {
    if path == "dist" || path == "target" { return false; }
    return declared_home(path);
}

// Both directions, and the second is the one a reader would not think to ask for: **a declared home
// that no longer exists tells the next person a place to put things exists when it does not.** Same
// defect as a spec citing a fixture that never existed.
function layout_is_declared(work: String) -> String touches files, commands {
    let mutable undeclared: String = "";
    let mutable examined: Int = 0;
    // The four parents the Rust twin walks. `""` is the repository root; the other three are where
    // a new directory is most tempting to misfile.
    let mutable which: Int = 0;
    while which < 4 {
        let mutable parent: String = "";
        if which == 1 { parent = "tests"; }
        if which == 2 { parent = "src"; }
        if which == 3 { parent = "examples"; }
        let mutable where: String = ".";
        let mutable prefix: String = "";
        if len(parent) > 0 {
            where = parent;
            prefix = parent + "/";
        }
        // `ls -d */` lists only directories, and `-A` is not needed because dot-directories are
        // skipped anyway — as is `__pycache__`, which python creates and nobody declares.
        let names: String = output_of("ls -A " + where, work + "/layout-" + to_string(which));
        let mutable at: Int = 0;
        while at < len(names) {
            let stop: Int = line_end(names, at);
            let entry: String = substring(names, at, stop - at);
            if len(entry) > 0 && byte_at(entry, 0) != 46 && entry != "__pycache__" {
                let full: String = prefix + entry;
                // Only DIRECTORIES are declared homes; a file at the root is the root invariant's
                // business, not this one.
                if is_directory(full) {
                    examined += 1;
                    if !declared_home(full) {
                        if len(undeclared) > 0 {
                            undeclared += ", ";
                        }
                        undeclared += full;
                    }
                }
            }
            at = stop + 1;
        }
        which += 1;
    }
    // The floor pays for the same difference as every other one here: `ls` on a missing directory
    // prints nothing and this function would call an empty tree fully declared.
    if examined < 10 {
        return "expected the declared directories to be found, examined only "
            + to_string(examined);
    }
    if len(undeclared) > 0 {
        return "undeclared directories: " + undeclared
            + " — add a row to `declared_home` saying what belongs there, or far more likely delete "
            + "it and use the home that already exists (spec/A7.0-NAMING.md §10)";
    }
    let mutable missing: String = "";
    let mutable homes: [String] = [];
    push(homes, "assets"); push(homes, "docs"); push(homes, "editors"); push(homes, "examples");
    push(homes, "lib"); push(homes, "scripts"); push(homes, "spec"); push(homes, "src");
    push(homes, "tests"); push(homes, "tests/pass"); push(homes, "tests/fail");
    push(homes, "tests/panic"); push(homes, "tests/review"); push(homes, "tests/support");
    push(homes, "src/rust-compiler"); push(homes, "src/burxt-compiler");
    for home in homes {
        if home_must_exist(home) && !is_directory(home) {
            if len(missing) > 0 {
                missing += ", ";
            }
            missing += home;
        }
    }
    if len(missing) > 0 {
        return "this list declares directories that do not exist: " + missing
            + " — renamed, or removed? A map that cites a place nothing is at is rot";
    }
    return "";
}

// Whether `path` is a directory. `test -d` through the shell, because Burxt cannot stat.
function is_directory(path: String) -> Bool touches commands {
    let status: Int = system("test -d " + path);
    return divide_floor(status, 256) == 0;
}


// ---- mirroring, and what NOT to mirror ---------------------------------------
//
// **Mirror what is CHECKED, not what is EXPLAINED.** `the_repository_layout_is_declared` in
// `runner.rs` pairs each directory with an English sentence saying what belongs there; this file
// carries only the NAMES. The sentences are documentation for a person deciding where to put a new
// file, they are not what the invariant compares, and a Burxt copy of them would be a second place
// to edit one fact — which is how prose and code drift apart. The next reader will be tempted to
// copy them for fidelity; fidelity is in the set, not in the paragraph.
//
// The same rule cuts the other way and that is why it is worth stating: where a NUMBER or a
// PATTERN is what gets compared, it must be mirrored exactly and re-measured rather than assumed.

function is_lower_or_underscore(b: Int) -> Bool {
    return (b >= 97 && b <= 122) || b == 95;
}

function is_name_char(b: Int) -> Bool {
    return (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95;
}

// The first byte of `text` at or after `from` that is not a space or a tab.
function skip_blanks(text: String, from: Int, stop: Int) -> Int {
    let mutable i: Int = from;
    while i < stop && (byte_at(text, i) == 32 || byte_at(text, i) == 9) {
        i += 1;
    }
    return i;
}

// `text` with every `needle` replaced by `with`.
function replace_all(text: String, needle: String, with_what: String) -> String {
    if len(needle) == 0 {
        return text;
    }
    let mutable out: String = "";
    let mutable i: Int = 0;
    while i < len(text) {
        if starts_with_at_runner(text, i, needle) {
            out += with_what;
            i += len(needle);
        } else {
            out += substring(text, i, 1);
            i += 1;
        }
    }
    return out;
}

// Whether `word` appears in `text` as a WORD rather than as a substring.
//
// **`as` must not be satisfied by `class`.** That is the whole reason this is not `contains`, and
// getting it wrong would make the invariant pass while the grammar was missing a keyword — the
// exact failure its Rust twin's comment records.
function word_present(text: String, word: String) -> Bool {
    if len(word) == 0 {
        return false;
    }
    let mutable i: Int = 0;
    while i + len(word) <= len(text) {
        if starts_with_at_runner(text, i, word) {
            let mutable ok: Bool = true;
            if i > 0 && is_name_char(byte_at(text, i - 1)) {
                ok = false;
            }
            let after: Int = i + len(word);
            if after < len(text) && is_name_char(byte_at(text, after)) {
                ok = false;
            }
            if ok {
                return true;
            }
        }
        i += 1;
    }
    return false;
}

// The editor grammar must know every word the compiler does.
//
// **Mirrored from `src/rust-compiler/lexer.rs` and `typeck.rs` deliberately, not from the Burxt
// compiler's own tables.** Both runners then assert the same thing and the verdict diff stays
// comparable. Whether the two compilers' keyword tables AGREE is a different question with a
// different honest failure message, and it lives in `the_two_compilers_know_the_same_keywords`
// rather than here — a divergence surfacing as "the grammar is missing X" would be the right fact
// under the wrong name.
//
// **Every scrape below carries a floor, and here is what the floors pay for.** The Rust twin's
// built-in scrape once matched a code shape the typechecker no longer had: it found NOTHING, quietly
// contributed an empty list, and the invariant went on passing on its keywords alone while `exit`
// was missing from the grammar for however many versions that refactor was old. **A check that has
// never run looks exactly like one that passes.** The numbers are measured, not guessed: 40
// keywords, 30 built-ins, 3023 bytes of pattern as of v0.0.255.
function grammar_knows_every_keyword() -> String touches files {
    let lexer_path: String = "src/rust-compiler/lexer.rs";
    let typeck_path: String = "src/rust-compiler/typeck.rs";
    let grammar_path: String = "editors/vscode/syntaxes/burxt.tmLanguage.json";
    if !readable(lexer_path) || !readable(typeck_path) || !readable(grammar_path) {
        return "one of the three files this reads is missing: " + lexer_path + ", " + typeck_path
            + ", " + grammar_path;
    }

    // Keywords, from the lexer's `"word" => Token::Variant` table.
    let lexer: String = read_file(lexer_path);
    let mutable words: [String] = [];
    let mutable at: Int = 0;
    while at < len(lexer) {
        let stop: Int = line_end(lexer, at);
        let begin: Int = skip_blanks(lexer, at, stop);
        if begin < stop && byte_at(lexer, begin) == 34 {
            let mutable j: Int = begin + 1;
            while j < stop && byte_at(lexer, j) != 34 {
                j += 1;
            }
            if j < stop {
                // `after_quote` and not `tail`: `tail` is a keyword in this language, which is
                // the kind of collision only writing the compiler's own test suite in it finds.
                let after_quote: Int = skip_blanks(lexer, j + 1, stop);
                if starts_with_at_runner(lexer, after_quote, "=> Token::") {
                    push(words, substring(lexer, begin + 1, j - begin - 1));
                }
            }
        }
        at = stop + 1;
    }
    if len(words) < 20 {
        return "failed to read the keyword table out of " + lexer_path + " — found only "
            + to_string(len(words)) + ". It moved; fix the scrape rather than deleting it, because "
            + "an empty list makes this invariant pass by checking nothing";
    }

    // Built-in names, from `fn is_reserved_name` in the typechecker.
    let typeck: String = read_file(typeck_path);
    let marker: Int = index_of(typeck, "fn is_reserved_name");
    if marker < 0 {
        return "`fn is_reserved_name` is not in " + typeck_path
            + " — it moved, and an empty built-in list would make this invariant vacuous";
    }
    let mutable close: Int = marker;
    while close < len(typeck) && byte_at(typeck, close) != 125 {
        close += 1;
    }
    let mutable builtins: Int = 0;
    let mutable i: Int = marker;
    let mutable inside: Bool = false;
    let mutable from: Int = 0;
    while i < close {
        if byte_at(typeck, i) == 34 {
            if inside {
                let candidate: String = substring(typeck, from, i - from);
                let mutable all_lower: Bool = len(candidate) > 0;
                let mutable k: Int = 0;
                while k < len(candidate) {
                    if !is_lower_or_underscore(byte_at(candidate, k)) {
                        all_lower = false;
                    }
                    k += 1;
                }
                if all_lower {
                    push(words, candidate);
                    builtins += 1;
                }
                inside = false;
            } else {
                inside = true;
                from = i + 1;
            }
        }
        i += 1;
    }
    if builtins < 10 {
        return "failed to read the built-in names out of " + typeck_path + " — found only "
            + to_string(builtins) + ". They moved: find them and fix this scrape rather than "
            + "deleting it. An empty list is how `exit` stayed missing from the grammar";
    }

    // The grammar's patterns: every `"match"`, `"begin"` and `"end"` line, with `\\b` turned into a
    // space — a word-boundary assertion whose own `b` would otherwise look like a letter attached
    // to the keyword in front of it.
    let grammar: String = read_file(grammar_path);
    let mutable patterns: String = "";
    let mutable g: Int = 0;
    while g < len(grammar) {
        let stop: Int = line_end(grammar, g);
        let begin: Int = skip_blanks(grammar, g, stop);
        if starts_with_at_runner(grammar, begin, "\"match\"")
            || starts_with_at_runner(grammar, begin, "\"begin\"")
            || starts_with_at_runner(grammar, begin, "\"end\"") {
            // The WHOLE line, indentation included — `begin` decides whether to take it, `g` is
            // where it starts. The Rust twin filters on the trimmed line and collects the untrimmed
            // one, and I collected the trimmed one: 2450 bytes against its 3023. The verdict was
            // unaffected (leading spaces are word boundaries either way) and that is exactly why it
            // was worth chasing — **a scrape that is nearly the same is not the same scrape**, and
            // the floor below was calibrated against the other number.
            // A separator BETWEEN lines, not after each — `join("\n")` on the Rust side leaves no
            // trailing newline, and appending one put me a byte over at 3024 against 3023. One byte,
            // at the very end, incapable of changing any lookup. Fixed anyway: the rule two comments
            // up says a scrape that is nearly the same is not the same scrape, and a rule I bend the
            // first time it costs me something is not a rule.
            if len(patterns) > 0 {
                patterns += "\n";
            }
            patterns += substring(grammar, g, stop - g);
        }
        g = stop + 1;
    }
    patterns = replace_all(patterns, "\\\\b", " ");
    if len(patterns) < 500 {
        return "failed to read the grammar's patterns out of " + grammar_path + " — got "
            + to_string(len(patterns)) + " bytes";
    }

    let mutable missing: String = "";
    for word in words {
        if !word_present(patterns, word) {
            if len(missing) > 0 {
                missing += ", ";
            }
            missing += word;
        }
    }
    if len(missing) > 0 {
        return "these words are known to the compiler but absent from the editor grammar: "
            + missing + " — add them to " + grammar_path;
    }
    return "";
}


// Every `"word" => <arrow>` in a Rust match table, appended to `into`. The two keyword scrapes and
// the renamed-spelling scrape are the same shape with a different arrow, so they are one function —
// three copies would be three places for the shape to drift.
function scrape_table(mutable into: [String], text: String, from: Int, stop: Int,
                      arrow: String) -> Int {
    let mutable found: Int = 0;
    let mutable at: Int = from;
    while at < stop {
        let eol: Int = line_end(text, at);
        let mutable line_stop: Int = eol;
        if line_stop > stop {
            line_stop = stop;
        }
        let begin: Int = skip_blanks(text, at, line_stop);
        if begin < line_stop && byte_at(text, begin) == 34 {
            let mutable j: Int = begin + 1;
            while j < line_stop && byte_at(text, j) != 34 {
                j += 1;
            }
            if j < line_stop {
                let after_quote: Int = skip_blanks(text, j + 1, line_stop);
                if starts_with_at_runner(text, after_quote, arrow) {
                    push(into, substring(text, begin + 1, j - begin - 1));
                    found += 1;
                }
            }
        }
        at = eol + 1;
    }
    return found;
}

// The quoted names inside `fn is_reserved_name`, appended to `into`. Lowercase and underscore only,
// which is what separates a built-in's name from the message text around it.
function scrape_reserved(mutable into: [String], typeck: String) -> Int {
    let marker: Int = index_of(typeck, "fn is_reserved_name");
    if marker < 0 {
        return 0;
    }
    let mutable close: Int = marker;
    while close < len(typeck) && byte_at(typeck, close) != 125 {
        close += 1;
    }
    let mutable found: Int = 0;
    let mutable i: Int = marker;
    let mutable inside: Bool = false;
    let mutable from: Int = 0;
    while i < close {
        if byte_at(typeck, i) == 34 {
            if inside {
                let candidate: String = substring(typeck, from, i - from);
                let mutable all_lower: Bool = len(candidate) > 0;
                let mutable k: Int = 0;
                while k < len(candidate) {
                    if !is_lower_or_underscore(byte_at(candidate, k)) {
                        all_lower = false;
                    }
                    k += 1;
                }
                if all_lower {
                    push(into, candidate);
                    found += 1;
                }
                inside = false;
            } else {
                inside = true;
                from = i + 1;
            }
        }
        i += 1;
    }
    return found;
}

// The website's highlighter must know every word the compiler does — **including the spellings the
// language RENAMED.**
//
// Those are the interesting third of this invariant. `fn`, `mut`, `impl`, `dyn`, `extern`, `struct`,
// `trait`, `record` do not compile, so the site must colour them as the errors they are rather than
// as plain identifiers — and they are NOT in the keyword table, which is exactly why the editor
// grammar went years without `trait` and `record`. A scrape that reads only the keyword table cannot
// see them.
//
// Measured against the Rust twin: 40 keywords, 30 built-ins, 8 renamed spellings, 2103 bytes of word
// list as of v0.0.258. Only what is inside a `words(...)` call counts — most of that file is comment,
// and a word in a comment is not a word that highlights.
function highlighter_knows_every_keyword() -> String touches files {
    let lexer_path: String = "src/rust-compiler/lexer.rs";
    let typeck_path: String = "src/rust-compiler/typeck.rs";
    let js_path: String = "docs/assets/burxt-editor.js";
    if !readable(lexer_path) || !readable(typeck_path) || !readable(js_path) {
        return "one of the three files this reads is missing: " + lexer_path + ", " + typeck_path
            + ", " + js_path;
    }
    let lexer: String = read_file(lexer_path);
    let typeck: String = read_file(typeck_path);
    let js: String = read_file(js_path);

    let mutable want: [String] = [];
    let keywords: Int = scrape_table(want, lexer, 0, len(lexer), "=> Token::");
    if keywords < 20 {
        return "failed to read the keyword table out of " + lexer_path + " — found only "
            + to_string(keywords) + "; fix the scrape rather than deleting it, because an empty "
            + "list makes this invariant pass by checking nothing";
    }
    let builtins: Int = scrape_reserved(want, typeck);
    if builtins < 10 {
        return "failed to read the built-in names out of " + typeck_path + " — found only "
            + to_string(builtins);
    }
    // The renamed spellings live between `fn renamed_keyword` and its `_ => return None` arm.
    let renamed_at: Int = index_of(lexer, "fn renamed_keyword");
    if renamed_at < 0 {
        return "`fn renamed_keyword` is not in " + lexer_path
            + " — it moved, and without it the renamed spellings go unchecked";
    }
    let mutable renamed_end: Int = index_of(substring(lexer, renamed_at, len(lexer) - renamed_at),
                                            "_ => return None");
    if renamed_end < 0 {
        return "`_ => return None` no longer closes `fn renamed_keyword` in " + lexer_path;
    }
    renamed_end += renamed_at;
    let old: Int = scrape_table(want, lexer, renamed_at, renamed_end, "=>");
    if old < 6 {
        return "failed to read the renamed spellings out of " + lexer_path + " — found only "
            + to_string(old) + ". These do not compile, so the site must colour them as errors; "
            + "they are not in the keyword table, which is why the grammar went years without "
            + "`trait` and `record`";
    }

    // **Only the BURXT word lists, which means stopping at `var PORTS`.**
    //
    // The unscoped version — mine, until this comment — searched all fourteen `words(...)` lists in
    // the file, and six of them belong to the PHP, Python and Rust snippets the site also
    // highlights. So a Burxt keyword counted as "known to the highlighter" when a sibling language
    // merely shared the spelling. I reported that as a theoretical weakness; **it is not
    // theoretical.** With A7's integer widths in the compiler, `i32`, `u8`, `u32` and `u64` appear
    // in this file exactly once each — in RUST's type list — and Burxt's own `var TYPE` has none of
    // them. Unscoped, this invariant is green on a live gap, under a name promising the Burxt
    // highlighter specifically.
    //
    // A test whose NAME makes a claim it does not check is the failure this repository keeps paying
    // for: `exit` missing from the grammar, M13 DONE for fourteen versions. So this is tightened
    // rather than joined by a second invariant — a second one would leave the false claim standing
    // beside a true one, and the next reader believes the shorter name.
    //
    // `var PORTS` is the seam: Burxt's lists are `var X = words(...)` above it, the ports' are
    // `keyword:`/`type:` inside it. If the marker moves, RE-SCOPE rather than dropping the split.
    let ports_at: Int = index_of(js, "var PORTS");
    if ports_at < 0 {
        return "`var PORTS` is not in " + js_path + " — it is the seam between Burxt's word lists "
            + "and the other languages'. Re-scope this scrape rather than dropping the split, or "
            + "the invariant goes back to passing when PHP happens to share a spelling";
    }
    // Note for whoever measures this next: there are EIGHT `words(` occurrences above the seam, not
    // seven. The eighth is `function words(s)`, the definition itself, which contributes the single
    // letter `s` to the joined text. Harmless, present in the Rust twin too, and worth naming so the
    // next person does not spend a round wondering which list they are missing.
    let mutable lists: String = "";
    let mutable at: Int = 0;
    while at < ports_at {
        if starts_with_at_runner(js, at, "words(") {
            let mutable j: Int = at + 6;
            while j < ports_at && byte_at(js, j) != 41 {
                j += 1;
            }
            if j < ports_at {
                if len(lists) > 0 {
                    lists += " ";
                }
                lists += substring(js, at + 6, j - at - 6);
            }
            at = j + 1;
        } else {
            at += 1;
        }
    }
    // 767 bytes as of v0.0.261, measured after scoping — the unscoped number was 2103, and a floor
    // calibrated against THAT would have been measuring the other languages.
    if len(lists) < 400 {
        return "failed to read Burxt's word lists out of " + js_path + " — got " + to_string(len(lists))
            + " bytes. They are the strings passed to `words(...)`; if that shape changed, fix this "
            + "scrape rather than loosening it to search the whole file, which is mostly comment";
    }

    let mutable missing: String = "";
    for word in want {
        if !word_present(lists, word) {
            if len(missing) > 0 {
                missing += ", ";
            }
            missing += word;
        }
    }
    if len(missing) > 0 {
        return "these words are known to the compiler but absent from the website's highlighter: "
            + missing + " — add them to a word list in " + js_path
            + "; a keyword the compiler knows and the site does not renders as a plain identifier "
            + "on every Burxt block on the site";
    }
    return "";
}

// The reason an invariant does NOT hold, or `""` when it does.
function run_invariant(name: String, compiler: String, work: String) -> String
    touches files, commands
{
    if name == "the_repository_root_holds_only_what_belongs_there" {
        return root_holds_only_what_belongs(work);
    }
    if name == "every_example_still_typechecks" {
        return examples_typecheck(compiler, work);
    }
    if name == "every_log_file_is_linked_from_its_index" {
        return log_files_are_linked(work);
    }
    if name == "no_html_page_is_written_in_markdown" {
        return html_pages_are_not_markdown(work);
    }
    if name == "the_mascot_plays_once" {
        return mascot_plays_once();
    }
    if name == "every_source_and_document_is_in_version_control" {
        return everything_is_tracked(work);
    }
    if name == "the_refusals_page_is_not_stale" {
        return refusals_page_is_current(compiler, work);
    }
    if name == "the_repository_layout_is_declared" {
        return layout_is_declared(work);
    }
    if name == "editor_grammar_knows_every_keyword_the_compiler_does" {
        return grammar_knows_every_keyword();
    }
    if name == "the_web_highlighter_knows_every_keyword_the_compiler_does" {
        return highlighter_knows_every_keyword();
    }
    // Not silence. A name in the list with no implementation behind it is a bug in this file,
    // and the only safe answer is to fail loudly — see the note at the top of this section.
    return "?unknown invariant";
}

// ---- isolation ---------------------------------------------------------------------------
//
// **Each invariant runs as a SUBPROCESS of the runner, and the reason is measured rather than
// theoretical.** `read_file` on a missing path ends the process, and a fixture with no `.stdout`
// used to kill this runner outright — no verdict, no summary, and the crash line printed before
// the banner because the abort discarded stdout's buffer. `cargo test` catches a panic and fails
// one test; the equivalent here is a process boundary, and `argument(0)` gives this program its
// own path, so it can re-invoke itself for exactly one invariant.
//
// So a crash becomes `not ok invariant/NAME: crashed`, which is a verdict, and the other 71 still
// run. The child is told which invariant to run through the same `only` argument a person uses.
function (mutable self: Outcome) sweep_invariants(compiler: String, work: String, only: String)
    -> Int touches files, commands, input
{
    let me: String = argument(0);
    let names: [String] = invariant_names();
    for name in names {
        if selected(only, "invariant", name) {
            // A single named invariant is run HERE rather than in a grandchild: `only` naming one
            // invariant is how the parent asks a child to do exactly this, so recursing would
            // never terminate.
            if only == "invariant/" + name {
                let why: String = run_invariant(name, compiler, work);
                let noted: Int = self.note(len(why) == 0, "invariant", name, why);
            } else {
                let log: String = work + "/invariant-" + name;
                let status: Int = run_capturing(me + " " + compiler + " " + work
                                                + " invariant/" + name, log);
                let said: String = read_file(log);
                if status == 0 && contains(said, "ok invariant/" + name) {
                    let noted: Int = self.note(true, "invariant", name, "");
                } else if contains(said, "not ok invariant/" + name) {
                    // The child reported properly; carry ITS reason rather than inventing one.
                    let noted: Int = self.note(false, "invariant", name,
                        after_colon(said, "not ok invariant/" + name));
                } else {
                    let noted: Int = self.note(false, "invariant", name,
                        "crashed or said nothing: " + trimmed(said));
                }
            }
        }
    }
    return 0;
}

// The text after `label: ` in `text`, to the end of that line. Used to carry a child's own reason
// up to the parent unchanged — a parent that re-worded it would be a second place the message
// lives, and the two would drift.
function after_colon(text: String, label: String) -> String {
    let mutable i: Int = 0;
    while i + len(label) <= len(text) {
        if starts_with_at_runner(text, i, label) {
            let mutable j: Int = i + len(label);
            if j < len(text) && byte_at(text, j) == 58 {
                j += 1;
            }
            if j < len(text) && byte_at(text, j) == 32 {
                j += 1;
            }
            let stop: Int = line_end(text, j);
            return substring(text, j, stop - j);
        }
        i += 1;
    }
    return "";
}

function starts_with_at_runner(text: String, at: Int, prefix: String) -> Bool {
    if at + len(prefix) > len(text) {
        return false;
    }
    let mutable i: Int = 0;
    while i < len(prefix) {
        if byte_at(text, at + i) != byte_at(prefix, i) {
            return false;
        }
        i += 1;
    }
    return true;
}

// ---- the sweep ---------------------------------------------------------------

// `only` selects: `""` is everything, `pass` is one kind, `pass/name` is one fixture.
//
// Two jobs, one mechanism, and the second is why it exists. The obvious one is a person
// debugging: re-running 447 fixtures to see one of them is a bad loop.
//
// The one that matters is that **`cargo test` gives `runner.rs` four things for free that this
// file has none of** — naming, selection, isolation, and parallelism — and selection is the one
// the other three are built on. `tests/support/runner_agreement.bx` mutates a fixture and asks
// whether the runner minds; without selection each question costs a full 28-second sweep, and the
// harness took five minutes to ask eight of them. With it, isolation is also reachable: a check
// can be run as a SUBPROCESS of the runner (`argument(0)` gives its own path, measured), so a
// crash fails one fixture instead of the suite — which is not hypothetical, a missing `.stdout`
// used to kill this program outright.
function selected(only: String, kind: String, name: String) -> Bool {
    if len(only) == 0 {
        return true;
    }
    if only == kind {
        return true;
    }
    return only == kind + "/" + name;
}

function (mutable self: Outcome) sweep(compiler: String, kind: String, work: String, only: String)
    -> Int touches files
{
    // The listing is read even when one fixture is wanted, because `ls` is cheap and because a
    // selection that names a fixture the directory does not hold should find nothing rather than
    // invent it.
    let names: String = listing_of("tests/" + kind, work + "/listing");
    let mutable at: Int = 0;
    while at < len(names) {
        let stop: Int = line_end(names, at);
        let entry: String = substring(names, at, stop - at);
        if ends_with_bx(entry) && selected(only, kind, without_extension(entry)) {
            let name: String = without_extension(entry);
            if kind == "pass" {
                let done: Int = self.check_pass(compiler, name, work);
            }
            if kind == "fail" {
                let done: Int = self.check_fail(compiler, name, work);
            }
            if kind == "panic" {
                let done: Int = self.check_panic(compiler, name, work);
            }
        }
        at = stop + 1;
    }
    return 0;
}

region suite {
    // Which compiler to exercise, and where to put what the run produces. Both are
    // arguments so this runner can test stage-0 today and stage-1 tomorrow without
    // being edited — the whole point of having two implementations.
    let mutable compiler: String = "./target/debug/burxt";
    if argument_count() > 1 {
        compiler = argument(1);
    }
    let mutable work: String = "/tmp/burxt-suite";
    if argument_count() > 2 {
        work = argument(2);
    }
    let made: Int = system("mkdir -p " + work);

    // Fixture programs run in `work`, and anything they need to READ is copied in first — the same
    // thing `install_fixtures` does in `tests/runner.rs`. Anything that is not a program or an
    // expectation is an input.
    //
    // This runner used to run pass fixtures with `cd tests/pass` and panic fixtures wherever it
    // happened to be standing, which was the repository root. Both leak: a fixture that WRITES a
    // file wrote it into the source tree. That is not hypothetical — `tests/pass/` holds
    // `bytes_out.txt` and `string_length_probe.txt`, both COMMITTED, both merely the output of the
    // fixture beside them, and `emitted.ll` sitting there untracked because `*.ll` is ignored.
    //
    // The nastier half is what that does to evidence. `install_fixtures` copies every non-program
    // file in the directory into the run as an INPUT, so a leaked output is indistinguishable from
    // a real fixture like `source_fixture.txt`. Nothing depends on one today, and the day something
    // does, it passes because of an artifact rather than because it works — which is the same shape
    // as a pass fixture that cannot tell "supported" from "not examined".
    // Copy everything, then remove the programs and expectations — rather than `find -exec`, whose
    // `{}` and `\;` both need escaping twice over (once for Burxt's interpolation, once for the
    // shell) and are unreadable by the time they survive both.
    let staged: Int = system("cp tests/pass/* tests/fail/* tests/panic/* " + work
                             + "/ 2>/dev/null; rm -f " + work + "/*.bx " + work + "/*.stdout "
                             + work + "/*.stderr; true");

    print("running the suite with " + compiler);

    let mutable only: String = "";
    if argument_count() > 3 {
        only = argument(3);
    }

    let mutable result: Outcome = Outcome { ran: 0, passed: 0, failed: 0,
                                            claims: 0, claims_passed: 0, claims_failed: 0 };
    let a: Int = result.sweep(compiler, "pass", work, only);
    let b: Int = result.sweep(compiler, "fail", work, only);
    let c: Int = result.sweep(compiler, "panic", work, only);
    let d: Int = result.sweep_invariants(compiler, work, only);

    print("---");
    print("ran " + to_string(result.ran) + ", passed " + to_string(result.passed)
          + ", failed " + to_string(result.failed));
    print("invariants " + to_string(result.claims) + ", passed "
          + to_string(result.claims_passed) + ", failed " + to_string(result.claims_failed));
    if result.failed > 0 || result.claims_failed > 0 {
        print("SUITE FAILED");
        // **And exit NONZERO, which this program did not do for its whole life so far.** It
        // printed `SUITE FAILED` and exited 0, so a CI step that ran it and trusted the exit
        // status would go green on a red suite — the one failure mode a test runner must not
        // have. Found by making an invariant crash on purpose and reading the exit code instead
        // of the output.
        //
        // `the_suite_also_runs_on_burxt` reads the OUTPUT for `all green` rather than the status,
        // so this is safe to add and always should have been here. A runner is a program a shell
        // asks a yes-or-no question of.
        exit(1);
    }
    print("all green");
}
