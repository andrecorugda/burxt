// ============================================================================
// The test suite, in Burxt.
//
//     burxt build tests/runner.bx -o /tmp/burxt-runner
//     /tmp/burxt-runner [compiler] [work-dir] [only]
//
// `only` is empty for everything, `pass` for one kind, `pass/name` for one fixture, `invariant`
// for every invariant, or `invariant/name` for one of those.
//
// It runs the same fixtures `tests/runner.rs` runs, and a Rust test asserts the
// two agree — so this is a second implementation of the harness, not a
// replacement for it, the same relationship stage-1 has with stage-0.
//
// Three kinds of fixture, and the directory says which:
//   tests/pass/NAME.bx   + NAME.stdout   must compile, run, and print that
//   tests/fail/NAME.bx   + NAME.stderr   must be REFUSED, with that text in the message
//   tests/panic/NAME.bx  + NAME.stderr   must compile, then die with that text
//
// Everything it needs from the machine goes through one C function. Burxt cannot
// yet list a directory — `opendir` returns a pointer, and the memory model has
// nothing to say about who owns it — so the shell lists it and the answer comes
// back through a file. That is a real limit, honestly worked around rather than
// pretended away, and it is the first thing the standard library will hide.
// ============================================================================

external function system(command: String) -> CInt;

// Whether a path can be opened for reading. **The only guard there is**: `read_file` does not
// answer a failure, it ENDS THE PROCESS — `burxt runtime error: cannot open file for reading`.
//
// It is here because of a measured hole, not a hypothetical one. A fixture whose `.stdout` was
// missing killed this runner outright: no verdict, no summary, and the crash line arrived BEFORE
// the banner because the abort discarded stdout's buffer. A contributor adding `foo.bx` and
// forgetting `foo.stdout` got a dead runner instead of "foo has no .stdout". For a file that is
// about to become the suite's primary authority that is the wrong failure shape — an authority
// must report, not die.
external function fopen(path: String, mode: String) -> CPointer touches files;
external function fclose(stream: CPointer) -> CInt touches files;

function readable(path: String) -> Bool touches files {
    let f: CPointer = fopen(path, "r");
    if c_is_null(f) {
        return false;
    }
    let closed: Int = fclose(f);
    return true;
}

// Fixtures and invariants are counted APART, and that is not bookkeeping tidiness.
//
// `the_suite_also_runs_on_burxt` in `tests/runner.rs` asserts this program prints
// `ran N, passed N, failed 0` where N is the number of `.bx` files in `tests/{pass,fail,panic}`.
// Folding two invariants into that total made it 449 against 447 on disk and would have failed
// the Rust cross-check — correctly, because the number no longer meant what its name says. They
// are also genuinely different claims: a fixture is a program with a recorded answer, an
// invariant is a statement about the repository. One total for both would be the kind of summary
// that hides which half went red.
class Outcome { ran: Int, passed: Int, failed: Int,
                claims: Int, claims_passed: Int, claims_failed: Int }

// ---- talking to the machine -------------------------------------------------

// Every name in a directory, one per line, via the shell. `ls` is the only thing
// here that is not Burxt, and it is doing what a directory read would do.
function listing_of(directory: String, into: String) -> String touches files {
    let command: String = "ls " + directory + " > " + into + " 2>/dev/null";
    let status: Int = system(command);
    return read_file(into);
}

// Every name in a directory INCLUDING the dotfiles, which `ls` hides by default. `-A` rather
// than `-a` because `.` and `..` are not entries anyone means. Needed by the repository-root
// invariant: `.gitignore` and `.github` are exactly the kind of thing that belongs there, and a
// listing that cannot see them would call a stray root file clean.
function listing_all_of(directory: String, into: String) -> String touches files, commands {
    let command: String = "ls -A " + directory + " > " + into + " 2>/dev/null";
    let status: Int = system(command);
    return read_file(into);
}

// Every file under `directory` whose name matches `pattern`, one per line, RECURSIVELY.
//
// The shared helper the document invariants needed. `ls` cannot recurse and Burxt cannot walk a
// tree — `opendir` answers a pointer the memory model has nothing to say about — so `find` does
// what a recursive read would, and the answer comes back through a file. Exactly the shape of
// `listing_of` above, one level further out, and the same honest workaround rather than a
// pretended-away limit.
function find_of(directory: String, pattern: String, into: String) -> String touches files, commands {
    let command: String = "find " + directory + " -type f -name '" + pattern + "' > " + into
        + " 2>/dev/null";
    let status: Int = system(command);
    return read_file(into);
}

// Run a command, capturing everything it says, and answer its exit code.
// `system` reports the wait status, and the exit code is the high byte of it.
function run_capturing(command: String, output: String) -> Int {
    let status: Int = system(command + " > " + output + " 2>&1");
    return divide_floor(status, 256);
}

// The same, but keeping the two streams APART: only stdout is captured, and stderr is discarded.
//
// Needed once `print_error` existed (v0.0.203). A pass fixture is compared against its `.stdout`, so
// merging the streams made anything written to stderr look like a difference — this runner reported
// `tests/pass/print_error.bx` as failing while the Rust runner, which reads the two separately, passed
// it. The merge was invisible for as long as nothing could write to stderr on purpose.
//
// Compiling still uses the merged form: there the diagnostics ARE the output being checked.
function run_capturing_stdout(command: String, output: String) -> Int {
    let status: Int = system(command + " > " + output + " 2>/dev/null");
    return divide_floor(status, 256);
}

// ---- reading the listing ----------------------------------------------------

function line_end(text: String, from: Int) -> Int {
    let mutable i: Int = from;
    while i < len(text) && byte_at(text, i) != 10 {
        i += 1;
    }
    return i;
}

function ends_with_bx(name: String) -> Bool {
    let n: Int = len(name);
    if n < 3 {
        return false;
    }
    return byte_at(name, n - 3) == 46 && byte_at(name, n - 2) == 98
        && byte_at(name, n - 1) == 120;
}

function without_extension(name: String) -> String {
    return substring(name, 0, len(name) - 3);
}

// ---- comparing ---------------------------------------------------------------

// Whether `haystack` contains `needle`. A fail fixture classes the text the error
// must CONTAIN rather than the whole message, so a reworded diagnostic does not
// break a test that is really about the rule.
function contains(haystack: String, needle: String) -> Bool {
    let n: Int = len(needle);
    if n == 0 {
        return true;
    }
    let mutable i: Int = 0;
    while i + n <= len(haystack) {
        let mutable k: Int = 0;
        let mutable same: Bool = true;
        while k < n {
            if byte_at(haystack, i + k) != byte_at(needle, k) {
                same = false;
                k = n;
            } else {
                k += 1;
            }
        }
        if same {
            return true;
        }
        i += 1;
    }
    return false;
}

// The recorded text, with the trailing newline a file always has removed.
function trimmed(text: String) -> String {
    let mutable n: Int = len(text);
    while n > 0 && byte_at(text, n - 1) == 10 {
        n -= 1;
    }
    return substring(text, 0, n);
}

// ---- the three kinds of check -----------------------------------------------

// One verdict per fixture, named, on stdout.
//
// **A summary is not evidence and a count cannot see a fixture change hands.** `ran 447, passed
// 447` is true of a runner that examined 447 fixtures and equally true of one that examined 446
// and one of them twice. So every fixture says its own name and its own answer, and
// `tests/support/runner_agreement.bx` compares that SET against the directory rather than
// comparing two totals — which is the whole reason this line exists.
//
// `ok` / `not ok` is TAP's spelling, chosen because it is a format other tools already read, and
// because a fixture's name is the only stable identifier the suite has.
function (mutable self: Outcome) note(passed: Bool, kind: String, name: String,
                                      why: String) -> Int {
    if kind == "invariant" {
        self.claims += 1;
        if passed {
            self.claims_passed += 1;
        } else {
            self.claims_failed += 1;
        }
    } else {
        self.ran += 1;
        if passed {
            self.passed += 1;
        } else {
            self.failed += 1;
        }
    }
    if passed {
        print("ok " + kind + "/" + name);
        return 0;
    }
    print("not ok " + kind + "/" + name + ": " + one_line(why));
    return 0;
}

// A reason, flattened to one line.
//
// **A verdict that spans lines is not machine-readable, and finding that out cost a confusing
// hour.** `printed X, expected Y` embeds a fixture's own output, and `tests/pass/rounding_negative`
// prints three lines — so its failure verdict was five lines, of which only the first began with
// `not ok`. Every consumer that reads this stream a line at a time then miscounts: the agreement
// harness reported a fixture as NOT EXAMINED when it had been examined and had failed.
//
// So the newline becomes a visible `\n` and the verdict is one line by construction. Carriage
// returns go too, because a `.stdout` recorded on Windows would otherwise split a line at the
// terminal without splitting it in the file.
function one_line(why: String) -> String {
    let mutable out: String = "";
    let mutable i: Int = 0;
    while i < len(why) {
        let b: Int = byte_at(why, i);
        if b == 10 {
            out += "\\n";
        } else if b == 13 {
            out += "\\r";
        } else {
            out += substring(why, i, 1);
        }
        i += 1;
    }
    return out;
}

function (mutable self: Outcome) check_pass(compiler: String, name: String, work: String)
    -> Int touches files
{
    let source: String = "tests/pass/" + name + ".bx";
    let expectation: String = "tests/pass/" + name + ".stdout";
    if !readable(expectation) {
        let noted: Int = self.note(false, "pass", name,
            "has no .stdout — a fixture must state what it expects");
        return 0;
    }
    let expected: String = trimmed(read_file(expectation));
    let binary: String = work + "/" + name;
    let log: String = work + "/out";

    let built: Int = run_capturing(compiler + " build " + source + " -o " + binary, log);
    if built != 0 {
        let noted: Int = self.note(false, "pass", name, "did not compile: " + trimmed(read_file(log)));
        return 0;
    }
    // In the fixture directory, because a program may read a file next to it.
    let ran: Int = run_capturing_stdout("cd tests/pass && " + binary, log);
    let printed: String = trimmed(read_file(log));
    if ran != 0 {
        let noted: Int = self.note(false, "pass", name, "exited " + to_string(ran));
        return 0;
    }
    if printed == expected {
        let noted: Int = self.note(true, "pass", name, "");
        return 0;
    }
    let noted: Int = self.note(false, "pass", name,
        "printed " + printed + ", expected " + expected);
    return 0;
}

function (mutable self: Outcome) check_fail(compiler: String, name: String, work: String)
    -> Int touches files
{
    let source: String = "tests/fail/" + name + ".bx";
    let expectation: String = "tests/fail/" + name + ".stderr";
    if !readable(expectation) {
        let noted: Int = self.note(false, "fail", name,
            "has no .stderr — a fixture must state what it expects");
        return 0;
    }
    let wanted: String = trimmed(read_file(expectation));
    let log: String = work + "/out";

    // `check` rather than `build`: a refusal needs no linker, and this is the only
    // thing the fixture is about.
    let status: Int = run_capturing(compiler + " check " + source, log);
    let said: String = read_file(log);
    if status == 0 {
        let noted: Int = self.note(false, "fail", name, "was accepted, and should not be");
        return 0;
    }
    if contains(said, wanted) {
        let noted: Int = self.note(true, "fail", name, "");
        return 0;
    }
    let noted: Int = self.note(false, "fail", name,
        "refused it for the wrong reason: " + trimmed(said));
    return 0;
}

function (mutable self: Outcome) check_panic(compiler: String, name: String, work: String)
    -> Int touches files
{
    let source: String = "tests/panic/" + name + ".bx";
    let expectation: String = "tests/panic/" + name + ".stderr";
    if !readable(expectation) {
        let noted: Int = self.note(false, "panic", name,
            "has no .stderr — a fixture must state what it expects");
        return 0;
    }
    let wanted: String = trimmed(read_file(expectation));
    let binary: String = work + "/" + name;
    let log: String = work + "/out";

    let built: Int = run_capturing(compiler + " build " + source + " -o " + binary, log);
    if built != 0 {
        let noted: Int = self.note(false, "panic", name, "did not compile, and should have");
        return 0;
    }
    let ran: Int = run_capturing(binary, log);
    let said: String = read_file(log);
    if ran == 0 {
        let noted: Int = self.note(false, "panic", name, "ran to completion, and should have died");
        return 0;
    }
    if contains(said, wanted) {
        let noted: Int = self.note(true, "panic", name, "");
        return 0;
    }
    let noted: Int = self.note(false, "panic", name,
        "died for the wrong reason: " + trimmed(said));
    return 0;
}


// ---- invariants ---------------------------------------------------------------------------
//
// A fixture is a program with a recorded answer. An INVARIANT is a claim about the repository
// that no single program can carry — that the root holds nothing stray, that every example still
// typechecks. `tests/runner.rs` has 72 of them and gets four services from `cargo test` for
// free: naming, selection, isolation, and parallelism. This section supplies the first three.
//
// **Dispatch is a chain of `if`s and the list of names is written separately, which is a real
// hazard worth naming rather than hiding.** Burxt has no function values, so an invariant cannot
// be put in an array — and that means an implemented invariant missing from `invariant_names`
// would simply never run, silently, which is this project's oldest failure shape. Two things
// guard it: an unknown name answers `?unknown invariant` and is reported as a failure rather
// than skipped, and `tests/support/runner_agreement.bx` compares this list against the `#[test]`
// names in `runner.rs` and prints the shortfall as a number. A number can be ratcheted; a
// forgotten `push` cannot.

// The `runner.rs` invariants this file answers WITHOUT a named invariant of its own — because the
// fixture walk already does exactly their work. Listed rather than inferred, so the coverage
// number in `tests/support/runner_agreement.bx` credits real work instead of understating it, and
// so that adding a name here is a visible claim someone can check rather than a silent bump.
function answered_by_the_fixture_sweep() -> [String] {
    let mutable all: [String] = [];
    push(all, "pass_programs_produce_expected_stdout");
    push(all, "fail_programs_are_rejected_with_expected_error");
    push(all, "panic_programs_die_cleanly_at_runtime");
    return all;
}

function invariant_names() -> [String] {
    let mutable all: [String] = [];
    push(all, "the_repository_root_holds_only_what_belongs_there");
    push(all, "every_example_still_typechecks");
    push(all, "every_log_file_is_linked_from_its_index");
    push(all, "no_html_page_is_written_in_markdown");
    push(all, "the_mascot_plays_once");
    return all;
}

// What may sit at the repository root. Word for word `runner.rs`'s two lists, and they are one
// list here because Burxt has no `const [&str; N]` and the distinction between "file" and
// "directory" does no work in the comparison.
function allowed_at_root(name: String) -> Bool {
    if name == "Cargo.toml" { return true; }
    if name == "Cargo.lock" { return true; }
    if name == ".cargo" { return true; }
    if name == ".git" { return true; }
    if name == ".gitignore" { return true; }
    if name == ".gitattributes" { return true; }
    if name == ".vscode" { return true; }
    if name == "target" { return true; }
    if name == "README.md" { return true; }
    if name == "DESIGN.md" { return true; }
    if name == "CONTRIBUTING.md" { return true; }
    if name == "CODE_OF_CONDUCT.md" { return true; }
    if name == "LICENSE-MIT" { return true; }
    if name == "LICENSE-APACHE" { return true; }
    if name == "src" { return true; }
    if name == "spec" { return true; }
    if name == "tests" { return true; }
    if name == "examples" { return true; }
    if name == "editors" { return true; }
    if name == "assets" { return true; }
    if name == "docs" { return true; }
    if name == "lib" { return true; }
    if name == "scripts" { return true; }
    if name == "dist" { return true; }
    if name == ".github" { return true; }
    if name == ".devcontainer" { return true; }
    return false;
}

function root_holds_only_what_belongs(work: String) -> String touches files, commands {
    let names: String = listing_all_of(".", work + "/root-listing");
    let mutable strays: String = "";
    let mutable at: Int = 0;
    while at < len(names) {
        let stop: Int = line_end(names, at);
        let entry: String = substring(names, at, stop - at);
        if len(entry) > 0 && !allowed_at_root(entry) {
            if len(strays) > 0 {
                strays += ", ";
            }
            strays += entry;
        }
        at = stop + 1;
    }
    if len(strays) == 0 {
        return "";
    }
    return "these do not belong at the repository root — build with `-o <path>` and move sources "
        + "into a directory: " + strays;
}

// Every `examples/*.bx` must still typecheck. `check` rather than `build`, exactly as the Rust
// one does: an example is about the language, not about the linker.
//
// The floor is `runner.rs`'s — at least three — and it is here for the reason the floor exists
// there: an empty `examples/` would otherwise make this invariant pass by having nothing to say.
function examples_typecheck(compiler: String, work: String) -> String touches files, commands {
    let names: String = listing_of("examples", work + "/examples-listing");
    let log: String = work + "/out";
    let mutable checked: Int = 0;
    let mutable failures: String = "";
    let mutable at: Int = 0;
    while at < len(names) {
        let stop: Int = line_end(names, at);
        let entry: String = substring(names, at, stop - at);
        if ends_with_bx(entry) {
            let status: Int = run_capturing(compiler + " check examples/" + entry, log);
            checked += 1;
            if status != 0 {
                if len(failures) > 0 {
                    failures += "; ";
                }
                failures += entry + ": " + trimmed(read_file(log));
            }
        }
        at = stop + 1;
    }
    if checked < 3 {
        return "expected several examples, checked only " + to_string(checked);
    }
    if len(failures) > 0 {
        return failures;
    }
    return "";
}


// How many lines `text` holds. `DESIGN.md` growing back into a log is measured, not felt.
function count_lines(text: String) -> Int {
    let mutable lines: Int = 0;
    let mutable i: Int = 0;
    while i < len(text) {
        if byte_at(text, i) == 10 {
            lines += 1;
        }
        i += 1;
    }
    return lines;
}

// The milestone log is split across files, so the index and the files must agree. Two ways to
// drift and both silent: a log file nobody links to, and a link to a file that was renamed.
// Checked in BOTH directions for that reason — the Rust one does, and a one-way check would pass
// a log whose index lists nothing.
function log_files_are_linked(work: String) -> String touches files, commands {
    if !readable("docs/log/README.md") {
        return "docs/log/README.md is missing, and it is the log's index";
    }
    let index: String = read_file("docs/log/README.md");
    let names: String = listing_of("docs/log", work + "/log-listing");
    let mutable found: Int = 0;
    let mutable unlinked: String = "";
    let mutable at: Int = 0;
    while at < len(names) {
        let stop: Int = line_end(names, at);
        let entry: String = substring(names, at, stop - at);
        if len(entry) > 3 && entry != "README.md"
            && substring(entry, len(entry) - 3, 3) == ".md" {
            found += 1;
            if !contains(index, entry) {
                if len(unlinked) > 0 {
                    unlinked += ", ";
                }
                unlinked += entry;
            }
        }
        at = stop + 1;
    }
    if found < 8 {
        return "the log lost files: only " + to_string(found) + " entries beside the index";
    }
    if len(unlinked) > 0 {
        return "docs/log/README.md does not link: " + unlinked;
    }
    // The other direction: every link in the index must resolve. A markdown link is `](target)`,
    // and only local `.md` targets are checked — `../` leaves the log and a `#` is a fragment
    // within a page, neither of which is this invariant's business.
    let mutable missing: String = "";
    let mutable i: Int = 0;
    while i < len(index) {
        if byte_at(index, i) == 40 {                 // '('
            let mutable j: Int = i + 1;
            while j < len(index) && byte_at(index, j) != 41 {
                j += 1;
            }
            let target: String = substring(index, i + 1, j - i - 1);
            if len(target) > 3 && substring(target, len(target) - 3, 3) == ".md"
                && !starts_with_at_runner(target, 0, "../") && !contains(target, "#") {
                if !readable("docs/log/" + target) {
                    if len(missing) > 0 {
                        missing += ", ";
                    }
                    missing += target;
                }
            }
            i = j + 1;
        } else {
            i += 1;
        }
    }
    if len(missing) > 0 {
        return "docs/log/README.md links files that do not exist: " + missing;
    }
    // `DESIGN.md` must POINT AT the log rather than hold it: the split is the whole point, and a
    // document that grows back into a log has quietly undone it.
    let design: String = read_file("DESIGN.md");
    if !contains(design, "docs/log/") {
        return "DESIGN.md must link the log";
    }
    if count_lines(design) >= 1200 {
        return "DESIGN.md is growing back into a log: " + to_string(count_lines(design)) + " lines";
    }
    return "";
}

// Markdown in a `.html` page reaches the live site verbatim, because kramdown never runs on one.
//
// Two exclusions, and both are in the Rust twin for reasons worth keeping. `_layouts` and
// `_includes` are templates rather than pages and hold no prose. And HTML COMMENTS are stripped
// before the scan, because a page explaining this very rule would otherwise fail it — the first
// version of the Rust test tripped on the sentence in `404.html` telling authors not to write
// `markdown="1"`. That is the prose-versus-pattern trap, and mirroring the fix matters more than
// mirroring the check.
function html_pages_are_not_markdown(work: String) -> String touches files, commands {
    let listing: String = find_of("docs", "*.html", work + "/html-listing");
    let mutable wrong: String = "";
    let mutable seen: Int = 0;
    let mutable at: Int = 0;
    while at < len(listing) {
        let stop: Int = line_end(listing, at);
        let path: String = substring(listing, at, stop - at);
        if len(path) > 0 && !contains(path, "_layouts") && !contains(path, "_includes") {
            seen += 1;
            let body: String = without_comments(after_front_matter(read_file(path)));
            let mutable line_no: Int = 1;
            let mutable k: Int = 0;
            while k < len(body) {
                let end: Int = line_end(body, k);
                if starts_with_at_runner(body, k, "# ") || starts_with_at_runner(body, k, "## ")
                    || starts_with_at_runner(body, k, "- ") || starts_with_at_runner(body, k, "|") {
                    if len(wrong) > 0 {
                        wrong += "; ";
                    }
                    wrong += path + ":" + to_string(line_no) + " is markdown in an .html page";
                }
                line_no += 1;
                k = end + 1;
            }
            if contains(body, "markdown=\"1\"") {
                if len(wrong) > 0 {
                    wrong += "; ";
                }
                wrong += path + " sets markdown=\"1\", which does nothing in an .html page";
            }
        }
        at = stop + 1;
    }
    // **A floor of 2, which is the measured count and not a guess — the first version said 3 and
    // failed honestly on a site that has two pages.** `docs/` holds four `.html` files and two of
    // them are in `_layouts`/`_includes`.
    //
    // The Rust twin has no floor here and does not need one: `walk` starts with
    // `fs::read_dir(dir).unwrap()`, so a missing `docs/` panics there. `find` prints nothing and
    // exits quietly, so the same mistake would make this invariant pass by having no pages to be
    // wrong about. **The floor is not mirroring the Rust check, it is paying for the difference
    // between an in-process walk and a shell one.**
    if seen < 2 {
        return "expected the two .html pages under docs/, examined only " + to_string(seen);
    }
    if len(wrong) > 0 {
        return wrong;
    }
    return "";
}

// The text after a page's YAML front matter. A `#` in there is a YAML comment and entirely
// correct, so scanning it for markdown headings would report every page.
function after_front_matter(text: String) -> String {
    if !starts_with_at_runner(text, 0, "---") {
        return text;
    }
    let mutable i: Int = 3;
    while i + 4 <= len(text) {
        if byte_at(text, i) == 10 && starts_with_at_runner(text, i + 1, "---") {
            return substring(text, i + 4, len(text) - i - 4);
        }
        i += 1;
    }
    return text;
}

// The same text with every `<!-- ... -->` removed. See `html_pages_are_not_markdown` for why.
function without_comments(text: String) -> String {
    let mutable out: String = "";
    let mutable i: Int = 0;
    while i < len(text) {
        if starts_with_at_runner(text, i, "<!--") {
            let mutable j: Int = i + 4;
            while j + 3 <= len(text) && !starts_with_at_runner(text, j, "-->") {
                j += 1;
            }
            if j + 3 > len(text) {
                return out;                          // unterminated: nothing after it is code
            }
            i = j + 3;
        } else {
            out += substring(text, i, 1);
            i += 1;
        }
    }
    return out;
}


// Where `needle` starts in `haystack`, or -1. `contains` answers whether; this answers where, and
// the GIF check needs the offset.
function index_of(haystack: String, needle: String) -> Int {
    let n: Int = len(needle);
    if n == 0 {
        return 0;
    }
    let mutable i: Int = 0;
    while i + n <= len(haystack) {
        let mutable k: Int = 0;
        let mutable same: Bool = true;
        while k < n {
            if byte_at(haystack, i + k) != byte_at(needle, k) {
                same = false;
                k = n;
            } else {
                k += 1;
            }
        }
        if same {
            return i;
        }
        i += 1;
    }
    return 0 - 1;
}

// The hero's mark must play ONCE and rest.
//
// **This one reads a BINARY file, and that capability was probed before a line of it was written.**
// `read_file` preserves every byte including NULs: on `assets/burxt-ember.gif` it answers 108599
// bytes, `71 73 70 56 57 97` for `GIF89a`, and finds `NETSCAPE2.0` at offset 784 with a loop count
// of 1 — byte for byte what Python reports for the same file. So Burxt can inspect a binary
// format, and this invariant is not a text check pretending.
//
// The loop count lives in the NETSCAPE application extension: the eleven bytes `NETSCAPE2.0`, then
// `0x03 0x01`, then two little-endian bytes. 0 means forever. The animation ends with the ember
// hidden, so exactly one play leaves a still logo — which is the whole design, and why the number
// is 1 rather than "small".
function mascot_plays_once() -> String touches files {
    let mutable wrong: String = "";
    let marker: String = "NETSCAPE2.0";
    // Both copies, because `docs/assets/` exists only so Pages can serve it, and a divergence
    // between them means the site shows something the brand folder does not.
    let here: String = "assets/burxt-ember.gif";
    let served: String = "docs/assets/burxt-ember.gif";
    if !readable(here) || !readable(served) {
        return "the mascot is missing from assets/ or docs/assets/";
    }
    let a: String = read_file(here);
    let b: String = read_file(served);
    let mutable which: Int = 0;
    while which < 2 {
        let mutable copy: String = a;
        let mutable named: String = here;
        if which == 1 {
            copy = b;
            named = served;
        }
        if len(copy) < 6 || substring(copy, 0, 6) != "GIF89a" {
            if len(wrong) > 0 { wrong += "; "; }
            wrong += named + " is not an animated GIF";
        } else {
            let at: Int = index_of(copy, marker);
            if at < 0 {
                if len(wrong) > 0 { wrong += "; "; }
                wrong += named + " has no NETSCAPE extension, so it has no loop count";
            } else {
                let low: Int = byte_at(copy, at + len(marker) + 2);
                let high: Int = byte_at(copy, at + len(marker) + 3);
                let loops: Int = low + high * 256;
                if loops != 1 {
                    if len(wrong) > 0 { wrong += "; "; }
                    wrong += named + " is set to loop " + to_string(loops)
                        + " times — patch the two bytes after `NETSCAPE2.0\\x03\\x01` to 1 rather "
                        + "than re-encoding, which would recompress every frame";
                }
            }
        }
        which += 1;
    }
    if len(a) != len(b) || a != b {
        if len(wrong) > 0 { wrong += "; "; }
        wrong += "assets/ and docs/assets/ hold different copies of the mascot";
    }
    // A GIF cannot be paused by CSS, so the only way to honour a reduced-motion preference is to
    // hand over a different file.
    if !readable("assets/burxt-ember-still.png") || !readable("docs/assets/burxt-ember-still.png") {
        if len(wrong) > 0 { wrong += "; "; }
        wrong += "the reduced-motion poster is missing from assets/ or docs/assets/";
    }
    let mutable page: Int = 0;
    while page < 2 {
        let mutable named: String = "docs/index.md";
        if page == 1 {
            named = "docs/404.html";
        }
        if readable(named) {
            let text: String = read_file(named);
            if contains(text, "burxt-ember.gif") {
                if !contains(text, "prefers-reduced-motion: reduce")
                    || !contains(text, "burxt-ember-still.png") {
                    if len(wrong) > 0 { wrong += "; "; }
                    wrong += named + " shows the mascot with no reduced-motion source offering "
                        + "burxt-ember-still.png";
                }
                // Width and height, or the page reflows when 106 KB finishes arriving.
                if !contains(text, "width=\"174\" height=\"222\"") {
                    if len(wrong) > 0 { wrong += "; "; }
                    wrong += named + " does not give the mascot its intrinsic size, so it will "
                        + "shift the layout as it loads";
                }
            }
        }
        page += 1;
    }
    if len(wrong) > 0 {
        return wrong;
    }
    return "";
}

// The reason an invariant does NOT hold, or `""` when it does.
function run_invariant(name: String, compiler: String, work: String) -> String
    touches files, commands
{
    if name == "the_repository_root_holds_only_what_belongs_there" {
        return root_holds_only_what_belongs(work);
    }
    if name == "every_example_still_typechecks" {
        return examples_typecheck(compiler, work);
    }
    if name == "every_log_file_is_linked_from_its_index" {
        return log_files_are_linked(work);
    }
    if name == "no_html_page_is_written_in_markdown" {
        return html_pages_are_not_markdown(work);
    }
    if name == "the_mascot_plays_once" {
        return mascot_plays_once();
    }
    // Not silence. A name in the list with no implementation behind it is a bug in this file,
    // and the only safe answer is to fail loudly — see the note at the top of this section.
    return "?unknown invariant";
}

// ---- isolation ---------------------------------------------------------------------------
//
// **Each invariant runs as a SUBPROCESS of the runner, and the reason is measured rather than
// theoretical.** `read_file` on a missing path ends the process, and a fixture with no `.stdout`
// used to kill this runner outright — no verdict, no summary, and the crash line printed before
// the banner because the abort discarded stdout's buffer. `cargo test` catches a panic and fails
// one test; the equivalent here is a process boundary, and `argument(0)` gives this program its
// own path, so it can re-invoke itself for exactly one invariant.
//
// So a crash becomes `not ok invariant/NAME: crashed`, which is a verdict, and the other 71 still
// run. The child is told which invariant to run through the same `only` argument a person uses.
function (mutable self: Outcome) sweep_invariants(compiler: String, work: String, only: String)
    -> Int touches files, commands, input
{
    let me: String = argument(0);
    let names: [String] = invariant_names();
    for name in names {
        if selected(only, "invariant", name) {
            // A single named invariant is run HERE rather than in a grandchild: `only` naming one
            // invariant is how the parent asks a child to do exactly this, so recursing would
            // never terminate.
            if only == "invariant/" + name {
                let why: String = run_invariant(name, compiler, work);
                let noted: Int = self.note(len(why) == 0, "invariant", name, why);
            } else {
                let log: String = work + "/invariant-" + name;
                let status: Int = run_capturing(me + " " + compiler + " " + work
                                                + " invariant/" + name, log);
                let said: String = read_file(log);
                if status == 0 && contains(said, "ok invariant/" + name) {
                    let noted: Int = self.note(true, "invariant", name, "");
                } else if contains(said, "not ok invariant/" + name) {
                    // The child reported properly; carry ITS reason rather than inventing one.
                    let noted: Int = self.note(false, "invariant", name,
                        after_colon(said, "not ok invariant/" + name));
                } else {
                    let noted: Int = self.note(false, "invariant", name,
                        "crashed or said nothing: " + trimmed(said));
                }
            }
        }
    }
    return 0;
}

// The text after `label: ` in `text`, to the end of that line. Used to carry a child's own reason
// up to the parent unchanged — a parent that re-worded it would be a second place the message
// lives, and the two would drift.
function after_colon(text: String, label: String) -> String {
    let mutable i: Int = 0;
    while i + len(label) <= len(text) {
        if starts_with_at_runner(text, i, label) {
            let mutable j: Int = i + len(label);
            if j < len(text) && byte_at(text, j) == 58 {
                j += 1;
            }
            if j < len(text) && byte_at(text, j) == 32 {
                j += 1;
            }
            let stop: Int = line_end(text, j);
            return substring(text, j, stop - j);
        }
        i += 1;
    }
    return "";
}

function starts_with_at_runner(text: String, at: Int, prefix: String) -> Bool {
    if at + len(prefix) > len(text) {
        return false;
    }
    let mutable i: Int = 0;
    while i < len(prefix) {
        if byte_at(text, at + i) != byte_at(prefix, i) {
            return false;
        }
        i += 1;
    }
    return true;
}

// ---- the sweep ---------------------------------------------------------------

// `only` selects: `""` is everything, `pass` is one kind, `pass/name` is one fixture.
//
// Two jobs, one mechanism, and the second is why it exists. The obvious one is a person
// debugging: re-running 447 fixtures to see one of them is a bad loop.
//
// The one that matters is that **`cargo test` gives `runner.rs` four things for free that this
// file has none of** — naming, selection, isolation, and parallelism — and selection is the one
// the other three are built on. `tests/support/runner_agreement.bx` mutates a fixture and asks
// whether the runner minds; without selection each question costs a full 28-second sweep, and the
// harness took five minutes to ask eight of them. With it, isolation is also reachable: a check
// can be run as a SUBPROCESS of the runner (`argument(0)` gives its own path, measured), so a
// crash fails one fixture instead of the suite — which is not hypothetical, a missing `.stdout`
// used to kill this program outright.
function selected(only: String, kind: String, name: String) -> Bool {
    if len(only) == 0 {
        return true;
    }
    if only == kind {
        return true;
    }
    return only == kind + "/" + name;
}

function (mutable self: Outcome) sweep(compiler: String, kind: String, work: String, only: String)
    -> Int touches files
{
    // The listing is read even when one fixture is wanted, because `ls` is cheap and because a
    // selection that names a fixture the directory does not hold should find nothing rather than
    // invent it.
    let names: String = listing_of("tests/" + kind, work + "/listing");
    let mutable at: Int = 0;
    while at < len(names) {
        let stop: Int = line_end(names, at);
        let entry: String = substring(names, at, stop - at);
        if ends_with_bx(entry) && selected(only, kind, without_extension(entry)) {
            let name: String = without_extension(entry);
            if kind == "pass" {
                let done: Int = self.check_pass(compiler, name, work);
            }
            if kind == "fail" {
                let done: Int = self.check_fail(compiler, name, work);
            }
            if kind == "panic" {
                let done: Int = self.check_panic(compiler, name, work);
            }
        }
        at = stop + 1;
    }
    return 0;
}

region suite {
    // Which compiler to exercise, and where to put what the run produces. Both are
    // arguments so this runner can test stage-0 today and stage-1 tomorrow without
    // being edited — the whole point of having two implementations.
    let mutable compiler: String = "./target/debug/burxt";
    if argument_count() > 1 {
        compiler = argument(1);
    }
    let mutable work: String = "/tmp/burxt-suite";
    if argument_count() > 2 {
        work = argument(2);
    }
    let made: Int = system("mkdir -p " + work);

    print("running the suite with " + compiler);

    let mutable only: String = "";
    if argument_count() > 3 {
        only = argument(3);
    }

    let mutable result: Outcome = Outcome { ran: 0, passed: 0, failed: 0,
                                            claims: 0, claims_passed: 0, claims_failed: 0 };
    let a: Int = result.sweep(compiler, "pass", work, only);
    let b: Int = result.sweep(compiler, "fail", work, only);
    let c: Int = result.sweep(compiler, "panic", work, only);
    let d: Int = result.sweep_invariants(compiler, work, only);

    print("---");
    print("ran " + to_string(result.ran) + ", passed " + to_string(result.passed)
          + ", failed " + to_string(result.failed));
    print("invariants " + to_string(result.claims) + ", passed "
          + to_string(result.claims_passed) + ", failed " + to_string(result.claims_failed));
    if result.failed > 0 || result.claims_failed > 0 {
        print("SUITE FAILED");
        // **And exit NONZERO, which this program did not do for its whole life so far.** It
        // printed `SUITE FAILED` and exited 0, so a CI step that ran it and trusted the exit
        // status would go green on a red suite — the one failure mode a test runner must not
        // have. Found by making an invariant crash on purpose and reading the exit code instead
        // of the output.
        //
        // `the_suite_also_runs_on_burxt` reads the OUTPUT for `all green` rather than the status,
        // so this is safe to add and always should have been here. A runner is a program a shell
        // asks a yes-or-no question of.
        exit(1);
    }
    print("all green");
}
