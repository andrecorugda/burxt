// Vector similarity, exactly — spec/N9-VECTORS-EXACTLY.md.
//
// The claim being pinned: the same query returns byte-identical scores, and the compiler traps rather
// than silently losing a digit. `f32` addition is not associative, so every float-based vector store's
// scores depend on the order its SIMD lanes reduced in — which depends on the CPU. Scaled-integer
// arithmetic is associative, so the wobble is absent rather than reduced.
//
// What that buys is the line below marked "the whole point": a retrieval test can assert a SCORE
// rather than a range. Nobody can do that with floats, which is why RAG quality is measured
// statistically today.
use "../../lib/vector.bx";

function vec3(a: Decimal<7>, b: Decimal<7>, c: Decimal<7>) -> [Decimal<7>] {
    let mutable v: [Decimal<7>] = [];
    let p: Int = push(v, a);
    let q: Int = push(v, b);
    let r: Int = push(v, c);
    return v;
}

let east: [Decimal<7>] = vec3(1.0000000, 0.0000000, 0.0000000);
let north: [Decimal<7>] = vec3(0.0000000, 1.0000000, 0.0000000);
// A 3-4-5 triangle, scaled: its magnitude is EXACTLY 1, which a float would give as 0.99999994.
let mostly_north: [Decimal<7>] = vec3(0.6000000, 0.8000000, 0.0000000);

// ---- the whole point: exact scores, asserted rather than approximated ----
print(vector_dot(east, east));                       // 1, exactly
print(vector_dot(east, north));                      // 0 — orthogonal
print(vector_dot(east, mostly_north));               // 0.6, exactly
print(vector_squared_distance(east, north));         // 2, and no square root was taken

// ---- magnitude, by binary search over the scaled count ----
// Nothing here converts a Decimal to an Int; Burxt has no way to do that, and none is needed.
print(vector_magnitude(mostly_north));               // 1.0000000 — the 3-4-5 triangle
print(vector_is_unit(mostly_north));
print(vector_is_unit(vec3(1.0000000, 1.0000000, 0.0000000)));
print(vector_magnitude(vec3(1.0000000, 1.0000000, 0.0000000)));   // √2, floored at 7 places

// ---- the 1536-dimension worst case ----
// Every component 0.9999999, which is the largest a normalised component can be at this scale. The
// answer is exact, and it is the same number on every machine — which is the claim.
let mutable big_a: [Decimal<7>] = [];
let mutable big_b: [Decimal<7>] = [];
let mutable i: Int = 0;
while i < 1536 {
    let p: Int = push(big_a, 0.9999999);
    let q: Int = push(big_b, 0.9999999);
    i += 1;
}
print(vector_dot(big_a, big_b));

// ---- brute-force top-K, ranked ----
// The ORDER is asserted, not just the membership. `east` scores 0 against `north` and is excluded.
let mutable rows: [Row] = [];
let r1: Int = push(rows, Row { id: "east", values: east });
let r2: Int = push(rows, Row { id: "north", values: north });
let r3: Int = push(rows, Row { id: "mostly-north", values: mostly_north });

let found: [Scored] = vector_top_dot(rows, north, 2);
print(len(found));
let mutable k: Int = 0;
while k < len(found) {
    print(rows[found[k].at].id + " " + to_string(found[k].score));
    k += 1;
}
