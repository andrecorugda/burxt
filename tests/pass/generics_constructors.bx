// A GENERIC CONSTRUCTOR: a function whose type parameters appear only in its return type.
//
// Two holes had to close for this, and both were the same shape — the compiler asking a question
// it could already answer:
//
//   1. A generic record literal INSIDE the generic that declares it. `Box { held: x }` within
//      `make_box<T>` is not an instantiation of anything yet; it becomes one when `make_box` does.
//      Stage-0 called that a codegen bug.
//   2. A type parameter with no argument to infer from. `let b: Box<Int> = fresh();` already says
//      what `T` is, in the place this language says a type belongs, so it is read from the
//      expectation. NOT a turbofish: writing `fresh::<Int>()` would be the language demanding an
//      answer it is already holding.
//
// A bound travels through too: `K: Equatable` declared on the constructor satisfies the same bound
// on the record it builds, because that is the only thing a bound is for.

record Box<T> { held: T }
record Pair<K: Equatable, V> { key: K, value: V }

function make_box<T>(x: T) -> Box<T> {
    return Box { held: x };
}

// Nothing to infer from but the annotation at the call site.
function empty_pair<K: Equatable, V>(k: K, v: V) -> Pair<K, V> {
    return Pair { key: k, value: v };
}

// A constructor with NO arguments at all, which is the case that could not be written before and
// is exactly what `map_new` needs. It works because every field can be built without a `T` in hand:
// an empty `[T]` needs no element. A `Box<T>` cannot be built this way and should not be — there is
// no `T` to hold — and asking for one says so by name.
record Bag<T> { items: [T], count: Int }

function empty_bag<T>() -> Bag<T> {
    return Bag { items: [], count: 0 };
}

region r {
    let b: Box<Int> = make_box(7);
    print(b.held);
    let s: Box<String> = make_box("text");
    print(s.held);

    // A record holding a record, built through a generic constructor.
    let inner: Box<Int> = make_box(41);
    let nested: Box<Box<Int>> = make_box(inner);
    print(nested.held.held + 1);

    let p: Pair<String, Int> = empty_pair("alpha", 9);
    print(p.key);
    print(p.value);

    // Both instantiations of the same constructor coexist, which is the thing monomorphisation has
    // to get right: two copies, two layouts, one source.
    let mutable bag: Bag<String> = empty_bag();
    let added: Int = push(bag.items, "only");
    print(len(bag.items));
    print(bag.items[0]);
    let numbers: Bag<Int> = empty_bag();
    print(len(numbers.items));
}
