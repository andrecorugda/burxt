// The mechanism-switch test: a one-field record is small enough for a target
// to pass in registers, an eight-field one is not. Both must behave
// IDENTICALLY — value-copy semantics, callee cannot touch the caller. If
// switching the mechanism ever changes observable behavior, that is the bug.
class Small { a: Int }
class Big {
    a: Int, b: Int, c: Int, d: Int,
    e: Int, f: Int, g: Int, h: Int,
}

function clobber_small(s: Small) -> Int {
    let mutable m: Small = s;
    m.a = 999;
    return m.a;
}
function clobber_big(s: Big) -> Int {
    let mutable m: Big = s;
    m.a = 999;
    m.h = 999;
    return m.a + m.h;
}
function roundtrip_small(s: Small) -> Small {
    return s;
}
function roundtrip_big(s: Big) -> Big {
    return s;
}

let s: Small = Small { a: 1 };
let b: Big = Big { a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8 };
print(clobber_small(s));
print(s.a);
print(clobber_big(b));
print(b.a);
print(b.h);
// a value that goes out and comes back is unchanged, both mechanisms
print(roundtrip_small(s).a);
let rb: Big = roundtrip_big(b);
print(rb.a + rb.h);
