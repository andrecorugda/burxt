// Inside `implement Trait for Type`, the header already says which type — so a method may
// write `function (self)` and let it. Repeating the type on every method buys nothing, and on
// a trait with five methods it was the type written six times.
trait Priced {
    function price(self) -> Decimal<2>
    function label(self) -> String
}

record Book { title: String, cost: Decimal<2> }

implement Priced for Book {
    function (self) price() -> Decimal<2> { return self.cost; }
    function (self) label() -> String { return "book: " + self.title; }
}

record Counter { n: Int }

implement Priced for Counter {
    // The long form still works, and is still required outside an `implement`.
    function (self: Counter) price() -> Decimal<2> { return $0.00; }
    function (self) label() -> String { return "counter " + to_string(self.n); }
}

// A mutating receiver abbreviates too. Free-standing methods are not inside an `implement`,
// so this one names its type — which is the rule, not an exception.
function (mutable self: Counter) bump() -> Int {
    self.n += 1;
    return self.n;
}

region r {
    let b = Book { title: "burxt", cost: $19.99 };
    print(b.price());
    print(b.label());

    let mutable c = Counter { n: 0 };
    print(c.bump());
    print(c.bump());
    print(c.label());
}
