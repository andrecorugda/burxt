// `byte_at(s, i)` is named for BYTES on purpose: A4.4 refused a bare `s[i]`
// because it would hide whether an index means a byte or a character.
let s: String = "AbZ";
print(byte_at(s, 0));
print(byte_at(s, 1));
print(byte_at(s, 2));
// walking a string is a lexer's inner loop
let mut i: Int = 0;
let mut sum: Int = 0;
while i < len(s) {
    sum = sum + byte_at(s, i);
    i = i + 1;
}
print(sum);
// bytes are UNSIGNED: a UTF-8 continuation byte must not come back negative
print(byte_at("é", 0));
print(byte_at("é", 1));
print(len("é"));
print(byte_at("\t", 0));
