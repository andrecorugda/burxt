// `&&`, `||`, `!` — Bool only, no truthiness anywhere.
let t: Bool = true;
let f: Bool = false;
print(t && t);
print(t && f);
print(f && t);
print(t || f);
print(f || f);
print(!t);
print(!f);
// Precedence: comparison binds tighter than `&&`, which binds tighter than `||`.
print(1 < 2 && 3 < 4);
print(1 < 2 || 5 < 4);
print(f && t || t);
print(!(1 < 2));
// They compose with control flow, which is the point of having them.
let balance: Decimal<2> = 100.00;
if balance > 0.00 && balance < 1000.00 {
    print(1);
}
let mut i: Int = 0;
while i < 5 && i != 3 {
    i = i + 1;
}
print(i);
