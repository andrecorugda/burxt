// `allocates` is worked out, not written. M14 slice 1.
//
// Not one function below says the word, and every one of them builds something in its
// caller's region. Before v0.0.142 each was a compile error naming a keyword the compiler
// had already worked out for itself.
//
// ---- Why this moved here ----------------------------------------------------------
//
// It began in `tests/stage0-only/`, because that directory's contract is that BOTH compilers
// accept everything in it — `the_burxt_backend_compiles_a_growing_share_of_the_suite` asserts
// 109 of 109 — and stage-1 still required the word. Staged the way M7 staged generics.
//
// v0.0.144 gave stage-1 the same inference, so it belongs here now, and both compilers are
// held to it. `tests/stage0-only/` is gone rather than left empty.

record Item { sku: String, name: String, price: Decimal<2> }

// Builds a String. The old error: "joining strings with `+` allocates, so it needs a
// region: there is none open here."
function label(item: Item, quantity: Int) -> String {
    return item.name + "  x" + to_string(quantity);
}

// Builds a growable array. The old error named the return type instead:
// "function `catalogue` cannot return [Item], because its storage lives in a region".
function catalogue() -> [Item] {
    let mutable shelf: [Item] = [];
    let a: Int = push(shelf, Item { sku: "RICE", name: "Rice 5kg", price: 52.75 });
    let b: Int = push(shelf, Item { sku: "MILK", name: "Milk 1L", price: 18.40 });
    return shelf;
}

// Allocates only because of who it CALLS — nothing here builds anything. This is the case
// that makes the inference a fixpoint rather than a pass: `forward` cannot be known to
// allocate until `label` is, and `twice` not until `forward` is.
function forward(item: Item, quantity: Int) -> String {
    return label(item, quantity);
}
function twice(item: Item) -> String {
    return forward(item, 2);
}

// A method, inferred the same way. `alloc_methods` is a separate set because a method is
// keyed by (receiver, name) — two records may both have a `describe`.
function (self: Item) describe() -> String {
    return self.sku + " " + self.name;
}

// Writing the word still works, and is still checked. It has to keep working: it is the
// escape hatch for `external function`, where there is no body to infer from, and every
// existing program in tests/pass/ says it.
function shout(item: Item) -> String allocates {
    return item.name + "!";
}

// A local region still bounds what is built inside it — the escape rule is what M14 keeps.
// This function does NOT allocate in its caller's region: everything it builds dies at the
// closing brace, and it answers a scalar.
function count_chars(item: Item) -> Int {
    let mutable total: Int = 0;
    region scratch {
        let joined: String = item.sku + item.name;
        total = len(joined);
    }
    return total;
}

region program {
    let shelf: [Item] = catalogue();
    let rice: Item = shelf[0];

    print(label(rice, 3));
    print(forward(rice, 4));
    print(twice(rice));
    print(rice.describe());
    print(shout(rice));
    print(count_chars(rice));
}
