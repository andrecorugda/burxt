// A generic record's LAYOUT depends on its argument, and this is the program that proves both
// compilers agree about it. `Pair<Int>` is two cells and `Pair<Point>` is four, from one
// declaration read twice — nothing is copied and no new type is invented, because in Burxt a
// layout is a COUNT of eight-byte cells and not a named machine type.
//
// The bug this fixture exists to catch, found the day it was written: sizing was right and the
// FIELD TYPE was not, so the emitter asked whether a `T` was an aggregate, was told no, and
// stored a Point's ADDRESS where its two cells belonged. A class of exactly the right size
// holding a pointer in the wrong place — which is why the test reads the fields back out and
// adds them, rather than only building the value.

class Point { x: Int, y: Int }
class Pair<T> { first: T, second: T }
class Nested<T> { inner: Pair<T>, tag: Int }

region r {
    let small: Pair<Int> = Pair { first: 3, second: 4 };
    print(small.first + small.second);

    let wide: Pair<Point> = Pair { first: Point { x: 1, y: 2 },
            second: Point { x: 10, y: 20 } };
    print(wide.second.x + wide.first.y);

    // A generic inside a generic: `Nested<Point>.inner` is a `Pair<Point>`, so the argument has
    // to travel one level down. A single binding table resolved at each level does that; a
    // rewrite of the declaration would have had to invent a node for `Pair<Point>` to point at.
    let deep: Nested<Point> = Nested { inner: Pair { first: Point { x: 7, y: 8 },
                second: Point { x: 30, y: 40 } },
            tag: 99 };
    print(deep.inner.second.y + deep.tag);

    // Copying is by value, and for an aggregate field that means cells and not a pointer: if
    // `held` shared storage with `wide`, this would print 10 and not 1.
    let held: Point = wide.first;
    print(held.x);

    let strings: Pair<String> = Pair { first: "left", second: "right" };
    print(strings.second);
}
