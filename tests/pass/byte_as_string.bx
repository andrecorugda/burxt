// `byte_as_string(n)` — the one builtin that turns a number into bytes, roadmap §A13.
//
// It exists because there was **no Int-to-String path in this language at all**, and that was
// measured rather than assumed (the argument is in `lib/string.bx`'s header, which used to be called
// THE GAP): no builtin did it; no escape named a byte, since `\xNN` and `\uXXXX` do not exist; so
// `substring` of a LITERAL was the only path; and a source file must be valid UTF-8, so a byte
// >= 0x80 could only reach a literal inside a complete multi-byte character. Reaching the 51 UTF-8
// lead bytes that way needed 51 characters from 51 blocks, six of them unassigned codepoints — a
// table that was refused as unreadable rather than written.
//
// **The property this fixture is built on is that it is the exact INVERSE of `byte_at`.** So the
// test is one identity over the WHOLE domain rather than a handful of chosen values:
//
//     byte_at(byte_as_string(n), 0) == n     for every n in 0..=255
//
// A loop over all 256, and that is deliberate. A fixture that checked 0, 65 and 255 would pass with
// a table covering only printable ASCII — which is exactly the bug `os_byte_as_string` had, and it
// had it for as long as it existed. Hand-picked examples cannot tell a complete function from one
// that happens to cover the examples.
//
// The range refusals are elsewhere, because a pass fixture cannot show a refusal:
//   tests/fail/byte_as_string_out_of_range.bx           a literal above 255
//   tests/fail/byte_as_string_negative_literal.bx       a literal below 0
//   tests/panic/byte_as_string_checked_at_runtime.bx    a computed value, trapped at runtime

// ---- 1. the identity, over every value in the domain ----
let mutable wrong_byte: Int = 0;
let mutable wrong_length: Int = 0;
for n in 0..256 {
    let one: String = byte_as_string(n);
    if len(one) != 1 {
        wrong_length += 1;
    }
    if byte_at(one, 0) != n {
        wrong_byte += 1;
    }
}
print(wrong_byte);                               // 0 — round-trips for all 256
print(wrong_length);                             // 0 — every answer is one byte long

// ---- 2. the two ends, named so a reader sees the domain rather than trusting the loop ----
print(byte_at(byte_as_string(0), 0));            // 0
print(byte_at(byte_as_string(255), 0));          // 255

// ---- 3. a NUL is an ORDINARY byte, and this is the assumption that was nearly got wrong ----
//
// A Burxt String is LENGTH-PREFIXED — an i64 header at `s - 8` — so `len` is a header read and not a
// `strlen`. `emit.bx` claimed the opposite in prose until v0.0.254, fourteen lines above the code
// that writes the header, and an agent scoping this builtin nearly gave the language a NUL special
// case on the strength of that sentence. There is no carve-out because none is needed.
let nul: String = byte_as_string(0);
print(len(nul));                                 // 1, not 0
print(byte_at(nul, 0));                          // 0
let around: String = "a" + nul + "b";
print(len(around));                              // 3 — the NUL does not end the String
print(byte_at(around, 1));                       // 0
print(len(substring(around, 1, 1)));             // 1

// ---- 4. an ordinary String: comparable, joinable, printable ----
//
// Nothing about the answer is special. It is the same kind of value a literal is, which is what
// makes the layer in `lib/string.bx` ordinary Burxt rather than more compiler work.
print(byte_as_string(65) == "A");                // true
print(byte_as_string(65) + byte_as_string(66));  // AB
print(byte_as_string(10) == "\n");               // true — the escape and the number agree

// ---- 5. assembling a multi-byte character BYTE BY BYTE, which is the reason it exists ----
//
// `é` is `C3 A9`. Neither byte can be written as a literal on its own — that is the wall this
// builtin was added to get past — and together they are one real character.
print(byte_as_string(195) + byte_as_string(169));            // é
print(len(byte_as_string(195) + byte_as_string(169)));       // 2

// ---- 6. it builds in the caller's region, and the inference sees that without being told ----
//
// No `allocates` written anywhere here. `assemble` returns a String it built, so the probe has to
// credit it — the same treatment `substring` and `read_file` get, and the reason `byte_as_string`
// had to be added to the allocation list in BOTH compilers rather than only typed.
function assemble(first: Int, second: Int) -> String {
    return byte_as_string(first) + byte_as_string(second);
}
print(assemble(195, 169));                       // é
print(len(assemble(0, 255)));                    // 2

// ---- 7. inside a region, where the answer is released with the block ----
region scratch {
    let built: String = byte_as_string(90);
    print(built);                                // Z
}
