// The pattern self-hosting needs: a class holding growable storage, mutated
// through a `mutable self` method, all inside one region that releases at the end.
class Arena { nodes: [Int], count: Int }

function (mutable self: Arena) add(v: Int) -> Int {
    push(self.nodes, v);
    self.count = self.count + 1;
    return self.count;
}

region parse {
    let mutable a: Arena = Arena { nodes: [], count: 0 };
    let mutable i: Int = 0;
    while i < 500 {
        a.add(i * 2);
        i = i + 1;
    }
    print(a.count);
    print(a.nodes[499]);
    print(len(a.nodes));
}
