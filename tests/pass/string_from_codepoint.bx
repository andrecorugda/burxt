// `from_codepoint` and `from_bytes` — the safe layer above the `byte_as_string` builtin, §D1p.
//
// These are the two functions `lib/string.bx` argued could not be written, in a header that measured
// each step of the claim and refused the 51-character workaround. It was right: what was missing was
// one primitive. Adding it made both of these ordinary Burxt, which is the outcome the note predicted
// and the reason it was worth recording rather than working around.
//
// **`from_codepoint` is checked as the exact inverse of `codepoint_at`, over EVERY codepoint** —
// all 1,112,064 of them, not one per width. A four-branch encoder has three boundaries (0x80, 0x800,
// 0x10000) and a surrogate hole, and an off-by-one at any of them survives a fixture that tests one
// value per branch. It costs a second to run.
//
// The third name §D1p asks for, `from_byte`, is deliberately absent: it would be `byte_as_string`
// under a second spelling. `lib/string.bx` says so where the function would have been, so that
// "decided" and "forgot" do not look the same from outside.
use "../../lib/string.bx";

// ---- 1. from_codepoint is the inverse of codepoint_at, over the whole of Unicode ----
//
// Three properties at once, because they fail differently: a wrong byte gives a wrong codepoint
// back, a missing continuation byte gives invalid UTF-8, and a sequence that is one byte too long
// still decodes but counts as two characters.
let mutable wrong_codepoint: Int = 0;
let mutable not_valid: Int = 0;
let mutable wrong_count: Int = 0;
for code in 0..1114112 {
    // U+D800..U+DFFF are surrogates — half of a UTF-16 pair, never a character on their own, and
    // `from_codepoint` refuses them by contract. Skipped here rather than tested, because a
    // `requires` violation is a trap and belongs in tests/panic/.
    if code < 55296 || code > 57343 {
        let one: String = from_codepoint(code);
        if codepoint_at(one, 0) != code {
            wrong_codepoint += 1;
        }
        if !is_valid_utf8(one) {
            not_valid += 1;
        }
        if char_count(one) != 1 {
            wrong_count += 1;
        }
    }
}
print(wrong_codepoint);                          // 0
print(not_valid);                                // 0 — never a PARTIAL sequence
print(wrong_count);                              // 0

// ---- 2. one value per width, spelled out, so a reader sees what the loop above covered ----
print(from_codepoint(97));                       // a      — 1 byte
print(from_codepoint(233));                      // é      — 2 bytes
print(from_codepoint(20013));                    // 中     — 3 bytes
print(from_codepoint(128512));                   // 😀     — 4 bytes
print(len(from_codepoint(97)));                  // 1
print(len(from_codepoint(233)));                 // 2
print(len(from_codepoint(20013)));               // 3
print(len(from_codepoint(128512)));              // 4

// ---- 3. the width boundaries, either side of each one ----
//
// The three places an encoder gets wrong, checked as lengths rather than as characters: 0x7F/0x80,
// 0x7FF/0x800 and 0xFFFF/0x10000 are where the branch changes.
print(len(from_codepoint(127)));                 // 1
print(len(from_codepoint(128)));                 // 2
print(len(from_codepoint(2047)));                // 2
print(len(from_codepoint(2048)));                // 3
print(len(from_codepoint(65535)));               // 3
print(len(from_codepoint(65536)));               // 4
print(len(from_codepoint(1114111)));             // 4 — the last codepoint there is

// ---- 4. from_bytes is the inverse of to_bytes ----
//
// Including a NUL, which is the case worth naming: a length-prefixed String makes it ordinary, and
// a reader who assumes C's rules would expect the round-trip to stop there.
let mixed: String = "héllo 中 😀";
print(from_bytes(to_bytes(mixed)) == mixed);     // true
let with_nul: String = "a\0b";
print(from_bytes(to_bytes(with_nul)) == with_nul);   // true
print(len(from_bytes(to_bytes(with_nul))));      // 3
print(from_bytes([]) == "");                     // true — the empty fold

// ---- 5. from_bytes makes NO validity promise, and that is documented rather than a gap ----
//
// The bytes are the caller's. A lone lead byte in gives a String out that `is_valid_utf8` rejects,
// which is how a caller builds a deliberately BINARY String — and why `from_codepoint` exists as the
// safe layer for text.
print(is_valid_utf8(from_bytes([195])));         // false — a lead byte with no continuation
print(is_valid_utf8(from_bytes([195, 169])));    // true  — the same two bytes, assembled
print(from_bytes([195, 169]));                   // é
print(len(from_bytes([0, 1, 255])));             // 3 — arbitrary bytes, not text at all
