// Interface Segregation: a one-method trait is the healthy default, and a
// type may satisfy several small interfaces rather than one fat one.
interface Named { function name_id(self) -> Int }
interface Valued { function value(self) -> Decimal<2> }

class Item { id: Int, cost: Decimal<2> }

implement Named for Item {
    function (self: Item) name_id() -> Int { return self.id; }
}
implement Valued for Item {
    function (self: Item) value() -> Decimal<2> { return self.cost; }
}

let it: Item = Item { id: 3, cost: 9.99 };
let n: dynamic Named = it;
let v: dynamic Valued = it;
print(n.name_id());
print(v.value());
