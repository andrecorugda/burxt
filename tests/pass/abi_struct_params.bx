// Structs cross function boundaries by value: the callee gets its own copy
// and cannot observe (or corrupt) the caller's storage.
struct LineItem { price: Decimal<2>, qty: Int }

fn total(item: LineItem) -> Decimal<2> {
    return item.price * item.qty;
}
// Returns an aggregate: built directly in space the caller owns (sret).
fn bump(item: LineItem) -> LineItem {
    let mut copy: LineItem = item;
    copy.qty = copy.qty + 1;
    return copy;
}
// THE aliasing test: the callee scribbles all over its parameter.
fn clobber(item: LineItem) -> Int {
    let mut m: LineItem = item;
    m.price = 0.00;
    m.qty = 999;
    return m.qty;
}

let item: LineItem = LineItem { price: 19.99, qty: 3 };
print(total(item));
let bumped: LineItem = bump(item);
print(bumped.qty);
print(clobber(item));
// The caller's value is untouched by both of the above.
print(item.qty);
print(item.price);
// A literal argument needs no home of its own.
print(total(LineItem { price: 2.50, qty: 4 }));
