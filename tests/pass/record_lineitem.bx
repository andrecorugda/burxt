// The OOP substrate: nominal structs with money fields.
record LineItem {
    price: Decimal<2>,
    quantity: Int,
}
// construction names every field; any order
let item: LineItem = LineItem { quantity: 3, price: 19.99 };
print(item.price);
print(item.quantity);
print(item.price * item.quantity);
// field mutation follows the binding's mutability
let mutable acc: LineItem = LineItem { price: 0.00, quantity: 0 };
acc.price = 12.50;
acc.quantity = acc.quantity + 2;
print(acc.price);
print(acc.quantity);
// assignment copies the whole value — no hidden aliasing
let copy: LineItem = item;
print(copy.price);
