// `function (mutable self: T) ...` mutates the CALLER's value: the receiver is a true
// reference in this one case, mirroring field assignment's own mutability
// rule (callable only through a `let mutable` binding). Calling it purely for
// its side effect uses the new expression-statement form.
class Account { balance: Decimal<2> }

function (mutable self: Account) deposit(amount: Decimal<2>) -> Decimal<2> {
    self.balance = self.balance + amount;
    return self.balance;
}
function (self: Account) balance_of() -> Decimal<2> {
    return self.balance;
}

let mutable acct: Account = Account { balance: 100.00 };
acct.deposit(25.50);
print(acct.balance_of());
print(acct.deposit(10.00));
print(acct.balance);
