// `/` on two Ints is refused because one operator cannot say which way it rounds.
// Three names can, and the difference is only visible on negatives — which is
// exactly why hiding it behind an operator would be a trap.
print(divide_floor(7, 2));      // 3
print(divide_toward_zero(7, 2));      // 3
print(divide_floor(-7, 2));     // -4, rounds down
print(divide_toward_zero(-7, 2));     // -3, rounds toward zero
print(divide_floor(7, -2));     // -4
print(divide_toward_zero(7, -2));     // -3
print(remainder(7, 2));            // 1
print(remainder(-7, 2));           // -1, the sign follows the dividend
print(remainder(7, -2));           // 1

// What compiler-shaped code actually needs.
let lo: Int = 3;
let hi: Int = 10;
print(divide_floor(lo + hi, 2));
print(remainder(255, 16));

// Composes with everything else on a signature.
pure function midpoint(a: Int, b: Int) -> Int
        requires a <= b
        ensures result >= a
        ensures result <= b
        {
    return divide_floor(a + b, 2);
}
print(midpoint(4, 9));
