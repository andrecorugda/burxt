// lib/hash.bx — SHA-256 and SHA-512 against the vectors FIPS 180-4 publishes.
//
// **The expected value is written into the source next to the call, not only into the `.stdout`.**
// A `.stdout` pins whatever the library printed the day it was recorded; a literal in the source is
// the number a reviewer compares against the standard. Both are here, and `vector` prints MISMATCH
// rather than the value if they disagree — so a wrong digest fails loudly in the diff AND in the
// text, rather than quietly re-baselining.
//
// The cases are chosen for where a SHA goes wrong, which is never `"abc"`:
//
//   * **the empty input** — one block that is entirely padding;
//   * **`"abc"`** — the one everybody tests and the one that proves nothing on its own;
//   * **the 448-bit and 896-bit messages from FIPS 180-4** — the second is multi-block for both;
//   * **a length sweep across every padding boundary**: 55/56/57 and 63/64/65 are where SHA-256's
//     padding either fits in the block or spills into a second one, and 111/112/127/128/129 are
//     the same four boundaries for SHA-512. **A hash that is right on `"abc"` and wrong on a
//     multi-block input is the classic failure**, and it lives at exactly these lengths;
//   * **one million `a`** — the FIPS long-message vector, 15,625 blocks, and the only case here
//     that would catch a state variable that drifts slowly.
use "../../lib/hash.bx";

function vector(label: String, actual: String, expected: String) -> Bool {
    if actual == expected {
        print(label + " = " + actual);
        return true;
    }
    print(label + " MISMATCH");
    print("  expected " + expected);
    print("  actual   " + actual);
    return false;
}

// ---- the two everyone knows ----
vector("sha256 of the empty string", hash_hex(sha256_text("")), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
vector("sha256 of abc", hash_hex(sha256_text("abc")), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");

// ---- FIPS 180-4 B.1 and B.2: 448 bits (56 bytes) and 896 bits (112 bytes) ----
// The 896-bit message is two blocks for SHA-256 and, with its padding, two for SHA-512.
let m448: String = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq";
let m896: String = "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu";
vector("sha256 of the 448-bit message", hash_hex(sha256_text(m448)), "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1");
vector("sha256 of the 896-bit message", hash_hex(sha256_text(m896)), "cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1");

// ---- the padding boundaries, as a sweep of `a` repeated ----
// 55 is the longest message whose padding still fits in one 64-byte block; 56 is the first
// that spills into a second; 64 lands exactly on a block boundary. 111/112/128 are the same
// three for SHA-512.
vector("sha256 of 55 a", hash_hex(sha256_text(string_repeat("a", 55))), "9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318");
vector("sha256 of 56 a", hash_hex(sha256_text(string_repeat("a", 56))), "b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a");
vector("sha256 of 57 a", hash_hex(sha256_text(string_repeat("a", 57))), "f13b2d724659eb3bf47f2dd6af1accc87b81f09f59f2b75e5c0bed6589dfe8c6");
vector("sha256 of 63 a", hash_hex(sha256_text(string_repeat("a", 63))), "7d3e74a05d7db15bce4ad9ec0658ea98e3f06eeecf16b4c6fff2da457ddc2f34");
vector("sha256 of 64 a", hash_hex(sha256_text(string_repeat("a", 64))), "ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb");
vector("sha256 of 65 a", hash_hex(sha256_text(string_repeat("a", 65))), "635361c48bb9eab14198e76ea8ab7f1a41685d6ad62aa9146d301d4f17eb0ae0");
vector("sha256 of 111 a", hash_hex(sha256_text(string_repeat("a", 111))), "6374f73208854473827f6f6a3f43b1f53eaa3b82c21c1a6d69a2110b2a79baad");
vector("sha256 of 112 a", hash_hex(sha256_text(string_repeat("a", 112))), "f54353008a2553262ecdc4a34749563ba0950e8b0fc8652780b0a614b99683c1");
vector("sha256 of 119 a", hash_hex(sha256_text(string_repeat("a", 119))), "31eba51c313a5c08226adf18d4a359cfdfd8d2e816b13f4af952f7ea6584dcfb");
vector("sha256 of 127 a", hash_hex(sha256_text(string_repeat("a", 127))), "c57e9278af78fa3cab38667bef4ce29d783787a2f731d4e12200270f0c32320a");
vector("sha256 of 128 a", hash_hex(sha256_text(string_repeat("a", 128))), "6836cf13bac400e9105071cd6af47084dfacad4e5e302c94bfed24e013afb73e");
vector("sha256 of 129 a", hash_hex(sha256_text(string_repeat("a", 129))), "c12cb024a2e5551cca0e08fce8f1c5e314555cc3fef6329ee994a3db752166ae");

// ---- SHA-512, the same cases ----
vector("sha512 of the empty string", hash_hex(sha512_text("")), "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e");
vector("sha512 of abc", hash_hex(sha512_text("abc")), "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f");
vector("sha512 of the 448-bit message", hash_hex(sha512_text(m448)), "204a8fc6dda82f0a0ced7beb8e08a41657c16ef468b228a8279be331a703c33596fd15c13b1b07f9aa1d3bea57789ca031ad85c7a71dd70354ec631238ca3445");
vector("sha512 of the 896-bit message", hash_hex(sha512_text(m896)), "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909");
vector("sha512 of 55 a", hash_hex(sha512_text(string_repeat("a", 55))), "b0220c772cbf6c1822e2cb38a437d0e1d58772417a4bbb21c961364f8b6143e05aa6316dca8d1d7b19e16448419076395f6086cb55101fbd6d5497b148e1745f");
vector("sha512 of 56 a", hash_hex(sha512_text(string_repeat("a", 56))), "962b64aae357d2a4fee3ded8b539bdc9d325081822b0bfc55583133aab44f18bafe11d72a7ae16c79ce2ba620ae2242d5144809161945f1367f41b3972e26e04");
vector("sha512 of 63 a", hash_hex(sha512_text(string_repeat("a", 63))), "c1b0f5c6d3b03dfe4a2602e67242f54e344090b66e01100a469b129f583f016c7e27dddeaa438393dcc7ec54b0b57c9ba7af007f9b56db5f6fb677d972a31362");
vector("sha512 of 64 a", hash_hex(sha512_text(string_repeat("a", 64))), "01d35c10c6c38c2dcf48f7eebb3235fb5ad74a65ec4cd016e2354c637a8fb49b695ef3c1d6f7ae4cd74d78cc9c9bcac9d4f23a73019998a7f73038a5c9b2dbde");
vector("sha512 of 111 a", hash_hex(sha512_text(string_repeat("a", 111))), "fa9121c7b32b9e01733d034cfc78cbf67f926c7ed83e82200ef86818196921760b4beff48404df811b953828274461673c68d04e297b0eb7b2b4d60fc6b566a2");
vector("sha512 of 112 a", hash_hex(sha512_text(string_repeat("a", 112))), "c01d080efd492776a1c43bd23dd99d0a2e626d481e16782e75d54c2503b5dc32bd05f0f1ba33e568b88fd2d970929b719ecbb152f58f130a407c8830604b70ca");
vector("sha512 of 113 a", hash_hex(sha512_text(string_repeat("a", 113))), "55ddd8ac210a6e18ba1ee055af84c966e0dbff091c43580ae1be703bdb85da31acf6948cf5bd90c55a20e5450f22fb89bd8d0085e39f85a86cc46abbca75e24d");
vector("sha512 of 119 a", hash_hex(sha512_text(string_repeat("a", 119))), "130396a75cb483f2eee8c56d8a668bb3d2641f5243212c0bee2bd33da096ad9eb8179fe18f9eaacf76e09fae9de4c3f14ba13341e345be05bf76c182cc3468cb");
vector("sha512 of 127 a", hash_hex(sha512_text(string_repeat("a", 127))), "828613968b501dc00a97e08c73b118aa8876c26b8aac93df128502ab360f91bab50a51e088769a5c1eff4782ace147dce3642554199876374291f5d921629502");
vector("sha512 of 128 a", hash_hex(sha512_text(string_repeat("a", 128))), "b73d1929aa615934e61a871596b3f3b33359f42b8175602e89f7e06e5f658a243667807ed300314b95cacdd579f3e33abdfbe351909519a846d465c59582f321");
vector("sha512 of 129 a", hash_hex(sha512_text(string_repeat("a", 129))), "4f681e0bd53cda4b5a2041cc8a06f2eabde44fb16c951fbd5b87702f07aeab611565b19c47fde30587177ebb852e3971bbd8d3fd30da18d71037dfbd98420429");

// ---- FIPS 180-4 C.3 / B.3: one million `a` ----
// 15,625 blocks for SHA-256 and 7,813 for SHA-512. Built with the chunk list §D0 requires —
// `million = million + "a"` a million times exhausts the arena, which is the whole reason
// that section exists.
let one_thousand: String = string_repeat("a", 1000);
let mutable pieces: [String] = [];
for i in 0..1000 {
    push(pieces, one_thousand);
}
let million: String = string_join_chunks(pieces);
print("one million a is " + to_string(len(million)) + " bytes");
let million_bytes: [Int] = to_bytes(million);
vector("sha256 of one million a", hash_hex(sha256(million_bytes)), "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0");
vector("sha512 of one million a", hash_hex(sha512(million_bytes)), "e718483d0ce769644e2e42c7bc15b4638e1f98b13b2044285632a803afa973ebde0ff244877ea60a4cb0432ce577c31beb009c5c2c49aa2e4eadb217ad8cc09b");

// ---- the byte-array and text forms are the same function ----
print(hash_equals_constant_time(sha256_text("abc"), sha256(to_bytes("abc"))));
print(hash_equals_constant_time(sha512_text("abc"), sha512(to_bytes("abc"))));
print(len(sha256_text("abc")));
print(len(sha512_text("abc")));
