// Behavior must be IDENTICAL whether a trait method is reached statically or
// through a trait object — the mechanism-switch property, extended to dyn.
// A trait method also cannot corrupt the caller: its receiver is read-only.
trait Peek {
    fn peek(self) -> Int
    fn copy_and_clobber(self) -> Int
}

struct Box2 { a: Int, b: Int }

impl Peek for Box2 {
    fn (self: Box2) peek() -> Int { return self.a; }
    fn (self: Box2) copy_and_clobber() -> Int {
        let mut m: Box2 = self;
        m.a = 999;
        return m.a;
    }
}

let bx: Box2 = Box2 { a: 1, b: 2 };
let d: dyn Peek = bx;

// same answers both ways
print(bx.peek());
print(d.peek());
print(bx.copy_and_clobber());
print(d.copy_and_clobber());
// and the original is untouched by either path
print(bx.a);
print(d.peek());
