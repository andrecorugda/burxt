// Behavior must be IDENTICAL whether a trait method is reached statically or
// through a trait object — the mechanism-switch property, extended to dynamic.
// A trait method also cannot corrupt the caller: its receiver is read-only.
trait Peek {
    function peek(self) -> Int
    function copy_and_clobber(self) -> Int
}

class Box2 { a: Int, b: Int }

implement Peek for Box2 {
    function (self: Box2) peek() -> Int { return self.a; }
    function (self: Box2) copy_and_clobber() -> Int {
        let mutable m: Box2 = self;
        m.a = 999;
        return m.a;
    }
}

let bx: Box2 = Box2 { a: 1, b: 2 };
let d: dynamic Peek = bx;

// same answers both ways
print(bx.peek());
print(d.peek());
print(bx.copy_and_clobber());
print(d.copy_and_clobber());
// and the original is untouched by either path
print(bx.a);
print(d.peek());
