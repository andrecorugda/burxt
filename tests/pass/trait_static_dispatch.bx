// An interface is a named set of method signatures a type can promise to satisfy.
// Satisfaction is EXPLICIT via `implement Trait for Type` — never inferred from
// method shapes happening to match.
interface HasBalance {
    function balance_of(self) -> Decimal<2>
            function label(self) -> Int
        }

class Account { balance: Decimal<2>, id: Int }

implement HasBalance for Account {
    function (self: Account) balance_of() -> Decimal<2> { return self.balance; }
    function (self: Account) label() -> Int { return self.id; }
}

// No `dynamic` anywhere: these are direct calls, and no vtable is emitted at all.
let acct: Account = Account { balance: 125.50, id: 7 };
print(acct.balance_of());
print(acct.label());
