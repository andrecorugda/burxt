// `allocates` on a method: it builds in the CALLER's region, exactly as the
// free-function form does. The M1a spec deferred this with the trigger "a required
// program needs an allocating method" — a symbol table written in Burxt was it,
// because Burxt has no mutable parameters and a pass that fills a table must
// therefore be a method on it.
record Row { id: Int }
record Log { rows: [Row] }

function (mutable self: Log) note(id: Int) -> String allocates
    ensures len(self.rows) >= old(len(self.rows))
{
    push(self.rows, Row { id: id });
    return "row " + to_string(id) + " of " + to_string(len(self.rows));
}

function (self: Log) describe() -> String allocates {
    return to_string(len(self.rows)) + " rows";
}

region r {
    let mutable log: Log = Log { rows: [] };
    print(log.note(1));
    print(log.note(2));
    print(log.describe());
}
