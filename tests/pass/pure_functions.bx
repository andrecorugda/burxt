// The claim `pure` makes: this result depends only on these arguments, and the
// compiler checked it. For money that is the audit story — a hidden clock or a
// config lookup three calls down cannot get in.
pure function interest(balance: Decimal<2, RoundHalfEven>, rate: Decimal<4>)
        -> Decimal<2, RoundHalfEven>
        {
    return balance * rate;
}

// Purity is transitive without being inferred: a pure function may call one.
pure function total_with_interest(balance: Decimal<2, RoundHalfEven>, rate: Decimal<4>)
        -> Decimal<2, RoundHalfEven>
        {
    return balance + interest(balance, rate);
}

// `pure` AND `allocates`: a bump allocator observes nothing about the outside
// world, so building a string is deterministic.
pure function render(amount: Decimal<2, RoundHalfEven>) -> String {
    return "amount " + to_string(amount);
}

// Purity constrains the callee, never the caller: an ordinary function may call a
// pure one freely.
function report(balance: Decimal<2, RoundHalfEven>, rate: Decimal<4>) -> Int {
    print(total_with_interest(balance, rate));
    return 0;
}

let balance: Decimal<2, RoundHalfEven> = 1000.00;
let rate: Decimal<4> = 8.25%;
print(interest(balance, rate));
let ignored: Int = report(balance, rate);
region r {
    print(render(total_with_interest(balance, rate)));
}
