// The marker words are CONTEXTUAL, not reserved: they mean something in exactly one
// position each, and are ordinary names everywhere else.
//
// This matters more as the language grows, because every guarantee Burxt adds is a
// declared word — `pure`, `allocates`, `tail`, `requires`, `ensures`, `decreases` —
// and reserving each one globally to recognise it in one place is over-collection.
// PHP solves the same problem with `$` on every variable, which taxes every use to
// refund an occasional collision; a contextual keyword pays only at the collision.
function label(n: Int) -> String allocates
        requires n > 0
        ensures len(result) > 0
        decreases n
        {
    if n <= 1 {
        return "one";
    }
    return label(n - 1);
}

region r {
    // The same four words, as names.
    let mutable allocates: Int = 0;
    let requires: Int = 1;
    let ensures: String = "a name, not a clause";
    let decreases: Bool = true;
    allocates = requires + 1;
    print(allocates);
    print(ensures);
    print(decreases);
    print(label(3));
}
