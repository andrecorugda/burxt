// User functions take and return Strings freely — every value is a
// 'static literal by construction, so there is no ownership question.
function pick(cond: Bool, a: String, b: String) -> String {
    if cond {
        return a;
    }
    return b;
}
print(pick(true, "yes", "no"));
print(pick(false, "yes", "no"));
let mutable s: String = "first";
s = "second";
print(s);
