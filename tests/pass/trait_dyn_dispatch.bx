// `dyn Trait` is the ONLY thing that triggers dynamic dispatch. One call
// site, two concrete impls, resolved at runtime through the vtable.
trait HasBalance {
    fn balance_of(self) -> Decimal<2>
    fn label(self) -> Int
}

struct Account { balance: Decimal<2>, id: Int }
struct Escrow  { held: Decimal<2>, fee: Decimal<2> }

impl HasBalance for Account {
    fn (self: Account) balance_of() -> Decimal<2> { return self.balance; }
    fn (self: Account) label() -> Int { return self.id; }
}
impl HasBalance for Escrow {
    fn (self: Escrow) balance_of() -> Decimal<2> { return self.held - self.fee; }
    fn (self: Escrow) label() -> Int { return 99; }
}

let acct: Account = Account { balance: 125.50, id: 7 };
let esc: Escrow = Escrow { held: 200.00, fee: 0.50 };

// the same static calls, for comparison
print(acct.balance_of());
print(esc.balance_of());

// now through trait objects — each reaches its own impl
let d1: dyn HasBalance = acct;
let d2: dyn HasBalance = esc;
print(d1.balance_of());
print(d2.balance_of());
// slot order comes from the trait declaration, so `label` is slot 1 for both
print(d1.label());
print(d2.label());
