// `dynamic Trait` is the ONLY thing that triggers dynamic dispatch. One call
// site, two concrete impls, resolved at runtime through the vtable.
interface HasBalance {
    function balance_of(self) -> Decimal<2>
    function label(self) -> Int
}

class Account { balance: Decimal<2>, id: Int }
class Escrow  { held: Decimal<2>, fee: Decimal<2> }

implement HasBalance for Account {
    function (self: Account) balance_of() -> Decimal<2> { return self.balance; }
    function (self: Account) label() -> Int { return self.id; }
}
implement HasBalance for Escrow {
    function (self: Escrow) balance_of() -> Decimal<2> { return self.held - self.fee; }
    function (self: Escrow) label() -> Int { return 99; }
}

let acct: Account = Account { balance: 125.50, id: 7 };
let esc: Escrow = Escrow { held: 200.00, fee: 0.50 };

// the same static calls, for comparison
print(acct.balance_of());
print(esc.balance_of());

// now through interface objects — each reaches its own implement
let d1: dynamic HasBalance = acct;
let d2: dynamic HasBalance = esc;
print(d1.balance_of());
print(d2.balance_of());
// slot order comes from the interface declaration, so `label` is slot 1 for both
print(d1.label());
print(d2.label());
