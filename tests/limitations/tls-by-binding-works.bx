// CLAIM: TCP, HTTP and TLS, yes. No DNS
// HOLDS: accepted
// WHY: the INVERSE guard, and the reason this file exists. This page said flatly "No TLS" for
//      two weeks after v1.0.0 shipped, while six `external function` declarations and
//      `-lssl -lcrypto` completed a TLS 1.3 handshake. A probe that only guards against
//      capabilities ARRIVING cannot catch a page that understates what is already there — so
//      this one goes red if somebody re-asserts that TLS is out of reach.
external function TLS_client_method() -> CPointer;
external function SSL_CTX_new(method: CPointer) -> CPointer;
external function SSL_new(context: CPointer) -> CPointer;
external function SSL_set_fd(ssl: CPointer, fd: Int) -> CInt;
external function SSL_connect(ssl: CPointer) -> CInt;
external function SSL_get_version(ssl: CPointer) -> CPointer;
region main {
    let method: CPointer = TLS_client_method();
    let context: CPointer = SSL_CTX_new(method);
    print("{c_is_null(context)}");
}
