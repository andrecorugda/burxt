// `?` recognises a failure by the VARIANT name — `Error` or `None` — never by the enum`s
// own name. That is what lets a library type have it. An enum with neither has no failure
// case to recognise.
enum Pair { Left(Int), Right(Int) }
function f() -> Pair {
    let p: Pair = Pair.Left(1);
    let v = p?;
    return Pair.Right(v);
}
region r {
    print(1);
}
