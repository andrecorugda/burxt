// B26 through a field. Same blindness, and the shape that was proven to corrupt: the field
// printed its value, then printed another string's bytes after a region reused the memory.
interface Named { function name(self) -> String }
class Item { sku: String }
implement Named for Item {
    function (self) name() -> String { return "item " + self.sku; }
}
class Holder { tag: String }
let mutable h: Holder = Holder { tag: "start" };
region r {
    let i: Item = Item { sku: "A" + "B" };
    let d: dynamic Named = i;
    h.tag = d.name();
}
print(h.tag);
