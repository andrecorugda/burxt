// A trait object borrows storage, so it must come from a variable.
trait Priced { function price(self) -> Decimal<2> }
class Book { cost: Decimal<2> }
implement Priced for Book {
    function (self: Book) price() -> Decimal<2> { return self.cost; }
}
let d: dynamic Priced = Book { cost: 1.00 };
print(d.price());
