// Satisfaction is nominal: matching method shapes is NOT enough, the implement
// must be declared.
trait Priced {
    function price(self) -> Decimal<2>
}
class Book { cost: Decimal<2> }
// Book has a price() method but never declares `implement Priced for Book`.
function (self: Book) price() -> Decimal<2> { return self.cost; }

let b: Book = Book { cost: 1.00 };
let d: dynamic Priced = b;
print(d.price());
