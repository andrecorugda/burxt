// The `allocates` rule, enforced through a trait object.
//
// This COMPILED until v0.0.143, and it was a gap in a memory guarantee rather than an
// inconvenience: the checker's `dynamic` branch returns before reaching the `allocates`
// test, so the rule was enforced for a direct call and silently skipped here. Nothing was
// corrupted in the reproduction only because a region happened to be open further up the
// stack — the check simply did not run.
//
// The answer is conservative because it has to be: a call through `dynamic Describable`
// cannot know which implementation runs, so if ANY of them allocates, the call site needs a
// region. Note there is no syntax for this. An earlier design had `allocates` on the trait
// signature, which would have been one fact in two places — the trait declaring it and
// every impl having to agree.
trait Describable {
    function describe(self) -> String
}
record Rate { pct: Int }
implement Describable for Rate {
    function (self) describe() -> String {
        return "rate " + to_string(self.pct);
    }
}
// No region anywhere: the top level is not one, so there is nowhere for the String to live.
let r: Rate = Rate { pct: 12 };
let d: dynamic Describable = r;
print(d.describe());
