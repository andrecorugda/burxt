// A trait object borrows; returning one would outlive its storage.
trait Priced { function price(self) -> Decimal<2> }
record Book { cost: Decimal<2> }
implement Priced for Book {
    function (self: Book) price() -> Decimal<2> { return self.cost; }
}
function make() -> dynamic Priced {
    let b: Book = Book { cost: 1.00 };
    let d: dynamic Priced = b;
    return d;
}
print(1);
