// A trait object borrows; returning one would outlive its storage.
trait Priced { fn price(self) -> Decimal<2> }
struct Book { cost: Decimal<2> }
impl Priced for Book {
    fn (self: Book) price() -> Decimal<2> { return self.cost; }
}
fn make() -> dyn Priced {
    let b: Book = Book { cost: 1.00 };
    let d: dyn Priced = b;
    return d;
}
print(1);
