// Conformance is declared, never inferred from having the right method names — so a type
// argument must have an `implement`, even if its methods would happen to work.
trait Priced { function price(self) -> Int }
record Book { cost: Int }
function describe<T: Priced>(item: T) -> Int { return item.price(); }
region r {
    print(describe(Book { cost: 5 }));
}
