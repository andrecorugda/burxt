// A11, the laundering case. An interface object points at the storage of the value behind it,
// so `let mutable d` over an immutable `b` would hand out through `d` exactly the write
// `b.bump()` is refused — the same bytes, one word apart. The permission may travel with a new
// name; it may not be upgraded on the way.
//
// The other direction stays legal, and must: `let d: dynamic Bump = mutable_thing` is an
// interface object that simply cannot write.
interface Bump { function bump(mutable self) -> Int }
class Cell { n: Int }
implement Bump for Cell {
    function (mutable self) bump() -> Int {
        self.n = self.n + 1;
        return self.n;
    }
}
let b: Cell = Cell { n: 0 };
let mutable d: dynamic Bump = b;
print(d.bump());
