// A relay excuses storage that came IN as a parameter. It does not excuse storage the function
// built inside a region of its own — that is the case the escape rule exists for, and it must stay
// refused now that the rule asks a narrower question.
//
// This is the negative control for `a_function_may_return_what_it_was_handed.bx`. That fixture
// permits returning a parameter; this one proves the permission did not widen into "any function
// that mentions a relay". `leak` has no parameters, so it has nothing to relay, and the array it
// answers with belongs to a region that closes before the caller reads it.
function same(xs: [Int]) -> [Int] { return xs; }

function leak() -> [Int] {
    region r { let mutable a: [Int] = []; let n: Int = push(a, 1); return same(a); }
}

print("k");
