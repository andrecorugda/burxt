// Calling a mutating method through a trait object is deferred: the compiler
// cannot yet tell whether the borrowed value is itself mutable.
trait Bumpable {
    fn bump(mut self) -> Int
}
struct Counter { n: Int }
impl Bumpable for Counter {
    fn (mut self: Counter) bump() -> Int {
        self.n = self.n + 1;
        return self.n;
    }
}
let mut c: Counter = Counter { n: 0 };
let d: dyn Bumpable = c;
print(d.bump());
