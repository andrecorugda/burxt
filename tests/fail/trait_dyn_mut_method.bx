// Calling a mutating method through an interface object is deferred: the compiler
// cannot yet tell whether the borrowed value is itself mutable.
interface Bumpable {
    function bump(mutable self) -> Int
}
class Counter { n: Int }
implement Bumpable for Counter {
    function (mutable self: Counter) bump() -> Int {
        self.n = self.n + 1;
        return self.n;
    }
}
let mutable c: Counter = Counter { n: 0 };
let d: dynamic Bumpable = c;
print(d.bump());
