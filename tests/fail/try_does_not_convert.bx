// The one decision `?` needed: it does NOT convert between error types. Two libraries
// with different failures means two `match`es, which is also the honest amount of thinking
// — somebody has to decide what the caller's failure means. See spec/M8-ERRORS.md §1a.
enum Result<T, E> { Ok(T), Error(E) }

function checked(a: Int, b: Int) -> Result<Int, String> {
    if b == 0 { return Result.Error("division by zero"); }
    return Result.Ok(divide_toward_zero(a, b));
}

function wrapped(a: Int, b: Int) -> Result<Int, Int> {
    let n = checked(a, b)?;
    return Result.Ok(n);
}
region r {
    print(1);
}
