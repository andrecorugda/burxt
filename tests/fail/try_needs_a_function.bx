// `?` returns the failure from the enclosing function. A top-level statement has none.
enum Result<T, E> { Ok(T), Err(E) }

fn checked(a: Int, b: Int) -> Result<Int, String> {
    if b == 0 { return Result.Err("division by zero"); }
    return Result.Ok(div_trunc(a, b));
}

region r {
    let n = checked(1, 0)?;
    print(n);
}
