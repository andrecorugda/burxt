// Every trait method must be implemented — Burxt has no default bodies.
trait HasBalance {
    function balance_of(self) -> Decimal<2>
    function label(self) -> Int
}
record Account { balance: Decimal<2> }
implement HasBalance for Account {
    function (self: Account) balance_of() -> Decimal<2> { return self.balance; }
}
print(1);
