// A literal has no home for the change to land in: the callee would modify a temporary, the program
// would look like it worked, and nothing would have happened. That is the shape of silent wrong answer
// this language exists to refuse, so it is refused rather than allowed-and-useless.
function reverse(mutable xs: [Int]) -> Int {
    let held: Int = xs[0];
    xs[0] = xs[1];
    xs[1] = held;
    return 0;
}
region main {
    let n: Int = reverse([1, 2]);
    print(n);
}
