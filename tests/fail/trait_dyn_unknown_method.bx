// A trait object exposes ONLY its trait methods — no downcasting, no asking
// what concrete type it really is.
trait Priced { function price(self) -> Decimal<2> }
record Book { cost: Decimal<2>, pages: Int }
implement Priced for Book {
    function (self: Book) price() -> Decimal<2> { return self.cost; }
}
function (self: Book) page_count() -> Int { return self.pages; }

let b: Book = Book { cost: 1.00, pages: 200 };
let d: dynamic Priced = b;
print(d.page_count());
