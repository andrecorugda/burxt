{
  "name": "burxt",
  "displayName": "Burxt",
  "description": "Burxt — a contract-first imperative language. Syntax highlighting, live diagnostics and hover, from the compiler itself.",
  "version": "0.1.5",
  "publisher": "burxt",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/andrecorugda/burxt.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "burxt",
    "decimal",
    "money",
    "llvm"
  ],
  "contributes": {
    "languages": [
      {
        "id": "burxt",
        "aliases": [
          "Burxt",
          "burxt"
        ],
        "extensions": [
          ".bx"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./file-icon.png",
          "dark": "./file-icon.png"
        }
      },
      {
        "//": "Matched by FILENAME, not extension. `burxt.package` and `burxt.lock` have no suffix of their own, and an `extensions: [\".package\"]` entry would both miss these files and claim every other tool's.",
        "id": "burxt-package",
        "aliases": [
          "Burxt package manifest"
        ],
        "filenames": [
          "burxt.package"
        ],
        "configuration": "./manifest-language-configuration.json"
      },
      {
        "//": "Its own language rather than a second filename on the one above: the two vocabularies do not overlap, and a lockfile is written by `burxt fetch` rather than by hand.",
        "id": "burxt-lock",
        "aliases": [
          "Burxt lockfile"
        ],
        "filenames": [
          "burxt.lock"
        ],
        "configuration": "./manifest-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "burxt",
        "scopeName": "source.burxt",
        "path": "./syntaxes/burxt.tmLanguage.json"
      },
      {
        "language": "burxt-package",
        "scopeName": "source.burxt-package",
        "path": "./syntaxes/burxt-package.tmLanguage.json"
      },
      {
        "language": "burxt-lock",
        "scopeName": "source.burxt-lock",
        "path": "./syntaxes/burxt-lock.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[burxt]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 4
      },
      "[burxt-lock]": {
        "//": "A lockfile says `Do not edit it by hand` in its own header, and `burxt fetch` rewrites it whole. Read-only is not something an extension can set, so the next best thing is to stop the editor from making silent changes to a file nobody should be editing.",
        "files.trimTrailingWhitespace": false,
        "files.insertFinalNewline": false
      }
    },
    "problemMatchers": [
      {
        "name": "burxt",
        "owner": "burxt",
        "source": "burxt",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "severity": "error",
        "pattern": [
          {
            "regexp": "^error: (.*)$",
            "message": 1
          },
          {
            "regexp": "^\\s*-->\\s+(.+):(\\d+):(\\d+)$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "burxt.run",
        "title": "Burxt: Run File",
        "icon": "$(play)"
      },
      {
        "command": "burxt.build",
        "title": "Burxt: Build File"
      },
      {
        "command": "burxt.restartServer",
        "title": "Burxt: Restart Language Server"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "burxt.run",
          "when": "resourceLangId == burxt",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "burxt.run",
          "when": "resourceLangId == burxt",
          "group": "z_commands"
        }
      ]
    },
    "keybindings": [
      {
        "command": "burxt.run",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "resourceLangId == burxt"
      }
    ],
    "configuration": {
      "title": "Burxt",
      "properties": {
        "burxt.path": {
          "type": "string",
          "default": "",
          "description": "Path to the burxt compiler, which also hosts the language server (`burxt lsp`). Empty means: use whichever of ./target/release/burxt and ./target/debug/burxt in the workspace is NEWER, otherwise `burxt` from PATH."
        }
      }
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:burxt"
  ],
  "icon": "icon.png",
  "extensionKind": [
    "workspace"
  ]
}
