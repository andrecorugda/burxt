{
  "name": "burxt",
  "displayName": "Burxt",
  "description": "Burxt language support: syntax highlighting and live diagnostics from the compiler itself.",
  "version": "0.1.0",
  "publisher": "burxt",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/andrecorugda/burxt.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "burxt",
    "decimal",
    "money",
    "llvm"
  ],
  "contributes": {
    "languages": [
      {
        "id": "burxt",
        "aliases": [
          "Burxt",
          "burxt"
        ],
        "extensions": [
          ".bx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "burxt",
        "scopeName": "source.burxt",
        "path": "./syntaxes/burxt.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[burxt]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 4
      }
    },
    "problemMatchers": [
      {
        "name": "burxt",
        "owner": "burxt",
        "source": "burxt",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "severity": "error",
        "pattern": [
          {
            "regexp": "^error: (.*)$",
            "message": 1
          },
          {
            "regexp": "^\\s*-->\\s+(.+):(\\d+):(\\d+)$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "burxt.check",
        "title": "Burxt: Check This File"
      }
    ],
    "configuration": {
      "title": "Burxt",
      "properties": {
        "burxt.path": {
          "type": "string",
          "default": "",
          "description": "Path to the burxt compiler. Empty means: use ./target/debug/burxt in the workspace if it exists, otherwise `burxt` from PATH."
        }
      }
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:burxt"
  ]
}
