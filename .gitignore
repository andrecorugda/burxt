/target
*.o
*.ll
# Compiled Burxt outputs are bare, extensionless executables written into the
# working directory, so they are easy to commit by accident. Two slipped into
# v0.0.40 this way. Ignore anything with no extension at the repository root, then
# re-admit the files that genuinely belong there — a rule that holds for programs
# nobody has written yet, rather than a list that has to be remembered.
/*
!/*.*
!/.gitignore
!/.gitattributes
!/LICENSE-APACHE
!/LICENSE-MIT
!/assets/
!/editors/
!/examples/
!/spec/
!/src/
!/tests/

# The named outputs below are redundant under the rule above, and kept only so the
# intent is readable at a glance.
/bigparse
/boundary_scaled_marshal
/enum_basic
/enum_match_flow
/enum_payloads
/interp_value
/io
/lexer
/mixed_scale_mul
/money
/order
/p
/parser
/read_file
/region_released_on_return
/sample
/tail_call_constant_stack
/to_string_builtin
/tour
# editor tooling scratch
node_modules/
*.vsix

# transient delivery artifacts, and the marker Windows attaches to downloads
*.zip
*.tar.gz
*:Zone.Identifier
