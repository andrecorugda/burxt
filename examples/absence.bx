// ============================================================================
// No null — absence and failure as types.
//
// Burxt has no null, no nil, no undefined and no "" standing in for missing.
// Nothing is implicitly absent, so no dereference can fail. Absence is a TYPE,
// and the compiler makes you say what happens when there is nothing there.
//
// `Option<T>` and `Result<T, E>` are not language features. They are four lines
// of Burxt each, in lib/option.bx and lib/result.bx, with no compiler support
// beyond generics — which was the test set for whether the generics are real: if
// `Option` had needed a keyword, they were not.
// ============================================================================

enum Option<T> {
    None,
    Some(T)
}

enum Result<T, E> {
    Ok(T),
    Error(E)
}

// A function that might not find anything says so in its type. There is no
// sentinel to document, no -1 to remember, and no way for a caller to forget.
function position_of(xs: [Int], want: Int) -> Option<Int> {
    let mutable i = 0;
    for x in xs {
        if x == want {
            return Option.Some(i);
        }
        i += 1;
    }
    return Option.None;
}

// A function that can fail says THAT in its type. No exception to catch, no
// error code to check-or-not.
function divide(a: Int, b: Int) -> Result<Int, String> {
    if b == 0 {
        return Result.Error("division by zero");
    }
    return Result.Ok(divide_toward_zero(a, b));
}

// The value or a fallback — generic over the element, so one definition serves
// every type. `Option<T>` inside a generic body is checked once, with `T`
// standing for nothing.
function or_else<T>(o: Option<T>, fallback: T) -> T {
    match o {
        None => { return fallback; }
        Some(value) => { return value; }
    }
}

// `?` yields the value or returns the failure from here — so the happy path reads as
// if nothing could go wrong, while the compiler still knows it can.
function average(a: Int, b: Int, n: Int) -> Result<Int, String> {
    let mean = divide(a + b, n)?;
    return Result.Ok(mean);
}

// The same shortcut over absence, in a function that answers with an Option.
function doubled_first(xs: [Int]) -> Option<Int> {
    let head = position_of(xs, 5)?;
    return Option.Some(head * 2);
}

let mutable xs: [Int] = [];
let a = push(xs, 5);
let b = push(xs, 9);
let c = push(xs, 14);

// Both cases, every time. That is the whole feature.
match position_of(xs, 9) {
    None => { print("not there"); }
    Some(at) => { print(at); }
}
match position_of(xs, 7) {
    None => { print("not there"); }
    Some(at) => { print(at); }
}

// Or a fallback, when a default is the right answer.
print(or_else(position_of(xs, 14), 0 - 1));
print(or_else(position_of(xs, 99), 0 - 1));

// One definition of `or_else`, two instantiations: `Option<Int>` and
// `Option<String>` are separate types with separate layouts.
let keywords: Option<String> = Option.Some("found");
print(or_else(keywords, "missing"));

match divide(10, 2) {
    Ok(answer) => { print(answer); }
    Error(why) => { print(why); }
}
match divide(1, 0) {
    Ok(answer) => { print(answer); }
    Error(why) => { print(why); }
}

// `?` in action: the second call fails, and the failure travels out untouched.
match average(10, 6, 2) {
    Ok(mean) => { print(mean); }
    Error(why) => { print(why); }
}
match average(10, 6, 0) {
    Ok(mean) => { print(mean); }
    Error(why) => { print(why); }
}
match doubled_first(xs) {
    None => { print("no 5"); }
    Some(v) => { print(v); }
}

// ---- What the compiler refuses, and why ------------------------------------
//
// Forgetting a case — the reason this type exists:
//     match found { Some(n) => { print(n); } }
//     error: this `match` on `Option<Int>` does not handle `None`. Every variant
//            must be handled — that is what makes adding a variant later a
//            compile error instead of a silent fall-through.
//
// A value whose type nothing states. `None` carries nothing, so nothing in the
// line says what `T` is:
//     let nothing = Option.None;
//     error: `Option.None` does not say what `T` is, and nothing here does.
//            Write the type where the value lands — `let x: Option<...> = ...`
//
// A record payload works since v0.0.118 — `Option<Point>` is an ordinary thing to want, and it
// used to be refused by name. What is still refused is an ENUM inside an enum, and the message
// says why in terms of the argument that caused it:
//     let held: Option<Shape> = Option.None;     // Shape is itself an enum
//     error: `Option<Shape>` cannot be made: `Option.Some` would carry the enum `Shape`,
//            which needs indirection to have a finite size.
//
// ---- `?` — the shortcut, and the one thing it will not do -------------------
//
// In a function that itself answers with a failure, `?` yields the value or returns
// the failure from here, immediately.
//
//     function average(a: Int, b: Int, n: Int) -> Result<Int, String> {
//         let mean = divide(a + b, n)?;      // the value, or return the Error
//         return Result.Ok(mean);
//     }
//
// It works on absence too, in a function answering with an `Option`:
//
//     function doubled_first(xs: [Int]) -> Option<Int> {
//         let head = first_of(xs)?;          // the value, or return None
//         return Option.Some(head * 2);
//     }
//
// `?` recognises a failure by the VARIANT name — `Error` or `None` — never by the
// enum's own name. That is what lets these be library types: an enum you write
// yourself gets `?` too, as long as its failing case is called `Error` or `None`.
//
// And it does NOT convert between error types:
//
//     error: `?` does not convert between failures: this one carries String, and the
//            enclosing function's `Error` carries Int. Write the `match`, or make the
//            two agree.
//
// Two libraries with different failures means two `match`es. That is more typing and
// it is also the honest amount of thinking — somebody has to decide what the caller's
// failure means, and that decision does not belong to an operator.
//
// ---- What is deliberately absent -------------------------------------------
//
// There is no `unwrap`. "Give me the value and abort if there is none" is null
// with extra steps, and the crash it causes is the one this type prevents.
