// ============================================================================
// STAGE-1: the Burxt compiler, written in Burxt.
//
// One file, because Burxt has no module system yet — which is the shape
// spec/M4-SELF-HOSTING.md predicted stage-1 would take. It grows a phase at a time:
//
//   phase 2 (v0.0.52)  the lexer: the real token set, exact money literals
//   phase 3 (v0.0.53)  the parser: types, expressions, statements, in an arena
//
// Nothing here uses a map, because Burxt has none: the keyword table and the symbol
// table are arrays searched linearly, which is what a compiler's lookups cost anyway.
// ============================================================================

// ---- token kinds -----------------------------------------------------------
// Codes rather than an enum: a 60-variant enum would force a 60-arm `match` at
// every use, and the payloads differ per kind. The names live in `kind_name`.
//   1 identifier      2 Int literal      3 Decimal literal     4 String literal
//   10..49 punctuation                   100.. keywords
struct Tok {
    kind: Int,
    start: Int,
    length: Int,
    // Int literals: the value. Decimals: the unscaled integer, with `scale` places.
    value: Int,
    scale: Int,
    // A string literal containing `{` opens an interpolation; splitting the pieces
    // is the parser's job, so the lexer only records that there is one.
    interpolated: Bool,
}

struct Kw { word: String, code: Int }
// ---- the AST -----------------------------------------------------------------
// Children by INDEX, not by pointer: v0.0.22 proved an arena needs no recursive
// types, and an index is a number a struct field can hold.
//
// Expression kinds:
//   1 Int literal        2 Decimal literal      3 String literal    4 Bool literal
//   5 name               6 unary minus          7 not
//   8 binary (a op b, op in `value`)             9 comparison
//  10 logical            11 field access        12 index
//  13 call               14 method call
// Type kinds:
//  40 Int  41 Bool  42 String  43 CInt  44 CDouble
//  45 Decimal (scale in `a`, contract in `b`)   46 named   47 slice   48 array
//  49 dyn
// Statement kinds:
//  60 let (name tok in `tok`, type in `a`, value in `b`, mutable in `value`)
//  61 assign            62 print               63 return            64 tail return
//  65 if                66 while               67 break             68 continue
//  69 region            70 expression statement
struct Node {
    kind: Int,
    // Child indices, or payload. Meaning depends on `kind`, documented above.
    a: Int,
    b: Int,
    c: Int,
    // The operator byte, a flag, or a literal's value — whatever the kind needs.
    value: Int,
    // The token this node started at, so a message can point at the source.
    tok: Int,
}

// One compilation unit: its tokens, its keyword table, and its AST.
//
// `kids` is where child LISTS live — the arguments of a call, the statements of a
// block. A node stores a start offset and a count into it, rather than a linked list
// through the nodes themselves.
//
// That is not a workaround for the two gaps found writing this file (Burxt has no
// `xs[i].field = v`, and no writing to a growable array element through a field): it
// is the better design regardless. Children pushed into a side array land
// CONTIGUOUSLY even though their subtrees interleave in `nodes`, so nothing needs
// back-patching, and a list is two integers instead of a chain of cells.
// A declared type: `Int`, `Decimal<2, RoundHalfEven>`, `[Int]`, a struct name.
// A struct rather than an enum, because it is compared and copied constantly and a
// payload enum would need a match at every use.
struct Ty {
    // The node kinds the parser produces: 40 Int, 41 Bool, 42 String, 43 CInt,
    // 44 CDouble, 45 Decimal, 46 named, 47 slice, 48 array, 49 dyn. 0 is unknown,
    // which never equals anything — including another unknown.
    kind: Int,
    scale: Int,
    contract: Int,
    // For a named type, the span of its name in the source.
    name_start: Int,
    name_len: Int,
}

// A binding in scope: its name as a SPAN, so the checker allocates nothing to
// remember a variable.
struct Sym { start: Int, length: Int, ty: Ty, mutable: Int, depth: Int }
// A declared function: its name span, its return type, and its parameter list node.
struct Fun { start: Int, length: Int, ret: Ty, params: Int, flags: Int }
// A declared struct or enum: its name span and the item node that declared it.
struct TypeDecl { start: Int, length: Int, kind: Int, node: Int }
// A declared method, keyed by the receiver's name and its own.
struct Method {
    receiver_start: Int, receiver_len: Int,
    start: Int, length: Int,
    ret: Ty, params: Int, mutating: Int, flags: Int,
}

struct Unit {
    toks: [Tok],
    words: [Kw],
    nodes: [Node],
    kids: [Int],
    // A SECOND child array, for lists nested inside another list: a match arm's
    // bindings, an enum variant's payload types, a trait signature's parameters.
    //
    // Not tidiness — correctness. Pushing bindings and arms into one array
    // interleaves them, and the design's whole premise is that a list is contiguous.
    // The first version did exactly that and indexed past the end; the cross-check
    // test caught it on tests/pass/enum_match_flow.bx.
    subs: [Int],
    // Top-level items, in source order, for the checker to walk.
    items: [Int],
    syms: [Sym],
    funs: [Fun],
    stack: [Int],
    methods: [Method],
    types: [TypeDecl],
    // Block depth, so a binding leaves scope at the closing brace.
    depth: Int,
    problems: Int,
    // Where the parser is in the token array.
    pos: Int,
    // Nonzero while parsing an `if`/`while` condition, where a `{` opens the BODY
    // rather than a struct literal. The Rust parser carries the same flag.
    impls: [Impl],
    typed: [Typed],
    // How many regions are open, and whether the function being checked declared
    // `allocates` — which means the caller's region is the region in effect. Together
    // these answer M1's one question: is there somewhere to allocate?
    region_depth: Int,
    in_caller_region: Int,
    in_pure: Int,
    loop_depth: Int,
    in_contract: Int,
    in_ensures: Int,
    // Which function is being checked, so a `tail` call can be compared with the
    // signature it must replace. -1 at top level and inside a method.
    current_fn: Int,
    // The backend's state: the IR text, the constants it referred to, a counter for
    // registers and one for labels, the locals' allocas, and the enclosing loops'
    // labels so `break` and `continue` know where to jump.
    out: String,
    globals: String,
    next_tmp: Int,
    next_label: Int,
    slots: [Slot],
    strings: [Int],
    loop_conds: [String],
    loop_ends: [String],
    in_function: Int,
    no_struct: Int,
    // Set while typing the operands of `*`. Multiplication combines a quantity with a
    // rate, so its operand scales differ by nature: a literal that cannot narrow to
    // the result's scale keeps its own instead of being refused. Stage-0 reaches the
    // same answer by re-checking both operands with no expected type.
    in_mul: Int,
    errors: Int,
}

fn is_alpha(b: Int) -> Bool {
    return (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || b == 95;
}

fn is_digit(b: Int) -> Bool {
    return b >= 48 && b <= 57;
}

fn is_name_byte(b: Int) -> Bool {
    return is_alpha(b) || is_digit(b);
}

fn is_space(b: Int) -> Bool {
    return b == 32 || b == 9 || b == 10 || b == 13;
}

fn at_byte(src: String, i: Int) -> Int {
    if i < 0 || i >= len(src) {
        return -1;
    }
    return byte_at(src, i);
}

// Compare two spans of the source directly. The obvious way to write this is
// `span_eq(src, a, alen, substring(src, b, blen))` — and the compiler refused it,
// because `substring` allocates and a comparison has no business needing a region.
// Comparing in place is both cheaper and what the checker wanted anyway.
fn spans_eq(src: String, a: Int, a_len: Int, b: Int, b_len: Int) -> Bool {
    if a_len != b_len {
        return false;
    }
    let mut i: Int = 0;
    while i < a_len {
        if byte_at(src, a + i) != byte_at(src, b + i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// Compare a span of the source against a whole word, without allocating.
fn span_eq(src: String, start: Int, length: Int, word: String) -> Bool {
    if length != len(word) {
        return false;
    }
    let mut i: Int = 0;
    while i < length {
        if byte_at(src, start + i) != byte_at(word, i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// ---- the keyword table -----------------------------------------------------
// Codes from 100. Order does not matter; the lookup is a scan.
fn (mut self: Unit) add_word(word: String, code: Int) -> Int {
    push(self.words, Kw { word: word, code: code });
    return len(self.words);
}

fn (mut self: Unit) install_keywords() -> Int {
    let mut n: Int = 0;
    n = self.add_word("let", 100);
    n = self.add_word("mut", 101);
    n = self.add_word("fn", 102);
    n = self.add_word("return", 103);
    n = self.add_word("if", 104);
    n = self.add_word("else", 105);
    n = self.add_word("while", 106);
    n = self.add_word("break", 107);
    n = self.add_word("continue", 108);
    n = self.add_word("struct", 109);
    n = self.add_word("enum", 110);
    n = self.add_word("match", 111);
    n = self.add_word("trait", 112);
    n = self.add_word("impl", 113);
    n = self.add_word("for", 114);
    n = self.add_word("dyn", 115);
    n = self.add_word("extern", 116);
    n = self.add_word("region", 117);
    n = self.add_word("print", 118);
    n = self.add_word("self", 119);
    n = self.add_word("true", 120);
    n = self.add_word("false", 121);
    n = self.add_word("as", 122);
    n = self.add_word("tail", 123);
    n = self.add_word("pure", 124);
    // `allocates`, `requires`, `ensures` and `decreases` are deliberately NOT here:
    // stage-0 made them contextual in v0.0.55, so they are ordinary identifiers and
    // the parser recognises them by position. A lexer that disagreed with stage-0
    // about this would reject `let allocates: Int = 0;` — which the cross-check test
    // caught within a minute of the change.
    n = self.add_word("interface", 129);
    n = self.add_word("is", 130);
    // Type names are keywords too: the parser needs them distinguished from
    // ordinary identifiers, exactly as the Rust lexer does.
    n = self.add_word("Int", 140);
    n = self.add_word("Bool", 141);
    n = self.add_word("String", 142);
    n = self.add_word("CInt", 143);
    n = self.add_word("CDouble", 144);
    n = self.add_word("Decimal", 145);
    n = self.add_word("RoundHalfEven", 146);
    n = self.add_word("RoundHalfUp", 147);
    return n;
}

// An identifier's span, or a keyword code if the table has it.
fn (self: Unit) keyword_code(src: String, start: Int, length: Int) -> Int {
    let mut i: Int = 0;
    while i < len(self.words) {
        if span_eq(src, start, length, self.words[i].word) {
            return self.words[i].code;
        }
        i = i + 1;
    }
    return 1;
}

fn (mut self: Unit) emit(kind: Int, start: Int, length: Int) -> Int {
    push(self.toks, Tok {
        kind: kind, start: start, length: length,
        value: 0, scale: 0, interpolated: false,
    });
    return len(self.toks);
}

fn (mut self: Unit) emit_number(kind: Int, start: Int, length: Int, value: Int, scale: Int) -> Int {
    push(self.toks, Tok {
        kind: kind, start: start, length: length,
        value: value, scale: scale, interpolated: false,
    });
    return len(self.toks);
}

fn (mut self: Unit) emit_string(start: Int, length: Int, interpolated: Bool) -> Int {
    push(self.toks, Tok {
        kind: 4, start: start, length: length,
        value: 0, scale: 0, interpolated: interpolated,
    });
    return len(self.toks);
}

// ---- whitespace and comments ----------------------------------------------
fn skip_trivia(src: String, from: Int) -> Int {
    let mut i: Int = from;
    while true {
        let mut moved: Bool = false;
        while i < len(src) && is_space(byte_at(src, i)) {
            i = i + 1;
            moved = true;
        }
        if at_byte(src, i) == 47 && at_byte(src, i + 1) == 47 {
            while i < len(src) && byte_at(src, i) != 10 {
                i = i + 1;
            }
            moved = true;
        }
        if !moved {
            break;
        }
    }
    return i;
}

// ---- numbers ---------------------------------------------------------------
// `19.99` is the unscaled integer 1999 with scale 2 — accumulated digit by digit,
// never through a float. `$19.99` is the same. `8.25%` is two places finer.
fn (mut self: Unit) scan_number(src: String, from: Int) -> Int allocates {
    let mut i: Int = from;
    let money: Bool = byte_at(src, i) == 36;         // '$'
    if money {
        i = i + 1;
    }
    let mut value: Int = 0;
    while i < len(src) && is_digit(byte_at(src, i)) {
        value = value * 10 + (byte_at(src, i) - 48);
        i = i + 1;
    }
    let mut scale: Int = 0;
    if at_byte(src, i) == 46 && is_digit(at_byte(src, i + 1)) {
        i = i + 1;
        while i < len(src) && is_digit(byte_at(src, i)) {
            value = value * 10 + (byte_at(src, i) - 48);
            scale = scale + 1;
            i = i + 1;
        }
    }
    if at_byte(src, i) == 37 {                       // '%'
        i = i + 1;
        // A percent is the number divided by a hundred: two more places, exactly.
        let n: Int = self.emit_number(3, from, i - from, value, scale + 2);
        return i;
    }
    if money || scale > 0 {
        let n: Int = self.emit_number(3, from, i - from, value, scale);
        return i;
    }
    let n: Int = self.emit_number(2, from, i - from, value, 0);
    return i;
}

// ---- strings ---------------------------------------------------------------
fn (mut self: Unit) scan_string(src: String, from: Int) -> Int allocates {
    let mut i: Int = from + 1;
    let mut interpolated: Bool = false;
    while true {
        if i >= len(src) {
            print("error: unterminated string literal");
            self.errors = self.errors + 1;
            break;
        }
        let b: Int = byte_at(src, i);
        if b == 92 {                                 // '\' — an escape, whatever follows
            i = i + 2;
            continue;
        }
        if b == 123 {                                // '{' opens an interpolation
            interpolated = true;
            i = i + 1;
            continue;
        }
        if b == 34 {                                 // '"' closes it
            i = i + 1;
            break;
        }
        i = i + 1;
    }
    let n: Int = self.emit_string(from, i - from, interpolated);
    return i;
}

// ---- punctuation -----------------------------------------------------------
// Two-character forms are tried first: `-` and `->` differ by one byte and mean
// entirely different things.
fn (mut self: Unit) scan_punct(src: String, from: Int) -> Int allocates {
    let one: Int = byte_at(src, from);
    let two: Int = at_byte(src, from + 1);
    if one == 45 && two == 62 { let n: Int = self.emit(10, from, 2); return from + 2; }  // ->
    if one == 61 && two == 62 { let n: Int = self.emit(11, from, 2); return from + 2; }  // =>
    if one == 61 && two == 61 { let n: Int = self.emit(12, from, 2); return from + 2; }  // ==
    if one == 33 && two == 61 { let n: Int = self.emit(13, from, 2); return from + 2; }  // !=
    if one == 60 && two == 61 { let n: Int = self.emit(14, from, 2); return from + 2; }  // <=
    if one == 62 && two == 61 { let n: Int = self.emit(15, from, 2); return from + 2; }  // >=
    if one == 38 && two == 38 { let n: Int = self.emit(16, from, 2); return from + 2; }  // &&
    if one == 124 && two == 124 { let n: Int = self.emit(17, from, 2); return from + 2; } // ||

    if one == 58 { let n: Int = self.emit(20, from, 1); return from + 1; }   // :
    if one == 59 { let n: Int = self.emit(21, from, 1); return from + 1; }   // ;
    if one == 44 { let n: Int = self.emit(22, from, 1); return from + 1; }   // ,
    if one == 46 { let n: Int = self.emit(23, from, 1); return from + 1; }   // .
    if one == 61 { let n: Int = self.emit(24, from, 1); return from + 1; }   // =
    if one == 43 { let n: Int = self.emit(25, from, 1); return from + 1; }   // +
    if one == 45 { let n: Int = self.emit(26, from, 1); return from + 1; }   // -
    if one == 42 { let n: Int = self.emit(27, from, 1); return from + 1; }   // *
    if one == 47 { let n: Int = self.emit(28, from, 1); return from + 1; }   // /
    if one == 40 { let n: Int = self.emit(29, from, 1); return from + 1; }   // (
    if one == 41 { let n: Int = self.emit(30, from, 1); return from + 1; }   // )
    if one == 123 { let n: Int = self.emit(31, from, 1); return from + 1; }  // {
    if one == 125 { let n: Int = self.emit(32, from, 1); return from + 1; }  // }
    if one == 91 { let n: Int = self.emit(33, from, 1); return from + 1; }   // [
    if one == 93 { let n: Int = self.emit(34, from, 1); return from + 1; }   // ]
    if one == 60 { let n: Int = self.emit(35, from, 1); return from + 1; }   // <
    if one == 62 { let n: Int = self.emit(36, from, 1); return from + 1; }   // >
    if one == 33 { let n: Int = self.emit(37, from, 1); return from + 1; }   // !

    print("error: byte " + to_string(one) + " starts no token");
    self.errors = self.errors + 1;
    return from + 1;
}

// ---- the loop --------------------------------------------------------------
fn (mut self: Unit) run(src: String) -> Int allocates {
    let mut i: Int = 0;
    while true {
        i = skip_trivia(src, i);
        if i >= len(src) {
            break;
        }
        let b: Int = byte_at(src, i);
        if is_alpha(b) {
            let start: Int = i;
            while i < len(src) && is_name_byte(byte_at(src, i)) {
                i = i + 1;
            }
            let code: Int = self.keyword_code(src, start, i - start);
            let n: Int = self.emit(code, start, i - start);
            continue;
        }
        if is_digit(b) || (b == 36 && is_digit(at_byte(src, i + 1))) {
            i = self.scan_number(src, i);
            continue;
        }
        if b == 34 {
            i = self.scan_string(src, i);
            continue;
        }
        i = self.scan_punct(src, i);
    }
    return len(self.toks);
}


// ============================================================================
// PHASE 3: the parser. Tokens in, arena AST out.
// ============================================================================

fn (self: Unit) kind_at(offset: Int) -> Int {
    let i: Int = self.pos + offset;
    if i < 0 || i >= len(self.toks) {
        return 0;                                    // past the end
    }
    return self.toks[i].kind;
}

fn (self: Unit) at(kind: Int) -> Bool {
    return self.kind_at(0) == kind;
}

// Is the current token the contextual word `word`? Compared against the source span,
// so it costs no allocation — the same trick keyword lookup uses.
fn (self: Unit) at_word(src: String, word: String) -> Bool {
    if self.kind_at(0) != 1 {
        return false;
    }
    let t: Tok = self.toks[self.pos];
    return span_eq(src, t.start, t.length, word);
}

fn (self: Unit) done() -> Bool {
    return self.pos >= len(self.toks);
}

fn (mut self: Unit) advance() -> Int {
    self.pos = self.pos + 1;
    return self.pos;
}

fn (mut self: Unit) complain(src: String, what: String) -> Int allocates {
    let where: Int = self.pos;
    if where < len(self.toks) {
        let t: Tok = self.toks[where];
        print("parse error: expected " + what + ", found `"
              + substring(src, t.start, t.length) + "`");
    } else {
        print("parse error: expected " + what + ", found the end of the file");
    }
    self.errors = self.errors + 1;
    return -1;
}

// Consume a token of this kind, or report what was there instead.
fn (mut self: Unit) eat(src: String, kind: Int, what: String) -> Bool allocates {
    if self.at(kind) {
        let n: Int = self.advance();
        return true;
    }
    let bad: Int = self.complain(src, what);
    return false;
}

fn (mut self: Unit) add(kind: Int, a: Int, b: Int, c: Int, value: Int, tok: Int) -> Int {
    push(self.nodes, Node { kind: kind, a: a, b: b, c: c, value: value, tok: tok });
    return len(self.nodes) - 1;
}

// ---- types -------------------------------------------------------------------
fn (mut self: Unit) parse_type(src: String) -> Int allocates {
    let here: Int = self.pos;
    let k: Int = self.kind_at(0);
    if k == 140 { let n: Int = self.advance(); return self.add(40, 0, 0, 0, 0, here); }
    if k == 141 { let n: Int = self.advance(); return self.add(41, 0, 0, 0, 0, here); }
    if k == 142 { let n: Int = self.advance(); return self.add(42, 0, 0, 0, 0, here); }
    if k == 143 { let n: Int = self.advance(); return self.add(43, 0, 0, 0, 0, here); }
    if k == 144 { let n: Int = self.advance(); return self.add(44, 0, 0, 0, 0, here); }
    if k == 145 {
        // Decimal<S> or Decimal<S, RoundHalfEven>: the scale and the contract are
        // part of the type, so they are part of the node.
        let n: Int = self.advance();
        if !self.eat(src, 35, "`<` after `Decimal`") { return -1; }
        if !self.at(2) { return self.complain(src, "a scale, e.g. `Decimal<2>`"); }
        let scale: Int = self.toks[self.pos].value;
        let m: Int = self.advance();
        let mut contract: Int = 0;
        if self.at(22) {                             // ','
            let c: Int = self.advance();
            if self.at(146) { contract = 1; }
            if self.at(147) { contract = 2; }
            if contract == 0 {
                return self.complain(src, "`RoundHalfEven` or `RoundHalfUp`");
            }
            let d: Int = self.advance();
        }
        if !self.eat(src, 36, "`>` closing the type") { return -1; }
        return self.add(45, scale, contract, 0, 0, here);
    }
    if k == 115 {                                    // dyn
        let n: Int = self.advance();
        if !self.at(1) { return self.complain(src, "a trait name after `dyn`"); }
        let name_tok: Int = self.pos;
        let m: Int = self.advance();
        return self.add(49, 0, 0, 0, 0, name_tok);
    }
    if k == 33 {                                     // '[' — slice or fixed array
        let n: Int = self.advance();
        let elem: Int = self.parse_type(src);
        if elem < 0 { return -1; }
        if self.at(21) {                             // ';' — a fixed length follows
            let semi: Int = self.advance();
            if !self.at(2) { return self.complain(src, "an array length"); }
            let count: Int = self.toks[self.pos].value;
            let m: Int = self.advance();
            if !self.eat(src, 34, "`]` closing the array type") { return -1; }
            return self.add(48, elem, count, 0, 0, here);
        }
        if !self.eat(src, 34, "`]` closing the slice type") { return -1; }
        return self.add(47, elem, 0, 0, 0, here);
    }
    if k == 1 {                                      // a named struct, enum or trait
        let name_tok: Int = self.pos;
        let n: Int = self.advance();
        return self.add(46, 0, 0, 0, 0, name_tok);
    }
    return self.complain(src, "a type");
}

// The type of `Name.field`, found by walking the struct's declaration. Linear, like
// every other lookup here: a struct has a handful of fields, and a map would be a
// dependency on machinery the language does not have.
fn (self: Unit) field_type(src: String, holder: Ty, name_tok: Int) -> Ty {
    if holder.kind != 46 {
        return ty_unknown();
    }
    let found: Int = self.find_type(src, holder.name_start, holder.name_len);
    if found < 0 {
        return ty_unknown();
    }
    let decl: TypeDecl = self.types[found];
    if decl.kind != 82 {
        return ty_unknown();
    }
    let item: Node = self.nodes[decl.node];
    let wanted: Tok = self.toks[name_tok];
    let mut i: Int = 0;
    while i < item.b {
        let field: Node = self.nodes[self.kids[item.a + i]];
        let field_name: Tok = self.toks[field.tok];
        if spans_eq(src, field_name.start, field_name.length, wanted.start, wanted.length) {
            return self.ty_of(src, field.a);
        }
        i = i + 1;
    }
    return ty_unknown();
}

// A builtin's return type. They are not in the function table because they are not
// declared anywhere — the compiler knows them, so the checker must too.
// How many arguments each builtin takes, and -1 for a name that is not one. Kept as a
// table rather than folded into the checks below, because "wrong number of arguments"
// is one message and reporting it once is what stops the type errors that follow it
// from being noise.
fn builtin_arity(name: String) -> Int {
    if name == "arg_count" { return 0; }
    if name == "len" { return 1; }
    if name == "to_string" { return 1; }
    if name == "read_file" { return 1; }
    if name == "arg" { return 1; }
    if name == "byte_at" { return 2; }
    if name == "push" { return 2; }
    if name == "truncate" { return 2; }
    if name == "write_file" { return 2; }
    if name == "div_floor" { return 2; }
    if name == "div_trunc" { return 2; }
    if name == "rem" { return 2; }
    if name == "substring" { return 3; }
    return -1;
}

fn builtin_result(name: String) -> Ty {
    if name == "to_string" { return ty_simple(42); }
    if name == "read_file" { return ty_simple(42); }
    if name == "substring" { return ty_simple(42); }
    if name == "arg" { return ty_simple(42); }
    if name == "len" { return ty_simple(40); }
    if name == "byte_at" { return ty_simple(40); }
    if name == "push" { return ty_simple(40); }
    if name == "truncate" { return ty_simple(40); }
    if name == "arg_count" { return ty_simple(40); }
    if name == "write_file" { return ty_simple(40); }
    if name == "div_floor" { return ty_simple(40); }
    if name == "div_trunc" { return ty_simple(40); }
    if name == "rem" { return ty_simple(40); }
    return ty_unknown();
}

// What each builtin will accept. The receiver-shaped ones — `push` and `truncate` —
// also need a MUTABLE binding, because they change the array in place.
fn (mut self: Unit) check_builtin_args(src: String, at: Int, called: String, first: Ty,
                                       second: Ty, first_node: Int) -> Int allocates {
    if called == "len" {
        if !is_unknown(first) && first.kind != 47 && first.kind != 48 && first.kind != 42 {
            let e: Int = self.complain_at(src, at,
                "`len` counts the elements of an array or the bytes of a String, but "
                + "this is " + ty_show(src, first));
        }
        return 1;
    }
    if called == "byte_at" || called == "substring" {
        if !is_unknown(first) && first.kind != 42 {
            let e: Int = self.complain_at(src, at,
                "`" + called + "` reads a String, but this is " + ty_show(src, first));
        }
        return 1;
    }
    if called == "to_string" {
        if first.kind == 42 {
            let e: Int = self.complain_at(src, at,
                "`to_string` of a String is a copy with a name that says otherwise");
        }
        if first.kind == 46 || first.kind == 49 || first.kind == 47 || first.kind == 48 {
            let e: Int = self.complain_at(src, at,
                "`to_string` renders a number, a Bool or a Decimal — " + ty_show(src, first)
                + " has no one rendering the language can choose for it");
        }
        return 1;
    }
    if called == "div_floor" || called == "div_trunc" || called == "rem" {
        if !is_unknown(first) && first.kind != 40 {
            let e: Int = self.complain_at(src, at,
                "`" + called + "` divides Ints, but the left side is " + ty_show(src, first));
        }
        if !is_unknown(second) && second.kind != 40 {
            let e: Int = self.complain_at(src, at,
                "`" + called + "` divides Ints, but the right side is " + ty_show(src, second));
        }
        return 1;
    }
    if called == "read_file" || called == "write_file" {
        if !is_unknown(first) && first.kind != 42 {
            let e: Int = self.complain_at(src, at,
                "a path is a String, but this is " + ty_show(src, first));
        }
        if called == "write_file" && !is_unknown(second) && second.kind != 42 {
            let e: Int = self.complain_at(src, at,
                "`write_file` writes a String, but this is " + ty_show(src, second));
        }
        return 1;
    }
    if called == "arg" {
        if !is_unknown(first) && first.kind != 40 {
            let e: Int = self.complain_at(src, at, "`arg` takes an Int index");
        }
        return 1;
    }
    if called == "push" || called == "truncate" {
        if !is_unknown(first) && first.kind != 47 {
            let e: Int = self.complain_at(src, at,
                "`" + called + "` needs a growable array — a `[T]` — but this is "
                + ty_show(src, first));
            return 1;
        }
        // In place means the binding itself changes, so it must be one that may.
        if first_node >= 0 {
            let base: Node = self.nodes[first_node];
            if base.kind == 5 {
                let t: Tok = self.toks[base.tok];
                let found: Int = self.find_sym(src, t.start, t.length);
                if found >= 0 {
                    if self.syms[found].mutable == 0 {
                        let e: Int = self.complain_at(src, at,
                            "`" + called + "` changes the array in place, so `"
                            + substring(src, t.start, t.length)
                            + "` has to be declared `let mut`");
                    }
                }
            }
        }
        if called == "push" && !is_unknown(first) {
            let want: Ty = self.ty_of(src, first.scale);
            if !is_unknown(second) && !ty_same(src, second, want) {
                let e: Int = self.complain_at(src, at,
                    "this array holds " + ty_show(src, want) + ", but the value is "
                    + ty_show(src, second));
            }
        }
        if called == "truncate" && !is_unknown(second) && second.kind != 40 {
            let e: Int = self.complain_at(src, at, "`truncate` takes an Int length");
        }
        return 1;
    }
    return 1;
}

fn (mut self: Unit) builtin_type(src: String, name: Tok, at: Int, args: Int) -> Ty allocates {
    // The arguments are typed here rather than by `check_args`, because their types
    // and their count decide most of the rules below.
    let mut first: Ty = ty_unknown();
    let mut second: Ty = ty_unknown();
    let mut count: Int = 0;
    let mut first_node: Int = -1;
    if args >= 0 {
        let list: Node = self.nodes[args];
        count = list.b;
        let mut i: Int = 0;
        while i < list.b {
            let t: Ty = self.type_of(src, self.kids[list.a + i], ty_unknown());
            if i == 0 {
                first = t;
                first_node = self.kids[list.a];
            }
            if i == 1 { second = t; }
            i = i + 1;
        }
    }
    let called: String = substring(src, name.start, name.length);
    let wanted: Int = builtin_arity(called);
    if wanted >= 0 && count != wanted {
        let e: Int = self.complain_at(src, at,
            "`" + called + "` takes " + to_string(wanted) + " argument(s), but this "
            + "call passes " + to_string(count));
        return builtin_result(called);
    }
    let checked: Int = self.check_builtin_args(src, at, called, first, second, first_node);
    // Three builtins hand back a freshly built String, so all three need a region —
    // except `to_string` of a Bool, which renders to one of two literals and so
    // allocates nothing.
    let mut builds: Bool = span_eq(src, name.start, name.length, "substring")
        || span_eq(src, name.start, name.length, "read_file");
    if span_eq(src, name.start, name.length, "to_string") && first.kind != 41 {
        builds = true;
    }
    if builds {
        if !self.has_region() {
            let r: Int = self.needs_region(src, at,
                substring(src, name.start, name.length) + "(...)");
        }
    }
    if self.in_pure == 1 {
        if span_eq(src, name.start, name.length, "read_file") {
            let e: Int = self.not_pure(src, at, "read a file");
        }
        if span_eq(src, name.start, name.length, "write_file") {
            let e: Int = self.not_pure(src, at, "write a file");
        }
    }
    if span_eq(src, name.start, name.length, "len") { return ty_simple(40); }
    if span_eq(src, name.start, name.length, "byte_at") { return ty_simple(40); }
    if span_eq(src, name.start, name.length, "push") { return ty_simple(40); }
    if span_eq(src, name.start, name.length, "truncate") { return ty_simple(40); }
    if span_eq(src, name.start, name.length, "arg_count") { return ty_simple(40); }
    if span_eq(src, name.start, name.length, "write_file") { return ty_simple(40); }
    if span_eq(src, name.start, name.length, "div_floor") { return ty_simple(40); }
    if span_eq(src, name.start, name.length, "div_trunc") { return ty_simple(40); }
    if span_eq(src, name.start, name.length, "rem") { return ty_simple(40); }
    if span_eq(src, name.start, name.length, "to_string") { return ty_simple(42); }
    if span_eq(src, name.start, name.length, "read_file") { return ty_simple(42); }
    if span_eq(src, name.start, name.length, "substring") { return ty_simple(42); }
    if span_eq(src, name.start, name.length, "arg") { return ty_simple(42); }
    return ty_unknown();
}

// A `dyn Trait` value can do exactly what the trait says, so the trait's signature
// is what the call is checked against — no concrete type is involved, which is the
// whole point of the indirection.
fn (mut self: Unit) dyn_method(src: String, holder: Ty, call: Node) -> Ty allocates {
    let wanted: Tok = self.toks[call.tok];
    let found: Int = self.find_type(src, holder.name_start, holder.name_len);
    if found < 0 {
        let e: Int = self.complain_at(src, call.tok, "no trait of this name is declared");
        return ty_unknown();
    }
    let decl: TypeDecl = self.types[found];
    let item: Node = self.nodes[decl.node];
    let mut i: Int = 0;
    while i < item.b {
        let sig: Node = self.nodes[self.kids[item.a + i]];
        let named: Tok = self.toks[sig.tok];
        if spans_eq(src, named.start, named.length, wanted.start, wanted.length) {
            // A trait signature's parameters live in `subs`, after the receiver.
            let list: Node = self.nodes[call.b];
            if list.b != sig.c {
                let e: Int = self.complain_at(src, call.tok,
                    "this call passes " + to_string(list.b) + " argument(s), but the "
                    + "method takes " + to_string(sig.c));
                return self.ty_of(src, sig.a);
            }
            let mut p: Int = 0;
            while p < sig.c {
                let param: Node = self.nodes[self.subs[sig.b + p]];
                let want: Ty = self.ty_of(src, param.a);
                let got: Ty = self.type_of(src, self.kids[list.a + p], want);
                if !is_unknown(got) && !self.fits(src, got, want) {
                    let e: Int = self.complain_at(src, call.tok,
                        "argument " + to_string(p + 1) + " should be " + ty_show(src, want)
                        + ", but it is " + ty_show(src, got));
                }
                p = p + 1;
            }
            return self.ty_of(src, sig.a);
        }
        i = i + 1;
    }
    let e: Int = self.complain_at(src, call.tok,
        ty_show(src, holder) + " has no such method");
    return ty_unknown();
}

fn (self: Unit) find_method_named(src: String, holder_start: Int, holder_len: Int,
                                  name_start: Int, name_len: Int) -> Int {
    let mut i: Int = 0;
    while i < len(self.methods) {
        let m: Method = self.methods[i];
        if spans_eq(src, m.receiver_start, m.receiver_len, holder_start, holder_len) {
            if spans_eq(src, m.start, m.length, name_start, name_len) {
                return i;
            }
        }
        i = i + 1;
    }
    return -1;
}

fn (self: Unit) find_method(src: String, holder: Ty, name_tok: Int) -> Int {
    if holder.kind != 46 {
        return -1;
    }
    let wanted: Tok = self.toks[name_tok];
    return self.find_method_named(src, holder.name_start, holder.name_len,
                                  wanted.start, wanted.length);
}

// `Enum.Variant(payload)`: the variant has to exist, and the payload has to match it.
// A constructor is the mirror of a match arm, so the two read alike on purpose.
fn (mut self: Unit) check_construction(src: String, holder: Ty, call: Node) -> Int allocates {
    let variant_name: Tok = self.toks[call.tok];
    let found: Int = self.find_type(src, holder.name_start, holder.name_len);
    let item: Node = self.nodes[self.types[found].node];
    let mut i: Int = 0;
    while i < item.b {
        let variant: Node = self.nodes[self.kids[item.a + i]];
        let named: Tok = self.toks[variant.tok];
        if spans_eq(src, named.start, named.length, variant_name.start, variant_name.length) {
            let mut given: Int = 0;
            if call.kind == 14 && call.b >= 0 {
                given = self.nodes[call.b].b;
            }
            if given != variant.c {
                let e: Int = self.complain_at(src, call.tok,
                    "`" + substring(src, named.start, named.length) + "` carries "
                    + to_string(variant.c) + " value(s), but this passes "
                    + to_string(given));
                return 0;
            }
            let list: Node = self.nodes[call.b];
            let mut p: Int = 0;
            while p < given {
                let want: Ty = self.ty_of(src, self.subs[variant.b + p]);
                let got: Ty = self.type_of(src, self.kids[list.a + p], want);
                if !is_unknown(got) && !self.fits(src, got, want) {
                    let e: Int = self.complain_at(src, call.tok,
                        "this variant carries " + ty_show(src, want) + ", but the value "
                        + "is " + ty_show(src, got));
                }
                p = p + 1;
            }
            return 1;
        }
        i = i + 1;
    }
    let e: Int = self.complain_at(src, call.tok,
        ty_show(src, holder) + " has no variant of this name");
    return 0;
}

// The payload types of `Enum.Variant`, bound to an arm's names.
fn (mut self: Unit) bind_arm(src: String, holder: Ty, arm: Node) -> Int allocates {
    if holder.kind != 46 {
        return 0;
    }
    let found: Int = self.find_type(src, holder.name_start, holder.name_len);
    if found < 0 {
        return 0;
    }
    let decl: TypeDecl = self.types[found];
    if decl.kind != 83 {
        return 0;
    }
    let item: Node = self.nodes[decl.node];
    let wanted: Tok = self.toks[arm.tok];
    let mut i: Int = 0;
    while i < item.b {
        let variant: Node = self.nodes[self.kids[item.a + i]];
        let variant_name: Tok = self.toks[variant.tok];
        if spans_eq(src, variant_name.start, variant_name.length, wanted.start, wanted.length) {
            // Bind each name in the arm to the payload type at the same position.
            if arm.c != variant.c {
                let e: Int = self.complain_at(src, arm.tok,
                    "this arm binds " + to_string(arm.c) + " name(s), but the variant "
                    + "carries " + to_string(variant.c));
            }
            let mut p: Int = 0;
            while p < arm.c && p < variant.c {
                let name: Tok = self.toks[self.subs[arm.b + p]];
                let ty: Ty = self.ty_of(src, self.subs[variant.b + p]);
                push(self.syms, Sym { start: name.start, length: name.length,
                                      ty: ty, mutable: 0, depth: self.depth + 1 });
                p = p + 1;
            }
            return variant.c;
        }
        i = i + 1;
    }
    let e: Int = self.complain_at(src, arm.tok, "this enum has no such variant");
    return 0;
}

// Where a value is stored rather than combined, `dyn Trait` accepts a type that
// implements it. This is the ONLY widening in the language, which is why it is a
// separate question from `ty_same`: equality must stay equality.
fn (mut self: Unit) fits(src: String, got: Ty, want: Ty) -> Bool {
    if ty_same(src, got, want) {
        return true;
    }
    if want.kind != 49 || got.kind != 46 {
        return false;
    }
    let mut i: Int = 0;
    while i < len(self.impls) {
        let candidate: Impl = self.impls[i];
        if spans_eq(src, candidate.trait_start, candidate.trait_len,
                    want.name_start, want.name_len) {
            if spans_eq(src, candidate.type_start, candidate.type_len,
                        got.name_start, got.name_len) {
                return true;
            }
        }
        i = i + 1;
    }
    return false;
}

// Whether evaluating this expression allocates. The aggregate cases are here for the
// reason v0.0.48 recorded: a struct or array holding a built String is itself built,
// and missing that arm let a use-after-free through for four versions.
fn (mut self: Unit) expr_allocates(src: String, node: Int) -> Bool {
    if node < 0 {
        return false;
    }
    let n: Node = self.nodes[node];
    if n.kind == 3 {
        return self.toks[n.tok].interpolated;
    }
    if n.kind == 8 {
        if n.value == 25 && self.type_at(node).kind == 42 {
            return true;                             // joining Strings
        }
        return self.expr_allocates(src, n.a) || self.expr_allocates(src, n.b);
    }
    if n.kind == 6 || n.kind == 7 {
        return self.expr_allocates(src, n.a);
    }
    if n.kind == 17 || n.kind == 19 {                // an array or struct literal
        if self.type_at(node).kind == 47 {
            return true;                             // a growable array lives in a region
        }
        let mut i: Int = 0;
        while i < n.b {
            if self.expr_allocates(src, self.kids[n.a + i]) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }
    if n.kind == 13 {                                // a call
        let name: Tok = self.toks[n.tok];
        if span_eq(src, name.start, name.length, "substring")
            || span_eq(src, name.start, name.length, "read_file")
            || span_eq(src, name.start, name.length, "arg") {
            return true;
        }
        if span_eq(src, name.start, name.length, "to_string") {
            // Except of a Bool, which renders to a literal.
            let list: Node = self.nodes[n.a];
            if list.b == 1 {
                return self.type_at(self.kids[list.a]).kind != 41;
            }
            return true;
        }
        let found: Int = self.find_fun(src, name.start, name.length);
        if found >= 0 {
            return flag_allocates(self.funs[found].flags) == 1;
        }
        // An enum constructor carries its payload, so it is built if the payload is.
        let list: Node = self.nodes[n.a];
        let mut i: Int = 0;
        while i < list.b {
            if self.expr_allocates(src, self.kids[list.a + i]) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }
    if n.kind == 14 {                                // a method call
        let holder: Ty = self.type_at(n.a);
        let found: Int = self.find_method(src, holder, n.tok);
        if found >= 0 {
            return flag_allocates(self.methods[found].flags) == 1;
        }
        return false;
    }
    return false;
}

// Whether this statement always leaves the block it is in. Used twice: to find code
// after it that can never run, and to find a function that can fall off its end.
// `while` is deliberately absent — a loop with a `return` inside it may also run zero
// times, and claiming otherwise would be a guess about the condition.
fn (self: Unit) stmt_exits(node: Int) -> Bool {
    if node < 0 {
        return false;
    }
    let n: Node = self.nodes[node];
    if n.kind == 63 || n.kind == 64 || n.kind == 67 || n.kind == 68 {
        return true;                                 // return, tail return, break, continue
    }
    if n.kind == 65 {                                // if: only when BOTH sides do
        if n.c < 0 {
            return false;
        }
        return self.block_exits(n.b) && self.block_exits(n.c);
    }
    if n.kind == 69 {                                // region
        return self.block_exits(n.a);
    }
    if n.kind == 71 {                                // match: only when every arm does
        if n.c == 0 {
            return false;
        }
        let mut i: Int = 0;
        while i < n.c {
            let arm: Node = self.nodes[self.kids[n.b + i]];
            if !self.block_exits(arm.a) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    return false;
}

fn (self: Unit) block_exits(block: Int) -> Bool {
    if block < 0 {
        return false;
    }
    let b: Node = self.nodes[block];
    if b.kind != 16 {
        // `else if` puts a statement where a block usually goes, so a branch is asked
        // the same question either way rather than the shape deciding the answer.
        return self.stmt_exits(block);
    }
    if b.b == 0 {
        return false;
    }
    return self.stmt_exits(self.kids[b.a + b.b - 1]);
}

fn (self: Unit) has_region() -> Bool {
    return self.region_depth > 0 || self.in_caller_region == 1;
}

// One sentence, and it offers both ways out — the region at the use, or `allocates`
// on the signature. M1a exists because for a while only the first was available.
fn (mut self: Unit) needs_region(src: String, at: Int, what: String) -> Int allocates {
    let e: Int = self.complain_at(src, at,
        what + " allocates, so it needs a region: there is none open here. Open one "
        + "with `region r \{ ... \}`, or declare the function `allocates` to build in "
        + "the caller's region");
    return 0;
}

fn (mut self: Unit) not_pure(src: String, at: Int, what: String) -> Int allocates {
    let e: Int = self.complain_at(src, at,
        "a `pure` function may not " + what + ": a function that can change the "
        + "program is not one whose answer depends on its arguments alone");
    return 0;
}

// The markers, unpacked from the bits they ride in.
fn flag_pure(flags: Int) -> Int {
    return rem(flags, 2);
}
fn flag_allocates(flags: Int) -> Int {
    return rem(div_floor(flags, 2), 2);
}
fn flag_extern(flags: Int) -> Int {
    return rem(div_floor(flags, 8), 2);
}

// ---- expressions -------------------------------------------------------------
// Precedence climbs the way the Rust parser's does: or, and, comparison, additive,
// term, unary, postfix, primary.
fn (mut self: Unit) parse_expr(src: String) -> Int allocates {
    return self.parse_or(src);
}

fn (mut self: Unit) parse_or(src: String) -> Int allocates {
    let mut left: Int = self.parse_and(src);
    while left >= 0 && self.at(17) {                 // ||
        let here: Int = self.pos;
        let n: Int = self.advance();
        let right: Int = self.parse_and(src);
        if right < 0 { return -1; }
        left = self.add(10, left, right, 0, 124, here);
    }
    return left;
}

fn (mut self: Unit) parse_and(src: String) -> Int allocates {
    let mut left: Int = self.parse_comparison(src);
    while left >= 0 && self.at(16) {                 // &&
        let here: Int = self.pos;
        let n: Int = self.advance();
        let right: Int = self.parse_comparison(src);
        if right < 0 { return -1; }
        left = self.add(10, left, right, 0, 38, here);
    }
    return left;
}

fn (mut self: Unit) parse_comparison(src: String) -> Int allocates {
    let left: Int = self.parse_additive(src);
    if left < 0 { return -1; }
    let k: Int = self.kind_at(0);
    if k == 12 || k == 13 || k == 14 || k == 15 || k == 35 || k == 36 {
        let here: Int = self.pos;
        let n: Int = self.advance();
        let right: Int = self.parse_additive(src);
        if right < 0 { return -1; }
        // Chained comparisons are not an expression in Burxt, and saying so here
        // beats letting `a < b < c` parse into something surprising.
        let next: Int = self.kind_at(0);
        if next == 12 || next == 13 || next == 14 || next == 15 || next == 35 || next == 36 {
            return self.complain(src, "no second comparison — `a < b < c` does not chain");
        }
        return self.add(9, left, right, 0, k, here);
    }
    return left;
}

fn (mut self: Unit) parse_additive(src: String) -> Int allocates {
    let mut left: Int = self.parse_term(src);
    while left >= 0 && (self.at(25) || self.at(26)) {  // + -
        let here: Int = self.pos;
        let op: Int = self.kind_at(0);
        let n: Int = self.advance();
        let right: Int = self.parse_term(src);
        if right < 0 { return -1; }
        left = self.add(8, left, right, 0, op, here);
    }
    return left;
}

fn (mut self: Unit) parse_term(src: String) -> Int allocates {
    let mut left: Int = self.parse_unary(src);
    while left >= 0 && (self.at(27) || self.at(28)) {  // * /
        let here: Int = self.pos;
        let op: Int = self.kind_at(0);
        let n: Int = self.advance();
        let right: Int = self.parse_unary(src);
        if right < 0 { return -1; }
        left = self.add(8, left, right, 0, op, here);
    }
    return left;
}

fn (mut self: Unit) parse_unary(src: String) -> Int allocates {
    let here: Int = self.pos;
    if self.at(26) {                                 // -
        let n: Int = self.advance();
        let inner: Int = self.parse_unary(src);
        if inner < 0 { return -1; }
        return self.add(6, inner, 0, 0, 0, here);
    }
    if self.at(37) {                                 // !
        let n: Int = self.advance();
        let inner: Int = self.parse_unary(src);
        if inner < 0 { return -1; }
        return self.add(7, inner, 0, 0, 0, here);
    }
    return self.parse_postfix(src);
}

// `.field`, `.method(args)` and `[index]`, chained as far as they go.
fn (mut self: Unit) parse_postfix(src: String) -> Int allocates {
    let mut node: Int = self.parse_primary(src);
    while node >= 0 {
        if self.at(23) {                             // '.'
            let here: Int = self.pos;
            let n: Int = self.advance();
            if !self.at(1) {
                return self.complain(src, "a field or method name after `.`");
            }
            let name_tok: Int = self.pos;
            let m: Int = self.advance();
            if self.at(29) {                         // '(' — a method call
                let args: Int = self.parse_args(src);
                if args < 0 { return -1; }
                node = self.add(14, node, args, 0, 0, name_tok);
                continue;
            }
            node = self.add(11, node, 0, 0, 0, name_tok);
            continue;
        }
        if self.at(33) {                             // '['
            let here: Int = self.pos;
            let n: Int = self.advance();
            let index: Int = self.parse_expr(src);
            if index < 0 { return -1; }
            if !self.eat(src, 34, "`]` closing the index") { return -1; }
            node = self.add(12, node, index, 0, 0, here);
            continue;
        }
        break;
    }
    return node;
}

// An argument list. Returns a node holding (start, count) into `kids`.
fn (mut self: Unit) parse_args(src: String) -> Int allocates {
    let here: Int = self.pos;
    if !self.eat(src, 29, "`(`") { return -1; }
    // Collect the argument node indices locally first: parsing one appends its whole
    // subtree to `nodes`, but nothing to `kids`, so the indices stay contiguous.
    let base: Int = len(self.stack);
    let mut count: Int = 0;
    while !self.at(30) {                             // until ')'
        let arg: Int = self.parse_expr(src);
        if arg < 0 { return -1; }
        push(self.stack, arg);
        count = count + 1;
        if self.at(22) {                             // ','
            let n: Int = self.advance();
            continue;
        }
        break;
    }
    if !self.eat(src, 30, "`)` closing the arguments") { return -1; }
    let start: Int = self.commit(base);
    return self.add(15, start, count, 0, 0, here);
}

fn (mut self: Unit) parse_primary(src: String) -> Int allocates {
    let here: Int = self.pos;
    let k: Int = self.kind_at(0);
    if k == 2 {
        let value: Int = self.toks[self.pos].value;
        let n: Int = self.advance();
        return self.add(1, 0, 0, 0, value, here);
    }
    if k == 3 {
        let t: Tok = self.toks[self.pos];
        let n: Int = self.advance();
        // The unscaled integer and the scale, carried exactly as the lexer read them.
        return self.add(2, t.scale, 0, 0, t.value, here);
    }
    if k == 4 {
        let n: Int = self.advance();
        return self.add(3, 0, 0, 0, 0, here);
    }
    if k == 120 || k == 121 {                        // true / false
        let n: Int = self.advance();
        let truth: Int = 0;
        if k == 120 { return self.add(4, 0, 0, 0, 1, here); }
        return self.add(4, 0, 0, 0, 0, here);
    }
    if k == 29 {                                     // '(' grouping
        let n: Int = self.advance();
        let inner: Int = self.parse_expr(src);
        if inner < 0 { return -1; }
        if !self.eat(src, 30, "`)` closing the group") { return -1; }
        return inner;
    }
    if k == 33 {                                     // '[' — an array or slice literal
        let n: Int = self.advance();
        let base: Int = len(self.stack);
        let mut count: Int = 0;
        while !self.at(34) {                         // until ']'
            let item: Int = self.parse_expr(src);
            if item < 0 { return -1; }
            push(self.stack, item);
            count = count + 1;
            if self.at(22) {                         // ','
                let c: Int = self.advance();
                continue;
            }
            break;
        }
        if !self.eat(src, 34, "`]` closing the literal") { return -1; }
        let start: Int = self.commit(base);
        return self.add(17, start, count, 0, 0, here);
    }
    if k == 1 || k == 119 || (k >= 140 && k <= 145) {  // a name, `self`, or a type name
        let name_tok: Int = self.pos;
        let n: Int = self.advance();
        if self.at(29) {                             // a call
            let args: Int = self.parse_args(src);
            if args < 0 { return -1; }
            return self.add(13, args, 0, 0, 0, name_tok);
        }
        if self.at(31) && self.no_struct == 0 {      // `Name { field: value }`
            let m: Int = self.advance();
            let base: Int = len(self.stack);
            let mut count: Int = 0;
            while !self.at(32) {                     // until '}'
                if !self.at(1) {
                    return self.complain(src, "a field name");
                }
                let field_tok: Int = self.pos;
                let f: Int = self.advance();
                if !self.eat(src, 20, "`:` after the field name") { return -1; }
                let value: Int = self.parse_expr(src);
                if value < 0 { return -1; }
                // One kid per field: the value, with the field's token on the node.
                let pair: Int = self.add(18, value, 0, 0, 0, field_tok);
                push(self.stack, pair);
                count = count + 1;
                if self.at(22) {                     // ',' — trailing one allowed
                    let c: Int = self.advance();
                    continue;
                }
                break;
            }
            if !self.eat(src, 32, "`\}` closing the literal") { return -1; }
            let start: Int = self.commit(base);
            return self.add(19, start, count, 0, 0, name_tok);
        }
        return self.add(5, 0, 0, 0, 0, name_tok);
    }
    return self.complain(src, "an expression");
}

// ---- statements --------------------------------------------------------------
// A block: a node holding (start, count) into `kids`, like an argument list.
// Move the scratch stack's entries above `base` into `kids`, and answer where they
// landed. Every child list goes through here for one reason: a list built by pushing
// straight into `kids` is NOT contiguous, because parsing element two pushes element
// two's own children first. That is the defect this repairs — the scratch stack is a
// stack, so an inner list is committed and popped before an outer one continues, and
// the entries that remain above `base` are exactly this list's, in order.
fn (mut self: Unit) commit(base: Int) -> Int allocates {
    let start: Int = len(self.kids);
    let mut i: Int = base;
    while i < len(self.stack) {
        push(self.kids, self.stack[i]);
        i = i + 1;
    }
    let dropped: Int = truncate(self.stack, base);
    return start;
}

fn (mut self: Unit) parse_block(src: String) -> Int allocates {
    let here: Int = self.pos;
    if !self.eat(src, 31, "`\{` opening a block") { return -1; }
    let base: Int = len(self.stack);
    let mut count: Int = 0;
    while !self.at(32) && !self.done() {             // until '}'
        let stmt: Int = self.parse_stmt(src);
        if stmt < 0 { return -1; }
        push(self.stack, stmt);
        count = count + 1;
    }
    if !self.eat(src, 32, "`\}` closing a block") { return -1; }
    let start: Int = self.commit(base);
    return self.add(16, start, count, 0, 0, here);
}
fn (mut self: Unit) parse_stmt(src: String) -> Int allocates {
    let here: Int = self.pos;
    let k: Int = self.kind_at(0);

    if k == 100 {                                    // let
        let n: Int = self.advance();
        let mut mutable: Int = 0;
        if self.at(101) {                            // mut
            mutable = 1;
            let m: Int = self.advance();
        }
        if !self.at(1) { return self.complain(src, "a name after `let`"); }
        let name_tok: Int = self.pos;
        let m2: Int = self.advance();
        if !self.eat(src, 20, "`:` and a type — every `let` declares one") { return -1; }
        let ty: Int = self.parse_type(src);
        if ty < 0 { return -1; }
        if !self.eat(src, 24, "`=` and an initial value") { return -1; }
        let value: Int = self.parse_expr(src);
        if value < 0 { return -1; }
        if !self.eat(src, 21, "`;`") { return -1; }
        return self.add(60, ty, value, 0, mutable, name_tok);
    }
    if k == 118 {                                    // print
        let n: Int = self.advance();
        if !self.eat(src, 29, "`(` after `print`") { return -1; }
        let value: Int = self.parse_expr(src);
        if value < 0 { return -1; }
        if !self.eat(src, 30, "`)`") { return -1; }
        if !self.eat(src, 21, "`;`") { return -1; }
        return self.add(62, value, 0, 0, 0, here);
    }
    if k == 103 {                                    // return
        let n: Int = self.advance();
        let mut kind: Int = 63;
        if self.at(123) {                            // tail
            kind = 64;
            let m: Int = self.advance();
        }
        let value: Int = self.parse_expr(src);
        if value < 0 { return -1; }
        if !self.eat(src, 21, "`;`") { return -1; }
        return self.add(kind, value, 0, 0, 0, here);
    }
    if k == 104 {                                    // if
        let n: Int = self.advance();
        self.no_struct = self.no_struct + 1;
        let cond: Int = self.parse_expr(src);
        self.no_struct = self.no_struct - 1;
        if cond < 0 { return -1; }
        let then_block: Int = self.parse_block(src);
        if then_block < 0 { return -1; }
        let mut else_block: Int = -1;
        if self.at(105) {                            // else
            let m: Int = self.advance();
            if self.at(104) {
                // `else if` is an else-block holding one if-statement.
                else_block = self.parse_stmt(src);
            } else {
                else_block = self.parse_block(src);
            }
            if else_block < 0 { return -1; }
        }
        return self.add(65, cond, then_block, else_block, 0, here);
    }
    if k == 106 {                                    // while
        let n: Int = self.advance();
        self.no_struct = self.no_struct + 1;
        let cond: Int = self.parse_expr(src);
        self.no_struct = self.no_struct - 1;
        if cond < 0 { return -1; }
        let body: Int = self.parse_block(src);
        if body < 0 { return -1; }
        return self.add(66, cond, body, 0, 0, here);
    }
    if k == 107 {                                    // break
        let n: Int = self.advance();
        if !self.eat(src, 21, "`;`") { return -1; }
        return self.add(67, 0, 0, 0, 0, here);
    }
    if k == 108 {                                    // continue
        let n: Int = self.advance();
        if !self.eat(src, 21, "`;`") { return -1; }
        return self.add(68, 0, 0, 0, 0, here);
    }
    if k == 111 {                                    // match
        let n: Int = self.advance();
        self.no_struct = self.no_struct + 1;
        let value: Int = self.parse_expr(src);
        self.no_struct = self.no_struct - 1;
        if value < 0 { return -1; }
        if !self.eat(src, 31, "`\{` opening the arms") { return -1; }
        let base: Int = len(self.stack);
        let mut count: Int = 0;
        while !self.at(32) && !self.done() {         // until '}'
            // `Variant => { ... }` or `Variant(a, b) => { ... }`. Every arm names a
            // variant: there is no wildcard, on purpose.
            if !self.at(1) {
                return self.complain(src, "a variant name — Burxt has no `_` arm");
            }
            let variant_tok: Int = self.pos;
            let v: Int = self.advance();
            let bind_start: Int = len(self.subs);
            let mut binds: Int = 0;
            if self.at(29) {                         // '(' bindings
                let p: Int = self.advance();
                while !self.at(30) {
                    if !self.at(1) {
                        return self.complain(src, "a name to bind the payload to");
                    }
                    push(self.subs, self.pos);
                    binds = binds + 1;
                    let b: Int = self.advance();
                    if self.at(22) {
                        let c: Int = self.advance();
                        continue;
                    }
                    break;
                }
                if !self.eat(src, 30, "`)` closing the bindings") { return -1; }
            }
            if !self.eat(src, 11, "`=>` after the variant") { return -1; }
            let body: Int = self.parse_block(src);
            if body < 0 { return -1; }
            let arm: Int = self.add(20, body, bind_start, binds, 0, variant_tok);
            push(self.stack, arm);
            count = count + 1;
        }
        if !self.eat(src, 32, "`\}` closing the arms") { return -1; }
        let start: Int = self.commit(base);
        return self.add(71, value, start, count, 0, here);
    }
    if k == 117 {                                    // region
        let n: Int = self.advance();
        if !self.at(1) { return self.complain(src, "a name for the region"); }
        let name_tok: Int = self.pos;
        let m: Int = self.advance();
        let body: Int = self.parse_block(src);
        if body < 0 { return -1; }
        return self.add(69, body, 0, 0, 0, name_tok);
    }

    // Anything else starts with an expression: an assignment or a call kept for its
    // effect. Parse the expression first and let what follows decide which.
    let target: Int = self.parse_expr(src);
    if target < 0 { return -1; }
    if self.at(24) {                                 // '='
        let n: Int = self.advance();
        let value: Int = self.parse_expr(src);
        if value < 0 { return -1; }
        if !self.eat(src, 21, "`;`") { return -1; }
        return self.add(61, target, value, 0, 0, here);
    }
    if !self.eat(src, 21, "`;`") { return -1; }
    return self.add(70, target, 0, 0, 0, here);
}


// ============================================================================
// PHASE 3b: items. fn, struct, enum, trait, impl, extern — with the markers and
// contract clauses that make a Burxt signature say what it promises.
// ============================================================================
//   80 fn        81 method    82 struct   83 enum   84 trait   85 impl   86 extern
//   90 parameter (type in `a`, marshalled in `value`, name token on the node)
//   91 field     92 variant (payload list in (b, c))
//   93 contract clause (expression in `a`, which clause in `value`)

// A parameter list: `(name: Type, name: Type as scaled)`. Returns (start, count).
fn (mut self: Unit) parse_params(src: String) -> Int allocates {
    let here: Int = self.pos;
    if !self.eat(src, 29, "`(` opening the parameters") { return -1; }
    let base: Int = len(self.stack);
    let mut count: Int = 0;
    while !self.at(30) {                             // until ')'
        if !self.at(1) {
            return self.complain(src, "a parameter name");
        }
        let name_tok: Int = self.pos;
        let n: Int = self.advance();
        if !self.eat(src, 20, "`:` and the parameter's type") { return -1; }
        let ty: Int = self.parse_type(src);
        if ty < 0 { return -1; }
        // `amount: Decimal<2> as scaled` — a boundary marshaller.
        let mut marshalled: Int = 0;
        if self.at(122) {                            // as
            let a: Int = self.advance();
            if !self.at(1) {
                return self.complain(src, "a marshaller name, e.g. `scaled`");
            }
            marshalled = 1;
            let m: Int = self.advance();
        }
        let param: Int = self.add(90, ty, 0, 0, marshalled, name_tok);
        push(self.stack, param);
        count = count + 1;
        if self.at(22) {                             // ','
            let c: Int = self.advance();
            continue;
        }
        break;
    }
    if !self.eat(src, 30, "`)` closing the parameters") { return -1; }
    let start: Int = self.commit(base);
    return self.add(15, start, count, 0, 0, here);
}

// `requires`, `ensures` and `decreases`, between the signature and the body.
// `ret` and `receiver_tok` ride in the clause node's two spare slots. A method item
// has five slots and six things to say, and this is the one that costs nothing: the
// clause node exists for every function whether it has clauses or not.
fn (mut self: Unit) parse_clauses(src: String, ret: Int, receiver_tok: Int) -> Int allocates {
    let here: Int = self.pos;
    let base: Int = len(self.stack);
    let mut count: Int = 0;
    while self.at_word(src, "requires") || self.at_word(src, "ensures")
          || self.at_word(src, "decreases") {
        // Which clause, decided before the word is consumed.
        let mut which: Int = 126;
        if self.at_word(src, "ensures") { which = 127; }
        if self.at_word(src, "decreases") { which = 128; }
        let n: Int = self.advance();
        // A clause is a condition, so a `{` after it opens the BODY.
        self.no_struct = self.no_struct + 1;
        let cond: Int = self.parse_expr(src);
        self.no_struct = self.no_struct - 1;
        if cond < 0 { return -1; }
        let clause: Int = self.add(93, cond, 0, 0, which, here);
        push(self.stack, clause);
        count = count + 1;
    }
    let start: Int = self.commit(base);
    return self.add(15, start, count, ret, receiver_tok, here);
}

// `fn name(params) -> Type [allocates] [clauses] { body }`, or a method when a
// receiver clause follows `fn`. `pure` precedes the whole thing.
fn (mut self: Unit) parse_fn(src: String, is_pure: Int) -> Int allocates {
    let here: Int = self.pos;
    if !self.eat(src, 102, "`fn`") { return -1; }

    // `fn (self: T) name(...)` and `fn (mut self: T) name(...)` are methods: the
    // `(` right after `fn` is the tell, exactly as in the Rust parser.
    let mut receiver_tok: Int = -1;
    let mut receiver_mut: Int = 0;
    if self.at(29) {
        let n: Int = self.advance();
        if self.at(101) {                            // mut
            receiver_mut = 1;
            let m: Int = self.advance();
        }
        if !self.eat(src, 119, "`self` in the receiver clause") { return -1; }
        if !self.eat(src, 20, "`:` and the receiver's type") { return -1; }
        if !self.at(1) {
            return self.complain(src, "a struct name after `self:`");
        }
        receiver_tok = self.pos;
        let r: Int = self.advance();
        if !self.eat(src, 30, "`)` closing the receiver clause") { return -1; }
    }

    if !self.at(1) {
        return self.complain(src, "a function name");
    }
    let name_tok: Int = self.pos;
    let n2: Int = self.advance();
    let params: Int = self.parse_params(src);
    if params < 0 { return -1; }
    if !self.eat(src, 10, "`->` and a return type — every Burxt function returns one") {
        return -1;
    }
    let ret: Int = self.parse_type(src);
    if ret < 0 { return -1; }
    let mut builds_in_caller: Int = 0;
    if self.at_word(src, "allocates") {              // contextual: only here does the
        builds_in_caller = 1;                        // word mean the marker.
        let a: Int = self.advance();
    }
    let clauses: Int = self.parse_clauses(src, ret, receiver_tok);
    if clauses < 0 { return -1; }
    let body: Int = self.parse_block(src);
    if body < 0 { return -1; }

    // The markers ride in `value` as bits: pure, allocates, mutating receiver.
    let mut flags: Int = 0;
    if is_pure == 1 { flags = flags + 1; }
    if builds_in_caller == 1 { flags = flags + 2; }
    if receiver_mut == 1 { flags = flags + 4; }
    if receiver_tok >= 0 {
        // A method: `c` is the clause node, which holds the receiver and the return
        // type both, so a method item has the same shape a function's does.
        let m: Int = self.add(81, params, body, clauses, flags, name_tok);
        return m;
    }
    let f: Int = self.add(80, params, body, clauses, flags, name_tok);
    return f;
}

// `struct Name { field: Type, ... }`
fn (mut self: Unit) parse_struct(src: String) -> Int allocates {
    if !self.eat(src, 109, "`struct`") { return -1; }
    if !self.at(1) { return self.complain(src, "a struct name"); }
    let name_tok: Int = self.pos;
    let n: Int = self.advance();
    if !self.eat(src, 31, "`\{` opening the fields") { return -1; }
    let base: Int = len(self.stack);
    let mut count: Int = 0;
    while !self.at(32) && !self.done() {
        if !self.at(1) { return self.complain(src, "a field name"); }
        let field_tok: Int = self.pos;
        let f: Int = self.advance();
        if !self.eat(src, 20, "`:` and the field's type") { return -1; }
        let ty: Int = self.parse_type(src);
        if ty < 0 { return -1; }
        let field: Int = self.add(91, ty, 0, 0, 0, field_tok);
        push(self.stack, field);
        count = count + 1;
        if self.at(22) {
            let c: Int = self.advance();
            continue;
        }
        break;
    }
    if !self.eat(src, 32, "`\}` closing the fields") { return -1; }
    let start: Int = self.commit(base);
    return self.add(82, start, count, 0, 0, name_tok);
}

// `enum Name { Variant, Variant(Type, Type), ... }`
fn (mut self: Unit) parse_enum(src: String) -> Int allocates {
    if !self.eat(src, 110, "`enum`") { return -1; }
    if !self.at(1) { return self.complain(src, "an enum name"); }
    let name_tok: Int = self.pos;
    let n: Int = self.advance();
    if !self.eat(src, 31, "`\{` opening the variants") { return -1; }
    let base: Int = len(self.stack);
    let mut count: Int = 0;
    while !self.at(32) && !self.done() {
        if !self.at(1) { return self.complain(src, "a variant name"); }
        let variant_tok: Int = self.pos;
        let v: Int = self.advance();
        let payload_start: Int = len(self.subs);
        let mut payload: Int = 0;
        if self.at(29) {                             // '(' — a payload
            let p: Int = self.advance();
            while !self.at(30) {
                let ty: Int = self.parse_type(src);
                if ty < 0 { return -1; }
                push(self.subs, ty);
                payload = payload + 1;
                if self.at(22) {
                    let c: Int = self.advance();
                    continue;
                }
                break;
            }
            if !self.eat(src, 30, "`)` closing the payload") { return -1; }
        }
        let variant: Int = self.add(92, 0, payload_start, payload, 0, variant_tok);
        push(self.stack, variant);
        count = count + 1;
        if self.at(22) {
            let c: Int = self.advance();
            continue;
        }
        break;
    }
    if !self.eat(src, 32, "`\}` closing the variants") { return -1; }
    let start: Int = self.commit(base);
    return self.add(83, start, count, 0, 0, name_tok);
}

// `trait Name { fn sig(self) -> Type }` — signatures only, no bodies.
fn (mut self: Unit) parse_trait(src: String) -> Int allocates {
    if !self.eat(src, 112, "`trait`") { return -1; }
    if !self.at(1) { return self.complain(src, "a trait name"); }
    let name_tok: Int = self.pos;
    let n: Int = self.advance();
    if !self.eat(src, 31, "`\{` opening the trait") { return -1; }
    let base: Int = len(self.stack);
    let mut count: Int = 0;
    while !self.at(32) && !self.done() {
        if !self.eat(src, 102, "`fn` — a trait holds signatures") { return -1; }
        if !self.at(1) { return self.complain(src, "a method name"); }
        let method_tok: Int = self.pos;
        let m: Int = self.advance();
        if !self.eat(src, 29, "`(` and a receiver") { return -1; }
        let mut receiver_mut: Int = 0;
        if self.at(101) {
            receiver_mut = 1;
            let mu: Int = self.advance();
        }
        if !self.eat(src, 119, "`self`") { return -1; }
        // A trait signature may take parameters after `self`.
        let extra_start: Int = len(self.subs);
        let mut extra: Int = 0;
        while self.at(22) {                          // ',' more parameters
            let c: Int = self.advance();
            if !self.at(1) { return self.complain(src, "a parameter name"); }
            let pname: Int = self.pos;
            let pn: Int = self.advance();
            if !self.eat(src, 20, "`:` and the parameter's type") { return -1; }
            let ty: Int = self.parse_type(src);
            if ty < 0 { return -1; }
            let param: Int = self.add(90, ty, 0, 0, 0, pname);
            push(self.subs, param);
            extra = extra + 1;
        }
        if !self.eat(src, 30, "`)`") { return -1; }
        if !self.eat(src, 10, "`->` and a return type") { return -1; }
        let ret: Int = self.parse_type(src);
        if ret < 0 { return -1; }
        let sig: Int = self.add(94, ret, extra_start, extra, receiver_mut, method_tok);
        push(self.stack, sig);
        count = count + 1;
    }
    if !self.eat(src, 32, "`\}` closing the trait") { return -1; }
    let start: Int = self.commit(base);
    return self.add(84, start, count, 0, 0, name_tok);
}

// `impl Trait for Type { methods }`
fn (mut self: Unit) parse_impl(src: String) -> Int allocates {
    if !self.eat(src, 113, "`impl`") { return -1; }
    if !self.at(1) { return self.complain(src, "a trait name"); }
    let trait_tok: Int = self.pos;
    let t: Int = self.advance();
    if !self.eat(src, 114, "`for`") { return -1; }
    if !self.at(1) { return self.complain(src, "the type implementing the trait"); }
    let type_tok: Int = self.pos;
    let ty: Int = self.advance();
    if !self.eat(src, 31, "`\{` opening the impl") { return -1; }
    let base: Int = len(self.stack);
    let mut count: Int = 0;
    while !self.at(32) && !self.done() {
        let method: Int = self.parse_fn(src, 0);
        if method < 0 { return -1; }
        push(self.stack, method);
        count = count + 1;
    }
    if !self.eat(src, 32, "`\}` closing the impl") { return -1; }
    let start: Int = self.commit(base);
    return self.add(85, start, count, type_tok, 0, trait_tok);
}

// `extern fn name(params) -> Type;` — no body, and none allowed.
fn (mut self: Unit) parse_extern(src: String) -> Int allocates {
    if !self.eat(src, 116, "`extern`") { return -1; }
    if !self.eat(src, 102, "`fn` after `extern`") { return -1; }
    if !self.at(1) { return self.complain(src, "a function name"); }
    let name_tok: Int = self.pos;
    let n: Int = self.advance();
    let params: Int = self.parse_params(src);
    if params < 0 { return -1; }
    if !self.eat(src, 10, "`->` and a return type") { return -1; }
    let ret: Int = self.parse_type(src);
    if ret < 0 { return -1; }
    if !self.eat(src, 21, "`;` — an extern declaration has no body") { return -1; }
    return self.add(86, params, ret, 0, 0, name_tok);
}

// One item, or a top-level statement: the same dispatch the Rust parser makes.
fn (mut self: Unit) parse_item(src: String) -> Int allocates {
    let k: Int = self.kind_at(0);
    if k == 124 {                                    // pure fn
        let n: Int = self.advance();
        return self.parse_fn(src, 1);
    }
    if k == 102 { return self.parse_fn(src, 0); }
    if k == 109 { return self.parse_struct(src); }
    if k == 110 { return self.parse_enum(src); }
    if k == 112 { return self.parse_trait(src); }
    if k == 113 { return self.parse_impl(src); }
    if k == 116 { return self.parse_extern(src); }
    return self.parse_stmt(src);
}

// Step over an item without reading it: phase 3b parses these, and until then the
// driver must not mistake a function body for top-level code.
fn (mut self: Unit) skip_item() -> Int {
    let mut braces: Int = 0;
    let mut nesting: Int = 0;
    let mut seen_brace: Bool = false;
    while !self.done() {
        let k: Int = self.kind_at(0);
        if k == 31 {
            braces = braces + 1;
            seen_brace = true;
        }
        if k == 32 { braces = braces - 1; }
        // Parentheses and brackets are counted too, and the reason is a bug this
        // caught: `fn f(xs: [Int; 3])` contains a SEMICOLON, inside the array type.
        // Treating any semicolon as the end of a bodyless `extern` declaration
        // stopped the skip in the middle of a signature.
        if k == 29 || k == 33 { nesting = nesting + 1; }
        if k == 30 || k == 34 { nesting = nesting - 1; }
        let n: Int = self.advance();
        if seen_brace && braces == 0 {
            break;
        }
        if !seen_brace && k == 21 && nesting == 0 {
            break;
        }
    }
    return self.pos;
}


// ============================================================================
// PHASE 4: the typechecker. Types in, refusals out — the same rules the Rust
// compiler enforces, applied to the AST the parser just built.
// ============================================================================

fn ty_unknown() -> Ty {
    return Ty { kind: 0, scale: 0, contract: 0, name_start: 0, name_len: 0 };
}

fn ty_simple(kind: Int) -> Ty {
    return Ty { kind: kind, scale: 0, contract: 0, name_start: 0, name_len: 0 };
}

// C's widths as Burxt sees them at the boundary. See N1-BOUNDARY-EXACTNESS: the
// exactness rule lives in `as scaled`, and the widths themselves are C's business.
fn as_burxt_sees(t: Ty) -> Ty {
    if t.kind == 43 || t.kind == 44 {
        return ty_simple(40);
    }
    return t;
}

fn ty_decimal(scale: Int, contract: Int) -> Ty {
    return Ty { kind: 45, scale: scale, contract: contract, name_start: 0, name_len: 0 };
}

// An unknown type never equals anything, including another unknown: one bad
// expression must not make every later comparison succeed. The stage-1 checker in
// examples/checker.bx learned this the hard way, and so did stage-0's recovery.
fn is_unknown(t: Ty) -> Bool {
    return t.kind == 0;
}

// A trait implementation: a pair of names, which is all `dyn` dispatch needs to know.
// The method table already knows what the type can do.
struct Impl { trait_start: Int, trait_len: Int, type_start: Int, type_len: Int }

struct Typed { node: Int, ty: Ty }

fn ty_same(src: String, a: Ty, b: Ty) -> Bool {
    if a.kind == 0 || b.kind == 0 {
        return false;
    }
    if a.kind != b.kind {
        return false;
    }
    if a.kind == 45 {
        // The rounding contract is part of the type, so it is part of equality.
        return a.scale == b.scale && a.contract == b.contract;
    }
    if a.kind == 46 || a.kind == 49 {
        return spans_eq(src, a.name_start, a.name_len, b.name_start, b.name_len);
    }
    return true;
}

fn ty_show(src: String, t: Ty) -> String allocates {
    if t.kind == 0 { return "?"; }
    if t.kind == 40 { return "Int"; }
    if t.kind == 41 { return "Bool"; }
    if t.kind == 42 { return "String"; }
    if t.kind == 43 { return "CInt"; }
    if t.kind == 44 { return "CDouble"; }
    if t.kind == 45 {
        if t.contract == 1 {
            return "Decimal<" + to_string(t.scale) + ", RoundHalfEven>";
        }
        if t.contract == 2 {
            return "Decimal<" + to_string(t.scale) + ", RoundHalfUp>";
        }
        return "Decimal<" + to_string(t.scale) + ">";
    }
    if t.kind == 47 { return "a growable array"; }
    if t.kind == 48 { return "an array"; }
    if t.kind == 49 { return "dyn " + substring(src, t.name_start, t.name_len); }
    return substring(src, t.name_start, t.name_len);
}

// Read a type NODE into a Ty.
fn (self: Unit) ty_of(src: String, node: Int) -> Ty {
    if node < 0 {
        return ty_unknown();
    }
    let n: Node = self.nodes[node];
    if n.kind == 45 {
        return ty_decimal(n.a, n.b);
    }
    if n.kind == 46 || n.kind == 49 {
        let t: Tok = self.toks[n.tok];
        return Ty { kind: n.kind, scale: 0, contract: 0,
                    name_start: t.start, name_len: t.length };
    }
    if n.kind == 47 || n.kind == 48 {
        // `scale` holds the ELEMENT type's node for a slice or an array, and
        // `contract` the declared length. Reusing two fields rather than widening a
        // struct that is copied at every comparison in the checker.
        return Ty { kind: n.kind, scale: n.a, contract: n.b,
                    name_start: 0, name_len: 0 };
    }
    if n.kind >= 40 && n.kind <= 48 {
        return ty_simple(n.kind);
    }
    return ty_unknown();
}

fn (mut self: Unit) complain_at(src: String, tok: Int, message: String) -> Int allocates {
    let t: Tok = self.toks[tok];
    print("error: " + message + " (at `" + substring(src, t.start, t.length) + "`)");
    self.problems = self.problems + 1;
    return 0;
}

// ---- declarations ------------------------------------------------------------
fn (self: Unit) find_sym(src: String, start: Int, length: Int) -> Int {
    // Backwards: the innermost binding with this name is the one in scope.
    let mut i: Int = len(self.syms) - 1;
    while i >= 0 {
        if spans_eq(src, self.syms[i].start, self.syms[i].length, start, length) {
            return i;
        }
        i = i - 1;
    }
    return -1;
}

fn (self: Unit) find_fun(src: String, start: Int, length: Int) -> Int {
    let mut i: Int = 0;
    while i < len(self.funs) {
        if spans_eq(src, self.funs[i].start, self.funs[i].length, start, length) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn (self: Unit) find_type(src: String, start: Int, length: Int) -> Int {
    let mut i: Int = 0;
    while i < len(self.types) {
        if spans_eq(src, self.types[i].start, self.types[i].length, start, length) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// Every signature first, so functions may be declared in any order and call each
// other — the same two-pass shape stage-0 uses.
// The names a program may not take: the builtins, `old`, and the two the runtime
// owns. Stage-0 refuses these because a call site cannot tell a shadowed builtin from
// the builtin, and a reader cannot either.
fn is_reserved_name(src: String, start: Int, length: Int) -> Bool {
    return span_eq(src, start, length, "print")
        || span_eq(src, start, length, "len")
        || span_eq(src, start, length, "byte_at")
        || span_eq(src, start, length, "push")
        || span_eq(src, start, length, "truncate")
        || span_eq(src, start, length, "substring")
        || span_eq(src, start, length, "to_string")
        || span_eq(src, start, length, "read_file")
        || span_eq(src, start, length, "write_file")
        || span_eq(src, start, length, "arg")
        || span_eq(src, start, length, "arg_count")
        || span_eq(src, start, length, "div_floor")
        || span_eq(src, start, length, "div_trunc")
        || span_eq(src, start, length, "rem")
        || span_eq(src, start, length, "old")
        || span_eq(src, start, length, "result")
        || span_eq(src, start, length, "main")
        || span_eq(src, start, length, "exit");
}

fn (mut self: Unit) collect_method(src: String, index: Int) -> Int allocates {
    let item: Node = self.nodes[index];
    let name: Tok = self.toks[item.tok];
    let signature: Node = self.nodes[item.c];
    let receiver: Tok = self.toks[signature.value];
    let mut mutating: Int = 0;
    if item.value >= 4 { mutating = 1; }
    if flag_pure(item.value) == 1 {
        let e: Int = self.complain_at(src, item.tok,
            "`pure` is not available on a method: a receiver is state, and a claim "
            + "about a function of its arguments cannot be made about one");
    }
    if self.find_method_named(src, receiver.start, receiver.length,
                              name.start, name.length) >= 0 {
        let e: Int = self.complain_at(src, item.tok, "this method is declared twice");
        return 0;
    }
    push(self.methods, Method {
        receiver_start: receiver.start, receiver_len: receiver.length,
        start: name.start, length: name.length,
        ret: self.ty_of(src, signature.c), params: item.a,
        mutating: mutating, flags: item.value,
    });
    return 1;
}

fn (mut self: Unit) collect_declarations(src: String) -> Int allocates {
    let mut i: Int = 0;
    while i < len(self.items) {
        let index: Int = self.items[i];
        let item: Node = self.nodes[index];
        let name: Tok = self.toks[item.tok];
        if item.kind == 83 {
            if item.b == 0 {
                let e: Int = self.complain_at(src, item.tok,
                    "an enum with no variants describes nothing, and no value of it "
                    + "could ever be made");
            }
            let mut v: Int = 0;
            while v < item.b {
                let variant: Node = self.nodes[self.kids[item.a + v]];
                let named: Tok = self.toks[variant.tok];
                let mut w: Int = v + 1;
                while w < item.b {
                    let other: Node = self.nodes[self.kids[item.a + w]];
                    let other_name: Tok = self.toks[other.tok];
                    if spans_eq(src, named.start, named.length,
                                other_name.start, other_name.length) {
                        let e: Int = self.complain_at(src, other.tok,
                            "this variant is declared twice");
                    }
                    w = w + 1;
                }
                v = v + 1;
            }
        }
        if item.kind == 82 {                         // struct: fields
            let mut f: Int = 0;
            while f < item.b {
                let field: Node = self.nodes[self.kids[item.a + f]];
                let shaped: Int = self.check_type_shape(src, field.a, field.tok);
                let held: Node = self.nodes[field.a];
                if held.kind == 46 {
                    let held_name: Tok = self.toks[held.tok];
                    if spans_eq(src, held_name.start, held_name.length,
                                name.start, name.length) {
                        // By value, always: a struct that contains itself has no size.
                        let e: Int = self.complain_at(src, field.tok,
                            "a struct cannot contain itself: its size would have to be "
                            + "bigger than itself");
                    }
                }
                f = f + 1;
            }
        }
        if item.kind == 83 {                         // enum: payloads
            let mut v: Int = 0;
            while v < item.b {
                let variant: Node = self.nodes[self.kids[item.a + v]];
                let mut p: Int = 0;
                while p < variant.c {
                    let payload: Int = self.subs[variant.b + p];
                    let shaped: Int = self.check_type_shape(src, payload, variant.tok);
                    let held: Node = self.nodes[payload];
                    if held.kind == 46 {
                        let held_name: Tok = self.toks[held.tok];
                        if spans_eq(src, held_name.start, held_name.length,
                                    name.start, name.length) {
                            let e: Int = self.complain_at(src, variant.tok,
                                "an enum cannot carry itself: its size would have to be "
                                + "bigger than itself");
                        }
                        let inner: Int = self.find_type(src, held_name.start, held_name.length);
                        if inner >= 0 {
                            if self.types[inner].kind == 82 {
                                let e: Int = self.complain_at(src, variant.tok,
                                    "a variant carries a scalar or a String for now: an "
                                    + "aggregate payload needs a layout rule that is not "
                                    + "written");
                            }
                        }
                    }
                    p = p + 1;
                }
                v = v + 1;
            }
        }
        if item.kind == 82 || item.kind == 83 {
            if self.find_type(src, name.start, name.length) >= 0 {
                let e: Int = self.complain_at(src, item.tok, "this type is declared twice");
            } else {
                push(self.types, TypeDecl { start: name.start, length: name.length,
                                            kind: item.kind, node: index });
            }
        }
        if item.kind == 81 {                         // a method
            let m: Int = self.collect_method(src, index);
        }
        if item.kind == 84 {                         // trait
            push(self.types, TypeDecl { start: name.start, length: name.length,
                                        kind: item.kind, node: index });
        }
        if item.kind == 85 {                         // impl Trait for Type { ... }
            let target: Tok = self.toks[item.c];
            push(self.impls, Impl { trait_start: name.start, trait_len: name.length,
                                    type_start: target.start, type_len: target.length });
            // The methods inside an impl are declared exactly as free-standing ones
            // are, so they are collected by the same code rather than by a copy of it.
            let mut k: Int = 0;
            while k < item.b {
                let m: Int = self.collect_method(src, self.kids[item.a + k]);
                k = k + 1;
            }
        }
        if item.kind == 80 || item.kind == 86 {
            if is_reserved_name(src, name.start, name.length) {
                let e: Int = self.complain_at(src, item.tok,
                    "`" + substring(src, name.start, name.length) + "` is a name the "
                    + "language owns, so a program may not declare it");
            }
            if self.find_fun(src, name.start, name.length) >= 0 {
                let e: Int = self.complain_at(src, item.tok, "this function is declared twice");
            } else {
                let mut ret: Ty = ty_unknown();
                if item.kind == 80 {
                    let signature: Node = self.nodes[item.c];
                    ret = self.ty_of(src, signature.c);
                } else {
                    ret = self.ty_of(src, item.b);   // an extern holds it directly
                    // CInt and CDouble are C's widths, not Burxt types: a Burxt caller
                    // passes and receives an Int. So an extern's signature is recorded
                    // as Burxt sees it, which is why `strcmp(a, b) < 0` compares two
                    // Ints rather than mixing a CInt with one.
                    ret = as_burxt_sees(ret);
                }
                let mut flags: Int = item.value;
                if item.kind == 86 { flags = 8; }    // the extern marker
                push(self.funs, Fun { start: name.start, length: name.length,
                                      ret: ret, params: item.a, flags: flags });
            }
        }
        i = i + 1;
    }
    return len(self.funs);
}

// ---- expressions -------------------------------------------------------------
// `expected` carries the declared type inward, which is how a Decimal product can
// know whether a rounding contract was supplied — exactly as in stage-0.
// Every expression's type, recorded as it is decided. The escape check asks about
// expressions the checker has already seen — whether a `+` joined two Strings, say —
// and re-walking them would report every complaint a second time.
fn (mut self: Unit) type_of(src: String, node: Int, expected: Ty) -> Ty allocates {
    let t: Ty = self.type_of_inner(src, node, expected);
    push(self.typed, Typed { node: node, ty: t });
    return t;
}

fn (self: Unit) type_at(node: Int) -> Ty {
    // Backwards: the last answer for a node is the one that stands, since a retyped
    // operand (multiplication does that) settles on its second reading.
    let mut i: Int = len(self.typed) - 1;
    while i >= 0 {
        let entry: Typed = self.typed[i];
        if entry.node == node {
            return entry.ty;
        }
        i = i - 1;
    }
    return ty_unknown();
}

fn (mut self: Unit) type_of_inner(src: String, node: Int, expected: Ty) -> Ty allocates {
    if node < 0 {
        return ty_unknown();
    }
    let n: Node = self.nodes[node];

    if n.kind == 1 { return ty_simple(40); }
    if n.kind == 2 {                                 // a decimal, money or percent
        if expected.kind != 45 {
            return ty_decimal(n.a, 0);
        }
        if expected.scale >= n.a {
            // Widening a literal is exact: $5 in a Decimal<2> context is 5.00. The
            // contract comes from the context too, and never rounds the literal —
            // a literal that needed rounding would be refused below.
            return ty_decimal(expected.scale, expected.contract);
        }
        // Narrowing: allowed only when every digit dropped is a zero.
        let mut factor: Int = 1;
        let mut drop: Int = n.a - expected.scale;
        while drop > 0 {
            factor = factor * 10;
            drop = drop - 1;
        }
        if rem(n.value, factor) == 0 {
            return ty_decimal(expected.scale, expected.contract);
        }
        if self.in_mul == 1 {
            return ty_decimal(n.a, 0);
        }
        let e: Int = self.complain_at(src, n.tok,
            "this literal needs " + to_string(n.a) + " decimal places but the context "
            + "has only " + to_string(expected.scale) + ", and dropping digits from "
            + "money is refused");
        return ty_unknown();
    }
    if n.kind == 3 {                                 // a String literal
        let t: Tok = self.toks[n.tok];
        // Interpolation IS `to_string` plus `+`, so it needs what those need. Stage-1
        // does not split the fragments yet, so any interpolated literal counts as a
        // join — which errs toward asking for a region, never toward allowing one out.
        if t.interpolated {
            if !self.has_region() {
                let r: Int = self.needs_region(src, n.tok, "this interpolated String");
            }
        }
        return ty_simple(42);
    }
    if n.kind == 4 { return ty_simple(41); }

    if n.kind == 5 {                                 // a name
        let t: Tok = self.toks[n.tok];
        let found: Int = self.find_sym(src, t.start, t.length);
        if found < 0 {
            let e: Int = self.complain_at(src, n.tok, "unknown name");
            return ty_unknown();
        }
        return self.syms[found].ty;
    }

    if n.kind == 6 {                                 // -x
        return self.type_of(src, n.a, expected);
    }
    if n.kind == 7 {                                 // !x
        let inner: Ty = self.type_of(src, n.a, ty_simple(41));
        if !is_unknown(inner) && inner.kind != 41 {
            let e: Int = self.complain_at(src, n.tok,
                "`!` needs a Bool, but this is " + ty_show(src, inner));
        }
        return ty_simple(41);
    }

    if n.kind == 8 {                                 // a + b, a * b
        let outer: Int = self.in_mul;
        if n.value == 27 { self.in_mul = 1; }
        let left: Ty = self.type_of(src, n.a, expected);
        let right: Ty = self.type_of(src, n.b, expected);
        self.in_mul = outer;
        if is_unknown(left) || is_unknown(right) {
            return ty_unknown();
        }
        // `*` combines a quantity with a rate, so the scales may differ — but the
        // product's scale is their SUM, and landing it needs a declared contract.
        if n.value == 27 {
            if left.kind == 45 && right.kind == 45 {
                if ty_same(src, left, right) {
                    // Identical operand types: their own contract lands the product,
                    // so the context does not have to repeat it.
                    if left.contract == 0 {
                        let e: Int = self.complain_at(src, n.tok,
                            "`*` on " + ty_show(src, left) + " and " + ty_show(src, right)
                            + " needs a rounding contract: the exact product has "
                            + to_string(left.scale + right.scale) + " decimal places");
                        return ty_unknown();
                    }
                    return left;
                }
                if expected.contract == 0 {
                    let e: Int = self.complain_at(src, n.tok,
                        "`*` on " + ty_show(src, left) + " and " + ty_show(src, right)
                        + " needs a rounding contract: the exact product has "
                        + to_string(left.scale + right.scale) + " decimal places");
                    return ty_unknown();
                }
                return expected;
            }
            if left.kind == 45 && right.kind == 40 { return left; }
            if left.kind == 40 && right.kind == 45 { return right; }
        }
        if n.value == 28 {                           // `/`
            if left.kind == 40 && right.kind == 40 {
                let e: Int = self.complain_at(src, n.tok,
                    "`/` on two Ints would have to round, and one operator cannot say "
                    + "which way — use div_floor, div_trunc or rem");
                return ty_unknown();
            }
            // A quotient can fall between two representable values — 1.00 / 3 — so
            // unlike `*`, division needs a contract even when the scales match, and
            // the contract has to be on the value being divided.
            if left.kind == 45 && (right.kind == 45 || right.kind == 40) {
                if right.kind == 45 && !ty_same(src, left, right) {
                    let e: Int = self.complain_at(src, n.tok,
                        "cannot divide " + ty_show(src, left) + " by " + ty_show(src, right)
                        + ": division needs the same type, scale included");
                    return ty_unknown();
                }
                if left.contract == 0 {
                    let e: Int = self.complain_at(src, n.tok,
                        "`/` on " + ty_show(src, left) + " needs a rounding contract, "
                        + "because the exact quotient can have more than "
                        + to_string(left.scale) + " decimal places");
                    return ty_unknown();
                }
                return left;
            }
        }
        if n.value == 25 && left.kind == 42 && right.kind == 42 {
            if !self.has_region() {
                let r: Int = self.needs_region(src, n.tok, "joining two Strings");
            }
            return left;
        }
        // `+` and `-` combine like quantities: the types must match exactly.
        if !ty_same(src, left, right) {
            let e: Int = self.complain_at(src, n.tok,
                "cannot combine " + ty_show(src, left) + " and " + ty_show(src, right)
                + ": addition and subtraction need the same type, scale included");
            return ty_unknown();
        }
        return left;
    }

    if n.kind == 9 {                                 // a comparison
        let left: Ty = self.type_of(src, n.a, ty_unknown());
        let right: Ty = self.type_of(src, n.b, left);
        if !is_unknown(left) && !is_unknown(right) && !ty_same(src, left, right) {
            let e: Int = self.complain_at(src, n.tok,
                "cannot compare " + ty_show(src, left) + " with " + ty_show(src, right)
                + ": one equality, no coercion");
        }
        return ty_simple(41);
    }

    if n.kind == 10 {                                // && ||
        let left: Ty = self.type_of(src, n.a, ty_simple(41));
        let right: Ty = self.type_of(src, n.b, ty_simple(41));
        if !is_unknown(left) && left.kind != 41 {
            let e: Int = self.complain_at(src, n.tok, "this operator needs a Bool");
        }
        if !is_unknown(right) && right.kind != 41 {
            let e: Int = self.complain_at(src, n.tok, "this operator needs a Bool");
        }
        return ty_simple(41);
    }

    // `Enum.Variant` and `Enum.Variant(payload)` — the base names a TYPE, not a
    // variable, so typing it as one reported an unknown name. An enum constructor
    // looks exactly like a field access or a method call until you check the base.
    if n.kind == 11 || n.kind == 14 {
        let base: Node = self.nodes[n.a];
        if base.kind == 5 {
            let base_name: Tok = self.toks[base.tok];
            let declared: Int = self.find_type(src, base_name.start, base_name.length);
            if declared >= 0 {
                if self.types[declared].kind == 83 {
                    let holder: Ty = Ty { kind: 46, scale: 0, contract: 0,
                                          name_start: base_name.start,
                                          name_len: base_name.length };
                    let checked: Int = self.check_construction(src, holder, n);
                    return holder;
                }
            }
        }
    }

    if n.kind == 17 {                                // an array literal
        if expected.kind != 47 && expected.kind != 48 {
            let visited: Int = self.visit_children(src, node);
            return ty_unknown();
        }
        let want: Ty = self.ty_of(src, expected.scale);
        if expected.kind == 47 && !self.has_region() {
            let r: Int = self.needs_region(src, n.tok, "a growable array");
        }
        if expected.kind == 48 && n.b != expected.contract {
            let e: Int = self.complain_at(src, n.tok,
                "this array holds " + to_string(expected.contract) + " element(s), and "
                + "the literal has " + to_string(n.b) + ": a fixed array's length is "
                + "part of its type");
        }
        let mut i: Int = 0;
        while i < n.b {
            let got: Ty = self.type_of(src, self.kids[n.a + i], want);
            if !is_unknown(got) && !self.fits(src, got, want) {
                let e: Int = self.complain_at(src, n.tok,
                    "element " + to_string(i + 1) + " should be " + ty_show(src, want)
                    + ", but it is " + ty_show(src, got));
            }
            i = i + 1;
        }
        return expected;
    }

    if n.kind == 12 {                                // xs[i]
        let holder: Ty = self.type_of(src, n.a, ty_unknown());
        let index: Ty = self.type_of(src, n.b, ty_simple(40));
        if !is_unknown(index) && index.kind != 40 {
            let e: Int = self.complain_at(src, n.tok, "an index must be an Int");
        }
        if is_unknown(holder) {
            return ty_unknown();
        }
        if holder.kind == 42 {
            let e: Int = self.complain_at(src, n.tok,
                "a String is indexed with byte_at(s, i), which says it reads a BYTE");
            return ty_unknown();
        }
        if holder.kind != 47 && holder.kind != 48 {
            let e: Int = self.complain_at(src, n.tok,
                "indexing needs an array, but this is " + ty_show(src, holder));
            return ty_unknown();
        }
        if holder.kind == 48 {
            let index_node: Node = self.nodes[n.b];
            if index_node.kind == 1 {
                // A literal index is known now, so the bounds check is a compile error
                // rather than an exit 70 later. The runtime check stays for the rest.
                if index_node.value >= holder.contract || index_node.value < 0 {
                    let e: Int = self.complain_at(src, n.tok,
                        "this array holds " + to_string(holder.contract)
                        + " element(s), so " + to_string(index_node.value)
                        + " is past its end");
                }
            }
        }
        return self.ty_of(src, holder.scale);
    }

    if n.kind == 14 {                                // a method call on a value
        let holder: Ty = self.type_of(src, n.a, ty_unknown());
        if is_unknown(holder) {
            let visited: Int = self.check_args(src, n.b);
            return ty_unknown();
        }
        if holder.kind == 49 {                       // dyn Trait
            return self.dyn_method(src, holder, n);
        }
        let found: Int = self.find_method(src, holder, n.tok);
        if found < 0 {
            let visited: Int = self.check_args(src, n.b);
            let e: Int = self.complain_at(src, n.tok,
                ty_show(src, holder) + " has no such method");
            return ty_unknown();
        }
        let m: Method = self.methods[found];
        if flag_allocates(m.flags) == 1 && !self.has_region() {
            let r: Int = self.needs_region(src, n.tok,
                "`" + substring(src, m.start, m.length) + "`");
        }
        if self.in_pure == 1 {
            // Not "a method that is not pure": `pure` is refused ON methods, so a
            // method call from a pure function can never be allowed.
            let e: Int = self.not_pure(src, n.tok, "call a method");
        }
        let ok: Int = self.check_against_params(src, n.tok, n.b, m.params, "method");
        return m.ret;
    }

    if n.kind == 11 {                                // a field access
        let holder: Ty = self.type_of(src, n.a, ty_unknown());
        if is_unknown(holder) {
            return ty_unknown();
        }
        let field: Ty = self.field_type(src, holder, n.tok);
        if is_unknown(field) {
            let e: Int = self.complain_at(src, n.tok,
                ty_show(src, holder) + " has no such field");
        }
        return field;
    }

    if n.kind == 19 {                                // a struct literal
        let name: Tok = self.toks[n.tok];
        let found: Int = self.find_type(src, name.start, name.length);
        if found < 0 {
            let e: Int = self.complain_at(src, n.tok, "unknown type");
            let visited: Int = self.visit_children(src, node);
            return ty_unknown();
        }
        let holder: Ty = Ty { kind: 46, scale: 0, contract: 0,
                              name_start: name.start, name_len: name.length };
        let mut i: Int = 0;
        while i < n.b {
            let pair: Node = self.nodes[self.kids[n.a + i]];
            let want: Ty = self.field_type(src, holder, pair.tok);
            if is_unknown(want) {
                let e: Int = self.complain_at(src, pair.tok,
                    ty_show(src, holder) + " has no such field");
            }
            let got: Ty = self.type_of(src, pair.a, want);
            if !is_unknown(got) && !is_unknown(want) && !self.fits(src, got, want) {
                let e: Int = self.complain_at(src, pair.tok,
                    "this field is " + ty_show(src, want) + ", but the value is "
                    + ty_show(src, got));
            }
            i = i + 1;
        }
        // Every field, not just the ones a writer remembered: a struct with a hole in
        // it has no value the compiler could invent that would be right.
        let decl: TypeDecl = self.types[found];
        let item: Node = self.nodes[decl.node];
        let mut f: Int = 0;
        while f < item.b {
            let field: Node = self.nodes[self.kids[item.a + f]];
            let field_name: Tok = self.toks[field.tok];
            let mut given: Bool = false;
            let mut g: Int = 0;
            while g < n.b {
                let pair: Node = self.nodes[self.kids[n.a + g]];
                let pair_name: Tok = self.toks[pair.tok];
                if spans_eq(src, pair_name.start, pair_name.length,
                            field_name.start, field_name.length) {
                    given = true;
                }
                g = g + 1;
            }
            if !given {
                let e: Int = self.complain_at(src, n.tok,
                    "this literal leaves out `"
                    + substring(src, field_name.start, field_name.length) + "`");
            }
            f = f + 1;
        }
        return holder;
    }

    if n.kind == 13 {                                // a call
        let t: Tok = self.toks[n.tok];
        if span_eq(src, t.start, t.length, "old") {
            // `old(e)` is the pre-state, hoisted to the function's entry. It means
            // nothing where there is no exit to compare against.
            if self.in_ensures == 0 {
                let e: Int = self.complain_at(src, n.tok,
                    "`old(...)` is the value on entry, so it only means something in "
                    + "an `ensures` clause");
            }
            let list: Node = self.nodes[n.a];
            if list.b != 1 {
                let e: Int = self.complain_at(src, n.tok, "`old` takes one expression");
                return ty_unknown();
            }
            let inner: Int = self.kids[list.a];
            let held: Node = self.nodes[inner];
            if held.kind == 5 {
                let named: Tok = self.toks[held.tok];
                if span_eq(src, named.start, named.length, "result") {
                    let e: Int = self.complain_at(src, n.tok,
                        "`old(result)` is a contradiction: the result does not exist "
                        + "on entry");
                    return ty_unknown();
                }
            }
            let got: Ty = self.type_of(src, inner, ty_unknown());
            if got.kind == 46 || got.kind == 47 || got.kind == 48 || got.kind == 49 {
                let e: Int = self.complain_at(src, n.tok,
                    "`old` of " + ty_show(src, got) + " would need a copy of the whole "
                    + "value at entry, which is not built: name the fields instead");
                return ty_unknown();
            }
            return got;
        }
        let found: Int = self.find_fun(src, t.start, t.length);
        if found < 0 {
            // A builtin, or a name nobody declared. The compiler knows the builtins,
            // so the checker knows them too rather than staying silent about calls.
            let builtin: Ty = self.builtin_type(src, t, n.tok, n.a);
            if is_unknown(builtin) {
                let e: Int = self.complain_at(src, n.tok, "unknown function");
            }
            return builtin;
        }
        let signature: Fun = self.funs[found];
        if flag_allocates(signature.flags) == 1 && !self.has_region() {
            let r: Int = self.needs_region(src, n.tok,
                "`" + substring(src, signature.start, signature.length) + "`");
        }
        if self.in_pure == 1 && flag_pure(signature.flags) == 0 {
            let e: Int = self.not_pure(src, n.tok,
                "call `" + substring(src, signature.start, signature.length)
                + "`, which is not `pure`");
        }
        let ok: Int = self.check_against_params(src, n.tok, n.a, signature.params,
                                                "function");
        return signature.ret;
    }

    // Anything else — fields, method calls, indexing, struct and array literals —
    // is phase 4b. Its children are still visited so unknown names are still found.
    let visited: Int = self.visit_children(src, node);
    return ty_unknown();
}

// Walk an expression's children without judging the node itself.
fn (mut self: Unit) visit_children(src: String, node: Int) -> Int allocates {
    let n: Node = self.nodes[node];
    if n.kind == 11 || n.kind == 6 || n.kind == 7 {
        let a: Ty = self.type_of(src, n.a, ty_unknown());
        return 1;
    }
    if n.kind == 12 || n.kind == 14 {
        let a: Ty = self.type_of(src, n.a, ty_unknown());
        if n.kind == 12 {
            let b: Ty = self.type_of(src, n.b, ty_simple(40));
        }
        return 1;
    }
    if n.kind == 17 || n.kind == 19 {                // array or struct literal
        let mut i: Int = 0;
        while i < n.b {
            let child: Int = self.kids[n.a + i];
            let field: Node = self.nodes[child];
            if n.kind == 19 {
                let v: Ty = self.type_of(src, field.a, ty_unknown());
            } else {
                let v: Ty = self.type_of(src, child, ty_unknown());
            }
            i = i + 1;
        }
        return 1;
    }
    return 0;
}

// Arity and argument types against a declared parameter list. Shared by function and
// method calls, because what the reader needs to be told is the same either way.
fn (mut self: Unit) check_against_params(src: String, at: Int, list_node: Int,
                                        params_node: Int, what: String) -> Int allocates {
    let list: Node = self.nodes[list_node];
    let params: Node = self.nodes[params_node];
    if list.b != params.b {
        let e: Int = self.complain_at(src, at,
            "this call passes " + to_string(list.b) + " argument(s), but the "
            + what + " takes " + to_string(params.b));
        return 0;
    }
    let mut i: Int = 0;
    while i < list.b {
        let param: Node = self.nodes[self.kids[params.a + i]];
        let want: Ty = as_burxt_sees(self.ty_of(src, param.a));
        let outer: Int = self.in_mul;
        self.in_mul = 0;                             // an argument is its own context
        let got: Ty = self.type_of(src, self.kids[list.a + i], want);
        self.in_mul = outer;
        if !is_unknown(got) && !self.fits(src, got, want) {
            let e: Int = self.complain_at(src, at,
                "argument " + to_string(i + 1) + " should be " + ty_show(src, want)
                + ", but it is " + ty_show(src, got));
        }
        i = i + 1;
    }
    return 1;
}

fn (mut self: Unit) check_args(src: String, list_node: Int) -> Int allocates {
    if list_node < 0 {
        return 0;
    }
    let list: Node = self.nodes[list_node];
    let mut i: Int = 0;
    while i < list.b {
        let arg: Ty = self.type_of(src, self.kids[list.a + i], ty_unknown());
        i = i + 1;
    }
    return list.b;
}

// ---- statements --------------------------------------------------------------
fn (mut self: Unit) check_block_nodes(src: String, block: Int, ret: Ty) -> Int allocates {
    if block < 0 {
        return 0;
    }
    let node: Node = self.nodes[block];
    self.depth = self.depth + 1;
    let mut i: Int = 0;
    while i < node.b {
        let stmt: Int = self.kids[node.a + i];
        let checked: Int = self.check_stmt_node(src, stmt, ret);
        // Anything after a statement that always leaves the block can never run, and
        // a reader who wrote it believed otherwise. Reported once, at the first one.
        if self.stmt_exits(stmt) && i + 1 < node.b {
            let next: Node = self.nodes[self.kids[node.a + i + 1]];
            let e: Int = self.complain_at(src, next.tok,
                "this can never run: the statement before it always leaves the block");
            i = node.b;
        }
        i = i + 1;
    }
    // Everything declared inside the block leaves scope at the closing brace. One
    // `truncate` rather than a loop: the bindings a block made are the ones on top.
    let mut keep: Int = len(self.syms);
    while keep > 0 && self.syms[keep - 1].depth >= self.depth {
        keep = keep - 1;
    }
    let dropped: Int = truncate(self.syms, keep);
    self.depth = self.depth - 1;
    return node.b;
}

fn (mut self: Unit) check_stmt_node(src: String, stmt: Int, ret: Ty) -> Int allocates {
    if stmt < 0 {
        return 0;
    }
    let n: Node = self.nodes[stmt];

    if n.kind == 60 {                                // let
        let declared: Ty = self.ty_of(src, n.a);
        let actual: Ty = self.type_of(src, n.b, declared);
        if !is_unknown(actual) && !self.fits(src, actual, declared) {
            let e: Int = self.complain_at(src, n.tok,
                "declared " + ty_show(src, declared) + ", but the value is "
                + ty_show(src, actual));
        }
        let name: Tok = self.toks[n.tok];
        // Shadowing is refused, so a second `let` of the same name is an error.
        if self.find_sym(src, name.start, name.length) >= 0 {
            let e: Int = self.complain_at(src, n.tok,
                "this name is already declared — Burxt does not shadow");
        }
        push(self.syms, Sym { start: name.start, length: name.length,
                              ty: declared, mutable: n.value, depth: self.depth });
        return 1;
    }

    if n.kind == 61 {                                // assignment
        let target: Node = self.nodes[n.a];
        let want: Ty = self.type_of(src, n.a, ty_unknown());
        let got: Ty = self.type_of(src, n.b, want);
        if !is_unknown(got) && !is_unknown(want) && !self.fits(src, got, want) {
            let e: Int = self.complain_at(src, n.tok,
                "cannot assign " + ty_show(src, got) + " to " + ty_show(src, want));
        }
        // Only a `let mut` binding may be assigned to.
        if target.kind == 5 {
            let name: Tok = self.toks[target.tok];
            let found: Int = self.find_sym(src, name.start, name.length);
            if found >= 0 && self.syms[found].mutable == 0 {
                let e: Int = self.complain_at(src, target.tok,
                    "this was declared immutable — declare it `let mut` to allow it");
            }
        }
        return 1;
    }

    if n.kind == 62 {                                // print
        if self.in_pure == 1 {
            let e: Int = self.not_pure(src, n.tok, "print");
        }
        let shown: Ty = self.type_at(n.a);
        if shown.kind == 46 || shown.kind == 49 || shown.kind == 47 || shown.kind == 48 {
            let e: Int = self.complain_at(src, n.tok,
                "`print` renders a number, a Bool, a Decimal or a String — "
                + ty_show(src, shown) + " has no one rendering the language can choose "
                + "for it");
        }
        let target: Node = self.nodes[n.a];
        if target.kind == 3 {
            if self.toks[target.tok].interpolated {
                // Printing an interpolated string writes its pieces in order, so no
                // String is built and no region is needed. Interpolation used as a
                // VALUE is a join, and that one does need one.
                return 1;
            }
        }
    }
    if n.kind == 62 || n.kind == 70 {                // print, expression statement
        let value: Ty = self.type_of(src, n.a, ty_unknown());
        return 1;
    }

    if n.kind == 63 || n.kind == 64 {                // return, return tail
        if self.in_function == 0 {
            let e: Int = self.complain_at(src, n.tok,
                "there is nothing here to return from: top-level code runs, it does "
                + "not answer");
            let visited: Ty = self.type_of(src, n.a, ty_unknown());
            return 1;
        }
        let value: Ty = self.type_of(src, n.a, ret);
        if !is_unknown(value) && !is_unknown(ret) && !self.fits(src, value, ret) {
            let e: Int = self.complain_at(src, n.tok,
                "this function returns " + ty_show(src, ret) + ", but the value is "
                + ty_show(src, value));
        }
        if n.kind == 64 {
            let checked: Int = self.check_tail(src, n, ret);
        }
        // The escape rule, and the whole of M1 in one condition: a built value may
        // leave a function ONLY when it was built in the CALLER's region — which means
        // `allocates`, and no region of this function's own open around the return.
        // A `region` block ends at its closing brace, so anything built inside it
        // would outlive its storage.
        if self.expr_allocates(src, n.a) {
            if self.in_caller_region == 0 {
                let e: Int = self.complain_at(src, n.tok,
                    "cannot return this: it allocates, and a function that returns "
                    + "built data must say `allocates` so the bytes belong to the "
                    + "caller's region");
            } else {
                if self.region_depth > 0 {
                    let e: Int = self.complain_at(src, n.tok,
                        "cannot return this: it was built inside a `region` block, "
                        + "which ends at its closing brace, so its storage would not "
                        + "outlive it");
                }
            }
        }
        return 1;
    }

    if n.kind == 65 {                                // if
        let cond: Ty = self.type_of(src, n.a, ty_simple(41));
        if !is_unknown(cond) && cond.kind != 41 {
            let e: Int = self.complain_at(src, n.tok, "an `if` condition must be a Bool");
        }
        let t: Int = self.check_block_nodes(src, n.b, ret);
        if n.c >= 0 {
            let other: Node = self.nodes[n.c];
            if other.kind == 16 {
                let f: Int = self.check_block_nodes(src, n.c, ret);
            } else {
                let f: Int = self.check_stmt_node(src, n.c, ret);
            }
        }
        return 1;
    }

    if n.kind == 66 {                                // while
        let cond: Ty = self.type_of(src, n.a, ty_simple(41));
        if !is_unknown(cond) && cond.kind != 41 {
            let e: Int = self.complain_at(src, n.tok, "a `while` condition must be a Bool");
        }
        self.loop_depth = self.loop_depth + 1;
        let body: Int = self.check_block_nodes(src, n.b, ret);
        self.loop_depth = self.loop_depth - 1;
        return 1;
    }

    if n.kind == 67 || n.kind == 68 {                // break, continue
        if self.loop_depth == 0 {
            let e: Int = self.complain_at(src, n.tok,
                "there is no loop here to leave: `break` and `continue` only mean "
                + "something inside `while`");
        }
        return 1;
    }

    if n.kind == 69 {                                // region
        if self.region_depth > 0 {
            let e: Int = self.complain_at(src, n.tok,
                "regions do not nest: the inner one would end while the outer is still "
                + "open, and one bump pointer cannot serve two marks");
        }
        self.region_depth = self.region_depth + 1;
        let body: Int = self.check_block_nodes(src, n.a, ret);
        self.region_depth = self.region_depth - 1;
        return 1;
    }

    if n.kind == 71 {                                // match
        let value: Ty = self.type_of(src, n.a, ty_unknown());
        let mut enum_decl: Int = -1;
        if value.kind == 46 {
            let declared: Int = self.find_type(src, value.name_start, value.name_len);
            if declared >= 0 {
                if self.types[declared].kind == 83 { enum_decl = declared; }
            }
        }
        if !is_unknown(value) && enum_decl < 0 {
            let e: Int = self.complain_at(src, n.tok,
                "`match` chooses between an enum's variants, and " + ty_show(src, value)
                + " has none");
        }
        if enum_decl >= 0 {
            // Every variant needs an arm, and no variant twice: exhaustiveness is what
            // makes a match an answer rather than a guess, and there is no `_` to hide
            // behind. Both questions are the same walk.
            let decl: Node = self.nodes[self.types[enum_decl].node];
            let mut v: Int = 0;
            while v < decl.b {
                let variant: Node = self.nodes[self.kids[decl.a + v]];
                let named: Tok = self.toks[variant.tok];
                let mut seen: Int = 0;
                let mut a: Int = 0;
                while a < n.c {
                    let arm: Node = self.nodes[self.kids[n.b + a]];
                    let arm_name: Tok = self.toks[arm.tok];
                    if spans_eq(src, arm_name.start, arm_name.length,
                                named.start, named.length) {
                        seen = seen + 1;
                    }
                    a = a + 1;
                }
                if seen == 0 {
                    let e: Int = self.complain_at(src, n.tok,
                        "this match has no arm for `"
                        + substring(src, named.start, named.length) + "`");
                }
                if seen > 1 {
                    let e: Int = self.complain_at(src, n.tok,
                        "`" + substring(src, named.start, named.length)
                        + "` has more than one arm, and only the first could ever run");
                }
                v = v + 1;
            }
        }
        let mut i: Int = 0;
        while i < n.c {
            let arm: Node = self.nodes[self.kids[n.b + i]];
            // The arm's bindings take the variant's payload types, and leave scope
            // with the arm — which is what `truncate` is for.
            let base: Int = len(self.syms);
            let bound: Int = self.bind_arm(src, value, arm);
            let body: Int = self.check_block_nodes(src, arm.a, ret);
            let dropped: Int = truncate(self.syms, base);
            i = i + 1;
        }
        return 1;
    }

    return 0;
}

// ---- the pass ----------------------------------------------------------------
// A function or method body, with its parameters — and a method's `self` — in scope.
fn (mut self: Unit) check_body(src: String, index: Int) -> Int allocates {
    let item: Node = self.nodes[index];
    let base: Int = len(self.syms);
    self.depth = self.depth + 1;
    // The markers are the body's rules: `allocates` means the caller's region is in
    // effect throughout, `pure` means the world is off limits.
    let outer_caller: Int = self.in_caller_region;
    let outer_pure: Int = self.in_pure;
    self.in_caller_region = flag_allocates(item.value);
    self.in_pure = flag_pure(item.value);
    let signature: Node = self.nodes[item.c];
    if item.kind == 81 {
        // `self` is a name like any other once it is bound: the receiver's type is
        // written in the clause node, so a method body needs no special rule.
        let receiver: Tok = self.toks[signature.value];
        // The clause node holds the receiver's TYPE token; the word `self` is two
        // tokens before it, because a receiver clause has exactly one shape:
        // `(self: Type)` or `(mut self: Type)`. Checked rather than assumed.
        let mut self_tok: Int = signature.value - 2;
        if self.toks[self_tok].kind != 119 {
            self_tok = signature.value;
        }
        let word: Tok = self.toks[self_tok];
        let mut writable: Int = 0;
        if item.value >= 4 { writable = 1; }
        push(self.syms, Sym { start: word.start, length: word.length,
                              ty: Ty { kind: 46, scale: 0, contract: 0,
                                       name_start: receiver.start,
                                       name_len: receiver.length },
                              mutable: writable, depth: self.depth });
    }
    let params: Node = self.nodes[item.a];
    let mut p: Int = 0;
    while p < params.b {
        let param: Node = self.nodes[self.kids[params.a + p]];
        let name: Tok = self.toks[param.tok];
        push(self.syms, Sym { start: name.start, length: name.length,
                              ty: self.ty_of(src, param.a), mutable: 0,
                              depth: self.depth });
        p = p + 1;
    }
    let ret: Ty = self.ty_of(src, signature.c);
    let clauses: Int = self.check_clauses(src, index, signature, ret);
    let outer_function: Int = self.in_function;
    let outer_loop: Int = self.loop_depth;
    let outer_fn: Int = self.current_fn;
    self.current_fn = -1;
    if item.kind == 80 {
        self.current_fn = self.find_fun(src, self.toks[item.tok].start,
                                       self.toks[item.tok].length);
    }
    self.in_function = 1;
    self.loop_depth = 0;
    let body: Int = self.check_block_nodes(src, item.b, ret);
    if !self.block_exits(item.b) {
        // Every Burxt function returns a value, so falling off the end is not a
        // silent zero — it is a missing answer, and the compiler says which function.
        let e: Int = self.complain_at(src, item.tok,
            "this function can reach its closing brace without returning, and every "
            + "Burxt function answers with a value");
    }
    self.in_function = outer_function;
    self.loop_depth = outer_loop;
    self.current_fn = outer_fn;
    let dropped: Int = truncate(self.syms, base);
    self.depth = self.depth - 1;
    self.in_caller_region = outer_caller;
    self.in_pure = outer_pure;
    return 1;
}

// `requires`, `ensures`, `decreases`. All three are checked under the `pure` rule,
// for the reason A5 gives: a contract that can change the program is not a check, it
// is a second program that only runs when someone is looking.
fn (mut self: Unit) check_clauses(src: String, index: Int, signature: Node,
                                  ret: Ty) -> Int allocates {
    let item: Node = self.nodes[index];
    let outer_pure: Int = self.in_pure;
    self.in_pure = 1;
    self.in_contract = 1;
    let mut measures: Int = 0;
    let mut i: Int = 0;
    while i < signature.b {
        let clause: Node = self.nodes[self.kids[signature.a + i]];
        let base: Int = len(self.syms);
        if clause.value == 127 {                     // ensures
            // `result` is bound here and nowhere else. It is not a keyword: a
            // parameter may still be called `result`, and then it collides, which is
            // an error about the collision rather than a silent shadowing.
            if ret.kind == 46 || ret.kind == 47 || ret.kind == 48 {
                let e: Int = self.complain_at(src, clause.tok,
                    "`ensures` cannot see the result of a function returning "
                    + ty_show(src, ret) + ": it travels through the caller's storage, "
                    + "and binding `result` to it needs care a scalar does not");
            }
            self.in_ensures = 1;
            let spelling: Int = find_text(src, "result");
            if spelling >= 0 {
                push(self.syms, Sym { start: spelling, length: 6,
                                      ty: ret, mutable: 0, depth: self.depth });
            }
        }
        let got: Ty = self.type_of(src, clause.a, ty_simple(41));
        if clause.value == 128 {                     // decreases
            measures = measures + 1;
            if !is_unknown(got) && got.kind != 40 {
                let e: Int = self.complain_at(src, clause.tok,
                    "a `decreases` measure counts, so it must be an Int: a Decimal "
                    + "measure invites a descent that shrinks forever without arriving");
            }
            if item.kind == 81 {
                let e: Int = self.complain_at(src, clause.tok,
                    "`decreases` is not available on a method yet, and a clause that "
                    + "is not checked would be worse than none");
            }
            if !self.body_calls(src, item.b, self.toks[item.tok]) {
                let e: Int = self.complain_at(src, clause.tok,
                    "`decreases` claims a recursion ends, and this function never "
                    + "calls itself, so there is nothing to check");
            }
        } else {
            if !is_unknown(got) && got.kind != 41 {
                let e: Int = self.complain_at(src, clause.tok,
                    "a contract is a claim, so it must be a Bool, but this is "
                    + ty_show(src, got));
            }
        }
        self.in_ensures = 0;
        let dropped: Int = truncate(self.syms, base);
        i = i + 1;
    }
    if measures > 1 {
        let e: Int = self.complain_at(src, item.tok,
            "one `decreases` per function: two measures would need a rule for which "
            + "one descends, and one integer covers the cases that exist");
    }
    self.in_contract = 0;
    self.in_pure = outer_pure;
    return 1;
}

// Where these bytes first appear in the source. A symbol is a span, so binding a name
// the program did not write — `result` inside an `ensures` — needs a span whose bytes
// spell it. Any occurrence will do, since only the bytes are compared. If the word
// appears nowhere, nothing can refer to it, and there is nothing to bind.
fn find_text(src: String, needle: String) -> Int {
    let n: Int = len(needle);
    let mut i: Int = 0;
    while i + n <= len(src) {
        let mut k: Int = 0;
        let mut same: Bool = true;
        while k < n {
            if byte_at(src, i + k) != byte_at(needle, k) {
                same = false;
                k = n;
            } else {
                k = k + 1;
            }
        }
        if same {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// `return tail f(...)` is a guarantee, not a hope: the frame is REPLACED. Everything
// below is a condition for that being possible at all, which is why each one is a
// compile error rather than a quiet fallback to an ordinary call.
fn (mut self: Unit) check_tail(src: String, n: Node, ret: Ty) -> Int allocates {
    let value: Node = self.nodes[n.a];
    if value.kind != 13 {
        let e: Int = self.complain_at(src, n.tok,
            "`tail` names the call whose frame replaces this one, and this is not a call");
        return 0;
    }
    if self.region_depth > 0 {
        let e: Int = self.complain_at(src, n.tok,
            "a `tail` call inside a `region` would jump past the region's close, and "
            + "the bytes would never be released");
    }
    if ret.kind == 46 || ret.kind == 47 || ret.kind == 48 {
        let e: Int = self.complain_at(src, n.tok,
            "a `tail` call cannot return " + ty_show(src, ret) + ": an aggregate travels "
            + "through the caller's storage, and the frame that owns it is the one being "
            + "replaced");
    }
    let called: Tok = self.toks[value.tok];
    let target: Int = self.find_fun(src, called.start, called.length);
    if target < 0 {
        let e: Int = self.complain_at(src, n.tok,
            "`tail` calls a Burxt function, and this is not one");
        return 0;
    }
    let callee: Fun = self.funs[target];
    if flag_extern(callee.flags) == 1 {
        let e: Int = self.complain_at(src, n.tok,
            "`tail` into C is not a tail call: the C side has its own calling "
            + "convention, and nothing here can guarantee the frame is replaced");
        return 0;
    }
    if self.current_fn < 0 {
        return 0;
    }
    let here: Fun = self.funs[self.current_fn];
    if !ty_same(src, callee.ret, here.ret) {
        let e: Int = self.complain_at(src, n.tok,
            "a `tail` call must answer what this function answers: " + ty_show(src, here.ret)
            + ", not " + ty_show(src, callee.ret));
    }
    let mine: Node = self.nodes[here.params];
    let theirs: Node = self.nodes[callee.params];
    if mine.b != theirs.b {
        let e: Int = self.complain_at(src, n.tok,
            "a `tail` call replaces this frame, so the signatures must match: this "
            + "function takes " + to_string(mine.b) + " parameter(s), and that one takes "
            + to_string(theirs.b));
        return 0;
    }
    let mut i: Int = 0;
    while i < mine.b {
        let want: Ty = self.ty_of(src, self.nodes[self.kids[mine.a + i]].a);
        let got: Ty = self.ty_of(src, self.nodes[self.kids[theirs.a + i]].a);
        if !ty_same(src, got, want) {
            let e: Int = self.complain_at(src, n.tok,
                "parameter " + to_string(i + 1) + " is " + ty_show(src, want) + " here and "
                + ty_show(src, got) + " there, and a replaced frame has one shape");
        }
        i = i + 1;
    }
    return 1;
}

// Whether a body calls this name — the token scan is exact, because Burxt has no
// first-class functions, so a name followed by `(` inside the body is a call to the
// one function that has it. The range is the body's braces, counted.
fn (self: Unit) body_calls(src: String, body: Int, name: Tok) -> Bool {
    if body < 0 {
        return false;
    }
    let mut i: Int = self.nodes[body].tok;
    let mut depth: Int = 0;
    let mut opened: Bool = false;
    while i < len(self.toks) {
        let t: Tok = self.toks[i];
        if t.kind == 31 {
            depth = depth + 1;
            opened = true;
        }
        if t.kind == 32 {
            depth = depth - 1;
            if opened && depth == 0 {
                return false;
            }
        }
        if t.kind == 1 && spans_eq(src, t.start, t.length, name.start, name.length) {
            if i + 1 < len(self.toks) {
                if self.toks[i + 1].kind == 29 {     // '('
                    return true;
                }
            }
        }
        i = i + 1;
    }
    return false;
}

// An `impl` answers a trait exactly: every signature, no extras, same shapes. A trait
// is a promise a `dyn` value makes on the implementor's behalf, so a mismatch here is a
// promise nobody keeps.
fn (mut self: Unit) check_impl(src: String, index: Int) -> Int allocates {
    let item: Node = self.nodes[index];
    let trait_name: Tok = self.toks[item.tok];
    let found: Int = self.find_type(src, trait_name.start, trait_name.length);
    if found < 0 {
        let e: Int = self.complain_at(src, item.tok, "no trait of this name is declared");
        return 0;
    }
    let decl: TypeDecl = self.types[found];
    if decl.kind != 84 {
        let e: Int = self.complain_at(src, item.tok,
            "`impl` implements a trait, and this name belongs to a type");
        return 0;
    }
    let declared: Node = self.nodes[decl.node];
    let mut i: Int = 0;
    while i < declared.b {
        let sig: Node = self.nodes[self.kids[declared.a + i]];
        let sig_name: Tok = self.toks[sig.tok];
        let mut matched: Int = -1;
        let mut k: Int = 0;
        while k < item.b {
            let candidate: Int = self.kids[item.a + k];
            let named: Tok = self.toks[self.nodes[candidate].tok];
            if spans_eq(src, named.start, named.length, sig_name.start, sig_name.length) {
                matched = candidate;
            }
            k = k + 1;
        }
        if matched < 0 {
            let e: Int = self.complain_at(src, item.tok,
                "this impl leaves out `" + substring(src, sig_name.start, sig_name.length)
                + "`, which the trait requires");
        } else {
            let method: Node = self.nodes[matched];
            let mut mutating: Int = 0;
            if method.value >= 4 { mutating = 1; }
            if mutating != sig.value {
                let e: Int = self.complain_at(src, method.tok,
                    "the trait writes this receiver differently: `self` and `mut self` "
                    + "are different promises");
            }
            let params: Node = self.nodes[method.a];
            if params.b != sig.c {
                let e: Int = self.complain_at(src, method.tok,
                    "the trait's signature takes " + to_string(sig.c)
                    + " parameter(s), and this takes " + to_string(params.b));
            } else {
                let mut p: Int = 0;
                while p < sig.c {
                    let want: Ty = self.ty_of(src, self.nodes[self.subs[sig.b + p]].a);
                    let got: Ty = self.ty_of(src, self.nodes[self.kids[params.a + p]].a);
                    if !ty_same(src, got, want) {
                        let e: Int = self.complain_at(src, method.tok,
                            "parameter " + to_string(p + 1) + " is " + ty_show(src, want)
                            + " in the trait, and " + ty_show(src, got) + " here");
                    }
                    p = p + 1;
                }
            }
            let want_ret: Ty = self.ty_of(src, sig.a);
            let got_ret: Ty = self.ty_of(src, self.nodes[method.c].c);
            if !ty_same(src, got_ret, want_ret) {
                let e: Int = self.complain_at(src, method.tok,
                    "the trait returns " + ty_show(src, want_ret) + ", and this returns "
                    + ty_show(src, got_ret));
            }
        }
        i = i + 1;
    }
    let mut k: Int = 0;
    while k < item.b {
        let method: Node = self.nodes[self.kids[item.a + k]];
        let named: Tok = self.toks[method.tok];
        let mut known: Bool = false;
        let mut i2: Int = 0;
        while i2 < declared.b {
            let sig: Node = self.nodes[self.kids[declared.a + i2]];
            let sig_name: Tok = self.toks[sig.tok];
            if spans_eq(src, named.start, named.length, sig_name.start, sig_name.length) {
                known = true;
            }
            i2 = i2 + 1;
        }
        if !known {
            let e: Int = self.complain_at(src, method.tok,
                "the trait has no method of this name, and an impl is an answer to a "
                + "trait rather than a place to add to a type");
        }
        k = k + 1;
    }
    return 1;
}

// The shapes a type may not have. Both refusals are about storage: a nested array would
// need a layout rule for arrays of arrays that M1 does not have, and a zero-length array
// describes nothing. A growable array inside a struct is fine — stage-1's own Unit is
// made of them — and what it costs is that the struct must be built in a region.
fn (mut self: Unit) check_type_shape(src: String, node: Int, at: Int) -> Int allocates {
    if node < 0 {
        return 0;
    }
    let n: Node = self.nodes[node];
    if n.kind != 47 && n.kind != 48 {
        return 0;
    }
    if n.kind == 48 && n.b <= 0 {
        let e: Int = self.complain_at(src, at,
            "an array of no elements describes nothing, and nothing can be read from it");
    }
    let element: Node = self.nodes[n.a];
    if element.kind == 47 || element.kind == 48 {
        let e: Int = self.complain_at(src, at,
            "arrays do not nest yet: an array of arrays needs a layout rule the memory "
            + "model does not have");
        return 0;
    }
    return self.check_type_shape(src, n.a, at);
}

fn (mut self: Unit) check(src: String) -> Int allocates {
    let collected: Int = self.collect_declarations(src);
    let mut i: Int = 0;
    while i < len(self.items) {
        let index: Int = self.items[i];
        let item: Node = self.nodes[index];
        if item.kind == 80 || item.kind == 81 {
            let checked: Int = self.check_body(src, index);
        }
        if item.kind == 85 {                         // an impl block's methods
            let answered: Int = self.check_impl(src, index);
            let mut k: Int = 0;
            while k < item.b {
                let checked: Int = self.check_body(src, self.kids[item.a + k]);
                k = k + 1;
            }
        }
        if item.kind >= 60 && item.kind <= 71 {      // a top-level statement
            let checked: Int = self.check_stmt_node(src, index, ty_unknown());
        }
        i = i + 1;
    }
    return self.problems;
}

// ---- reporting -------------------------------------------------------------
fn kind_name(kind: Int) -> String allocates {
    if kind == 1 { return "ident"; }
    if kind == 2 { return "int"; }
    if kind == 3 { return "decimal"; }
    if kind == 4 { return "string"; }
    if kind >= 140 { return "type"; }
    if kind >= 100 { return "keyword"; }
    return "punct";
}

fn (self: Unit) report(src: String, limit: Int) -> Int allocates {
    let mut i: Int = 0;
    while i < len(self.toks) && i < limit {
        let t: Tok = self.toks[i];
        let text: String = substring(src, t.start, t.length);
        if t.kind == 3 {
            print("  decimal " + text + " -> unscaled " + to_string(t.value)
                  + " scale " + to_string(t.scale));
        } else {
            print("  " + kind_name(t.kind) + " `" + text + "`");
        }
        i = i + 1;
    }
    return i;
}

fn (self: Unit) count_of(kind: Int) -> Int {
    let mut i: Int = 0;
    let mut found: Int = 0;
    while i < len(self.toks) {
        if self.toks[i].kind == kind {
            found = found + 1;
        }
        i = i + 1;
    }
    return found;
}


// =============================================================================
// PHASE 5: the backend. Textual LLVM IR, for the reason M4 §1 gives — an
// `extern fn` returns an Int or a CInt, never a pointer whose ownership Burxt
// cannot describe, so an LLVMBuilderRef is unreachable BY CONSTRUCTION. Emitting
// text is not a workaround: it is string formatting instead of an API, and the
// output is readable, diffable and testable without a debugger.
//
// Slice 1 covers Ints, Bools, String literals, arithmetic with the overflow
// checks the thesis requires, comparisons, `if`, `while`, `break`, `continue`,
// functions, calls and `print`. Decimals, regions and aggregates follow; what is
// not covered is refused by name rather than emitted wrongly.
// =============================================================================

struct Slot { start: Int, length: Int, index: Int }

fn (mut self: Unit) w(text: String) -> Int allocates {
    self.out = self.out + text;
    return 0;
}

fn (mut self: Unit) fresh() -> String allocates {
    self.next_tmp = self.next_tmp + 1;
    return "%t" + to_string(self.next_tmp);
}

fn (mut self: Unit) fresh_label(stem: String) -> String allocates {
    self.next_label = self.next_label + 1;
    return stem + to_string(self.next_label);
}

// A local's alloca, named by its position in the table rather than by the source
// name, so two blocks that both say `x` cannot collide in the IR.
fn (mut self: Unit) declare_slot(src: String, start: Int, length: Int) -> Int allocates {
    let index: Int = len(self.slots);
    push(self.slots, Slot { start: start, length: length, index: index });
    let visited: Int = self.w("  %v" + to_string(index) + " = alloca i64\n");
    return index;
}

fn (self: Unit) find_slot(src: String, start: Int, length: Int) -> Int {
    let mut i: Int = len(self.slots) - 1;
    while i >= 0 {
        let slot: Slot = self.slots[i];
        if spans_eq(src, slot.start, slot.length, start, length) {
            return slot.index;
        }
        i = i - 1;
    }
    return -1;
}

// Every byte as a hex escape. LLVM accepts c"\68\69\00", and emitting only escapes
// means no byte needs a character to stand for it — which matters in a language whose
// own `to_string` answers with digits, not letters.
fn hex_of(value: Int) -> String allocates {
    let digits: String = "0123456789abcdef";
    return "\\" + substring(digits, div_floor(value, 16), 1)
                + substring(digits, rem(value, 16), 1);
}

// A private constant for these bytes, answering the global's name. The bytes are the
// STRING as the lexer read it, escapes and all, so what the program prints is what the
// source said.
fn (mut self: Unit) intern(src: String, start: Int, length: Int) -> String allocates {
    let name: String = "@s" + to_string(len(self.strings));
    push(self.strings, start);
    let mut body: String = "";
    let mut count: Int = 0;
    let mut i: Int = 0;
    while i < length {
        let byte: Int = byte_at(src, start + i);
        if byte == 92 && i + 1 < length {            // a backslash: the lexer's escape
            let next: Int = byte_at(src, start + i + 1);
            let mut resolved: Int = next;
            if next == 110 { resolved = 10; }        // \n
            if next == 116 { resolved = 9; }         // \t
            if next == 48 { resolved = 0; }          // \0
            body = body + hex_of(resolved);
            count = count + 1;
            i = i + 2;
        } else {
            body = body + hex_of(byte);
            count = count + 1;
            i = i + 1;
        }
    }
    self.globals = self.globals + name + " = private unnamed_addr constant ["
        + to_string(count + 1) + " x i8] c\"" + body + hex_of(0) + "\"\n";
    return name;
}

// ---- expressions -------------------------------------------------------------
// Each one answers an OPERAND: a register like %t7, or a literal like 42. The caller
// does not care which, which is what keeps the emitter free of a value type.
fn (mut self: Unit) emit_expr(src: String, node: Int) -> String allocates {
    let n: Node = self.nodes[node];
    if n.kind == 1 {                                 // an Int literal
        return to_string(n.value);
    }
    if n.kind == 4 {                                 // a Bool literal
        if n.value == 1 {
            return "1";
        }
        return "0";
    }
    if n.kind == 3 {                                 // a String literal
        let t: Tok = self.toks[n.tok];
        if t.interpolated {
            let e: Int = self.complain_at(src, n.tok,
                "the Burxt backend does not emit interpolation yet: it desugars to "
                + "`to_string` and `+`, and neither is emitted in this slice");
            return "@str_true";
        }
        // The token's span includes its quotes, and the bytes between them are the
        // string. One place knows that, and it is here.
        let global: String = self.intern(src, t.start + 1, t.length - 2);
        return "ptrtoint (ptr " + global + " to i64)";
    }
    if n.kind == 5 {                                 // a name
        let t: Tok = self.toks[n.tok];
        let slot: Int = self.find_slot(src, t.start, t.length);
        if slot < 0 {
            return "0";
        }
        let reg: String = self.fresh();
        let visited: Int = self.w("  " + reg + " = load i64, ptr %v" + to_string(slot)
                                  + "\n");
        return reg;
    }
    if n.kind == 6 || n.kind == 7 {                  // -e, !e
        let inner: String = self.emit_expr(src, n.a);
        let reg: String = self.fresh();
        if n.kind == 7 {
            let visited: Int = self.w("  " + reg + " = xor i64 " + inner + ", 1\n");
        } else {
            let visited: Int = self.w("  " + reg + " = call i64 @burxt.checked.sub(i64 0, "
                                      + "i64 " + inner + ")\n");
        }
        return reg;
    }
    if n.kind == 8 {                                 // a + b, a - b, a * b
        let left: String = self.emit_expr(src, n.a);
        let right: String = self.emit_expr(src, n.b);
        if n.value == 25 && self.type_at(n.a).kind == 42 {
            // `+` on Strings is a join, and the join allocates in the open region.
            let joined: String = self.fresh();
            let visited: Int = self.w("  " + joined + " = call i64 @burxt.concat(i64 "
                                      + left + ", i64 " + right + ")\n");
            return joined;
        }
        let mut helper: String = "add";
        if n.value == 26 { helper = "sub"; }
        if n.value == 27 { helper = "mul"; }
        let reg: String = self.fresh();
        // Through the checked helper, always. An arithmetic result that silently wraps
        // is the same class of wrong as a rounded cent.
        let visited: Int = self.w("  " + reg + " = call i64 @burxt.checked." + helper
                                  + "(i64 " + left + ", i64 " + right + ")\n");
        return reg;
    }
    if n.kind == 9 {                                 // a comparison
        let left: String = self.emit_expr(src, n.a);
        let right: String = self.emit_expr(src, n.b);
        // The token codes, not invented ones: `==` is 12, `!=` 13, `<=` 14, `>=` 15,
        // and the single-character `<` and `>` are 35 and 36.
        let mut op: String = "eq";
        if n.value == 13 { op = "ne"; }
        if n.value == 14 { op = "sle"; }
        if n.value == 15 { op = "sge"; }
        if n.value == 35 { op = "slt"; }
        if n.value == 36 { op = "sgt"; }
        let bit: String = self.fresh();
        let visited: Int = self.w("  " + bit + " = icmp " + op + " i64 " + left + ", "
                                  + right + "\n");
        let reg: String = self.fresh();
        // A Bool is an i64 in Burxt's ABI, so a comparison widens once, here.
        let widened: Int = self.w("  " + reg + " = zext i1 " + bit + " to i64\n");
        return reg;
    }
    if n.kind == 10 {                                // && and ||
        // Both sides are evaluated: Burxt has no short-circuit yet, and pretending
        // otherwise in the backend would make the two implementations disagree.
        let left: String = self.emit_expr(src, n.a);
        let right: String = self.emit_expr(src, n.b);
        let reg: String = self.fresh();
        let mut op: String = "and";
        if n.value == 17 { op = "or"; }
        let visited: Int = self.w("  " + reg + " = " + op + " i64 " + left + ", "
                                  + right + "\n");
        return reg;
    }
    if n.kind == 13 {                                // a call
        let t: Tok = self.toks[n.tok];
        let list: Node = self.nodes[n.a];
        let called: String = substring(src, t.start, t.length);
        if builtin_arity(called) >= 0 {
            return self.emit_builtin(src, n, called);
        }
        let mut args: String = "";
        let mut i: Int = 0;
        while i < list.b {
            let value: String = self.emit_expr(src, self.kids[list.a + i]);
            if i > 0 {
                args = args + ", ";
            }
            args = args + "i64 " + value;
            i = i + 1;
        }
        let reg: String = self.fresh();
        let visited: Int = self.w("  " + reg + " = call i64 @" + substring(src, t.start,
                                  t.length) + "(" + args + ")\n");
        return reg;
    }
    // Anything this slice does not cover is named rather than emitted wrongly.
    let e: Int = self.complain_at(src, n.tok,
        "the Burxt backend does not emit this expression yet");
    return "0";
}

// ---- statements --------------------------------------------------------------
// The builtins with a runtime helper behind them, and the ones that are a single
// instruction. Anything else is refused by name.
fn (mut self: Unit) emit_builtin(src: String, n: Node, called: String) -> String allocates {
    let list: Node = self.nodes[n.a];
    let mut first: String = "0";
    let mut second: String = "0";
    let mut third: String = "0";
    if list.b > 0 { first = self.emit_expr(src, self.kids[list.a]); }
    if list.b > 1 { second = self.emit_expr(src, self.kids[list.a + 1]); }
    if list.b > 2 { third = self.emit_expr(src, self.kids[list.a + 2]); }
    let reg: String = self.fresh();

    if called == "to_string" {
        if self.type_at(self.kids[list.a]).kind == 41 {
            // A Bool renders to one of two literals, which is why it needs no region.
            let bit: String = self.fresh();
            let tested: Int = self.w("  " + bit + " = icmp ne i64 " + first + ", 0\n");
            let chosen: Int = self.w("  " + reg + " = select i1 " + bit
                + ", i64 ptrtoint (ptr @str_true to i64), i64 ptrtoint (ptr @str_false to i64)\n");
            return reg;
        }
        let visited: Int = self.w("  " + reg + " = call i64 @burxt.to_string_int(i64 "
                                  + first + ")\n");
        return reg;
    }
    if called == "len" {
        if self.type_at(self.kids[list.a]).kind == 42 {
            let visited: Int = self.w("  " + reg + " = call i64 @burxt.len_str(i64 "
                                      + first + ")\n");
            return reg;
        }
        let e: Int = self.complain_at(src, n.tok,
            "the Burxt backend does not emit `len` of an array yet");
        return "0";
    }
    if called == "byte_at" {
        let visited: Int = self.w("  " + reg + " = call i64 @burxt.byte_at(i64 " + first
                                  + ", i64 " + second + ")\n");
        return reg;
    }
    if called == "substring" {
        let visited: Int = self.w("  " + reg + " = call i64 @burxt.substring(i64 " + first
                                  + ", i64 " + second + ", i64 " + third + ")\n");
        return reg;
    }
    if called == "div_trunc" {
        let visited: Int = self.w("  " + reg + " = sdiv i64 " + first + ", " + second + "\n");
        return reg;
    }
    if called == "rem" {
        let visited: Int = self.w("  " + reg + " = srem i64 " + first + ", " + second + "\n");
        return reg;
    }
    if called == "div_floor" {
        let visited: Int = self.w("  " + reg + " = call i64 @burxt.div_floor(i64 " + first
                                  + ", i64 " + second + ")\n");
        return reg;
    }
    let e: Int = self.complain_at(src, n.tok,
        "the Burxt backend does not emit `" + called + "` yet");
    return "0";
}

fn (mut self: Unit) emit_stmt(src: String, node: Int) -> Int allocates {
    let n: Node = self.nodes[node];

    if n.kind == 60 {                                // let
        let name: Tok = self.toks[n.tok];
        let value: String = self.emit_expr(src, n.b);
        let slot: Int = self.declare_slot(src, name.start, name.length);
        return self.w("  store i64 " + value + ", ptr %v" + to_string(slot) + "\n");
    }

    if n.kind == 61 {                                // assignment
        let target: Node = self.nodes[n.a];
        let name: Tok = self.toks[target.tok];
        let value: String = self.emit_expr(src, n.b);
        let slot: Int = self.find_slot(src, name.start, name.length);
        return self.w("  store i64 " + value + ", ptr %v" + to_string(slot) + "\n");
    }

    if n.kind == 62 {                                // print
        let shown: Ty = self.type_at(n.a);
        let value: String = self.emit_expr(src, n.a);
        if shown.kind == 41 {                        // a Bool renders as a word
            let bit: String = self.fresh();
            let visited: Int = self.w("  " + bit + " = icmp ne i64 " + value + ", 0\n");
            let text: String = self.fresh();
            let chosen: Int = self.w("  " + text + " = select i1 " + bit
                                     + ", ptr @str_true, ptr @str_false\n");
            let printed: Int = self.w("  call i32 (ptr, ...) @printf(ptr @fmt_str, ptr "
                                      + text + ")\n");
            return self.w("  call i32 (ptr, ...) @printf(ptr @fmt_nl)\n");
        }
        if shown.kind == 42 {                        // a String
            let as_ptr: String = self.fresh();
            let cast: Int = self.w("  " + as_ptr + " = inttoptr i64 " + value + " to ptr\n");
            let printed: Int = self.w("  call i32 (ptr, ...) @printf(ptr @fmt_str, ptr "
                                      + as_ptr + ")\n");
            return self.w("  call i32 (ptr, ...) @printf(ptr @fmt_nl)\n");
        }
        let printed: Int = self.w("  call i32 (ptr, ...) @printf(ptr @fmt_int, i64 "
                                  + value + ")\n");
        return self.w("  call i32 (ptr, ...) @printf(ptr @fmt_nl)\n");
    }

    if n.kind == 63 {                                // return
        let value: String = self.emit_expr(src, n.a);
        return self.w("  ret i64 " + value + "\n");
    }

    if n.kind == 65 {                                // if
        let cond: String = self.emit_expr(src, n.a);
        let bit: String = self.fresh();
        let tested: Int = self.w("  " + bit + " = icmp ne i64 " + cond + ", 0\n");
        let then_label: String = self.fresh_label("if.then");
        let else_label: String = self.fresh_label("if.else");
        let end_label: String = self.fresh_label("if.end");
        let branched: Int = self.w("  br i1 " + bit + ", label %" + then_label
                                   + ", label %" + else_label + "\n");
        let opened: Int = self.w(then_label + ":\n");
        let then_body: Int = self.emit_block(src, n.b);
        let closed: Int = self.w("  br label %" + end_label + "\n" + else_label + ":\n");
        if n.c >= 0 {
            let else_body: Int = self.emit_block(src, n.c);
        }
        let joined: Int = self.w("  br label %" + end_label + "\n" + end_label + ":\n");
        return 1;
    }

    if n.kind == 66 {                                // while
        let cond_label: String = self.fresh_label("while.cond");
        let body_label: String = self.fresh_label("while.body");
        let end_label: String = self.fresh_label("while.end");
        let entered: Int = self.w("  br label %" + cond_label + "\n" + cond_label + ":\n");
        let cond: String = self.emit_expr(src, n.a);
        let bit: String = self.fresh();
        let tested: Int = self.w("  " + bit + " = icmp ne i64 " + cond + ", 0\n");
        let branched: Int = self.w("  br i1 " + bit + ", label %" + body_label
                                   + ", label %" + end_label + "\n" + body_label + ":\n");
        // A stack, because `break` inside a nested loop leaves the INNER one.
        push(self.loop_conds, cond_label);
        push(self.loop_ends, end_label);
        let body: Int = self.emit_block(src, n.b);
        let dropped_cond: Int = truncate(self.loop_conds, len(self.loop_conds) - 1);
        let dropped_end: Int = truncate(self.loop_ends, len(self.loop_ends) - 1);
        return self.w("  br label %" + cond_label + "\n" + end_label + ":\n");
    }

    if n.kind == 67 || n.kind == 68 {                // break, continue
        let depth: Int = len(self.loop_ends);
        if depth == 0 {
            return 0;
        }
        let mut target: String = self.loop_ends[depth - 1];
        if n.kind == 68 {
            target = self.loop_conds[depth - 1];
        }
        let jumped: Int = self.w("  br label %" + target + "\n");
        // The block after an unconditional branch needs a label, and nothing reaches it.
        let dead: String = self.fresh_label("after");
        return self.w(dead + ":\n");
    }

    if n.kind == 69 {                                // region
        // The mark IS the region: closing it releases every allocation at once.
        let mark: String = self.fresh();
        let saved: Int = self.w("  " + mark + " = load i64, ptr @bump\n");
        let body: Int = self.emit_block(src, n.a);
        return self.w("  store i64 " + mark + ", ptr @bump\n");
    }

    if n.kind == 70 {                                // an expression, for its effect
        let value: String = self.emit_expr(src, n.a);
        return 1;
    }

    let e: Int = self.complain_at(src, n.tok,
        "the Burxt backend does not emit this statement yet");
    return 0;
}

fn (mut self: Unit) emit_block(src: String, block: Int) -> Int allocates {
    if block < 0 {
        return 0;
    }
    let n: Node = self.nodes[block];
    if n.kind != 16 {
        return self.emit_stmt(src, block);
    }
    let mut i: Int = 0;
    while i < n.b {
        let emitted: Int = self.emit_stmt(src, self.kids[n.a + i]);
        i = i + 1;
    }
    return 1;
}

// ---- the module --------------------------------------------------------------
fn (mut self: Unit) emit_module(src: String) -> Int allocates {
    let mut preamble: Int = self.w("declare i32 @printf(ptr, ...)\n");
    preamble = self.w("declare void @exit(i32)\n\n");
    // The overflow helpers, written once. They are what makes `a + b` a claim rather
    // than a hope, and they exit 70 like every other named runtime failure.
    preamble = self.w(overflow_helper("add", "sadd"));
    preamble = self.w(overflow_helper("sub", "ssub"));
    preamble = self.w(overflow_helper("mul", "smul"));
    preamble = self.w(runtime_ir());

    // Functions first, so a call reads as a call to something already written.
    let mut i: Int = 0;
    while i < len(self.items) {
        let index: Int = self.items[i];
        let item: Node = self.nodes[index];
        if item.kind == 80 {
            let name: Tok = self.toks[item.tok];
            let params: Node = self.nodes[item.a];
            let base: Int = len(self.slots);
            let mut signature: String = "";
            let mut p: Int = 0;
            while p < params.b {
                if p > 0 {
                    signature = signature + ", ";
                }
                signature = signature + "i64 %a" + to_string(p);
                p = p + 1;
            }
            let opened: Int = self.w("define i64 @" + substring(src, name.start, name.length)
                                     + "(" + signature + ") \{\nentry:\n");
            p = 0;
            while p < params.b {
                let param: Node = self.nodes[self.kids[params.a + p]];
                let pname: Tok = self.toks[param.tok];
                let slot: Int = self.declare_slot(src, pname.start, pname.length);
                let stored: Int = self.w("  store i64 %a" + to_string(p) + ", ptr %v"
                                         + to_string(slot) + "\n");
                p = p + 1;
            }
            let body: Int = self.emit_block(src, item.b);
            // Unreachable, since the checker proved every path returns — but LLVM
            // requires every block to end in a terminator, and a module that does not
            // verify is not a program.
            let closed: Int = self.w("  ret i64 0\n\}\n\n");
            let dropped: Int = truncate(self.slots, base);
        }
        i = i + 1;
    }

    // Then main, which is the top-level statements in order.
    let opened: Int = self.w("define i32 @main(i32 %argc, ptr %argv) \{\nentry:\n");
    i = 0;
    while i < len(self.items) {
        let index: Int = self.items[i];
        let item: Node = self.nodes[index];
        if item.kind >= 60 && item.kind <= 71 {
            let emitted: Int = self.emit_stmt(src, index);
        }
        i = i + 1;
    }
    let closed: Int = self.w("  ret i32 0\n\}\n");
    return 1;
}

// The runtime, written into every module rather than linked from a library: a bump
// allocator, and the String operations that build in it. Emitting it means a Burxt
// program needs nothing on the machine but a C library.
//
// A Burxt String is a NUL-terminated pointer, carried as an i64 like every other value
// — one value type through the whole emitter, cast at the few places a pointer is
// needed. `len` is therefore strlen, which is also why a String has no length field
// that could fall out of step with its bytes. The bump allocator's MARK is the region:
// opening one remembers where the pointer stood, closing it puts the pointer back, and
// that is the whole of release — O(1) for any number of allocations.
fn runtime_ir() -> String allocates {
    return "@arena = global ptr null\n"
        + "@bump = global i64 0\n"
        + "declare ptr @malloc(i64)\n"
        + "declare i64 @strlen(ptr)\n"
        + "declare ptr @memcpy(ptr, ptr, i64)\n"
        + "declare i32 @snprintf(ptr, i64, ptr, ...)\n\n"
        + "define i64 @burxt.alloc(i64 %n) \{\n"
        + "entry:\n"
        + "  %a = load ptr, ptr @arena\n"
        + "  %isnull = icmp eq ptr %a, null\n"
        + "  br i1 %isnull, label %init, label %go\n"
        + "init:\n"
        + "  %m = call ptr @malloc(i64 268435456)\n"
        + "  store ptr %m, ptr @arena\n"
        + "  br label %go\n"
        + "go:\n"
        + "  %base = load ptr, ptr @arena\n"
        + "  %off = load i64, ptr @bump\n"
        + "  %p = getelementptr i8, ptr %base, i64 %off\n"
        + "  %padded = add i64 %n, 7\n"
        + "  %rounded = and i64 %padded, -8\n"
        + "  %next = add i64 %off, %rounded\n"
        + "  store i64 %next, ptr @bump\n"
        + "  %asint = ptrtoint ptr %p to i64\n"
        + "  ret i64 %asint\n\}\n\n"
        + "define i64 @burxt.concat(i64 %a, i64 %b) \{\n"
        + "entry:\n"
        + "  %pa = inttoptr i64 %a to ptr\n"
        + "  %pb = inttoptr i64 %b to ptr\n"
        + "  %la = call i64 @strlen(ptr %pa)\n"
        + "  %lb = call i64 @strlen(ptr %pb)\n"
        + "  %total = add i64 %la, %lb\n"
        + "  %size = add i64 %total, 1\n"
        + "  %out = call i64 @burxt.alloc(i64 %size)\n"
        + "  %pout = inttoptr i64 %out to ptr\n"
        + "  %c1 = call ptr @memcpy(ptr %pout, ptr %pa, i64 %la)\n"
        + "  %tail = getelementptr i8, ptr %pout, i64 %la\n"
        + "  %c2 = call ptr @memcpy(ptr %tail, ptr %pb, i64 %lb)\n"
        + "  %end = getelementptr i8, ptr %pout, i64 %total\n"
        + "  store i8 0, ptr %end\n"
        + "  ret i64 %out\n\}\n\n"
        + "define i64 @burxt.substring(i64 %s, i64 %from, i64 %count) \{\n"
        + "entry:\n"
        + "  %size = add i64 %count, 1\n"
        + "  %out = call i64 @burxt.alloc(i64 %size)\n"
        + "  %pout = inttoptr i64 %out to ptr\n"
        + "  %ps = inttoptr i64 %s to ptr\n"
        + "  %from_ptr = getelementptr i8, ptr %ps, i64 %from\n"
        + "  %copied = call ptr @memcpy(ptr %pout, ptr %from_ptr, i64 %count)\n"
        + "  %end = getelementptr i8, ptr %pout, i64 %count\n"
        + "  store i8 0, ptr %end\n"
        + "  ret i64 %out\n\}\n\n"
        + "define i64 @burxt.to_string_int(i64 %v) \{\n"
        + "entry:\n"
        + "  %out = call i64 @burxt.alloc(i64 24)\n"
        + "  %p = inttoptr i64 %out to ptr\n"
        + "  %n = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %p, i64 24, ptr @fmt_int, "
        + "i64 %v)\n"
        + "  ret i64 %out\n\}\n\n"
        + "define i64 @burxt.byte_at(i64 %s, i64 %i) \{\n"
        + "entry:\n"
        + "  %p = inttoptr i64 %s to ptr\n"
        + "  %q = getelementptr i8, ptr %p, i64 %i\n"
        + "  %b = load i8, ptr %q\n"
        + "  %z = zext i8 %b to i64\n"
        + "  ret i64 %z\n\}\n\n"
        + "define i64 @burxt.len_str(i64 %s) \{\n"
        + "entry:\n"
        + "  %p = inttoptr i64 %s to ptr\n"
        + "  %l = call i64 @strlen(ptr %p)\n"
        + "  ret i64 %l\n\}\n\n"
        + "define i64 @burxt.div_floor(i64 %a, i64 %b) \{\n"
        + "entry:\n"
        + "  %q = sdiv i64 %a, %b\n"
        + "  %r = srem i64 %a, %b\n"
        + "  %nonzero = icmp ne i64 %r, 0\n"
        + "  %ra = xor i64 %r, %b\n"
        + "  %opposite = icmp slt i64 %ra, 0\n"
        + "  %adjust = and i1 %nonzero, %opposite\n"
        + "  %lower = sub i64 %q, 1\n"
        + "  %answer = select i1 %adjust, i64 %lower, i64 %q\n"
        + "  ret i64 %answer\n\}\n\n";
}

fn overflow_helper(name: String, intrinsic: String) -> String allocates {
    return "define i64 @burxt.checked." + name + "(i64 %a, i64 %b) \{\n"
        + "entry:\n"
        + "  %r = call \{i64, i1\} @llvm." + intrinsic + ".with.overflow.i64(i64 %a, i64 %b)\n"
        + "  %v = extractvalue \{i64, i1\} %r, 0\n"
        + "  %o = extractvalue \{i64, i1\} %r, 1\n"
        + "  br i1 %o, label %overflowed, label %ok\n"
        + "ok:\n  ret i64 %v\n"
        + "overflowed:\n"
        + "  call i32 (ptr, ...) @printf(ptr @overflow_msg)\n"
        + "  call void @exit(i32 70)\n"
        + "  unreachable\n\}\n"
        + "declare \{i64, i1\} @llvm." + intrinsic + ".with.overflow.i64(i64, i64)\n\n";
}

region compile {
    // The file to lex: whatever was asked for, or the tour as a default.
    let mut path: String = "examples/tour.bx";
    if arg_count() > 1 {
        path = arg(1);
    }
    let src: String = read_file(path);
    let mut unit: Unit = Unit { toks: [], words: [], nodes: [], kids: [], subs: [], items: [], syms: [], funs: [], stack: [], methods: [], types: [], impls: [], typed: [], region_depth: 0, in_caller_region: 0, in_pure: 0, loop_depth: 0, in_contract: 0, in_ensures: 0, current_fn: -1, out: "", globals: "", next_tmp: 0, next_label: 0, slots: [], strings: [], loop_conds: [], loop_ends: [], in_function: 0, depth: 0, problems: 0, pos: 0, no_struct: 0, in_mul: 0, errors: 0 };
    let installed: Int = unit.install_keywords();
    let total: Int = unit.run(src);

    print("lexed " + path + ": " + to_string(total) + " tokens, "
          + to_string(installed) + " keywords known");
    print("  identifiers: " + to_string(unit.count_of(1)));
    print("  decimals:    " + to_string(unit.count_of(3)));
    print("  strings:     " + to_string(unit.count_of(4)));
    print("  errors:      " + to_string(unit.errors));
    print("first tokens:");
    let shown: Int = unit.report(src, 8);

    // ---- phase 3: parse everything the tokens describe ----
    let mut items: Int = 0;
    while !unit.done() {
        let item: Int = unit.parse_item(src);
        if item < 0 {
            break;
        }
        push(unit.items, item);
        items = items + 1;
    }
    print("parsed " + to_string(items) + " items and statements into "
          + to_string(len(unit.nodes)) + " nodes, "
          + to_string(len(unit.kids)) + " child slots");
    print("  parse errors: " + to_string(unit.errors));

    // ---- phase 4: check what the parser read ----
    if unit.errors == 0 {
        let problems: Int = unit.check(src);
        print("checked " + to_string(len(unit.funs)) + " functions and "
              + to_string(len(unit.types)) + " types");
        print("  type errors: " + to_string(problems));

        // ---- phase 5: emit LLVM IR, when a second argument says where ----
        if problems == 0 && arg_count() > 2 {
            let emitted: Int = unit.emit_module(src);
            if unit.problems == 0 {
                let text: String = "; LLVM IR written by the Burxt compiler, in Burxt.\n"
                    + "@fmt_int = private unnamed_addr constant [5 x i8] c\"%lld\\00\"\n"
                    + "@fmt_str = private unnamed_addr constant [3 x i8] c\"%s\\00\"\n"
                    + "@fmt_nl = private unnamed_addr constant [2 x i8] c\"\\0A\\00\"\n"
                    + "@str_true = private unnamed_addr constant [5 x i8] c\"true\\00\"\n"
                    + "@str_false = private unnamed_addr constant [6 x i8] c\"false\\00\"\n"
                    + "@overflow_msg = private unnamed_addr constant [42 x i8] "
                    + "c\"burxt runtime error: arithmetic overflow\\0A\\00\"\n"
                    + unit.globals + "\n" + unit.out;
                let wrote: Int = write_file(arg(2), text);
                print("wrote " + arg(2) + ", " + to_string(len(text)) + " bytes of IR");
            } else {
                print("  backend refusals: " + to_string(unit.problems));
            }
        }
    }
}
