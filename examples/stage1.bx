// ============================================================================
// STAGE-1: the Burxt compiler, written in Burxt.
//
// One file, because Burxt has no module system yet — which is the shape
// spec/M4-SELF-HOSTING.md predicted stage-1 would take. It grows a phase at a time:
//
//   phase 2 (v0.0.52)  the lexer: the real token set, exact money literals
//   phase 3 (v0.0.53)  the parser: types, expressions, statements, in an arena
//
// Nothing here uses a map, because Burxt has none: the keyword table and the symbol
// table are arrays searched linearly, which is what a compiler's lookups cost anyway.
// ============================================================================

// ---- token kinds -----------------------------------------------------------
// Codes rather than an enum: a 60-variant enum would force a 60-arm `match` at
// every use, and the payloads differ per kind. The names live in `kind_name`.
//   1 identifier      2 Int literal      3 Decimal literal     4 String literal
//   10..49 punctuation                   100.. keywords
struct Tok {
    kind: Int,
    start: Int,
    length: Int,
    // Int literals: the value. Decimals: the unscaled integer, with `scale` places.
    value: Int,
    scale: Int,
    // A string literal containing `{` opens an interpolation; splitting the pieces
    // is the parser's job, so the lexer only records that there is one.
    interpolated: Bool,
}

struct Kw { word: String, code: Int }
// ---- the AST -----------------------------------------------------------------
// Children by INDEX, not by pointer: v0.0.22 proved an arena needs no recursive
// types, and an index is a number a struct field can hold.
//
// Expression kinds:
//   1 Int literal        2 Decimal literal      3 String literal    4 Bool literal
//   5 name               6 unary minus          7 not
//   8 binary (a op b, op in `value`)             9 comparison
//  10 logical            11 field access        12 index
//  13 call               14 method call
// Type kinds:
//  40 Int  41 Bool  42 String  43 CInt  44 CDouble
//  45 Decimal (scale in `a`, contract in `b`)   46 named   47 slice   48 array
//  49 dyn
// Statement kinds:
//  60 let (name tok in `tok`, type in `a`, value in `b`, mutable in `value`)
//  61 assign            62 print               63 return            64 tail return
//  65 if                66 while               67 break             68 continue
//  69 region            70 expression statement
struct Node {
    kind: Int,
    // Child indices, or payload. Meaning depends on `kind`, documented above.
    a: Int,
    b: Int,
    c: Int,
    // The operator byte, a flag, or a literal's value — whatever the kind needs.
    value: Int,
    // The token this node started at, so a message can point at the source.
    tok: Int,
}

// One compilation unit: its tokens, its keyword table, and its AST.
//
// `kids` is where child LISTS live — the arguments of a call, the statements of a
// block. A node stores a start offset and a count into it, rather than a linked list
// through the nodes themselves.
//
// That is not a workaround for the two gaps found writing this file (Burxt has no
// `xs[i].field = v`, and no writing to a growable array element through a field): it
// is the better design regardless. Children pushed into a side array land
// CONTIGUOUSLY even though their subtrees interleave in `nodes`, so nothing needs
// back-patching, and a list is two integers instead of a chain of cells.
// A declared type: `Int`, `Decimal<2, RoundHalfEven>`, `[Int]`, a struct name.
// A struct rather than an enum, because it is compared and copied constantly and a
// payload enum would need a match at every use.
struct Ty {
    // The node kinds the parser produces: 40 Int, 41 Bool, 42 String, 43 CInt,
    // 44 CDouble, 45 Decimal, 46 named, 47 slice, 48 array, 49 dyn. 0 is unknown,
    // which never equals anything — including another unknown.
    kind: Int,
    scale: Int,
    contract: Int,
    // For a named type, the span of its name in the source.
    name_start: Int,
    name_len: Int,
}

// A binding in scope: its name as a SPAN, so the checker allocates nothing to
// remember a variable.
struct Sym { start: Int, length: Int, ty: Ty, mutable: Int, depth: Int }
// A declared function: its name span, its return type, and its parameter list node.
struct Fun { start: Int, length: Int, ret: Ty, params: Int, flags: Int }
// A declared struct or enum: its name span and the item node that declared it.
struct TypeDecl { start: Int, length: Int, kind: Int, node: Int }
// A declared method, keyed by the receiver's name and its own.
struct Method {
    receiver_start: Int, receiver_len: Int,
    start: Int, length: Int,
    ret: Ty, params: Int, mutating: Int,
}

struct Unit {
    toks: [Tok],
    words: [Kw],
    nodes: [Node],
    kids: [Int],
    // A SECOND child array, for lists nested inside another list: a match arm's
    // bindings, an enum variant's payload types, a trait signature's parameters.
    //
    // Not tidiness — correctness. Pushing bindings and arms into one array
    // interleaves them, and the design's whole premise is that a list is contiguous.
    // The first version did exactly that and indexed past the end; the cross-check
    // test caught it on tests/pass/enum_match_flow.bx.
    subs: [Int],
    // Top-level items, in source order, for the checker to walk.
    items: [Int],
    syms: [Sym],
    funs: [Fun],
    stack: [Int],
    methods: [Method],
    types: [TypeDecl],
    // Block depth, so a binding leaves scope at the closing brace.
    depth: Int,
    problems: Int,
    // Where the parser is in the token array.
    pos: Int,
    // Nonzero while parsing an `if`/`while` condition, where a `{` opens the BODY
    // rather than a struct literal. The Rust parser carries the same flag.
    no_struct: Int,
    errors: Int,
}

fn is_alpha(b: Int) -> Bool {
    return (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || b == 95;
}

fn is_digit(b: Int) -> Bool {
    return b >= 48 && b <= 57;
}

fn is_name_byte(b: Int) -> Bool {
    return is_alpha(b) || is_digit(b);
}

fn is_space(b: Int) -> Bool {
    return b == 32 || b == 9 || b == 10 || b == 13;
}

fn at_byte(src: String, i: Int) -> Int {
    if i < 0 || i >= len(src) {
        return -1;
    }
    return byte_at(src, i);
}

// Compare two spans of the source directly. The obvious way to write this is
// `span_eq(src, a, alen, substring(src, b, blen))` — and the compiler refused it,
// because `substring` allocates and a comparison has no business needing a region.
// Comparing in place is both cheaper and what the checker wanted anyway.
fn spans_eq(src: String, a: Int, a_len: Int, b: Int, b_len: Int) -> Bool {
    if a_len != b_len {
        return false;
    }
    let mut i: Int = 0;
    while i < a_len {
        if byte_at(src, a + i) != byte_at(src, b + i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// Compare a span of the source against a whole word, without allocating.
fn span_eq(src: String, start: Int, length: Int, word: String) -> Bool {
    if length != len(word) {
        return false;
    }
    let mut i: Int = 0;
    while i < length {
        if byte_at(src, start + i) != byte_at(word, i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// ---- the keyword table -----------------------------------------------------
// Codes from 100. Order does not matter; the lookup is a scan.
fn (mut self: Unit) add_word(word: String, code: Int) -> Int {
    push(self.words, Kw { word: word, code: code });
    return len(self.words);
}

fn (mut self: Unit) install_keywords() -> Int {
    let mut n: Int = 0;
    n = self.add_word("let", 100);
    n = self.add_word("mut", 101);
    n = self.add_word("fn", 102);
    n = self.add_word("return", 103);
    n = self.add_word("if", 104);
    n = self.add_word("else", 105);
    n = self.add_word("while", 106);
    n = self.add_word("break", 107);
    n = self.add_word("continue", 108);
    n = self.add_word("struct", 109);
    n = self.add_word("enum", 110);
    n = self.add_word("match", 111);
    n = self.add_word("trait", 112);
    n = self.add_word("impl", 113);
    n = self.add_word("for", 114);
    n = self.add_word("dyn", 115);
    n = self.add_word("extern", 116);
    n = self.add_word("region", 117);
    n = self.add_word("print", 118);
    n = self.add_word("self", 119);
    n = self.add_word("true", 120);
    n = self.add_word("false", 121);
    n = self.add_word("as", 122);
    n = self.add_word("tail", 123);
    n = self.add_word("pure", 124);
    // `allocates`, `requires`, `ensures` and `decreases` are deliberately NOT here:
    // stage-0 made them contextual in v0.0.55, so they are ordinary identifiers and
    // the parser recognises them by position. A lexer that disagreed with stage-0
    // about this would reject `let allocates: Int = 0;` — which the cross-check test
    // caught within a minute of the change.
    n = self.add_word("interface", 129);
    n = self.add_word("is", 130);
    // Type names are keywords too: the parser needs them distinguished from
    // ordinary identifiers, exactly as the Rust lexer does.
    n = self.add_word("Int", 140);
    n = self.add_word("Bool", 141);
    n = self.add_word("String", 142);
    n = self.add_word("CInt", 143);
    n = self.add_word("CDouble", 144);
    n = self.add_word("Decimal", 145);
    n = self.add_word("RoundHalfEven", 146);
    n = self.add_word("RoundHalfUp", 147);
    return n;
}

// An identifier's span, or a keyword code if the table has it.
fn (self: Unit) keyword_code(src: String, start: Int, length: Int) -> Int {
    let mut i: Int = 0;
    while i < len(self.words) {
        if span_eq(src, start, length, self.words[i].word) {
            return self.words[i].code;
        }
        i = i + 1;
    }
    return 1;
}

fn (mut self: Unit) emit(kind: Int, start: Int, length: Int) -> Int {
    push(self.toks, Tok {
        kind: kind, start: start, length: length,
        value: 0, scale: 0, interpolated: false,
    });
    return len(self.toks);
}

fn (mut self: Unit) emit_number(kind: Int, start: Int, length: Int, value: Int, scale: Int) -> Int {
    push(self.toks, Tok {
        kind: kind, start: start, length: length,
        value: value, scale: scale, interpolated: false,
    });
    return len(self.toks);
}

fn (mut self: Unit) emit_string(start: Int, length: Int, interpolated: Bool) -> Int {
    push(self.toks, Tok {
        kind: 4, start: start, length: length,
        value: 0, scale: 0, interpolated: interpolated,
    });
    return len(self.toks);
}

// ---- whitespace and comments ----------------------------------------------
fn skip_trivia(src: String, from: Int) -> Int {
    let mut i: Int = from;
    while true {
        let mut moved: Bool = false;
        while i < len(src) && is_space(byte_at(src, i)) {
            i = i + 1;
            moved = true;
        }
        if at_byte(src, i) == 47 && at_byte(src, i + 1) == 47 {
            while i < len(src) && byte_at(src, i) != 10 {
                i = i + 1;
            }
            moved = true;
        }
        if !moved {
            break;
        }
    }
    return i;
}

// ---- numbers ---------------------------------------------------------------
// `19.99` is the unscaled integer 1999 with scale 2 — accumulated digit by digit,
// never through a float. `$19.99` is the same. `8.25%` is two places finer.
fn (mut self: Unit) scan_number(src: String, from: Int) -> Int allocates {
    let mut i: Int = from;
    let money: Bool = byte_at(src, i) == 36;         // '$'
    if money {
        i = i + 1;
    }
    let mut value: Int = 0;
    while i < len(src) && is_digit(byte_at(src, i)) {
        value = value * 10 + (byte_at(src, i) - 48);
        i = i + 1;
    }
    let mut scale: Int = 0;
    if at_byte(src, i) == 46 && is_digit(at_byte(src, i + 1)) {
        i = i + 1;
        while i < len(src) && is_digit(byte_at(src, i)) {
            value = value * 10 + (byte_at(src, i) - 48);
            scale = scale + 1;
            i = i + 1;
        }
    }
    if at_byte(src, i) == 37 {                       // '%'
        i = i + 1;
        // A percent is the number divided by a hundred: two more places, exactly.
        let n: Int = self.emit_number(3, from, i - from, value, scale + 2);
        return i;
    }
    if money || scale > 0 {
        let n: Int = self.emit_number(3, from, i - from, value, scale);
        return i;
    }
    let n: Int = self.emit_number(2, from, i - from, value, 0);
    return i;
}

// ---- strings ---------------------------------------------------------------
fn (mut self: Unit) scan_string(src: String, from: Int) -> Int allocates {
    let mut i: Int = from + 1;
    let mut interpolated: Bool = false;
    while true {
        if i >= len(src) {
            print("error: unterminated string literal");
            self.errors = self.errors + 1;
            break;
        }
        let b: Int = byte_at(src, i);
        if b == 92 {                                 // '\' — an escape, whatever follows
            i = i + 2;
            continue;
        }
        if b == 123 {                                // '{' opens an interpolation
            interpolated = true;
            i = i + 1;
            continue;
        }
        if b == 34 {                                 // '"' closes it
            i = i + 1;
            break;
        }
        i = i + 1;
    }
    let n: Int = self.emit_string(from, i - from, interpolated);
    return i;
}

// ---- punctuation -----------------------------------------------------------
// Two-character forms are tried first: `-` and `->` differ by one byte and mean
// entirely different things.
fn (mut self: Unit) scan_punct(src: String, from: Int) -> Int allocates {
    let one: Int = byte_at(src, from);
    let two: Int = at_byte(src, from + 1);
    if one == 45 && two == 62 { let n: Int = self.emit(10, from, 2); return from + 2; }  // ->
    if one == 61 && two == 62 { let n: Int = self.emit(11, from, 2); return from + 2; }  // =>
    if one == 61 && two == 61 { let n: Int = self.emit(12, from, 2); return from + 2; }  // ==
    if one == 33 && two == 61 { let n: Int = self.emit(13, from, 2); return from + 2; }  // !=
    if one == 60 && two == 61 { let n: Int = self.emit(14, from, 2); return from + 2; }  // <=
    if one == 62 && two == 61 { let n: Int = self.emit(15, from, 2); return from + 2; }  // >=
    if one == 38 && two == 38 { let n: Int = self.emit(16, from, 2); return from + 2; }  // &&
    if one == 124 && two == 124 { let n: Int = self.emit(17, from, 2); return from + 2; } // ||

    if one == 58 { let n: Int = self.emit(20, from, 1); return from + 1; }   // :
    if one == 59 { let n: Int = self.emit(21, from, 1); return from + 1; }   // ;
    if one == 44 { let n: Int = self.emit(22, from, 1); return from + 1; }   // ,
    if one == 46 { let n: Int = self.emit(23, from, 1); return from + 1; }   // .
    if one == 61 { let n: Int = self.emit(24, from, 1); return from + 1; }   // =
    if one == 43 { let n: Int = self.emit(25, from, 1); return from + 1; }   // +
    if one == 45 { let n: Int = self.emit(26, from, 1); return from + 1; }   // -
    if one == 42 { let n: Int = self.emit(27, from, 1); return from + 1; }   // *
    if one == 47 { let n: Int = self.emit(28, from, 1); return from + 1; }   // /
    if one == 40 { let n: Int = self.emit(29, from, 1); return from + 1; }   // (
    if one == 41 { let n: Int = self.emit(30, from, 1); return from + 1; }   // )
    if one == 123 { let n: Int = self.emit(31, from, 1); return from + 1; }  // {
    if one == 125 { let n: Int = self.emit(32, from, 1); return from + 1; }  // }
    if one == 91 { let n: Int = self.emit(33, from, 1); return from + 1; }   // [
    if one == 93 { let n: Int = self.emit(34, from, 1); return from + 1; }   // ]
    if one == 60 { let n: Int = self.emit(35, from, 1); return from + 1; }   // <
    if one == 62 { let n: Int = self.emit(36, from, 1); return from + 1; }   // >
    if one == 33 { let n: Int = self.emit(37, from, 1); return from + 1; }   // !

    print("error: byte " + to_string(one) + " starts no token");
    self.errors = self.errors + 1;
    return from + 1;
}

// ---- the loop --------------------------------------------------------------
fn (mut self: Unit) run(src: String) -> Int allocates {
    let mut i: Int = 0;
    while true {
        i = skip_trivia(src, i);
        if i >= len(src) {
            break;
        }
        let b: Int = byte_at(src, i);
        if is_alpha(b) {
            let start: Int = i;
            while i < len(src) && is_name_byte(byte_at(src, i)) {
                i = i + 1;
            }
            let code: Int = self.keyword_code(src, start, i - start);
            let n: Int = self.emit(code, start, i - start);
            continue;
        }
        if is_digit(b) || (b == 36 && is_digit(at_byte(src, i + 1))) {
            i = self.scan_number(src, i);
            continue;
        }
        if b == 34 {
            i = self.scan_string(src, i);
            continue;
        }
        i = self.scan_punct(src, i);
    }
    return len(self.toks);
}


// ============================================================================
// PHASE 3: the parser. Tokens in, arena AST out.
// ============================================================================

fn (self: Unit) kind_at(offset: Int) -> Int {
    let i: Int = self.pos + offset;
    if i < 0 || i >= len(self.toks) {
        return 0;                                    // past the end
    }
    return self.toks[i].kind;
}

fn (self: Unit) at(kind: Int) -> Bool {
    return self.kind_at(0) == kind;
}

// Is the current token the contextual word `word`? Compared against the source span,
// so it costs no allocation — the same trick keyword lookup uses.
fn (self: Unit) at_word(src: String, word: String) -> Bool {
    if self.kind_at(0) != 1 {
        return false;
    }
    let t: Tok = self.toks[self.pos];
    return span_eq(src, t.start, t.length, word);
}

fn (self: Unit) done() -> Bool {
    return self.pos >= len(self.toks);
}

fn (mut self: Unit) advance() -> Int {
    self.pos = self.pos + 1;
    return self.pos;
}

fn (mut self: Unit) complain(src: String, what: String) -> Int allocates {
    let where: Int = self.pos;
    if where < len(self.toks) {
        let t: Tok = self.toks[where];
        print("parse error: expected " + what + ", found `"
              + substring(src, t.start, t.length) + "`");
    } else {
        print("parse error: expected " + what + ", found the end of the file");
    }
    self.errors = self.errors + 1;
    return -1;
}

// Consume a token of this kind, or report what was there instead.
fn (mut self: Unit) eat(src: String, kind: Int, what: String) -> Bool allocates {
    if self.at(kind) {
        let n: Int = self.advance();
        return true;
    }
    let bad: Int = self.complain(src, what);
    return false;
}

fn (mut self: Unit) add(kind: Int, a: Int, b: Int, c: Int, value: Int, tok: Int) -> Int {
    push(self.nodes, Node { kind: kind, a: a, b: b, c: c, value: value, tok: tok });
    return len(self.nodes) - 1;
}

// ---- types -------------------------------------------------------------------
fn (mut self: Unit) parse_type(src: String) -> Int allocates {
    let here: Int = self.pos;
    let k: Int = self.kind_at(0);
    if k == 140 { let n: Int = self.advance(); return self.add(40, 0, 0, 0, 0, here); }
    if k == 141 { let n: Int = self.advance(); return self.add(41, 0, 0, 0, 0, here); }
    if k == 142 { let n: Int = self.advance(); return self.add(42, 0, 0, 0, 0, here); }
    if k == 143 { let n: Int = self.advance(); return self.add(43, 0, 0, 0, 0, here); }
    if k == 144 { let n: Int = self.advance(); return self.add(44, 0, 0, 0, 0, here); }
    if k == 145 {
        // Decimal<S> or Decimal<S, RoundHalfEven>: the scale and the contract are
        // part of the type, so they are part of the node.
        let n: Int = self.advance();
        if !self.eat(src, 35, "`<` after `Decimal`") { return -1; }
        if !self.at(2) { return self.complain(src, "a scale, e.g. `Decimal<2>`"); }
        let scale: Int = self.toks[self.pos].value;
        let m: Int = self.advance();
        let mut contract: Int = 0;
        if self.at(22) {                             // ','
            let c: Int = self.advance();
            if self.at(146) { contract = 1; }
            if self.at(147) { contract = 2; }
            if contract == 0 {
                return self.complain(src, "`RoundHalfEven` or `RoundHalfUp`");
            }
            let d: Int = self.advance();
        }
        if !self.eat(src, 36, "`>` closing the type") { return -1; }
        return self.add(45, scale, contract, 0, 0, here);
    }
    if k == 115 {                                    // dyn
        let n: Int = self.advance();
        if !self.at(1) { return self.complain(src, "a trait name after `dyn`"); }
        let name_tok: Int = self.pos;
        let m: Int = self.advance();
        return self.add(49, 0, 0, 0, 0, name_tok);
    }
    if k == 33 {                                     // '[' — slice or fixed array
        let n: Int = self.advance();
        let elem: Int = self.parse_type(src);
        if elem < 0 { return -1; }
        if self.at(21) {                             // ';' — a fixed length follows
            let semi: Int = self.advance();
            if !self.at(2) { return self.complain(src, "an array length"); }
            let count: Int = self.toks[self.pos].value;
            let m: Int = self.advance();
            if !self.eat(src, 34, "`]` closing the array type") { return -1; }
            return self.add(48, elem, count, 0, 0, here);
        }
        if !self.eat(src, 34, "`]` closing the slice type") { return -1; }
        return self.add(47, elem, 0, 0, 0, here);
    }
    if k == 1 {                                      // a named struct, enum or trait
        let name_tok: Int = self.pos;
        let n: Int = self.advance();
        return self.add(46, 0, 0, 0, 0, name_tok);
    }
    return self.complain(src, "a type");
}

// The type of `Name.field`, found by walking the struct's declaration. Linear, like
// every other lookup here: a struct has a handful of fields, and a map would be a
// dependency on machinery the language does not have.
fn (self: Unit) field_type(src: String, holder: Ty, name_tok: Int) -> Ty {
    if holder.kind != 46 {
        return ty_unknown();
    }
    let found: Int = self.find_type(src, holder.name_start, holder.name_len);
    if found < 0 {
        return ty_unknown();
    }
    let decl: TypeDecl = self.types[found];
    if decl.kind != 82 {
        return ty_unknown();
    }
    let item: Node = self.nodes[decl.node];
    let wanted: Tok = self.toks[name_tok];
    let mut i: Int = 0;
    while i < item.b {
        let field: Node = self.nodes[self.kids[item.a + i]];
        let field_name: Tok = self.toks[field.tok];
        if spans_eq(src, field_name.start, field_name.length, wanted.start, wanted.length) {
            return self.ty_of(src, field.a);
        }
        i = i + 1;
    }
    return ty_unknown();
}

// A builtin's return type. They are not in the function table because they are not
// declared anywhere — the compiler knows them, so the checker must too.
fn (mut self: Unit) builtin_type(src: String, name: Tok, args: Int) -> Ty allocates {
    let visited: Int = self.check_args(src, args);
    if span_eq(src, name.start, name.length, "len") { return ty_simple(40); }
    if span_eq(src, name.start, name.length, "byte_at") { return ty_simple(40); }
    if span_eq(src, name.start, name.length, "push") { return ty_simple(40); }
    if span_eq(src, name.start, name.length, "truncate") { return ty_simple(40); }
    if span_eq(src, name.start, name.length, "arg_count") { return ty_simple(40); }
    if span_eq(src, name.start, name.length, "write_file") { return ty_simple(40); }
    if span_eq(src, name.start, name.length, "div_floor") { return ty_simple(40); }
    if span_eq(src, name.start, name.length, "div_trunc") { return ty_simple(40); }
    if span_eq(src, name.start, name.length, "rem") { return ty_simple(40); }
    if span_eq(src, name.start, name.length, "to_string") { return ty_simple(42); }
    if span_eq(src, name.start, name.length, "read_file") { return ty_simple(42); }
    if span_eq(src, name.start, name.length, "substring") { return ty_simple(42); }
    if span_eq(src, name.start, name.length, "arg") { return ty_simple(42); }
    return ty_unknown();
}

fn (self: Unit) find_method(src: String, holder: Ty, name_tok: Int) -> Int {
    if holder.kind != 46 {
        return -1;
    }
    let wanted: Tok = self.toks[name_tok];
    let mut i: Int = 0;
    while i < len(self.methods) {
        let m: Method = self.methods[i];
        if spans_eq(src, m.receiver_start, m.receiver_len, holder.name_start, holder.name_len) {
            if spans_eq(src, m.start, m.length, wanted.start, wanted.length) {
                return i;
            }
        }
        i = i + 1;
    }
    return -1;
}

// The payload types of `Enum.Variant`, bound to an arm's names.
fn (mut self: Unit) bind_arm(src: String, holder: Ty, arm: Node) -> Int allocates {
    if holder.kind != 46 {
        return 0;
    }
    let found: Int = self.find_type(src, holder.name_start, holder.name_len);
    if found < 0 {
        return 0;
    }
    let decl: TypeDecl = self.types[found];
    if decl.kind != 83 {
        return 0;
    }
    let item: Node = self.nodes[decl.node];
    let wanted: Tok = self.toks[arm.tok];
    let mut i: Int = 0;
    while i < item.b {
        let variant: Node = self.nodes[self.kids[item.a + i]];
        let variant_name: Tok = self.toks[variant.tok];
        if spans_eq(src, variant_name.start, variant_name.length, wanted.start, wanted.length) {
            // Bind each name in the arm to the payload type at the same position.
            if arm.c != variant.c {
                let e: Int = self.complain_at(src, arm.tok,
                    "this arm binds " + to_string(arm.c) + " name(s), but the variant "
                    + "carries " + to_string(variant.c));
            }
            let mut p: Int = 0;
            while p < arm.c && p < variant.c {
                let name: Tok = self.toks[self.subs[arm.b + p]];
                let ty: Ty = self.ty_of(src, self.subs[variant.b + p]);
                push(self.syms, Sym { start: name.start, length: name.length,
                                      ty: ty, mutable: 0, depth: self.depth + 1 });
                p = p + 1;
            }
            return variant.c;
        }
        i = i + 1;
    }
    let e: Int = self.complain_at(src, arm.tok, "this enum has no such variant");
    return 0;
}

// ---- expressions -------------------------------------------------------------
// Precedence climbs the way the Rust parser's does: or, and, comparison, additive,
// term, unary, postfix, primary.
fn (mut self: Unit) parse_expr(src: String) -> Int allocates {
    return self.parse_or(src);
}

fn (mut self: Unit) parse_or(src: String) -> Int allocates {
    let mut left: Int = self.parse_and(src);
    while left >= 0 && self.at(17) {                 // ||
        let here: Int = self.pos;
        let n: Int = self.advance();
        let right: Int = self.parse_and(src);
        if right < 0 { return -1; }
        left = self.add(10, left, right, 0, 124, here);
    }
    return left;
}

fn (mut self: Unit) parse_and(src: String) -> Int allocates {
    let mut left: Int = self.parse_comparison(src);
    while left >= 0 && self.at(16) {                 // &&
        let here: Int = self.pos;
        let n: Int = self.advance();
        let right: Int = self.parse_comparison(src);
        if right < 0 { return -1; }
        left = self.add(10, left, right, 0, 38, here);
    }
    return left;
}

fn (mut self: Unit) parse_comparison(src: String) -> Int allocates {
    let left: Int = self.parse_additive(src);
    if left < 0 { return -1; }
    let k: Int = self.kind_at(0);
    if k == 12 || k == 13 || k == 14 || k == 15 || k == 35 || k == 36 {
        let here: Int = self.pos;
        let n: Int = self.advance();
        let right: Int = self.parse_additive(src);
        if right < 0 { return -1; }
        // Chained comparisons are not an expression in Burxt, and saying so here
        // beats letting `a < b < c` parse into something surprising.
        let next: Int = self.kind_at(0);
        if next == 12 || next == 13 || next == 14 || next == 15 || next == 35 || next == 36 {
            return self.complain(src, "no second comparison — `a < b < c` does not chain");
        }
        return self.add(9, left, right, 0, k, here);
    }
    return left;
}

fn (mut self: Unit) parse_additive(src: String) -> Int allocates {
    let mut left: Int = self.parse_term(src);
    while left >= 0 && (self.at(25) || self.at(26)) {  // + -
        let here: Int = self.pos;
        let op: Int = self.kind_at(0);
        let n: Int = self.advance();
        let right: Int = self.parse_term(src);
        if right < 0 { return -1; }
        left = self.add(8, left, right, 0, op, here);
    }
    return left;
}

fn (mut self: Unit) parse_term(src: String) -> Int allocates {
    let mut left: Int = self.parse_unary(src);
    while left >= 0 && (self.at(27) || self.at(28)) {  // * /
        let here: Int = self.pos;
        let op: Int = self.kind_at(0);
        let n: Int = self.advance();
        let right: Int = self.parse_unary(src);
        if right < 0 { return -1; }
        left = self.add(8, left, right, 0, op, here);
    }
    return left;
}

fn (mut self: Unit) parse_unary(src: String) -> Int allocates {
    let here: Int = self.pos;
    if self.at(26) {                                 // -
        let n: Int = self.advance();
        let inner: Int = self.parse_unary(src);
        if inner < 0 { return -1; }
        return self.add(6, inner, 0, 0, 0, here);
    }
    if self.at(37) {                                 // !
        let n: Int = self.advance();
        let inner: Int = self.parse_unary(src);
        if inner < 0 { return -1; }
        return self.add(7, inner, 0, 0, 0, here);
    }
    return self.parse_postfix(src);
}

// `.field`, `.method(args)` and `[index]`, chained as far as they go.
fn (mut self: Unit) parse_postfix(src: String) -> Int allocates {
    let mut node: Int = self.parse_primary(src);
    while node >= 0 {
        if self.at(23) {                             // '.'
            let here: Int = self.pos;
            let n: Int = self.advance();
            if !self.at(1) {
                return self.complain(src, "a field or method name after `.`");
            }
            let name_tok: Int = self.pos;
            let m: Int = self.advance();
            if self.at(29) {                         // '(' — a method call
                let args: Int = self.parse_args(src);
                if args < 0 { return -1; }
                node = self.add(14, node, args, 0, 0, name_tok);
                continue;
            }
            node = self.add(11, node, 0, 0, 0, name_tok);
            continue;
        }
        if self.at(33) {                             // '['
            let here: Int = self.pos;
            let n: Int = self.advance();
            let index: Int = self.parse_expr(src);
            if index < 0 { return -1; }
            if !self.eat(src, 34, "`]` closing the index") { return -1; }
            node = self.add(12, node, index, 0, 0, here);
            continue;
        }
        break;
    }
    return node;
}

// An argument list. Returns a node holding (start, count) into `kids`.
fn (mut self: Unit) parse_args(src: String) -> Int allocates {
    let here: Int = self.pos;
    if !self.eat(src, 29, "`(`") { return -1; }
    // Collect the argument node indices locally first: parsing one appends its whole
    // subtree to `nodes`, but nothing to `kids`, so the indices stay contiguous.
    let base: Int = len(self.stack);
    let mut count: Int = 0;
    while !self.at(30) {                             // until ')'
        let arg: Int = self.parse_expr(src);
        if arg < 0 { return -1; }
        push(self.stack, arg);
        count = count + 1;
        if self.at(22) {                             // ','
            let n: Int = self.advance();
            continue;
        }
        break;
    }
    if !self.eat(src, 30, "`)` closing the arguments") { return -1; }
    let start: Int = self.commit(base);
    return self.add(15, start, count, 0, 0, here);
}

fn (mut self: Unit) parse_primary(src: String) -> Int allocates {
    let here: Int = self.pos;
    let k: Int = self.kind_at(0);
    if k == 2 {
        let value: Int = self.toks[self.pos].value;
        let n: Int = self.advance();
        return self.add(1, 0, 0, 0, value, here);
    }
    if k == 3 {
        let t: Tok = self.toks[self.pos];
        let n: Int = self.advance();
        // The unscaled integer and the scale, carried exactly as the lexer read them.
        return self.add(2, t.scale, 0, 0, t.value, here);
    }
    if k == 4 {
        let n: Int = self.advance();
        return self.add(3, 0, 0, 0, 0, here);
    }
    if k == 120 || k == 121 {                        // true / false
        let n: Int = self.advance();
        let truth: Int = 0;
        if k == 120 { return self.add(4, 0, 0, 0, 1, here); }
        return self.add(4, 0, 0, 0, 0, here);
    }
    if k == 29 {                                     // '(' grouping
        let n: Int = self.advance();
        let inner: Int = self.parse_expr(src);
        if inner < 0 { return -1; }
        if !self.eat(src, 30, "`)` closing the group") { return -1; }
        return inner;
    }
    if k == 33 {                                     // '[' — an array or slice literal
        let n: Int = self.advance();
        let base: Int = len(self.stack);
        let mut count: Int = 0;
        while !self.at(34) {                         // until ']'
            let item: Int = self.parse_expr(src);
            if item < 0 { return -1; }
            push(self.stack, item);
            count = count + 1;
            if self.at(22) {                         // ','
                let c: Int = self.advance();
                continue;
            }
            break;
        }
        if !self.eat(src, 34, "`]` closing the literal") { return -1; }
        let start: Int = self.commit(base);
        return self.add(17, start, count, 0, 0, here);
    }
    if k == 1 || k == 119 || (k >= 140 && k <= 145) {  // a name, `self`, or a type name
        let name_tok: Int = self.pos;
        let n: Int = self.advance();
        if self.at(29) {                             // a call
            let args: Int = self.parse_args(src);
            if args < 0 { return -1; }
            return self.add(13, args, 0, 0, 0, name_tok);
        }
        if self.at(31) && self.no_struct == 0 {      // `Name { field: value }`
            let m: Int = self.advance();
            let base: Int = len(self.stack);
            let mut count: Int = 0;
            while !self.at(32) {                     // until '}'
                if !self.at(1) {
                    return self.complain(src, "a field name");
                }
                let field_tok: Int = self.pos;
                let f: Int = self.advance();
                if !self.eat(src, 20, "`:` after the field name") { return -1; }
                let value: Int = self.parse_expr(src);
                if value < 0 { return -1; }
                // One kid per field: the value, with the field's token on the node.
                let pair: Int = self.add(18, value, 0, 0, 0, field_tok);
                push(self.stack, pair);
                count = count + 1;
                if self.at(22) {                     // ',' — trailing one allowed
                    let c: Int = self.advance();
                    continue;
                }
                break;
            }
            if !self.eat(src, 32, "`\}` closing the literal") { return -1; }
            let start: Int = self.commit(base);
            return self.add(19, start, count, 0, 0, name_tok);
        }
        return self.add(5, 0, 0, 0, 0, name_tok);
    }
    return self.complain(src, "an expression");
}

// ---- statements --------------------------------------------------------------
// A block: a node holding (start, count) into `kids`, like an argument list.
// Move the scratch stack's entries above `base` into `kids`, and answer where they
// landed. Every child list goes through here for one reason: a list built by pushing
// straight into `kids` is NOT contiguous, because parsing element two pushes element
// two's own children first. That is the defect this repairs — the scratch stack is a
// stack, so an inner list is committed and popped before an outer one continues, and
// the entries that remain above `base` are exactly this list's, in order.
fn (mut self: Unit) commit(base: Int) -> Int allocates {
    let start: Int = len(self.kids);
    let mut i: Int = base;
    while i < len(self.stack) {
        push(self.kids, self.stack[i]);
        i = i + 1;
    }
    let dropped: Int = truncate(self.stack, base);
    return start;
}

fn (mut self: Unit) parse_block(src: String) -> Int allocates {
    let here: Int = self.pos;
    if !self.eat(src, 31, "`\{` opening a block") { return -1; }
    let base: Int = len(self.stack);
    let mut count: Int = 0;
    while !self.at(32) && !self.done() {             // until '}'
        let stmt: Int = self.parse_stmt(src);
        if stmt < 0 { return -1; }
        push(self.stack, stmt);
        count = count + 1;
    }
    if !self.eat(src, 32, "`\}` closing a block") { return -1; }
    let start: Int = self.commit(base);
    return self.add(16, start, count, 0, 0, here);
}
fn (mut self: Unit) parse_stmt(src: String) -> Int allocates {
    let here: Int = self.pos;
    let k: Int = self.kind_at(0);

    if k == 100 {                                    // let
        let n: Int = self.advance();
        let mut mutable: Int = 0;
        if self.at(101) {                            // mut
            mutable = 1;
            let m: Int = self.advance();
        }
        if !self.at(1) { return self.complain(src, "a name after `let`"); }
        let name_tok: Int = self.pos;
        let m2: Int = self.advance();
        if !self.eat(src, 20, "`:` and a type — every `let` declares one") { return -1; }
        let ty: Int = self.parse_type(src);
        if ty < 0 { return -1; }
        if !self.eat(src, 24, "`=` and an initial value") { return -1; }
        let value: Int = self.parse_expr(src);
        if value < 0 { return -1; }
        if !self.eat(src, 21, "`;`") { return -1; }
        return self.add(60, ty, value, 0, mutable, name_tok);
    }
    if k == 118 {                                    // print
        let n: Int = self.advance();
        if !self.eat(src, 29, "`(` after `print`") { return -1; }
        let value: Int = self.parse_expr(src);
        if value < 0 { return -1; }
        if !self.eat(src, 30, "`)`") { return -1; }
        if !self.eat(src, 21, "`;`") { return -1; }
        return self.add(62, value, 0, 0, 0, here);
    }
    if k == 103 {                                    // return
        let n: Int = self.advance();
        let mut kind: Int = 63;
        if self.at(123) {                            // tail
            kind = 64;
            let m: Int = self.advance();
        }
        let value: Int = self.parse_expr(src);
        if value < 0 { return -1; }
        if !self.eat(src, 21, "`;`") { return -1; }
        return self.add(kind, value, 0, 0, 0, here);
    }
    if k == 104 {                                    // if
        let n: Int = self.advance();
        self.no_struct = self.no_struct + 1;
        let cond: Int = self.parse_expr(src);
        self.no_struct = self.no_struct - 1;
        if cond < 0 { return -1; }
        let then_block: Int = self.parse_block(src);
        if then_block < 0 { return -1; }
        let mut else_block: Int = -1;
        if self.at(105) {                            // else
            let m: Int = self.advance();
            if self.at(104) {
                // `else if` is an else-block holding one if-statement.
                else_block = self.parse_stmt(src);
            } else {
                else_block = self.parse_block(src);
            }
            if else_block < 0 { return -1; }
        }
        return self.add(65, cond, then_block, else_block, 0, here);
    }
    if k == 106 {                                    // while
        let n: Int = self.advance();
        self.no_struct = self.no_struct + 1;
        let cond: Int = self.parse_expr(src);
        self.no_struct = self.no_struct - 1;
        if cond < 0 { return -1; }
        let body: Int = self.parse_block(src);
        if body < 0 { return -1; }
        return self.add(66, cond, body, 0, 0, here);
    }
    if k == 107 {                                    // break
        let n: Int = self.advance();
        if !self.eat(src, 21, "`;`") { return -1; }
        return self.add(67, 0, 0, 0, 0, here);
    }
    if k == 108 {                                    // continue
        let n: Int = self.advance();
        if !self.eat(src, 21, "`;`") { return -1; }
        return self.add(68, 0, 0, 0, 0, here);
    }
    if k == 111 {                                    // match
        let n: Int = self.advance();
        self.no_struct = self.no_struct + 1;
        let value: Int = self.parse_expr(src);
        self.no_struct = self.no_struct - 1;
        if value < 0 { return -1; }
        if !self.eat(src, 31, "`\{` opening the arms") { return -1; }
        let base: Int = len(self.stack);
        let mut count: Int = 0;
        while !self.at(32) && !self.done() {         // until '}'
            // `Variant => { ... }` or `Variant(a, b) => { ... }`. Every arm names a
            // variant: there is no wildcard, on purpose.
            if !self.at(1) {
                return self.complain(src, "a variant name — Burxt has no `_` arm");
            }
            let variant_tok: Int = self.pos;
            let v: Int = self.advance();
            let bind_start: Int = len(self.subs);
            let mut binds: Int = 0;
            if self.at(29) {                         // '(' bindings
                let p: Int = self.advance();
                while !self.at(30) {
                    if !self.at(1) {
                        return self.complain(src, "a name to bind the payload to");
                    }
                    push(self.subs, self.pos);
                    binds = binds + 1;
                    let b: Int = self.advance();
                    if self.at(22) {
                        let c: Int = self.advance();
                        continue;
                    }
                    break;
                }
                if !self.eat(src, 30, "`)` closing the bindings") { return -1; }
            }
            if !self.eat(src, 11, "`=>` after the variant") { return -1; }
            let body: Int = self.parse_block(src);
            if body < 0 { return -1; }
            let arm: Int = self.add(20, body, bind_start, binds, 0, variant_tok);
            push(self.stack, arm);
            count = count + 1;
        }
        if !self.eat(src, 32, "`\}` closing the arms") { return -1; }
        let start: Int = self.commit(base);
        return self.add(71, value, start, count, 0, here);
    }
    if k == 117 {                                    // region
        let n: Int = self.advance();
        if !self.at(1) { return self.complain(src, "a name for the region"); }
        let name_tok: Int = self.pos;
        let m: Int = self.advance();
        let body: Int = self.parse_block(src);
        if body < 0 { return -1; }
        return self.add(69, body, 0, 0, 0, name_tok);
    }

    // Anything else starts with an expression: an assignment or a call kept for its
    // effect. Parse the expression first and let what follows decide which.
    let target: Int = self.parse_expr(src);
    if target < 0 { return -1; }
    if self.at(24) {                                 // '='
        let n: Int = self.advance();
        let value: Int = self.parse_expr(src);
        if value < 0 { return -1; }
        if !self.eat(src, 21, "`;`") { return -1; }
        return self.add(61, target, value, 0, 0, here);
    }
    if !self.eat(src, 21, "`;`") { return -1; }
    return self.add(70, target, 0, 0, 0, here);
}


// ============================================================================
// PHASE 3b: items. fn, struct, enum, trait, impl, extern — with the markers and
// contract clauses that make a Burxt signature say what it promises.
// ============================================================================
//   80 fn        81 method    82 struct   83 enum   84 trait   85 impl   86 extern
//   90 parameter (type in `a`, marshalled in `value`, name token on the node)
//   91 field     92 variant (payload list in (b, c))
//   93 contract clause (expression in `a`, which clause in `value`)

// A parameter list: `(name: Type, name: Type as scaled)`. Returns (start, count).
fn (mut self: Unit) parse_params(src: String) -> Int allocates {
    let here: Int = self.pos;
    if !self.eat(src, 29, "`(` opening the parameters") { return -1; }
    let base: Int = len(self.stack);
    let mut count: Int = 0;
    while !self.at(30) {                             // until ')'
        if !self.at(1) {
            return self.complain(src, "a parameter name");
        }
        let name_tok: Int = self.pos;
        let n: Int = self.advance();
        if !self.eat(src, 20, "`:` and the parameter's type") { return -1; }
        let ty: Int = self.parse_type(src);
        if ty < 0 { return -1; }
        // `amount: Decimal<2> as scaled` — a boundary marshaller.
        let mut marshalled: Int = 0;
        if self.at(122) {                            // as
            let a: Int = self.advance();
            if !self.at(1) {
                return self.complain(src, "a marshaller name, e.g. `scaled`");
            }
            marshalled = 1;
            let m: Int = self.advance();
        }
        let param: Int = self.add(90, ty, 0, 0, marshalled, name_tok);
        push(self.stack, param);
        count = count + 1;
        if self.at(22) {                             // ','
            let c: Int = self.advance();
            continue;
        }
        break;
    }
    if !self.eat(src, 30, "`)` closing the parameters") { return -1; }
    let start: Int = self.commit(base);
    return self.add(15, start, count, 0, 0, here);
}

// `requires`, `ensures` and `decreases`, between the signature and the body.
fn (mut self: Unit) parse_clauses(src: String, ret: Int) -> Int allocates {
    let here: Int = self.pos;
    let base: Int = len(self.stack);
    let mut count: Int = 0;
    while self.at_word(src, "requires") || self.at_word(src, "ensures")
          || self.at_word(src, "decreases") {
        // Which clause, decided before the word is consumed.
        let mut which: Int = 126;
        if self.at_word(src, "ensures") { which = 127; }
        if self.at_word(src, "decreases") { which = 128; }
        let n: Int = self.advance();
        // A clause is a condition, so a `{` after it opens the BODY.
        self.no_struct = self.no_struct + 1;
        let cond: Int = self.parse_expr(src);
        self.no_struct = self.no_struct - 1;
        if cond < 0 { return -1; }
        let clause: Int = self.add(93, cond, 0, 0, which, here);
        push(self.stack, clause);
        count = count + 1;
    }
    let start: Int = self.commit(base);
    return self.add(15, start, count, ret, 0, here);
}

// `fn name(params) -> Type [allocates] [clauses] { body }`, or a method when a
// receiver clause follows `fn`. `pure` precedes the whole thing.
fn (mut self: Unit) parse_fn(src: String, is_pure: Int) -> Int allocates {
    let here: Int = self.pos;
    if !self.eat(src, 102, "`fn`") { return -1; }

    // `fn (self: T) name(...)` and `fn (mut self: T) name(...)` are methods: the
    // `(` right after `fn` is the tell, exactly as in the Rust parser.
    let mut receiver_tok: Int = -1;
    let mut receiver_mut: Int = 0;
    if self.at(29) {
        let n: Int = self.advance();
        if self.at(101) {                            // mut
            receiver_mut = 1;
            let m: Int = self.advance();
        }
        if !self.eat(src, 119, "`self` in the receiver clause") { return -1; }
        if !self.eat(src, 20, "`:` and the receiver's type") { return -1; }
        if !self.at(1) {
            return self.complain(src, "a struct name after `self:`");
        }
        receiver_tok = self.pos;
        let r: Int = self.advance();
        if !self.eat(src, 30, "`)` closing the receiver clause") { return -1; }
    }

    if !self.at(1) {
        return self.complain(src, "a function name");
    }
    let name_tok: Int = self.pos;
    let n2: Int = self.advance();
    let params: Int = self.parse_params(src);
    if params < 0 { return -1; }
    if !self.eat(src, 10, "`->` and a return type — every Burxt function returns one") {
        return -1;
    }
    let ret: Int = self.parse_type(src);
    if ret < 0 { return -1; }
    let mut builds_in_caller: Int = 0;
    if self.at_word(src, "allocates") {              // contextual: only here does the
        builds_in_caller = 1;                        // word mean the marker.
        let a: Int = self.advance();
    }
    let clauses: Int = self.parse_clauses(src, ret);
    if clauses < 0 { return -1; }
    let body: Int = self.parse_block(src);
    if body < 0 { return -1; }

    // The markers ride in `value` as bits: pure, allocates, mutating receiver.
    let mut flags: Int = 0;
    if is_pure == 1 { flags = flags + 1; }
    if builds_in_caller == 1 { flags = flags + 2; }
    if receiver_mut == 1 { flags = flags + 4; }
    if receiver_tok >= 0 {
        // A method: the receiver's token goes in `c`, so nothing is lost.
        let m: Int = self.add(81, params, body, receiver_tok, flags, name_tok);
        return m;
    }
    let f: Int = self.add(80, params, body, clauses, flags, name_tok);
    return f;
}

// `struct Name { field: Type, ... }`
fn (mut self: Unit) parse_struct(src: String) -> Int allocates {
    if !self.eat(src, 109, "`struct`") { return -1; }
    if !self.at(1) { return self.complain(src, "a struct name"); }
    let name_tok: Int = self.pos;
    let n: Int = self.advance();
    if !self.eat(src, 31, "`\{` opening the fields") { return -1; }
    let base: Int = len(self.stack);
    let mut count: Int = 0;
    while !self.at(32) && !self.done() {
        if !self.at(1) { return self.complain(src, "a field name"); }
        let field_tok: Int = self.pos;
        let f: Int = self.advance();
        if !self.eat(src, 20, "`:` and the field's type") { return -1; }
        let ty: Int = self.parse_type(src);
        if ty < 0 { return -1; }
        let field: Int = self.add(91, ty, 0, 0, 0, field_tok);
        push(self.stack, field);
        count = count + 1;
        if self.at(22) {
            let c: Int = self.advance();
            continue;
        }
        break;
    }
    if !self.eat(src, 32, "`\}` closing the fields") { return -1; }
    let start: Int = self.commit(base);
    return self.add(82, start, count, 0, 0, name_tok);
}

// `enum Name { Variant, Variant(Type, Type), ... }`
fn (mut self: Unit) parse_enum(src: String) -> Int allocates {
    if !self.eat(src, 110, "`enum`") { return -1; }
    if !self.at(1) { return self.complain(src, "an enum name"); }
    let name_tok: Int = self.pos;
    let n: Int = self.advance();
    if !self.eat(src, 31, "`\{` opening the variants") { return -1; }
    let base: Int = len(self.stack);
    let mut count: Int = 0;
    while !self.at(32) && !self.done() {
        if !self.at(1) { return self.complain(src, "a variant name"); }
        let variant_tok: Int = self.pos;
        let v: Int = self.advance();
        let payload_start: Int = len(self.subs);
        let mut payload: Int = 0;
        if self.at(29) {                             // '(' — a payload
            let p: Int = self.advance();
            while !self.at(30) {
                let ty: Int = self.parse_type(src);
                if ty < 0 { return -1; }
                push(self.subs, ty);
                payload = payload + 1;
                if self.at(22) {
                    let c: Int = self.advance();
                    continue;
                }
                break;
            }
            if !self.eat(src, 30, "`)` closing the payload") { return -1; }
        }
        let variant: Int = self.add(92, 0, payload_start, payload, 0, variant_tok);
        push(self.stack, variant);
        count = count + 1;
        if self.at(22) {
            let c: Int = self.advance();
            continue;
        }
        break;
    }
    if !self.eat(src, 32, "`\}` closing the variants") { return -1; }
    let start: Int = self.commit(base);
    return self.add(83, start, count, 0, 0, name_tok);
}

// `trait Name { fn sig(self) -> Type }` — signatures only, no bodies.
fn (mut self: Unit) parse_trait(src: String) -> Int allocates {
    if !self.eat(src, 112, "`trait`") { return -1; }
    if !self.at(1) { return self.complain(src, "a trait name"); }
    let name_tok: Int = self.pos;
    let n: Int = self.advance();
    if !self.eat(src, 31, "`\{` opening the trait") { return -1; }
    let base: Int = len(self.stack);
    let mut count: Int = 0;
    while !self.at(32) && !self.done() {
        if !self.eat(src, 102, "`fn` — a trait holds signatures") { return -1; }
        if !self.at(1) { return self.complain(src, "a method name"); }
        let method_tok: Int = self.pos;
        let m: Int = self.advance();
        if !self.eat(src, 29, "`(` and a receiver") { return -1; }
        let mut receiver_mut: Int = 0;
        if self.at(101) {
            receiver_mut = 1;
            let mu: Int = self.advance();
        }
        if !self.eat(src, 119, "`self`") { return -1; }
        // A trait signature may take parameters after `self`.
        let extra_start: Int = len(self.subs);
        let mut extra: Int = 0;
        while self.at(22) {                          // ',' more parameters
            let c: Int = self.advance();
            if !self.at(1) { return self.complain(src, "a parameter name"); }
            let pname: Int = self.pos;
            let pn: Int = self.advance();
            if !self.eat(src, 20, "`:` and the parameter's type") { return -1; }
            let ty: Int = self.parse_type(src);
            if ty < 0 { return -1; }
            let param: Int = self.add(90, ty, 0, 0, 0, pname);
            push(self.subs, param);
            extra = extra + 1;
        }
        if !self.eat(src, 30, "`)`") { return -1; }
        if !self.eat(src, 10, "`->` and a return type") { return -1; }
        let ret: Int = self.parse_type(src);
        if ret < 0 { return -1; }
        let sig: Int = self.add(94, ret, extra_start, extra, receiver_mut, method_tok);
        push(self.stack, sig);
        count = count + 1;
    }
    if !self.eat(src, 32, "`\}` closing the trait") { return -1; }
    let start: Int = self.commit(base);
    return self.add(84, start, count, 0, 0, name_tok);
}

// `impl Trait for Type { methods }`
fn (mut self: Unit) parse_impl(src: String) -> Int allocates {
    if !self.eat(src, 113, "`impl`") { return -1; }
    if !self.at(1) { return self.complain(src, "a trait name"); }
    let trait_tok: Int = self.pos;
    let t: Int = self.advance();
    if !self.eat(src, 114, "`for`") { return -1; }
    if !self.at(1) { return self.complain(src, "the type implementing the trait"); }
    let type_tok: Int = self.pos;
    let ty: Int = self.advance();
    if !self.eat(src, 31, "`\{` opening the impl") { return -1; }
    let base: Int = len(self.stack);
    let mut count: Int = 0;
    while !self.at(32) && !self.done() {
        let method: Int = self.parse_fn(src, 0);
        if method < 0 { return -1; }
        push(self.stack, method);
        count = count + 1;
    }
    if !self.eat(src, 32, "`\}` closing the impl") { return -1; }
    let start: Int = self.commit(base);
    return self.add(85, start, count, type_tok, 0, trait_tok);
}

// `extern fn name(params) -> Type;` — no body, and none allowed.
fn (mut self: Unit) parse_extern(src: String) -> Int allocates {
    if !self.eat(src, 116, "`extern`") { return -1; }
    if !self.eat(src, 102, "`fn` after `extern`") { return -1; }
    if !self.at(1) { return self.complain(src, "a function name"); }
    let name_tok: Int = self.pos;
    let n: Int = self.advance();
    let params: Int = self.parse_params(src);
    if params < 0 { return -1; }
    if !self.eat(src, 10, "`->` and a return type") { return -1; }
    let ret: Int = self.parse_type(src);
    if ret < 0 { return -1; }
    if !self.eat(src, 21, "`;` — an extern declaration has no body") { return -1; }
    return self.add(86, params, ret, 0, 0, name_tok);
}

// One item, or a top-level statement: the same dispatch the Rust parser makes.
fn (mut self: Unit) parse_item(src: String) -> Int allocates {
    let k: Int = self.kind_at(0);
    if k == 124 {                                    // pure fn
        let n: Int = self.advance();
        return self.parse_fn(src, 1);
    }
    if k == 102 { return self.parse_fn(src, 0); }
    if k == 109 { return self.parse_struct(src); }
    if k == 110 { return self.parse_enum(src); }
    if k == 112 { return self.parse_trait(src); }
    if k == 113 { return self.parse_impl(src); }
    if k == 116 { return self.parse_extern(src); }
    return self.parse_stmt(src);
}

// Step over an item without reading it: phase 3b parses these, and until then the
// driver must not mistake a function body for top-level code.
fn (mut self: Unit) skip_item() -> Int {
    let mut braces: Int = 0;
    let mut nesting: Int = 0;
    let mut seen_brace: Bool = false;
    while !self.done() {
        let k: Int = self.kind_at(0);
        if k == 31 {
            braces = braces + 1;
            seen_brace = true;
        }
        if k == 32 { braces = braces - 1; }
        // Parentheses and brackets are counted too, and the reason is a bug this
        // caught: `fn f(xs: [Int; 3])` contains a SEMICOLON, inside the array type.
        // Treating any semicolon as the end of a bodyless `extern` declaration
        // stopped the skip in the middle of a signature.
        if k == 29 || k == 33 { nesting = nesting + 1; }
        if k == 30 || k == 34 { nesting = nesting - 1; }
        let n: Int = self.advance();
        if seen_brace && braces == 0 {
            break;
        }
        if !seen_brace && k == 21 && nesting == 0 {
            break;
        }
    }
    return self.pos;
}


// ============================================================================
// PHASE 4: the typechecker. Types in, refusals out — the same rules the Rust
// compiler enforces, applied to the AST the parser just built.
// ============================================================================

fn ty_unknown() -> Ty {
    return Ty { kind: 0, scale: 0, contract: 0, name_start: 0, name_len: 0 };
}

fn ty_simple(kind: Int) -> Ty {
    return Ty { kind: kind, scale: 0, contract: 0, name_start: 0, name_len: 0 };
}

fn ty_decimal(scale: Int, contract: Int) -> Ty {
    return Ty { kind: 45, scale: scale, contract: contract, name_start: 0, name_len: 0 };
}

// An unknown type never equals anything, including another unknown: one bad
// expression must not make every later comparison succeed. The stage-1 checker in
// examples/checker.bx learned this the hard way, and so did stage-0's recovery.
fn is_unknown(t: Ty) -> Bool {
    return t.kind == 0;
}

fn ty_same(src: String, a: Ty, b: Ty) -> Bool {
    if a.kind == 0 || b.kind == 0 {
        return false;
    }
    if a.kind != b.kind {
        return false;
    }
    if a.kind == 45 {
        // The rounding contract is part of the type, so it is part of equality.
        return a.scale == b.scale && a.contract == b.contract;
    }
    if a.kind == 46 || a.kind == 49 {
        return spans_eq(src, a.name_start, a.name_len, b.name_start, b.name_len);
    }
    return true;
}

fn ty_show(src: String, t: Ty) -> String allocates {
    if t.kind == 0 { return "?"; }
    if t.kind == 40 { return "Int"; }
    if t.kind == 41 { return "Bool"; }
    if t.kind == 42 { return "String"; }
    if t.kind == 43 { return "CInt"; }
    if t.kind == 44 { return "CDouble"; }
    if t.kind == 45 {
        if t.contract == 1 {
            return "Decimal<" + to_string(t.scale) + ", RoundHalfEven>";
        }
        if t.contract == 2 {
            return "Decimal<" + to_string(t.scale) + ", RoundHalfUp>";
        }
        return "Decimal<" + to_string(t.scale) + ">";
    }
    if t.kind == 47 { return "a growable array"; }
    if t.kind == 48 { return "an array"; }
    if t.kind == 49 { return "dyn " + substring(src, t.name_start, t.name_len); }
    return substring(src, t.name_start, t.name_len);
}

// Read a type NODE into a Ty.
fn (self: Unit) ty_of(src: String, node: Int) -> Ty {
    if node < 0 {
        return ty_unknown();
    }
    let n: Node = self.nodes[node];
    if n.kind == 45 {
        return ty_decimal(n.a, n.b);
    }
    if n.kind == 46 || n.kind == 49 {
        let t: Tok = self.toks[n.tok];
        return Ty { kind: n.kind, scale: 0, contract: 0,
                    name_start: t.start, name_len: t.length };
    }
    if n.kind == 47 || n.kind == 48 {
        // `scale` holds the ELEMENT type's node for a slice or an array, and
        // `contract` the declared length. Reusing two fields rather than widening a
        // struct that is copied at every comparison in the checker.
        return Ty { kind: n.kind, scale: n.a, contract: n.b,
                    name_start: 0, name_len: 0 };
    }
    if n.kind >= 40 && n.kind <= 48 {
        return ty_simple(n.kind);
    }
    return ty_unknown();
}

fn (mut self: Unit) complain_at(src: String, tok: Int, message: String) -> Int allocates {
    let t: Tok = self.toks[tok];
    print("error: " + message + " (at `" + substring(src, t.start, t.length) + "`)");
    self.problems = self.problems + 1;
    return 0;
}

// ---- declarations ------------------------------------------------------------
fn (self: Unit) find_sym(src: String, start: Int, length: Int) -> Int {
    // Backwards: the innermost binding with this name is the one in scope.
    let mut i: Int = len(self.syms) - 1;
    while i >= 0 {
        if spans_eq(src, self.syms[i].start, self.syms[i].length, start, length) {
            return i;
        }
        i = i - 1;
    }
    return -1;
}

fn (self: Unit) find_fun(src: String, start: Int, length: Int) -> Int {
    let mut i: Int = 0;
    while i < len(self.funs) {
        if spans_eq(src, self.funs[i].start, self.funs[i].length, start, length) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn (self: Unit) find_type(src: String, start: Int, length: Int) -> Int {
    let mut i: Int = 0;
    while i < len(self.types) {
        if spans_eq(src, self.types[i].start, self.types[i].length, start, length) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// Every signature first, so functions may be declared in any order and call each
// other — the same two-pass shape stage-0 uses.
fn (mut self: Unit) collect_declarations(src: String) -> Int allocates {
    let mut i: Int = 0;
    while i < len(self.items) {
        let index: Int = self.items[i];
        let item: Node = self.nodes[index];
        let name: Tok = self.toks[item.tok];
        if item.kind == 82 || item.kind == 83 {
            if self.find_type(src, name.start, name.length) >= 0 {
                let e: Int = self.complain_at(src, item.tok, "this type is declared twice");
            } else {
                push(self.types, TypeDecl { start: name.start, length: name.length,
                                            kind: item.kind, node: index });
            }
        }
        if item.kind == 81 {                         // a method
            let receiver: Tok = self.toks[item.c];
            let signature: Node = self.nodes[item.b];
            // A method node holds (params, body, receiver token); its return type is
            // on the clause node the body follows, so it is read from the item.
            let mut mutating: Int = 0;
            if item.value >= 4 { mutating = 1; }
            push(self.methods, Method {
                receiver_start: receiver.start, receiver_len: receiver.length,
                start: name.start, length: name.length,
                ret: ty_unknown(), params: item.a, mutating: mutating,
            });
        }
        if item.kind == 80 || item.kind == 86 {
            if self.find_fun(src, name.start, name.length) >= 0 {
                let e: Int = self.complain_at(src, item.tok, "this function is declared twice");
            } else {
                let mut ret: Ty = ty_unknown();
                if item.kind == 80 {
                    let signature: Node = self.nodes[item.c];
                    ret = self.ty_of(src, signature.c);
                } else {
                    ret = self.ty_of(src, item.b);   // an extern holds it directly
                }
                push(self.funs, Fun { start: name.start, length: name.length,
                                      ret: ret, params: item.a, flags: item.value });
            }
        }
        i = i + 1;
    }
    return len(self.funs);
}

// ---- expressions -------------------------------------------------------------
// `expected` carries the declared type inward, which is how a Decimal product can
// know whether a rounding contract was supplied — exactly as in stage-0.
fn (mut self: Unit) type_of(src: String, node: Int, expected: Ty) -> Ty allocates {
    if node < 0 {
        return ty_unknown();
    }
    let n: Node = self.nodes[node];

    if n.kind == 1 { return ty_simple(40); }
    if n.kind == 2 { return ty_decimal(n.a, expected.contract); }
    if n.kind == 3 { return ty_simple(42); }
    if n.kind == 4 { return ty_simple(41); }

    if n.kind == 5 {                                 // a name
        let t: Tok = self.toks[n.tok];
        let found: Int = self.find_sym(src, t.start, t.length);
        if found < 0 {
            let e: Int = self.complain_at(src, n.tok, "unknown name");
            return ty_unknown();
        }
        return self.syms[found].ty;
    }

    if n.kind == 6 {                                 // -x
        return self.type_of(src, n.a, expected);
    }
    if n.kind == 7 {                                 // !x
        let inner: Ty = self.type_of(src, n.a, ty_simple(41));
        if !is_unknown(inner) && inner.kind != 41 {
            let e: Int = self.complain_at(src, n.tok,
                "`!` needs a Bool, but this is " + ty_show(src, inner));
        }
        return ty_simple(41);
    }

    if n.kind == 8 {                                 // a + b, a * b
        let left: Ty = self.type_of(src, n.a, expected);
        let right: Ty = self.type_of(src, n.b, expected);
        if is_unknown(left) || is_unknown(right) {
            return ty_unknown();
        }
        // `*` combines a quantity with a rate, so the scales may differ — but the
        // product's scale is their SUM, and landing it needs a declared contract.
        if n.value == 27 {
            if left.kind == 45 && right.kind == 45 {
                if expected.contract == 0 {
                    let e: Int = self.complain_at(src, n.tok,
                        "`*` on " + ty_show(src, left) + " and " + ty_show(src, right)
                        + " needs a rounding contract: the exact product has "
                        + to_string(left.scale + right.scale) + " decimal places");
                    return ty_unknown();
                }
                return expected;
            }
            if left.kind == 45 && right.kind == 40 { return left; }
            if left.kind == 40 && right.kind == 45 { return right; }
        }
        if n.value == 28 && left.kind == 40 && right.kind == 40 {
            let e: Int = self.complain_at(src, n.tok,
                "`/` on two Ints would have to round, and one operator cannot say "
                + "which way — use div_floor, div_trunc or rem");
            return ty_unknown();
        }
        // `+` and `-` combine like quantities: the types must match exactly.
        if !ty_same(src, left, right) {
            let e: Int = self.complain_at(src, n.tok,
                "cannot combine " + ty_show(src, left) + " and " + ty_show(src, right)
                + ": addition and subtraction need the same type, scale included");
            return ty_unknown();
        }
        return left;
    }

    if n.kind == 9 {                                 // a comparison
        let left: Ty = self.type_of(src, n.a, ty_unknown());
        let right: Ty = self.type_of(src, n.b, left);
        if !is_unknown(left) && !is_unknown(right) && !ty_same(src, left, right) {
            let e: Int = self.complain_at(src, n.tok,
                "cannot compare " + ty_show(src, left) + " with " + ty_show(src, right)
                + ": one equality, no coercion");
        }
        return ty_simple(41);
    }

    if n.kind == 10 {                                // && ||
        let left: Ty = self.type_of(src, n.a, ty_simple(41));
        let right: Ty = self.type_of(src, n.b, ty_simple(41));
        if !is_unknown(left) && left.kind != 41 {
            let e: Int = self.complain_at(src, n.tok, "this operator needs a Bool");
        }
        if !is_unknown(right) && right.kind != 41 {
            let e: Int = self.complain_at(src, n.tok, "this operator needs a Bool");
        }
        return ty_simple(41);
    }

    // `Enum.Variant` and `Enum.Variant(payload)` — the base names a TYPE, not a
    // variable, so typing it as one reported an unknown name. An enum constructor
    // looks exactly like a field access or a method call until you check the base.
    if n.kind == 11 || n.kind == 14 {
        let base: Node = self.nodes[n.a];
        if base.kind == 5 {
            let base_name: Tok = self.toks[base.tok];
            let declared: Int = self.find_type(src, base_name.start, base_name.length);
            if declared >= 0 {
                if self.types[declared].kind == 83 {
                    if n.kind == 14 {
                        let visited: Int = self.check_args(src, n.b);
                    }
                    return Ty { kind: 46, scale: 0, contract: 0,
                                name_start: base_name.start, name_len: base_name.length };
                }
            }
        }
    }

    if n.kind == 12 {                                // xs[i]
        let holder: Ty = self.type_of(src, n.a, ty_unknown());
        let index: Ty = self.type_of(src, n.b, ty_simple(40));
        if !is_unknown(index) && index.kind != 40 {
            let e: Int = self.complain_at(src, n.tok, "an index must be an Int");
        }
        if is_unknown(holder) {
            return ty_unknown();
        }
        if holder.kind == 42 {
            let e: Int = self.complain_at(src, n.tok,
                "a String is indexed with byte_at(s, i), which says it reads a BYTE");
            return ty_unknown();
        }
        if holder.kind != 47 && holder.kind != 48 {
            let e: Int = self.complain_at(src, n.tok,
                "indexing needs an array, but this is " + ty_show(src, holder));
            return ty_unknown();
        }
        return self.ty_of(src, holder.scale);
    }

    if n.kind == 14 {                                // a method call on a value
        let holder: Ty = self.type_of(src, n.a, ty_unknown());
        let visited: Int = self.check_args(src, n.b);
        if is_unknown(holder) {
            return ty_unknown();
        }
        let found: Int = self.find_method(src, holder, n.tok);
        if found < 0 {
            let e: Int = self.complain_at(src, n.tok,
                ty_show(src, holder) + " has no such method");
            return ty_unknown();
        }
        // The return type is read from the declaration when 4b completes; for now the
        // call is accepted and its type left open rather than guessed.
        return ty_unknown();
    }

    if n.kind == 11 {                                // a field access
        let holder: Ty = self.type_of(src, n.a, ty_unknown());
        if is_unknown(holder) {
            return ty_unknown();
        }
        let field: Ty = self.field_type(src, holder, n.tok);
        if is_unknown(field) {
            let e: Int = self.complain_at(src, n.tok,
                ty_show(src, holder) + " has no such field");
        }
        return field;
    }

    if n.kind == 19 {                                // a struct literal
        let name: Tok = self.toks[n.tok];
        let found: Int = self.find_type(src, name.start, name.length);
        if found < 0 {
            let e: Int = self.complain_at(src, n.tok, "unknown type");
            let visited: Int = self.visit_children(src, node);
            return ty_unknown();
        }
        let holder: Ty = Ty { kind: 46, scale: 0, contract: 0,
                              name_start: name.start, name_len: name.length };
        let mut i: Int = 0;
        while i < n.b {
            let pair: Node = self.nodes[self.kids[n.a + i]];
            let want: Ty = self.field_type(src, holder, pair.tok);
            if is_unknown(want) {
                let e: Int = self.complain_at(src, pair.tok,
                    ty_show(src, holder) + " has no such field");
            }
            let got: Ty = self.type_of(src, pair.a, want);
            if !is_unknown(got) && !is_unknown(want) && !ty_same(src, got, want) {
                let e: Int = self.complain_at(src, pair.tok,
                    "this field is " + ty_show(src, want) + ", but the value is "
                    + ty_show(src, got));
            }
            i = i + 1;
        }
        return holder;
    }

    if n.kind == 13 {                                // a call
        let t: Tok = self.toks[n.tok];
        let found: Int = self.find_fun(src, t.start, t.length);
        if found < 0 {
            // A builtin, or a name nobody declared. The compiler knows the builtins,
            // so the checker knows them too rather than staying silent about calls.
            let builtin: Ty = self.builtin_type(src, t, n.a);
            if is_unknown(builtin) {
                let e: Int = self.complain_at(src, n.tok, "unknown function");
            }
            return builtin;
        }
        let signature: Fun = self.funs[found];
        let list: Node = self.nodes[n.a];
        let params: Node = self.nodes[signature.params];
        if list.b != params.b {
            let e: Int = self.complain_at(src, n.tok,
                "this call passes " + to_string(list.b) + " argument(s), but the "
                + "function takes " + to_string(params.b));
            return signature.ret;
        }
        let mut i: Int = 0;
        while i < list.b {
            let arg: Int = self.kids[list.a + i];
            let param: Node = self.nodes[self.kids[params.a + i]];
            let want: Ty = self.ty_of(src, param.a);
            let got: Ty = self.type_of(src, arg, want);
            if !is_unknown(got) && !ty_same(src, got, want) {
                let e: Int = self.complain_at(src, n.tok,
                    "argument " + to_string(i + 1) + " should be " + ty_show(src, want)
                    + ", but it is " + ty_show(src, got));
            }
            i = i + 1;
        }
        return signature.ret;
    }

    // Anything else — fields, method calls, indexing, struct and array literals —
    // is phase 4b. Its children are still visited so unknown names are still found.
    let visited: Int = self.visit_children(src, node);
    return ty_unknown();
}

// Walk an expression's children without judging the node itself.
fn (mut self: Unit) visit_children(src: String, node: Int) -> Int allocates {
    let n: Node = self.nodes[node];
    if n.kind == 11 || n.kind == 6 || n.kind == 7 {
        let a: Ty = self.type_of(src, n.a, ty_unknown());
        return 1;
    }
    if n.kind == 12 || n.kind == 14 {
        let a: Ty = self.type_of(src, n.a, ty_unknown());
        if n.kind == 12 {
            let b: Ty = self.type_of(src, n.b, ty_simple(40));
        }
        return 1;
    }
    if n.kind == 17 || n.kind == 19 {                // array or struct literal
        let mut i: Int = 0;
        while i < n.b {
            let child: Int = self.kids[n.a + i];
            let field: Node = self.nodes[child];
            if n.kind == 19 {
                let v: Ty = self.type_of(src, field.a, ty_unknown());
            } else {
                let v: Ty = self.type_of(src, child, ty_unknown());
            }
            i = i + 1;
        }
        return 1;
    }
    return 0;
}

fn (mut self: Unit) check_args(src: String, list_node: Int) -> Int allocates {
    if list_node < 0 {
        return 0;
    }
    let list: Node = self.nodes[list_node];
    let mut i: Int = 0;
    while i < list.b {
        let arg: Ty = self.type_of(src, self.kids[list.a + i], ty_unknown());
        i = i + 1;
    }
    return list.b;
}

// ---- statements --------------------------------------------------------------
fn (mut self: Unit) check_block_nodes(src: String, block: Int, ret: Ty) -> Int allocates {
    if block < 0 {
        return 0;
    }
    let node: Node = self.nodes[block];
    self.depth = self.depth + 1;
    let mut i: Int = 0;
    while i < node.b {
        let checked: Int = self.check_stmt_node(src, self.kids[node.a + i], ret);
        i = i + 1;
    }
    // Everything declared inside the block leaves scope at the closing brace. One
    // `truncate` rather than a loop: the bindings a block made are the ones on top.
    let mut keep: Int = len(self.syms);
    while keep > 0 && self.syms[keep - 1].depth >= self.depth {
        keep = keep - 1;
    }
    let dropped: Int = truncate(self.syms, keep);
    self.depth = self.depth - 1;
    return node.b;
}

fn (mut self: Unit) check_stmt_node(src: String, stmt: Int, ret: Ty) -> Int allocates {
    if stmt < 0 {
        return 0;
    }
    let n: Node = self.nodes[stmt];

    if n.kind == 60 {                                // let
        let declared: Ty = self.ty_of(src, n.a);
        let actual: Ty = self.type_of(src, n.b, declared);
        if !is_unknown(actual) && !ty_same(src, actual, declared) {
            let e: Int = self.complain_at(src, n.tok,
                "declared " + ty_show(src, declared) + ", but the value is "
                + ty_show(src, actual));
        }
        let name: Tok = self.toks[n.tok];
        // Shadowing is refused, so a second `let` of the same name is an error.
        if self.find_sym(src, name.start, name.length) >= 0 {
            let e: Int = self.complain_at(src, n.tok,
                "this name is already declared — Burxt does not shadow");
        }
        push(self.syms, Sym { start: name.start, length: name.length,
                              ty: declared, mutable: n.value, depth: self.depth });
        return 1;
    }

    if n.kind == 61 {                                // assignment
        let target: Node = self.nodes[n.a];
        let want: Ty = self.type_of(src, n.a, ty_unknown());
        let got: Ty = self.type_of(src, n.b, want);
        if !is_unknown(got) && !is_unknown(want) && !ty_same(src, got, want) {
            let e: Int = self.complain_at(src, n.tok,
                "cannot assign " + ty_show(src, got) + " to " + ty_show(src, want));
        }
        // Only a `let mut` binding may be assigned to.
        if target.kind == 5 {
            let name: Tok = self.toks[target.tok];
            let found: Int = self.find_sym(src, name.start, name.length);
            if found >= 0 && self.syms[found].mutable == 0 {
                let e: Int = self.complain_at(src, target.tok,
                    "this was declared immutable — declare it `let mut` to allow it");
            }
        }
        return 1;
    }

    if n.kind == 62 || n.kind == 70 {                // print, expression statement
        let value: Ty = self.type_of(src, n.a, ty_unknown());
        return 1;
    }

    if n.kind == 63 || n.kind == 64 {                // return, return tail
        let value: Ty = self.type_of(src, n.a, ret);
        if !is_unknown(value) && !is_unknown(ret) && !ty_same(src, value, ret) {
            let e: Int = self.complain_at(src, n.tok,
                "this function returns " + ty_show(src, ret) + ", but the value is "
                + ty_show(src, value));
        }
        return 1;
    }

    if n.kind == 65 {                                // if
        let cond: Ty = self.type_of(src, n.a, ty_simple(41));
        if !is_unknown(cond) && cond.kind != 41 {
            let e: Int = self.complain_at(src, n.tok, "an `if` condition must be a Bool");
        }
        let t: Int = self.check_block_nodes(src, n.b, ret);
        if n.c >= 0 {
            let other: Node = self.nodes[n.c];
            if other.kind == 16 {
                let f: Int = self.check_block_nodes(src, n.c, ret);
            } else {
                let f: Int = self.check_stmt_node(src, n.c, ret);
            }
        }
        return 1;
    }

    if n.kind == 66 {                                // while
        let cond: Ty = self.type_of(src, n.a, ty_simple(41));
        if !is_unknown(cond) && cond.kind != 41 {
            let e: Int = self.complain_at(src, n.tok, "a `while` condition must be a Bool");
        }
        let body: Int = self.check_block_nodes(src, n.b, ret);
        return 1;
    }

    if n.kind == 69 {                                // region
        let body: Int = self.check_block_nodes(src, n.a, ret);
        return 1;
    }

    if n.kind == 71 {                                // match
        let value: Ty = self.type_of(src, n.a, ty_unknown());
        let mut i: Int = 0;
        while i < n.c {
            let arm: Node = self.nodes[self.kids[n.b + i]];
            // The arm's bindings take the variant's payload types, and leave scope
            // with the arm — which is what `truncate` is for.
            let base: Int = len(self.syms);
            let bound: Int = self.bind_arm(src, value, arm);
            let body: Int = self.check_block_nodes(src, arm.a, ret);
            let dropped: Int = truncate(self.syms, base);
            i = i + 1;
        }
        return 1;
    }

    return 0;
}

// ---- the pass ----------------------------------------------------------------
fn (mut self: Unit) check(src: String) -> Int allocates {
    let collected: Int = self.collect_declarations(src);
    let mut i: Int = 0;
    while i < len(self.items) {
        let index: Int = self.items[i];
        let item: Node = self.nodes[index];
        if item.kind == 80 {                         // a function: parameters in scope
            let base: Int = len(self.syms);
            self.depth = self.depth + 1;
            let params: Node = self.nodes[item.a];
            let mut p: Int = 0;
            while p < params.b {
                let param: Node = self.nodes[self.kids[params.a + p]];
                let name: Tok = self.toks[param.tok];
                push(self.syms, Sym { start: name.start, length: name.length,
                                      ty: self.ty_of(src, param.a), mutable: 0,
                                      depth: self.depth });
                p = p + 1;
            }
            // The return type rides in the clause node's spare slot.
            let signature: Node = self.nodes[item.c];
            let ret: Ty = self.ty_of(src, signature.c);
            let body: Int = self.check_block_nodes(src, item.b, ret);
            // The parameters go out of scope with the function.
            let dropped: Int = truncate(self.syms, base);
            self.depth = self.depth - 1;
        }
        if item.kind >= 60 && item.kind <= 71 {      // a top-level statement
            let checked: Int = self.check_stmt_node(src, index, ty_unknown());
        }
        i = i + 1;
    }
    return self.problems;
}

// ---- reporting -------------------------------------------------------------
fn kind_name(kind: Int) -> String allocates {
    if kind == 1 { return "ident"; }
    if kind == 2 { return "int"; }
    if kind == 3 { return "decimal"; }
    if kind == 4 { return "string"; }
    if kind >= 140 { return "type"; }
    if kind >= 100 { return "keyword"; }
    return "punct";
}

fn (self: Unit) report(src: String, limit: Int) -> Int allocates {
    let mut i: Int = 0;
    while i < len(self.toks) && i < limit {
        let t: Tok = self.toks[i];
        let text: String = substring(src, t.start, t.length);
        if t.kind == 3 {
            print("  decimal " + text + " -> unscaled " + to_string(t.value)
                  + " scale " + to_string(t.scale));
        } else {
            print("  " + kind_name(t.kind) + " `" + text + "`");
        }
        i = i + 1;
    }
    return i;
}

fn (self: Unit) count_of(kind: Int) -> Int {
    let mut i: Int = 0;
    let mut found: Int = 0;
    while i < len(self.toks) {
        if self.toks[i].kind == kind {
            found = found + 1;
        }
        i = i + 1;
    }
    return found;
}

region compile {
    // The file to lex: whatever was asked for, or the tour as a default.
    let mut path: String = "examples/tour.bx";
    if arg_count() > 1 {
        path = arg(1);
    }
    let src: String = read_file(path);
    let mut unit: Unit = Unit { toks: [], words: [], nodes: [], kids: [], subs: [], items: [], syms: [], funs: [], stack: [], methods: [], types: [], depth: 0, problems: 0, pos: 0, no_struct: 0, errors: 0 };
    let installed: Int = unit.install_keywords();
    let total: Int = unit.run(src);

    print("lexed " + path + ": " + to_string(total) + " tokens, "
          + to_string(installed) + " keywords known");
    print("  identifiers: " + to_string(unit.count_of(1)));
    print("  decimals:    " + to_string(unit.count_of(3)));
    print("  strings:     " + to_string(unit.count_of(4)));
    print("  errors:      " + to_string(unit.errors));
    print("first tokens:");
    let shown: Int = unit.report(src, 8);

    // ---- phase 3: parse everything the tokens describe ----
    let mut items: Int = 0;
    while !unit.done() {
        let item: Int = unit.parse_item(src);
        if item < 0 {
            break;
        }
        push(unit.items, item);
        items = items + 1;
    }
    print("parsed " + to_string(items) + " items and statements into "
          + to_string(len(unit.nodes)) + " nodes, "
          + to_string(len(unit.kids)) + " child slots");
    print("  parse errors: " + to_string(unit.errors));

    // ---- phase 4: check what the parser read ----
    if unit.errors == 0 {
        let problems: Int = unit.check(src);
        print("checked " + to_string(len(unit.funs)) + " functions and "
              + to_string(len(unit.types)) + " types");
        print("  type errors: " + to_string(problems));
    }
}
