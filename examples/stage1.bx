// ============================================================================
// STAGE-1: the Burxt compiler, written in Burxt.
//
// The program is this file; the compiler is the modules it uses. It was one file of
// nearly six thousand lines until v0.0.82, because Burxt had no module system — and
// splitting it is the acceptance test for having one. If the compiler cannot be
// split, modules are not done.
//
//   types.bx    the shapes, and the lexer
//   parser.bx   tokens in, arena AST out
//   check.bx    the rules: scales, regions, purity, contracts, exhaustiveness
//   modules.bx  `use "path";`, resolved before lexing
//   emit.bx     textual LLVM IR, and the runtime emitted with it
//
// Build and run it with:
//
//     burxt build examples/stage1.bx -o /tmp/stage1
//     /tmp/stage1 <program.bx> [out.ll]
//
// Given a second argument it emits LLVM IR for the program; given one it lexes,
// parses and checks it, and reports what it found.
// ============================================================================

use "burxt/types.bx";
use "burxt/parser.bx";
use "burxt/check.bx";
use "burxt/modules.bx";
use "burxt/emit.bx";

region compile {
    // The file to lex: whatever was asked for, or the tour as a default.
    let mutable path: String = "examples/tour.bx";
    if arg_count() > 1 {
        path = arg(1);
    }
    // The program AND everything it uses, in one buffer. The same design stage-0 uses, for
    // the same reason: a Span stays a byte range, and only a renderer needs to know which
    // file an offset fell in. See spec/M6-MODULES.md §1.5.
    let src: String = load_program(path);
    let mutable unit: Unit = Unit { toks: [], words: [], nodes: [], kids: [], subs: [], items: [], syms: [], funs: [], stack: [], methods: [], types: [], params_in_scope: [], generics: [], type_params: [], impls: [], typed: [], region_depth: 0, in_caller_region: 0, in_pure: 0, loop_depth: 0, in_contract: 0, in_ensures: 0, current_fn: -1, chunks: [], pending: "", globals: "", sret: "", sret_cells: 0, fn_entry: "", body_chunks: [], body_pending: "", next_tmp: 0, next_slot: 0, next_label: 0, slots: [], strings: [], declared: [], loop_conds: [], loop_ends: [], in_function: 0, depth: 0, problems: 0, pos: 0, token_end: 0, no_struct: 0, in_mul: 0, errors: 0, n_type_of: 0, n_find_sym: 0, n_find_fun: 0, n_ty_show: 0, n_expr_allocates: 0, n_type_at: 0 };
    let installed: Int = unit.install_keywords();
    let total: Int = unit.run(src);

    print("lexed " + path + ": " + to_string(total) + " tokens, "
          + to_string(installed) + " keywords known");
    print("  identifiers: " + to_string(unit.count_of(1)));
    print("  decimals:    " + to_string(unit.count_of(3)));
    print("  strings:     " + to_string(unit.count_of(4)));
    print("  errors:      " + to_string(unit.errors));
    print("first tokens:");
    let shown: Int = unit.report(src, 8);

    // ---- phase 3: parse everything the tokens describe ----
    let mutable items: Int = 0;
    while !unit.done() {
        let item: Int = unit.parse_item(src);
        if item < 0 {
            break;
        }
        push(unit.items, item);
        items += 1;
    }
    print("parsed " + to_string(items) + " items and statements into "
          + to_string(len(unit.nodes)) + " nodes, "
          + to_string(len(unit.kids)) + " child slots");
    print("  parse errors: " + to_string(unit.errors));

    // ---- phase 4: check what the parser read ----
    if unit.errors == 0 {
        let problems: Int = unit.check(src);
        print("checked " + to_string(len(unit.funs)) + " functions and "
              + to_string(len(unit.types)) + " types");
        print("  type errors: " + to_string(problems));
        // M9: what the checker actually did, per run. A number beside a phase is the only
        // thing that turns "the checker is slow" into a place to look.
        print("  work: " + to_string(len(unit.nodes)) + " nodes, type_of "
              + to_string(unit.n_type_of) + ", find_sym " + to_string(unit.n_find_sym)
              + " over " + to_string(len(unit.syms)) + " syms, find_fun "
              + to_string(unit.n_find_fun) + " over " + to_string(len(unit.funs)) + " funs");

        // ---- phase 5: emit LLVM IR, when a second argument says where ----
        if problems == 0 && arg_count() > 2 {
            let emitted: Int = unit.emit_module(src);
            if unit.problems == 0 {
                let text: String = "; LLVM IR written by the Burxt compiler, in Burxt.\n"
                    + "@burxt.fmt_int = private unnamed_addr constant [5 x i8] c\"%lld\\00\"\n"
                    + "@burxt.fmt_str = private unnamed_addr constant [3 x i8] c\"%s\\00\"\n"
                    + "@burxt.fmt_nl = private unnamed_addr constant [2 x i8] c\"\\0A\\00\"\n"
                    + "@burxt.str_true = private unnamed_addr constant [5 x i8] c\"true\\00\"\n"
                    + "@burxt.str_false = private unnamed_addr constant [6 x i8] c\"false\\00\"\n"
                    + "@burxt.str_minus = private unnamed_addr constant [2 x i8] c\"-\\00\"\n"
                    + "@burxt.str_empty = private unnamed_addr constant [1 x i8] c\"\\00\"\n"
                    + "@burxt.overflow_msg = private unnamed_addr constant [42 x i8] "
                    + "c\"burxt runtime error: arithmetic overflow\\0A\\00\"\n"
                    + "@burxt.region_msg = private unnamed_addr constant [87 x i8] "
                    + "c\"burxt runtime error: region memory exhausted — this build "
                    + "reserves 1 GB per process\\0A\\00\"\n"
                    + "@burxt.divzero_msg = private unnamed_addr constant [39 x i8] "
                    + "c\"burxt runtime error: division by zero\\0A\\00\"\n"
                    + "@burxt.bounds_msg = private unnamed_addr constant [76 x i8] "
                    + "c\"burxt runtime error: index %lld is outside an array of %lld"
                    + " (at byte %lld)\\0A\\00\"\n"
                    + unit.globals + "\n" + unit.finish();
                let wrote: Int = write_file(arg(2), text);
                print("wrote " + arg(2) + ", " + to_string(len(text)) + " bytes of IR");
            } else {
                print("  backend refusals: " + to_string(unit.problems));
            }
        }
    }
}
