// ============================================================================
// A Burxt lexer, written in Burxt.
//
// This is the first piece of the compiler to be self-hosted. It tokenizes real
// Burxt source read from disk. A token that refers to source text carries a
// (start, length) span rather than an owned substring, and numbers are
// accumulated arithmetically as digits arrive — so the only allocation in the
// whole program is the file's bytes, which live in one region.
// ============================================================================

enum Token {
    Plus,
    Minus,
    Star,
    Slash,
    LParen,
    RParen,
    Semi,
    Assign,
    // a literal value, accumulated digit by digit — no string building
    Number(Int),
    // a span into the source: start byte and length, so no allocation
    Name(Int, Int),
    Unknown(Int),
    End,
}

// One step of the scan: the token found, and where to continue from.
struct Scan {
    tok: Token,
    next: Int,
}

fn is_digit(b: Int) -> Bool {
    return b >= 48 && b <= 57;
}

fn is_alpha(b: Int) -> Bool {
    return (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || b == 95;
}

fn is_space(b: Int) -> Bool {
    return b == 32 || b == 9 || b == 10 || b == 13;
}

// Whitespace and `// line comments` are both trivia: skip them together, and
// keep going, because a comment can be followed by more of either.
fn skip_trivia(src: String, from: Int) -> Int {
    let mut i: Int = from;
    let mut moving: Bool = true;
    while moving {
        moving = false;
        while i < len(src) && is_space(byte_at(src, i)) {
            i = i + 1;
            moving = true;
        }
        if i + 1 < len(src) && byte_at(src, i) == 47 && byte_at(src, i + 1) == 47 {
            while i < len(src) && byte_at(src, i) != 10 {
                i = i + 1;
            }
            moving = true;
        }
    }
    return i;
}

fn next_token(src: String, from: Int) -> Scan {
    let start: Int = skip_trivia(src, from);
    if start >= len(src) {
        return Scan { tok: Token.End, next: start };
    }

    let b: Int = byte_at(src, start);

    if is_digit(b) {
        // accumulate the value as we go: no substring, no allocation
        let mut i: Int = start;
        let mut value: Int = 0;
        while i < len(src) && is_digit(byte_at(src, i)) {
            value = value * 10 + (byte_at(src, i) - 48);
            i = i + 1;
        }
        return Scan { tok: Token.Number(value), next: i };
    }

    if is_alpha(b) {
        let mut i: Int = start;
        while i < len(src) && (is_alpha(byte_at(src, i)) || is_digit(byte_at(src, i))) {
            i = i + 1;
        }
        return Scan { tok: Token.Name(start, i - start), next: i };
    }

    let after: Int = start + 1;
    if b == 43 { return Scan { tok: Token.Plus,   next: after }; }
    if b == 45 { return Scan { tok: Token.Minus,  next: after }; }
    if b == 42 { return Scan { tok: Token.Star,   next: after }; }
    if b == 47 { return Scan { tok: Token.Slash,  next: after }; }
    if b == 40 { return Scan { tok: Token.LParen, next: after }; }
    if b == 41 { return Scan { tok: Token.RParen, next: after }; }
    if b == 59 { return Scan { tok: Token.Semi,   next: after }; }
    if b == 61 { return Scan { tok: Token.Assign, next: after }; }
    return Scan { tok: Token.Unknown(b), next: after };
}

// Printing a token is where `match` earns its keep: add a variant to Token and
// this function stops compiling until the new case is handled.
fn show(t: Token) -> Int {
    match t {
        Plus => { print("PLUS"); return 1; }
        Minus => { print("MINUS"); return 1; }
        Star => { print("STAR"); return 1; }
        Slash => { print("SLASH"); return 1; }
        LParen => { print("LPAREN"); return 1; }
        RParen => { print("RPAREN"); return 1; }
        Semi => { print("SEMI"); return 1; }
        Assign => { print("ASSIGN"); return 1; }
        Number(v) => { print("NUMBER {v}"); return 1; }
        Name(at, n) => { print("NAME at {at} len {n}"); return 1; }
        Unknown(b) => { print("UNKNOWN byte {b}"); return 1; }
        End => { return 0; }
    }
}

fn tokenize(src: String) -> Int {
    let mut pos: Int = 0;
    let mut count: Int = 0;
    let mut running: Bool = true;
    while running {
        let s: Scan = next_token(src, pos);
        pos = s.next;
        if show(s.tok) == 0 {
            running = false;
        } else {
            count = count + 1;
        }
    }
    return count;
}

// The payoff: the lexer no longer has its input baked in. It reads a real file
// from disk — the last thing a self-hosted compiler was missing. The bytes live
// in the region and are released as a unit when it closes.
region source {
    let text: String = read_file("examples/sample.bx");
    print("--- " + to_string(len(text)) + " bytes read");
    let n: Int = tokenize(text);
    print("--- " + to_string(n) + " tokens");
}
