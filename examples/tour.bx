// ============================================================================
// A tour of Burxt in one file: what the language is, in the order it matters.
// Also the sample used to check the editor grammar highlights real code.
// ============================================================================

// ---- Exact money, and rounding you have to declare ----
let price: Decimal<2> = $19.99;
let quantity: Int = 3;
let subtotal: Decimal<2> = price * quantity;          // exact: Decimal * Int never rounds
print("subtotal {subtotal}");

let rate: Decimal<4> = 8.25%;                    // a percent literal: scale 6 written as 4+2
let tax: Decimal<2, RoundHalfEven> = subtotal * rate;   // mixed scales need a contract
print("tax {tax}");

// ---- Aggregates with value semantics, and behaviour attached to them ----
class LineItem { label: String, price: Decimal<2>, quantity: Int }

trait Priced { function total(self) -> Decimal<2> }

implement Priced for LineItem {
    function (self) total() -> Decimal<2> {
        return self.price * self.quantity;
    }
}

let widget: LineItem = LineItem { label: "widget", price: $19.99, quantity: 3 };
print("{widget.label}: {widget.total()}");

// A trait object: runtime dispatch only where `dynamic` is written.
function show(item: dynamic Priced) -> Int {
    print("via dynamic: {item.total()}");
    return 0;
}
let ignored: Int = show(widget);

// ---- Sum types with exhaustive matching: no wildcard, no forgotten case ----
enum Status { Paid, Owing(Decimal<2>), Void }

function describe(s: Status) -> Int {
    match s {
        Paid => { print("paid in full"); return 1; }
        Owing(amount) => { print("owing {amount}"); return 2; }
        Void => { print("void"); return 0; }
    }
}
let code: Int = describe(Status.Owing($4.50));

// ---- Guaranteed tail calls: constant stack, or a compile error ----
function accumulate(n: Int, acc: Decimal<2>) -> Decimal<2> {
    if n <= 0 { return acc; }
    return tail accumulate(n - 1, acc + $0.01);
}
print("a million cents: {accumulate(1000000, $0.00)}");

// ---- Regions: the unit of ownership, released in O(1) ----
region tour {
    let mutable lengths: [Int] = [];                  // growable, no capacity declared
    let source: String = read_file("examples/tour.bx");
    push(lengths, len(source));
    push(lengths, byte_at(source, 0));
    let report: String = "read {lengths[0]} bytes, first byte {lengths[1]}";
    print(report);
}                                                 // released here, as a unit

// ---- The C boundary, where exactness is usually lost and here is not ----
external function llabs(amount: Decimal<2> as scaled) -> Int;
print("C received the exact scaled integer: {llabs(price)}");
