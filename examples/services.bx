// ============================================================================
// Coming from classes: everything a class gives you, and where it lives here.
//
//   Constructor              a function returning the struct
//   Validation on construct  `requires` on that function — checked every call
//   Initialization           a struct literal must set EVERY field
//   Interface                `trait`
//   Polymorphism             `impl Trait for Type`, and `dyn Trait` at runtime
//   Dependency injection     a `dyn Trait` FIELD, chosen by whoever builds it
//   Destructor               the region; you do not write one
//   Static methods           a free function
//   Inheritance              deliberately absent — see the bottom of this file
//
// This file is a small application: a checkout service with an injected tax-rate
// provider, two implementations of it, and a constructor that refuses bad input.
// ============================================================================

// ---- The interface ---------------------------------------------------------
trait Rates {
    fn rate_for(self, country: String) -> Decimal<4>
    fn name(self) -> String
}

// ---- Two implementations ---------------------------------------------------
struct FlatRates { everywhere: Decimal<4> }
struct TableRates { home: Decimal<4>, abroad: Decimal<4> }

impl Rates for FlatRates {
    fn (self) rate_for(country: String) -> Decimal<4> {
        return self.everywhere;
    }
    fn (self: FlatRates) name() -> String { return "flat"; }
}

impl Rates for TableRates {
    fn (self) rate_for(country: String) -> Decimal<4> {
        if country == "PH" { return self.home; }
        return self.abroad;
    }
    fn (self: TableRates) name() -> String { return "table"; }
}

// ---- A constructor, and what one is actually FOR ---------------------------
// A constructor exists to refuse an invalid object. Burxt puts that refusal in the
// signature, where a reader meets it before the body — and `requires` is checked on
// every call, with no build mode that removes it and no factory that bypasses it.
struct Order { subtotal: Decimal<2, RoundHalfEven>, country: String }

fn new_order(subtotal: Decimal<2, RoundHalfEven>, country: String) -> Order
    requires subtotal >= $0.00
    requires len(country) == 2
{
    // Every field, always. There is no half-built object here and no `null` to
    // leave in one — which is the initialization bug a constructor can still have
    // in most languages with classes.
    return Order { subtotal: subtotal, country: country };
}

// ---- Dependency injection --------------------------------------------------
// `Checkout` holds its dependency as a field. It never names FlatRates or
// TableRates, and it cannot: all it knows is that something answers `Rates`.
// That is constructor injection, with the container replaced by a struct literal.
struct Checkout { rates: dyn Rates }

fn (self: Checkout) total_for(order: Order) -> Decimal<2, RoundHalfEven> {
    let rate: Decimal<4> = self.rates.rate_for(order.country);
    let tax: Decimal<2, RoundHalfEven> = order.subtotal * rate;
    return order.subtotal + tax;
}

fn (self: Checkout) describe() -> String allocates {
    return "checkout using " + self.rates.name() + " rates";
}

region app {
    let order: Order = new_order($100.00, "PH");

    // Inject one implementation. The dependency is bound to a variable first,
    // because a `dyn` borrows the storage of the value it refers to and a
    // temporary has none — the compiler says exactly that if you forget.
    let live_rates: TableRates = TableRates { home: 12.00%, abroad: 0.00% };
    let live: Checkout = Checkout { rates: live_rates };
    print(live.describe());
    print(live.total_for(order));

    // Inject another. Nothing about `Checkout` changes — this is the seam a test
    // uses, and it needs no framework, no annotation and no container.
    let stub_rates: FlatRates = FlatRates { everywhere: 5.00% };
    let stubbed: Checkout = Checkout { rates: stub_rates };
    print(stubbed.describe());
    print(stubbed.total_for(order));
    print(stubbed.total_for(new_order($100.00, "US")));
}

// ---- What the compiler refuses, and why ------------------------------------
//
// A constructor's precondition, at run time, quoting the clause:
//     new_order($10.00, "PHILIPPINES")
//     burxt runtime error: `requires len(country) == 2` failed in `new_order`
//
// A struct literal missing a field:
//     Order { subtotal: $10.00 }
//     error: this literal leaves out `country`
//
// A `dyn` built from a temporary rather than a variable:
//     Checkout { rates: FlatRates { everywhere: 5.00% } }
//     error: a `dyn Rates` must come from a variable — a trait object borrows the
//            storage of the value it refers to, and an expression has none
//
// An impl that does not answer the whole trait:
//     error: this impl leaves out `name`, which the trait requires
//
// ---- And the one thing that is missing on purpose --------------------------
//
// There is no inheritance. No `extends`, no base class, no `super`, no abstract
// class. If the instinct is "I would put the shared behaviour in an AbstractRates
// base", the answer here is: put it in a function both impls call, or in a struct
// field both hold, and let each type implement the trait.
//
// That was decided in v0.0.46 after thirty versions in which nothing needed it —
// the same conclusion Go and Rust reached — and it buys the absence of the
// fragile-base-class problem, of "which parent did this method come from", and of
// constructors that run in an order nobody remembers.
