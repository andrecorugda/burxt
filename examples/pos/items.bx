// ============================================================================
// pos/items.bx — what a shop sells, and what a customer is buying.
//
//     use "items.bx";
//
// Data only. Every other file in this app depends on this one and it depends on
// nothing, which is the only reason `use` can have no cycles to worry about.
// ============================================================================

// One thing on the shelf. `price` is a Decimal<2> because it is money, and money
// in this language is an integer and a scale — never a float.
class Item {
    sku: String,
    name: String,
    price: Decimal<2, RoundHalfUp>,
    taxable: Bool,
}

// One line on a receipt: a thing, and how many of it — and what it costs, which now lives
// with it rather than beside it.
//
// Until v0.0.149 this was `class Line { ... }` followed by a free function
// `line_subtotal(line)`. The two were adjacent by convention: nothing connected them, and
// nothing stopped the next function about a Line landing in another file. That was the largest
// readability gap the four-language comparison found, and it is what the word `class` is for.
class Line {
    item: Item,
    quantity: Int,

    // What this line costs before tax. `quantity` is an Int and `price` is a Decimal<2>, so
    // the product is a Decimal<2> exactly — no rounding happens here, and none is allowed to
    // happen silently.
    function (self) subtotal() -> Decimal<2, RoundHalfUp> {
        return self.item.price * self.quantity;
    }
}
