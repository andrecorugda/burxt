// ============================================================================
// Interfaces — the whole of Burxt's abstraction story. There is no `class` and no
// inheritance: an interface says what a type can DO, an `implement` says a type does it,
// and `dynamic` is the only place a decision is made at runtime.
// ============================================================================

// An interface is a list of signatures. No bodies, no fields, no state — an interface
// describes behaviour, and behaviour is all it can describe.
interface Priced {
    function price(self) -> Decimal<2>
    function label(self) -> String
}
// (In an interface the receiver is just `self`; inside an `implement` block it may be just
//  `function (self)` too, because the header already said which type.)

class Book { title: String, cost: Decimal<2> }
class Meal { dish: String, cost: Decimal<2>, covers: Int }

// `implement Trait for Type` is explicit. A type does not accidentally satisfy a
// trait by having the right method names — conformance is declared, and the
// compiler checks the implementation answers EVERY signature, with no extras.
implement Priced for Book {
    function (self) price() -> Decimal<2> { return self.cost; }
    function (self) label() -> String { return "book: " + self.title; }
}

implement Priced for Meal {
    function (self) price() -> Decimal<2> { return self.cost * self.covers; }
    function (self) label() -> String { return "meal: " + self.dish; }
}

// ---- Static dispatch: the default, and it costs nothing -------------------
// `item: Book` is a concrete type, so the call is direct. No vtable, no
// indirection, and the optimiser can see through it.
function describe_book(item: Book) -> String {
    return item.label() + " at " + to_string(item.price());
}

// ---- Runtime dispatch: only where you write `dynamic` -------------------------
// `dynamic Priced` is a fat pointer — the value, and a table of the interface's
// methods. Slot order comes from the interface declaration, so `price` is slot 0
// for every implementor. You pay for this exactly where you ask for it.
function show(item: dynamic Priced) -> Decimal<2> {
    return item.price();
}

let novel: Book = Book { title: "Sea", cost: $14.50 };
let dinner: Meal = Meal { dish: "Stew", cost: $12.25, covers: 2 };

// static: the type is known here
print(describe_book(novel));

// dynamic: the same function serves both types
print(show(novel));
print(show(dinner));

// A `dynamic` value is storable — it is a value like any other, so it can live
// in a binding, a class field, or an array.
let anything: dynamic Priced = dinner;
print(anything.label());
print(anything.price());

// ---- What the compiler refuses, and why ------------------------------------
//
// An implement that leaves a method out:
//     implement Priced for Book { function (self: Book) price() -> Decimal<2> { ... } }
//     error: this implement leaves out `label`, which the interface requires
//
// An implement that adds one the interface never declared:
//     error: the interface has no method of this name, and an implementation is an answer to
//            an interface rather than a place to add to a type
//
// A signature that does not match — including the receiver form, since `self`
// and `mutable self` are different promises:
//     error: the interface returns Decimal<2>, and this returns Int
//
// And there is no inheritance to reach for instead. A `Book` is not a kind of
// anything; it is a class that satisfies an interface. Composition and interfaces do
// the work a base class would, without the fragile-base-class problem or the
// question of which parent a method came from.
