// ============================================================================
// check.bx — part of the Burxt compiler, written in Burxt.
//
// The rules. Types, scales, rounding contracts, regions, purity, contracts, exhaustiveness
// — the same refusals stage-0 makes, which is what the differential test compares.
//
// Assembled by examples/stage1.bx, which is the program; everything here is
// declarations, which is what a module may hold.
// ============================================================================

// ============================================================================
// PHASE 4: the typechecker. Types in, refusals out — the same rules the Rust
// compiler enforces, applied to the AST the parser just built.
// ============================================================================

function unknown_type() -> Type {
    return Type { kind: 0, scale: 0, contract: 0, name_start: 0, name_length: 0 };
}

function simple_type(kind: Int) -> Type {
    return Type { kind: kind, scale: 0, contract: 0, name_start: 0, name_length: 0 };
}

// C's widths as Burxt sees them at the boundary. See N1-BOUNDARY-EXACTNESS: the
// exactness rule lives in `as scaled`, and the widths themselves are C's business.
function as_burxt_sees(t: Type) -> Type {
    if t.kind == 43 || t.kind == 44 {
        return simple_type(40);
    }
    return t;
}

function decimal_type(scale: Int, contract: Int) -> Type {
    return Type { kind: 45, scale: scale, contract: contract, name_start: 0, name_length: 0 };
}

// An unknown type never equals anything, including another unknown: one bad
// expression must not make every later comparison succeed. The stage-1 checker in
// examples/checker.bx learned this the hard way, and so did stage-0's recovery.
function is_unknown(t: Type) -> Bool {
    return t.kind == 0;
}

// An interface implementation: a pair of names, which is all `dynamic` dispatch needs to know.
// The method table already knows what the type can do.
class Implementation { trait_start: Int, trait_len: Int, type_start: Int, type_len: Int }




// The same, for the types whose ELEMENT has to be read out of the arena. A method, because a
// slice holds its element as a node index and rendering it needs the nodes.
//
// Rendering a slice used to say the keywords "a growable array" and nothing more, so the first
// message this file produced
// after element comparison started working read "argument 1 should be a growable array, but it
// is a growable array". A refusal a reader cannot act on is barely better than no refusal.
function (self: Unit) show_type(src: String, t: Type) -> String {
    if t.kind == 47 {
        return "[" + self.show_type(src, self.declared_type(src, t.scale)) + "]";
    }
    if t.kind == 48 {
        return "[" + self.show_type(src, self.declared_type(src, t.scale)) + "; "
               + to_string(t.contract) + "]";
    }
    if t.kind == 46 && t.contract > 0 {
        // A generic application: the name, then its arguments.
        let mutable out: String = substring(src, t.name_start, t.name_length) + "<";
        let mutable i: Int = 0;
        while i < t.contract {
            if i > 0 { out += ", "; }
            out += self.show_type(src, self.declared_type(src, self.nested_children[t.scale + i]));
            i += 1;
        }
        return out + ">";
    }
    if t.kind == 0 { return "?"; }
    if t.kind == 40 { return "Int"; }
    if t.kind == 41 { return "Bool"; }
    if t.kind == 42 { return "String"; }
    if t.kind == 43 { return "CInt"; }
    if t.kind == 44 { return "CDouble"; }
    if t.kind == 45 {
        if t.contract == 1 {
            return "Decimal<" + to_string(t.scale) + ", RoundHalfEven>";
        }
        if t.contract == 2 {
            return "Decimal<" + to_string(t.scale) + ", RoundHalfUp>";
        }
        return "Decimal<" + to_string(t.scale) + ">";
    }
    if t.kind == 49 { return "dynamic " + substring(src, t.name_start, t.name_length); }
    if t.kind == 50 { return substring(src, t.name_start, t.name_length); }
    return substring(src, t.name_start, t.name_length);
}

// Read a type NODE into a Type.
// Two types are the same only if their ELEMENTS are.
//
// This has to be a METHOD: a slice or array holds its element type as a NODE INDEX, so
// comparing those two integers compares positions rather than types, and reading the element
// back needs the arena. It used to be a free function that could not reach the nodes, so it
// fell through to `true` for both kinds — which meant `[Int]` and `[String]` were the same
// type to stage-1 for eleven versions, and it accepted `takes_ints(keywords)` where stage-0
// refused it.
//
// Nothing caught it because the differential test's rejection count is a FLOOR, not an
// equality: stage-1 rejecting less than stage-0 kept the ratchet green. Found by trying to
// build generic unification on top of it, which needed element comparison to mean something.
// What a type parameter stands for right now, or the type unchanged if it is not one.
//
// Shallow on purpose: it looks at ONE level. Every recursive walk over types calls it as it
// descends, so `[T]` resolves when its element is reached rather than being rewritten — which
// it could not be, since a slice holds its element as a node index and a substituted element
// would have no node.
// Bind a generic's type parameters from the arguments at a call site.
//
// Each declared parameter type is matched against the argument's actual type; a parameter that
// no argument mentions cannot be inferred, and says so. The bound is checked here too, where
// the type argument is chosen — which is the point of a bound, and the same place stage-0
// checks it.
function (mutable self: Unit) bind_type_arguments(src: String, generic: Int, args: Int,
                                                 params: Int, at: Int) -> Int {
    let declaration: Generic = self.generics[generic];
    let given: Node = self.nodes[args];
    let wanted: Node = self.nodes[params];
    let mutable i: Int = 0;
    while i < wanted.b && i < given.b {
        let parameter: Node = self.nodes[self.children[wanted.a + i]];
        let declared: Type = self.declared_type(src, parameter.a);
        // A bare `T`, a slice, an array — or a generic APPLICATION like `Option<T>`, which is kind 46
        // and was skipped here. `unify` has handled applications since generics landed; this was the
        // only place that did not ask it to.
        //
        // It went unnoticed because a parameter reachable ONLY through an application —
        // `option_is_some(o: Option<T>) -> Bool`, whose single parameter mentions T nowhere else —
        // happened to find `T` already bound by an enclosing call. Scoping the lookup to the current
        // call (see `type_binding_floor`) removed that accident and the gap showed immediately, which
        // is the useful shape of a fix: it made a second bug visible rather than hiding it.
        if declared.kind == 50 || declared.kind == 47 || declared.kind == 48
           || declared.kind == 46 {
            let actual: Type = self.type_of(src, self.children[given.a + i], unknown_type());
            if !is_unknown(actual) {
                let matched: Bool = self.unify(src, declared, actual);
                if !matched {
                    let complained: Int = self.complain_at(src, at,
                        "argument " + to_string(i + 1) + " does not fit "
                        + self.show_type(src, declared) + ": it is "
                        + self.show_type(src, actual));
                }
            }
        }
        i += 1;
    }
    // Every parameter has to have been settled by something, and to satisfy its bound.
    let mutable p: Int = 0;
    while p < declaration.type_param_count {
        let slot: Int = declaration.type_param_start + p;
        let named: Token = self.tokens[self.type_parameters[slot]];
        // "Settled" means a binding EXISTS, not that it is concrete. A generic calling a
        // generic binds `T` to the enclosing `T` — still abstract, and correct: the copy
        // appears when the outer generic is instantiated. Asking whether the resolved kind is
        // still 50 cannot tell that from "nobody said", which is why this asks the table.
        let settled: Bool = self.has_binding(src, named.start, named.length);
        let stands_for: Type = self.resolve_shallow(src,
            Type { kind: 50, scale: 0, contract: 0,
                   name_start: named.start, name_length: named.length });
        if !settled {
            let complained: Int = self.complain_at(src, at,
                "cannot tell what `" + substring(src, named.start, named.length)
                + "` is from this call: no argument mentions it");
        } else if stands_for.kind != 50 {
            let satisfied: Int = self.check_bound(src, self.type_param_bounds[slot],
                                                 stands_for, named, at);
        }
        p += 1;
    }
    return 1;
}

// Does this type argument satisfy the bound the signature declared?
//
// The two the language ships mirror exactly what it already allows: `Ordered` is Int and
// Decimal, the types `<` works on; `Equatable` adds Bool and String, the types `==` works on.
// A bound cannot promise more than the language delivers.
function (mutable self: Unit) check_bound(src: String, bound: Int, argument: Type,
                                         parameter: Token, at: Int) -> Int {
    if bound < 0 {
        return 0;
    }
    let named: Token = self.tokens[bound];
    if span_equal(src, named.start, named.length, "Ordered") {
        if argument.kind != 40 && argument.kind != 45 {
            let complained: Int = self.complain_at(src, at,
                "`" + substring(src, parameter.start, parameter.length)
                + ": Ordered` needs a type with an order, and " + self.show_type(src, argument)
                + " has none: Ordered is Int and Decimal");
        }
        return 1;
    }
    if span_equal(src, named.start, named.length, "Equatable") {
        if argument.kind != 40 && argument.kind != 41 && argument.kind != 42
           && argument.kind != 45 {
            let complained: Int = self.complain_at(src, at,
                "`" + substring(src, parameter.start, parameter.length)
                + ": Equatable` needs a type two values of which can be compared, and "
                + self.show_type(src, argument) + " is not one");
        }
        return 1;
    }
    // Any other bound names a declared trait, and satisfying it means having an implementation.
    // Interfaces are registered in the same table classes and enums are, so one lookup covers all
    // three — and a bound naming a class rather than an interface fails the implementation check
    // below, which is the honest place for it.
    if self.find_type(src, named.start, named.length) < 0 {
        let complained: Int = self.complain_at(src, at,
            "`" + substring(src, parameter.start, parameter.length) + ": "
            + substring(src, named.start, named.length)
            + "` names something that is not an interface this program declares");
        return 1;
    }
    if argument.kind != 46 {
        let complained: Int = self.complain_at(src, at,
            self.show_type(src, argument) + " cannot implement an interface — only a class or an "
            + "enum can");
        return 1;
    }
    let mutable i: Int = 0;
    while i < len(self.impls) {
        let candidate: Implementation = self.impls[i];
        if spans_equal(src, candidate.trait_start, candidate.trait_len, named.start, named.length) {
            if spans_equal(src, candidate.type_start, candidate.type_len,
                           argument.name_start, argument.name_length) {
                return 1;
            }
        }
        i += 1;
    }
    let complained: Int = self.complain_at(src, at,
        self.show_type(src, argument) + " does not implement `"
        + substring(src, named.start, named.length)
        + "`: conformance is declared, never inferred");
    return 1;
}

// The bound declared for this type parameter, as the token of the interface's name, or -1.
// Looked up by the parameter's own name span, which is unique within the declaration that
// owns it.
// A node that denotes this type, so a resolved element can be pointed AT.
//
// The inverse of `declared_type`, and the one place stage-1 does synthesize an arena entry. A
// slice holds its element as a node index, so turning `[T]` into `[Int]` means there has to BE
// a node for `Int` — and until a use asks, there is not. The token is borrowed from `at`, so a
// diagnostic about a synthesized type still points at the source that caused it.
function (mutable self: Unit) node_for(t: Type, at: Int) -> Int {
    if t.kind == 45 {
        return self.add(45, t.scale, t.contract, 0, 0, at);
    }
    if t.kind == 46 || t.kind == 49 || t.kind == 50 {
        // A named type's node identifies its name by TOKEN and a Type carries only the span,
        // so the token has to be found. Every name came from the source, so one exists.
        let token: Int = self.token_starting_at(t.name_start);
        if token < 0 {
            return 0 - 1;
        }
        return self.add(t.kind, t.scale, t.contract, 0, 0, token);
    }
    return self.add(t.kind, t.scale, t.contract, 0, 0, at);
}

function (self: Unit) token_starting_at(start: Int) -> Int {
    let mutable i: Int = 0;
    while i < len(self.tokens) {
        if self.tokens[i].start == start {
            return i;
        }
        i += 1;
    }
    return 0 - 1;
}

// This type with every parameter replaced, all the way down — the deep form of
// `resolve_shallow`, for the places that must hand back a self-contained answer rather than
// resolve as they go. A field's type is one: `Stack<Int>.items` has to BE `[Int]`, because
// whoever receives it no longer has the bindings.
//
// Nothing is rebuilt unless it changed, so an ordinary type costs no arena entry.
// The same Type, field for field. NOT `same_type`, which resolves both sides before comparing
// and would therefore call a `T` and the Point it stands for equal — exactly the question being
// asked here, so the answer has to be about what is WRITTEN and not what it means.
function type_identical(a: Type, b: Type) -> Bool {
    return a.kind == b.kind && a.scale == b.scale && a.contract == b.contract
        && a.name_start == b.name_start && a.name_length == b.name_length;
}

function (mutable self: Unit) resolve_deep(src: String, t: Type, at: Int) -> Type {
    let here: Type = self.resolve_shallow(src, t);
    // A generic inside a generic: `Nested<Point>.inner` is written `Pair<T>`, and whoever
    // receives it has no bindings left, so the argument has to travel down into the
    // application. Its arguments are node indices, so a changed one means a fresh argument
    // list — the one place laziness runs out, and it costs entries only when it fires.
    if here.kind == 46 && here.contract > 0 {
        let mutable changed: Bool = false;
        let mutable i: Int = 0;
        while i < here.contract {
            let written: Type = self.declared_type(src, self.nested_children[here.scale + i]);
            let settled: Type = self.resolve_deep(src, written, at);
            if !type_identical(settled, written) {
                changed = true;
            }
            i += 1;
        }
        if !changed {
            return here;
        }
        let start: Int = len(self.nested_children);
        i = 0;
        while i < here.contract {
            let written: Type = self.declared_type(src, self.nested_children[here.scale + i]);
            let settled: Type = self.resolve_deep(src, written, at);
            let node: Int = self.node_for(settled, at);
            if node < 0 {
                return here;                         // no token to point at: leave it written
            }
            let noted: Int = push(self.nested_children, node);
            i += 1;
        }
        return Type { kind: 46, scale: start, contract: here.contract,
                      name_start: here.name_start, name_length: here.name_length };
    }
    if here.kind != 47 && here.kind != 48 {
        return here;
    }
    let declared: Type = self.declared_type(src, here.scale);
    let element: Type = self.resolve_deep(src, declared, at);
    // `type_identical` and NOT `same_type`, which resolves both sides before comparing and would
    // therefore call a resolved `String` and the `K` it came from equal — the exact question being
    // asked. `[K]` then answered `[K]` and a method returning `[K]` did not resolve at its call
    // site. The nested-application branch above learned this first; this one had the same bug and
    // kept it two versions longer.
    if type_identical(element, declared) {
        return here;
    }
    let node: Int = self.node_for(element, at);
    if node < 0 {
        return here;
    }
    return Type { kind: here.kind, scale: node, contract: here.contract,
                  name_start: 0, name_length: 0 };
}

// Bind a generic type's parameters from an APPLICATION's arguments: `Stack<Int>` binds `T`.
// Answers the base to truncate back to, so the caller's bindings survive.
function (mutable self: Unit) bind_from_application(src: String, holder: Type) -> Int {
    let base: Int = len(self.type_bindings);
    if holder.kind != 46 || holder.contract <= 0 {
        return base;
    }
    let generic: Int = self.generic_named(src, holder.name_start, holder.name_length);
    if generic < 0 {
        return base;
    }
    let declaration: Generic = self.generics[generic];
    let mutable i: Int = 0;
    while i < declaration.type_param_count && i < holder.contract {
        let named: Token = self.tokens[self.type_parameters[declaration.type_param_start + i]];
        let written: Type = self.declared_type(src, self.nested_children[holder.scale + i]);
        // Resolved BEFORE it is pushed, under the bindings already in scope. `Nested<Point>`
        // holds a `Pair<T>`, and binding Pair's `T` to the literal `T` would shadow the
        // Nested binding that says what `T` is — resolve_shallow searches backwards and stops
        // at the first match, so the innermost binding must already be the answer.
        // `Pair<Point>` was 2 cells instead of 4 for exactly this reason.
        let argument: Type = self.resolve_shallow(src, written);
        push(self.type_bindings, TypeBinding { name_start: named.start,
                                              name_length: named.length, bound: argument });
        i += 1;
    }
    return base;
}

// Is there a binding for this parameter at all? Distinct from asking what it resolves to: a
// parameter bound to ANOTHER parameter resolves to something still abstract, and that is
// settled, not missing.
function (self: Unit) has_binding(src: String, start: Int, length: Int) -> Bool {
    let mutable i: Int = 0;
    while i < len(self.type_bindings) {
        let binding: TypeBinding = self.type_bindings[i];
        if spans_equal(src, binding.name_start, binding.name_length, start, length) {
            return true;
        }
        i += 1;
    }
    return false;
}

function (self: Unit) bound_of(src: String, start: Int, length: Int) -> Int {
    if self.current_generic < 0 {
        return 0 - 1;
    }
    let declaration: Generic = self.generics[self.current_generic];
    let mutable i: Int = 0;
    while i < declaration.type_param_count {
        let at: Int = declaration.type_param_start + i;
        let named: Token = self.tokens[self.type_parameters[at]];
        if spans_equal(src, named.start, named.length, start, length) {
            return self.type_param_bounds[at];
        }
        i += 1;
    }
    return 0 - 1;
}

function (self: Unit) resolve_shallow(src: String, t: Type) -> Type {
    if t.kind != 50 {
        return t;
    }
    // Backwards to the FLOOR, not to zero. The floor is where the current generic call's bindings
    // begin, so a nested call to the same generic starts with `T` unbound rather than inheriting the
    // enclosing call's answer — see `type_binding_floor`.
    let mutable i: Int = len(self.type_bindings) - 1;
    while i >= self.type_binding_floor {
        let binding: TypeBinding = self.type_bindings[i];
        if spans_equal(src, binding.name_start, binding.name_length, t.name_start, t.name_length) {
            return binding.bound;
        }
        i -= 1;
    }
    return t;                                        // still abstract: inside the generic itself
}

// Match a declared parameter type against an argument's actual type, binding type parameters
// as it goes. The whole of stage-1's inference: structural, one direction, no backtracking —
// the same shape stage-0 uses, so the two agree by construction rather than by coincidence.
function (mutable self: Unit) unify(src: String, declared: Type, actual: Type) -> Bool {
    if declared.kind == 50 {
        let already: Type = self.resolve_shallow(src, declared);
        if already.kind != 50 {
            return self.same_type(src, already, actual);   // bound once, so it must agree
        }
        let noted: Int = push(self.type_bindings,
            TypeBinding { name_start: declared.name_start, name_length: declared.name_length,
                          bound: actual });
        return true;
    }
    if declared.kind != actual.kind {
        return false;
    }
    if declared.kind == 47 {
        return self.unify(src, self.declared_type(src, declared.scale),
                          self.declared_type(src, actual.scale));
    }
    if declared.kind == 48 {
        if declared.contract != actual.contract {
            return false;
        }
        return self.unify(src, self.declared_type(src, declared.scale),
                          self.declared_type(src, actual.scale));
    }
    // A named APPLICATION, argument by argument: `Map<K, V>` against `Map<String, Int>` binds both.
    // Without this, unify handled slices and stopped, so a parameter reachable only through a type
    // argument could not be inferred — which is every constructor, since `-> Map<K, V>` mentions
    // its parameters only there.
    if declared.kind == 46 && declared.contract > 0 && actual.kind == 46 {
        if declared.contract != actual.contract {
            return false;
        }
        if !spans_equal(src, declared.name_start, declared.name_length,
                        actual.name_start, actual.name_length) {
            return false;
        }
        let mutable i: Int = 0;
        while i < declared.contract {
            let want: Type = self.declared_type(src, self.nested_children[declared.scale + i]);
            let got: Type = self.declared_type(src, self.nested_children[actual.scale + i]);
            if !self.unify(src, want, got) {
                return false;
            }
            i += 1;
        }
        return true;
    }
    return self.same_type(src, declared, actual);
}

// The generic declaration this name belongs to, or -1.
function (self: Unit) generic_named(src: String, start: Int, length: Int) -> Int {
    let mutable i: Int = 0;
    while i < len(self.generics) {
        let g: Generic = self.generics[i];
        if spans_equal(src, g.start, g.length, start, length) {
            return i;
        }
        i += 1;
    }
    return 0 - 1;
}

function (self: Unit) same_type(src: String, a: Type, b: Type) -> Bool {
    // Resolved at every level rather than rewritten: a type parameter becomes what it stands
    // for exactly where the comparison reaches it. See resolve_shallow.
    let left: Type = self.resolve_shallow(src, a);
    let right: Type = self.resolve_shallow(src, b);
    if left.kind == 0 || right.kind == 0 {
        return false;
    }
    if left.kind != right.kind {
        return false;
    }
    if left.kind == 47 {
        return self.same_type(src, self.declared_type(src, left.scale),
                              self.declared_type(src, right.scale));
    }
    if left.kind == 48 {
        // A fixed array's length is part of its type, and so is its element's type.
        if left.contract != right.contract {
            return false;
        }
        return self.same_type(src, self.declared_type(src, left.scale),
                              self.declared_type(src, right.scale));
    }
    if left.kind == 45 {
        // The rounding contract is part of the type, so it is part of equality.
        return left.scale == right.scale && left.contract == right.contract;
    }
    if left.kind == 46 || left.kind == 49 || left.kind == 50 {
        return spans_equal(src, left.name_start, left.name_length,
                           right.name_start, right.name_length);
    }
    return true;
}

function (self: Unit) declared_type(src: String, node: Int) -> Type {
    if node < 0 {
        return unknown_type();
    }
    let n: Node = self.nodes[node];
    if n.kind == 45 {
        return decimal_type(n.a, n.b);
    }
    if n.kind == 46 || n.kind == 49 || n.kind == 50 {
        // A named type, an interface object, or a type PARAMETER — all three carry the span of a
        // name written in the source, which is why a parameter needs no invented identifier.
        // A generic application also carries its arguments: `a` is their start in
        // `nested_children` and `b` is how many.
        let t: Token = self.tokens[n.token];
        // A BARE INTERFACE NAME means a dynamic one — `item: Priced` is `item: dynamic Priced`
        // (stage-0 v0.0.155, stage-1 v0.0.175). `dynamic` was Rust's `dyn`, and requiring it put a
        // word on every polymorphic parameter that a reviewer had to decode and an agent had to
        // remember. `dynamic Priced` stays legal and identical; the static path `<T: Priced>` is
        // untouched and still pays no vtable.
        //
        // These three lines were held back for two versions, and the reason is worth keeping: with
        // them alone stage-1 ACCEPTED `item: Priced` and emitted a binary that SEGFAULTED, because
        // its emitter coerced a concrete value into a `{data, vtable}` pair in only three places —
        // a field initializer, a `let` and an assignment. A call argument, a method argument, an
        // associated function's argument and a `return` all went out uncoerced.
        //
        // A refusal is safe and a miscompile is not, so the sugar waited for the four crossings.
        // See tests/pass/dyn_param_takes_a_concrete_value.bx, which is the case no fixture in
        // either compiler's suite had: every other one launders the value through a binding first,
        // where the coercion already happened.
        if n.kind == 46 {
            let named: Int = self.find_type(src, t.start, t.length);
            if named >= 0 {
                if self.types[named].kind == 84 {
                    return Type { kind: 49, scale: n.a, contract: n.b,
                                name_start: t.start, name_length: t.length };
                }
            }
        }
        return Type { kind: n.kind, scale: n.a, contract: n.b,
                    name_start: t.start, name_length: t.length };
    }
    if n.kind == 47 || n.kind == 48 {
        // `scale` holds the ELEMENT type's node for a slice or an array, and
        // `contract` the declared length. Reusing two fields rather than widening a
        // record that is copied at every comparison in the checker.
        return Type { kind: n.kind, scale: n.a, contract: n.b,
                    name_start: 0, name_length: 0 };
    }
    if n.kind >= 40 && n.kind <= 48 {
        return simple_type(n.kind);
    }
    return unknown_type();
}

function (mutable self: Unit) complain_at(src: String, token: Int, message: String) -> Int {
    // A probe round is silent. It refuses nothing, so anything it found is about a question
    // still being answered — and this function PRINTS, so without the guard the user would
    // read complaints that the real pass then does not make. The real pass reports
    // everything, in its own order, exactly as it did before the inference existed.
    if self.probing == 1 {
        return 0;
    }
    let t: Token = self.tokens[token];
    print("error: " + message + " (at `" + substring(src, t.start, t.length) + "`)");
    self.problems += 1;
    return 0;
}

// ---- declarations ------------------------------------------------------------
// Refuse a call that reaches further than this signature admits.
//
// Written once, because the messages ARE the agent's instruction set and two wordings for one rule is
// how a language starts feeling arbitrary. Word for word stage-0's, which is not a courtesy — the
// .stderr fixtures pin one text and two compilers must produce it.
function (self: Unit) effect_refusal(callee: String, bit: Int) -> String {
    let named: String = effect_name(bit);
    if len(self.effects_owner) == 0 {
        return "`" + callee + "` touches " + named + ", and top-level code declares nothing it "
            + "touches. Call it from a function that says `touches " + named + "`, where a reader "
            + "can see it.";
    }
    return "`" + callee + "` touches " + named + ", but `" + self.effects_owner + "` does not say "
        + "it does. Add `touches " + named + "` to `" + self.effects_owner + "`'s signature — so "
        + "anyone reading it can see what this call can reach — or stop calling `" + callee + "`.";
}

// Every effect `reaches` claims that this signature does not admit, complained about in the closed
// set's order so two programs differing only in clause order report identically.
function (mutable self: Unit) check_effects(src: String, at: Int, callee: String,
                                 reaches: Int) -> Int {
    let mutable bit: Int = 1;
    while bit <= 32 {
        if remainder(divide_floor(reaches, bit), 2) == 1 {
            if remainder(divide_floor(self.allowed_effects, bit), 2) == 0 {
                let complained: Int = self.complain_at(src, at,
                    self.effect_refusal(callee, bit));
            }
        }
        bit = bit * 2;
    }
    return 0;
}

// The lowest set bit of a mask, so a message names one effect rather than a list. The first one is
// enough: fixing it brings the reader back for the next.
function lowest_effect(mask: Int) -> Int {
    let mutable bit: Int = 1;
    while bit <= 32 {
        if remainder(divide_floor(mask, bit), 2) == 1 {
            return bit;
        }
        bit = bit * 2;
    }
    return 1;
}

// What a BUILTIN reaches. Kept beside the effect rule rather than as a second rule for builtins that
// would have to be held in step with the first — the same list stage-0 carries.
//
// `print` is deliberately absent: it would be on almost every function, and an annotation that appears
// on everything tells a reviewer nothing, which is the lesson `allocates` taught.
function builtin_effects(name: String) -> Int {
    if name == "read_file" { return 1; }             // files
    if name == "write_file" { return 1; }
    if name == "write_bytes" { return 1; }
    if name == "argument" { return 8; }              // input: the command line
    if name == "argument_count" { return 8; }
    return 0;
}

// May the code being checked right now see `holder`'s private members?
//
// The CLASS is the scope, not the file — so the question is only ever "is the enclosing method's
// receiver this same class". A free function has no receiver and top-level code has no enclosing
// anything, so both answer false, which is the whole rule.
//
// No new state, and that is deliberate: `current_method` is already saved and restored around every
// body. Stage-0's first version of this kept its own `current_receiver`, set it and never restored
// it, and the top level inherited the LAST class's privileges — a private method called from
// outside compiled cleanly. A leaked capability is the dangerous direction of that bug, so the
// answer here is derived from state that cannot leak rather than tracked again.
function (self: Unit) inside_class(src: String, holder: Type) -> Bool {
    if self.current_method < 0 {
        return false;
    }
    if holder.kind != 46 {
        return false;
    }
    let m: Method = self.methods[self.current_method];
    return spans_equal(src, m.receiver_start, m.receiver_length,
               holder.name_start, holder.name_length);
}

// Is this field of this class declared `private`? The field node's spare slot carries it, set by
// the parser. 0 for a public field and for a name that is no field at all — "no such field" is a
// better message than a privacy one, and it is already reported elsewhere.
function (self: Unit) field_is_private(src: String, holder: Type, name_tok: Int) -> Bool {
    if holder.kind != 46 {
        return false;
    }
    let found: Int = self.find_type(src, holder.name_start, holder.name_length);
    if found < 0 {
        return false;
    }
    let decl: TypeDeclaration = self.types[found];
    if decl.kind != 82 {
        return false;
    }
    let item: Node = self.nodes[decl.node];
    let wanted: Token = self.tokens[name_tok];
    let mutable i: Int = 0;
    while i < item.b {
        let field: Node = self.nodes[self.children[item.a + i]];
        let field_name: Token = self.tokens[field.token];
        if spans_equal(src, field_name.start, field_name.length, wanted.start, wanted.length) {
            return field.value == 1;
        }
        i += 1;
    }
    return false;
}

// `Account.open(...)` — is this method call actually a call to an ASSOCIATED function? The index
// of the method if so, -1 otherwise.
//
// Three questions, in the order that makes each cheap. The base has to be a bare name (kind 5), so
// `sale.total.round()` never reaches the rest. That name must not be a BINDING — a local called
// `Account` shadows the class, exactly as it does everywhere else in the language, and getting this
// order wrong would let a variable's method call be resolved against a class. And it must be a
// declared type, so a typo answers "unknown name" rather than "no such method".
//
// The receiver's span comes straight from the source, which is the point: `Account` is written at
// the call site and written again at the declaration, so two spans compare equal with no name
// having to be built. That is why stage-1 needed no synthesized-name machinery for constructors.
function (mutable self: Unit) associated_at(src: String, node: Int) -> Int {
    let n: Node = self.nodes[node];
    let base: Node = self.nodes[n.a];
    if base.kind != 5 {
        return -1;
    }
    let holder: Token = self.tokens[base.token];
    if self.find_binding(src, holder.start, holder.length) >= 0 {
        return -1;
    }
    if self.find_type(src, holder.start, holder.length) < 0 {
        return -1;
    }
    let wanted: Token = self.tokens[n.token];
    let found: Int = self.find_method_named(src, holder.start, holder.length,
                         wanted.start, wanted.length);
    if found < 0 {
        return -1;
    }
    if flag_associated(self.methods[found].flags) == 0 {
        // A real method reached through the class name rather than a value. Not this rule's
        // business: fall through and let the ordinary path say what it says.
        return -1;
    }
    return found;
}

function (mutable self: Unit) find_binding(src: String, start: Int, length: Int) -> Int {
    self.find_binding_calls += 1;
    // Backwards: the innermost binding with this name is the one in scope.
    let mutable i: Int = len(self.bindings) - 1;
    while i >= 0 {
        if spans_equal(src, self.bindings[i].start, self.bindings[i].length, start, length) {
            return i;
        }
        i -= 1;
    }
    return -1;
}

// FNV-1a over a SPAN, without building a String from it.
//
// The point is what it does not do: `hash(substring(src, start, length))` would allocate once per
// lookup, in a region, in a compiler — which trades a quadratic for a leak. This reads the bytes
// where they are.
//
// Kept under 2^30 so the multiply cannot overflow: `*` panics on overflow in Burxt, deliberately,
// and a hash is the one place that would be an unwelcome surprise rather than a caught bug. 2^30
// times 16777619 is about 2^54, which fits an i64 with room to spare.
function span_hash(src: String, start: Int, length: Int) -> Int {
    let mutable h: Int = 2166136261;
    let mutable i: Int = 0;
    while i < length {
        h = remainder((h + byte_at(src, start + i)) * 16777619, 1073741824);
        i += 1;
    }
    return remainder(h, 1024);
}

// Note the function just declared, so `find_function` can reach it without a scan.
function (mutable self: Unit) index_fun(src: String, start: Int, length: Int) -> Int {
    if len(self.function_buckets) == 0 {
        let mutable b: Int = 0;
        while b < 1024 {
            let blank: Int = push(self.function_buckets, 0 - 1);
            b += 1;
        }
    }
    let at: Int = span_hash(src, start, length);
    let linked: Int = push(self.function_chain, self.function_buckets[at]);
    self.function_buckets[at] = len(self.function_chain) - 1;
    return 1;
}

// The declared function of this name, through the index.
//
// Was a scan of every function declared so far, which made DECLARING n functions cost O(n^2) — the
// duplicate-name check is a lookup, so the table is walked once per declaration while it grows.
// 3200 declarations took 5.5 seconds and nothing else in the compiler was superlinear.
//
// The chain is walked NEWEST first, which matters: `find_function` answered the first match in
// declaration order before, and a chain built by prepending answers the last. Both are the same
// answer, because a duplicate name is refused — and that refusal is the reason this is a lookup at
// all.
function (mutable self: Unit) find_function(src: String, start: Int, length: Int) -> Int {
    self.find_function_calls += 1;
    if len(self.function_buckets) == 0 {
        return -1;                                   // nothing declared yet
    }
    let mutable i: Int = self.function_buckets[span_hash(src, start, length)];
    while i >= 0 {
        if spans_equal(src, self.functions[i].start, self.functions[i].length, start, length) {
            return i;
        }
        i = self.function_chain[i];
    }
    return -1;
}

function (self: Unit) find_type(src: String, start: Int, length: Int) -> Int {
    let mutable i: Int = 0;
    while i < len(self.types) {
        if spans_equal(src, self.types[i].start, self.types[i].length, start, length) {
            return i;
        }
        i += 1;
    }
    return -1;
}

// Every signature first, so functions may be declared in any order and call each
// other — the same two-pass shape stage-0 uses.
// The names a program may not take: the builtins, `old`, and the two the runtime
// owns. Stage-0 refuses these because a call site cannot tell a shadowed builtin from
// the builtin, and a reader cannot either.
function is_reserved_name(src: String, start: Int, length: Int) -> Bool {
    return span_equal(src, start, length, "print")
        || span_equal(src, start, length, "len")
        || span_equal(src, start, length, "byte_at")
        || span_equal(src, start, length, "push")
        || span_equal(src, start, length, "truncate")
        || span_equal(src, start, length, "substring")
        || span_equal(src, start, length, "to_string")
        || span_equal(src, start, length, "read_file")
        || span_equal(src, start, length, "write_file")
        || span_equal(src, start, length, "write_bytes")
        || span_equal(src, start, length, "argument")
        || span_equal(src, start, length, "argument_count")
        || span_equal(src, start, length, "divide_floor")
        || span_equal(src, start, length, "divide_toward_zero")
        || span_equal(src, start, length, "remainder")
        || span_equal(src, start, length, "hash")
        || span_equal(src, start, length, "old")
        || span_equal(src, start, length, "result")
        || span_equal(src, start, length, "main")
        || span_equal(src, start, length, "exit");
}

// The `self` token of the receiver clause that ends just before `from`. -1 if there is
// none, which the caller treats as a program that is not a method.
function (self: Unit) self_token(from: Int) -> Int {
    // Scans back to the clause's opening `(` rather than counting tokens. A fixed budget of
    // six was enough for `(self)`, `(self: T)` and `(mut self: T)` and one short for
    // `(self: Stack<T>)`, which is seven — so a generic receiver returned -1 and the caller
    // indexed the token array with it. A bound that depends on the shape of what it is
    // scanning is a bound that breaks when the shape grows.
    let mutable i: Int = from - 1;
    while i >= 0 {
        if self.tokens[i].kind == 119 {                // `self`
            return i;
        }
        if self.tokens[i].kind == 29 {                 // `(` — the clause started here
            return 0 - 1;
        }
        i -= 1;
    }
    return 0 - 1;
}

function (mutable self: Unit) collect_method(src: String, index: Int) -> Int {
    let item: Node = self.nodes[index];
    let name: Token = self.tokens[item.token];
    let signature: Node = self.nodes[item.c];
    let receiver: Token = self.tokens[signature.value];
    let mutable mutating: Int = 0;
    if item.value >= 4 { mutating = 1; }
    if flag_pure(item.value) == 1 {
        let complained: Int = self.complain_at(src, item.token,
            "`pure` is not available on a method: a receiver is state, and a claim "
            + "about a function of its arguments cannot be made about one");
    }
    if self.find_method_named(src, receiver.start, receiver.length,
                              name.start, name.length) >= 0 {
        let complained: Int = self.complain_at(src, item.token, "this method is declared twice");
        return 0;
    }
    push(self.methods, Method {
        receiver_start: receiver.start, receiver_length: receiver.length,
        start: name.start, length: name.length,
        return_type: self.declared_type(src, signature.c), parameters: item.a,
        mutating: mutating, flags: item.value,
    });
    return 1;
}

function (mutable self: Unit) collect_declarations(src: String) -> Int {
    let mutable i: Int = 0;
    while i < len(self.items) {
        let index: Int = self.items[i];
        let item: Node = self.nodes[index];
        let name: Token = self.tokens[item.token];
        if item.kind == 83 {
            if item.b == 0 {
                let complained: Int = self.complain_at(src, item.token,
                    "an enum with no variants describes nothing, and no value of it "
                    + "could ever be made");
            }
            let mutable v: Int = 0;
            while v < item.b {
                let variant: Node = self.nodes[self.children[item.a + v]];
                let named: Token = self.tokens[variant.token];
                let mutable later: Int = v + 1;
                while later < item.b {
                    let other: Node = self.nodes[self.children[item.a + later]];
                    let other_name: Token = self.tokens[other.token];
                    if spans_equal(src, named.start, named.length,
                                other_name.start, other_name.length) {
                        let complained: Int = self.complain_at(src, other.token,
                            "this variant is declared twice");
                    }
                    later += 1;
                }
                v += 1;
            }
        }
        if item.kind == 82 {                         // record: fields
            let mutable f: Int = 0;
            while f < item.b {
                let field: Node = self.nodes[self.children[item.a + f]];
                let shaped: Int = self.check_type_shape(src, field.a, field.token);
                let held: Node = self.nodes[field.a];
                if held.kind == 46 {
                    let held_name: Token = self.tokens[held.token];
                    if spans_equal(src, held_name.start, held_name.length,
                                name.start, name.length) {
                        // By value, always: a class that contains itself has no size.
                        let complained: Int = self.complain_at(src, field.token,
                            "a class cannot contain itself: its size would have to be "
                            + "bigger than itself");
                    }
                }
                f += 1;
            }
        }
        if item.kind == 83 {                         // enum: payloads
            let mutable v: Int = 0;
            while v < item.b {
                let variant: Node = self.nodes[self.children[item.a + v]];
                let mutable p: Int = 0;
                while p < variant.c {
                    let payload: Int = self.nested_children[variant.b + p];
                    let shaped: Int = self.check_type_shape(src, payload, variant.token);
                    let held: Node = self.nodes[payload];
                    if held.kind == 46 {
                        // The rule is FINITE WIDTH, not "no enum payload". A width is unbounded only
                        // when a type contains ITSELF by value; recursion through a slice is a
                        // pointer and terminates, which is most recursive data — a tree, a JSON
                        // document, an AST.
                        //
                        // This used to be two flat refusals: one for `E` inside `E` and one for `E`
                        // inside `F`. The second was a proxy and refused finite shapes, and stage-0
                        // did not obey it either — the same shape reached through a generic
                        // instantiation was allowed and worked. One walk now, covering both, and it
                        // follows classes and arrays as well because either can carry the enum on.
                        let carried: Type = self.declared_type(src, payload);
                        if self.embeds_by_value(src, carried, name.start, name.length) {
                            let complained: Int = self.complain_at(src, variant.token,
                                "this variant carries `"
                                + substring(src, name.start, name.length)
                                + "` by value, so its size would have to be bigger than itself. "
                                + "Carry it behind a slice — `["
                                + substring(src, name.start, name.length)
                                + "]` — which is a pointer, so the size is finite and the recursion "
                                + "still works");
                        }
                    }
                    p += 1;
                }
                v += 1;
            }
        }
        if item.kind == 82 || item.kind == 83 {
            if self.find_type(src, name.start, name.length) >= 0 {
                let complained: Int = self.complain_at(src, item.token, "this type is declared twice");
            } else {
                push(self.types, TypeDeclaration { start: name.start, length: name.length,
                                            kind: item.kind, node: index });
            }
        }
        if item.kind == 81 {                         // a method
            let m: Int = self.collect_method(src, index);
        }
        if item.kind == 84 {                         // trait
            push(self.types, TypeDeclaration { start: name.start, length: name.length,
                                        kind: item.kind, node: index });
        }
        if item.kind == 85 {                         // implement Trait for Type { ... }
            let target: Token = self.tokens[item.c];
            push(self.impls, Implementation { trait_start: name.start, trait_len: name.length,
                                    type_start: target.start, type_len: target.length });
            // The methods inside an implementation are declared exactly as free-standing ones
            // are, so they are collected by the same code rather than by a copy of it.
            let mutable k: Int = 0;
            while k < item.b {
                let m: Int = self.collect_method(src, self.children[item.a + k]);
                k += 1;
            }
        }
        if item.kind == 80 || item.kind == 86 {
            if is_reserved_name(src, name.start, name.length) {
                let complained: Int = self.complain_at(src, item.token,
                    "`" + substring(src, name.start, name.length) + "` is a name the "
                    + "language owns, so a program may not declare it");
            }
            let already: Int = self.find_function(src, name.start, name.length);
            let mutable clash: Bool = already >= 0;
            if already >= 0 && item.kind == 86 {
                // An `external function` declares an external FACT, not a definition, so two
                // modules may both declare it — `lib/files.bx` and `lib/os.bx` both need
                // `system`, and neither can know the other did. Stage-0 allows this when
                // the signatures match, and the two must agree.
                if flag_external(self.functions[already].flags) == 1 {
                    clash = false;
                }
            }
            if clash {
                let complained: Int = self.complain_at(src, item.token, "this function is declared twice");
            } else {
                let mutable return_type: Type = unknown_type();
                if item.kind == 80 {
                    let signature: Node = self.nodes[item.c];
                    return_type = self.declared_type(src, signature.c);
                } else {
                    return_type = self.declared_type(src, item.b);   // an external holds it directly
                    // CInt and CDouble are C's widths, not Burxt types: a Burxt caller
                    // passes and receives an Int. So an external's signature is recorded
                    // as Burxt sees it, which is why `strcmp(a, b) < 0` compares two
                    // Ints rather than mixing a CInt with one.
                    return_type = as_burxt_sees(return_type);
                }
                // `pure` and `touches` are the same claim from opposite ends: pure means the answer
                // depends on the arguments and nothing else, which IS touching nothing. Saying both is
                // a contradiction rather than a refinement, and refusing it at the DECLARATION is what
                // makes the message name the contradiction instead of some later call.
                if flag_pure(item.value) == 1 && flag_effects(item.value) > 0 {
                    let complained: Int = self.complain_at(src, item.token,
                        "`pure function " + substring(src, name.start, name.length)
                        + "` cannot also `touches "
                        + effect_name(lowest_effect(flag_effects(item.value)))
                        + "`: `pure` means the answer depends on the arguments and nothing else, "
                        + "which is the same thing as touching nothing. Drop one of the two.");
                }
                let mutable flags: Int = item.value;
                if item.kind == 86 {
                    // The external marker, plus the effect mask the extern declared. An extern's
                    // `touches` is where an effect ENTERS the program — there is no body to reason
                    // about, so the declaration is the only source.
                    flags = 8 + item.c * 64;
                }
                push(self.functions, DeclaredFunction { start: name.start, length: name.length,
                                      return_type: return_type, parameters: item.a, flags: flags });
                let indexed: Int = self.index_fun(src, name.start, name.length);
            }
        }
        i += 1;
    }
    return len(self.functions);
}

// ---- expressions -------------------------------------------------------------
// `expected` carries the declared type inward, which is how a Decimal product can
// know whether a rounding contract was supplied — exactly as in stage-0.
// Every expression's type, recorded as it is decided. The escape check asks about
// expressions the checker has already seen — whether a `+` joined two Strings, say —
// and re-walking them would report every complaint a second time.
function (mutable self: Unit) type_of(src: String, node: Int, expected: Type) -> Type {
    self.type_of_calls += 1;
    let t: Type = self.type_of_inner(src, node, expected);
    // The cache is a slot per NODE. It grows to reach the node being recorded, which costs
    // one push per node over a whole compile, and the last answer for a node stands — a
    // retyped operand (multiplication does that) settles on its second reading.
    while len(self.typed) <= node {
        let filled: Int = push(self.typed, unknown_type());
    }
    self.typed[node] = t;
    return t;
}

function (self: Unit) type_at(node: Int) -> Type {
    // Indexed BY NODE, so a lookup is one load.
    //
    // This was a backwards linear scan until v0.0.87, over a list that grew with every
    // typed expression — O(n²) over a compile, noted at the time as "fine at bootstrap
    // scale". It stopped being fine at 46,000 tokens: the compiler took three and a half
    // minutes on its own source and then exhausted its region, and the language could not
    // grow further until this changed. The lesson is the placeholder, not the algorithm —
    // "fine for now" needs a number attached, or nobody notices when now ends.
    if node < 0 || node >= len(self.typed) {
        return unknown_type();
    }
    return self.typed[node];
}

function (mutable self: Unit) type_of_inner(src: String, node: Int, expected: Type) -> Type {
    if node < 0 {
        return unknown_type();
    }
    let n: Node = self.nodes[node];

    if n.kind == 1 { return simple_type(40); }
    if n.kind == 2 {                                 // a decimal, money or percent
        if expected.kind != 45 {
            return decimal_type(n.a, 0);
        }
        if expected.scale >= n.a {
            // Widening a literal is exact: $5 in a Decimal<2> context is 5.00. The
            // contract comes from the context too, and never rounds the literal —
            // a literal that needed rounding would be refused below.
            return decimal_type(expected.scale, expected.contract);
        }
        // Narrowing: allowed only when every digit dropped is a zero.
        let mutable factor: Int = 1;
        let mutable drop: Int = n.a - expected.scale;
        while drop > 0 {
            factor = factor * 10;
            drop -= 1;
        }
        if remainder(n.value, factor) == 0 {
            return decimal_type(expected.scale, expected.contract);
        }
        if self.in_multiply == 1 {
            return decimal_type(n.a, 0);
        }
        let complained: Int = self.complain_at(src, n.token,
            "this literal needs " + to_string(n.a) + " decimal places but the context "
            + "has only " + to_string(expected.scale) + ", and dropping digits from "
            + "money is refused");
        return unknown_type();
    }
    if n.kind == 3 {                                 // a String literal, or a piece of one
        return simple_type(42);
    }

    if n.kind == 18 {                                // an interpolated String
        // Interpolation IS `to_string` plus `+`, so as a VALUE it allocates and needs a
        // region. As the argument of a `print` it does not — the pieces go out in order
        // and nothing is joined — which is why the print statement checks it separately.
        if !self.has_region() {
            let r: Int = self.needs_region(src, n.token, "this interpolated String");
        }
        let checked: Int = self.check_pieces(src, n);
        return simple_type(42);
    }
    if n.kind == 4 { return simple_type(41); }

    if n.kind == 5 {                                 // a name
        let t: Token = self.tokens[n.token];
        let found: Int = self.find_binding(src, t.start, t.length);
        if found < 0 {
            let complained: Int = self.complain_at(src, n.token, "unknown name");
            return unknown_type();
        }
        return self.bindings[found].bound_type;
    }

    if n.kind == 6 {                                 // -x
        return self.type_of(src, n.a, expected);
    }
    if n.kind == 7 {                                 // !x
        let inner: Type = self.type_of(src, n.a, simple_type(41));
        if !is_unknown(inner) && inner.kind != 41 {
            let complained: Int = self.complain_at(src, n.token,
                "`!` needs a Bool, but this is " + self.show_type(src, inner));
        }
        return simple_type(41);
    }

    if n.kind == 8 {                                 // a + b, a * b
        let outer: Int = self.in_multiply;
        if n.value == 27 { self.in_multiply = 1; }
        let left: Type = self.type_of(src, n.a, expected);
        let right: Type = self.type_of(src, n.b, expected);
        self.in_multiply = outer;
        if is_unknown(left) || is_unknown(right) {
            return unknown_type();
        }
        // `*` combines a quantity with a rate, so the scales may differ — but the
        // product's scale is their SUM, and landing it needs a declared contract.
        if n.value == 27 {
            if left.kind == 45 && right.kind == 45 {
                // The product's TRUE scale is the sum of the operands'. At that scale
                // nothing rounds, so nothing needs declaring — and a contract demanded
                // where no rounding happens teaches the reader that contracts are
                // ceremony. They are not: one appears exactly where a value narrows.
                //
                // A scaled i64 holds 18 fractional digits, so a wider sum must narrow
                // whatever the author wanted. (Relaxed in v0.0.91, with stage-0.)
                let exact: Int = left.scale + right.scale;
                let representable: Bool = exact <= 18;
                if expected.kind == 45 && expected.contract != 0 {
                    return expected;                 // a contract says how it narrows
                }
                if expected.kind == 45 {
                    if representable && expected.scale == exact {
                        return decimal_type(exact, 0);  // the product's own width: exact
                    }
                    let complained: Int = self.complain_at(src, n.token,
                        "`*` on " + self.show_type(src, left) + " and " + self.show_type(src, right)
                        + " has an exact product with " + to_string(exact)
                        + " decimal places, and reaching " + self.show_type(src, expected)
                        + " means rounding it: say how with a rounding contract, or take "
                        + "the exact answer");
                    return unknown_type();
                }
                // Nothing asked for it. Identical operands that carry a contract land the
                // product at their OWN scale — the context does not have to repeat what the
                // operands already say, so `print(a * b)` on money answers in money.
                if self.same_type(src, left, right) && left.contract != 0 {
                    return left;
                }
                if representable {
                    return decimal_type(exact, 0);
                }
                let complained: Int = self.complain_at(src, n.token,
                    "`*` on " + self.show_type(src, left) + " and " + self.show_type(src, right)
                    + " has an exact product with " + to_string(exact)
                    + " decimal places, which does not fit a scaled i64: bind it to a "
                    + "Decimal with a rounding contract");
                return unknown_type();
            }
            if left.kind == 45 && right.kind == 40 { return left; }
            if left.kind == 40 && right.kind == 45 { return right; }
        }
        if n.value == 28 {                           // `/`
            if left.kind == 40 && right.kind == 40 {
                let complained: Int = self.complain_at(src, n.token,
                    "`/` on two Ints would have to round, and one operator cannot say "
                    + "which way — use divide_floor, divide_toward_zero or remainder");
                return unknown_type();
            }
            // A quotient can fall between two representable values — 1.00 / 3 — so
            // unlike `*`, division needs a contract even when the scales match, and
            // the contract has to be on the value being divided.
            if left.kind == 45 && (right.kind == 45 || right.kind == 40) {
                if right.kind == 45 && !self.same_type(src, left, right) {
                    let complained: Int = self.complain_at(src, n.token,
                        "cannot divide " + self.show_type(src, left) + " by " + self.show_type(src, right)
                        + ": division needs the same type, scale included");
                    return unknown_type();
                }
                if left.contract == 0 {
                    let complained: Int = self.complain_at(src, n.token,
                        "`/` on " + self.show_type(src, left) + " needs a rounding contract, "
                        + "because the exact quotient can have more than "
                        + to_string(left.scale) + " decimal places");
                    return unknown_type();
                }
                return left;
            }
        }
        if n.value == 25 && left.kind == 42 && right.kind == 42 {
            if !self.has_region() {
                let r: Int = self.needs_region(src, n.token, "joining two Strings");
            }
            return left;
        }
        if left.kind == 45 && right.kind == 45 {
            // Addition and subtraction never round, so the SCALES must match and the
            // contracts need not: one side carrying a contract and the other none leaves
            // exactly one answer to "if this ever rounds, which way", and the result carries
            // it. Two DIFFERENT contracts is a real ambiguity and stays refused.
            // (Relaxed in v0.0.86, together with stage-0.)
            if left.scale != right.scale {
                let complained: Int = self.complain_at(src, n.token,
                    "cannot combine " + self.show_type(src, left) + " and " + self.show_type(src, right)
                    + ": scales must match. Burxt does not silently rescale money");
                return unknown_type();
            }
            if left.contract != 0 && right.contract != 0 && left.contract != right.contract {
                let complained: Int = self.complain_at(src, n.token,
                    "cannot combine " + self.show_type(src, left) + " and " + self.show_type(src, right)
                    + ": these are two different rounding contracts, and picking one would "
                    + "be a decision nobody wrote down");
                return unknown_type();
            }
            if left.contract != 0 {
                return left;
            }
            return right;
        }
        // `+` and `-` combine like quantities: every other type must match exactly.
        if !self.same_type(src, left, right) {
            let complained: Int = self.complain_at(src, n.token,
                "cannot combine " + self.show_type(src, left) + " and " + self.show_type(src, right)
                + ": addition and subtraction need the same type, scale included");
            return unknown_type();
        }
        return left;
    }

    if n.kind == 9 {                                 // a comparison
        let left: Type = self.type_of(src, n.a, unknown_type());
        let right: Type = self.type_of(src, n.b, left);
        if !is_unknown(left) && !is_unknown(right) && !self.same_type(src, left, right) {
            let complained: Int = self.complain_at(src, n.token,
                "cannot compare " + self.show_type(src, left) + " with " + self.show_type(src, right)
                + ": one equality, no coercion");
        }
        // Two values of a type PARAMETER: whether this is allowed is entirely what the bound
        // says. Without one, a parameter can be stored, copied, passed and returned and
        // nothing else — the body is checked against the signature's promise, not against
        // whatever the instantiations happen to permit.
        let abstract_left: Type = self.resolve_shallow(src, left);
        if abstract_left.kind == 50 {
            let bound: Int = self.bound_of(src, abstract_left.name_start, abstract_left.name_length);
            let ordering: Bool = n.value != 12 && n.value != 13;   // not `==` and not `!=`
            if bound < 0 {
                let complained: Int = self.complain_at(src, n.token,
                    "`" + substring(src, abstract_left.name_start, abstract_left.name_length)
                    + "` is a type parameter with no bound, so two values of it cannot be "
                    + "compared: say so in the signature with a bound");
            } else {
                let named: Token = self.tokens[bound];
                let is_ordered: Bool = span_equal(src, named.start, named.length, "Ordered");
                let is_equatable: Bool = span_equal(src, named.start, named.length, "Equatable");
                if !is_ordered && (ordering || !is_equatable) {
                    let complained: Int = self.complain_at(src, n.token,
                        "comparing two values of `"
                        + substring(src, abstract_left.name_start, abstract_left.name_length)
                        + "` needs `Ordered`, or `Equatable` for `==` and `!=`");
                }
            }
        }
        return simple_type(41);
    }

    if n.kind == 10 {                                // && ||
        let left: Type = self.type_of(src, n.a, simple_type(41));
        let right: Type = self.type_of(src, n.b, simple_type(41));
        if !is_unknown(left) && left.kind != 41 {
            let complained: Int = self.complain_at(src, n.token, "this operator needs a Bool");
        }
        if !is_unknown(right) && right.kind != 41 {
            let complained: Int = self.complain_at(src, n.token, "this operator needs a Bool");
        }
        return simple_type(41);
    }

    // `Enum.Variant` and `Enum.Variant(payload)` — the base names a TYPE, not a
    // variable, so typing it as one reported an unknown name. An enum constructor
    // looks exactly like a field access or a method call until you check the base.
    if n.kind == 11 || n.kind == 14 {
        let base: Node = self.nodes[n.a];
        if base.kind == 5 {
            let base_name: Token = self.tokens[base.token];
            let declared: Int = self.find_type(src, base_name.start, base_name.length);
            if declared >= 0 {
                if self.types[declared].kind == 83 {
                    let mutable holder: Type = Type { kind: 46, scale: 0, contract: 0,
                                          name_start: base_name.start,
                                          name_length: base_name.length };
                    // A generic enum's arguments come from the context: `Option.Some(3)` is an
                    // `Option<Int>` because something said so, and `Option.None` has nothing
                    // else to go on.
                    if expected.kind == 46 && expected.contract > 0
                       && spans_equal(src, expected.name_start, expected.name_length,
                                      base_name.start, base_name.length) {
                        holder = expected;
                    }
                    let checked: Int = self.check_construction(src, holder, n);
                    return holder;
                }
            }
        }
    }

    if n.kind == 17 {                                // an array literal
        if expected.kind != 47 && expected.kind != 48 {
            let visited: Int = self.visit_children(src, node);
            return unknown_type();
        }
        let want: Type = self.declared_type(src, expected.scale);
        if expected.kind == 47 && !self.has_region() {
            let r: Int = self.needs_region(src, n.token, "a growable array");
        }
        if expected.kind == 48 && n.b != expected.contract {
            let complained: Int = self.complain_at(src, n.token,
                "this array holds " + to_string(expected.contract) + " element(s), and "
                + "the literal has " + to_string(n.b) + ": a fixed array's length is "
                + "part of its type");
        }
        let mutable i: Int = 0;
        while i < n.b {
            let got: Type = self.type_of(src, self.children[n.a + i], want);
            if !is_unknown(got) && !self.fits(src, got, want) {
                let complained: Int = self.complain_at(src, n.token,
                    "element " + to_string(i + 1) + " should be " + self.show_type(src, want)
                    + ", but it is " + self.show_type(src, got));
            }
            i += 1;
        }
        return expected;
    }

    if n.kind == 12 {                                // xs[i]
        let holder: Type = self.type_of(src, n.a, unknown_type());
        let index: Type = self.type_of(src, n.b, simple_type(40));
        if !is_unknown(index) && index.kind != 40 {
            let complained: Int = self.complain_at(src, n.token, "an index must be an Int");
        }
        if is_unknown(holder) {
            return unknown_type();
        }
        if holder.kind == 42 {
            let complained: Int = self.complain_at(src, n.token,
                "a String is indexed with byte_at(s, i), which says it reads a BYTE");
            return unknown_type();
        }
        if holder.kind != 47 && holder.kind != 48 {
            let complained: Int = self.complain_at(src, n.token,
                "indexing needs an array, but this is " + self.show_type(src, holder));
            return unknown_type();
        }
        if holder.kind == 48 {
            let index_node: Node = self.nodes[n.b];
            if index_node.kind == 1 {
                // A literal index is known now, so the bounds check is a compile error
                // rather than an exit 70 later. The runtime check stays for the rest.
                if index_node.value >= holder.contract || index_node.value < 0 {
                    let complained: Int = self.complain_at(src, n.token,
                        "this array holds " + to_string(holder.contract)
                        + " element(s), so " + to_string(index_node.value)
                        + " is past its end");
                }
            }
        }
        return self.declared_type(src, holder.scale);
    }

    // Kind 21: the value being returned, which is what an elided `[>= $0.00]` on a return type
    // compares against, and what `it` means there. It answers the enclosing signature's return type
    // and has no name at all — which is the point. The word `result` appears in no program that uses
    // the bracket form, so there is no span for a name node to carry, and inventing one was the wall
    // spec/M13 spent two versions describing.
    if n.kind == 21 {
        if self.result_type_node < 0 {
            let complained: Int = self.complain_at(src, n.token,
                "the value being returned is only meaningful in a contract on the return type");
            return unknown_type();
        }
        return self.declared_type(src, self.result_type_node);
    }

    if n.kind == 14 {                                // a method call on a value
        // `Account.open(...)` — an ASSOCIATED function, which reads exactly like a method call and
        // is told apart the same way stage-0 tells one: by what the name in FRONT of the dot is. A
        // class name that is not also a binding, holding a method flagged associated.
        //
        // Checked before `type_of` on the base, because `Account` on its own is not an expression
        // and asking for its type is what produced "unknown name" for every constructor call.
        let associated: Int = self.associated_at(src, node);
        if associated >= 0 {
            let m: Method = self.methods[associated];
            if flag_allocates(m.flags) == 1 && !self.has_region() {
                let r: Int = self.needs_region(src, n.token,
                    "`" + substring(src, m.start, m.length) + "`");
            }
            if self.in_pure == 1 {
                let complained: Int = self.not_pure(src, n.token, "call a method");
            }
            let ok: Int = self.check_against_params(src, n.token, n.b, m.parameters, "method");
            // The node is marked so the emitter needs none of this reasoning again: `c` is unused
            // on a method call, and a second copy of "is this associated" in the backend is how
            // two answers to one question drift apart.
            self.nodes[node] = Node { kind: n.kind, a: n.a, b: n.b, c: 1,
                                  value: n.value, token: n.token };
            return m.return_type;
        }
        let holder: Type = self.type_of(src, n.a, unknown_type());
        if is_unknown(holder) {
            let visited: Int = self.check_args(src, n.b);
            return unknown_type();
        }
        if holder.kind == 49 {                       // dynamic Trait
            return self.dynamic_method(src, holder, n);
        }
        let found: Int = self.find_method(src, holder, n.token);
        if found < 0 {
            let visited: Int = self.check_args(src, n.b);
            let complained: Int = self.complain_at(src, n.token,
                self.show_type(src, holder) + " has no such method");
            return unknown_type();
        }
        let m: Method = self.methods[found];
        if self.in_pure == 0 {
            let reaches: Int = flag_effects(m.flags);
            if reaches > 0 {
                let checked: Int = self.check_effects(src, n.token,
                    self.show_type(src, holder) + "." + substring(src, m.start, m.length),
                    reaches);
            }
        }
        if flag_private(m.flags) == 1 && !self.inside_class(src, holder) {
            let complained: Int = self.complain_at(src, n.token,
                "`" + self.show_type(src, holder) + "."
                + substring(src, m.start, m.length)
                + "()` is private: it is callable only from `"
                + self.show_type(src, holder) + "`'s own methods");
        }
        if flag_allocates(m.flags) == 1 && !self.has_region() {
            let r: Int = self.needs_region(src, n.token,
                "`" + substring(src, m.start, m.length) + "`");
        }
        if self.in_pure == 1 {
            // Not "a method that is not pure": `pure` is refused ON methods, so a
            // method call from a pure function can never be allowed.
            let complained: Int = self.not_pure(src, n.token, "call a method");
        }
        // The receiver's arguments are in scope for the whole call: a parameter declared `T`
        // has to accept a Point when the receiver is a `Pair<Point>`, and the answer has to BE
        // a Point, because whoever receives it no longer has the bindings. The same shape the
        // field rule below uses — a method is a field's worth of resolution plus arguments.
        let base: Int = self.bind_from_application(src, holder);
        let ok: Int = self.check_against_params(src, n.token, n.b, m.parameters, "method");
        let answer: Type = self.resolve_deep(src, m.return_type, n.token);
        let dropped: Int = truncate(self.type_bindings, base);
        return answer;
    }

    if n.kind == 11 {                                // a field access
        let holder: Type = self.type_of(src, n.a, unknown_type());
        if is_unknown(holder) {
            return unknown_type();
        }
        // The field's type as the HOLDER sees it: `Stack<Int>.items` is `[Int]`, not `[T]`,
        // because whoever receives this answer no longer has the bindings.
        let base: Int = self.bind_from_application(src, holder);
        let declared: Type = self.field_type(src, holder, n.token);
        let field: Type = self.resolve_deep(src, declared, n.token);
        let dropped: Int = truncate(self.type_bindings, base);
        if is_unknown(field) {
            let complained: Int = self.complain_at(src, n.token,
                self.show_type(src, holder) + " has no such field");
        }
        if self.field_is_private(src, holder, n.token) && !self.inside_class(src, holder) {
            let complained: Int = self.complain_at(src, n.token,
                "`" + self.show_type(src, holder) + "."
                + substring(src, self.tokens[n.token].start, self.tokens[n.token].length)
                + "` is private: it is reachable only from `"
                + self.show_type(src, holder) + "`'s own methods");
        }
        return field;
    }

    if n.kind == 19 {                                // a class literal
        let name: Token = self.tokens[n.token];
        let found: Int = self.find_type(src, name.start, name.length);
        if found < 0 {
            let complained: Int = self.complain_at(src, n.token, "unknown type");
            let visited: Int = self.visit_children(src, node);
            return unknown_type();
        }
        let mutable holder: Type = Type { kind: 46, scale: 0, contract: 0,
                              name_start: name.start, name_length: name.length };
        if expected.kind == 46 && expected.contract > 0
           && spans_equal(src, expected.name_start, expected.name_length,
                          name.start, name.length) {
            holder = expected;                       // `Holder<Int>` said what T is
        }
        let mutable i: Int = 0;
        while i < n.b {
            let pair: Node = self.nodes[self.children[n.a + i]];
            let base: Int = self.bind_from_application(src, holder);
            let stated: Type = self.field_type(src, holder, pair.token);
            let want: Type = self.resolve_deep(src, stated, pair.token);
            let dropped: Int = truncate(self.type_bindings, base);
            if is_unknown(want) {
                let complained: Int = self.complain_at(src, pair.token,
                    self.show_type(src, holder) + " has no such field");
            }
            // A private field a literal could still set from outside would be half a boundary:
            // `private` would protect reading and writing but not CONSTRUCTION, and every
            // `requires` on the class's constructor would be a suggestion. This is the rule that
            // turns the other two into a wall.
            if self.field_is_private(src, holder, pair.token) && !self.inside_class(src, holder) {
                let complained: Int = self.complain_at(src, n.token,
                    "`" + self.show_type(src, holder) + "."
                    + substring(src, self.tokens[pair.token].start,
                                self.tokens[pair.token].length)
                    + "` is private, so `" + self.show_type(src, holder)
                    + "` cannot be built here: a literal may set a private field only inside `"
                    + self.show_type(src, holder) + "`");
            }
            let got: Type = self.type_of(src, pair.a, want);
            if !is_unknown(got) && !is_unknown(want) && !self.fits(src, got, want) {
                let complained: Int = self.complain_at(src, pair.token,
                    "this field is " + self.show_type(src, want) + ", but the value is "
                    + self.show_type(src, got));
            }
            i += 1;
        }
        // Every field, not just the ones a writer remembered: a class with a hole in
        // it has no value the compiler could invent that would be right.
        let decl: TypeDeclaration = self.types[found];
        let item: Node = self.nodes[decl.node];
        let mutable f: Int = 0;
        while f < item.b {
            let field: Node = self.nodes[self.children[item.a + f]];
            let field_name: Token = self.tokens[field.token];
            let mutable given: Bool = false;
            let mutable g: Int = 0;
            while g < n.b {
                let pair: Node = self.nodes[self.children[n.a + g]];
                let pair_name: Token = self.tokens[pair.token];
                if spans_equal(src, pair_name.start, pair_name.length,
                            field_name.start, field_name.length) {
                    given = true;
                }
                g += 1;
            }
            if !given {
                let complained: Int = self.complain_at(src, n.token,
                    "this literal leaves out `"
                    + substring(src, field_name.start, field_name.length) + "`");
            }
            f += 1;
        }
        return holder;
    }

    if n.kind == 13 {                                // a call
        let t: Token = self.tokens[n.token];
        // The effect check, at the TOP of the arm and before the builtin dispatch.
        //
        // Placement is the whole of it, and stage-0 records getting this wrong: further down, past the
        // builtins, `read_file` was invisible to the rule that exists to catch exactly that.
        //
        // Silent inside a `pure` function, so the purity rule speaks instead. Both are true there — a
        // pure function declares no effects and may reach none — but "`pure function f` may not read a
        // file" names the PROMISE being broken, and the effect message would only name the
        // bookkeeping. One rule speaks per situation and the more specific one wins.
        if self.in_pure == 0 {
            let called: String = substring(src, t.start, t.length);
            let mutable reaches: Int = builtin_effects(called);
            let declared_fn: Int = self.find_function(src, t.start, t.length);
            if declared_fn >= 0 {
                reaches = flag_effects(self.functions[declared_fn].flags);
            }
            if reaches > 0 {
                let checked: Int = self.check_effects(src, n.token, called, reaches);
            }
        }
        if span_equal(src, t.start, t.length, "old") {
            // `old(e)` is the pre-state, hoisted to the function's entry. It means
            // nothing where there is no exit to compare against.
            if self.in_ensures == 0 {
                let complained: Int = self.complain_at(src, n.token,
                    "`old(...)` is the value on entry, so it only means something in "
                    + "an `ensures` clause");
            }
            let list: Node = self.nodes[n.a];
            if list.b != 1 {
                let complained: Int = self.complain_at(src, n.token, "`old` takes one expression");
                return unknown_type();
            }
            let inner: Int = self.children[list.a];
            let held: Node = self.nodes[inner];
            if held.kind == 5 {
                let named: Token = self.tokens[held.token];
                if span_equal(src, named.start, named.length, "result") {
                    let complained: Int = self.complain_at(src, n.token,
                        "`old(result)` is a contradiction: the result does not exist "
                        + "on entry");
                    return unknown_type();
                }
            }
            let got: Type = self.type_of(src, inner, unknown_type());
            if got.kind == 46 || got.kind == 47 || got.kind == 48 || got.kind == 49 {
                let complained: Int = self.complain_at(src, n.token,
                    "`old` of " + self.show_type(src, got) + " would need a copy of the whole "
                    + "value at entry, which is not built: name the fields instead");
                return unknown_type();
            }
            return got;
        }
        let found: Int = self.find_function(src, t.start, t.length);
        if found < 0 {
            // A builtin, or a name nobody declared. The compiler knows the builtins,
            // so the checker knows them too rather than staying silent about calls.
            let builtin: Type = self.builtin_type(src, t, n.token, n.a);
            if is_unknown(builtin) {
                let complained: Int = self.complain_at(src, n.token, "unknown function");
            }
            return builtin;
        }
        let signature: DeclaredFunction = self.functions[found];
        if flag_allocates(signature.flags) == 1 && !self.has_region() {
            let r: Int = self.needs_region(src, n.token,
                "`" + substring(src, signature.start, signature.length) + "`");
        }
        if self.in_pure == 1 && flag_pure(signature.flags) == 0 {
            let complained: Int = self.not_pure(src, n.token,
                "call `" + substring(src, signature.start, signature.length)
                + "`, which is not `pure`");
        }
        // A generic call: bind each type parameter from the arguments, then check exactly as
        // an ordinary call is checked. Nothing below this line knows generics exist — the
        // bindings do their work through `same_type`, which resolves as it recurses.
        let base: Int = len(self.type_bindings);
        // This call's bindings begin here, and `resolve_shallow` looks no further back while it is in
        // effect. Saved and restored, so a nested call gets its own clean view of `T` and this one gets
        // its view back afterwards.
        let outer_floor: Int = self.type_binding_floor;
        self.type_binding_floor = base;
        let generic: Int = self.generic_named(src, t.start, t.length);
        if generic >= 0 {
            // Anything the arguments cannot settle is read from the EXPECTATION first, so that
            // `let m: Map<String, Int> = map_new();` works: a type parameter appearing only in the
            // return type has no argument to infer from, and the annotation already says what it
            // is, in the place this language says a type belongs. Better than a turbofish, which
            // would ask a question the context has already answered.
            //
            // Bound BEFORE the arguments are matched, so an argument that disagrees still fails
            // where it should — `unify` refuses to rebind a parameter to something that does not
            // agree with what it already stands for.
            // Only when there IS an expectation. `print(identity(3))` has none, and binding `T`
            // to "unknown" before the arguments are looked at poisoned it — the argument then
            // disagreed with a parameter nobody had settled, and nine valid programs were refused.
            if !is_unknown(expected) {
                let from_context: Bool = self.unify(src, signature.return_type, expected);
            }
            let bound: Int = self.bind_type_arguments(src, generic, n.a, signature.parameters,
                                                      n.token);
        }
        let ok: Int = self.check_against_params(src, n.token, n.a, signature.parameters,
                                                "function");
        // DEEPLY, not shallowly. `resolve_shallow` only answers for a bare parameter, so a
        // function returning `Map<K, V>` answered `Map<K, V>` — with the parameters still in it —
        // and whoever received that had no bindings left to make sense of them. The emitter reads
        // this cached answer to pick which copy to call, so a half-resolved one meant a call to an
        // unmangled `@map_new` that nothing defines.
        let answer: Type = self.resolve_deep(src, signature.return_type, n.token);
        // The bindings belong to this call. A nested generic call pushed its own on top and
        // truncating restores ours, which is why the base is taken before and not after.
        let dropped: Int = truncate(self.type_bindings, base);
        self.type_binding_floor = outer_floor;
        return answer;
    }

    // Anything else — fields, method calls, indexing, record and array literals —
    // is phase 4b. Its children are still visited so unknown names are still found.
    let visited: Int = self.visit_children(src, node);
    return unknown_type();
}

// Walk an expression's children without judging the node itself.
function (mutable self: Unit) visit_children(src: String, node: Int) -> Int {
    let n: Node = self.nodes[node];
    if n.kind == 11 || n.kind == 6 || n.kind == 7 {
        let a: Type = self.type_of(src, n.a, unknown_type());
        return 1;
    }
    if n.kind == 12 || n.kind == 14 {
        let a: Type = self.type_of(src, n.a, unknown_type());
        if n.kind == 12 {
            let b: Type = self.type_of(src, n.b, simple_type(40));
        }
        return 1;
    }
    if n.kind == 17 || n.kind == 19 {                // array or class literal
        let mutable i: Int = 0;
        while i < n.b {
            let child: Int = self.children[n.a + i];
            let field: Node = self.nodes[child];
            if n.kind == 19 {
                let v: Type = self.type_of(src, field.a, unknown_type());
            } else {
                let v: Type = self.type_of(src, child, unknown_type());
            }
            i += 1;
        }
        return 1;
    }
    return 0;
}

// Arity and argument types against a declared parameter list. Shared by function and
// method calls, because what the reader needs to be told is the same either way.
function (mutable self: Unit) check_against_params(src: String, at: Int, list_node: Int,
                                        params_node: Int, what: String) -> Int {
    let list: Node = self.nodes[list_node];
    let params: Node = self.nodes[params_node];
    if list.b != params.b {
        let complained: Int = self.complain_at(src, at,
            "this call passes " + to_string(list.b) + " argument(s), but the "
            + what + " takes " + to_string(params.b));
        return 0;
    }
    let mutable i: Int = 0;
    while i < list.b {
        let param: Node = self.nodes[self.children[params.a + i]];
        let want: Type = as_burxt_sees(self.declared_type(src, param.a));
        let outer: Int = self.in_multiply;
        self.in_multiply = 0;                             // an argument is its own context
        let got: Type = self.type_of(src, self.children[list.a + i], want);
        self.in_multiply = outer;
        if !is_unknown(got) && !self.fits(src, got, want) {
            let complained: Int = self.complain_at(src, at,
                "argument " + to_string(i + 1) + " should be " + self.show_type(src, want)
                + ", but it is " + self.show_type(src, got));
        }
        i += 1;
    }
    return 1;
}

function (mutable self: Unit) check_args(src: String, list_node: Int) -> Int {
    if list_node < 0 {
        return 0;
    }
    let list: Node = self.nodes[list_node];
    let mutable i: Int = 0;
    while i < list.b {
        let argument: Type = self.type_of(src, self.children[list.a + i], unknown_type());
        i += 1;
    }
    return list.b;
}

// ---- statements --------------------------------------------------------------
function (mutable self: Unit) check_block_nodes(src: String, block: Int, return_type: Type) -> Int {
    if block < 0 {
        return 0;
    }
    let node: Node = self.nodes[block];
    self.depth += 1;
    let mutable i: Int = 0;
    while i < node.b {
        let stmt: Int = self.children[node.a + i];
        let checked: Int = self.check_stmt_node(src, stmt, return_type);
        // Anything after a statement that always leaves the block can never run, and
        // a reader who wrote it believed otherwise. Reported once, at the first one.
        if self.stmt_exits(stmt) && i + 1 < node.b {
            let next: Node = self.nodes[self.children[node.a + i + 1]];
            let complained: Int = self.complain_at(src, next.token,
                "this can never run: the statement before it always leaves the block");
            i = node.b;
        }
        i += 1;
    }
    // Everything declared inside the block leaves scope at the closing brace. One
    // `truncate` rather than a loop: the bindings a block made are the ones on top.
    let mutable keep: Int = len(self.bindings);
    while keep > 0 && self.bindings[keep - 1].depth >= self.depth {
        keep -= 1;
    }
    let dropped: Int = truncate(self.bindings, keep);
    self.depth -= 1;
    return node.b;
}

function (mutable self: Unit) check_stmt_node(src: String, stmt: Int, return_type: Type) -> Int {
    if stmt < 0 {
        return 0;
    }
    let n: Node = self.nodes[stmt];

    if n.kind == 60 {                                // let
        // Two paths, and only the first line differs: with an annotation the value is
        // checked AGAINST a type, without one the value IS the type. Inference removes
        // typing, not checking. See spec/M10-ERGONOMICS.md §1.
        let mutable declared: Type = unknown_type();
        if n.a >= 0 {
            declared = self.declared_type(src, n.a);
            let actual: Type = self.type_of(src, n.b, declared);
            if !is_unknown(actual) && !self.fits(src, actual, declared) {
                let complained: Int = self.complain_at(src, n.token,
                    "declared " + self.show_type(src, declared) + ", but the value is "
                    + self.show_type(src, actual));
            }
        } else {
            declared = self.type_of(src, n.b, unknown_type());
            // `let nothing = Option.None;` and `let b = Bag { items: [] };` name a generic
            // and settle nothing: the value carries no type to read `T` off. With an
            // annotation both are fine, so the fix is to write one, and the message says so
            // rather than reporting the missing type as a mystery later.
            if self.unsettled_generic(src, declared) {
                let complained: Int = self.complain_at(src, n.token,
                    "cannot tell what " + self.show_type(src, declared)
                    + " holds from this value: write the type, as in "
                    + "`let x: " + self.show_type(src, declared) + "<Int> = ...`");
            }
        }
        let name: Token = self.tokens[n.token];
        // Shadowing is refused, so a second `let` of the same name is an error.
        if self.find_binding(src, name.start, name.length) >= 0 {
            let complained: Int = self.complain_at(src, n.token,
                "this name is already declared — Burxt does not shadow");
        }
        push(self.bindings, Binding { start: name.start, length: name.length,
                              bound_type: declared, writable: n.value, depth: self.depth });
        return 1;
    }

    if n.kind == 72 {                                // for x in xs
        let holder: Type = self.type_of(src, n.a, unknown_type());
        let name: Token = self.tokens[n.token];
        if is_unknown(holder) {
            let skipped: Int = self.check_block_nodes(src, n.b, return_type);
            return 1;
        }
        if holder.kind == 42 {
            let complained: Int = self.complain_at(src, n.token,
                "`for` iterates an array, and a String is bytes: use byte_at(s, i), "
                + "which says BYTE so the byte-versus-character question cannot hide");
            return 1;
        }
        if holder.kind != 47 && holder.kind != 48 {
            let complained: Int = self.complain_at(src, n.token,
                "`for` iterates an array, and this is " + self.show_type(src, holder));
            return 1;
        }
        if self.find_binding(src, name.start, name.length) >= 0 {
            let complained: Int = self.complain_at(src, n.token,
                "this name is already declared — Burxt does not shadow, and a `for` "
                + "binding is a binding");
        }
        // The element is a COPY, and immutable: nothing may be written back through it.
        let element: Type = self.declared_type(src, holder.scale);
        let base: Int = len(self.bindings);
        self.depth += 1;
        push(self.bindings, Binding { start: name.start, length: name.length, bound_type: element,
                              writable: 0, depth: self.depth });
        self.loop_depth += 1;
        let body: Int = self.check_block_nodes(src, n.b, return_type);
        self.loop_depth -= 1;
        self.depth -= 1;
        let dropped: Int = truncate(self.bindings, base);
        return 1;
    }

    if n.kind == 61 {                                // assignment
        let target: Node = self.nodes[n.a];
        let want: Type = self.type_of(src, n.a, unknown_type());
        let got: Type = self.type_of(src, n.b, want);
        if !is_unknown(got) && !is_unknown(want) && !self.fits(src, got, want) {
            let complained: Int = self.complain_at(src, n.token,
                "cannot assign " + self.show_type(src, got) + " to " + self.show_type(src, want));
        }
        // Only a `let mutable` binding may be assigned to.
        if target.kind == 5 {
            let name: Token = self.tokens[target.token];
            let found: Int = self.find_binding(src, name.start, name.length);
            if found >= 0 && self.bindings[found].writable == 0 {
                let complained: Int = self.complain_at(src, target.token,
                    "this was declared immutable — declare it `let mutable` to allow it");
            }
        }
        return 1;
    }

    if n.kind == 62 {                                // print
        if self.in_pure == 1 {
            let complained: Int = self.not_pure(src, n.token, "print");
        }
        // A printed type PARAMETER, found without typing the expression. Calling `type_of`
        // here would fill the cache that the rules below read, and those rules have been
        // switching on `unknown` — so making them live rejected nine programs stage-0
        // accepts. That is a real gap in this branch, recorded rather than fixed blind:
        // the rules were written against an assumption this file no longer holds.
        let printed: Node = self.nodes[n.a];
        if printed.kind == 5 {
            let referenced: Token = self.tokens[printed.token];
            let where: Int = self.find_binding(src, referenced.start, referenced.length);
            if where >= 0 && self.bindings[where].bound_type.kind == 50 {
                let named: Type = self.bindings[where].bound_type;
                let complained: Int = self.complain_at(src, n.token,
                    "`" + substring(src, named.name_start, named.name_length)
                    + "` is a type parameter with no bound, so a value of it can be stored, "
                    + "copied, passed and returned — not printed, which needs to know what "
                    + "the value IS");
            }
        }
        let shown: Type = self.type_at(n.a);
        if shown.kind == 50 {
            let complained: Int = self.complain_at(src, n.token,
                "`" + substring(src, shown.name_start, shown.name_length)
                + "` is a type parameter with no bound, so a value of it can be stored, "
                + "copied, passed and returned — not printed, which needs to know what the "
                + "value IS");
        }
        if shown.kind == 46 || shown.kind == 49 || shown.kind == 47 || shown.kind == 48 {
            let complained: Int = self.complain_at(src, n.token,
                "`print` renders a number, a Bool, a Decimal or a String — "
                + self.show_type(src, shown) + " has no one rendering the language can choose "
                + "for it");
        }
        let target: Node = self.nodes[n.a];
        if target.kind == 18 {
            // Printing an interpolated string writes its pieces in order, so no String is
            // built and no region is needed. Used as a VALUE it is a join, and that does.
            let checked: Int = self.check_pieces(src, target);
            return 1;
        }
    }
    if n.kind == 62 || n.kind == 70 {                // print, expression statement
        let value: Type = self.type_of(src, n.a, unknown_type());
        return 1;
    }

    if n.kind == 63 || n.kind == 64 {                // return, return tail
        if self.in_function == 0 {
            let complained: Int = self.complain_at(src, n.token,
                "there is nothing here to return from: top-level code runs, it does "
                + "not answer");
            let visited: Type = self.type_of(src, n.a, unknown_type());
            return 1;
        }
        let value: Type = self.type_of(src, n.a, return_type);
        if !is_unknown(value) && !is_unknown(return_type) && !self.fits(src, value, return_type) {
            let complained: Int = self.complain_at(src, n.token,
                "this function returns " + self.show_type(src, return_type) + ", but the value is "
                + self.show_type(src, value));
        }
        if n.kind == 64 {
            let checked: Int = self.check_tail(src, n, return_type);
        }
        // The escape rule, and the whole of M1 in one condition: a built value may
        // leave a function ONLY when it was built in the CALLER's region — which means
        // `allocates`, and no region of this function's own open around the return.
        // A `region` block ends at its closing brace, so anything built inside it
        // would outlive its storage.
        if self.expr_allocates(src, n.a) {
            // Probing: the SECOND way a function turns out to allocate, and missing it made
            // the inference silently incomplete rather than wrong. `has_region` catches the
            // first way — something in the body wanted a region — but a function can allocate
            // purely by RETURNING built data it never bound. `lib/map.bx`'s `map_new` returns
            // `Map { entries: [], slots: [], live: 0 }` straight out, with no `let` anywhere,
            // so nothing ever asked and the probe credited nothing. Asking here classes it,
            // and classes it in the one place that knows how.
            if self.probing == 1 {
                let asked: Bool = self.has_region();
                return 1;
            }
            // The escape rule, and after slice 2 it is the ONLY one left: a value built
            // inside a `region` block cannot leave it, because that block releases at its
            // closing brace. Outside one there is nothing to escape from — the bytes live in
            // the program's arena and outlive every call. The `in_caller_region` half is gone
            // with the word that fed it.
            if self.region_depth > 0 {
                let complained: Int = self.complain_at(src, n.token,
                    "cannot return this: it was built inside a `region` block, which "
                    + "releases at its closing brace, so its storage would not outlive "
                    + "the call. Move the allocation out of the `region` block, or return "
                    + "a scalar summary.");
            }
        }
        return 1;
    }

    if n.kind == 65 {                                // if
        let cond: Type = self.type_of(src, n.a, simple_type(41));
        if !is_unknown(cond) && cond.kind != 41 {
            let complained: Int = self.complain_at(src, n.token, "an `if` condition must be a Bool");
        }
        let t: Int = self.check_block_nodes(src, n.b, return_type);
        if n.c >= 0 {
            let other: Node = self.nodes[n.c];
            if other.kind == 16 {
                let f: Int = self.check_block_nodes(src, n.c, return_type);
            } else {
                let f: Int = self.check_stmt_node(src, n.c, return_type);
            }
        }
        return 1;
    }

    if n.kind == 66 {                                // while
        let cond: Type = self.type_of(src, n.a, simple_type(41));
        if !is_unknown(cond) && cond.kind != 41 {
            let complained: Int = self.complain_at(src, n.token, "a `while` condition must be a Bool");
        }
        self.loop_depth += 1;
        let body: Int = self.check_block_nodes(src, n.b, return_type);
        self.loop_depth -= 1;
        return 1;
    }

    if n.kind == 67 || n.kind == 68 {                // break, continue
        if self.loop_depth == 0 {
            let complained: Int = self.complain_at(src, n.token,
                "there is no loop here to leave: `break` and `continue` only mean "
                + "something inside `while`");
        }
        return 1;
    }

    if n.kind == 69 {                                // region
        if self.region_depth > 0 {
            let complained: Int = self.complain_at(src, n.token,
                "regions do not nest: the inner one would end while the outer is still "
                + "open, and one bump pointer cannot serve two marks");
        }
        self.region_depth += 1;
        let body: Int = self.check_block_nodes(src, n.a, return_type);
        self.region_depth -= 1;
        return 1;
    }

    if n.kind == 71 {                                // match
        let value: Type = self.type_of(src, n.a, unknown_type());
        let mutable enum_decl: Int = -1;
        if value.kind == 46 {
            let declared: Int = self.find_type(src, value.name_start, value.name_length);
            if declared >= 0 {
                if self.types[declared].kind == 83 { enum_decl = declared; }
            }
        }
        // A SCALAR match — on an Int, a String or a Bool. A different set of rules, and they are the
        // OPPOSITE of the enum ones on purpose: an enum match refuses `_` because listing every
        // variant is the point, and a scalar match REQUIRES it because `Int` cannot be enumerated and
        // a match without a catch-all would be a hole with no error to mark it. Both messages say
        // which rule they are, because two rules for one keyword that differ will otherwise read as
        // arbitrary.
        if value.kind == 40 || value.kind == 41 || value.kind == 42 {
            let checked: Int = self.check_scalar_match(src, n, value, return_type);
            return 1;
        }
        if !is_unknown(value) && enum_decl < 0 {
            let complained: Int = self.complain_at(src, n.token,
                "`match` chooses between an enum's variants or a scalar, and "
                + self.show_type(src, value) + " is neither. Use `if` to branch on anything else");
        }
        if enum_decl >= 0 {
            // `_` on an ENUM match, said as itself. The parser accepts `_` as an arm pattern now
            // (a scalar match requires one), so an enum match with a wildcard reaches here — and
            // without this it was reported as "no arm for `Stop`", which names a symptom and sends
            // the reader to add a variant they already handled. The rule being broken is the
            // wildcard, so the message is about the wildcard.
            let mutable w: Int = 0;
            while w < n.c {
                let arm: Node = self.nodes[self.children[n.b + w]];
                let pattern: Token = self.tokens[arm.token];
                if span_equal(src, pattern.start, pattern.length, "_") {
                    let complained: Int = self.complain_at(src, arm.token,
                        "Burxt has no `_` wildcard arm on an enum: it would silently absorb "
                        + "variants added later, which is the one thing exhaustive matching exists "
                        + "to prevent. List the remaining variants");
                }
                w += 1;
            }
            // Every variant needs an arm, and no variant twice: exhaustiveness is what
            // makes a match an answer rather than a guess, and there is no `_` to hide
            // behind. Both questions are the same walk.
            let decl: Node = self.nodes[self.types[enum_decl].node];
            let mutable v: Int = 0;
            while v < decl.b {
                let variant: Node = self.nodes[self.children[decl.a + v]];
                let named: Token = self.tokens[variant.token];
                let mutable seen: Int = 0;
                let mutable a: Int = 0;
                while a < n.c {
                    let arm: Node = self.nodes[self.children[n.b + a]];
                    let arm_name: Token = self.tokens[arm.token];
                    if spans_equal(src, arm_name.start, arm_name.length,
                                named.start, named.length) {
                        seen += 1;
                    }
                    a += 1;
                }
                if seen == 0 {
                    let complained: Int = self.complain_at(src, n.token,
                        "this match has no arm for `"
                        + substring(src, named.start, named.length) + "`");
                }
                if seen > 1 {
                    let complained: Int = self.complain_at(src, n.token,
                        "`" + substring(src, named.start, named.length)
                        + "` has more than one arm, and only the first could ever run");
                }
                v += 1;
            }
        }
        let mutable i: Int = 0;
        while i < n.c {
            let arm: Node = self.nodes[self.children[n.b + i]];
            // The arm's bindings take the variant's payload types, and leave scope
            // with the arm — which is what `truncate` is for.
            let base: Int = len(self.bindings);
            let bound: Int = self.bind_arm(src, value, arm);
            let body: Int = self.check_block_nodes(src, arm.a, return_type);
            let dropped: Int = truncate(self.bindings, base);
            i += 1;
        }
        return 1;
    }

    return 0;
}

// A `match` on an Int, a String or a Bool.
//
// The arms are literals and a `_`, and every rule here is the mirror of the enum ones. `_` is
// REQUIRED and must be LAST — an arm after it could never run, and silently unreachable code is
// exactly what a reviewer should not have to spot.
//
// Equality is the ordinary one: no coercion, so an Int literal does not match a String subject. That
// is not a special rule for `match`, it is the one rule `==` follows everywhere, which is why it
// needed no new machinery.
function (mutable self: Unit) check_scalar_match(src: String, n: Node, value: Type,
                                       return_type: Type) -> Int {
    let mutable wildcards: Int = 0;
    let mutable i: Int = 0;
    while i < n.c {
        let arm: Node = self.nodes[self.children[n.b + i]];
        let pattern: Token = self.tokens[arm.token];
        let is_wildcard: Bool = pattern.kind == 1
                                && span_equal(src, pattern.start, pattern.length, "_");
        if arm.c > 0 {
            let complained: Int = self.complain_at(src, arm.token,
                "a literal carries nothing to name — payload names belong to an enum variant");
        }
        if is_wildcard {
            wildcards += 1;
            if wildcards > 1 {
                let complained: Int = self.complain_at(src, arm.token,
                    "this `match` has two `_` arms");
            }
        } else {
            if wildcards > 0 {
                let complained: Int = self.complain_at(src, arm.token,
                    "this arm comes after the `_` arm, so it could never run. Put `_` last");
            }
            // The literal's type, from the token the parser left. A name that is not `_` is a
            // variant name, which a scalar match cannot have.
            let mutable literal: Int = 0;
            if pattern.kind == 2 { literal = 40; }
            if pattern.kind == 4 { literal = 42; }
            if pattern.kind == 120 || pattern.kind == 121 { literal = 41; }
            if literal == 0 {
                let complained: Int = self.complain_at(src, arm.token,
                    "this `match` is on " + self.show_type(src, value) + ", so `"
                    + substring(src, pattern.start, pattern.length)
                    + "` is not a pattern it can have — a scalar match takes literals and `_`, "
                    + "not variant names");
            } else {
                // An Int literal against a Decimal subject is the one crossing allowed, the same way
                // `price * 3` is: an Int is exact at any scale.
                let mutable fits: Bool = literal == value.kind;
                if value.kind == 45 && literal == 40 {
                    fits = true;
                }
                if !fits {
                    let complained: Int = self.complain_at(src, arm.token,
                        "this `match` is on " + self.show_type(src, value) + ", but `"
                        + substring(src, pattern.start, pattern.length) + "` is "
                        + self.show_type(src, simple_type(literal))
                        + ". There is one equality in Burxt and it never converts");
                }
                // No literal twice, for the same reason no variant may have two arms: only the
                // first could ever run, and the second is a claim the reader would trust.
                let mutable k: Int = 0;
                while k < i {
                    let earlier: Node = self.nodes[self.children[n.b + k]];
                    let seen: Token = self.tokens[earlier.token];
                    if spans_equal(src, seen.start, seen.length, pattern.start, pattern.length) {
                        let complained: Int = self.complain_at(src, arm.token,
                            "`" + substring(src, pattern.start, pattern.length)
                            + "` is matched twice in this `match`");
                    }
                    k += 1;
                }
            }
        }
        let body: Int = self.check_block_nodes(src, arm.a, return_type);
        i += 1;
    }
    if wildcards == 0 {
        let complained: Int = self.complain_at(src, n.token,
            "this `match` on " + self.show_type(src, value) + " has no `_` arm. A scalar cannot be "
            + "enumerated, so a match without a catch-all would leave values with nowhere to go — "
            + "which is the opposite of an enum match, where `_` is refused because listing every "
            + "variant is the point");
    }
    return 1;
}

// ---- the pass ----------------------------------------------------------------
// A function or method body, with its parameters — and a method's `self` — in scope.
function (mutable self: Unit) check_body(src: String, index: Int) -> Int {
    let item: Node = self.nodes[index];
    let base: Int = len(self.bindings);
    self.depth += 1;
    // The markers are the body's rules: `allocates` means the caller's region is in
    // effect throughout, `pure` means the world is off limits.
    let outer_caller: Int = self.in_caller_region;
    let outer_pure: Int = self.in_pure;
    // From the node's flags for now; corrected below to the STORED signature's flags once
    // this body's owner is known. The stored one is what the probe updates, so reading the
    // node here alone would mean an inferred `allocates` never reached the body it was
    // inferred for — the body would still refuse what the signature now permits.
    self.in_caller_region = flag_allocates(item.value);
    self.in_pure = flag_pure(item.value);
    let signature: Node = self.nodes[item.c];
    // An ASSOCIATED function is stored as a method so the two-span lookup finds it, but it has no
    // receiver clause and therefore no `self` anywhere in its text. Binding one would send
    // `self_token` scanning backwards for a word that was never written, and it would find some
    // earlier method's — a wrong span rather than a refusal, which is the dangerous direction.
    if item.kind == 81 && flag_associated(item.value) == 0 {
        // `self` is a name like any other once it is bound: the receiver's type is
        // written in the clause node, so a method body needs no special rule.
        let receiver: Token = self.tokens[signature.value];
        // Where the word `self` is. Counting back from the receiver's TYPE token stopped
        // working when `function (self) name()` became legal inside an `implement`, because there the
        // type token is the implementation HEADER's and lives far away. The clause always sits
        // immediately before the method's name, in one of three shapes — `(self)`,
        // `(self: T)`, `(mutable self: T)` — so scanning back for it is both shorter and
        // right for all three.
        let self_tok: Int = self.self_token(item.token);
        let word: Token = self.tokens[self_tok];
        let mutable writable: Int = 0;
        if item.value >= 4 { writable = 1; }
        push(self.bindings, Binding { start: word.start, length: word.length,
                              bound_type: Type { kind: 46, scale: 0, contract: 0,
                                       name_start: receiver.start,
                                       name_length: receiver.length },
                              writable: writable, depth: self.depth });
    }
    let params: Node = self.nodes[item.a];
    let mutable p: Int = 0;
    while p < params.b {
        let param: Node = self.nodes[self.children[params.a + p]];
        let name: Token = self.tokens[param.token];
        push(self.bindings, Binding { start: name.start, length: name.length,
                              bound_type: self.declared_type(src, param.a), writable: 0,
                              depth: self.depth });
        p += 1;
    }
    let return_type: Type = self.declared_type(src, signature.c);
    // Which generic this is, so a parameter's bound is looked up in its own declaration.
    //
    // For a METHOD the answer is its RECEIVER's declaration, not its own name: `Map<K: Equatable,
    // V>.probe` is an ordinary name, and the bound that justifies `entry.key == key` inside it was
    // written on the class. Looking only at the method's own name found no bound and refused a
    // program that says exactly what it needs — and stage-0 never noticed, because it checks
    // instantiated COPIES where `K` is already String.
    let outer_generic: Int = self.current_generic;
    let named_here: Token = self.tokens[item.token];
    let mutable enclosing: Int = self.generic_named(src, named_here.start, named_here.length);
    if item.kind == 81 && enclosing < 0 {
        let receiver: Token = self.tokens[signature.value];
        enclosing = self.generic_named(src, receiver.start, receiver.length);
    }
    self.current_generic = enclosing;
    // Which declaration this body IS, settled BEFORE the clauses are checked rather than after.
    //
    // It used to be after, and privacy is what exposed the ordering: `requires amount <=
    // self.balance` reads a private field, and while `current_method` was still the previous
    // body's the clause was being checked as though it stood outside the class. A contract is part
    // of the method, so it has to be checked knowing which method it belongs to — the false
    // positive was the honest signal that it was not.
    let outer_fn: Int = self.current_function;
    let outer_method: Int = self.current_method;
    self.current_function = -1;
    self.current_method = -1;
    if item.kind == 80 {
        self.current_function = self.find_function(src, self.tokens[item.token].start,
                                       self.tokens[item.token].length);
    }
    if item.kind == 81 {
        let receiver_token: Token = self.tokens[signature.value];
        self.current_method = self.find_method_named(src, receiver_token.start,
                                  receiver_token.length, self.tokens[item.token].start,
                                  self.tokens[item.token].length);
    }
    // Now that the owner is known, take `allocates` from the signature the probe updates
    // rather than from the node it was parsed with. See the note above.
    if self.current_function >= 0 {
        self.in_caller_region = flag_allocates(self.functions[self.current_function].flags);
    }
    if self.current_method >= 0 {
        self.in_caller_region = flag_allocates(self.methods[self.current_method].flags);
    }
    // What this body may reach, and whose signature said so. Read from the STORED signature for the
    // same reason `allocates` is — the node's flags are what was parsed, and the stored one is what
    // the rest of the checker agrees on.
    let outer_effects: Int = self.allowed_effects;
    let outer_owner: String = self.effects_owner;
    self.allowed_effects = flag_effects(item.value);
    self.effects_owner = substring(src, self.tokens[item.token].start,
                             self.tokens[item.token].length);
    let clauses: Int = self.check_clauses(src, index, signature, return_type);
    let outer_function: Int = self.in_function;
    let outer_loop: Int = self.loop_depth;
    self.in_function = 1;
    self.loop_depth = 0;
    let body: Int = self.check_block_nodes(src, item.b, return_type);
    if !self.block_exits(item.b) {
        // Every Burxt function returns a value, so falling off the end is not a
        // silent zero — it is a missing answer, and the compiler says which function.
        let complained: Int = self.complain_at(src, item.token,
            "this function can reach its closing brace without returning, and every "
            + "Burxt function answers with a value");
    }
    self.in_function = outer_function;
    self.loop_depth = outer_loop;
    self.current_function = outer_fn;
    self.current_method = outer_method;
    self.allowed_effects = outer_effects;
    self.effects_owner = outer_owner;
    let dropped: Int = truncate(self.bindings, base);
    self.depth -= 1;
    self.in_caller_region = outer_caller;
    self.in_pure = outer_pure;
    self.current_generic = outer_generic;
    return 1;
}

// `requires`, `ensures`, `decreases`. All three are checked under the `pure` rule,
// for the reason A5 gives: a contract that can change the program is not a check, it
// is a second program that only runs when someone is looking.
function (mutable self: Unit) check_clauses(src: String, index: Int, signature: Node,
                                  return_type: Type) -> Int {
    let item: Node = self.nodes[index];
    let outer_pure: Int = self.in_pure;
    self.in_pure = 1;
    self.in_contract = 1;
    // The return type's node, for kind 21 — the operand a return bracket's elided subject becomes.
    // Saved and restored, because clauses of one function must not answer with another's return type.
    let outer_result_node: Int = self.result_type_node;
    self.result_type_node = signature.c;
    let mutable measures: Int = 0;
    let mutable i: Int = 0;
    while i < signature.b {
        let clause: Node = self.nodes[self.children[signature.a + i]];
        let base: Int = len(self.bindings);
        if clause.value == 127 {                     // ensures
            // `result` is bound here and nowhere else. It is not a keyword: a
            // parameter may still be called `result`, and then it collides, which is
            // an error about the collision rather than a silent shadowing.
            if return_type.kind == 46 || return_type.kind == 47 || return_type.kind == 48 {
                let complained: Int = self.complain_at(src, clause.token,
                    "`ensures` cannot see the result of a function returning "
                    + self.show_type(src, return_type) + ": it travels through the caller's storage, "
                    + "and binding `result` to it needs care a scalar does not");
            }
            self.in_ensures = 1;
            let spelling: Int = find_text(src, "result");
            if spelling >= 0 {
                push(self.bindings, Binding { start: spelling, length: 6,
                                      bound_type: return_type, writable: 0, depth: self.depth });
            }
        }
        let got: Type = self.type_of(src, clause.a, simple_type(41));
        if clause.value == 128 {                     // decreases
            measures += 1;
            if !is_unknown(got) && got.kind != 40 {
                let complained: Int = self.complain_at(src, clause.token,
                    "a `decreases` measure counts, so it must be an Int: a Decimal "
                    + "measure invites a descent that shrinks forever without arriving");
            }
            if item.kind == 81 {
                let complained: Int = self.complain_at(src, clause.token,
                    "`decreases` is not available on a method yet, and a clause that "
                    + "is not checked would be worse than none");
            }
            if !self.body_calls(src, item.b, self.tokens[item.token]) {
                let complained: Int = self.complain_at(src, clause.token,
                    "`decreases` claims a recursion ends, and this function never "
                    + "calls itself, so there is nothing to check");
            }
        } else {
            if !is_unknown(got) && got.kind != 41 {
                let complained: Int = self.complain_at(src, clause.token,
                    "a contract is a claim, so it must be a Bool, but this is "
                    + self.show_type(src, got));
            }
        }
        self.in_ensures = 0;
        let dropped: Int = truncate(self.bindings, base);
        i += 1;
    }
    if measures > 1 {
        let complained: Int = self.complain_at(src, item.token,
            "one `decreases` per function: two measures would need a rule for which "
            + "one descends, and one integer covers the cases that exist");
    }
    self.in_contract = 0;
    self.in_pure = outer_pure;
    self.result_type_node = outer_result_node;
    return 1;
}

// Where these bytes first appear in the source. A symbol is a span, so binding a name
// the program did not write — `result` inside an `ensures` — needs a span whose bytes
// spell it. Any occurrence will do, since only the bytes are compared. If the word
// appears nowhere, nothing can refer to it, and there is nothing to bind.
function find_text(src: String, needle: String) -> Int {
    let n: Int = len(needle);
    // `len` on a String is strlen, so both bounds are hoisted. Leaving `len(src)` in the
    // condition walked the whole source on every iteration — O(source²) for one call, on a
    // two-hundred-kilobyte source. The first of four of this shape; the one that mattered
    // was not in Burxt at all, and spec/M9-PERFORMANCE.md tells that story.
    let stop: Int = len(src) - n;
    let mutable i: Int = 0;
    while i <= stop {
        let mutable k: Int = 0;
        let mutable same: Bool = true;
        while k < n {
            if byte_at(src, i + k) != byte_at(needle, k) {
                same = false;
                k = n;
            } else {
                k += 1;
            }
        }
        if same {
            return i;
        }
        i += 1;
    }
    return -1;
}

// `return tail f(...)` is a guarantee, not a hope: the frame is REPLACED. Everything
// below is a condition for that being possible at all, which is why each one is a
// compile error rather than a quiet fallback to an ordinary call.
function (mutable self: Unit) check_tail(src: String, n: Node, return_type: Type) -> Int {
    let value: Node = self.nodes[n.a];
    if value.kind != 13 {
        let complained: Int = self.complain_at(src, n.token,
            "`tail` names the call whose frame replaces this one, and this is not a call");
        return 0;
    }
    if self.region_depth > 0 {
        let complained: Int = self.complain_at(src, n.token,
            "a `tail` call inside a `region` would jump past the region's close, and "
            + "the bytes would never be released");
    }
    if return_type.kind == 46 || return_type.kind == 47 || return_type.kind == 48 {
        let complained: Int = self.complain_at(src, n.token,
            "a `tail` call cannot return " + self.show_type(src, return_type) + ": an aggregate travels "
            + "through the caller's storage, and the frame that owns it is the one being "
            + "replaced");
    }
    let called: Token = self.tokens[value.token];
    let target: Int = self.find_function(src, called.start, called.length);
    if target < 0 {
        let complained: Int = self.complain_at(src, n.token,
            "`tail` calls a Burxt function, and this is not one");
        return 0;
    }
    let callee: DeclaredFunction = self.functions[target];
    if flag_external(callee.flags) == 1 {
        let complained: Int = self.complain_at(src, n.token,
            "`tail` into C is not a tail call: the C side has its own calling "
            + "convention, and nothing here can guarantee the frame is replaced");
        return 0;
    }
    if self.current_function < 0 {
        return 0;
    }
    let here: DeclaredFunction = self.functions[self.current_function];
    if !self.same_type(src, callee.return_type, here.return_type) {
        let complained: Int = self.complain_at(src, n.token,
            "a `tail` call must answer what this function answers: " + self.show_type(src, here.return_type)
            + ", not " + self.show_type(src, callee.return_type));
    }
    let mine: Node = self.nodes[here.parameters];
    let theirs: Node = self.nodes[callee.parameters];
    if mine.b != theirs.b {
        let complained: Int = self.complain_at(src, n.token,
            "a `tail` call replaces this frame, so the signatures must match: this "
            + "function takes " + to_string(mine.b) + " parameter(s), and that one takes "
            + to_string(theirs.b));
        return 0;
    }
    let mutable i: Int = 0;
    while i < mine.b {
        let want: Type = self.declared_type(src, self.nodes[self.children[mine.a + i]].a);
        let got: Type = self.declared_type(src, self.nodes[self.children[theirs.a + i]].a);
        if !self.same_type(src, got, want) {
            let complained: Int = self.complain_at(src, n.token,
                "parameter " + to_string(i + 1) + " is " + self.show_type(src, want) + " here and "
                + self.show_type(src, got) + " there, and a replaced frame has one shape");
        }
        i += 1;
    }
    return 1;
}

// Whether a body calls this name — the token scan is exact, because Burxt has no
// first-class functions, so a name followed by `(` inside the body is a call to the
// one function that has it. The range is the body's braces, counted.
function (self: Unit) body_calls(src: String, body: Int, name: Token) -> Bool {
    if body < 0 {
        return false;
    }
    let mutable i: Int = self.nodes[body].token;
    let mutable depth: Int = 0;
    let mutable opened: Bool = false;
    while i < len(self.tokens) {
        let t: Token = self.tokens[i];
        if t.kind == 31 {
            depth += 1;
            opened = true;
        }
        if t.kind == 32 {
            depth -= 1;
            if opened && depth == 0 {
                return false;
            }
        }
        if t.kind == 1 && spans_equal(src, t.start, t.length, name.start, name.length) {
            if i + 1 < len(self.tokens) {
                if self.tokens[i + 1].kind == 29 {     // '('
                    return true;
                }
            }
        }
        i += 1;
    }
    return false;
}

// An `implement` answers an interface exactly: every signature, no extras, same shapes. An interface
// is a promise a `dynamic` value makes on the implementor's behalf, so a mismatch here is a
// promise nobody keeps.
function (mutable self: Unit) check_impl(src: String, index: Int) -> Int {
    let item: Node = self.nodes[index];
    let trait_name: Token = self.tokens[item.token];
    let found: Int = self.find_type(src, trait_name.start, trait_name.length);
    if found < 0 {
        let complained: Int = self.complain_at(src, item.token, "no trait of this name is declared");
        return 0;
    }
    let decl: TypeDeclaration = self.types[found];
    if decl.kind != 84 {
        let complained: Int = self.complain_at(src, item.token,
            "`implement` implements an interface, and this name belongs to a type");
        return 0;
    }
    let declared: Node = self.nodes[decl.node];
    // `class X implements Y` sets `value` to 1 and carries no children: the class's OWN methods
    // satisfy the interface, so conformance is checked against the method table. A class may also
    // have methods the interface never mentions, which is normal — so the "no extras" rule that
    // applies to a standalone `implement` block does not apply here.
    if item.value == 1 {
        let holder: Token = self.tokens[item.c];
        let mutable s: Int = 0;
        while s < declared.b {
            let sig: Node = self.nodes[self.children[declared.a + s]];
            let sig_name: Token = self.tokens[sig.token];
            let found_method: Int = self.find_method_named(src, holder.start, holder.length,
                                        sig_name.start, sig_name.length);
            if found_method < 0 {
                let complained: Int = self.complain_at(src, item.token,
                    "this class does not have `" + substring(src, sig_name.start, sig_name.length)
                    + "`, which the interface it implements requires");
            }
            s += 1;
        }
        return 0;
    }
    let mutable i: Int = 0;
    while i < declared.b {
        let sig: Node = self.nodes[self.children[declared.a + i]];
        let sig_name: Token = self.tokens[sig.token];
        let mutable matched: Int = -1;
        let mutable k: Int = 0;
        while k < item.b {
            let candidate: Int = self.children[item.a + k];
            let named: Token = self.tokens[self.nodes[candidate].token];
            if spans_equal(src, named.start, named.length, sig_name.start, sig_name.length) {
                matched = candidate;
            }
            k += 1;
        }
        if matched < 0 {
            let complained: Int = self.complain_at(src, item.token,
                "this implement leaves out `" + substring(src, sig_name.start, sig_name.length)
                + "`, which the interface requires");
        } else {
            let method: Node = self.nodes[matched];
            let mutable mutating: Int = 0;
            if method.value >= 4 { mutating = 1; }
            if mutating != sig.value {
                let complained: Int = self.complain_at(src, method.token,
                    "the interface writes this receiver differently: `self` and `mutable self` "
                    + "are different promises");
            }
            let params: Node = self.nodes[method.a];
            if params.b != sig.c {
                let complained: Int = self.complain_at(src, method.token,
                    "the interface's signature takes " + to_string(sig.c)
                    + " parameter(s), and this takes " + to_string(params.b));
            } else {
                let mutable p: Int = 0;
                while p < sig.c {
                    let want: Type = self.declared_type(src, self.nodes[self.nested_children[sig.b + p]].a);
                    let got: Type = self.declared_type(src, self.nodes[self.children[params.a + p]].a);
                    if !self.same_type(src, got, want) {
                        let complained: Int = self.complain_at(src, method.token,
                            "parameter " + to_string(p + 1) + " is " + self.show_type(src, want)
                            + " in the interface, and " + self.show_type(src, got) + " here");
                    }
                    p += 1;
                }
            }
            let want_ret: Type = self.declared_type(src, sig.a);
            let got_ret: Type = self.declared_type(src, self.nodes[method.c].c);
            if !self.same_type(src, got_ret, want_ret) {
                let complained: Int = self.complain_at(src, method.token,
                    "the interface returns " + self.show_type(src, want_ret) + ", and this returns "
                    + self.show_type(src, got_ret));
            }
        }
        i += 1;
    }
    let mutable k: Int = 0;
    while k < item.b {
        let method: Node = self.nodes[self.children[item.a + k]];
        let named: Token = self.tokens[method.token];
        let mutable known: Bool = false;
        let mutable i2: Int = 0;
        while i2 < declared.b {
            let sig: Node = self.nodes[self.children[declared.a + i2]];
            let sig_name: Token = self.tokens[sig.token];
            if spans_equal(src, named.start, named.length, sig_name.start, sig_name.length) {
                known = true;
            }
            i2 += 1;
        }
        if !known {
            let complained: Int = self.complain_at(src, method.token,
                "the interface has no method of this name, and an implementation is an answer to a "
                + "trait rather than a place to add to a type");
        }
        k += 1;
    }
    return 1;
}

// The shapes a type may not have. Both refusals are about storage: a nested array would
// need a layout rule for arrays of arrays that M1 does not have, and a zero-length array
// describes nothing. A growable array inside a class is fine — stage-1's own Unit is
// made of them — and what it costs is that the class must be built in a region.
function (mutable self: Unit) check_type_shape(src: String, node: Int, at: Int) -> Int {
    if node < 0 {
        return 0;
    }
    let n: Node = self.nodes[node];
    if n.kind != 47 && n.kind != 48 {
        return 0;
    }
    if n.kind == 48 && n.b <= 0 {
        let complained: Int = self.complain_at(src, at,
            "an array of no elements describes nothing, and nothing can be read from it");
    }
    let element: Node = self.nodes[n.a];
    if element.kind == 47 || element.kind == 48 {
        let complained: Int = self.complain_at(src, at,
            "arrays do not nest yet: an array of arrays needs a layout rule the memory "
            + "model does not have");
        return 0;
    }
    return self.check_type_shape(src, n.a, at);
}

// Does this program use generics? Stage-1 READS them — the parser handles type parameters,
// applications, bounds and generic receivers — and its checker does not yet monomorphise
// them. Refused here, once, with the reason: a checker that half-understood a generic would
// answer differently from stage-0, and the differential test exists to stop exactly that.
//
// A clean refusal, not a crash. Before this guard the checker walked a type-parameter node,
// looked its name up as a class, got -1, and indexed an array with it. Saying "not yet" is
// the honest answer and the cheap one. See spec/M7-GENERICS.md §5 for the design that
// replaces it.
// The one thing left that needs a COPY rather than a resolution: a function whose body is sized
// by a type parameter. `identity<T>` compiles to different code for `T = Int` (one cell) and
// `T = Point` (two), so there must be one machine function per instantiation — mangling, a work
// list, and a call site that names the copy. Classes and enums need none of that, because their
// layout is a count read under the arguments in scope.
//
// Answers the declaration node so the message can point at it, or -1 when there is none.

function (self: Unit) generic_function(src: String) -> Int {
    let mutable at: Int = 0;
    while at < len(self.nodes) {
        let n: Node = self.nodes[at];
        if n.kind == 80 || n.kind == 81 {
            let name: Token = self.tokens[n.token];
            if self.generic_named(src, name.start, name.length) >= 0 {
                return at;
            }
        }
        at += 1;
    }
    return 0 - 1;
}

// Every generic APPLICATION written in the program, checked against the declaration it names:
// the name must be generic, and the argument count must match. Done in one sweep because an
// application can appear in any type position, and a rule spread over every position is a rule
// with a hole in it.
// A named type whose declaration takes type parameters, written with none of them — which is
// only ever a question the program has not answered.
function (self: Unit) unsettled_generic(src: String, t: Type) -> Bool {
    if t.kind != 46 && t.kind != 49 {
        return false;
    }
    if t.contract > 0 {                               // arguments were given
        return false;
    }
    let named: Int = self.generic_named(src, t.name_start, t.name_length);
    if named < 0 {
        return false;
    }
    let declaration: Generic = self.generics[named];
    return declaration.type_param_count > 0;
}

// Does `carried` embed the type named by `(target_start, target_length)` — its own bytes, directly or
// through anything it contains?
//
// **By value is the whole of the question.** A width is unbounded only when a type contains ITSELF: a
// variant carrying `[Json]` carries a pointer, a length and a capacity no matter how wide a `Json` is,
// so recursion through a slice always terminates. An ARRAY does embed its element, so it recurses.
//
// This replaces the rule both compilers used to state — "a variant may not carry an enum" — which was
// a proxy for this one and wrong whenever the recursion went through a pointer. Stage-0 did not obey
// its own proxy either: the same shape reached through `Option<Json>` was allowed and worked.
//
// `self.walked_types` is the cycle guard, holding the DECLARATION INDEX of each type already entered —
// which is what makes the walk terminate on the very shapes it exists to refuse. Without it,
// `enum A { Go(B) }` / `enum B { Back(A) }` recurses forever while deciding that it recurses forever.
//
// A field rather than a parameter because Burxt has no writable parameters — the same constraint that
// made `lib/map.bx` method-based — and truncated on the way out, exactly as `type_bindings` is.
function (mutable self: Unit) embeds_by_value(src: String, carried: Type, target_start: Int,
                                    target_length: Int) -> Bool {
    // A pointer, whatever it points at. This is the case the old rule got wrong.
    if carried.kind == 47 || carried.kind == 49 {
        return false;
    }
    if carried.kind == 48 {                          // an array DOES embed its element
        let element: Type = self.declared_type(src, carried.scale);
        return self.embeds_by_value(src, element, target_start, target_length);
    }
    if carried.kind != 46 {
        return false;
    }
    if spans_equal(src, carried.name_start, carried.name_length, target_start, target_length) {
        return true;
    }
    let found: Int = self.find_type(src, carried.name_start, carried.name_length);
    if found < 0 {
        return false;
    }
    let mutable w: Int = 0;
    while w < len(self.walked_types) {
        if self.walked_types[w] == found {
            return false;                            // already entered; not a fresh path
        }
        w += 1;
    }
    let depth: Int = len(self.walked_types);
    let added: Int = push(self.walked_types, found);
    let decl: TypeDeclaration = self.types[found];
    let item: Node = self.nodes[decl.node];
    let mutable answer: Bool = false;
    if decl.kind == 82 {                             // a class: every field
        let mutable f: Int = 0;
        while f < item.b {
            let field: Node = self.nodes[self.children[item.a + f]];
            let held: Type = self.declared_type(src, field.a);
            if self.embeds_by_value(src, held, target_start, target_length) {
                answer = true;
            }
            f += 1;
        }
    }
    if decl.kind == 83 {                             // an enum: every variant's every payload
        let mutable v: Int = 0;
        while v < item.b {
            let variant: Node = self.nodes[self.children[item.a + v]];
            let mutable p: Int = 0;
            while p < variant.c {
                let held: Type = self.declared_type(src, self.nested_children[variant.b + p]);
                if self.embeds_by_value(src, held, target_start, target_length) {
                    answer = true;
                }
                p += 1;
            }
            v += 1;
        }
    }
    let dropped: Int = truncate(self.walked_types, depth);
    return answer;
}

// A variant payload must be a scalar, and for a generic enum that is a rule about the
// INSTANTIATION rather than the declaration: `Option<T>`'s payload is a parameter, which is
// neither scalar nor aggregate until an argument says. So the rule is checked where the
// argument is written, once per application, with the arguments in scope.
//
// The rule itself is a cut, not a principle — an aggregate payload reopens the question of how
// wide a variant is when the widest one holds a class. Stage-0 draws the same line, and the
// two must draw it in the same place or a program compiles with one compiler and not the other.
function (mutable self: Unit) check_payloads(src: String, application: Int) -> Int {
    let applied: Type = self.declared_type(src, application);
    let found: Int = self.find_type(src, applied.name_start, applied.name_length);
    if found < 0 {
        return 0;
    }
    let decl: TypeDeclaration = self.types[found];
    if decl.kind != 83 {                              // classes may hold anything
        return 0;
    }
    let item: Node = self.nodes[decl.node];
    let base: Int = self.bind_from_application(src, applied);
    let mutable v: Int = 0;
    while v < item.b {
        let variant: Node = self.nodes[self.children[item.a + v]];
        let mutable p: Int = 0;
        while p < variant.c {
            let written: Type = self.declared_type(src, self.nested_children[variant.b + p]);
            let carried: Type = self.resolve_shallow(src, written);
            // A class or an array payload is allowed since v0.0.118: `cells_of` already sums a
            // variant's payload cells, so the layout question this rule deferred was already
            // answered here — stage-1 was refusing something its own emitter could do.
            //
            // An enum payload is allowed when its width is FINITE, which is the rule this used to
            // approximate by refusing every enum payload. What makes a width unbounded is a type
            // containing ITSELF by value; recursion through a slice is a pointer and terminates.
            // `dynamic Trait` is still refused — its two cells hold a pointer into storage a
            // variant's payload area does not own, which is an ownership question rather than a
            // width one.
            let mutable refused: Bool = carried.kind == 49;
            if carried.kind == 46 {
                if self.embeds_by_value(src, carried, applied.name_start, applied.name_length) {
                    refused = true;
                }
            }
            if refused {
                let variant_name: Token = self.tokens[variant.token];
                let complained: Int = self.complain_at(src, self.nodes[application].token,
                    "`" + self.show_type(src, applied) + "` cannot be made: `"
                    + substring(src, applied.name_start, applied.name_length) + "."
                    + substring(src, variant_name.start, variant_name.length)
                    + "` would carry " + self.show_type(src, carried)
                    + ", which has no layout here. A variant carries a scalar, a String, a "
                    + "class or an array");
            }
            p += 1;
        }
        v += 1;
    }
    let dropped: Int = truncate(self.type_bindings, base);
    return 1;
}

function (mutable self: Unit) check_applications(src: String) -> Int {
    let mutable at: Int = 0;
    while at < len(self.nodes) {
        let n: Node = self.nodes[at];
        if n.kind == 46 && n.b > 0 {
            let named: Token = self.tokens[n.token];
            let generic: Int = self.generic_named(src, named.start, named.length);
            if generic < 0 {
                let complained: Int = self.complain_at(src, n.token,
                    "`" + substring(src, named.start, named.length)
                    + "` is not generic, so it takes no type arguments");
            } else {
                let declaration: Generic = self.generics[generic];
                if declaration.type_param_count != n.b {
                    let complained: Int = self.complain_at(src, n.token,
                        "`" + substring(src, named.start, named.length) + "` takes "
                        + to_string(declaration.type_param_count) + " type argument(s), and "
                        + to_string(n.b) + " were given");
                } else {
                    let checked: Int = self.check_payloads(src, at);
                }
            }
        }
        at += 1;
    }
    return 1;
}

// Work out which functions and methods allocate, so `allocates` need not be written.
//
// A least fixpoint, and it iterates rather than asking once because the answer travels along
// the call graph: `a` allocates because it calls `b`, which allocates because it calls `c`.
// One round per link, plus one to confirm nothing new — a 4-deep forwarding chain takes 5,
// and the compiler's own 8,300 lines take 2, because nearly everything that allocates does
// so directly.
//
// Rounds are safe to repeat, which is not luck but two properties worth naming:
//   * the `typed` cache is a slot per NODE and the last answer for a node stands, so a
//     second reading overwrites rather than appends;
//   * `complain_at` is silent while probing, so nothing a round found is reported.
// Bindings are already truncated per body by `check_body`.
//
// Terminates because the flags only ever go from 0 to 1, over a finite number of signatures.
// The ceiling is a backstop for that argument being wrong, not an expectation.
function (mutable self: Unit) infer_allocates(src: String) -> Int {
    self.probing = 1;
    let ceiling: Int = len(self.functions) + len(self.methods) + 1;
    // Where the binding stack stood before any round ran.
    //
    // `check_body` truncates back to its own base, so a FUNCTION body leaves nothing behind
    // — but a top-level statement declares into the same stack and nothing pops it, because
    // in a single pass nothing ever needed to. Two passes, and the real one met every
    // top-level name already declared: `this name is already declared — Burxt does not
    // shadow`, on 68 of 109 programs. The rounds have to leave the stack where they found it.
    let base: Int = len(self.bindings);
    let mutable round: Int = 0;
    while round < ceiling {
        self.probe_changes = 0;
        let swept: Int = self.check_bodies(src);
        let dropped: Int = truncate(self.bindings, base);
        if self.probe_changes == 0 {
            break;
        }
        round += 1;
    }
    self.probing = 0;
    return round;
}

function (mutable self: Unit) check(src: String) -> Int {
    let collected: Int = self.collect_declarations(src);
    let applications: Int = self.check_applications(src);
    // Before anything is refused: a body may call a function declared 200 lines below it, so
    // the answer has to exist before the first body is read. That ordering is the only reason
    // `allocates` was ever required — the compiler always computed it.
    let inferred: Int = self.infer_allocates(src);
    let checked: Int = self.check_bodies(src);
    return self.problems;
}

function (mutable self: Unit) check_bodies(src: String) -> Int {
    let mutable i: Int = 0;
    while i < len(self.items) {
        let index: Int = self.items[i];
        let item: Node = self.nodes[index];
        if item.kind == 80 || item.kind == 81 {
            let checked: Int = self.check_body(src, index);
        }
        if item.kind == 85 {                         // an implementation block's methods
            let answered: Int = self.check_impl(src, index);
            let mutable k: Int = 0;
            while k < item.b {
                let checked: Int = self.check_body(src, self.children[item.a + k]);
                k += 1;
            }
        }
        if item.kind >= 60 && item.kind <= 72 {      // a top-level statement
            let checked: Int = self.check_stmt_node(src, index, unknown_type());
        }
        i += 1;
    }
    return self.problems;
}

// ---- reporting -------------------------------------------------------------
function kind_name(kind: Int) -> String {
    if kind == 1 { return "ident"; }
    if kind == 2 { return "int"; }
    if kind == 3 { return "decimal"; }
    if kind == 4 { return "string"; }
    if kind >= 140 { return "type"; }
    if kind >= 100 { return "keyword"; }
    return "punct";
}

function (self: Unit) report(src: String, limit: Int) -> Int {
    let mutable i: Int = 0;
    while i < len(self.tokens) && i < limit {
        let t: Token = self.tokens[i];
        let text: String = substring(src, t.start, t.length);
        if t.kind == 3 {
            print("  decimal " + text + " -> unscaled " + to_string(t.value)
                  + " scale " + to_string(t.scale));
        } else {
            print("  " + kind_name(t.kind) + " `" + text + "`");
        }
        i += 1;
    }
    return i;
}

function (self: Unit) count_of(kind: Int) -> Int {
    let mutable found = 0;
    for t in self.tokens {
        if t.kind == kind {
            found += 1;
        }
    }
    return found;
}
