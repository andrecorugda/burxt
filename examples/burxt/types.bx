// ============================================================================
// types.bx — part of the Burxt compiler, written in Burxt.
//
// The shapes everything else is written in: a token, an arena node, a type, a symbol,
// and the Unit that holds a whole compile. Also the lexer, because a token is what the
// rest of the compiler reads and the two are one idea.
//
// Assembled by examples/stage1.bx, which is the program; everything here is
// declarations, which is what a module may hold.
// ============================================================================

// ============================================================================
// STAGE-1: the Burxt compiler, written in Burxt.
//
// One file, because Burxt has no module system yet — which is the shape
// spec/M4-SELF-HOSTING.md predicted stage-1 would take. It grows a phase at a time:
//
//   phase 2 (v0.0.52)  the lexer: the real token set, exact money literals
//   phase 3 (v0.0.53)  the parser: types, expressions, statements, in an arena
//
// Nothing here uses a map, because Burxt has none: the keyword table and the symbol
// table are arrays searched linearly, which is what a compiler's lookups cost anyway.
// ============================================================================

// ---- token kinds -----------------------------------------------------------
// Codes rather than an enum: a 60-variant enum would force a 60-arm `match` at
// every use, and the payloads differ per kind. The names live in `kind_name`.
//   1 identifier      2 Int literal      3 Decimal literal     4 String literal
//   10..49 punctuation                   100.. keywords
struct Tok {
    kind: Int,
    start: Int,
    length: Int,
    // Int literals: the value. Decimals: the unscaled integer, with `scale` places.
    value: Int,
    scale: Int,
    // A string literal containing `{` opens an interpolation; splitting the pieces
    // is the parser's job, so the lexer only records that there is one.
    interpolated: Bool,
}

struct Kw { word: String, code: Int }
// ---- the AST -----------------------------------------------------------------
// Children by INDEX, not by pointer: v0.0.22 proved an arena needs no recursive
// types, and an index is a number a struct field can hold.
//
// Expression kinds:
//   1 Int literal        2 Decimal literal      3 String literal    4 Bool literal
//   5 name               6 unary minus          7 not
//   8 binary (a op b, op in `value`)             9 comparison
//  10 logical            11 field access        12 index
//  13 call               14 method call
// Type kinds:
//  40 Int  41 Bool  42 String  43 CInt  44 CDouble
//  45 Decimal (scale in `a`, contract in `b`)   46 named   47 slice   48 array
//  49 dyn
// Statement kinds:
//  60 let (name tok in `tok`, type in `a`, value in `b`, mutable in `value`)
//  61 assign            62 print               63 return            64 tail return
//  65 if                66 while               67 break             68 continue
//  69 region            70 expression statement
struct Node {
    kind: Int,
    // Child indices, or payload. Meaning depends on `kind`, documented above.
    a: Int,
    b: Int,
    c: Int,
    // The operator byte, a flag, or a literal's value — whatever the kind needs.
    value: Int,
    // The token this node started at, so a message can point at the source.
    tok: Int,
}

// One compilation unit: its tokens, its keyword table, and its AST.
//
// `kids` is where child LISTS live — the arguments of a call, the statements of a
// block. A node stores a start offset and a count into it, rather than a linked list
// through the nodes themselves.
//
// That is not a workaround for the two gaps found writing this file (Burxt has no
// `xs[i].field = v`, and no writing to a growable array element through a field): it
// is the better design regardless. Children pushed into a side array land
// CONTIGUOUSLY even though their subtrees interleave in `nodes`, so nothing needs
// back-patching, and a list is two integers instead of a chain of cells.
// A declared type: `Int`, `Decimal<2, RoundHalfEven>`, `[Int]`, a struct name.
// A struct rather than an enum, because it is compared and copied constantly and a
// payload enum would need a match at every use.
struct Ty {
    // The node kinds the parser produces: 40 Int, 41 Bool, 42 String, 43 CInt,
    // 44 CDouble, 45 Decimal, 46 named, 47 slice, 48 array, 49 dyn. 0 is unknown,
    // which never equals anything — including another unknown.
    kind: Int,
    scale: Int,
    contract: Int,
    // For a named type, the span of its name in the source.
    name_start: Int,
    name_len: Int,
}

// A binding in scope: its name as a SPAN, so the checker allocates nothing to
// remember a variable.
struct Sym { start: Int, length: Int, ty: Ty, mutable: Int, depth: Int }
// A declared function: its name span, its return type, and its parameter list node.
struct Fun { start: Int, length: Int, ret: Ty, params: Int, flags: Int }
// A declared struct or enum: its name span and the item node that declared it.
struct TypeDecl { start: Int, length: Int, kind: Int, node: Int }
// A declared method, keyed by the receiver's name and its own.
struct Method {
    receiver_start: Int, receiver_len: Int,
    start: Int, length: Int,
    ret: Ty, params: Int, mutating: Int, flags: Int,
}

struct Unit {
    toks: [Tok],
    words: [Kw],
    nodes: [Node],
    kids: [Int],
    // A SECOND child array, for lists nested inside another list: a match arm's
    // bindings, an enum variant's payload types, a trait signature's parameters.
    //
    // Not tidiness — correctness. Pushing bindings and arms into one array
    // interleaves them, and the design's whole premise is that a list is contiguous.
    // The first version did exactly that and indexed past the end; the cross-check
    // test caught it on tests/pass/enum_match_flow.bx.
    subs: [Int],
    // Top-level items, in source order, for the checker to walk.
    items: [Int],
    syms: [Sym],
    funs: [Fun],
    stack: [Int],
    methods: [Method],
    types: [TypeDecl],
    // Block depth, so a binding leaves scope at the closing brace.
    depth: Int,
    problems: Int,
    // Where the parser is in the token array.
    pos: Int,
    // Nonzero while parsing an `if`/`while` condition, where a `{` opens the BODY
    // rather than a struct literal. The Rust parser carries the same flag.
    impls: [Impl],
    // Every expression's type, indexed by node. See check.bx's type_at for why it is
    // indexed rather than searched.
    typed: [Ty],
    // How many regions are open, and whether the function being checked declared
    // `allocates` — which means the caller's region is the region in effect. Together
    // these answer M1's one question: is there somewhere to allocate?
    region_depth: Int,
    in_caller_region: Int,
    in_pure: Int,
    loop_depth: Int,
    in_contract: Int,
    in_ensures: Int,
    // Which function is being checked, so a `tail` call can be compared with the
    // signature it must replace. -1 at top level and inside a method.
    current_fn: Int,
    // The backend's state: the IR text, the constants it referred to, a counter for
    // registers and one for labels, the locals' allocas, and the enclosing loops'
    // labels so `break` and `continue` know where to jump.
    chunks: [String],
    pending: String,
    globals: String,
    // The caller's storage for an aggregate return, while a function that has one is
    // being emitted, and how many cells it holds.
    sret: String,
    sret_cells: Int,
    fn_entry: String,
    body_chunks: [String],
    body_pending: String,
    next_tmp: Int,
    next_slot: Int,
    next_label: Int,
    slots: [Slot],
    strings: [Int],
    // Extern symbols already declared in the emitted module, so a symbol two modules
    // both wrap is declared once.
    declared: [String],
    loop_conds: [String],
    loop_ends: [String],
    in_function: Int,
    // Where the program's tokens end, which is not where the token ARRAY ends: an
    // interpolation fragment appends its own, and the parser must not walk into them.
    token_end: Int,
    no_struct: Int,
    // Set while typing the operands of `*`. Multiplication combines a quantity with a
    // rate, so its operand scales differ by nature: a literal that cannot narrow to
    // the result's scale keeps its own instead of being refused. Stage-0 reaches the
    // same answer by re-checking both operands with no expected type.
    in_mul: Int,
    errors: Int,
}

fn is_alpha(b: Int) -> Bool {
    return (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || b == 95;
}

fn is_digit(b: Int) -> Bool {
    return b >= 48 && b <= 57;
}

fn is_name_byte(b: Int) -> Bool {
    return is_alpha(b) || is_digit(b);
}

fn is_space(b: Int) -> Bool {
    return b == 32 || b == 9 || b == 10 || b == 13;
}

fn at_byte(src: String, i: Int) -> Int {
    if i < 0 || i >= len(src) {
        return -1;
    }
    return byte_at(src, i);
}

// Compare two spans of the source directly. The obvious way to write this is
// `span_eq(src, a, alen, substring(src, b, blen))` — and the compiler refused it,
// because `substring` allocates and a comparison has no business needing a region.
// Comparing in place is both cheaper and what the checker wanted anyway.
fn spans_eq(src: String, a: Int, a_len: Int, b: Int, b_len: Int) -> Bool {
    if a_len != b_len {
        return false;
    }
    let mut i: Int = 0;
    while i < a_len {
        if byte_at(src, a + i) != byte_at(src, b + i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// Compare a span of the source against a whole word, without allocating.
fn span_eq(src: String, start: Int, length: Int, word: String) -> Bool {
    if length != len(word) {
        return false;
    }
    let mut i: Int = 0;
    while i < length {
        if byte_at(src, start + i) != byte_at(word, i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// ---- the keyword table -----------------------------------------------------
// Codes from 100. Order does not matter; the lookup is a scan.
fn (mut self: Unit) add_word(word: String, code: Int) -> Int {
    push(self.words, Kw { word: word, code: code });
    return len(self.words);
}

fn (mut self: Unit) install_keywords() -> Int {
    let mut n: Int = 0;
    n = self.add_word("let", 100);
    n = self.add_word("mut", 101);
    n = self.add_word("fn", 102);
    n = self.add_word("return", 103);
    n = self.add_word("if", 104);
    n = self.add_word("else", 105);
    n = self.add_word("while", 106);
    n = self.add_word("break", 107);
    n = self.add_word("continue", 108);
    n = self.add_word("struct", 109);
    n = self.add_word("enum", 110);
    n = self.add_word("match", 111);
    n = self.add_word("trait", 112);
    n = self.add_word("impl", 113);
    n = self.add_word("for", 114);
    n = self.add_word("dyn", 115);
    n = self.add_word("extern", 116);
    n = self.add_word("region", 117);
    n = self.add_word("print", 118);
    n = self.add_word("self", 119);
    n = self.add_word("true", 120);
    n = self.add_word("false", 121);
    n = self.add_word("as", 122);
    n = self.add_word("tail", 123);
    n = self.add_word("pure", 124);
    // `allocates`, `requires`, `ensures` and `decreases` are deliberately NOT here:
    // stage-0 made them contextual in v0.0.55, so they are ordinary identifiers and
    // the parser recognises them by position. A lexer that disagreed with stage-0
    // about this would reject `let allocates: Int = 0;` — which the cross-check test
    // caught within a minute of the change.
    n = self.add_word("interface", 129);
    n = self.add_word("is", 130);
    // Type names are keywords too: the parser needs them distinguished from
    // ordinary identifiers, exactly as the Rust lexer does.
    n = self.add_word("Int", 140);
    n = self.add_word("Bool", 141);
    n = self.add_word("String", 142);
    n = self.add_word("CInt", 143);
    n = self.add_word("CDouble", 144);
    n = self.add_word("Decimal", 145);
    n = self.add_word("RoundHalfEven", 146);
    n = self.add_word("RoundHalfUp", 147);
    return n;
}

// An identifier's span, or a keyword code if the table has it.
fn (self: Unit) keyword_code(src: String, start: Int, length: Int) -> Int {
    let mut i: Int = 0;
    while i < len(self.words) {
        if span_eq(src, start, length, self.words[i].word) {
            return self.words[i].code;
        }
        i = i + 1;
    }
    return 1;
}

fn (mut self: Unit) emit(kind: Int, start: Int, length: Int) -> Int {
    push(self.toks, Tok {
        kind: kind, start: start, length: length,
        value: 0, scale: 0, interpolated: false,
    });
    return len(self.toks);
}

fn (mut self: Unit) emit_number(kind: Int, start: Int, length: Int, value: Int, scale: Int) -> Int {
    push(self.toks, Tok {
        kind: kind, start: start, length: length,
        value: value, scale: scale, interpolated: false,
    });
    return len(self.toks);
}

fn (mut self: Unit) emit_string(start: Int, length: Int, interpolated: Bool) -> Int {
    push(self.toks, Tok {
        kind: 4, start: start, length: length,
        value: 0, scale: 0, interpolated: interpolated,
    });
    return len(self.toks);
}

// ---- whitespace and comments ----------------------------------------------
fn skip_trivia(src: String, from: Int) -> Int {
    let mut i: Int = from;
    while true {
        let mut moved: Bool = false;
        while i < len(src) && is_space(byte_at(src, i)) {
            i = i + 1;
            moved = true;
        }
        if at_byte(src, i) == 47 && at_byte(src, i + 1) == 47 {
            while i < len(src) && byte_at(src, i) != 10 {
                i = i + 1;
            }
            moved = true;
        }
        if !moved {
            break;
        }
    }
    return i;
}

// ---- numbers ---------------------------------------------------------------
// `19.99` is the unscaled integer 1999 with scale 2 — accumulated digit by digit,
// never through a float. `$19.99` is the same. `8.25%` is two places finer.
fn (mut self: Unit) scan_number(src: String, from: Int) -> Int allocates {
    let mut i: Int = from;
    let money: Bool = byte_at(src, i) == 36;         // '$'
    if money {
        i = i + 1;
    }
    let mut value: Int = 0;
    while i < len(src) && is_digit(byte_at(src, i)) {
        value = value * 10 + (byte_at(src, i) - 48);
        i = i + 1;
    }
    let mut scale: Int = 0;
    if at_byte(src, i) == 46 && is_digit(at_byte(src, i + 1)) {
        i = i + 1;
        while i < len(src) && is_digit(byte_at(src, i)) {
            value = value * 10 + (byte_at(src, i) - 48);
            scale = scale + 1;
            i = i + 1;
        }
    }
    if at_byte(src, i) == 37 {                       // '%'
        i = i + 1;
        // A percent is the number divided by a hundred: two more places, exactly.
        let n: Int = self.emit_number(3, from, i - from, value, scale + 2);
        return i;
    }
    if money || scale > 0 {
        let n: Int = self.emit_number(3, from, i - from, value, scale);
        return i;
    }
    let n: Int = self.emit_number(2, from, i - from, value, 0);
    return i;
}

// ---- strings ---------------------------------------------------------------
fn (mut self: Unit) scan_string(src: String, from: Int) -> Int allocates {
    let mut i: Int = from + 1;
    let mut interpolated: Bool = false;
    while true {
        if i >= len(src) {
            print("error: unterminated string literal");
            self.errors = self.errors + 1;
            break;
        }
        let b: Int = byte_at(src, i);
        if b == 92 {                                 // '\' — an escape, whatever follows
            i = i + 2;
            continue;
        }
        if b == 123 {                                // '{' opens an interpolation
            interpolated = true;
            i = i + 1;
            continue;
        }
        if b == 34 {                                 // '"' closes it
            i = i + 1;
            break;
        }
        i = i + 1;
    }
    let n: Int = self.emit_string(from, i - from, interpolated);
    return i;
}

// ---- punctuation -----------------------------------------------------------
// Two-character forms are tried first: `-` and `->` differ by one byte and mean
// entirely different things.
fn (mut self: Unit) scan_punct(src: String, from: Int) -> Int allocates {
    let one: Int = byte_at(src, from);
    let two: Int = at_byte(src, from + 1);
    if one == 45 && two == 62 { let n: Int = self.emit(10, from, 2); return from + 2; }  // ->
    if one == 61 && two == 62 { let n: Int = self.emit(11, from, 2); return from + 2; }  // =>
    if one == 61 && two == 61 { let n: Int = self.emit(12, from, 2); return from + 2; }  // ==
    if one == 33 && two == 61 { let n: Int = self.emit(13, from, 2); return from + 2; }  // !=
    if one == 60 && two == 61 { let n: Int = self.emit(14, from, 2); return from + 2; }  // <=
    if one == 62 && two == 61 { let n: Int = self.emit(15, from, 2); return from + 2; }  // >=
    if one == 38 && two == 38 { let n: Int = self.emit(16, from, 2); return from + 2; }  // &&
    if one == 124 && two == 124 { let n: Int = self.emit(17, from, 2); return from + 2; } // ||

    if one == 58 { let n: Int = self.emit(20, from, 1); return from + 1; }   // :
    if one == 59 { let n: Int = self.emit(21, from, 1); return from + 1; }   // ;
    if one == 44 { let n: Int = self.emit(22, from, 1); return from + 1; }   // ,
    if one == 46 { let n: Int = self.emit(23, from, 1); return from + 1; }   // .
    if one == 61 { let n: Int = self.emit(24, from, 1); return from + 1; }   // =
    if one == 43 { let n: Int = self.emit(25, from, 1); return from + 1; }   // +
    if one == 45 { let n: Int = self.emit(26, from, 1); return from + 1; }   // -
    if one == 42 { let n: Int = self.emit(27, from, 1); return from + 1; }   // *
    if one == 47 { let n: Int = self.emit(28, from, 1); return from + 1; }   // /
    if one == 40 { let n: Int = self.emit(29, from, 1); return from + 1; }   // (
    if one == 41 { let n: Int = self.emit(30, from, 1); return from + 1; }   // )
    if one == 123 { let n: Int = self.emit(31, from, 1); return from + 1; }  // {
    if one == 125 { let n: Int = self.emit(32, from, 1); return from + 1; }  // }
    if one == 91 { let n: Int = self.emit(33, from, 1); return from + 1; }   // [
    if one == 93 { let n: Int = self.emit(34, from, 1); return from + 1; }   // ]
    if one == 60 { let n: Int = self.emit(35, from, 1); return from + 1; }   // <
    if one == 62 { let n: Int = self.emit(36, from, 1); return from + 1; }   // >
    if one == 33 { let n: Int = self.emit(37, from, 1); return from + 1; }   // !

    print("error: byte " + to_string(one) + " starts no token");
    self.errors = self.errors + 1;
    return from + 1;
}

// ---- the loop --------------------------------------------------------------
fn (mut self: Unit) run(src: String) -> Int allocates {
    let count: Int = self.run_range(src, 0, len(src));
    // Where the PROGRAM's tokens end. An interpolation fragment is lexed later and its
    // tokens are appended, so without this the parser would walk off the end of the
    // program and try to read `n` from `"{n}"` as a top-level statement.
    self.token_end = len(self.toks);
    return count;
}

// Lexing a SLICE of the source rather than all of it. Interpolation needs this: the
// bytes between `{` and `}` are real Burxt, and the honest way to read them is with the
// lexer that reads everything else. The tokens are appended, and their spans are absolute,
// so nothing already parsed shifts and every diagnostic still points at the right byte.
fn (mut self: Unit) run_range(src: String, from: Int, until: Int) -> Int allocates {
    let mut i: Int = from;
    while true {
        i = skip_trivia(src, i);
        if i >= until {
            break;
        }
        let b: Int = byte_at(src, i);
        if is_alpha(b) {
            let start: Int = i;
            while i < until && is_name_byte(byte_at(src, i)) {
                i = i + 1;
            }
            let code: Int = self.keyword_code(src, start, i - start);
            let n: Int = self.emit(code, start, i - start);
            continue;
        }
        if is_digit(b) || (b == 36 && is_digit(at_byte(src, i + 1))) {
            i = self.scan_number(src, i);
            continue;
        }
        if b == 34 {
            i = self.scan_string(src, i);
            continue;
        }
        i = self.scan_punct(src, i);
    }
    return len(self.toks);
}
