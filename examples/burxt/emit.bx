// ============================================================================
// emit.bx — part of the Burxt compiler, written in Burxt.
//
// Textual LLVM IR. The runtime is emitted into every module, so a Burxt program needs
// nothing on the machine but a C library.
//
// Assembled by examples/stage1.bx, which is the program; everything here is
// declarations, which is what a module may hold.
// ============================================================================

// =============================================================================
// PHASE 5: the backend. Textual LLVM IR, for the reason M4 §1 gives — an
// `external function` returns an Int or a CInt, never a pointer whose ownership Burxt
// cannot describe, so an LLVMBuilderRef is unreachable BY CONSTRUCTION. Emitting
// text is not a workaround: it is string formatting instead of an API, and the
// output is readable, diffable and testable without a debugger.
//
// Slice 1 covers Ints, Bools, String literals, arithmetic with the overflow
// checks the thesis requires, comparisons, `if`, `while`, `break`, `continue`,
// functions, calls and `print`. Decimals, regions and aggregates follow; what is
// not covered is refused by name rather than emitted wrongly.
// =============================================================================

// A local. For a scalar the alloca holds the value; for an aggregate the alloca IS the
// storage and the value is its address.
//
// `aggregate` means "the alloca IS the storage", recorded rather than inferred from
// `cells`. A class with ONE field occupies one cell and is still a class — inferring it
// from the count loaded the field instead of passing the address, and a one-field record
// passed to a method segfaulted. A `mutable self` slot is the mirror case: one cell, holding
// someone else's address, so it reads by LOADING and is marked not-aggregate.
class Slot { start: Int, length: Int, index: Int, cells: Int, aggregate: Int }

// Two buffers per function, joined when it closes. Allocas MUST land in the entry
// block: an `alloca` inside a loop allocates again on every iteration, so a `let` in a
// `while` would grow the stack until it ran out. The entry block is the one place where
// "once per call" is guaranteed.
// The body accumulates in CHUNKS for the same reason the module does: `a += b` copies
// the whole left side, and a function body reaching a hundred kilobytes, appended to a
// hundred thousand times, copies gigabytes. Bounding each copy to the chunk size is what
// keeps the compiler inside its own region.
//
// The entry buffer stays a plain String: allocas are few and short, so it never grows
// enough for the quadratic term to matter.
function (mutable self: Unit) write_body(text: String) -> Int {
    self.body_pending += text;
    if len(self.body_pending) > 512 {
        push(self.body_chunks, self.body_pending);
        self.body_pending = "";
    }
    return 0;
}

// Module-level text — the declarations and the runtime — goes straight to the module,
// not through a function's buffer: `open_function` clears those, and a preamble written into
// one would be discarded when the first function opened.
// The module's text, in CHUNKS of 512 bytes.
//
// The number is a balance, and it is worth the arithmetic. With A appends into a buffer that
// is flushed at T bytes, the copying is about A x T/2; joining the N/T chunks pairwise costs
// N per round for log2(N/T) rounds. Emitting this compiler is A ~ 300,000 and N ~ 1.5 MB, so
// T = 4096 spent about 600 MB and ran the region out; T = 512 spends about 95 MB.
// `a += b` copies the whole left side, so appending
// fifty thousand times to one growing String copies gigabytes — which is exactly how
// this compiler first exhausted its region while emitting its own source. Chunks bound
// each copy to the chunk size, and the joins at the end are few.
//
// The real fix is a byte buffer that grows in place, which needs a builtin that writes
// one. Recorded rather than pretended away: this is a cost, not a design.
function (mutable self: Unit) write_module(text: String) -> Int {
    self.pending += text;
    if len(self.pending) > 512 {
        push(self.chunks, self.pending);
        self.pending = "";
    }
    return 0;
}

// Joining the chunks PAIRWISE rather than one after another. Appending each chunk to a
// growing result copies the whole result every time — O(n²) in the output size, which is
// what exhausted a 1 GB region the moment the module grew past a megabyte. Merging pairs
// halves the count each round, so the total copying is O(n log n): about eleven megabytes
// for a 1.2 MB module instead of several hundred.
//
// The honest fix is still a byte buffer that grows in place, which needs a builtin that
// writes one. This buys the room to get there.
function (mutable self: Unit) finish() -> String {
    if len(self.pending) > 0 {
        push(self.chunks, self.pending);
        self.pending = "";
    }
    if len(self.chunks) == 0 {
        return "";
    }
    while len(self.chunks) > 1 {
        let mutable merged: [String] = [];
        let mutable i: Int = 0;
        while i + 1 < len(self.chunks) {
            let pair: String = self.chunks[i] + self.chunks[i + 1];
            let added: Int = push(merged, pair);
            i += 2;
        }
        if i < len(self.chunks) {
            let last: Int = push(merged, self.chunks[i]);
        }
        self.chunks = merged;
    }
    return self.chunks[0];
}

function (mutable self: Unit) write_entry(text: String) -> Int {
    self.function_entry += text;
    return 0;
}

function (mutable self: Unit) open_function(header: String) -> Int {
    self.function_entry = "";
    self.body_pending = "";
    self.body_chunks = [];
    return self.write_entry(header);
}

function (mutable self: Unit) close_function(closing: String) -> Int {
    let entry_written: Int = self.write_module(self.function_entry);
    let mutable i: Int = 0;
    while i < len(self.body_chunks) {
        let piece: Int = self.write_module(self.body_chunks[i]);
        i += 1;
    }
    let rest: Int = self.write_module(self.body_pending);
    let closed: Int = self.write_module(closing);
    self.function_entry = "";
    self.body_pending = "";
    self.body_chunks = [];
    return 0;
}

function (mutable self: Unit) fresh() -> String {
    self.next_register += 1;
    return "%t" + to_string(self.next_register);
}

function (mutable self: Unit) fresh_label(stem: String) -> String {
    self.next_label += 1;
    return stem + to_string(self.next_label);
}

// A local's alloca, named by its position in the table rather than by the source
// name, so two blocks that both say `x` cannot collide in the IR.
function (mutable self: Unit) declare_slot(src: String, start: Int, length: Int, cells: Int,
                                 aggregate: Int) -> Int {
    // The NAME comes from a counter that only grows, not from the table's length. A match
    // arm's bindings leave scope by truncating the table, so lengths repeat — and two
    // allocas called `%v3` in one function is not a program LLVM will accept.
    self.next_slot += 1;
    let index: Int = self.next_slot;
    push(self.slots, Slot { start: start, length: length, index: index, cells: cells,
                            aggregate: aggregate });
    let visited: Int = self.write_entry("  %v" + to_string(index) + " = alloca ["
                                   + to_string(cells) + " x i64]\n");
    return index;
}

// Scratch storage for a value that has no name — a class literal, an array literal.
// In the entry block for the same reason every other alloca is.
function (mutable self: Unit) scratch(cells: Int) -> String {
    self.next_register += 1;
    let name: String = "%scratch" + to_string(self.next_register);
    let visited: Int = self.write_entry("  " + name + " = alloca [" + to_string(cells)
                                   + " x i64]\n");
    return name;
}

function (self: Unit) slot_is_aggregate(src: String, start: Int, length: Int) -> Bool {
    let mutable i: Int = len(self.slots) - 1;
    while i >= 0 {
        let slot: Slot = self.slots[i];
        if spans_equal(src, slot.start, slot.length, start, length) {
            return slot.aggregate == 1;
        }
        i -= 1;
    }
    return false;
}

// How many i64 cells a value of this type occupies. Everything a Burxt value can be is
// eight bytes wide or an aggregate of things that are — a String and a growable array
// are pointers, a Decimal is a scaled i64 — so a layout is a COUNT, and nothing here
// needs an alignment rule.
function (mutable self: Unit) cells_of(src: String, written: Type) -> Int {
    // A type parameter is whatever it was bound to, and a generic's fields are sized with its
    // ARGUMENTS in scope. Because a layout is a count and not a named LLVM type, nothing is
    // rewritten and no copy of the declaration is made: `Pair<Int>` is 2 cells and
    // `Pair<Point>` is 4 from the same declaration, read twice under different bindings.
    // The same laziness the checker found, applied to size.
    let bound_type: Type = self.resolve_shallow(src, written);
    if bound_type.kind == 46 {
        let found: Int = self.find_type(src, bound_type.name_start, bound_type.name_length);
        if found < 0 {
            return 1;
        }
        let decl: TypeDeclaration = self.types[found];
        let item: Node = self.nodes[decl.node];
        // Installed AFTER the two refusals above, so the only paths that bind are the two
        // that walk, and each of them restores before it answers.
        let restore: Int = self.bind_from_application(src, bound_type);
        if decl.kind == 83 {
            // An enum is a TAG plus room for the widest variant's payload. Every value of
            // the type is the same size, so one may be assigned where another was — which
            // is what makes a variant a value rather than a separate type.
            let mutable widest: Int = 0;
            let mutable v: Int = 0;
            while v < item.b {
                let variant: Node = self.nodes[self.children[item.a + v]];
                let mutable carried: Int = 0;
                let mutable p: Int = 0;
                while p < variant.c {
                    carried += self.cells_of(src, self.declared_type(src, self.nested_children[variant.b + p]));
                    p += 1;
                }
                if carried > widest { widest = carried; }
                v += 1;
            }
            let dropped: Int = truncate(self.type_bindings, restore);
            return 1 + widest;
        }
        if decl.kind != 82 {
            let dropped: Int = truncate(self.type_bindings, restore);
            return 1;
        }
        let mutable total: Int = 0;
        let mutable f: Int = 0;
        while f < item.b {
            let field: Node = self.nodes[self.children[item.a + f]];
            total += self.cells_of(src, self.declared_type(src, field.a));
            f += 1;
        }
        let dropped: Int = truncate(self.type_bindings, restore);
        return total;
    }
    if bound_type.kind == 48 {                               // [T; N]
        return bound_type.contract * self.cells_of(src, self.declared_type(src, bound_type.scale));
    }
    if bound_type.kind == 49 {
        // An interface object is a FAT POINTER: the value, and the table of the interface's
        // methods. Two cells, always, whatever the concrete type behind it is — which is
        // what lets one `dynamic Priced` hold a Book today and a Meal tomorrow.
        return 2;
    }
    return 1;
}

// Where a field starts, in cells, and -1 when the holder has no such field. The walk is
// the same one `cells_of` does, which is why the two cannot disagree about a layout.
function (mutable self: Unit) offset_of(src: String, holder: Type, name: Token) -> Int {
    let found: Int = self.find_type(src, holder.name_start, holder.name_length);
    if found < 0 {
        return -1;
    }
    let item: Node = self.nodes[self.types[found].node];
    let restore: Int = self.bind_from_application(src, holder);
    let mutable offset: Int = 0;
    let mutable f: Int = 0;
    let mutable answer: Int = 0 - 1;
    while f < item.b && answer < 0 {
        let field: Node = self.nodes[self.children[item.a + f]];
        let field_name: Token = self.tokens[field.token];
        if spans_equal(src, field_name.start, field_name.length, name.start, name.length) {
            answer = offset;
        } else {
            offset += self.cells_of(src, self.declared_type(src, field.a));
        }
        f += 1;
    }
    let dropped: Int = truncate(self.type_bindings, restore);
    return answer;
}

// A field's type with the holder's type ARGUMENTS in scope, so `Pair<Point>.first` is a Point
// and not a `T`. Without this the emitter asked whether a `T` was an aggregate, was told no,
// and stored the value's ADDRESS in the field instead of copying its cells — a class that
// looked the right size and held a pointer where a Point belonged. check.bx's record-literal
// rule does exactly this, which is the argument for it living in one named function.
function (mutable self: Unit) field_type_here(src: String, holder: Type, at: Int) -> Type {
    let base: Int = self.bind_from_application(src, holder);
    let stated: Type = self.field_type(src, holder, at);
    let settled: Type = self.resolve_deep(src, stated, at);
    let dropped: Int = truncate(self.type_bindings, base);
    return settled;
}

// Does a value of this type travel by ADDRESS rather than in a register? Resolved first, because
// a `T` is whatever it was bound to and the answer decides the calling convention.
//
// It did not resolve at first, and the bug that found was precise: a method returning `T` where
// `T = Point` did not set up an sret, while the CALL site — reading the checker's already-resolved
// type — passed a storage pointer as the first argument. The two halves of one call disagreeing
// about the shape of a function is not a wrong answer, it is a wrong frame.
function (self: Unit) is_aggregate_written(src: String, written: Type) -> Bool {
    return self.is_aggregate(self.resolve_shallow(src, written));
}

function (self: Unit) is_aggregate(bound_type: Type) -> Bool {
    return bound_type.kind == 46 || bound_type.kind == 48 || bound_type.kind == 49;
}

function (self: Unit) find_slot(src: String, start: Int, length: Int) -> Int {
    let mutable i: Int = len(self.slots) - 1;
    while i >= 0 {
        let slot: Slot = self.slots[i];
        if spans_equal(src, slot.start, slot.length, start, length) {
            return slot.index;
        }
        i -= 1;
    }
    return -1;
}

// Every byte as a hex escape. LLVM accepts c"\68\69\00", and emitting only escapes
// means no byte needs a character to stand for it — which matters in a language whose
// own `to_string` answers with digits, not letters.
function hex_of(value: Int) -> String {
    let digits: String = "0123456789abcdef";
    return "\\" + substring(digits, divide_floor(value, 16), 1)
                + substring(digits, remainder(value, 16), 1);
}

// A private constant for these bytes, answering the global's name. The bytes are the
// STRING as the lexer read it, escapes and all, so what the program prints is what the
// source said.
// A constant holding bytes the EMITTER produced — a printf format built for a scale,
// say — rather than bytes quoted from the program. Same escaping, different source.
function (mutable self: Unit) intern_text(text: String) -> String {
    let name: String = "@burxt.k" + to_string(len(self.strings));
    push(self.strings, 0);
    // Measured once. `len` on a String walks it, so leaving it in the condition makes
    // interning cost the square of the literal's length — the same shape that made the
    // lexer quadratic. See at_byte in types.bx.
    let width: Int = len(text);
    let mutable body: String = "";
    let mutable i: Int = 0;
    while i < width {
        body += hex_of(byte_at(text, i));
        i += 1;
    }
    // `{ i64 length, [n+1 x i8] bytes }`, and the operand answered is a GEP past the header, so a
    // literal looks exactly like a region-built String to everything downstream. Without the header
    // `len("hello")` would read whatever the linker placed before the bytes.
    let shape: String = "\{ i64, [" + to_string(width + 1) + " x i8] \}";
    self.globals += name + " = private unnamed_addr constant " + shape + " \{ i64 "
        + to_string(width) + ", [" + to_string(width + 1) + " x i8] c\"" + body + hex_of(0)
        + "\" \}\n";
    // The GEP expression inline, repeated at each use, and that is the MEASURED choice rather than
    // the tidy one. An `alias` naming the byte pointer once looks obviously better — a short name
    // instead of sixty characters — and cost 0.99 s and 968 MB against 0.11 s and 326 MB, because
    // `self.globals` is a growing String and one more append per literal is quadratic in the
    // literal count. The tidier IR was three times slower to produce.
    //
    // Recorded because it is the kind of change that would be made again on principle. If
    // `globals` ever becomes a chunk list like `chunks` and `body_chunks` already are, this is
    // worth re-measuring.
    return "getelementptr inbounds (" + shape + ", ptr " + name + ", i32 0, i32 1)";
}

// Ten to the power of a scale. A scale is at most 18 and 10^18 fits in an i64, so this
// is a literal the emitter can write rather than a computation the program must do.
function power_of_ten(scale: Int) -> Int {
    let mutable n: Int = 1;
    let mutable i: Int = 0;
    while i < scale {
        n = n * 10;
        i += 1;
    }
    return n;
}

function (mutable self: Unit) intern(src: String, start: Int, length: Int) -> String {
    let name: String = "@burxt.s" + to_string(len(self.strings));
    push(self.strings, start);
    let mutable body: String = "";
    let mutable count: Int = 0;
    let mutable i: Int = 0;
    while i < length {
        let byte: Int = byte_at(src, start + i);
        if byte == 92 && i + 1 < length {            // a backslash: the lexer's escape
            let next: Int = byte_at(src, start + i + 1);
            let mutable resolved: Int = next;
            if next == 110 { resolved = 10; }        // \n
            if next == 114 { resolved = 13; }        // \r
            if next == 116 { resolved = 9; }         // \t
            if next == 48 { resolved = 0; }          // \0
            body += hex_of(resolved);
            count += 1;
            i += 2;
        } else {
            body += hex_of(byte);
            count += 1;
            i += 1;
        }
    }
    let shape: String = "\{ i64, [" + to_string(count + 1) + " x i8] \}";
    self.globals += name + " = private unnamed_addr constant " + shape + " \{ i64 "
        + to_string(count) + ", [" + to_string(count + 1) + " x i8] c\"" + body + hex_of(0)
        + "\" \}\n";
    return "getelementptr inbounds (" + shape + ", ptr " + name + ", i32 0, i32 1)";
}

// ---- expressions -------------------------------------------------------------
// Each one answers an OPERAND: a register like %t7, or a literal like 42. The caller
// does not care which, which is what keeps the emitter free of a value type.
// The element at `index` of an array whose type is `holder`, given the array's `base`
// register. Shared by `xs[i]` and by `for x in xs`, so the two cannot drift apart —
// which they would, because the slice and fixed-array paths differ.
function (mutable self: Unit) emit_element(src: String, holder: Type, base: String, index: String,
                                 token: Int) -> String {
        if holder.kind == 47 {
            let element: Type = self.declared_type(src, holder.scale);
            let at: String = self.fresh();
            let found: Int = self.write_body("  " + at + " = call i64 @burxt.slot(i64 " + base
                                    + ", i64 " + index + ", i64 "
                                    + to_string(self.tokens[token].start) + ")\n");
            if self.is_aggregate_written(src, element) {
                return at;
            }
            let as_ptr: String = self.fresh();
            let cast: Int = self.write_body("  " + as_ptr + " = inttoptr i64 " + at + " to ptr\n");
            let reg: String = self.fresh();
            let loaded: Int = self.write_body("  " + reg + " = load i64, ptr " + as_ptr + "\n");
            return reg;
        }
        if holder.kind != 48 {
            let complained: Int = self.complain_at(src, token,
                "the Burxt backend cannot index this");
            return "0";
        }
        let element: Type = self.declared_type(src, holder.scale);
        let stride: Int = self.cells_of(src, element);
        // The bounds check is not optional and not a build mode: an index past the end
        // is a named failure, exit 70, like every other one.
        let checked: Int = self.write_body("  call void @burxt.bounds(i64 " + index + ", i64 "
                                  + to_string(holder.contract) + ", i64 "
                                  + to_string(self.tokens[token].start) + ")\n");
        let scaled: String = self.fresh();
        let multiplied: Int = self.write_body("  " + scaled + " = mul i64 " + index + ", "
                                     + to_string(stride) + "\n");
        let as_ptr: String = self.fresh();
        let cast: Int = self.write_body("  " + as_ptr + " = inttoptr i64 " + base + " to ptr\n");
        let at: String = self.fresh();
        let stepped: Int = self.write_body("  " + at + " = getelementptr i64, ptr " + as_ptr
                                  + ", i64 " + scaled + "\n");
        if self.is_aggregate_written(src, element) {
            let reg: String = self.fresh();
            let visited: Int = self.write_body("  " + reg + " = ptrtoint ptr " + at + " to i64\n");
            return reg;
        }
        let reg: String = self.fresh();
        let loaded: Int = self.write_body("  " + reg + " = load i64, ptr " + at + "\n");
        return reg;
}
function (mutable self: Unit) emit_expr(src: String, node: Int) -> String {
    let n: Node = self.nodes[node];
    if n.kind == 1 {                                 // an Int literal
        return to_string(n.value);
    }
    if n.kind == 2 {                                 // a Decimal literal
        // Scaled integer, and nothing else: $19.99 IS 1999. But a literal takes the scale
        // of its CONTEXT when that loses nothing — `$5` in a Decimal<2> is 5.00, the
        // integer 500 — and the checker recorded which scale it settled on. Emitting the
        // lexer's raw digits instead printed `$5` as 0.05.
        let settled: Type = self.type_at(node);
        let mutable value: Int = n.value;
        if settled.kind == 45 {
            if settled.scale > n.a {
                value = value * power_of_ten(settled.scale - n.a);
            }
            if settled.scale < n.a {
                // Narrowing, which the checker allowed only because every digit dropped
                // is a zero: `42.0` in a Decimal<0> is 42, and the division is exact.
                value = divide_toward_zero(value, power_of_ten(n.a - settled.scale));
            }
        }
        return to_string(value);
    }
    if n.kind == 4 {                                 // a Bool literal
        if n.value == 1 {
            return "1";
        }
        return "0";
    }
    if n.kind == 3 {                                 // a String literal, or a piece
        if n.c == 1 {
            // A literal run inside an interpolation: the span is the bytes themselves,
            // with no quotes around them.
            let inner: String = self.intern(src, n.a, n.b);
            return "ptrtoint (ptr " + inner + " to i64)";
        }
        let t: Token = self.tokens[n.token];
        // The token's span includes its quotes, and the bytes between them are the
        // string. One place knows that, and it is here.
        let global: String = self.intern(src, t.start + 1, t.length - 2);
        return "ptrtoint (ptr " + global + " to i64)";
    }

    if n.kind == 18 {                                // an interpolated String, as a value
        // The join it stands for, left to right — byte-identical to writing the `+` and
        // `to_string` calls by hand, which is the promise interpolation makes.
        if n.b == 0 {
            return "ptrtoint (ptr " + self.intern_text("") + " to i64)";
        }
        let mutable joined: String = self.emit_piece(src, self.children[n.a]);
        let mutable i: Int = 1;
        while i < n.b {
            let piece: String = self.emit_piece(src, self.children[n.a + i]);
            let next: String = self.fresh();
            let appended: Int = self.write_body("  " + next + " = call i64 @burxt.concat(i64 "
                                       + joined + ", i64 " + piece + ")\n");
            joined = next;
            i += 1;
        }
        return joined;
    }
    // Kind 21: the value being returned. No name, so no span, so no slot lookup — it reads the one
    // slot `emit_ensures` declared. That is the whole of what stage-1 needed for a return bracket,
    // and it is smaller than the synthetic token spec/M13 proposed for two versions.
    if n.kind == 21 {
        if self.result_slot < 0 {
            return "0";
        }
        let reg: String = self.fresh();
        let visited: Int = self.write_body("  " + reg + " = load i64, ptr %v"
                                  + to_string(self.result_slot) + "\n");
        return reg;
    }
    if n.kind == 5 {                                 // a name
        let t: Token = self.tokens[n.token];
        let slot: Int = self.find_slot(src, t.start, t.length);
        if slot < 0 {
            return "0";
        }
        let reg: String = self.fresh();
        if self.slot_is_aggregate(src, t.start, t.length) {
            // An aggregate's value IS its address: the alloca is the storage, and
            // copying happens where a copy is meant, not on every mention.
            let visited: Int = self.write_body("  " + reg + " = ptrtoint ptr %v" + to_string(slot)
                                      + " to i64\n");
            return reg;
        }
        let visited: Int = self.write_body("  " + reg + " = load i64, ptr %v" + to_string(slot)
                                  + "\n");
        return reg;
    }

    // `Enum.Variant` and `Enum.Variant(x)` parse as a field access and a method call. The
    // base names a TYPE rather than a value, which is the only thing that tells them
    // apart — the same check the typechecker makes, for the same reason.
    if n.kind == 11 || n.kind == 14 {
        let base_node: Node = self.nodes[n.a];
        if base_node.kind == 5 {
            let base_name: Token = self.tokens[base_node.token];
            let declared: Int = self.find_type(src, base_name.start, base_name.length);
            if declared >= 0 {
                if self.types[declared].kind == 83 {
                    let holder: Type = Type { kind: 46, scale: 0, contract: 0,
                                          name_start: base_name.start,
                                          name_length: base_name.length };
                    return self.emit_construction(src, holder, n, n.kind == 14);
                }
            }
        }
    }

    if n.kind == 11 {                                // a field
        let holder: Type = self.type_at(n.a);
        let base: String = self.emit_expr(src, n.a);
        let field: Token = self.tokens[n.token];
        let offset: Int = self.offset_of(src, holder, field);
        if offset < 0 {
            let complained: Int = self.complain_at(src, n.token,
                "the Burxt backend cannot find this field's offset");
            return "0";
        }
        let as_ptr: String = self.fresh();
        let cast: Int = self.write_body("  " + as_ptr + " = inttoptr i64 " + base + " to ptr\n");
        let at: String = self.fresh();
        let stepped: Int = self.write_body("  " + at + " = getelementptr i64, ptr " + as_ptr
                                  + ", i64 " + to_string(offset) + "\n");
        let mine: Type = self.type_at(node);
        if self.is_aggregate_written(src, mine) {
            // A field that is itself an aggregate answers an INTERIOR address, which is
            // the same kind of value as any other aggregate's.
            let reg: String = self.fresh();
            let visited: Int = self.write_body("  " + reg + " = ptrtoint ptr " + at + " to i64\n");
            return reg;
        }
        let reg: String = self.fresh();
        let loaded: Int = self.write_body("  " + reg + " = load i64, ptr " + at + "\n");
        return reg;
    }

    if n.kind == 12 {                                // xs[i]
        let holder: Type = self.type_at(n.a);
        let base: String = self.emit_expr(src, n.a);
        let index: String = self.emit_expr(src, n.b);
        return self.emit_element(src, holder, base, index, n.token);
    }

    if n.kind == 19 {                                // a class literal
        let mine: Type = self.type_at(node);
        let cells: Int = self.cells_of(src, mine);
        let storage: String = self.scratch(cells);
        let mutable i: Int = 0;
        while i < n.b {
            let pair: Node = self.nodes[self.children[n.a + i]];
            let field: Token = self.tokens[pair.token];
            let offset: Int = self.offset_of(src, mine, field);
            let field_ty: Type = self.field_type_here(src, mine, pair.token);
            let value: String = self.emit_value_for(src, field_ty, pair.a);
            let at: String = self.fresh();
            let stepped: Int = self.write_body("  " + at + " = getelementptr i64, ptr " + storage
                                      + ", i64 " + to_string(offset) + "\n");
            if self.is_aggregate_written(src, field_ty) {
                // A field holding an aggregate holds a COPY of it, not a reference to
                // wherever the value came from.
                let copied: Int = self.copy_cells(src, at, value,
                                                  self.cells_of(src, field_ty));
            } else {
                let stored: Int = self.write_body("  store i64 " + value + ", ptr " + at + "\n");
            }
            i += 1;
        }
        let reg: String = self.fresh();
        let visited: Int = self.write_body("  " + reg + " = ptrtoint ptr " + storage + " to i64\n");
        return reg;
    }

    if n.kind == 17 {                                // an array literal
        let mine: Type = self.type_at(node);
        if mine.kind == 47 {                         // [T] — a header in the region
            let element: Type = self.declared_type(src, mine.scale);
            let reg: String = self.fresh();
            let made: Int = self.write_body("  " + reg + " = call i64 @burxt.new_array(i64 "
                                   + to_string(self.cells_of(src, element)) + ")\n");
            let mutable k: Int = 0;
            while k < n.b {
                let value: String = self.emit_expr(src, self.children[n.a + k]);
                let pushed: String = self.fresh();
                let added: Int = self.write_body("  " + pushed + " = call i64 @burxt.push(i64 "
                                        + reg + ", i64 " + value + ")\n");
                k += 1;
            }
            return reg;
        }
        if mine.kind != 48 {
            let complained: Int = self.complain_at(src, n.token,
                "the Burxt backend cannot build this array");
            return "0";
        }
        let element: Type = self.declared_type(src, mine.scale);
        let stride: Int = self.cells_of(src, element);
        let storage: String = self.scratch(self.cells_of(src, mine));
        let mutable i: Int = 0;
        while i < n.b {
            let value: String = self.emit_expr(src, self.children[n.a + i]);
            let at: String = self.fresh();
            let stepped: Int = self.write_body("  " + at + " = getelementptr i64, ptr " + storage
                                      + ", i64 " + to_string(i * stride) + "\n");
            if self.is_aggregate_written(src, element) {
                let copied: Int = self.copy_cells(src, at, value, stride);
            } else {
                let stored: Int = self.write_body("  store i64 " + value + ", ptr " + at + "\n");
            }
            i += 1;
        }
        let reg: String = self.fresh();
        let visited: Int = self.write_body("  " + reg + " = ptrtoint ptr " + storage + " to i64\n");
        return reg;
    }
    if n.kind == 6 || n.kind == 7 {                  // -e, !e
        let inner: String = self.emit_expr(src, n.a);
        let reg: String = self.fresh();
        if n.kind == 7 {
            let visited: Int = self.write_body("  " + reg + " = xor i64 " + inner + ", 1\n");
        } else {
            let visited: Int = self.write_body("  " + reg + " = call i64 @burxt.checked.sub(i64 0, "
                                      + "i64 " + inner + ")\n");
        }
        return reg;
    }
    if n.kind == 8 {                                 // a + b, a - b, a * b
        let left: String = self.emit_expr(src, n.a);
        let right: String = self.emit_expr(src, n.b);
        if n.value == 25 && self.type_at(n.a).kind == 42 {
            // `+` on Strings is a join, and the join allocates in the open region.
            let joined: String = self.fresh();
            let visited: Int = self.write_body("  " + joined + " = call i64 @burxt.concat(i64 "
                                      + left + ", i64 " + right + ")\n");
            return joined;
        }
        let left_ty: Type = self.type_at(n.a);
        let right_ty: Type = self.type_at(n.b);
        let answer_ty: Type = self.type_at(node);

        if n.value == 27 && left_ty.kind == 45 && right_ty.kind == 45 {
            // The exact product of two scaled integers has the SUM of their scales. Landing
            // it on the answer's scale is a division by a power of ten — and the rounding
            // contract in the type is what says which way it goes. This is the one place
            // in the language where a value can lose information, and it is written down.
            let shift: Int = left_ty.scale + right_ty.scale - answer_ty.scale;
            return self.emit_rounded(left, right, shift, answer_ty.contract, 0);
        }
        if n.value == 28 && left_ty.kind == 45 {
            // a / b, both scaled by 10^S: the true quotient scaled back up is a*10^S / b.
            // Dividing by an Int needs no scaling at all — the count is not scaled.
            if right_ty.kind == 45 {
                return self.emit_rounded(left, right, 0 - answer_ty.scale,
                                         answer_ty.contract, 1);
            }
            return self.emit_rounded(left, right, 0, answer_ty.contract, 1);
        }

        let mutable helper: String = "add";
        if n.value == 26 { helper = "sub"; }
        if n.value == 27 { helper = "mul"; }
        let reg: String = self.fresh();
        // Through the checked helper, always. An arithmetic result that silently wraps
        // is the same class of wrong as a rounded cent.
        let visited: Int = self.write_body("  " + reg + " = call i64 @burxt.checked." + helper
                                  + "(i64 " + left + ", i64 " + right + ")\n");
        return reg;
    }
    if n.kind == 9 {                                 // a comparison
        let left: String = self.emit_expr(src, n.a);
        let right: String = self.emit_expr(src, n.b);
        // A CLASS compares field by field. Before v0.0.184 this fell through to the integer path,
        // which compared the two ADDRESSES — so `a == b` on two identical Points answered false, and
        // the checker accepted it. A silent wrong answer, for as long as classes have existed,
        // reachable from three lines of ordinary code.
        //
        // Not memcmp either: a String field holds a POINTER, and two equal strings need not live at
        // the same address, so comparing the cells would be the same bug one level down.
        if self.type_at(n.a).kind == 46 {
            let bit: String = self.class_equal(src, self.type_at(n.a), left, right);
            if n.value == 13 {                       // `!=`
                let flipped: String = self.fresh();
                let inverted: Int = self.write_body("  " + flipped + " = sub i64 1, " + bit + "\n");
                return flipped;
            }
            return bit;
        }
        if self.type_at(n.a).kind == 42 {
            // Strings compare by BYTES. Comparing the i64s would compare pointers, which
            // is true only when two Strings are the same object — a bug that reads as a
            // working program right up until two equal Strings were built separately.
            let order: String = self.fresh();
            let compared: Int = self.write_body("  " + order + " = call i64 @burxt.strcmp(i64 "
                                       + left + ", i64 " + right + ")\n");
            let bit: String = self.fresh();
            let mutable op: String = "eq";
            if n.value == 13 { op = "ne"; }
            let tested: Int = self.write_body("  " + bit + " = icmp " + op + " i64 " + order
                                     + ", 0\n");
            let reg: String = self.fresh();
            let widened: Int = self.write_body("  " + reg + " = zext i1 " + bit + " to i64\n");
            return reg;
        }
        // The token codes, not invented ones: `==` is 12, `!=` 13, `<=` 14, `>=` 15,
        // and the single-character `<` and `>` are 35 and 36.
        let mutable op: String = "eq";
        if n.value == 13 { op = "ne"; }
        if n.value == 14 { op = "sle"; }
        if n.value == 15 { op = "sge"; }
        if n.value == 35 { op = "slt"; }
        if n.value == 36 { op = "sgt"; }
        let bit: String = self.fresh();
        let visited: Int = self.write_body("  " + bit + " = icmp " + op + " i64 " + left + ", "
                                  + right + "\n");
        let reg: String = self.fresh();
        // A Bool is an i64 in Burxt's ABI, so a comparison widens once, here.
        let widened: Int = self.write_body("  " + reg + " = zext i1 " + bit + " to i64\n");
        return reg;
    }
    if n.kind == 10 {                                // && and ||
        // These SHORT-CIRCUIT: the right side is evaluated only when the left has not
        // already decided the answer. That is not an optimisation, it is what makes
        // `while keep > 0 && self.bindings[keep - 1].depth >= self.depth` safe to write —
        // and this compiler's own symbol table is written exactly that way, which is how
        // a backend that evaluated both sides was caught: by indexing at -1.
        //
        // The answer lives in one cell: store the left value, and overwrite it only if
        // the right side runs. For `&&` a false left IS the answer; for `||` a true left
        // is; and when the right side runs, it is the answer for both.
        //
        // The parser classes the OPERATOR'S BYTE — 124 for `|`, 38 for `&` — not the
        // token kind. Reading it as a token kind made every `||` an `and`, and the first
        // test to notice agreed with stage-0 by accident: `5 != 5 || false` is false
        // either way.
        let answer: String = self.scratch(1);
        let left: String = self.emit_expr(src, n.a);
        let kept: Int = self.write_body("  store i64 " + left + ", ptr " + answer + "\n");
        let bit: String = self.fresh();
        let tested: Int = self.write_body("  " + bit + " = icmp ne i64 " + left + ", 0\n");
        let rhs_label: String = self.fresh_label("logic.rhs");
        let end_label: String = self.fresh_label("logic.end");
        if n.value == 124 {                          // ||: a true left is the answer
            let branched: Int = self.write_body("  br i1 " + bit + ", label %" + end_label
                                       + ", label %" + rhs_label + "\n");
        } else {                                     // &&: a false left is the answer
            let branched: Int = self.write_body("  br i1 " + bit + ", label %" + rhs_label
                                       + ", label %" + end_label + "\n");
        }
        let opened: Int = self.write_body(rhs_label + ":\n");
        let right: String = self.emit_expr(src, n.b);
        let stored: Int = self.write_body("  store i64 " + right + ", ptr " + answer + "\n");
        let joined: Int = self.write_body("  br label %" + end_label + "\n" + end_label + ":\n");
        let reg: String = self.fresh();
        let loaded: Int = self.write_body("  " + reg + " = load i64, ptr " + answer + "\n");
        return reg;
    }
    if n.kind == 14 {                                // a method call
        // `c == 1`: the checker already decided this is an ASSOCIATED function, so the base is a
        // class NAME rather than a value and there is no receiver to evaluate. Taking the marker
        // rather than re-deriving it means the backend cannot disagree with the checker about which
        // call this is — and a disagreement there is a wrong call, not an error message.
        if n.c == 1 {
            return self.emit_associated_call(src, node, n);
        }
        let holder: Type = self.type_at(n.a);
        if holder.kind == 49 {
            // The call's own type, resolved here because a dynamic call needs it for the
            // same reason a direct one does: an aggregate answer travels through the
            // caller's storage and the call has to hand over a pointer.
            let dyn_answers: Type = self.type_at(node);
            return self.emit_dynamic_call(src, holder, n, dyn_answers);
        }
        let receiver: String = self.emit_expr(src, n.a);
        let list: Node = self.nodes[n.b];
        // Against the METHOD's declared parameters, for the same reason as an ordinary call: a
        // method taking `item: Priced` wants a fat pointer, and only its declaration says so.
        let found_method: Int = self.find_method(src, holder, n.token);
        let mutable method_params: Int = 0 - 1;
        if found_method >= 0 {
            method_params = self.methods[found_method].parameters;
        }
        let mutable args: String = "i64 " + receiver;
        let mutable k: Int = 0;
        while k < list.b {
            let want: Type = self.param_type_at(src, method_params, k);
            let value: String = self.emit_value_for(src, want, self.children[list.a + k]);
            args += ", i64 " + value;
            k += 1;
        }
        let answers: Type = self.type_at(node);
        if self.is_aggregate_written(src, answers) {
            let storage: String = self.scratch(self.cells_of(src, answers));
            let dropped: String = self.fresh();
            let seen: Int = self.note_holder(src, holder);
            let called_it: Int = self.write_body("  " + dropped + " = call i64 @"
                                        + method_symbol(src, holder, self.tokens[n.token])
                                        + self.holder_suffix(src, holder)
                                        + "(ptr " + storage + ", " + args + ")\n");
            let reg: String = self.fresh();
            let address: Int = self.write_body("  " + reg + " = ptrtoint ptr " + storage
                                      + " to i64\n");
            return reg;
        }
        let reg: String = self.fresh();
        let seen: Int = self.note_holder(src, holder);
        let visited: Int = self.write_body("  " + reg + " = call i64 @"
                                  + method_symbol(src, holder, self.tokens[n.token])
                                  + self.holder_suffix(src, holder)
                                  + "(" + args + ")\n");
        return reg;
    }

    if n.kind == 13 {                                // a call
        let t: Token = self.tokens[n.token];
        let list: Node = self.nodes[n.a];
        let called: String = substring(src, t.start, t.length);
        if builtin_arity(called) >= 0 {
            return self.emit_builtin(src, n, called);
        }
        // `old(expr)` is not a call. Its value was captured at function entry — see hoist_old — so
        // this reads the slot rather than calling anything, and must do so BEFORE the arguments are
        // emitted or the expression would be evaluated a second time, at the wrong moment.
        let captured: Int = self.old_slot_for(node);
        if captured >= 0 {
            let held: String = self.fresh();
            let loaded: Int = self.write_body("  " + held + " = load i64, ptr %old"
                                     + to_string(captured) + "\n");
            return held;
        }
        // The callee is found BEFORE its arguments are emitted, because each argument has to be
        // emitted AGAINST its declared parameter type: a concrete value passed where an interface is
        // wanted becomes a {data, vtable} pair, and only the declaration says which parameters want
        // one. It used to be looked up afterwards and every argument emitted with plain `emit_expr`,
        // which passed a class pointer where a fat pointer belonged — accepted by the checker and
        // segfaulting at run time. See tests/pass/dyn_param_takes_a_concrete_value.bx.
        let found_fn: Int = self.find_function(src, t.start, t.length);
        let mutable declared_params: Int = 0 - 1;
        if found_fn >= 0 {
            declared_params = self.functions[found_fn].parameters;
        }
        let mutable args: String = "";
        let mutable arg_values: [String] = [];
        let mutable i: Int = 0;
        while i < list.b {
            let want: Type = self.param_type_at(src, declared_params, i);
            let value: String = self.emit_value_for(src, want, self.children[list.a + i]);
            if i > 0 {
                args += ", ";
            }
            args += "i64 " + value;
            let kept: Int = push(arg_values, value);
            i += 1;
        }
        // A RECURSIVE call, in a function with a `decreases` measure: the measure must be strictly
        // smaller with these arguments than it was at entry. Checked BEFORE the call, because after
        // it the recursion has already happened — which is the difference between a guarantee and a
        // post-mortem.
        if self.measure_clause >= 0 {
            if span_equal(src, t.start, t.length, self.measure_owner) {
                let bounded: Int = self.check_measure_at_call(src, arg_values);
            }
        }
        if found_fn >= 0 {
            if flag_external(self.functions[found_fn].flags) == 1 {
                return self.emit_c_call(src, n, self.functions[found_fn]);
            }
        }
        let answers: Type = self.type_at(node);
        if self.is_aggregate_written(src, answers) {
            let storage: String = self.scratch(self.cells_of(src, answers));
            let mutable all: String = "ptr " + storage;
            if args != "" {
                all += ", " + args;
            }
            let dropped: String = self.fresh();
            let called_it: Int = self.write_body("  " + dropped + " = call i64 @"
                                        + substring(src, t.start, t.length)
                                        + self.call_suffix(src, t, n.a, node)
                                        + "(" + all + ")\n");
            let reg: String = self.fresh();
            let address: Int = self.write_body("  " + reg + " = ptrtoint ptr " + storage
                                      + " to i64\n");
            return reg;
        }
        let reg: String = self.fresh();
        let visited: Int = self.write_body("  " + reg + " = call i64 @" + substring(src, t.start,
                                  t.length) + self.call_suffix(src, t, n.a, node)
                                  + "(" + args + ")\n");
        return reg;
    }
    // Anything this slice does not cover is named rather than emitted wrongly.
    let complained: Int = self.complain_at(src, n.token,
        "the Burxt backend does not emit this expression yet");
    return "0";
}

// ---- statements --------------------------------------------------------------
// The return type an `external function` declared, read from the declaration itself.
function (mutable self: Unit) extern_return(src: String, signature: DeclaredFunction) -> Type {
    let mutable i: Int = 0;
    while i < len(self.items) {
        let item: Node = self.nodes[self.items[i]];
        if item.kind == 86 {
            let named: Token = self.tokens[item.token];
            if spans_equal(src, named.start, named.length, signature.start, signature.length) {
                return self.declared_type(src, item.b);
            }
        }
        i += 1;
    }
    return signature.return_type;
}

// A call into C. Every Burxt value is an i64 here, and C's types are not, so each
// argument is cast at the boundary and the answer is cast back — which is the only place
// in the emitter where a value changes representation rather than meaning.
function (mutable self: Unit) emit_c_call(src: String, n: Node, signature: DeclaredFunction) -> String {
    let list: Node = self.nodes[n.a];
    let params: Node = self.nodes[signature.parameters];
    let mutable args: String = "";
    let mutable i: Int = 0;
    while i < list.b {
        let value: String = self.emit_expr(src, self.children[list.a + i]);
        let mutable want: Type = simple_type(40);
        if i < params.b {
            want = self.declared_type(src, self.nodes[self.children[params.a + i]].a);
        }
        let shape: String = c_type_of(want);
        let mutable passed: String = value;
        if shape == "ptr" {
            let as_ptr: String = self.fresh();
            let cast: Int = self.write_body("  " + as_ptr + " = inttoptr i64 " + value + " to ptr\n");
            passed = as_ptr;
        }
        if shape == "i32" {
            // Narrow, widen back, and compare. `trunc` silently keeps the low 32 bits, so
            // 4294967296 arrives in C as 0 — a wrong answer that looks like a valid one, and the
            // exact class of silent corruption this language exists to refuse.
            //
            // Real instructions rather than a constant expression: LLVM 18 no longer accepts a
            // `sext` constexpr, and the round trip reads more plainly anyway.
            let narrow: String = self.fresh();
            let cast: Int = self.write_body("  " + narrow + " = trunc i64 " + value + " to i32\n");
            let widened: String = self.fresh();
            let back: Int = self.write_body("  " + widened + " = sext i32 " + narrow
                                   + " to i64\n");
            let refused: Int = self.check_or_die("eq", value, widened,
                "burxt runtime error: this value does not fit in a C int — the external "
                + "parameter is 32-bit\n");
            passed = narrow;
        }
        if i > 0 {
            args += ", ";
        }
        args += shape + " " + passed;
        i += 1;
    }

    // C's DECLARED return, not the one the checker recorded. The checker maps a CInt
    // return to Int, because a Burxt caller receives an Int — but the call instruction
    // must name the width C actually returns, or the upper 32 bits are read as data.
    // `strcmp` answering -1 came back as 4294967295 until this looked at the declaration.
    let shape: String = c_type_of(self.extern_return(src, signature));
    let answer: String = self.fresh();
    let called: Int = self.write_body("  " + answer + " = call " + shape + " @"
        + substring(src, signature.start, signature.length) + "(" + args + ")\n");
    if shape == "i32" {
        // Sign-extended, not zero-extended: a C function that answers -1 means -1.
        let widened: String = self.fresh();
        let ext: Int = self.write_body("  " + widened + " = sext i32 " + answer + " to i64\n");
        return widened;
    }
    // A CPointer comes back as a real `ptr` and every Burxt value here is an i64, so it is carried
    // as an integer — which costs nothing, because Burxt can do nothing with it either way. This
    // arm was unreachable until v0.0.196: before the pointer wall opened, no external could return
    // one.
    if shape == "ptr" {
        let as_int: String = self.fresh();
        let cast: Int = self.write_body("  " + as_int + " = ptrtoint ptr " + answer + " to i64\n");
        return as_int;
    }
    return answer;
}

// One piece of an interpolation, as a String. A String piece is itself; anything else is
// rendered the way `to_string` would render it, because interpolation IS `to_string`.
function (mutable self: Unit) emit_piece(src: String, node: Int) -> String {
    let value: String = self.emit_expr(src, node);
    let shown: Type = self.type_at(node);
    if shown.kind == 42 {
        return value;
    }
    let reg: String = self.fresh();
    if shown.kind == 45 {
        let format: String = self.decimal_format(shown.scale);
        let called: Int = self.write_body("  " + reg + " = call i64 @burxt.to_string_dec(i64 "
            + value + ", i64 " + to_string(power_of_ten(shown.scale)) + ", ptr "
            + format + ")\n");
        return reg;
    }
    if shown.kind == 41 {
        let bit: String = self.fresh();
        let tested: Int = self.write_body("  " + bit + " = icmp ne i64 " + value + ", 0\n");
        let chosen: Int = self.write_body("  " + reg + " = select i1 " + bit
            + ", i64 ptrtoint (ptr getelementptr inbounds (\{ i64, [5 x i8] \}, ptr @burxt.string_true, i32 0, i32 1) to i64), i64 ptrtoint (ptr getelementptr inbounds (\{ i64, [6 x i8] \}, ptr @burxt.string_false, i32 0, i32 1) to i64)\n");
        return reg;
    }
    let called: Int = self.write_body("  " + reg + " = call i64 @burxt.to_string_int(i64 " + value
                             + ")\n");
    return reg;
}

// The builtins with a runtime helper behind them, and the ones that are a single
// instruction. Anything else is refused by name.
// `memcpy` of a whole aggregate. Burxt passes and stores aggregates BY VALUE, so this
// is where that promise is kept: a copy at the point a copy is meant, and nowhere else.
// Field-by-field equality for a class, as an i64 that is 0 or 1.
//
// A class value is an ADDRESS here, and its fields are i64 cells at offsets — so each field is one
// getelementptr and one load, compared according to its own type.
//
// NOT a cell-by-cell memcmp, and that is the whole of the work: a String field holds a POINTER, and
// two equal strings need not live at the same address. Comparing the cells would answer false for two
// accounts with the same owner built separately — the same bug the String path above records, one
// level down.
//
// Ands the field results rather than branching: a class has a handful of fields, each comparison is a
// few instructions, and a branch per field would cost more to emit than it could ever save.
function (mutable self: Unit) class_equal(src: String, holder: Type, left: String,
                                right: String) -> String {
    let found: Int = self.find_type(src, holder.name_start, holder.name_length);
    if found < 0 {
        return "0";
    }
    let item: Node = self.nodes[self.types[found].node];
    let restore: Int = self.bind_from_application(src, holder);
    let left_ptr: String = self.fresh();
    let cast_l: Int = self.write_body("  " + left_ptr + " = inttoptr i64 " + left + " to ptr\n");
    let right_ptr: String = self.fresh();
    let cast_r: Int = self.write_body("  " + right_ptr + " = inttoptr i64 " + right + " to ptr\n");
    let mutable all: String = "1";
    let mutable offset: Int = 0;
    let mutable f: Int = 0;
    while f < item.b {
        let field: Node = self.nodes[self.children[item.a + f]];
        let held: Type = self.resolve_shallow(src, self.declared_type(src, field.a));
        let at_l: String = self.fresh();
        let step_l: Int = self.write_body("  " + at_l + " = getelementptr i64, ptr " + left_ptr
                                 + ", i64 " + to_string(offset) + "\n");
        let at_r: String = self.fresh();
        let step_r: Int = self.write_body("  " + at_r + " = getelementptr i64, ptr " + right_ptr
                                 + ", i64 " + to_string(offset) + "\n");
        let mutable one: String = "1";
        if held.kind == 46 {
            // A nested class is stored INLINE — its cells sit right here, so the cell at this offset
            // is its FIRST FIELD and not a pointer to it. The address is what the recursion wants.
            //
            // Loading it instead was the first version, and it segfaulted immediately: for
            // `Named { label, at: Point, ... }` it read `at.x` and used the integer 1 as an address.
            // The lesson is the ABI, not the bug — an aggregate's value IS its address here, and a
            // FIELD of aggregate type is its cells rather than a reference to them.
            let addr_l: String = self.fresh();
            let cast_al: Int = self.write_body("  " + addr_l + " = ptrtoint ptr " + at_l
                                      + " to i64\n");
            let addr_r: String = self.fresh();
            let cast_ar: Int = self.write_body("  " + addr_r + " = ptrtoint ptr " + at_r
                                      + " to i64\n");
            one = self.class_equal(src, held, addr_l, addr_r);
        } else {
            let val_l: String = self.fresh();
            let load_l: Int = self.write_body("  " + val_l + " = load i64, ptr " + at_l + "\n");
            let val_r: String = self.fresh();
            let load_r: Int = self.write_body("  " + val_r + " = load i64, ptr " + at_r + "\n");
            if held.kind == 42 {
                let order: String = self.fresh();
                let compared: Int = self.write_body("  " + order
                                           + " = call i64 @burxt.strcmp(i64 " + val_l + ", i64 "
                                           + val_r + ")\n");
                let bit: String = self.fresh();
                let tested: Int = self.write_body("  " + bit + " = icmp eq i64 " + order
                                         + ", 0\n");
                one = self.fresh();
                let widened: Int = self.write_body("  " + one + " = zext i1 " + bit + " to i64\n");
            } else {
                // Int, Bool and a Decimal of equal scale are all one i64 cell, and a scaled decimal
                // compares exactly as a plain integer — no rescaling, no rounding, no float.
                let bit: String = self.fresh();
                let tested: Int = self.write_body("  " + bit + " = icmp eq i64 " + val_l + ", "
                                         + val_r + "\n");
                one = self.fresh();
                let widened: Int = self.write_body("  " + one + " = zext i1 " + bit + " to i64\n");
            }
        }
        let combined: String = self.fresh();
        let anded: Int = self.write_body("  " + combined + " = mul i64 " + all + ", " + one + "\n");
        all = combined;
        offset += self.cells_of(src, held);
        f += 1;
    }
    let dropped: Int = truncate(self.type_bindings, restore);
    return all;
}

// The ADDRESS a place names, for the left of an assignment. Reading `x.f` loads from
// here; writing stores to here.
function (mutable self: Unit) place_of(src: String, node: Int) -> String {
    let n: Node = self.nodes[node];
    if n.kind == 11 {                                // x.f
        let holder: Type = self.type_at(n.a);
        let base: String = self.emit_expr(src, n.a);
        let offset: Int = self.offset_of(src, holder, self.tokens[n.token]);
        if offset < 0 {
            let complained: Int = self.complain_at(src, n.token, "no such field to write to");
            return "";
        }
        let as_ptr: String = self.fresh();
        let cast: Int = self.write_body("  " + as_ptr + " = inttoptr i64 " + base + " to ptr\n");
        let at: String = self.fresh();
        let stepped: Int = self.write_body("  " + at + " = getelementptr i64, ptr " + as_ptr
                                  + ", i64 " + to_string(offset) + "\n");
        return at;
    }
    if n.kind == 12 {                                // xs[i]
        let holder: Type = self.type_at(n.a);
        let base: String = self.emit_expr(src, n.a);
        let index: String = self.emit_expr(src, n.b);
        if holder.kind == 47 {
            let at: String = self.fresh();
            let found: Int = self.write_body("  " + at + " = call i64 @burxt.slot(i64 " + base
                                    + ", i64 " + index + ", i64 "
                                    + to_string(self.tokens[n.token].start) + ")\n");
            let as_ptr: String = self.fresh();
            let cast: Int = self.write_body("  " + as_ptr + " = inttoptr i64 " + at + " to ptr\n");
            return as_ptr;
        }
        if holder.kind != 48 {
            let complained: Int = self.complain_at(src, n.token,
                "the Burxt backend cannot write into this");
            return "";
        }
        let stride: Int = self.cells_of(src, self.declared_type(src, holder.scale));
        let checked: Int = self.write_body("  call void @burxt.bounds(i64 " + index + ", i64 "
                                  + to_string(holder.contract) + ", i64 "
                                  + to_string(self.tokens[n.token].start) + ")\n");
        let scaled: String = self.fresh();
        let multiplied: Int = self.write_body("  " + scaled + " = mul i64 " + index + ", "
                                     + to_string(stride) + "\n");
        let as_ptr: String = self.fresh();
        let cast: Int = self.write_body("  " + as_ptr + " = inttoptr i64 " + base + " to ptr\n");
        let at: String = self.fresh();
        let stepped: Int = self.write_body("  " + at + " = getelementptr i64, ptr " + as_ptr
                                  + ", i64 " + scaled + "\n");
        return at;
    }
    let complained: Int = self.complain_at(src, n.token, "this is not something to assign to");
    return "";
}

// Where a variant sits in its enum's declaration — that position IS the tag, so the two
// compilers agree on it without recording anything: the declaration is the shared fact.
// -1 when the name is not a variant of this enum.
function (mutable self: Unit) variant_index(src: String, holder: Type, name: Token) -> Int {
    let found: Int = self.find_type(src, holder.name_start, holder.name_length);
    if found < 0 {
        return -1;
    }
    let decl: TypeDeclaration = self.types[found];
    if decl.kind != 83 {
        return -1;
    }
    let item: Node = self.nodes[decl.node];
    let mutable v: Int = 0;
    while v < item.b {
        let variant: Node = self.nodes[self.children[item.a + v]];
        let named: Token = self.tokens[variant.token];
        if spans_equal(src, named.start, named.length, name.start, name.length) {
            return v;
        }
        v += 1;
    }
    return -1;
}

// `Enum.Variant` or `Enum.Variant(payload)`: the tag in cell 0, the payload after it.
function (mutable self: Unit) emit_construction(src: String, holder: Type, call: Node,
                                      has_args: Bool) -> String {
    let tag: Int = self.variant_index(src, holder, self.tokens[call.token]);
    let storage: String = self.scratch(self.cells_of(src, holder));
    let stored: Int = self.write_body("  store i64 " + to_string(tag) + ", ptr " + storage + "\n");

    if has_args {
        let list: Node = self.nodes[call.b];
        let mutable cell: Int = 1;
        let mutable i: Int = 0;
        while i < list.b {
            let value: String = self.emit_expr(src, self.children[list.a + i]);
            let at: String = self.fresh();
            let stepped: Int = self.write_body("  " + at + " = getelementptr i64, ptr " + storage
                                      + ", i64 " + to_string(cell) + "\n");
            let payload_ty: Type = self.type_at(self.children[list.a + i]);
            let width: Int = self.cells_of(src, payload_ty);
            if self.is_aggregate_written(src, payload_ty) {
                let copied: Int = self.copy_cells(src, at, value, width);
            } else {
                let put: Int = self.write_body("  store i64 " + value + ", ptr " + at + "\n");
            }
            cell += width;
            i += 1;
        }
    }
    let reg: String = self.fresh();
    let address: Int = self.write_body("  " + reg + " = ptrtoint ptr " + storage + " to i64\n");
    return reg;
}

// A method's symbol: the receiver's type, a dot, the method's name. Two types may both
// have a `label`, and the linker needs to tell them apart.
// `Account.open(...)` — the same shape as a method call with the receiver taken out. The symbol is
// still qualified, because that is what the definition emitted, and an aggregate answer still
// travels through the caller's storage, because that is about the RETURN and not about `self`.
//
// The holder is built from the base node's own token rather than from `type_at`, which is the whole
// reason this is a separate path: `Account` on its own has no type, and asking for one is what used
// to fail here.
function (mutable self: Unit) emit_associated_call(src: String, node: Int, n: Node) -> String {
    let base: Node = self.nodes[n.a];
    let named: Token = self.tokens[base.token];
    let holder: Type = Type { kind: 46, scale: 0, contract: 0,
                          name_start: named.start, name_length: named.length };
    let list: Node = self.nodes[n.b];
    // Against the associated function's declared parameters — a constructor taking an interface is
    // the same crossing as any other. Found by the two-span lookup, exactly as the checker found it.
    let found: Int = self.find_method_named(src, named.start, named.length,
                         self.tokens[n.token].start, self.tokens[n.token].length);
    let mutable declared_params: Int = 0 - 1;
    if found >= 0 {
        declared_params = self.methods[found].parameters;
    }
    let mutable args: String = "";
    let mutable k: Int = 0;
    while k < list.b {
        let want: Type = self.param_type_at(src, declared_params, k);
        let value: String = self.emit_value_for(src, want, self.children[list.a + k]);
        if k > 0 {
            args += ", ";
        }
        args += "i64 " + value;
        k += 1;
    }
    let answers: Type = self.type_at(node);
    let symbol: String = method_symbol(src, holder, self.tokens[n.token])
        + self.holder_suffix(src, holder);
    let seen: Int = self.note_holder(src, holder);
    if self.is_aggregate_written(src, answers) {
        let storage: String = self.scratch(self.cells_of(src, answers));
        let dropped: String = self.fresh();
        let mutable handed: String = "ptr " + storage;
        if len(args) > 0 {
            handed += ", " + args;
        }
        let called_it: Int = self.write_body("  " + dropped + " = call i64 @" + symbol
                                    + "(" + handed + ")\n");
        let reg: String = self.fresh();
        let address: Int = self.write_body("  " + reg + " = ptrtoint ptr " + storage
                                  + " to i64\n");
        return reg;
    }
    let reg: String = self.fresh();
    let visited: Int = self.write_body("  " + reg + " = call i64 @" + symbol
                              + "(" + args + ")\n");
    return reg;
}

function method_symbol(src: String, holder: Type, name: Token) -> String {
    return substring(src, holder.name_start, holder.name_length) + "."
        + substring(src, name.start, name.length);
}

function (mutable self: Unit) copy_cells(src: String, destination: String, source: String,
                               cells: Int) -> Int {
    let from: String = self.fresh();
    let cast: Int = self.write_body("  " + from + " = inttoptr i64 " + source + " to ptr\n");
    return self.write_body("  call ptr @memcpy(ptr " + destination + ", ptr " + from + ", i64 "
                  + to_string(cells * 8) + ")\n");
}

// A Decimal printed exactly: the sign, the integer part, and the fraction zero-padded to
// the scale. The work happens in i128 because negating the most negative i64 does not fit
// in an i64 — the one value where taking an absolute value is not free.
//
// Scale 0 prints NO decimal point: showing ".0" would display a digit that does not exist.
// The printf format for a Decimal of this scale. Scale 0 prints no decimal point at all:
// showing ".0" would display a digit the value does not have.
function (mutable self: Unit) decimal_format(scale: Int) -> String {
    if scale == 0 {
        return self.intern_text("%s%llu");
    }
    return self.intern_text("%s%llu.%0" + to_string(scale) + "llu");
}

// `round(p, d)` where p and d are built from the operands. `shift` says how many powers
// of ten separate the exact result from the one the type asks for: positive means the
// product is too fine and must be divided down, negative means the dividend must be scaled
// up first. `dividing` picks which operand becomes the divisor.
function (mutable self: Unit) emit_rounded(left: String, right: String, shift: Int, contract: Int,
                                 dividing: Int) -> String {
    let lw: String = self.fresh();
    let w1: Int = self.write_body("  " + lw + " = sext i64 " + left + " to i128\n");
    let rw: String = self.fresh();
    let w2: Int = self.write_body("  " + rw + " = sext i64 " + right + " to i128\n");

    let mutable numerator: String = "";
    let mutable divisor: String = "";
    if dividing == 1 {
        divisor = rw;
        if shift < 0 {
            let scaled: String = self.fresh();
            let up: Int = self.write_body("  " + scaled + " = mul i128 " + lw + ", "
                                 + to_string(power_of_ten(0 - shift)) + "\n");
            numerator = scaled;
        } else {
            numerator = lw;
        }
    } else {
        let product: String = self.fresh();
        let mul: Int = self.write_body("  " + product + " = mul i128 " + lw + ", " + rw + "\n");
        if shift < 0 {
            // The answer's scale is WIDER than the exact product's, so nothing rounds:
            // widening is multiplication by a power of ten and it is lossless. Sending it
            // through the rounding helper would divide by 10^0 and leave the value at the
            // wrong scale — `0.05 * 0.5` in a Decimal<6> printed as 0.000025.
            let widened: String = self.fresh();
            let up: Int = self.write_body("  " + widened + " = mul i128 " + product + ", "
                                 + to_string(power_of_ten(0 - shift)) + "\n");
            let reg: String = self.fresh();
            let narrowed: Int = self.write_body("  " + reg + " = trunc i128 " + widened
                                       + " to i64\n");
            return reg;
        }
        if shift == 0 {
            // The answer is exactly as wide as the product, so the product IS the answer
            // and there is nothing to round — which is why the checker asks for no
            // contract here. Dividing by 10^0 would give the same value; saying so
            // directly skips a call and matches the IR stage-0 emits.
            let reg: String = self.fresh();
            let narrowed: Int = self.write_body("  " + reg + " = trunc i128 " + product
                                       + " to i64\n");
            return reg;
        }
        numerator = product;
        divisor = to_string(power_of_ten(shift));
    }

    let mutable mode: String = "half_up";
    if contract == 1 { mode = "half_even"; }
    let wide: String = self.fresh();
    let called: Int = self.write_body("  " + wide + " = call i128 @burxt.round." + mode
                             + "(i128 " + numerator + ", i128 " + divisor + ")\n");
    // Back to an i64, and CHECKED on the way. The comment here used to say the arithmetic helpers
    // already raise this — they do not: they guard `+`, `-` and `*` on Ints, and nothing guarded
    // this narrowing. A product too large for the declared scale wrapped and printed a negative
    // number, which is the one thing a money type must never do.
    //
    // Narrow, widen back, compare — the same round trip the C-int boundary uses, for the same
    // reason: `trunc` keeps the low bits and says nothing.
    let reg: String = self.fresh();
    let narrowed: Int = self.write_body("  " + reg + " = trunc i128 " + wide + " to i64\n");
    let again: String = self.fresh();
    let widened: Int = self.write_body("  " + again + " = sext i64 " + reg + " to i128\n");
    let same: String = self.fresh();
    let compared: Int = self.write_body("  " + same + " = icmp eq i128 " + wide + ", " + again
                               + "\n");
    let ok: String = self.fresh_label("fits.ok");
    let over: String = self.fresh_label("fits.over");
    let branched: Int = self.write_body("  br i1 " + same + ", label %" + ok + ", label %"
                               + over + "\n");
    let opened: Int = self.write_body(over + ":\n");
    // A FRESH register, not "%oerr" glued to one that already carries its sigil — that produced
    // `%oerr%t7`, which llc reads as an instruction name and refuses.
    let stream: String = self.fresh();
    let told: Int = self.write_body("  " + stream + " = load ptr, ptr @stderr\n");
    let printed: Int = self.write_body("  call i32 (ptr, ptr, ...) @fprintf(ptr " + stream
                              + ", ptr @burxt.overflow_msg)\n");
    let stopped: Int = self.write_body("  call void @exit(i32 70)\n");
    let dead: Int = self.write_body("  unreachable\n");
    let resumed: Int = self.write_body(ok + ":\n");
    return reg;
}

function (mutable self: Unit) emit_decimal_print(value: String, scale: Int) -> Int {
    let wide: String = self.fresh();
    let widened: Int = self.write_body("  " + wide + " = sext i64 " + value + " to i128\n");
    let negative: String = self.fresh();
    let tested: Int = self.write_body("  " + negative + " = icmp slt i64 " + value + ", 0\n");
    let flipped: String = self.fresh();
    let negated: Int = self.write_body("  " + flipped + " = sub i128 0, " + wide + "\n");
    let magnitude: String = self.fresh();
    let chosen: Int = self.write_body("  " + magnitude + " = select i1 " + negative + ", i128 "
                             + flipped + ", i128 " + wide + "\n");
    let sign: String = self.fresh();
    let signed: Int = self.write_body("  " + sign + " = select i1 " + negative
        + ", ptr getelementptr inbounds (\{ i64, [2 x i8] \}, ptr @burxt.string_minus, i32 0, i32 1), ptr getelementptr inbounds (\{ i64, [1 x i8] \}, ptr @burxt.string_empty, i32 0, i32 1)\n");

    if scale == 0 {
        let whole: String = self.fresh();
        let narrowed: Int = self.write_body("  " + whole + " = trunc i128 " + magnitude + " to i64\n");
        let format: String = self.decimal_format(0);
        return self.write_body("  call i32 (ptr, ...) @printf(ptr " + format + ", ptr " + sign
                      + ", i64 " + whole + ")\n");
    }

    let power: String = to_string(power_of_ten(scale));
    let whole_wide: String = self.fresh();
    let divided: Int = self.write_body("  " + whole_wide + " = udiv i128 " + magnitude + ", "
                              + power + "\n");
    let frac_wide: String = self.fresh();
    let remained: Int = self.write_body("  " + frac_wide + " = urem i128 " + magnitude + ", "
                               + power + "\n");
    let whole: String = self.fresh();
    let n1: Int = self.write_body("  " + whole + " = trunc i128 " + whole_wide + " to i64\n");
    let frac: String = self.fresh();
    let n2: Int = self.write_body("  " + frac + " = trunc i128 " + frac_wide + " to i64\n");
    let format: String = self.decimal_format(scale);
    return self.write_body("  call i32 (ptr, ...) @printf(ptr " + format + ", ptr " + sign
                  + ", i64 " + whole + ", i64 " + frac + ")\n");
}

function (mutable self: Unit) emit_builtin(src: String, n: Node, called: String) -> String {
    let list: Node = self.nodes[n.a];
    let mutable first: String = "0";
    let mutable second: String = "0";
    let mutable third: String = "0";
    if list.b > 0 { first = self.emit_expr(src, self.children[list.a]); }
    if list.b > 1 { second = self.emit_expr(src, self.children[list.a + 1]); }
    if list.b > 2 { third = self.emit_expr(src, self.children[list.a + 2]); }
    let reg: String = self.fresh();

    if called == "to_string" {
        let held: Type = self.type_at(self.children[list.a]);
        if held.kind == 45 {                         // a Decimal renders with its scale
            let format: String = self.decimal_format(held.scale);
            let visited: Int = self.write_body("  " + reg + " = call i64 @burxt.to_string_dec(i64 "
                + first + ", i64 " + to_string(power_of_ten(held.scale)) + ", ptr "
                + format + ")\n");
            return reg;
        }
        if self.type_at(self.children[list.a]).kind == 41 {
            // A Bool renders to one of two literals, which is why it needs no region.
            let bit: String = self.fresh();
            let tested: Int = self.write_body("  " + bit + " = icmp ne i64 " + first + ", 0\n");
            let chosen: Int = self.write_body("  " + reg + " = select i1 " + bit
                + ", i64 ptrtoint (ptr getelementptr inbounds (\{ i64, [5 x i8] \}, ptr @burxt.string_true, i32 0, i32 1) to i64), i64 ptrtoint (ptr getelementptr inbounds (\{ i64, [6 x i8] \}, ptr @burxt.string_false, i32 0, i32 1) to i64)\n");
            return reg;
        }
        let visited: Int = self.write_body("  " + reg + " = call i64 @burxt.to_string_int(i64 "
                                  + first + ")\n");
        return reg;
    }
    if called == "len" {
        let held: Type = self.type_at(self.children[list.a]);
        if held.kind == 42 {
            let visited: Int = self.write_body("  " + reg + " = call i64 @burxt.len_str(i64 "
                                      + first + ")\n");
            return reg;
        }
        if held.kind == 47 {
            let visited: Int = self.write_body("  " + reg + " = call i64 @burxt.array_len(i64 "
                                      + first + ")\n");
            return reg;
        }
        if held.kind == 48 {
            // A fixed array's length is part of its type, so it is known here and
            // costs no instruction at all.
            return to_string(held.contract);
        }
        let complained: Int = self.complain_at(src, n.token, "the Burxt backend cannot take this len");
        return "0";
    }
    if called == "push" {
        let visited: Int = self.write_body("  " + reg + " = call i64 @burxt.push(i64 " + first
                                  + ", i64 " + second + ")\n");
        return reg;
    }
    if called == "truncate" {
        let visited: Int = self.write_body("  " + reg + " = call i64 @burxt.truncate(i64 " + first
                                  + ", i64 " + second + ")\n");
        return reg;
    }
    if called == "byte_at" {
        let visited: Int = self.write_body("  " + reg + " = call i64 @burxt.byte_at(i64 " + first
                                  + ", i64 " + second + ")\n");
        return reg;
    }
    if called == "substring" {
        let visited: Int = self.write_body("  " + reg + " = call i64 @burxt.substring(i64 " + first
                                  + ", i64 " + second + ", i64 " + third + ")\n");
        return reg;
    }
    if called == "argument_count" {
        let visited: Int = self.write_body("  " + reg + " = call i64 @burxt.argument_count()\n");
        return reg;
    }
    if called == "argument" {
        let visited: Int = self.write_body("  " + reg + " = call i64 @burxt.argument(i64 " + first + ")\n");
        return reg;
    }
    // `c_is_null(p)` is one integer comparison: a Bool is an i64 0/1 here, so the zext is the
    // whole conversion.
    if called == "c_is_null" {
        let flag: String = self.fresh();
        let compared: Int = self.write_body("  " + flag + " = icmp eq i64 " + first + ", 0\n");
        let widened: String = self.fresh();
        let ext: Int = self.write_body("  " + widened + " = zext i1 " + flag + " to i64\n");
        return widened;
    }
    if called == "c_string_at" {
        let answer: String = self.fresh();
        let visited: Int = self.write_body("  " + answer
            + " = call i64 @burxt.c_string_at(i64 " + first + ")\n");
        return answer;
    }
    if called == "read_file" {
        let visited: Int = self.write_body("  " + reg + " = call i64 @burxt.read_file(i64 " + first
                                  + ")\n");
        return reg;
    }
    if called == "hash" {
        // Which helper depends on the ARGUMENT's type, not the result's: a String hashes its
        // bytes and a scalar hashes its value, and they are two functions rather than one with a
        // branch because the argument arrives as a different kind of thing.
        let of_what: Type = self.type_at(self.children[self.nodes[n.a].a]);
        let mutable which: String = "burxt.hash_int";
        if of_what.kind == 42 {
            which = "burxt.hash_str";
        }
        let visited: Int = self.write_body("  " + reg + " = call i64 @" + which + "(i64 "
                                  + first + ")\n");
        return reg;
    }
    if called == "write_bytes" {
        let visited: Int = self.write_body("  " + reg + " = call i64 @burxt.write_bytes(i64 "
                                  + first + ", i64 " + second + ")\n");
        return reg;
    }
    if called == "write_file" {
        let visited: Int = self.write_body("  " + reg + " = call i64 @burxt.write_file(i64 " + first
                                  + ", i64 " + second + ")\n");
        return reg;
    }
    if called == "divide_toward_zero" {
        let visited: Int = self.write_body("  " + reg + " = sdiv i64 " + first + ", " + second + "\n");
        return reg;
    }
    if called == "remainder" {
        // Through a helper, because `srem` by zero is undefined behaviour in LLVM — it traps on
        // x86 and the program dies with SIGFPE and no message. A named error beats a signal.
        let visited: Int = self.write_body("  " + reg + " = call i64 @burxt.remainder(i64 " + first
                                  + ", i64 " + second + ")\n");
        return reg;
    }
    if called == "divide_floor" {
        let visited: Int = self.write_body("  " + reg + " = call i64 @burxt.divide_floor(i64 " + first
                                  + ", i64 " + second + ")\n");
        return reg;
    }
    let complained: Int = self.complain_at(src, n.token,
        "the Burxt backend does not emit `" + called + "` yet");
    return "0";
}

function (mutable self: Unit) emit_stmt(src: String, node: Int) -> Int {
    let n: Node = self.nodes[node];

    if n.kind == 60 {                                // let
        let name: Token = self.tokens[n.token];
        // The DECLARED type, not the value's: `let d: dynamic Priced = book;` stores an interface
        // object, and the coercion happens here or nowhere.
        let mutable declared: Type = self.type_at(n.b);
        if n.a >= 0 {
            declared = self.declared_type(src, n.a);
        }
        let value: String = self.emit_value_for(src, declared, n.b);
        let cells: Int = self.cells_of(src, declared);
        if self.is_aggregate_written(src, declared) {
            // The binding gets its OWN storage and a copy: `let a: S = b` then changing
            // `b.f` must not change `a.f`, which is what by-value means.
            let slot: Int = self.declare_slot(src, name.start, name.length, cells, 1);
            return self.copy_cells(src, "%v" + to_string(slot), value, cells);
        }
        let slot: Int = self.declare_slot(src, name.start, name.length, 1, 0);
        return self.write_body("  store i64 " + value + ", ptr %v" + to_string(slot) + "\n");
    }

    if n.kind == 61 {                                // assignment
        let target: Node = self.nodes[n.a];
        let into: Type = self.type_at(n.a);
        let value: String = self.emit_value_for(src, into, n.b);
        if target.kind == 5 {                        // a name
            let name: Token = self.tokens[target.token];
            let slot: Int = self.find_slot(src, name.start, name.length);
            if self.is_aggregate_written(src, into) {
                return self.copy_cells(src, "%v" + to_string(slot), value,
                                       self.cells_of(src, into));
            }
            return self.write_body("  store i64 " + value + ", ptr %v" + to_string(slot) + "\n");
        }
        // A place, not a name: `x.f = v` and `xs[i] = v`. The address is computed the
        // same way reading them does, so the two cannot drift apart.
        let at: String = self.place_of(src, n.a);
        if at == "" {
            return 0;
        }
        if self.is_aggregate_written(src, into) {
            return self.copy_cells(src, at, value, self.cells_of(src, into));
        }
        return self.write_body("  store i64 " + value + ", ptr " + at + "\n");
    }

    if n.kind == 62 {                                // print
        let printed_node: Node = self.nodes[n.a];
        if printed_node.kind == 18 {
            // Pieces in order, then one newline. No join means no allocation, which is
            // why `print("a {b}")` needs no region while `let s = "a {b}"` does.
            let mutable piece_index: Int = 0;
            while piece_index < printed_node.b {
                let piece: String = self.emit_piece(src, self.children[printed_node.a + piece_index]);
                let as_ptr: String = self.fresh();
                let cast: Int = self.write_body("  " + as_ptr + " = inttoptr i64 " + piece
                                       + " to ptr\n");
                let out: Int = self.write_body("  call i32 (ptr, ...) @printf(ptr @burxt.fmt_str, "
                                      + "ptr " + as_ptr + ")\n");
                piece_index += 1;
            }
            return self.write_body("  call i32 (ptr, ...) @printf(ptr @burxt.fmt_nl)\n");
        }
        let shown: Type = self.type_at(n.a);
        let value: String = self.emit_expr(src, n.a);
        if shown.kind == 41 {                        // a Bool renders as a word
            let bit: String = self.fresh();
            let visited: Int = self.write_body("  " + bit + " = icmp ne i64 " + value + ", 0\n");
            let text: String = self.fresh();
            let chosen: Int = self.write_body("  " + text + " = select i1 " + bit
                                     + ", ptr getelementptr inbounds (\{ i64, [5 x i8] \}, ptr @burxt.string_true, i32 0, i32 1), ptr getelementptr inbounds (\{ i64, [6 x i8] \}, ptr @burxt.string_false, i32 0, i32 1)\n");
            let printed: Int = self.write_body("  call i32 (ptr, ...) @printf(ptr @burxt.fmt_str, ptr "
                                      + text + ")\n");
            return self.write_body("  call i32 (ptr, ...) @printf(ptr @burxt.fmt_nl)\n");
        }
        if shown.kind == 45 {                        // a Decimal
            let rendered: Int = self.emit_decimal_print(value, shown.scale);
            return self.write_body("  call i32 (ptr, ...) @printf(ptr @burxt.fmt_nl)\n");
        }
        if shown.kind == 42 {                        // a String
            let as_ptr: String = self.fresh();
            let cast: Int = self.write_body("  " + as_ptr + " = inttoptr i64 " + value + " to ptr\n");
            let printed: Int = self.write_body("  call i32 (ptr, ...) @printf(ptr @burxt.fmt_str, ptr "
                                      + as_ptr + ")\n");
            return self.write_body("  call i32 (ptr, ...) @printf(ptr @burxt.fmt_nl)\n");
        }
        let printed: Int = self.write_body("  call i32 (ptr, ...) @printf(ptr @burxt.fmt_int, i64 "
                                  + value + ")\n");
        return self.write_body("  call i32 (ptr, ...) @printf(ptr @burxt.fmt_nl)\n");
    }

    if n.kind == 64 {                                // return tail
        // `musttail` is the guarantee, not a hope: LLVM either replaces the frame or
        // refuses to compile. The checker already proved the signatures match, which is
        // exactly what LLVM requires of a musttail call.
        let value: Node = self.nodes[n.a];
        let target: Token = self.tokens[value.token];
        let list: Node = self.nodes[value.a];
        let mutable args: String = "";
        let mutable arg_values: [String] = [];
        let mutable i: Int = 0;
        while i < list.b {
            let argument: String = self.emit_expr(src, self.children[list.a + i]);
            if i > 0 {
                args += ", ";
            }
            args += "i64 " + argument;
            let kept: Int = push(arg_values, argument);
            i += 1;
        }
        // A tail call is still a recursive call, and it is the one that MUST be checked: `musttail`
        // reuses the frame, so a measure that does not shrink loops forever without even growing
        // the stack. `tests/panic/termination_does_not_decrease.bx` is exactly that program, and it
        // ran until a timeout killed it until this check existed.
        if self.measure_clause >= 0 {
            if span_equal(src, target.start, target.length, self.measure_owner) {
                let bounded: Int = self.check_measure_at_call(src, arg_values);
            }
        }
        let answer: String = self.fresh();
        let jumped: Int = self.write_body("  " + answer + " = musttail call i64 @"
            + substring(src, target.start, target.length)
            + self.call_suffix(src, target, value.a, n.a) + "(" + args + ")\n");
        return self.write_body("  ret i64 " + answer + "\n");
    }

    if n.kind == 63 {                                // return
        // Against the function's declared RETURN type, which is the fourth crossing: a function
        // answering `-> Priced` with a concrete value has to hand back a fat pointer.
        //
        // The NODE rather than a resolved Type, for the same reason `result_type_node` is a node —
        // a Type field would need a value in stage1.bx's Unit literal, and `declared_type` already
        // turns one into the other.
        let want: Type = self.declared_type(src, self.returns_node);
        let value: String = self.emit_value_for(src, want, n.a);
        if self.sret != "" {
            let copied: Int = self.copy_cells(src, self.sret, value, self.sret_cells);
            // No `ensures` here: the checker already refuses one on a function whose answer
            // travels through the caller's storage, because binding `result` to it needs care a
            // scalar does not.
            return self.write_body("  ret i64 0\n");
        }
        // `ensures` at EVERY return, not at one exit. Verified against stage-0, which fires on each
        // return path — a function with an early return has two places the promise must hold.
        let checked: Int = self.emit_ensures(src, value);
        return self.write_body("  ret i64 " + value + "\n");
    }

    if n.kind == 65 {                                // if
        let cond: String = self.emit_expr(src, n.a);
        let bit: String = self.fresh();
        let tested: Int = self.write_body("  " + bit + " = icmp ne i64 " + cond + ", 0\n");
        let then_label: String = self.fresh_label("if.then");
        let else_label: String = self.fresh_label("if.else");
        let end_label: String = self.fresh_label("if.end");
        let branched: Int = self.write_body("  br i1 " + bit + ", label %" + then_label
                                   + ", label %" + else_label + "\n");
        let opened: Int = self.write_body(then_label + ":\n");
        let then_body: Int = self.emit_block(src, n.b);
        let closed: Int = self.write_body("  br label %" + end_label + "\n" + else_label + ":\n");
        if n.c >= 0 {
            let else_body: Int = self.emit_block(src, n.c);
        }
        let joined: Int = self.write_body("  br label %" + end_label + "\n" + end_label + ":\n");
        return 1;
    }

    if n.kind == 66 {                                // while
        let cond_label: String = self.fresh_label("while.cond");
        let body_label: String = self.fresh_label("while.body");
        let end_label: String = self.fresh_label("while.end");
        let entered: Int = self.write_body("  br label %" + cond_label + "\n" + cond_label + ":\n");
        let cond: String = self.emit_expr(src, n.a);
        let bit: String = self.fresh();
        let tested: Int = self.write_body("  " + bit + " = icmp ne i64 " + cond + ", 0\n");
        let branched: Int = self.write_body("  br i1 " + bit + ", label %" + body_label
                                   + ", label %" + end_label + "\n" + body_label + ":\n");
        // A stack, because `break` inside a nested loop leaves the INNER one.
        push(self.loop_condition_labels, cond_label);
        push(self.loop_end_labels, end_label);
        let body: Int = self.emit_block(src, n.b);
        let dropped_cond: Int = truncate(self.loop_condition_labels, len(self.loop_condition_labels) - 1);
        let dropped_end: Int = truncate(self.loop_end_labels, len(self.loop_end_labels) - 1);
        return self.write_body("  br label %" + cond_label + "\n" + end_label + ":\n");
    }

    if n.kind == 72 {                                // for x in xs
        let holder: Type = self.type_at(n.a);
        let element: Type = self.declared_type(src, holder.scale);
        let name: Token = self.tokens[n.token];
        // The index has no name in the program, so it gets scratch storage rather than a
        // named slot: nothing can refer to it, and nothing should be able to.
        let counter: String = self.scratch(1);
        let zeroed: Int = self.write_body("  store i64 0, ptr " + counter + "\n");

        let cond_label: String = self.fresh_label("for.cond");
        let body_label: String = self.fresh_label("for.body");
        let end_label: String = self.fresh_label("for.end");
        let entered: Int = self.write_body("  br label %" + cond_label + "\n" + cond_label + ":\n");
        let i: String = self.fresh();
        let read: Int = self.write_body("  " + i + " = load i64, ptr " + counter + "\n");
        // The array is re-read in the condition, so a growable one that changed length
        // would be seen — the same as the `while i < len(xs)` this replaces.
        let base: String = self.emit_expr(src, n.a);
        let mutable bound: String = to_string(holder.contract);
        if holder.kind == 47 {
            let as_ptr: String = self.fresh();
            let cast: Int = self.write_body("  " + as_ptr + " = inttoptr i64 " + base
                                   + " to ptr\n");
            let counted: String = self.fresh();
            let loaded: Int = self.write_body("  " + counted + " = load i64, ptr " + as_ptr
                                     + "\n");
            bound = counted;
        }
        let bit: String = self.fresh();
        let tested: Int = self.write_body("  " + bit + " = icmp slt i64 " + i + ", " + bound
                                 + "\n");
        let branched: Int = self.write_body("  br i1 " + bit + ", label %" + body_label
                                   + ", label %" + end_label + "\n" + body_label
                                   + ":\n");

        // The element is copied into the binding's own storage, because a binding owns
        // what it holds — the same rule `let` follows.
        let value: String = self.emit_element(src, holder, base, i, n.token);
        let cells: Int = self.cells_of(src, element);
        if self.is_aggregate_written(src, element) {
            let slot: Int = self.declare_slot(src, name.start, name.length, cells, 1);
            let copied: Int = self.copy_cells(src, "%v" + to_string(slot), value, cells);
        } else {
            let slot: Int = self.declare_slot(src, name.start, name.length, 1, 0);
            let stored: Int = self.write_body("  store i64 " + value + ", ptr %v"
                                     + to_string(slot) + "\n");
        }
        // The advance comes BEFORE the body. `continue` jumps to the condition, so an
        // increment at the bottom would be skipped and the loop would never end.
        let next: String = self.fresh();
        let bumped: Int = self.write_body("  " + next + " = add i64 " + i + ", 1\n");
        let advanced: Int = self.write_body("  store i64 " + next + ", ptr " + counter + "\n");

        push(self.loop_condition_labels, cond_label);
        push(self.loop_end_labels, end_label);
        let body: Int = self.emit_block(src, n.b);
        let dropped_cond: Int = truncate(self.loop_condition_labels, len(self.loop_condition_labels) - 1);
        let dropped_end: Int = truncate(self.loop_end_labels, len(self.loop_end_labels) - 1);
        return self.write_body("  br label %" + cond_label + "\n" + end_label + ":\n");
    }

    if n.kind == 67 || n.kind == 68 {                // break, continue
        let depth: Int = len(self.loop_end_labels);
        if depth == 0 {
            return 0;
        }
        let mutable target: String = self.loop_end_labels[depth - 1];
        if n.kind == 68 {
            target = self.loop_condition_labels[depth - 1];
        }
        let jumped: Int = self.write_body("  br label %" + target + "\n");
        // The block after an unconditional branch needs a label, and nothing reaches it.
        let dead: String = self.fresh_label("after");
        return self.write_body(dead + ":\n");
    }

    if n.kind == 69 {                                // region
        // The mark IS the region: closing it releases every allocation at once.
        let mark: String = self.fresh();
        let saved: Int = self.write_body("  " + mark + " = load i64, ptr @burxt.bump\n");
        let body: Int = self.emit_block(src, n.a);
        return self.write_body("  store i64 " + mark + ", ptr @burxt.bump\n");
    }

    if n.kind == 71 {                                // match
        // A SCALAR match — on an Int, a String, a Bool or a Decimal. Not a tag comparison: a chain of
        // ordinary equalities against the literals, with the `_` arm as the tail. Emitted here rather
        // than desugared into nodes because the emitter builds IR directly and a chain IS the IR;
        // stage-0 desugars in its checker for the mirror-image reason, so that neither of ITS
        // backends learns a new statement kind.
        let scrutinee: Type = self.type_at(n.a);
        if scrutinee.kind == 40 || scrutinee.kind == 41 || scrutinee.kind == 42
           || scrutinee.kind == 45 {
            return self.emit_scalar_match(src, n, scrutinee);
        }
        // The value is an enum, so its first cell is the tag. Each arm is a comparison
        // against the variant's position in the declaration, and the arm's bindings are
        // the payload cells that follow. No jump table: a chain of comparisons is what a
        // reader would write, and LLVM turns a dense one into a switch anyway.
        let holder: Type = self.type_at(n.a);
        let subject: String = self.emit_expr(src, n.a);
        let as_ptr: String = self.fresh();
        let cast: Int = self.write_body("  " + as_ptr + " = inttoptr i64 " + subject + " to ptr\n");
        let tag: String = self.fresh();
        let loaded: Int = self.write_body("  " + tag + " = load i64, ptr " + as_ptr + "\n");
        let done: String = self.fresh_label("match.end");

        let mutable i: Int = 0;
        while i < n.c {
            let arm: Node = self.nodes[self.children[n.b + i]];
            let which: Int = self.variant_index(src, holder, self.tokens[arm.token]);
            let hit: String = self.fresh();
            let compared: Int = self.write_body("  " + hit + " = icmp eq i64 " + tag + ", "
                                       + to_string(which) + "\n");
            let body_label: String = self.fresh_label("match.arm");
            let next_label: String = self.fresh_label("match.next");
            let branched: Int = self.write_body("  br i1 " + hit + ", label %" + body_label
                                       + ", label %" + next_label + "\n"
                                       + body_label + ":\n");

            // The bindings name the payload cells, and leave scope with the arm.
            let base: Int = len(self.slots);
            let bound: Int = self.bind_payload(src, holder, arm, as_ptr);
            let body: Int = self.emit_block(src, arm.a);
            let dropped: Int = truncate(self.slots, base);

            let joined: Int = self.write_body("  br label %" + done + "\n" + next_label + ":\n");
            i += 1;
        }
        // Every variant has an arm — the checker proved it — so falling past the last
        // comparison is unreachable. LLVM still needs the block terminated.
        return self.write_body("  br label %" + done + "\n" + done + ":\n");
    }

    if n.kind == 70 {                                // an expression, for its effect
        let value: String = self.emit_expr(src, n.a);
        return 1;
    }

    let complained: Int = self.complain_at(src, n.token,
        "the Burxt backend does not emit this statement yet");
    return 0;
}

// A `match` on a scalar, as a chain of equalities.
//
// The subject is emitted ONCE and reused, which is not only cheaper: a subject with a side effect —
// `match next_row() { ... }` — evaluated per arm would run it as many times as there are arms, and a
// match that consumes four rows to test one is a wrong answer rather than a slow one.
//
// Strings compare through `burxt.strcmp` for the same reason `==` does: comparing the i64s would
// compare POINTERS, which is true only when two Strings are the same object.
function (mutable self: Unit) emit_scalar_match(src: String, n: Node, scrutinee: Type) -> Int {
    let subject: String = self.emit_expr(src, n.a);
    let done: String = self.fresh_label("match.end");
    let mutable i: Int = 0;
    while i < n.c {
        let arm: Node = self.nodes[self.children[n.b + i]];
        let pattern: Token = self.tokens[arm.token];
        let is_wildcard: Bool = pattern.kind == 1
                                && span_equal(src, pattern.start, pattern.length, "_");
        if is_wildcard {
            // The tail. The checker proved `_` is present and last, so nothing follows it.
            let body: Int = self.emit_block(src, arm.a);
            let joined: Int = self.write_body("  br label %" + done + "\n");
            i += 1;
        } else {
            let hit: String = self.fresh();
            if pattern.kind == 4 {
                let literal: String = self.intern(src, pattern.start + 1, pattern.length - 2);
                let order: String = self.fresh();
                let compared: Int = self.write_body("  " + order
                                           + " = call i64 @burxt.strcmp(i64 " + subject
                                           + ", i64 ptrtoint (ptr " + literal + " to i64))\n");
                let tested: Int = self.write_body("  " + hit + " = icmp eq i64 " + order
                                         + ", 0\n");
            } else {
                // An Int or Decimal literal is its own value; `true` is 1 and `false` is 0, which is
                // what a Bool already is in this ABI.
                let mutable literal: Int = pattern.value;
                if pattern.kind == 120 { literal = 1; }
                if pattern.kind == 121 { literal = 0; }
                let compared: Int = self.write_body("  " + hit + " = icmp eq i64 " + subject + ", "
                                           + to_string(literal) + "\n");
            }
            let body_label: String = self.fresh_label("match.arm");
            let next_label: String = self.fresh_label("match.next");
            let branched: Int = self.write_body("  br i1 " + hit + ", label %" + body_label
                                       + ", label %" + next_label + "\n"
                                       + body_label + ":\n");
            let body: Int = self.emit_block(src, arm.a);
            let joined: Int = self.write_body("  br label %" + done + "\n" + next_label + ":\n");
            i += 1;
        }
    }
    // The `_` arm terminated its own block, so this one is reached only when there was none — which
    // the checker refuses. LLVM still needs every block terminated.
    return self.write_body("  br label %" + done + "\n" + done + ":\n");
}

// An arm's bindings, pointing into the value being matched. A scalar payload is loaded
// into its own slot; an aggregate one is named by its address, exactly as any other
// aggregate is.
function (mutable self: Unit) bind_payload(src: String, holder: Type, arm: Node,
                                 base: String) -> Int {
    let found: Int = self.find_type(src, holder.name_start, holder.name_length);
    if found < 0 {
        return 0;
    }
    let item: Node = self.nodes[self.types[found].node];
    // The holder's type ARGUMENTS, in scope for the whole walk. A generic variant's payload is
    // written `T`, and without the binding it resolved to `T`: not an aggregate, so a `Point`
    // payload was loaded as if its first cell were an address. That segfaults rather than printing
    // something wrong, which is the better failure — and it is the same omission the field rule and
    // `cells_of` each had to learn.
    let restore: Int = self.bind_from_application(src, holder);
    let wanted: Token = self.tokens[arm.token];
    let mutable v: Int = 0;
    while v < item.b {
        let variant: Node = self.nodes[self.children[item.a + v]];
        let named: Token = self.tokens[variant.token];
        if spans_equal(src, named.start, named.length, wanted.start, wanted.length) {
            let mutable cell: Int = 1;
            let mutable p: Int = 0;
            while p < arm.c && p < variant.c {
                let name: Token = self.tokens[self.nested_children[arm.b + p]];
                let payload: Type = self.declared_type(src, self.nested_children[variant.b + p]);
                let width: Int = self.cells_of(src, payload);
                let at: String = self.fresh();
                let stepped: Int = self.write_body("  " + at + " = getelementptr i64, ptr " + base
                                          + ", i64 " + to_string(cell) + "\n");
                if self.is_aggregate_written(src, payload) {
                    let slot: Int = self.declare_slot(src, name.start, name.length, 1, 0);
                    let address: String = self.fresh();
                    let taken: Int = self.write_body("  " + address + " = ptrtoint ptr " + at
                                            + " to i64\n");
                    let put: Int = self.write_body("  store i64 " + address + ", ptr %v"
                                          + to_string(slot) + "\n");
                } else {
                    let slot: Int = self.declare_slot(src, name.start, name.length, 1, 0);
                    let value: String = self.fresh();
                    let read: Int = self.write_body("  " + value + " = load i64, ptr " + at + "\n");
                    let put: Int = self.write_body("  store i64 " + value + ", ptr %v"
                                          + to_string(slot) + "\n");
                }
                cell += width;
                p += 1;
            }
            let dropped: Int = truncate(self.type_bindings, restore);
            return 1;
        }
        v += 1;
    }
    let dropped: Int = truncate(self.type_bindings, restore);
    return 0;
}

function (mutable self: Unit) emit_block(src: String, block: Int) -> Int {
    if block < 0 {
        return 0;
    }
    let n: Node = self.nodes[block];
    if n.kind != 16 {
        return self.emit_stmt(src, block);
    }
    let mutable i: Int = 0;
    while i < n.b {
        let emitted: Int = self.emit_stmt(src, self.children[n.a + i]);
        i += 1;
    }
    return 1;
}

// ---- the module --------------------------------------------------------------
// The symbol naming an interface's table for one concrete type.
function vtable_symbol(src: String, trait_name: Token, type_name: Token) -> String {
    return "@burxt.vt." + substring(src, trait_name.start, trait_name.length) + "."
        + substring(src, type_name.start, type_name.length);
}

function (mutable self: Unit) emit_vtable(src: String, index: Int) -> Int {
    let item: Node = self.nodes[index];
    let trait_name: Token = self.tokens[item.token];
    let type_name: Token = self.tokens[item.c];
    let found: Int = self.find_type(src, trait_name.start, trait_name.length);
    if found < 0 {
        return 0;
    }
    let declared: Node = self.nodes[self.types[found].node];
    let mutable entries: String = "";
    let mutable i: Int = 0;
    while i < declared.b {
        let sig: Node = self.nodes[self.children[declared.a + i]];
        let named: Token = self.tokens[sig.token];
        if i > 0 {
            entries += ", ";
        }
        entries += "ptr @" + substring(src, type_name.start, type_name.length)
            + "." + substring(src, named.start, named.length);
        i += 1;
    }
    return self.write_module(vtable_symbol(src, trait_name, type_name) + " = constant ["
                      + to_string(declared.b) + " x ptr] [" + entries + "]\n");
}

// A concrete value becoming a `dynamic Trait`: the address in cell 0, the table in cell 1.
// This is the ONLY coercion in the language, and it happens where a value is STORED —
// a binding, a field, an argument, a return — never silently mid-expression.
function (mutable self: Unit) emit_dynamic(src: String, want: Type, node: Int) -> String {
    let concrete: Type = self.type_at(node);
    let value: String = self.emit_expr(src, node);
    if concrete.kind == 49 {
        return value;                                // already an interface object
    }
    let storage: String = self.scratch(2);
    let put_data: Int = self.write_body("  store i64 " + value + ", ptr " + storage + "\n");
    let table_cell: String = self.fresh();
    let stepped: Int = self.write_body("  " + table_cell + " = getelementptr i64, ptr " + storage
                              + ", i64 1\n");
    // The table is chosen by the CONCRETE type, here, at the one place the concrete type
    // is still known. After this the value has forgotten what it was.
    let table: String = "@burxt.vt." + substring(src, want.name_start, want.name_length) + "."
        + substring(src, concrete.name_start, concrete.name_length);
    let put_table: Int = self.write_body("  store i64 ptrtoint (ptr " + table + " to i64), ptr "
                                + table_cell + "\n");
    let reg: String = self.fresh();
    let address: Int = self.write_body("  " + reg + " = ptrtoint ptr " + storage + " to i64\n");
    return reg;
}

// Calling a method through an interface object: load the table, take the slot the interface gave
// this method, and call what is there with the DATA pointer as the receiver. The concrete
// type is not known here and does not need to be — that is what the indirection buys.
// A method call through an interface object. `answers` is the call's own type, handed in rather
// than looked up, because the caller holds the node index and this holds only the node.
//
// The aggregate return below was MISSING, and the program segfaulted: the call passed the
// receiver where the callee expected its `%sret` pointer, so a method returning a class
// wrote the answer through whatever the receiver happened to be. Stage-0 had the identical
// omission at the identical place — a vtable call that never learned what the direct call
// already knew — which is worth recording, because two independent implementations failing
// the same way at the same site says the fault is in how the shape was thought about rather
// than in either translation.
function (mutable self: Unit) emit_dynamic_call(src: String, holder: Type, call: Node,
                                                answers: Type) -> String {
    let fat: String = self.emit_expr(src, call.a);
    let base: String = self.fresh();
    let cast: Int = self.write_body("  " + base + " = inttoptr i64 " + fat + " to ptr\n");
    let data: String = self.fresh();
    let loaded: Int = self.write_body("  " + data + " = load i64, ptr " + base + "\n");
    let table_cell: String = self.fresh();
    let stepped: Int = self.write_body("  " + table_cell + " = getelementptr i64, ptr " + base
                              + ", i64 1\n");
    let table: String = self.fresh();
    let read: Int = self.write_body("  " + table + " = load i64, ptr " + table_cell + "\n");
    let table_ptr: String = self.fresh();
    let as_ptr: Int = self.write_body("  " + table_ptr + " = inttoptr i64 " + table + " to ptr\n");

    let slot: Int = self.trait_slot(src, holder, self.tokens[call.token]);
    let entry: String = self.fresh();
    let indexed: Int = self.write_body("  " + entry + " = getelementptr ptr, ptr " + table_ptr
                              + ", i64 " + to_string(slot) + "\n");
    let target: String = self.fresh();
    let fetched: Int = self.write_body("  " + target + " = load ptr, ptr " + entry + "\n");

    let list: Node = self.nodes[call.b];
    let mutable args: String = "i64 " + data;
    let mutable i: Int = 0;
    while i < list.b {
        let value: String = self.emit_expr(src, self.children[list.a + i]);
        args += ", i64 " + value;
        i += 1;
    }
    // An aggregate answer: hand over storage the CALLER owns and answer its address, the
    // same shape the direct method call uses. Returning a pointer into the callee's frame
    // would be a dangling one, so this is the only correct form rather than a choice.
    if self.is_aggregate_written(src, answers) {
        let storage: String = self.scratch(self.cells_of(src, answers));
        let dropped: String = self.fresh();
        let filled: Int = self.write_body("  " + dropped + " = call i64 " + target
                                 + "(ptr " + storage + ", " + args + ")\n");
        let address: String = self.fresh();
        let taken: Int = self.write_body("  " + address + " = ptrtoint ptr " + storage
                                + " to i64\n");
        return address;
    }
    let answer: String = self.fresh();
    let called: Int = self.write_body("  " + answer + " = call i64 " + target + "(" + args + ")\n");
    return answer;
}

// Which slot an interface gives a method — its position in the interface's declaration.
function (mutable self: Unit) trait_slot(src: String, holder: Type, name: Token) -> Int {
    let found: Int = self.find_type(src, holder.name_start, holder.name_length);
    if found < 0 {
        return 0;
    }
    let declared: Node = self.nodes[self.types[found].node];
    let mutable i: Int = 0;
    while i < declared.b {
        let sig: Node = self.nodes[self.children[declared.a + i]];
        let named: Token = self.tokens[sig.token];
        if spans_equal(src, named.start, named.length, name.start, name.length) {
            return i;
        }
        i += 1;
    }
    return 0;
}

// A value on its way into a place that wants `want`. Everything goes through here so the
// coercion has exactly one home.
function (mutable self: Unit) emit_value_for(src: String, want: Type, node: Int) -> String {
    if want.kind == 49 {
        return self.emit_dynamic(src, want, node);
    }
    return self.emit_expr(src, node);
}

// The declared type of parameter `i`, or unknown when there is none to read — an unknown callee, a
// builtin, an arity mismatch the checker has already complained about.
//
// Unknown is the right answer rather than a problem, because `emit_value_for` only acts when the
// wanted type is an interface object and passes everything else straight to `emit_expr`. So every
// argument site can ask for the wanted type unconditionally and none of them needs to know which
// types coerce.
function (mutable self: Unit) param_type_at(src: String, params_node: Int, i: Int) -> Type {
    if params_node < 0 {
        return unknown_type();
    }
    let list: Node = self.nodes[params_node];
    if i < 0 || i >= list.b {
        return unknown_type();
    }
    let param: Node = self.nodes[self.children[list.a + i]];
    return self.declared_type(src, param.a);
}

// What C sees for one Burxt type. A String is a pointer; a CInt is 32 bits wide and must
// be declared as such or the sign is lost on the way back; everything else is an i64,
// including a Decimal — which crosses as the exact scaled integer it already is, and that
// is the whole of `as scaled`: no conversion, because none is needed.
function c_type_of(bound_type: Type) -> String {
    if bound_type.kind == 42 {
        return "ptr";
    }
    if bound_type.kind == 43 {
        return "i32";
    }
    // An opaque pointer, both ways: C receives and returns a real `ptr`, and the emitter casts at
    // the boundary just as it does for a String. What keeps it opaque is the CHECKER — nothing in
    // Burxt can follow it — so the representation needs no protection of its own.
    if bound_type.kind == 51 {
        return "ptr";
    }
    if bound_type.kind == 44 {
        return "double";
    }
    return "i64";
}

// The libc symbols the emitted runtime already declares. A program is free to declare them
// too — `external function strcmp` is an ordinary thing to write — but LLVM refuses the same symbol
// declared twice, so the second one is skipped rather than emitted.
//
// Stage-0 answers the same collision by REFUSING the name. Skipping is better: the program
// gets to say what it means, and the only cost is that a program declaring a different
// signature for one of these would be told so by LLVM rather than by the compiler.
function declared_by_runtime(name: String) -> Bool {
    return name == "printf" || name == "exit" || name == "malloc" || name == "strlen"
        || name == "strcmp" || name == "memcpy" || name == "snprintf" || name == "fprintf"
        || name == "fopen" || name == "fread" || name == "fwrite" || name == "fclose"
        || name == "fseek" || name == "ftell";
}

function (mutable self: Unit) emit_extern(src: String, index: Int) -> Int {
    let item: Node = self.nodes[index];
    let name: Token = self.tokens[item.token];
    let called: String = substring(src, name.start, name.length);
    if declared_by_runtime(called) {
        return 0;
    }
    // Two modules may declare the same external, which the checker allows when the
    // signatures match. Emitting it twice would let LLVM rename the second and the
    // linker would ask for a symbol nobody has.
    let mutable d: Int = 0;
    while d < len(self.declared) {
        if self.declared[d] == called {
            return 0;
        }
        d += 1;
    }
    let noted: Int = push(self.declared, called);
    let params: Node = self.nodes[item.a];
    let mutable signature: String = "";
    let mutable p: Int = 0;
    while p < params.b {
        if p > 0 {
            signature += ", ";
        }
        let param: Node = self.nodes[self.children[params.a + p]];
        signature += c_type_of(self.declared_type(src, param.a));
        p += 1;
    }
    let answers: Type = self.declared_type(src, item.b);
    return self.write_module("declare " + c_type_of(answers) + " @"
                      + substring(src, name.start, name.length) + "(" + signature + ")\n");
}

// One function or method, from its signature to its closing brace. A method is a
// function whose first parameter is the receiver — `mutable self` is handed the ADDRESS and
// writes through it, plain `self` gets a copy, which is exactly what the two spellings
// promise a reader.
// ============================================================================
// GENERIC FUNCTIONS: one machine function per instantiation.
//
// Everything else about generics resolves lazily — a layout is a cell count, so `Pair<Int>` and
// `Pair<Point>` are read from one declaration under different bindings. A BODY cannot do that.
// `identity<T>` compiles to a load for `T = Int` and a memcpy for `T = Point`, so there has to
// be one function per argument list, with a name the linker can tell apart.
//
// The pieces: a mangled symbol, a find-or-add so two identical calls share one copy, and a work
// list drained to a fixpoint because emitting one instance can discover another.
// ============================================================================

// A type as a symbol fragment. Total by construction: every kind answers something, because a
// name that falls through to "" would collide two instances into one definition.
function (self: Unit) mangle_type(src: String, written: Type) -> String {
    // Resolved at every level, like `cells_of`. So `Pair<Pair<T>>` mangles correctly with the
    // bindings in scope and nothing has to be substituted first — the argument list travels down
    // by being looked up rather than rewritten.
    let t: Type = self.resolve_shallow(src, written);
    if t.kind == 40 { return "Int"; }
    if t.kind == 41 { return "Bool"; }
    if t.kind == 42 { return "String"; }
    if t.kind == 43 { return "Unit"; }
    if t.kind == 45 { return "Decimal" + to_string(t.scale) + "r" + to_string(t.contract); }
    if t.kind == 46 || t.kind == 49 || t.kind == 50 {
        let mutable base: String = substring(src, t.name_start, t.name_length);
        if t.kind == 49 {
            base = "dyn." + base;
        }
        let mutable i: Int = 0;
        while i < t.contract {
            base += "." + self.mangle_type(src, self.declared_type(src,
                                              self.nested_children[t.scale + i]));
            i += 1;
        }
        return base;
    }
    if t.kind == 47 {
        return "slice." + self.mangle_type(src, self.declared_type(src, t.scale));
    }
    if t.kind == 48 {
        return "array" + to_string(t.contract) + "."
            + self.mangle_type(src, self.declared_type(src, t.scale));
    }
    return "k" + to_string(t.kind);
}

// `identity$Int`. A dollar cannot appear in a Burxt identifier, so a mangled name can never
// collide with one a program wrote — the same reason stage-0 chose it.
function (self: Unit) instance_symbol(src: String, instance: Int) -> String {
    let it: Instance = self.instances[instance];
    let declaration: Generic = self.generics[it.generic];
    let mutable symbol: String = substring(src, declaration.start, declaration.length);
    let mutable i: Int = 0;
    while i < it.args_count {
        symbol += "$" + self.mangle_type(src, self.instance_arguments[it.args_start + i]);
        i += 1;
    }
    return symbol;
}

// The suffix alone — what `emit_function` appends to the declaration's own name. Kept separate
// from `instance_symbol` because the definition builds its name from the node it is emitting and
// only needs the tail.
function (self: Unit) instance_suffix(src: String, instance: Int) -> String {
    let it: Instance = self.instances[instance];
    let mutable suffix: String = "";
    let mutable i: Int = 0;
    while i < it.args_count {
        suffix += "$" + self.mangle_type(src, self.instance_arguments[it.args_start + i]);
        i += 1;
    }
    return suffix;
}

// The instance for this generic and these arguments, adding it if it is new. Two calls with the
// same arguments must answer the same index, or the module would define one function twice.
function (mutable self: Unit) find_instance(src: String, generic: Int, args_start: Int,
                                            args_count: Int) -> Int {
    let mutable i: Int = 0;
    while i < len(self.instances) {
        let it: Instance = self.instances[i];
        if it.generic == generic && it.args_count == args_count {
            let mutable same: Bool = true;
            let mutable k: Int = 0;
            while k < args_count {
                // `same_type`, NOT `type_identical`. Two instantiations are the same instance when
                // their arguments are the same TYPE — and `type_identical` compares span POSITIONS,
                // so the word `Json` written at two different offsets came out unequal and a second
                // `option_or$Json` was recorded. LLVM then refused the module for defining one symbol
                // twice, which is the loud end of a wrong answer rather than the quiet one.
                //
                // `type_identical` is right where it is used in check.bx — asking whether resolving
                // CHANGED a type, where an identical span means nothing moved. It is the wrong
                // question here, where identity means "would emit the same machine function".
                if !self.same_type(src, self.instance_arguments[it.args_start + k],
                                   self.instance_arguments[args_start + k]) {
                    same = false;
                }
                k += 1;
            }
            if same {
                let dropped: Int = truncate(self.instance_arguments, args_start);
                return i;                            // already wanted: reuse it
            }
        }
        i += 1;
    }
    let noted: Int = push(self.instances, Instance { generic: generic, args_start: args_start,
                                                     args_count: args_count });
    return len(self.instances) - 1;
}

// The declared function a generic index names. `Generic` holds a name span rather than an index
// into `functions`, because a generic may be a class or an enum too, so the crossing is by bytes.
function (self: Unit) find_function_by_index(generic: Int) -> Int {
    let declaration: Generic = self.generics[generic];
    let mutable i: Int = 0;
    while i < len(self.functions) {
        let f: DeclaredFunction = self.functions[i];
        if f.start == declaration.start && f.length == declaration.length {
            return i;
        }
        i += 1;
    }
    return 0 - 1;
}

// Which instance a call resolves to, working out its type arguments the way the checker did:
// unify the declared parameter types against the actual ones. The actuals come from the
// checker's own cache and are resolved DEEPLY first, because inside `echo<T>` the argument's
// recorded type is `T`, and what this needs is the Int that `T` stands for right here.
//
// Answers -1 when a type argument is still abstract, which is not a failure: it means the
// enclosing generic has not been instantiated yet, and this call will be reached again when it
// is. That is exactly the case a work list exists to handle.
function (mutable self: Unit) instance_of_call(src: String, generic: Int, params: Int,
                                               args: Int, call: Int) -> Int {
    let base: Int = len(self.type_bindings);
    // What the CALL's type turned out to be settles anything the arguments cannot — which for a
    // constructor is everything, since `-> Map<K, V>` mentions its parameters only in the return.
    // The checker already worked this out and cached it, so the emitter reads the answer rather
    // than deriving it a second time and risking a different one.
    let found: Int = self.find_function_by_index(generic);
    if found >= 0 {
        let matched: Bool = self.unify(src, self.functions[found].return_type, self.type_at(call));
    }
    let wanted: Node = self.nodes[params];
    let given: Node = self.nodes[args];
    let mutable i: Int = 0;
    while i < wanted.b && i < given.b {
        let parameter: Node = self.nodes[self.children[wanted.a + i]];
        let declared: Type = self.declared_type(src, parameter.a);
        // Kind 46 too — a generic APPLICATION like `Option<T>`. The same omission the checker had
        // (see `bind_type_arguments`), and the emitter's copy of it had the louder symptom: a parameter
        // reachable only through an application meant no instance was selected, so the call went out
        // UNMANGLED — `@option_is_some` instead of `@option_is_some$Json`, a symbol nothing defines.
        //
        // Two implementations of one question is the shape to notice: the checker and the emitter both
        // decide which instantiation a call is, and they have to decide it the same way or the module
        // does not link.
        if declared.kind == 50 || declared.kind == 47 || declared.kind == 48
           || declared.kind == 46 {
            let recorded: Type = self.type_at(self.children[given.a + i]);
            let actual: Type = self.resolve_deep(src, recorded, self.children[given.a + i]);
            let matched: Bool = self.unify(src, declared, actual);
        }
        i += 1;
    }
    let declaration: Generic = self.generics[generic];
    let args_start: Int = len(self.instance_arguments);
    let mutable settled: Bool = true;
    let mutable p: Int = 0;
    while p < declaration.type_param_count {
        let named: Token = self.tokens[self.type_parameters[declaration.type_param_start + p]];
        let stands_for: Type = self.resolve_shallow(src,
            Type { kind: 50, scale: 0, contract: 0,
                   name_start: named.start, name_length: named.length });
        if stands_for.kind == 50 {
            settled = false;
        }
        let noted: Int = push(self.instance_arguments, stands_for);
        p += 1;
    }
    let dropped: Int = truncate(self.type_bindings, base);
    if !settled {
        let unwound: Int = truncate(self.instance_arguments, args_start);
        return 0 - 1;
    }
    return self.find_instance(src, generic, args_start, declaration.type_param_count);
}

// The suffix a call site must add to name the copy it is calling, or "" when the callee is not
// generic. Also the moment an instance is DISCOVERED, which is why it is not a pure lookup: a
// call reached while emitting one instance adds the next one to the list.
function (mutable self: Unit) call_suffix(src: String, name: Token, args: Int,
                                          call: Int) -> String {
    let generic: Int = self.generic_named(src, name.start, name.length);
    if generic < 0 {
        return "";
    }
    let found: Int = self.find_function(src, name.start, name.length);
    if found < 0 {
        return "";
    }
    let instance: Int = self.instance_of_call(src, generic, self.functions[found].parameters, args, call);
    if instance < 0 {
        return "";                                   // still abstract: nothing to name yet
    }
    let it: Instance = self.instances[instance];
    let mutable suffix: String = "";
    let mutable i: Int = 0;
    while i < it.args_count {
        suffix += "$" + self.mangle_type(src, self.instance_arguments[it.args_start + i]);
        i += 1;
    }
    return suffix;
}

// The suffix that names a METHOD's copy: the receiver's type arguments, mangled. `Pair<Point>`
// gives `$Point`, so the symbol is `Pair$Point.left`. A method on a generic type is the one case
// where the copy is chosen by the RECEIVER rather than by the arguments, which is also why it
// needs no unification — the call site already knows what it is holding.
function (self: Unit) holder_suffix(src: String, holder: Type) -> String {
    if holder.kind != 46 {
        return "";
    }
    if holder.contract > 0 {
        let mutable suffix: String = "";
        let mutable i: Int = 0;
        while i < holder.contract {
            suffix += "$" + self.mangle_type(src,
                self.declared_type(src, self.nested_children[holder.scale + i]));
            i += 1;
        }
        return suffix;
    }
    // No arguments WRITTEN, which is what `self` looks like inside the generic's own methods: the
    // receiver's type comes from a bare name in the clause. So the suffix comes from the
    // declaration's parameters resolved through the bindings in scope — which, while an instance
    // is being emitted, are exactly that instance's arguments.
    //
    // Without this, `probe` called from `set` inside `Map$String$Int` emitted a call to the
    // unmangled `@Map.probe`, which nothing defines. A link error rather than a wrong answer,
    // which is the failure mode a mangled name is supposed to have.
    let generic: Int = self.generic_named(src, holder.name_start, holder.name_length);
    if generic < 0 {
        return "";
    }
    let declaration: Generic = self.generics[generic];
    let mutable suffix: String = "";
    let mutable p: Int = 0;
    while p < declaration.type_param_count {
        let named: Token = self.tokens[self.type_parameters[declaration.type_param_start + p]];
        let stands_for: Type = self.resolve_shallow(src,
            Type { kind: 50, scale: 0, contract: 0,
                   name_start: named.start, name_length: named.length });
        if stands_for.kind == 50 {
            return "";                               // still abstract: nothing to name yet
        }
        suffix += "$" + self.mangle_type(src, stands_for);
        p += 1;
    }
    return suffix;
}

// A receiver application seen at a call site, recorded so its methods get emitted. The same work
// list the functions use, and deliberately so: a method called on a `Pair<Point>` inside a
// `Stack<Point>` method is discovered while that one is being emitted.
//
// Answers nothing. Skipped when an argument is still abstract, because the enclosing generic has
// not been instantiated yet and this receiver will be seen again when it is.
function (mutable self: Unit) note_holder(src: String, holder: Type) -> Int {
    if holder.kind != 46 || holder.contract <= 0 {
        return 0;
    }
    let generic: Int = self.generic_named(src, holder.name_start, holder.name_length);
    if generic < 0 {
        return 0;
    }
    let args_start: Int = len(self.instance_arguments);
    let mutable settled: Bool = true;
    let mutable i: Int = 0;
    while i < holder.contract {
        let written: Type = self.declared_type(src, self.nested_children[holder.scale + i]);
        let argument: Type = self.resolve_shallow(src, written);
        if argument.kind == 50 {
            settled = false;
        }
        let noted: Int = push(self.instance_arguments, argument);
        i += 1;
    }
    if !settled {
        let unwound: Int = truncate(self.instance_arguments, args_start);
        return 0;
    }
    let instance: Int = self.find_instance(src, generic, args_start, holder.contract);
    return instance;
}

// Put an instance's arguments in scope, so every layout question asked while its body is emitted
// answers for THIS instantiation. Returns the base to truncate back to.
function (mutable self: Unit) install_instance(src: String, instance: Int) -> Int {
    let base: Int = len(self.type_bindings);
    let it: Instance = self.instances[instance];
    let declaration: Generic = self.generics[it.generic];
    let mutable i: Int = 0;
    while i < it.args_count {
        let named: Token = self.tokens[self.type_parameters[declaration.type_param_start + i]];
        push(self.type_bindings, TypeBinding { name_start: named.start, name_length: named.length,
                                               bound: self.instance_arguments[it.args_start + i] });
        i += 1;
    }
    return base;
}

// `left <predicate> right`, or die with a message built at compile time. The shape every runtime
// check in this emitter has: a comparison, a branch, and a named failure.
function (mutable self: Unit) check_or_die(predicate: String, left: String, right: String,
                                 message: String) -> Int {
    let held: String = self.fresh();
    let compared: Int = self.write_body("  " + held + " = icmp " + predicate + " i64 " + left
                               + ", " + right + "\n");
    let ok: String = self.fresh_label("check.ok");
    let broken: String = self.fresh_label("check.broken");
    let branched: Int = self.write_body("  br i1 " + held + ", label %" + ok + ", label %"
                               + broken + "\n");
    let opened: Int = self.write_body(broken + ":\n");
    let text: String = self.intern_text(message);
    let told: Int = self.write_body("  call void @burxt.contract_failed(i64 ptrtoint (ptr "
                           + text + " to i64))\n");
    let dead: Int = self.write_body("  unreachable\n");
    return self.write_body(ok + ":\n");
}

// The measure at a RECURSIVE call: re-evaluated with this call's arguments in place of the
// parameters, and required to be strictly smaller than the one taken at entry.
//
// The substitution works by declaring slots for the parameter names holding the call's argument
// values. `find_slot` searches backwards, so the newest binding wins, and truncating restores the
// caller's — the same shape every scope in this emitter uses. Stage-0 does exactly this with its
// variable map, which is why the two agree.
function (mutable self: Unit) check_measure_at_call(src: String, values: [String]) -> Int {
    if self.measure_clause < 0 {
        return 0;
    }
    let clause: Node = self.nodes[self.measure_clause];
    let params: Node = self.nodes[self.measure_parameters];
    let base: Int = len(self.slots);
    let mutable i: Int = 0;
    while i < params.b && i < len(values) {
        let param: Node = self.nodes[self.children[params.a + i]];
        let named: Token = self.tokens[param.token];
        let slot: Int = self.declare_slot(src, named.start, named.length, 1, 0);
        let stored: Int = self.write_body("  store i64 " + values[i] + ", ptr %v"
                                 + to_string(slot) + "\n");
        i += 1;
    }
    let next: String = self.emit_expr(src, clause.a);
    let dropped: Int = truncate(self.slots, base);
    let mine: String = self.fresh();
    let loaded: Int = self.write_body("  " + mine + " = load i64, ptr %measure"
                             + to_string(self.measure_slot) + "\n");
    let text: String = substring(src, clause.b, clause.c);
    return self.check_or_die("slt", next, mine,
        "burxt runtime error: `" + text + "` did not decrease on a recursive call to `"
        + self.measure_owner + "`\n");
}

// Every `old(...)` in this clause, evaluated NOW and remembered.
//
// A conservation law compares the state after a function against the state before it, so `old` is
// not a function call at all — it is a value captured at entry. Emitting it as a call produced
// `@old`, which nothing defines, and the IR would not assemble. That is the better failure: a
// missing check that silently passed would have been worse.
//
// The walk is over the whole clause because `old` may sit anywhere in it — inside an addition,
// inside a comparison, nested in another call's arguments.
function (mutable self: Unit) hoist_old(src: String, node: Int) -> Int {
    if node < 0 {
        return 0;
    }
    let n: Node = self.nodes[node];
    if n.kind == 13 {                                // a call
        let named: Token = self.tokens[n.token];
        if span_equal(src, named.start, named.length, "old") {
            let list: Node = self.nodes[n.a];
            if list.b == 1 {
                let inner: Int = self.children[list.a];
                let captured: String = self.emit_expr(src, inner);
                let slot: Int = self.next_slot;
                self.next_slot += 1;
                let made: Int = self.write_entry("  %old" + to_string(slot)
                                        + " = alloca i64\n");
                let stored: Int = self.write_body("  store i64 " + captured + ", ptr %old"
                                         + to_string(slot) + "\n");
                push(self.old_nodes, node);
                push(self.old_slots, slot);
                return 1;
            }
        }
    }
    // Kind by kind, and it has to be: a node's `a`/`b`/`c` hold a child index for SOME kinds and
    // payload for others — a scale, a token, a count. Walking all three unconditionally recursed
    // into node 0 forever, because 0 is a valid index and `a` is 0 for every leaf. It segfaulted,
    // which is the better failure, and it is why the guard is a whitelist rather than a guess.
    if n.kind == 8 || n.kind == 9 || n.kind == 10 || n.kind == 12 {
        let left: Int = self.hoist_old(src, n.a);      // binary, comparison, logic, index
        let right: Int = self.hoist_old(src, n.b);
        return 1;
    }
    if n.kind == 6 || n.kind == 7 || n.kind == 11 {
        return self.hoist_old(src, n.a);               // unary not/negate, field access
    }
    if n.kind == 13 {                                  // an ordinary call: walk its arguments
        let list: Node = self.nodes[n.a];
        let mutable i: Int = 0;
        while i < list.b {
            let done: Int = self.hoist_old(src, self.children[list.a + i]);
            i += 1;
        }
        return 1;
    }
    if n.kind == 14 {                                  // a method call: receiver, then arguments
        let receiver: Int = self.hoist_old(src, n.a);
        let list: Node = self.nodes[n.b];
        let mutable i: Int = 0;
        while i < list.b {
            let done: Int = self.hoist_old(src, self.children[list.a + i]);
            i += 1;
        }
        return 1;
    }
    return 1;                                          // a leaf: a name, a literal, `self`
}

// The slot holding an `old(...)` capture, or -1 if this call node is not one.
function (self: Unit) old_slot_for(node: Int) -> Int {
    let mutable i: Int = 0;
    while i < len(self.old_nodes) {
        if self.old_nodes[i] == node {
            return self.old_slots[i];
        }
        i += 1;
    }
    return 0 - 1;
}

// Every `ensures` of the function being emitted, checked against the value about to be returned.
//
// `result` is bound by declaring a slot at the span of the word "result" in the SOURCE, which is the
// same span the checker binds — the two have to agree, and neither invents a name. Stage-1 names
// every binding by where it is written, and this is that rule applied to a name the language
// introduces rather than the programmer.
function (mutable self: Unit) emit_ensures(src: String, value: String) -> Int {
    if self.ensures_count == 0 {
        return 0;
    }
    let mutable any: Int = 0;
    let mutable c: Int = 0;
    while c < self.ensures_count {
        let clause: Node = self.nodes[self.children[self.ensures_start + c]];
        if clause.value == 127 {
            any += 1;
        }
        c += 1;
    }
    if any == 0 {
        return 0;
    }
    // The slot has to exist before the clause is emitted, because the clause reads it.
    //
    // EXACTLY ONE slot, whichever form the program used. The longhand `ensures result >= $0.00` finds
    // it by the span of the word `result`; a bracket `[>= $0.00]` writes that word nowhere, so kind 21
    // reads `result_slot` instead. Two slots would mean the bracket form checking an uninitialised
    // one, which is a wrong answer rather than an error.
    //
    // When the word is absent the slot is declared at a span nothing can look up — a name is never
    // zero-length — because the span is only ever used BY `find_slot`, and nothing will.
    let spelling: Int = find_text(src, "result");
    let mutable slot_start: Int = 0 - 1;
    let mutable slot_length: Int = 0;
    if spelling >= 0 {
        slot_start = spelling;
        slot_length = 6;
    }
    let outer_result_slot: Int = self.result_slot;
    let slot: Int = self.declare_slot(src, slot_start, slot_length, 1, 0);
    self.result_slot = slot;
    let stored: Int = self.write_body("  store i64 " + value + ", ptr %v" + to_string(slot)
                             + "\n");
    c = 0;
    while c < self.ensures_count {
        let clause: Node = self.nodes[self.children[self.ensures_start + c]];
        if clause.value == 127 {
            let done: Int = self.emit_clause_check(src, clause, self.ensures_owner);
        }
        c += 1;
    }
    self.result_slot = outer_result_slot;
    return 1;
}

// Replace every WHOLE-WORD occurrence of `word` with `with`.
//
// Whole-word so that `it` inside `limit`, `omit` or `items` survives: a substring replace would
// rewrite a clause into nonsense, silently, in a message nobody reads until it fires. A boundary is
// "not alphanumeric and not `_`", which is where the lexer ends an identifier — so the two agree
// about where a name stops.
function replace_whole_word(text: String, word: String, with_text: String) -> String {
    let mutable out: String = "";
    // Everything below `copied` is already in `out`. Runs are copied WHOLE rather than a byte at a
    // time: `out = out + substring(text, i, 1)` in a loop allocates a fresh String per byte, in a
    // region, in a compiler — the shape that made the lexer quadratic for eleven versions.
    let mutable copied: Int = 0;
    let n: Int = len(text);
    let w: Int = len(word);
    let mutable i: Int = 0;
    while i < n {
        let mutable matched: Bool = i + w <= n;
        let mutable k: Int = 0;
        while matched && k < w {
            if byte_at(text, i + k) != byte_at(word, k) {
                matched = false;
            }
            k += 1;
        }
        if matched && i > 0 && is_name_byte(byte_at(text, i - 1)) {
            matched = false;
        }
        if matched && i + w < n && is_name_byte(byte_at(text, i + w)) {
            matched = false;
        }
        if matched {
            out = out + substring(text, copied, i - copied) + with_text;
            i += w;
            copied = i;
        } else {
            i += 1;
        }
    }
    return out + substring(text, copied, n - copied);
}


// The text a failure quotes, which for a BRACKET contract is not one span.
//
// `balance: Decimal<2> [> $0.00]` has to report `balance > $0.00`, and the subject and the clause are
// not contiguous — the type sits between them. So the subject comes from `clause_subjects`, the side
// table the parser filled, and the message is two pieces joined. The same answer as v0.0.165's
// qualified names: a thing that is not one span may still be two.
//
// The subject is written in even though nobody wrote it, and that is Andre's call: a message reading
// `> $0.00` names no value, which sends the reader back to the declaration to work out which one
// broke — a cost paid on every failure forever.
//
// A clause using `it` already HAS a subject in its text, spelled `it`, so that one is replaced rather
// than prepended. Stage-0 does exactly this, and the two messages have to match byte for byte.
function (self: Unit) clause_text(src: String, clause: Node) -> String {
    let written: String = substring(src, clause.b, clause.c);
    // Keyed by the clause's TEXT START rather than its node index, because two clauses cannot begin
    // at the same byte and the emitter is handed a Node rather than an index. A key that is already
    // unique beats threading an extra argument through every call site.
    let mutable i: Int = 0;
    while i < len(self.clause_subjects) {
        let entry: ClauseSubject = self.clause_subjects[i];
        if entry.clause == clause.b {
            // A bracket writes no `requires`/`ensures` word, and a longhand clause's span includes
            // one — so the word goes in front here, or the two forms would not report the same text.
            let mutable keyword: String = "requires ";
            if clause.value == 127 {
                keyword = "ensures ";
            }
            let mutable subject: String = "result";
            if entry.is_result == 0 {
                subject = substring(src, entry.start, entry.length);
            }
            if entry.mode == 1 {
                return keyword + subject + " " + written;
            }
            if entry.mode == 2 {
                return keyword + replace_whole_word(written, "it", subject);
            }
            return keyword + written;
        }
        i += 1;
    }
    return written;
}

// One contract clause, checked. `kind` is the word to quote — "requires" or "ensures" — and the
// message is built here, at compile time, so the runtime helper takes a pointer and does no work.
//
// The message matches stage-0's byte for byte, deliberately: the two compilers agreeing about what
// a program PRINTS is what the differential test measures, and a failure is output like any other.
function (mutable self: Unit) emit_clause_check(src: String, clause: Node,
                                       owner: String) -> Int {
    let condition: String = self.emit_expr(src, clause.a);
    let held: String = self.fresh();
    let checked: Int = self.write_body("  " + held + " = icmp ne i64 " + condition + ", 0\n");
    let ok: String = self.fresh_label("contract.ok");
    let broken: String = self.fresh_label("contract.broken");
    let branched: Int = self.write_body("  br i1 " + held + ", label %" + ok + ", label %"
                               + broken + "\n");
    let opened: Int = self.write_body(broken + ":\n");
    let text: String = self.clause_text(src, clause);
    let message: String = self.intern_text("burxt runtime error: `" + text + "` failed in `"
                                  + owner + "`\n");
    let told: Int = self.write_body("  call void @burxt.contract_failed(i64 ptrtoint (ptr "
                           + message + " to i64))\n");
    let dead: Int = self.write_body("  unreachable\n");
    return self.write_body(ok + ":\n");
}

function (mutable self: Unit) emit_function(src: String, index: Int, suffix: String) -> Int {
    let item: Node = self.nodes[index];
    let name: Token = self.tokens[item.token];
    let params: Node = self.nodes[item.a];
    let signature_node: Node = self.nodes[item.c];
    let base: Int = len(self.slots);
    // Two questions, and they are not the same one. `qualified` asks whether the SYMBOL carries the
    // class's name — true for a method and for an associated function alike, because both are
    // `Account.something`. `is_method` asks whether a RECEIVER arrives, which an associated
    // function's does not. Conflating them emitted `Account.open` with a third parameter nothing
    // ever passed.
    let qualified: Bool = item.kind == 81;
    let is_method: Bool = item.kind == 81 && flag_associated(item.value) == 0;

    // An aggregate return travels through the CALLER's storage: the caller hands over a
    // pointer as the first argument and the callee copies into it. Returning a pointer
    // into the callee's own frame would be a dangling one, which is why this is not an
    // optimisation but the only correct shape.
    let answers: Type = self.resolve_shallow(src, self.declared_type(src, signature_node.c));
    // What a `return` in this body has to produce. Saved and restored, because a nested emit — a
    // generic instantiated while this one is being written — must not leave the wrong answer behind.
    let outer_returns: Int = self.returns_node;
    self.returns_node = signature_node.c;
    let outer_sret: String = self.sret;
    self.sret = "";
    let mutable signature: String = "";
    let mutable first: Int = 0;
    if self.is_aggregate_written(src, answers) {
        self.sret = "%sret";
        self.sret_cells = self.cells_of(src, answers);
        signature = "ptr %sret";
        first = 1;
    }

    let mutable symbol: String = substring(src, name.start, name.length) + suffix;
    if qualified {
        let receiver: Token = self.tokens[signature_node.value];
        let holder: Type = Type { kind: 46, scale: 0, contract: 0,
                              name_start: receiver.start, name_length: receiver.length };
        symbol = method_symbol(src, holder, name) + suffix;
    }
    if is_method {
        if first > 0 {
            signature += ", ";
        }
        signature += "i64 %a" + to_string(first);
        first += 1;
    }
    let mutable p: Int = 0;
    while p < params.b {
        if p + first > 0 {
            signature += ", ";
        }
        signature += "i64 %a" + to_string(p + first);
        p += 1;
    }
    let opened: Int = self.open_function("define i64 @" + symbol + "(" + signature
                                   + ") \{\nentry:\n");
    if is_method {
        let receiver: Token = self.tokens[signature_node.value];
        // The word `self`, found by scanning back from the method's name rather than by
        // counting from the receiver's TYPE token — because `function (self) name()` inside an
        // `implement` borrows the header's type token, which is nowhere near the clause.
        // See check.bx's self_token, which had to learn the same thing.
        let word: Token = self.tokens[self.self_token(item.token)];
        // The receiver arrives as an address either way. `mutable self` keeps it, so writes
        // reach the caller's value; plain `self` copies, so they cannot.
        let receiver_arg: String = "%a" + to_string(first - 1);
        if item.value >= 4 {
            // Two kinds of aggregate slot, and they are not the same. A local record or
            // a by-value parameter IS its storage, so reading the name takes the alloca's
            // address. `mutable self` HOLDS the caller's address, so reading it must LOAD —
            // the loaded i64 is already the address. Marked not-aggregate for that
            // reason: the flag means "the alloca is the storage", not "this is a class".
            let slot: Int = self.declare_slot(src, word.start, word.length, 1, 0);
            let stored: Int = self.write_body("  store i64 " + receiver_arg + ", ptr %v"
                                     + to_string(slot) + "\n");
        } else {
            let holder: Type = Type { kind: 46, scale: 0, contract: 0,
                                  name_start: receiver.start, name_length: receiver.length };
            let cells: Int = self.cells_of(src, holder);
            let slot: Int = self.declare_slot(src, word.start, word.length, cells, 1);
            let copied: Int = self.copy_cells(src, "%v" + to_string(slot), receiver_arg,
                                              cells);
        }
    }
    p = 0;
    while p < params.b {
        let param: Node = self.nodes[self.children[params.a + p]];
        let pname: Token = self.tokens[param.token];
        let declared: Type = self.resolve_shallow(src, self.declared_type(src, param.a));
        if self.is_aggregate_written(src, declared) {
            // By value across a call too: the callee copies what it was handed, so
            // writing to a parameter cannot reach back into the caller.
            let cells: Int = self.cells_of(src, declared);
            let slot: Int = self.declare_slot(src, pname.start, pname.length, cells, 1);
            let copied: Int = self.copy_cells(src, "%v" + to_string(slot),
                                              "%a" + to_string(p + first), cells);
        } else {
            let slot: Int = self.declare_slot(src, pname.start, pname.length, 1, 0);
            let stored: Int = self.write_body("  store i64 %a" + to_string(p + first) + ", ptr %v"
                                     + to_string(slot) + "\n");
        }
        p += 1;
    }

    // `requires`, after the parameters are in their slots — the clause names them, so they have to
    // exist — and before a single statement of the body runs. A precondition that was checked after
    // the work would be a report, not a guard.
    let outer_ensures_start: Int = self.ensures_start;
    let outer_ensures_count: Int = self.ensures_count;
    let outer_ensures_owner: String = self.ensures_owner;
    self.ensures_start = 0;
    self.ensures_count = 0;
    self.ensures_owner = symbol;
    let mutable c: Int = 0;
    while c < signature_node.b {
        let clause: Node = self.nodes[self.children[signature_node.a + c]];
        if clause.value == 126 {                     // requires
            let checked: Int = self.emit_clause_check(src, clause, symbol);
        }
        c += 1;
    }
    // The `decreases` measure, captured at entry and refused if negative. A measure that can fall
    // below zero is not a ladder to the floor, it is a hole: "strictly smaller" alone would let it
    // descend forever.
    let outer_measure_clause: Int = self.measure_clause;
    let outer_measure_slot: Int = self.measure_slot;
    let outer_measure_params: Int = self.measure_parameters;
    let outer_measure_owner: String = self.measure_owner;
    self.measure_clause = 0 - 1;
    c = 0;
    while c < signature_node.b {
        let clause: Node = self.nodes[self.children[signature_node.a + c]];
        if clause.value == 128 {                     // decreases
            let value: String = self.emit_expr(src, clause.a);
            self.measure_slot = self.next_slot;
            self.next_slot += 1;
            let made: Int = self.write_entry("  %measure" + to_string(self.measure_slot)
                                    + " = alloca i64\n");
            let stored: Int = self.write_body("  store i64 " + value + ", ptr %measure"
                                     + to_string(self.measure_slot) + "\n");
            let text: String = substring(src, clause.b, clause.c);
            let refused: Int = self.check_or_die("sge", value, "0",
                "burxt runtime error: `" + text + "` is negative in `" + symbol + "`\n");
            self.measure_clause = self.children[signature_node.a + c];
            self.measure_parameters = item.a;
            self.measure_owner = substring(src, name.start, name.length);
        }
        c += 1;
    }

    // `old(...)` captured at ENTRY, before the body can change anything. This is the whole reason a
    // conservation law works: `ensures self.a + self.b == old(self.a + self.b)` compares the state
    // after against a value taken before.
    let old_base: Int = len(self.old_nodes);
    c = 0;
    while c < signature_node.b {
        let clause: Node = self.nodes[self.children[signature_node.a + c]];
        if clause.value == 127 {                     // ensures
            let hoisted: Int = self.hoist_old(src, clause.a);
        }
        c += 1;
    }

    // The `ensures` range is remembered rather than emitted: it belongs at every `return`, which is
    // in emit_stmt and may be forty lines away.
    self.ensures_start = signature_node.a;
    self.ensures_count = signature_node.b;

    let body: Int = self.emit_block(src, item.b);
    // Unreachable, since the checker proved every path returns — but LLVM requires every
    // block to end in a terminator, and a module that does not verify is not a program.
    let closed: Int = self.close_function("  ret i64 0\n\}\n\n");
    let dropped: Int = truncate(self.slots, base);
    self.sret = outer_sret;
    self.returns_node = outer_returns;
    self.ensures_start = outer_ensures_start;
    self.ensures_count = outer_ensures_count;
    self.ensures_owner = outer_ensures_owner;
    let forgotten: Int = truncate(self.old_nodes, old_base);
    let released: Int = truncate(self.old_slots, old_base);
    self.measure_clause = outer_measure_clause;
    self.measure_slot = outer_measure_slot;
    self.measure_parameters = outer_measure_params;
    self.measure_owner = outer_measure_owner;
    return 1;
}

function (mutable self: Unit) emit_module(src: String) -> Int {
    // The CHECKER handles generic applications: parameters resolve lazily as comparison
    // recurses, and a field's type is resolved deeply where it is read. LAYOUT is the part
    // that cannot be lazy — `Option<Int>` needs its own tag-and-payload sizing, one copy per
    // argument list — so the refusal lives here rather than in the checker, which no longer
    // needs it. See spec/M7-GENERICS.md §5.
    // A generic METHOD is the one thing left: `Stack<T>.push` wants a mangled receiver as well
    // as a mangled name, and a receiver that is itself an application. Named rather than emitted
    // wrongly, which is the rule every gap in this file follows.
    let mutable preamble: Int = self.write_module("declare i32 @printf(ptr, ...)\n");
    preamble = self.write_module("declare void @exit(i32)\n\n");
    // The overflow helpers, written once. They are what makes `a + b` a claim rather
    // than a hope, and they exit 70 like every other named runtime failure.
    preamble = self.write_module(overflow_helper("add", "sadd"));
    preamble = self.write_module(overflow_helper("sub", "ssub"));
    preamble = self.write_module(overflow_helper("mul", "smul"));
    preamble = self.write_module(runtime_ir());

    // The method tables, before anything can refer to them. Slot order comes from the
    // TRAIT's declaration, so every implementor agrees on which slot is which without
    // negotiating — the same reason the enum tag is a variant's position.
    let mutable t: Int = 0;
    while t < len(self.items) {
        let item: Node = self.nodes[self.items[t]];
        if item.kind == 85 {
            let table: Int = self.emit_vtable(src, self.items[t]);
        }
        t += 1;
    }

    // Functions first, so a call reads as a call to something already written.
    let mutable i: Int = 0;
    while i < len(self.items) {
        let index: Int = self.items[i];
        let item: Node = self.nodes[index];
        if item.kind == 86 {                         // external function: a declaration, no body
            let declared: Int = self.emit_extern(src, index);
        }
        if item.kind == 85 {                         // an implementation block's methods
            let mutable k: Int = 0;
            while k < item.b {
                let done: Int = self.emit_function(src, self.children[item.a + k], "");
                k += 1;
            }
        }
        if item.kind == 80 || item.kind == 81 {
            // A generic declaration is NOT emitted here. There is no one function to emit: it
            // becomes one copy per instantiation, and the instantiations are only known once
            // every body that calls it has been walked. Skipped now, drained below.
            let name: Token = self.tokens[item.token];
            let mutable generic: Bool = self.generic_named(src, name.start, name.length) >= 0;
            if item.kind == 81 {
                // A METHOD is generic when its RECEIVER is, whatever the method itself is
                // called. `Pair<T>.left` has an ordinary name and still needs one copy per
                // instantiation, which is the case the first version of this test missed.
                let signature: Node = self.nodes[item.c];
                let receiver: Token = self.tokens[signature.value];
                if self.generic_named(src, receiver.start, receiver.length) >= 0 {
                    generic = true;
                }
            }
            if !generic {
                let done: Int = self.emit_function(src, index, "");
            }
        }
        i += 1;
    }

    // Then main, which is the top-level statements in order.
    let opened: Int = self.open_function("define i32 @main(i32 %argc, ptr %argv) \{\nentry:\n");
    // The arguments are recorded once, where they arrive, so `argument(n)` is a load rather
    // than a parameter threaded through every function that might want it.
    let widened: Int = self.write_body("  %argc64 = sext i32 %argc to i64\n");
    let kept: Int = self.write_body("  store i64 %argc64, ptr @burxt.argc\n");
    let kept_argv: Int = self.write_body("  store ptr %argv, ptr @burxt.argv\n");
    i = 0;
    while i < len(self.items) {
        let index: Int = self.items[i];
        let item: Node = self.nodes[index];
        if item.kind >= 60 && item.kind <= 72 {
            let emitted: Int = self.emit_stmt(src, index);
        }
        i += 1;
    }
    let closed: Int = self.close_function("  ret i32 0\n\}\n");

    // The work list, drained to a fixpoint. Every call emitted above added the instance it
    // needs; emitting those bodies discovers the instances THEY need, so the list grows while it
    // is being walked. A `while` over `len`, re-read each turn, is what makes that terminate for
    // the right reason: a generic can only be instantiated at finitely many argument lists that
    // the program actually writes, and `find_instance` makes each of them one entry.
    //
    // After main rather than before it, because before it the list is empty — nothing has been
    // walked yet. LLVM does not mind a call to a function defined further down the module.
    let mutable pending: Int = 0;
    while pending < len(self.instances) {
        let it: Instance = self.instances[pending];
        let declaration: Generic = self.generics[it.generic];
        let base: Int = self.install_instance(src, pending);
        let suffix: String = self.instance_suffix(src, pending);
        let node: Int = self.declaration_node(src, declaration.start, declaration.length);
        if node >= 0 {
            let done: Int = self.emit_function(src, node, suffix);
        } else {
            // Not a function, so a generic RECORD or ENUM, and what an instantiation of one
            // means is that every method on it needs a copy. Chosen by the receiver rather than
            // by the arguments, which is why there is no unification here: the call site that
            // recorded this instance already knew what it was holding.
            let methods: Int = self.emit_methods_of(src, declaration, suffix);
        }
        let dropped: Int = truncate(self.type_bindings, base);
        pending += 1;
    }
    return 1;
}

// Every method declared on this generic type, emitted once for the arguments now in scope.
function (mutable self: Unit) emit_methods_of(src: String, declaration: Generic,
                                             suffix: String) -> Int {
    let mutable i: Int = 0;
    while i < len(self.items) {
        let index: Int = self.items[i];
        let item: Node = self.nodes[index];
        if item.kind == 81 {
            let signature: Node = self.nodes[item.c];
            let receiver: Token = self.tokens[signature.value];
            if spans_equal(src, receiver.start, receiver.length,
                           declaration.start, declaration.length) {
                let done: Int = self.emit_function(src, index, suffix);
            }
        }
        i += 1;
    }
    return 1;
}

// The declaration node for a function of this name. The generics list holds a name span, not a
// node, because a generic may be a class or an enum too — so the node is found where every
// other name in stage-1 is found: by comparing bytes.
function (self: Unit) declaration_node(src: String, start: Int, length: Int) -> Int {
    let mutable i: Int = 0;
    while i < len(self.items) {
        let index: Int = self.items[i];
        let item: Node = self.nodes[index];
        if item.kind == 80 {
            let name: Token = self.tokens[item.token];
            if spans_equal(src, name.start, name.length, start, length) {
                return index;
            }
        }
        i += 1;
    }
    return 0 - 1;
}

// Every symbol here lives under `burxt.` — a program that defines `function bump()` must not
// collide with the allocator's pointer, and one that names a class `Line` must not
// collide with anything either. Stage-0 solves the same problem by refusing the name; the
// prefix solves it without taking a word away from the programmer.
//
// The runtime, written into every module rather than linked from a library: a bump
// allocator, and the String operations that build in it. Emitting it means a Burxt
// program needs nothing on the machine but a C library.
//
// A Burxt String is a NUL-terminated pointer, carried as an i64 like every other value
// — one value type through the whole emitter, cast at the few places a pointer is
// needed. `len` is therefore strlen, which is also why a String has no length field
// that could fall out of step with its bytes. The bump allocator's MARK is the region:
// opening one remembers where the pointer stood, closing it puts the pointer back, and
// that is the whole of release — O(1) for any number of allocations.
function runtime_ir() -> String {
    return "@burxt.arena = global ptr null\n"
        + "@burxt.bump = global i64 0\n"
        + "declare ptr @malloc(i64)\n"
        + "declare i64 @strlen(ptr)\n"
        + "declare i32 @strcmp(ptr, ptr)\n"
        + "declare ptr @memcpy(ptr, ptr, i64)\n"
        + "declare i32 @snprintf(ptr, i64, ptr, ...)\n"
        + "declare i32 @fprintf(ptr, ptr, ...)\n"
        + "@stderr = external global ptr\n\n"
        // One gigabyte, the same reservation stage-0 makes, and the SAME refusal when it
        // runs out. A bump allocator that does not check its limit does not fail — it
        // writes past the mapping and the program dies with a signal, which is the one
        // outcome this language is supposed to make impossible. Exit 70 and a named
        // error, like every other runtime failure.
        + "define i64 @burxt.alloc(i64 %n) \{\n"
        + "entry:\n"
        + "  %a = load ptr, ptr @burxt.arena\n"
        + "  %isnull = icmp eq ptr %a, null\n"
        + "  br i1 %isnull, label %init, label %go\n"
        + "init:\n"
        + "  %m = call ptr @malloc(i64 1073741824)\n"
        + "  %failed = icmp eq ptr %m, null\n"
        + "  br i1 %failed, label %exhausted, label %mapped\n"
        + "mapped:\n"
        + "  store ptr %m, ptr @burxt.arena\n"
        + "  br label %go\n"
        + "go:\n"
        + "  %base = load ptr, ptr @burxt.arena\n"
        + "  %off = load i64, ptr @burxt.bump\n"
        + "  %padded = add i64 %n, 7\n"
        + "  %rounded = and i64 %padded, -8\n"
        + "  %next = add i64 %off, %rounded\n"
        + "  %over = icmp ugt i64 %next, 1073741824\n"
        + "  br i1 %over, label %exhausted, label %hand_out\n"
        + "hand_out:\n"
        + "  %p = getelementptr i8, ptr %base, i64 %off\n"
        + "  store i64 %next, ptr @burxt.bump\n"
        + "  %asint = ptrtoint ptr %p to i64\n"
        + "  ret i64 %asint\n"
        + "exhausted:\n"
        + "  %err = load ptr, ptr @stderr\n"
        + "  call i32 (ptr, ptr, ...) @fprintf(ptr %err, ptr @burxt.region_msg)\n"
        + "  call void @exit(i32 70)\n"
        + "  unreachable\n\}\n\n"
        // Every String this runtime makes goes through here, and it is the whole of M12: the
        // length lives in the eight bytes BEFORE the first byte, so `len` is a load rather than a
        // scan. The pointer answered points at the first byte, so a Burxt String is still one
        // pointer and still a valid `char*` — C never looks behind it.
        //
        // Reading n bytes used to cost n squared, because a bounds check is a length and a length
        // was a strlen. 102400 statements took 31.67 seconds; they take 0.05 now.
        + "define i64 @burxt.alloc_string(i64 %len) \{\n"
        + "entry:\n"
        + "  %total = add i64 %len, 9\n"
        + "  %base = call i64 @burxt.alloc(i64 %total)\n"
        + "  %hp = inttoptr i64 %base to ptr\n"
        + "  store i64 %len, ptr %hp\n"
        + "  %bytes = add i64 %base, 8\n"
        + "  %bp = inttoptr i64 %bytes to ptr\n"
        + "  %end = getelementptr i8, ptr %bp, i64 %len\n"
        + "  store i8 0, ptr %end\n"
        + "  ret i64 %bytes\n\}\n\n"
        + "define i64 @burxt.concat(i64 %a, i64 %b) \{\n"
        + "entry:\n"
        + "  %pa = inttoptr i64 %a to ptr\n"
        + "  %pb = inttoptr i64 %b to ptr\n"
        + "  %la = call i64 @burxt.len_str(i64 %a)\n"
        + "  %lb = call i64 @burxt.len_str(i64 %b)\n"
        + "  %total = add i64 %la, %lb\n"
        + "  %out = call i64 @burxt.alloc_string(i64 %total)\n"
        + "  %pout = inttoptr i64 %out to ptr\n"
        + "  %c1 = call ptr @memcpy(ptr %pout, ptr %pa, i64 %la)\n"
        + "  %tail = getelementptr i8, ptr %pout, i64 %la\n"
        + "  %c2 = call ptr @memcpy(ptr %tail, ptr %pb, i64 %lb)\n"
        + "  ret i64 %out\n\}\n\n"
        + "define i64 @burxt.substring(i64 %s, i64 %from, i64 %count) \{\n"
        + "entry:\n"
        + "  %n = call i64 @burxt.len_str(i64 %s)\n"
        // `%stop`, not `%end`: the body below already uses `%end` for the NUL it writes, and LLVM
        // refuses a name defined twice in one function. A collision in emitted IR is caught by llc
        // rather than by anything here, so the names have to be picked with the whole function in view.
        + "  %stop = add i64 %from, %count\n"
        + "  %neg_from = icmp slt i64 %from, 0\n"
        + "  %neg_count = icmp slt i64 %count, 0\n"
        + "  %past = icmp sgt i64 %stop, %n\n"
        + "  %either = or i1 %neg_from, %neg_count\n"
        + "  %bad = or i1 %either, %past\n"
        + "  br i1 %bad, label %oops, label %fits\n"
        + "oops:\n"
        + "  %err = load ptr, ptr @stderr\n"
        + "  call i32 (ptr, ptr, ...) @fprintf(ptr %err, ptr @burxt.substring_msg, i64 %from, "
        + "i64 %count, i64 %n)\n"
        + "  call void @exit(i32 70)\n"
        + "  unreachable\n"
        + "fits:\n"
        + "  %out = call i64 @burxt.alloc_string(i64 %count)\n"
        + "  %pout = inttoptr i64 %out to ptr\n"
        + "  %ps = inttoptr i64 %s to ptr\n"
        + "  %from_ptr = getelementptr i8, ptr %ps, i64 %from\n"
        + "  %copied = call ptr @memcpy(ptr %pout, ptr %from_ptr, i64 %count)\n"
        + "  %end = getelementptr i8, ptr %pout, i64 %count\n"
        + "  store i8 0, ptr %end\n"
        + "  ret i64 %out\n\}\n\n"
        // Room for the widest i64 reserved up front, then the header CORRECTED to what snprintf
        // actually wrote. Reserving and correcting rather than measuring twice: snprintf already
        // answers the length, so asking anything else for it would be asking a second source the
        // same question — which is how a length and its bytes drift apart.
        + "define i64 @burxt.to_string_int(i64 %v) \{\n"
        + "entry:\n"
        + "  %out = call i64 @burxt.alloc_string(i64 24)\n"
        + "  %p = inttoptr i64 %out to ptr\n"
        + "  %n = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %p, i64 25, ptr @burxt.fmt_int, "
        + "i64 %v)\n"
        + "  %wrote = sext i32 %n to i64\n"
        + "  %hdr = sub i64 %out, 8\n"
        + "  %hp = inttoptr i64 %hdr to ptr\n"
        + "  store i64 %wrote, ptr %hp\n"
        + "  ret i64 %out\n\}\n\n"
        // Bounds-checked, and the check costs one load now that a String carries its length — which
        // is the whole argument M12 made. Reading past the end would hand back whatever byte follows,
        // and silent garbage is the failure this language exists to refuse.
        + "define i64 @burxt.remainder(i64 %a, i64 %b) \{\n"
        + "entry:\n"
        + "  %zero = icmp eq i64 %b, 0\n"
        + "  br i1 %zero, label %oops, label %ok\n"
        + "oops:\n"
        + "  %err = load ptr, ptr @stderr\n"
        + "  call i32 (ptr, ptr, ...) @fprintf(ptr %err, ptr @burxt.remainder_msg)\n"
        + "  call void @exit(i32 70)\n"
        + "  unreachable\n"
        + "ok:\n"
        + "  %r = srem i64 %a, %b\n"
        + "  ret i64 %r\n\}\n\n"
        + "define i64 @burxt.byte_at(i64 %s, i64 %i) \{\n"
        + "entry:\n"
        + "  %n = call i64 @burxt.len_str(i64 %s)\n"
        + "  %low = icmp slt i64 %i, 0\n"
        + "  %high = icmp sge i64 %i, %n\n"
        + "  %bad = or i1 %low, %high\n"
        + "  br i1 %bad, label %oops, label %ok\n"
        + "oops:\n"
        + "  %err = load ptr, ptr @stderr\n"
        + "  %last = sub i64 %n, 1\n"
        + "  call i32 (ptr, ptr, ...) @fprintf(ptr %err, ptr @burxt.byte_msg, i64 %i, i64 %n, "
        + "i64 %last)\n"
        + "  call void @exit(i32 70)\n"
        + "  unreachable\n"
        + "ok:\n"
        + "  %p = inttoptr i64 %s to ptr\n"
        + "  %q = getelementptr i8, ptr %p, i64 %i\n"
        + "  %b = load i8, ptr %q\n"
        + "  %z = zext i8 %b to i64\n"
        + "  ret i64 %z\n\}\n\n"
        + "define i64 @burxt.strcmp(i64 %a, i64 %b) \{\n"
        + "entry:\n"
        + "  %pa = inttoptr i64 %a to ptr\n"
        + "  %pb = inttoptr i64 %b to ptr\n"
        + "  %r = call i32 @strcmp(ptr %pa, ptr %pb)\n"
        + "  %answer = sext i32 %r to i64\n"
        + "  ret i64 %answer\n\}\n\n"
        + "define i64 @burxt.len_str(i64 %s) \{\n"
        + "entry:\n"
        + "  %header = sub i64 %s, 8\n"
        + "  %hp = inttoptr i64 %header to ptr\n"
        + "  %l = load i64, ptr %hp\n"
        + "  ret i64 %l\n\}\n\n"
        // A growable array is a four-cell header in the region: length, capacity, the
        // data pointer, and the ELEMENT WIDTH in cells. The width is stored rather than
        // baked into the call, so one `push` serves scalars and structs both — it copies
        // eight bytes or the whole element depending on what the header says.
        // Rounding, in i128 so no intermediate can overflow: every operand reaching here
        // came from i64s. The tie test is |r| * 2 against |d|, which is exact rather than
        // a comparison against half of something.
        //
        // HalfEven is the default in financial regulation because it does not bias upward
        // over many transactions; HalfUp is the one people expect from school.
        + round_helper("half_even")
        + round_helper("half_up")
        + "define i64 @burxt.to_string_dec(i64 %v, i64 %pow, ptr %fmt) \{\n"
        + "entry:\n"
        + "  %out = call i64 @burxt.alloc_string(i64 48)\n"
        + "  %p = inttoptr i64 %out to ptr\n"
        + "  %wide = sext i64 %v to i128\n"
        + "  %isneg = icmp slt i64 %v, 0\n"
        + "  %flip = sub i128 0, %wide\n"
        + "  %abs = select i1 %isneg, i128 %flip, i128 %wide\n"
        + "  %sign = select i1 %isneg, ptr getelementptr inbounds (\{ i64, [2 x i8] \}, ptr @burxt.string_minus, i32 0, i32 1), ptr getelementptr inbounds (\{ i64, [1 x i8] \}, ptr @burxt.string_empty, i32 0, i32 1)\n"
        + "  %poww = sext i64 %pow to i128\n"
        + "  %iw = udiv i128 %abs, %poww\n"
        + "  %fw = urem i128 %abs, %poww\n"
        + "  %ip = trunc i128 %iw to i64\n"
        + "  %fp = trunc i128 %fw to i64\n"
        + "  %n = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %p, i64 49, ptr %fmt, "
        + "ptr %sign, i64 %ip, i64 %fp)\n"
        + "  %wrote = sext i32 %n to i64\n"
        + "  %hdr = sub i64 %out, 8\n"
        + "  %hp = inttoptr i64 %hdr to ptr\n"
        + "  store i64 %wrote, ptr %hp\n"
        + "  ret i64 %out\n\}\n\n"
        + "define i64 @burxt.new_array(i64 %elem) \{\n"
        + "entry:\n"
        + "  %h = call i64 @burxt.alloc(i64 32)\n"
        + "  %p = inttoptr i64 %h to ptr\n"
        + "  store i64 0, ptr %p\n"
        + "  %capp = getelementptr i64, ptr %p, i64 1\n"
        + "  store i64 0, ptr %capp\n"
        + "  %datap = getelementptr i64, ptr %p, i64 2\n"
        + "  store i64 0, ptr %datap\n"
        + "  %elemp = getelementptr i64, ptr %p, i64 3\n"
        + "  store i64 %elem, ptr %elemp\n"
        + "  ret i64 %h\n\}\n\n"
        + "define i64 @burxt.push(i64 %xs, i64 %value) \{\n"
        + "entry:\n"
        + "  %p = inttoptr i64 %xs to ptr\n"
        + "  %capp = getelementptr i64, ptr %p, i64 1\n"
        + "  %datap = getelementptr i64, ptr %p, i64 2\n"
        + "  %elemp = getelementptr i64, ptr %p, i64 3\n"
        + "  %len = load i64, ptr %p\n"
        + "  %cap = load i64, ptr %capp\n"
        + "  %elem = load i64, ptr %elemp\n"
        + "  %full = icmp sge i64 %len, %cap\n"
        + "  br i1 %full, label %grow, label %place\n"
        + "grow:\n"
        + "  %doubled = mul i64 %cap, 2\n"
        + "  %small = icmp slt i64 %doubled, 8\n"
        + "  %newcap = select i1 %small, i64 8, i64 %doubled\n"
        + "  %cells = mul i64 %newcap, %elem\n"
        + "  %bytes = mul i64 %cells, 8\n"
        + "  %fresh = call i64 @burxt.alloc(i64 %bytes)\n"
        + "  %freshp = inttoptr i64 %fresh to ptr\n"
        + "  %old = load i64, ptr %datap\n"
        + "  %empty = icmp eq i64 %old, 0\n"
        + "  br i1 %empty, label %installed, label %move\n"
        + "move:\n"
        + "  %oldp = inttoptr i64 %old to ptr\n"
        + "  %usedcells = mul i64 %len, %elem\n"
        + "  %usedbytes = mul i64 %usedcells, 8\n"
        + "  %moved = call ptr @memcpy(ptr %freshp, ptr %oldp, i64 %usedbytes)\n"
        + "  br label %installed\n"
        + "installed:\n"
        + "  store i64 %fresh, ptr %datap\n"
        + "  store i64 %newcap, ptr %capp\n"
        + "  br label %place\n"
        + "place:\n"
        + "  %data = load i64, ptr %datap\n"
        + "  %dp = inttoptr i64 %data to ptr\n"
        + "  %offset = mul i64 %len, %elem\n"
        + "  %slot = getelementptr i64, ptr %dp, i64 %offset\n"
        + "  %wide = icmp sgt i64 %elem, 1\n"
        + "  br i1 %wide, label %copy, label %store_one\n"
        + "copy:\n"
        + "  %vp = inttoptr i64 %value to ptr\n"
        + "  %vbytes = mul i64 %elem, 8\n"
        + "  %copied = call ptr @memcpy(ptr %slot, ptr %vp, i64 %vbytes)\n"
        + "  br label %done\n"
        + "store_one:\n"
        + "  store i64 %value, ptr %slot\n"
        + "  br label %done\n"
        + "done:\n"
        + "  %next = add i64 %len, 1\n"
        + "  store i64 %next, ptr %p\n"
        + "  ret i64 %next\n\}\n\n"
        // REFUSES to grow rather than clamping. Clamping silently gave a program the length it had
        // instead of the one it asked for, which is a wrong answer where stage-0 gives an error —
        // and `truncate` is named for the one thing it does.
        + "define i64 @burxt.truncate(i64 %xs, i64 %n) \{\n"
        + "entry:\n"
        + "  %p = inttoptr i64 %xs to ptr\n"
        + "  %len = load i64, ptr %p\n"
        + "  %grows = icmp sgt i64 %n, %len\n"
        + "  %below = icmp slt i64 %n, 0\n"
        + "  %bad = or i1 %grows, %below\n"
        + "  br i1 %bad, label %oops, label %ok\n"
        + "oops:\n"
        + "  %err = load ptr, ptr @stderr\n"
        + "  call i32 (ptr, ptr, ...) @fprintf(ptr %err, ptr @burxt.truncate_msg, i64 %n, "
        + "i64 %len)\n"
        + "  call void @exit(i32 70)\n"
        + "  unreachable\n"
        + "ok:\n"
        + "  %answer = select i1 %grows, i64 %len, i64 %n\n"
        + "  store i64 %answer, ptr %p\n"
        + "  ret i64 %answer\n\}\n\n"
        + "define i64 @burxt.array_len(i64 %xs) \{\n"
        + "entry:\n"
        + "  %p = inttoptr i64 %xs to ptr\n"
        + "  %len = load i64, ptr %p\n"
        + "  ret i64 %len\n\}\n\n"
        // The address of element i, bounds-checked against the LENGTH — not the
        // capacity, which is an implementation detail no program can see.
        + "define i64 @burxt.slot(i64 %xs, i64 %i, i64 %at) \{\n"
        + "entry:\n"
        + "  %p = inttoptr i64 %xs to ptr\n"
        + "  %len = load i64, ptr %p\n"
        + "  call void @burxt.bounds(i64 %i, i64 %len, i64 %at)\n"
        + "  %datap = getelementptr i64, ptr %p, i64 2\n"
        + "  %elemp = getelementptr i64, ptr %p, i64 3\n"
        + "  %data = load i64, ptr %datap\n"
        + "  %elem = load i64, ptr %elemp\n"
        + "  %offset = mul i64 %i, %elem\n"
        + "  %dp = inttoptr i64 %data to ptr\n"
        + "  %slot = getelementptr i64, ptr %dp, i64 %offset\n"
        + "  %answer = ptrtoint ptr %slot to i64\n"
        + "  ret i64 %answer\n\}\n\n"
        // The driver's four: the arguments the program was started with, and the two
        // file operations. `read_file` reads into the region, so the text it answers has
        // the lifetime the region does — which is why it needs one open.
        + "@burxt.argc = global i64 0\n"
        + "@burxt.argv = global ptr null\n"
        + "declare ptr @fopen(ptr, ptr)\n"
        + "declare i64 @fread(ptr, i64, i64, ptr)\n"
        + "declare i64 @fwrite(ptr, i64, i64, ptr)\n"
        + "declare i32 @fclose(ptr)\n"
        + "declare i32 @fseek(ptr, i64, i32)\n"
        + "declare i64 @ftell(ptr)\n"
        // The runtime-check messages. The array sizes count BYTES, not characters — the em-dash is
        // three of them in UTF-8, and guessing these wrong is a build failure at llc rather than a
        // compile error here. Counted, not estimated.
        //
        // Built here as printf formats rather than interned strings,
        // because each one names the values that broke it — "byte index 5 is out of bounds" tells a
        // reader where to look and "index out of bounds" sends them hunting.
        //
        // The wording matches stage-0's byte for byte. What a program prints is what the
        // differential test compares, and a failure is output like any other.
        + "@burxt.byte_msg = private unnamed_addr constant [112 x i8] "
        + "c\"burxt runtime error: byte index %lld is out of bounds \\E2\\80\\94 this string has "
        + "%lld bytes (valid indexes 0 to %lld)\\0A\\00\"\n"
        + "@burxt.substring_msg = private unnamed_addr constant [91 x i8] "
        + "c\"burxt runtime error: substring(s, %lld, %lld) does not fit \\E2\\80\\94 this string "
        + "has %lld bytes\\0A\\00\"\n"
        + "@burxt.truncate_msg = private unnamed_addr constant [116 x i8] "
        + "c\"burxt runtime error: truncate(xs, %lld) \\E2\\80\\94 this array has %lld elements, "
        + "and truncate only ever makes one shorter\\0A\\00\"\n"
        + "@burxt.remainder_msg = private unnamed_addr constant [45 x i8] "
        + "c\"burxt runtime error: remainder(...) by zero\\0A\\00\"\n"
        + "@burxt.mode_read = private unnamed_addr constant [2 x i8] c\"r\\00\"\n"
        + "@burxt.mode_write = private unnamed_addr constant [2 x i8] c\"w\\00\"\n"
        // "wb" and not "w" for a byte buffer. Identical on Linux; the distinction is real on
        // platforms that translate newlines, and a buffer of bytes is exactly the case where a
        // translated newline would corrupt the output. Stage-0 opens it the same way.
        + "@burxt.mode_wb = private unnamed_addr constant [3 x i8] c\"wb\\00\"\n"
        + "@burxt.no_read_msg = private unnamed_addr constant [51 x i8] "
        + "c\"burxt runtime error: cannot open file for reading\\0A\\00\"\n"
        + "@burxt.no_write_msg = private unnamed_addr constant [51 x i8] "
        + "c\"burxt runtime error: cannot open file for writing\\0A\\00\"\n"
        + "@burxt.null_ptr_msg = private unnamed_addr constant [83 x i8] "
        + "c\"burxt runtime error: c_string_at was given a null pointer; "
        + "ask c_is_null(p) first\\0A\\00\"\n\n"
        + "define i64 @burxt.argument_count() \{\n"
        + "entry:\n  %n = load i64, ptr @burxt.argc\n  ret i64 %n\n\}\n\n"
        + "define i64 @burxt.argument(i64 %i) \{\n"
        + "entry:\n"
        + "  %n = load i64, ptr @burxt.argc\n"
        + "  call void @burxt.bounds(i64 %i, i64 %n, i64 0)\n"
        + "  %argv = load ptr, ptr @burxt.argv\n"
        + "  %at = getelementptr ptr, ptr %argv, i64 %i\n"
        + "  %s = load ptr, ptr %at\n"
        // COPIED into the region, with a header. `argv` holds C's strings, which have none, so
        // handing one back directly would make `len` of it read whatever the loader placed before
        // it — a silent wrong length, worse than a crash. This is the one place a foreign string
        // enters a Burxt program, and the strlen happens ONCE here rather than once per byte read
        // afterwards. See spec/M12-STRINGS.md §3.
        + "  %borrowed = call i64 @strlen(ptr %s)\n"
        + "  %owned = call i64 @burxt.alloc_string(i64 %borrowed)\n"
        + "  %op = inttoptr i64 %owned to ptr\n"
        + "  %moved = call ptr @memcpy(ptr %op, ptr %s, i64 %borrowed)\n"
        + "  ret i64 %owned\n\}\n\n"
        // `c_string_at(p)` — the SECOND place a foreign string enters a Burxt program, and the
        // general one. The comment above says `argument` is the only place; as of v0.0.196 that is
        // no longer true, and the reason is the pointer wall: an `external function` may hand back
        // a CPointer, and this is the only way to look at what it points at.
        //
        // The copy IS the wall. After this returns, Burxt holds bytes it owns and the pointer is
        // not kept, so "who frees it" and "is it still valid" stop being questions the compiler has
        // to answer — nothing will look again.
        //
        // A null pointer dies here rather than answering "": unset and empty are different facts,
        // and one String for both is the silent wrong answer this language exists to refuse.
        + "define i64 @burxt.c_string_at(i64 %p) \{\n"
        + "entry:\n"
        + "  %isnull = icmp eq i64 %p, 0\n"
        + "  br i1 %isnull, label %nothing, label %copy\n"
        + "nothing:\n"
        + "  %nerr = load ptr, ptr @stderr\n"
        + "  call i32 (ptr, ptr, ...) @fprintf(ptr %nerr, ptr @burxt.null_ptr_msg)\n"
        + "  call void @exit(i32 70)\n"
        + "  unreachable\n"
        + "copy:\n"
        + "  %cs = inttoptr i64 %p to ptr\n"
        + "  %clen = call i64 @strlen(ptr %cs)\n"
        + "  %cowned = call i64 @burxt.alloc_string(i64 %clen)\n"
        + "  %cop = inttoptr i64 %cowned to ptr\n"
        + "  %cmoved = call ptr @memcpy(ptr %cop, ptr %cs, i64 %clen)\n"
        + "  ret i64 %cowned\n\}\n\n"
        + "define i64 @burxt.read_file(i64 %path) \{\n"
        + "entry:\n"
        + "  %p = inttoptr i64 %path to ptr\n"
        + "  %f = call ptr @fopen(ptr %p, ptr @burxt.mode_read)\n"
        + "  %missing = icmp eq ptr %f, null\n"
        + "  br i1 %missing, label %nothing, label %read\n"
        // FAILS rather than answering an empty String. An unreadable file that reads as empty is a
        // wrong answer a program cannot tell from a real empty file — and stage-0 has always
        // refused it. The silent version was the more dangerous of the two divergences this file
        // had, because nothing downstream could detect it.
        + "nothing:\n"
        + "  %rerr = load ptr, ptr @stderr\n"
        + "  call i32 (ptr, ptr, ...) @fprintf(ptr %rerr, ptr @burxt.no_read_msg)\n"
        + "  call void @exit(i32 70)\n"
        + "  unreachable\n"
        + "read:\n"
        + "  %sought = call i32 @fseek(ptr %f, i64 0, i32 2)\n"
        + "  %size = call i64 @ftell(ptr %f)\n"
        + "  %rewound = call i32 @fseek(ptr %f, i64 0, i32 0)\n"
        + "  %buffer = call i64 @burxt.alloc_string(i64 %size)\n"
        + "  %bp = inttoptr i64 %buffer to ptr\n"
        + "  %got = call i64 @fread(ptr %bp, i64 1, i64 %size, ptr %f)\n"
        + "  %closed = call i32 @fclose(ptr %f)\n"
        // ftell may report more than fread delivers — a text-mode translation, a file that
        // shrank — so the header is corrected to what actually arrived. A length that disagrees
        // with the bytes is exactly what this representation exists to prevent.
        + "  %hdr = sub i64 %buffer, 8\n"
        + "  %hp2 = inttoptr i64 %hdr to ptr\n"
        + "  store i64 %got, ptr %hp2\n"
        + "  %end = getelementptr i8, ptr %bp, i64 %got\n"
        + "  store i8 0, ptr %end\n"
        + "  ret i64 %buffer\n\}\n\n"
        + "define i64 @burxt.write_file(i64 %path, i64 %text) \{\n"
        + "entry:\n"
        + "  %p = inttoptr i64 %path to ptr\n"
        + "  %t = inttoptr i64 %text to ptr\n"
        + "  %f = call ptr @fopen(ptr %p, ptr @burxt.mode_write)\n"
        + "  %missing = icmp eq ptr %f, null\n"
        + "  br i1 %missing, label %refused, label %write\n"
        + "refused:\n  ret i64 0\n"
        + "write:\n"
        + "  %size = call i64 @burxt.len_str(i64 %text)\n"
        + "  %written = call i64 @fwrite(ptr %t, i64 1, i64 %size, ptr %f)\n"
        + "  %closed = call i32 @fclose(ptr %f)\n"
        + "  ret i64 %written\n\}\n\n"
        // `write_bytes(path, buffer)` — the low byte of every element, written out.
        //
        // Elements are i64 because a growable array's element type is one of Burxt's and there is
        // no byte type yet. The narrowing is deliberate: an element outside 0..255 keeps its low
        // eight bits, which is what a byte buffer means. The 8x memory cost of holding bytes in
        // i64s is the price of not adding a type, and it is paid in a buffer that lives for one
        // region.
        //
        // One narrow pass into region memory, then a SINGLE fwrite. Writing byte by byte through
        // the C library would be a million calls for a megabyte, which is the whole reason this
        // builtin exists — see the fixture, which is about not building a String in a loop.
        // The two hash helpers, and they must answer EXACTLY what stage-0's answer. FNV-1a for a
        // String — offset basis 0xcbf29ce484222325, prime 0x100000001b3, one xor and one multiply
        // per byte — and two rounds of xor-shift-multiply for a scalar, so small consecutive Ints
        // do not land in consecutive slots.
        //
        // The sign bit is cleared, so a hash is never negative: every caller turns one into an
        // index with `remainder(h, capacity)`, and `remainder` keeps the sign of its left operand,
        // so a negative hash would mean a negative index and a bounds failure at run time. One
        // instruction here removes that from every caller.
        //
        // Wrapping arithmetic, which is deliberate in a language where `+` panics on overflow: a
        // hash is a bit pattern and not a quantity, so there is nothing to conserve. This is the
        // only place in a Burxt program where that is true, and it is a good reason for hashing to
        // be a builtin rather than something a program writes with `*`.
        + "define i64 @burxt.hash_int(i64 %x) \{\n"
        + "entry:\n"
        + "  %m1 = mul i64 %x, 1099511628211\n"
        + "  %s1 = lshr i64 %m1, 29\n"
        + "  %f1 = xor i64 %m1, %s1\n"
        + "  %m2 = mul i64 %f1, 1099511628211\n"
        + "  %s2 = lshr i64 %m2, 32\n"
        + "  %f2 = xor i64 %m2, %s2\n"
        + "  %out = and i64 %f2, 9223372036854775807\n"
        + "  ret i64 %out\n\}\n\n"
        + "define i64 @burxt.hash_str(i64 %s) \{\n"
        + "entry:\n"
        + "  %sp = inttoptr i64 %s to ptr\n"
        + "  %acc = alloca i64\n"
        + "  %ip = alloca i64\n"
        + "  store i64 -3750763034362895579, ptr %acc\n"
        + "  store i64 0, ptr %ip\n"
        + "  br label %head\n"
        + "head:\n"
        + "  %i = load i64, ptr %ip\n"
        + "  %at = getelementptr i8, ptr %sp, i64 %i\n"
        + "  %byte = load i8, ptr %at\n"
        + "  %more = icmp ne i8 %byte, 0\n"
        + "  br i1 %more, label %body, label %done\n"
        + "body:\n"
        + "  %wide = zext i8 %byte to i64\n"
        + "  %h = load i64, ptr %acc\n"
        + "  %x = xor i64 %h, %wide\n"
        + "  %scaled = mul i64 %x, 1099511628211\n"
        + "  store i64 %scaled, ptr %acc\n"
        + "  %next = add i64 %i, 1\n"
        + "  store i64 %next, ptr %ip\n"
        + "  br label %head\n"
        + "done:\n"
        + "  %raw = load i64, ptr %acc\n"
        + "  %out = and i64 %raw, 9223372036854775807\n"
        + "  ret i64 %out\n\}\n\n"
        + "define i64 @burxt.write_bytes(i64 %path, i64 %xs) \{\n"
        + "entry:\n"
        + "  %h = inttoptr i64 %xs to ptr\n"
        + "  %datap = getelementptr i64, ptr %h, i64 2\n"
        + "  %count = load i64, ptr %h\n"
        + "  %data = load i64, ptr %datap\n"
        + "  %dp = inttoptr i64 %data to ptr\n"
        + "  %flat = call i64 @burxt.alloc(i64 %count)\n"
        + "  %fp = inttoptr i64 %flat to ptr\n"
        + "  %i0 = alloca i64\n"
        + "  store i64 0, ptr %i0\n"
        + "  br label %narrow_head\n"
        + "narrow_head:\n"
        + "  %i = load i64, ptr %i0\n"
        + "  %more = icmp slt i64 %i, %count\n"
        + "  br i1 %more, label %narrow_body, label %narrow_done\n"
        + "narrow_body:\n"
        + "  %src = getelementptr i64, ptr %dp, i64 %i\n"
        + "  %wide = load i64, ptr %src\n"
        + "  %byte = trunc i64 %wide to i8\n"
        + "  %dst = getelementptr i8, ptr %fp, i64 %i\n"
        + "  store i8 %byte, ptr %dst\n"
        + "  %next = add i64 %i, 1\n"
        + "  store i64 %next, ptr %i0\n"
        + "  br label %narrow_head\n"
        + "narrow_done:\n"
        + "  %pp = inttoptr i64 %path to ptr\n"
        + "  %f = call ptr @fopen(ptr %pp, ptr @burxt.mode_wb)\n"
        + "  %missing = icmp eq ptr %f, null\n"
        + "  br i1 %missing, label %refused, label %opened\n"
        // A refusal EXITS rather than answering 0, because stage-0 does: a program that cannot
        // write the file it was told to write has not half-succeeded.
        + "refused:\n"
        + "  %err = load ptr, ptr @stderr\n"
        + "  call i32 (ptr, ptr, ...) @fprintf(ptr %err, ptr @burxt.no_write_msg)\n"
        + "  call void @exit(i32 70)\n"
        + "  unreachable\n"
        + "opened:\n"
        + "  %written = call i64 @fwrite(ptr %fp, i64 1, i64 %count, ptr %f)\n"
        + "  %closed = call i32 @fclose(ptr %f)\n"
        + "  ret i64 %written\n\}\n\n"
        // A contract that did not hold. The whole message is built at COMPILE time and interned,
        // so this helper takes one pointer and needs no formatting — and the text it prints is the
        // clause exactly as the programmer wrote it, which is the difference between a message that
        // names the promise and one that says a precondition was violated.
        + "define void @burxt.contract_failed(i64 %msg) \{\n"
        + "entry:\n"
        + "  %m = inttoptr i64 %msg to ptr\n"
        + "  %err = load ptr, ptr @stderr\n"
        + "  call i32 (ptr, ptr, ...) @fprintf(ptr %err, ptr @burxt.fmt_str, ptr %m)\n"
        + "  call void @exit(i32 70)\n"
        + "  unreachable\n\}\n\n"
        + "define void @burxt.bounds(i64 %i, i64 %limit, i64 %at) \{\n"
        + "entry:\n"
        + "  %low = icmp slt i64 %i, 0\n"
        + "  %high = icmp sge i64 %i, %limit\n"
        + "  %bad = or i1 %low, %high\n"
        + "  br i1 %bad, label %oops, label %ok\n"
        + "ok:\n  ret void\n"
        + "oops:\n"
        + "  %err = load ptr, ptr @stderr\n"
        // The numbers, because "outside the array" leaves a reader to guess which index
        // and how long the array was — and the two together usually name the bug.
        + "  call i32 (ptr, ptr, ...) @fprintf(ptr %err, ptr @burxt.bounds_msg, i64 %i, "
        + "i64 %limit, i64 %at)\n"
        + "  call void @exit(i32 70)\n"
        + "  unreachable\n\}\n\n"
        + "define i64 @burxt.divide_floor(i64 %a, i64 %b) \{\n"
        + "entry:\n"
        + "  %q = sdiv i64 %a, %b\n"
        + "  %r = srem i64 %a, %b\n"
        + "  %nonzero = icmp ne i64 %r, 0\n"
        + "  %ra = xor i64 %r, %b\n"
        + "  %opposite = icmp slt i64 %ra, 0\n"
        + "  %adjust = and i1 %nonzero, %opposite\n"
        + "  %lower = sub i64 %q, 1\n"
        + "  %answer = select i1 %adjust, i64 %lower, i64 %q\n"
        + "  ret i64 %answer\n\}\n\n";
}

// One rounding helper per mode, differing only in the tie rule. Written as text with the
// mode's name substituted, because the two bodies are otherwise identical and a copy would
// be two places to fix a bug in.
function round_helper(mode: String) -> String {
    let mutable tie: String = "";
    if mode == "half_even" {
        // A tie goes to the even quotient, so repeated rounding does not drift upward.
        tie = "  %gt = icmp sgt i128 %r2, %absd\n"
            + "  %eq = icmp eq i128 %r2, %absd\n"
            + "  %lsb = and i128 %q, 1\n"
            + "  %odd = icmp ne i128 %lsb, 0\n"
            + "  %toeven = and i1 %eq, %odd\n"
            + "  %bump = or i1 %gt, %toeven\n";
    } else {
        tie = "  %bump = icmp sge i128 %r2, %absd\n";
    }
    return "define i128 @burxt.round." + mode + "(i128 %p, i128 %d) \{\n"
        + "entry:\n"
        + "  %zero = icmp eq i128 %d, 0\n"
        + "  br i1 %zero, label %by_zero, label %divide\n"
        + "by_zero:\n"
        + "  %err = load ptr, ptr @stderr\n"
        + "  call i32 (ptr, ptr, ...) @fprintf(ptr %err, ptr @burxt.divzero_msg)\n"
        + "  call void @exit(i32 70)\n"
        + "  unreachable\n"
        + "divide:\n"
        + "  %q = sdiv i128 %p, %d\n"
        + "  %r = srem i128 %p, %d\n"
        + "  %rneg = sub i128 0, %r\n"
        + "  %risneg = icmp slt i128 %r, 0\n"
        + "  %absr = select i1 %risneg, i128 %rneg, i128 %r\n"
        + "  %dneg = sub i128 0, %d\n"
        + "  %disneg = icmp slt i128 %d, 0\n"
        + "  %absd = select i1 %disneg, i128 %dneg, i128 %d\n"
        + "  %r2 = mul i128 %absr, 2\n"
        + tie
        // Away from zero means toward the true quotient's sign, which is sign(p)*sign(d).
        + "  %pneg = icmp slt i128 %p, 0\n"
        + "  %opposite = xor i1 %pneg, %disneg\n"
        + "  %dir = select i1 %opposite, i128 -1, i128 1\n"
        + "  %delta = select i1 %bump, i128 %dir, i128 0\n"
        + "  %answer = add i128 %q, %delta\n"
        + "  ret i128 %answer\n\}\n\n";
}

function overflow_helper(name: String, intrinsic: String) -> String {
    return "define i64 @burxt.checked." + name + "(i64 %a, i64 %b) \{\n"
        + "entry:\n"
        + "  %r = call \{i64, i1\} @llvm." + intrinsic + ".with.overflow.i64(i64 %a, i64 %b)\n"
        + "  %v = extractvalue \{i64, i1\} %r, 0\n"
        + "  %o = extractvalue \{i64, i1\} %r, 1\n"
        + "  br i1 %o, label %overflowed, label %ok\n"
        + "ok:\n  ret i64 %v\n"
        + "overflowed:\n"
        + "  %err = load ptr, ptr @stderr\n"
        + "  call i32 (ptr, ptr, ...) @fprintf(ptr %err, ptr @burxt.overflow_msg)\n"
        + "  call void @exit(i32 70)\n"
        + "  unreachable\n\}\n"
        + "declare \{i64, i1\} @llvm." + intrinsic + ".with.overflow.i64(i64, i64)\n\n";
}
