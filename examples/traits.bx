// ============================================================================
// Traits — the whole of Burxt's abstraction story. There is no `class` and no
// inheritance: a trait says what a type can DO, an `impl` says a type does it,
// and `dyn` is the only place a decision is made at runtime.
// ============================================================================

// A trait is a list of signatures. No bodies, no fields, no state — a trait
// describes behaviour, and behaviour is all it can describe.
trait Priced {
    fn price(self) -> Decimal<2>
    fn label(self) -> String
}
// (In a trait the receiver is just `self`; in the `impl` it is written in full,
//  `fn (self: Book) price()`, because that is where the type is known.)

struct Book { title: String, cost: Decimal<2> }
struct Meal { dish: String, cost: Decimal<2>, covers: Int }

// `impl Trait for Type` is explicit. A type does not accidentally satisfy a
// trait by having the right method names — conformance is declared, and the
// compiler checks the impl answers EVERY signature, with no extras.
impl Priced for Book {
    fn (self) price() -> Decimal<2> { return self.cost; }
    fn (self) label() -> String allocates { return "book: " + self.title; }
}

impl Priced for Meal {
    fn (self) price() -> Decimal<2> { return self.cost * self.covers; }
    fn (self) label() -> String allocates { return "meal: " + self.dish; }
}

// ---- Static dispatch: the default, and it costs nothing -------------------
// `item: Book` is a concrete type, so the call is direct. No vtable, no
// indirection, and the optimiser can see through it.
fn describe_book(item: Book) -> String allocates {
    return item.label() + " at " + to_string(item.price());
}

// ---- Runtime dispatch: only where you write `dyn` -------------------------
// `dyn Priced` is a fat pointer — the value, and a table of the trait's
// methods. Slot order comes from the trait declaration, so `price` is slot 0
// for every implementor. You pay for this exactly where you ask for it.
fn show(item: dyn Priced) -> Decimal<2> {
    return item.price();
}

region r {
    let novel: Book = Book { title: "Sea", cost: $14.50 };
    let dinner: Meal = Meal { dish: "Stew", cost: $12.25, covers: 2 };

    // static: the type is known here
    print(describe_book(novel));

    // dynamic: the same function serves both types
    print(show(novel));
    print(show(dinner));

    // A `dyn` value is storable — it is a value like any other, so it can live
    // in a binding, a struct field, or an array.
    let anything: dyn Priced = dinner;
    print(anything.label());
    print(anything.price());
}

// ---- What the compiler refuses, and why ------------------------------------
//
// An impl that leaves a method out:
//     impl Priced for Book { fn (self: Book) price() -> Decimal<2> { ... } }
//     error: this impl leaves out `label`, which the trait requires
//
// An impl that adds one the trait never declared:
//     error: the trait has no method of this name, and an impl is an answer to
//            a trait rather than a place to add to a type
//
// A signature that does not match — including the receiver form, since `self`
// and `mut self` are different promises:
//     error: the trait returns Decimal<2>, and this returns Int
//
// And there is no inheritance to reach for instead. A `Book` is not a kind of
// anything; it is a struct that satisfies a trait. Composition and traits do
// the work a base class would, without the fragile-base-class problem or the
// question of which parent a method came from.
