// Valid declarations, read by nothing in particular — a scratch file for trying the
// language out. The version WITH a redeclaration, which `examples/symbols.bx` reads to
// show the symbol table catching it, is in `examples/negative/declarations.bx`.
let price: Decimal<2> = $19.99;
let mut qty: Int = 3;
let mut total: Decimal<2> = $0.00;
let label: String = "widget";
qty = 4;
print(qty);
