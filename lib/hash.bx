// ============================================================================
// lib/hash.bx — hashes and checksums.
//
//     use "lib/hash.bx";
//
// ============================================================================
// TWO KINDS OF FUNCTION LIVE HERE AND THEY ARE NOT INTERCHANGEABLE
// ============================================================================
//
// **CHECKSUMS — `crc32`, `fnv1a_32`, `fnv1a_64`.** They detect accidental damage and they spread
// keys across buckets. They are *not* cryptographic: given a value you can construct an input that
// produces it, in seconds, by hand. **Using either for a token, a signature, a password, a
// deduplication key an attacker can choose, or an "is this file the one I signed" check is a
// security bug**, and the fact that the answer looks like a random number is exactly why it is a
// bug that survives review. Their virtue is that they are cheap and their answer never changes,
// which is what a bucket index and a wire-format checksum both need.
//
// **CRYPTOGRAPHIC — `sha256`, `sha512`, `hmac_sha256`, `hmac_sha512`, `pbkdf2_sha256`.** These are
// the ones to reach for when an adversary chooses the input. `sha256` and `sha512` are *not*
// password hashes on their own: they are fast by design and a GPU tries billions per second, which
// is what `pbkdf2_sha256` and its iteration count exist to answer.
//
// What is deliberately NOT here, per `spec/1.0/ROADMAP-1.0.md` §E5: AES, ChaCha20, RSA, Ed25519,
// X25519, TLS, Argon2, scrypt, bcrypt. **Bind those, do not hand-roll them.** Two reasons and both
// are structural rather than a matter of effort: this language gives no control over instruction
// timing, and RSA and the curves need arbitrary-precision integers, which do not exist here —
// `Decimal` is a scaled i64 capped at scale 18.
//
// ============================================================================
// WHY THESE FIVE WERE BUILT WHEN THOSE ARE BOUND — the line is TESTABILITY
// ============================================================================
//
// Everything in this file has **published test vectors** and **no secret-dependent branching**.
// That combination is what makes "it compiles" and "it is correct" the same statement: there is a
// number the standard prints, this file produces that number or it does not, and no part of the
// computation depends on the value of a secret, so there is no timing channel to get wrong.
//
// Every vector is pinned as a test rather than described here:
//
//     tests/pass/hash_sha2.bx      FIPS 180-4 — SHA-256 and SHA-512, empty / "abc" / 448-bit /
//                                  896-bit / a 64-byte input landing exactly on a block boundary /
//                                  one million 'a'
//     tests/pass/hash_hmac.bx      RFC 4231 cases 1-7, HMAC-SHA-256 and HMAC-SHA-512, including
//                                  the 131-byte key that must be hashed first
//     tests/pass/hash_pbkdf2.bx    PBKDF2-HMAC-SHA256, the widely-published SHA-2 companion set to
//                                  RFC 6070 (RFC 6070's own vectors are HMAC-SHA1, which this file
//                                  does not implement — see the note on `pbkdf2_sha256`)
//     tests/pass/hash_checksums.bx CRC-32's specification check value, and the FNV reference vectors
//
// ============================================================================
// THE ARITHMETIC PROBLEM, AND HOW IT IS SOLVED HERE
// ============================================================================
//
// SHA-256 is defined on **u32** with addition that wraps and rotation that wraps. SHA-512 is the
// same on **u64**. Burxt's `Int` is i64 and `+` **traps** on overflow, which is the right default
// and the wrong instruction for a hash. A7 shipped `u32` and `u64`, but they are **boundary-only**
// types — they exist so a C signature can be written honestly and cannot be used as arithmetic
// types in Burxt code. So both widths are built from the bit operations, and the two answers are
// different:
//
// **u32 rides inside i64 with room to spare.** A u32 value is at most 2^32-1, so the sum of five
// of them is at most 2^35 — nowhere near i64's 2^63. Plain `+` therefore cannot trap, and the
// whole discipline is one `bit_and(x, MASK_32)` **after** the add rather than before. That is why
// `hash_mask_32` appears at the end of every SHA-256 line and never in the middle.
//
// **u64 has no room at all, and this is where a hash goes subtly wrong.** `a + b` on two full-width
// values traps, so SHA-512 adds through `hash_add_wrapping_64`, which splits both operands into
// 32-bit halves and carries by hand. `lib/math.bx` already has `math_wrapping_add`, and it is not
// used here on purpose: it is a half-adder loop that iterates once per carry bit — measured mean
// 6.3 passes and worst case 64 — where the split-halves form is a fixed eleven operations. SHA-512
// performs about 500 additions per 128-byte block, so the difference is the difference between a
// usable hash and an unusable one.
//
// **A u64 word is stored as the i64 with the same bits, so half of them are negative.** That is
// correct and it is also a trap for the next person: `<` on two of these compares them as signed
// and answers the wrong thing. Nothing in this file compares words — only `bit_*`, `shift_*` and
// the two wrapping helpers, all of which are bit-pattern operations and care nothing for the sign.
// `shift_right_zeros` and never `shift_right_sign`, for the same reason.
//
// **The rotate is built, not borrowed.** `hash_rotate_right_32(x, n)` is
// `shift_right_zeros(x, n)` merged with `shift_left(x, 32 - n)` and then masked, because
// `shift_left` discards what leaves the top of the *register*, which is bit 63 and not bit 31.
// Leaving the mask off produces a value that is right in its low 32 bits and carries rubbish
// above, and rubbish above survives into the next `bit_xor`. This is the classic way a SHA passes
// on `"abc"` and fails on a longer input, which is why the fixtures test multi-block cases.
//
// ============================================================================
// §D0 — BUILDING THE HEX STRING
// ============================================================================
//
// `hash_hex` is the only function here that builds a String, and it is exactly the shape §D0
// names: a **chunk list joined PAIRWISE**, never `out = out + piece` in a loop and never a left
// fold. A SHA-512 digest is 128 hex characters, so the cost is small — but the reason to write it
// correctly anyway is that hex-encoding a digest is the first thing anyone copies out of this file
// into a loop over ten thousand digests. `string_join_chunks` in `lib/string.bx` is the merge.
//
// ============================================================================
// THREE SHAPES THE REGION MODEL CHOSE, NOT THE AUTHOR
// ============================================================================
//
//   1. **`sha256_k` fills an array rather than returning one.** A function taking no
//      region-carrying parameter may not return `[Int]` — "its storage lives in a region and would
//      not outlive it" — so the round constants are written as a local literal and copied into an
//      array the caller owns. `sha256(data)` can return `[Int]` because `data` carries the
//      caller's region in.
//   2. **The constant table is built once per call and passed down**, not rebuilt per block. A
//      `const` may not be an array (`a const is a literal with a name, and [Int] has no literal to
//      name`), so there is nowhere else to put it. The message schedule `w` is allocated once per
//      call for the same reason — a fresh 64-entry array per block would be 16,384 allocations for
//      a one-megabyte input.
//   3. **The message is never copied.** Padding appends to the *last block* — the final partial block plus
//      the length — and the whole blocks are read straight out of the caller's array. Copying a
//      megabyte in order to append nine bytes to it is the kind of thing a hash library does once
//      and everybody pays for forever.
//
// Arrays are handles here as everywhere: `let mutable u: [Int] = block;` does **not** copy, it
// aliases. `pbkdf2_sha256` copies element by element for that reason, and it is commented at the
// line rather than left to be discovered.
//
// ============================================================================
// NAMING — the algorithm name IS the prefix
// ============================================================================
//
// `lib/README.md` says every function is prefixed with its module, and these are not: `sha256`,
// not `hash_sha256`. The reason the prefix rule exists is that a short name collides with what a
// program would plausibly call its own function. `sha256`, `hmac_sha512` and `crc32` are not
// plausible names for anything else — they are the words the standards use, and a reviewer
// checking a digest against FIPS 180-4 should be reading the same word FIPS prints. The helpers
// that are *not* standard names — `hash_hex`, `hash_mask_32`, `hash_rotate_right_64` — do carry
// the prefix.
//
// A `_text` suffix means the same function with String arguments instead of byte arrays. It is a
// convenience over `to_bytes` from `lib/string.bx` and nothing more; the byte-array form is the
// real one, because a key or a salt is not always text.
//
// ============================================================================
// WHAT THIS FILE CANNOT DO, SAID HERE RATHER THAN DISCOVERED
// ============================================================================
//
//   * **A secret cannot be erased.** A String or an array lives until its region closes and there
//     is no `zeroise`. A password handed to `pbkdf2_sha256` stays in memory until the region ends.
//     This is `spec/1.0/ROADMAP-1.0.md` §E6 and it is a 1.0 limitation, not an oversight.
//   * **There is no CSPRNG.** Nothing here generates a salt; `lib/random.bx` is seeded and
//     reproducible on purpose, which is precisely wrong for a salt or a key. §E3.
//   * **"Constant time" here means no secret-dependent branch or early exit** — see
//     `hash_equals_constant_time`. It is not a timing guarantee, because this language does not
//     control instruction selection or the cache. It removes the mistake that is visible in the
//     source, which is the one that gets made.
//   * **There is no streaming interface.** Everything takes the whole message at once, so hashing
//     a file means holding the file. `sha256` itself uses fixed memory beyond its input, so the
//     limit is the input, and a streaming form is a later addition rather than a rewrite.
// ============================================================================

use "string.bx";

// ============================================================================
// Widths, built from the bit operations
// ============================================================================

// The low 32 bits. Named because it appears at the end of nearly every SHA-256 line and
// `0xFFFFFFFF` written out forty times is forty chances to write `0xFFFFFFF`.
const MASK_32: Int = 0xFFFFFFFF;

pure function hash_mask_32(x: Int) -> Int {
    return bit_and(x, MASK_32);
}

// Rotate a 32-bit word right by `n`, in a 64-bit register.
//
// The mask is the whole point: `shift_left(x, 32 - n)` pushes bits into positions 32..63, which do
// not exist in the u32 this is pretending to be. They must be discarded here, before the caller
// xors this into anything.
//
// `n == 0` would ask for `shift_left(x, 32)`, which is defined (it is a shift by less than the
// register width) and gives the right answer once masked. No round in SHA-256 rotates by 0.
pure function hash_rotate_right_32(x: Int, n: Int) -> Int
    requires n >= 0
    requires n < 32
{
    return hash_mask_32(bit_or(shift_right_zeros(x, n), shift_left(x, 32 - n)));
}

// Rotate a 64-bit word right by `n`. No mask, because 64 bits is the whole register — what leaves
// the top is exactly what should be arriving at the bottom, and `bit_or` puts it there.
//
// `n` must not be 0: `shift_left(x, 64)` shifts by the full register width, which the hardware
// does not define. No round in SHA-512 rotates by 0, and the precondition says so rather than
// leaving it to be discovered on some other machine.
pure function hash_rotate_right_64(x: Int, n: Int) -> Int
    requires n > 0
    requires n < 64
{
    return bit_or(shift_right_zeros(x, n), shift_left(x, 64 - n));
}

// `a + b` discarding the carry out of bit 63 — the addition SHA-512 is defined on, which `+`
// cannot do because `+` traps.
//
// Split both into 32-bit halves and add the halves: each partial sum is at most 2^33, so no `+`
// here can trap. The carry out of the low half is bit 32 of `low`, which is why the high half adds
// `shift_right_zeros(low, 32)`. The carry out of the high half is discarded by the mask, which is
// what "wrapping" means.
//
// Eleven operations, always the same eleven. `lib/math.bx`'s `math_wrapping_add` is a half-adder
// loop whose length depends on the operands — correct, general, and the wrong shape for a function
// called five hundred times per block.
pure function hash_add_wrapping_64(a: Int, b: Int) -> Int {
    let low: Int = bit_and(a, MASK_32) + bit_and(b, MASK_32);
    let high: Int = shift_right_zeros(a, 32) + shift_right_zeros(b, 32) + shift_right_zeros(low, 32);
    return bit_or(shift_left(bit_and(high, MASK_32), 32), bit_and(low, MASK_32));
}

// `a * b` keeping the low 64 bits — what FNV-1a's multiply-by-a-prime step needs.
//
// Sixteen-bit limbs, because that is the largest split whose partial products fit: two 16-bit
// values multiply to at most 2^32, and four of those sum to less than 2^34, so nothing here
// approaches i64's limit. Products whose place value is 2^64 or above vanish modulo 2^64 and are
// simply not computed — that is the `i + j <= 3` in the sum, written out as four groups.
//
// `shift_left` discarding what leaves the top is doing real work in the last two terms: `s2 << 32`
// and `s3 << 48` both overflow the register, and dropping the excess is exactly correct modulo
// 2^64.
//
// This is here rather than in `lib/math.bx` because `math_wrapping_mul` is shift-and-add over 64
// bits, each step calling the looping `math_wrapping_add` — roughly 400 operations against these
// 30. Worth moving there one day; noted rather than done, because that file is not this one's.
pure function hash_multiply_wrapping_64(a: Int, b: Int) -> Int {
    let a0: Int = bit_and(a, 0xFFFF);
    let a1: Int = bit_and(shift_right_zeros(a, 16), 0xFFFF);
    let a2: Int = bit_and(shift_right_zeros(a, 32), 0xFFFF);
    let a3: Int = bit_and(shift_right_zeros(a, 48), 0xFFFF);
    let b0: Int = bit_and(b, 0xFFFF);
    let b1: Int = bit_and(shift_right_zeros(b, 16), 0xFFFF);
    let b2: Int = bit_and(shift_right_zeros(b, 32), 0xFFFF);
    let b3: Int = bit_and(shift_right_zeros(b, 48), 0xFFFF);
    let s0: Int = a0 * b0;
    let s1: Int = a0 * b1 + a1 * b0;
    let s2: Int = a0 * b2 + a1 * b1 + a2 * b0;
    let s3: Int = a0 * b3 + a1 * b2 + a2 * b1 + a3 * b0;
    let sum: Int = hash_add_wrapping_64(s0, shift_left(s1, 16));
    return hash_add_wrapping_64(sum, hash_add_wrapping_64(shift_left(s2, 32), shift_left(s3, 48)));
}

// ============================================================================
// Hex — the only String this file builds, and §D0 governs it
// ============================================================================

pure function hash_hex_digit(value: Int) -> String
    requires value >= 0
    requires value < 16
{
    if value < 10 {
        return byte_as_string(48 + value);
    }
    // 97 is 'a', so 97 - 10 = 87. Lowercase, because every published vector is printed lowercase
    // and a reviewer comparing two strings should not have to case-fold first.
    return byte_as_string(87 + value);
}

// A digest as lowercase hex — the form every standard prints its vectors in, and the form to
// compare against one.
//
// §D0: pieces into a chunk list, joined pairwise. A 32-byte digest never needs it; the loop that
// hashes a directory and hexes every answer does, and this is the code that gets copied.
pure function hash_hex(digest: [Int]) -> String {
    let mutable chunks: [String] = [];
    let mutable pending: String = "";
    let n: Int = len(digest);
    for i in 0..n {
        let byte: Int = digest[i];
        pending = pending + hash_hex_digit(shift_right_zeros(byte, 4)) + hash_hex_digit(bit_and(byte, 15));
        if len(pending) >= 32 {
            push(chunks, pending);
            pending = "";
        }
    }
    if len(pending) > 0 {
        push(chunks, pending);
    }
    return string_join_chunks(chunks);
}

// The low `width` bytes of `value` as lowercase hex, big-endian — for printing a `crc32` or an
// `fnv1a_64`, which answer an Int rather than a digest.
//
// `fnv1a_64`'s answer is frequently negative, because a u64 above 2^63 is stored as the i64 with
// the same bits. Printing it as a decimal Int is legal and useless; printing it here gives the
// sixteen characters the FNV reference page prints.
pure function hash_hex_int(value: Int, width: Int) -> String
    requires width > 0
    requires width <= 8
{
    let mutable bytes: [Int] = [];
    for i in 0..width {
        push(bytes, bit_and(shift_right_zeros(value, 8 * (width - 1 - i)), 0xFF));
    }
    return hash_hex(bytes);
}

// Whether two digests are equal, without an early exit.
//
// **The name is the documentation and it is spelled out for the reason `shift_right_zeros` is.**
// The ordinary comparison stops at the first differing byte, so the time it takes tells an
// attacker how many leading bytes of a forged MAC were right — and a MAC can then be found one
// byte at a time instead of all at once. This reads every byte of both, always.
//
// **It is not a timing guarantee and must not be sold as one.** Burxt does not control instruction
// selection, branch prediction or the cache, and nothing at this level can. What it removes is the
// data-dependent branch that is visible in the source, which is the mistake that actually gets
// made. Lengths are compared normally: the length of a digest is not a secret.
pure function hash_equals_constant_time(a: [Int], b: [Int]) -> Bool {
    if len(a) != len(b) {
        return false;
    }
    let mutable differences: Int = 0;
    for i in 0..len(a) {
        differences = bit_or(differences, bit_xor(a[i], b[i]));
    }
    return differences == 0;
}

// ============================================================================
// CHECKSUMS — NOT cryptographic. Read the header before using one.
// ============================================================================

// CRC-32/ISO-HDLC — the one in zip, gzip, PNG and Ethernet. Reflected, polynomial 0xEDB88320,
// initial and final xor 0xFFFFFFFF.
//
// **Promoted out of `tests/pass/bits.bx`, where it was written in v0.0.199 as proof that the new
// bit operations were enough to compute a real checksum.** It was correct there and is unchanged
// here, which is why this is `spec/1.0/ROADMAP-1.0.md` §E4 and the cheapest item on that board: the
// work was done, in the wrong place. The fixture keeps its own copy, deliberately — it is a
// demonstration that a reader can build a checksum from `bit_*` alone, and importing the answer
// from a library would delete the thing it demonstrates.
//
// Bit-at-a-time, no table. A 256-entry table is four times faster and would have to be built per
// call, since a `const` cannot be an array; when a caller measures this as the bottleneck the
// table belongs in their loop, built once.
pure function crc32_byte(crc: Int, byte: Int) -> Int {
    let mutable c: Int = bit_xor(crc, byte);
    for bit in 0..8 {
        if bit_and(c, 1) == 1 {
            c = bit_xor(shift_right_zeros(c, 1), 0xEDB88320);
        } else {
            c = shift_right_zeros(c, 1);
        }
    }
    return c;
}

pure function crc32(data: [Int]) -> Int {
    let mutable crc: Int = 0xFFFFFFFF;
    let n: Int = len(data);
    for i in 0..n {
        crc = crc32_byte(crc, data[i]);
    }
    return hash_mask_32(bit_xor(crc, 0xFFFFFFFF));
}

pure function crc32_text(text: String) -> Int {
    let mutable crc: Int = 0xFFFFFFFF;
    let n: Int = len(text);
    for i in 0..n {
        crc = crc32_byte(crc, byte_at(text, i));
    }
    return hash_mask_32(bit_xor(crc, 0xFFFFFFFF));
}

// FNV-1a — Fowler/Noll/Vo, the 1a variant: xor the byte in first, then multiply.
//
// **Here for the case CRC-32 is wrong for and a SHA is absurd for: a hash table index, a shard
// number, a change-detection fingerprint** — somewhere the answer must be the same on every
// machine and in every version, which rules out anything randomised, and must cost a few
// instructions per byte, which rules out SHA-256. It is not cryptographic and not close to it.
//
// `hash` is a Burxt builtin and gives no such promise: it is whatever the runtime finds convenient
// for a `Map` key. **`fnv1a_64` is the one to write into a file**; the builtin is the one to leave
// inside a data structure.
//
// The offset basis and the prime are the published constants. 0xcbf29ce484222325 is above 2^63 and
// therefore a negative Int — the same bits, and every operation below is a bit operation.
const FNV_OFFSET_32: Int = 0x811C9DC5;
const FNV_PRIME_32: Int = 16777619;
const FNV_OFFSET_64: Int = 0xCBF29CE484222325;
const FNV_PRIME_64: Int = 1099511628211;

// The multiply needs no wrapping helper: the hash is under 2^32 and the prime is under 2^25, so
// the product is under 2^57 and `*` cannot trap. Mask after, exactly as SHA-256 does.
pure function fnv1a_32(data: [Int]) -> Int {
    let mutable h: Int = FNV_OFFSET_32;
    let n: Int = len(data);
    for i in 0..n {
        h = hash_mask_32(bit_xor(h, data[i]) * FNV_PRIME_32);
    }
    return h;
}

pure function fnv1a_32_text(text: String) -> Int {
    let mutable h: Int = FNV_OFFSET_32;
    let n: Int = len(text);
    for i in 0..n {
        h = hash_mask_32(bit_xor(h, byte_at(text, i)) * FNV_PRIME_32);
    }
    return h;
}

// The 64-bit multiply overflows for almost every input, so it goes through the limb multiply.
// `hash_hex_int(fnv1a_64(...), 8)` is how to print one.
pure function fnv1a_64(data: [Int]) -> Int {
    let mutable h: Int = FNV_OFFSET_64;
    let n: Int = len(data);
    for i in 0..n {
        h = hash_multiply_wrapping_64(bit_xor(h, data[i]), FNV_PRIME_64);
    }
    return h;
}

pure function fnv1a_64_text(text: String) -> Int {
    let mutable h: Int = FNV_OFFSET_64;
    let n: Int = len(text);
    for i in 0..n {
        h = hash_multiply_wrapping_64(bit_xor(h, byte_at(text, i)), FNV_PRIME_64);
    }
    return h;
}

// ============================================================================
// SHA-256 — FIPS 180-4
// ============================================================================

const SHA256_BLOCK: Int = 64;
const SHA256_DIGEST: Int = 32;

// The sixty-four round constants: the first 32 bits of the fractional part of the cube root of
// each of the first 64 primes. Filled into an array the caller owns, because a function with no
// region-carrying parameter cannot return one and a `const` cannot be an array.
function sha256_k(mutable into: [Int]) -> Int {
    let table: [Int] = [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
        0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
        0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
        0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
        0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
        0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
        0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
        0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
        0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
    ];
    for t in 0..len(table) {
        push(into, table[t]);
    }
    return len(into);
}

// One 64-byte block, folded into the eight-word state `h`.
//
// `w` is the caller's 64-entry scratch array and is overwritten here — it is passed in rather than
// allocated because this is called once per block and a megabyte is sixteen thousand blocks.
//
// Every `+` in this function is between values under 2^32, in groups of at most five, so the
// largest intermediate is under 2^35 and none of them can trap. The `hash_mask_32` goes at the end
// of the sum, never between the terms.
function sha256_block(mutable h: [Int], mutable w: [Int], message: [Int], at: Int, k: [Int]) -> Int {
    for t in 0..16 {
        let b: Int = at + 4 * t;
        w[t] = bit_or(bit_or(shift_left(message[b], 24), shift_left(message[b + 1], 16)),
                      bit_or(shift_left(message[b + 2], 8), message[b + 3]));
    }
    for t in 16..64 {
        let x: Int = w[t - 15];
        let y: Int = w[t - 2];
        let s0: Int = bit_xor(bit_xor(hash_rotate_right_32(x, 7), hash_rotate_right_32(x, 18)),
                              shift_right_zeros(x, 3));
        let s1: Int = bit_xor(bit_xor(hash_rotate_right_32(y, 17), hash_rotate_right_32(y, 19)),
                              shift_right_zeros(y, 10));
        w[t] = hash_mask_32(w[t - 16] + s0 + w[t - 7] + s1);
    }
    let mutable a: Int = h[0];
    let mutable b: Int = h[1];
    let mutable c: Int = h[2];
    let mutable d: Int = h[3];
    let mutable e: Int = h[4];
    let mutable f: Int = h[5];
    let mutable g: Int = h[6];
    let mutable last: Int = h[7];
    for t in 0..64 {
        let s1: Int = bit_xor(bit_xor(hash_rotate_right_32(e, 6), hash_rotate_right_32(e, 11)),
                              hash_rotate_right_32(e, 25));
        // `bit_not(e)` sets every bit above 31 too; `bit_and` with `g`, which is a u32, clears them
        // again. No mask needed and none written, because one that does nothing is a lie about
        // where the danger is.
        let ch: Int = bit_xor(bit_and(e, f), bit_and(bit_not(e), g));
        let t1: Int = hash_mask_32(last + s1 + ch + k[t] + w[t]);
        let s0: Int = bit_xor(bit_xor(hash_rotate_right_32(a, 2), hash_rotate_right_32(a, 13)),
                              hash_rotate_right_32(a, 22));
        let maj: Int = bit_xor(bit_xor(bit_and(a, b), bit_and(a, c)), bit_and(b, c));
        let t2: Int = hash_mask_32(s0 + maj);
        last = g;
        g = f;
        f = e;
        e = hash_mask_32(d + t1);
        d = c;
        c = b;
        b = a;
        a = hash_mask_32(t1 + t2);
    }
    h[0] = hash_mask_32(h[0] + a);
    h[1] = hash_mask_32(h[1] + b);
    h[2] = hash_mask_32(h[2] + c);
    h[3] = hash_mask_32(h[3] + d);
    h[4] = hash_mask_32(h[4] + e);
    h[5] = hash_mask_32(h[5] + f);
    h[6] = hash_mask_32(h[6] + g);
    h[7] = hash_mask_32(h[7] + last);
    return 0;
}

// SHA-256 of `data`, as 32 bytes. `hash_hex` turns it into the sixty-four characters a vector is
// printed as.
//
// The padding is the part worth reading twice, because it is where a hash that is right on "abc"
// goes wrong. The message gets one 0x80 byte, then zeros until the length is 56 modulo 64, then
// the length **in bits** as eight big-endian bytes. When the remainder is 56 or more, that fills
// one block and spills into a second — the `while` handles both without a special case, and the
// 64-byte and 119..128-byte fixtures are there to prove it.
//
// Only the final block is built: whole blocks are read out of `data` where they lie.
//
// (`tail` would have been the name; it is a keyword in this language.)
function sha256(data: [Int]) -> [Int] {
    let n: Int = len(data);
    let mutable h: [Int] = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
                            0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
    let mutable w: [Int] = [];
    for t in 0..64 {
        push(w, 0);
    }
    let mutable k: [Int] = [];
    sha256_k(k);

    let whole: Int = n - remainder(n, SHA256_BLOCK);
    let mutable at: Int = 0;
    while at < whole {
        sha256_block(h, w, data, at, k);
        at += SHA256_BLOCK;
    }

    let mutable last_block: [Int] = [];
    for i in whole..n {
        push(last_block, data[i]);
    }
    push(last_block, 0x80);
    while remainder(len(last_block), SHA256_BLOCK) != 56 {
        push(last_block, 0);
    }
    // `n * 8` would trap for an input over 2^60 bytes, which is an exabyte. The trap is the right
    // answer there: it says the length field is about to be wrong rather than silently wrapping it.
    let bits: Int = n * 8;
    for j in 0..8 {
        push(last_block, bit_and(shift_right_zeros(bits, 8 * (7 - j)), 0xFF));
    }
    at = 0;
    while at < len(last_block) {
        sha256_block(h, w, last_block, at, k);
        at += SHA256_BLOCK;
    }

    let mutable out: [Int] = [];
    for i in 0..8 {
        for j in 0..4 {
            push(out, bit_and(shift_right_zeros(h[i], 8 * (3 - j)), 0xFF));
        }
    }
    return out;
}

function sha256_text(text: String) -> [Int] {
    return sha256(to_bytes(text));
}

// ============================================================================
// SHA-512 — FIPS 180-4. Same shape, 64-bit words, 80 rounds, 128-byte blocks.
// ============================================================================

const SHA512_BLOCK: Int = 128;
const SHA512_DIGEST: Int = 64;

// The eighty round constants: the first 64 bits of the fractional part of the cube root of each of
// the first 80 primes. **These were generated from the cube roots rather than transcribed** — 80
// sixteen-digit constants is 1,280 characters and a single wrong one produces a hash that is wrong
// only for some inputs. The first (0x428a2f98d728ae22) and the last (0x6c44198c4a475817) are the
// two FIPS 180-4 prints in full, and they match.
//
// Each value above 2^63 is a negative Int holding the right bits. Nothing here compares them.
function sha512_k(mutable into: [Int]) -> Int {
    let table: [Int] = [
        0x428a2f98d728ae22, 0x7137449123ef65cd, 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc,
        0x3956c25bf348b538, 0x59f111f1b605d019, 0x923f82a4af194f9b, 0xab1c5ed5da6d8118,
        0xd807aa98a3030242, 0x12835b0145706fbe, 0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2,
        0x72be5d74f27b896f, 0x80deb1fe3b1696b1, 0x9bdc06a725c71235, 0xc19bf174cf692694,
        0xe49b69c19ef14ad2, 0xefbe4786384f25e3, 0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65,
        0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5,
        0x983e5152ee66dfab, 0xa831c66d2db43210, 0xb00327c898fb213f, 0xbf597fc7beef0ee4,
        0xc6e00bf33da88fc2, 0xd5a79147930aa725, 0x06ca6351e003826f, 0x142929670a0e6e70,
        0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed, 0x53380d139d95b3df,
        0x650a73548baf63de, 0x766a0abb3c77b2a8, 0x81c2c92e47edaee6, 0x92722c851482353b,
        0xa2bfe8a14cf10364, 0xa81a664bbc423001, 0xc24b8b70d0f89791, 0xc76c51a30654be30,
        0xd192e819d6ef5218, 0xd69906245565a910, 0xf40e35855771202a, 0x106aa07032bbd1b8,
        0x19a4c116b8d2d0c8, 0x1e376c085141ab53, 0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8,
        0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3,
        0x748f82ee5defb2fc, 0x78a5636f43172f60, 0x84c87814a1f0ab72, 0x8cc702081a6439ec,
        0x90befffa23631e28, 0xa4506cebde82bde9, 0xbef9a3f7b2c67915, 0xc67178f2e372532b,
        0xca273eceea26619c, 0xd186b8c721c0c207, 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178,
        0x06f067aa72176fba, 0x0a637dc5a2c898a6, 0x113f9804bef90dae, 0x1b710b35131c471b,
        0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c,
        0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817
    ];
    for t in 0..len(table) {
        push(into, table[t]);
    }
    return len(into);
}

// One 128-byte block. Every addition goes through `hash_add_wrapping_64`, because at this width
// `+` traps — that single difference from `sha256_block` is what 64-bit words cost.
function sha512_block(mutable h: [Int], mutable w: [Int], message: [Int], at: Int, k: [Int]) -> Int {
    for t in 0..16 {
        let b: Int = at + 8 * t;
        let mutable word: Int = 0;
        for j in 0..8 {
            word = bit_or(shift_left(word, 8), message[b + j]);
        }
        w[t] = word;
    }
    for t in 16..80 {
        let x: Int = w[t - 15];
        let y: Int = w[t - 2];
        let s0: Int = bit_xor(bit_xor(hash_rotate_right_64(x, 1), hash_rotate_right_64(x, 8)),
                              shift_right_zeros(x, 7));
        let s1: Int = bit_xor(bit_xor(hash_rotate_right_64(y, 19), hash_rotate_right_64(y, 61)),
                              shift_right_zeros(y, 6));
        w[t] = hash_add_wrapping_64(hash_add_wrapping_64(w[t - 16], s0),
                                    hash_add_wrapping_64(w[t - 7], s1));
    }
    let mutable a: Int = h[0];
    let mutable b: Int = h[1];
    let mutable c: Int = h[2];
    let mutable d: Int = h[3];
    let mutable e: Int = h[4];
    let mutable f: Int = h[5];
    let mutable g: Int = h[6];
    let mutable last: Int = h[7];
    for t in 0..80 {
        let s1: Int = bit_xor(bit_xor(hash_rotate_right_64(e, 14), hash_rotate_right_64(e, 18)),
                              hash_rotate_right_64(e, 41));
        let ch: Int = bit_xor(bit_and(e, f), bit_and(bit_not(e), g));
        let t1: Int = hash_add_wrapping_64(hash_add_wrapping_64(hash_add_wrapping_64(last, s1),
                                                                hash_add_wrapping_64(ch, k[t])),
                                           w[t]);
        let s0: Int = bit_xor(bit_xor(hash_rotate_right_64(a, 28), hash_rotate_right_64(a, 34)),
                              hash_rotate_right_64(a, 39));
        let maj: Int = bit_xor(bit_xor(bit_and(a, b), bit_and(a, c)), bit_and(b, c));
        let t2: Int = hash_add_wrapping_64(s0, maj);
        last = g;
        g = f;
        f = e;
        e = hash_add_wrapping_64(d, t1);
        d = c;
        c = b;
        b = a;
        a = hash_add_wrapping_64(t1, t2);
    }
    h[0] = hash_add_wrapping_64(h[0], a);
    h[1] = hash_add_wrapping_64(h[1], b);
    h[2] = hash_add_wrapping_64(h[2], c);
    h[3] = hash_add_wrapping_64(h[3], d);
    h[4] = hash_add_wrapping_64(h[4], e);
    h[5] = hash_add_wrapping_64(h[5], f);
    h[6] = hash_add_wrapping_64(h[6], g);
    h[7] = hash_add_wrapping_64(h[7], last);
    return 0;
}

// SHA-512 of `data`, as 64 bytes.
//
// The length field is **128 bits**, not 64 — eight zero bytes then the eight that carry the bit
// count. Writing only eight bytes here is the other classic SHA-512 bug: it produces a hash that
// is right for every input under 112 bytes and wrong for everything above, which the 896-bit
// fixture catches.
function sha512(data: [Int]) -> [Int] {
    let n: Int = len(data);
    let mutable h: [Int] = [0x6a09e667f3bcc908, 0xbb67ae8584caa73b, 0x3c6ef372fe94f82b,
                            0xa54ff53a5f1d36f1, 0x510e527fade682d1, 0x9b05688c2b3e6c1f,
                            0x1f83d9abfb41bd6b, 0x5be0cd19137e2179];
    let mutable w: [Int] = [];
    for t in 0..80 {
        push(w, 0);
    }
    let mutable k: [Int] = [];
    sha512_k(k);

    let whole: Int = n - remainder(n, SHA512_BLOCK);
    let mutable at: Int = 0;
    while at < whole {
        sha512_block(h, w, data, at, k);
        at += SHA512_BLOCK;
    }

    let mutable last_block: [Int] = [];
    for i in whole..n {
        push(last_block, data[i]);
    }
    push(last_block, 0x80);
    while remainder(len(last_block), SHA512_BLOCK) != 112 {
        push(last_block, 0);
    }
    let bits: Int = n * 8;
    for j in 0..8 {
        push(last_block, 0);
    }
    for j in 0..8 {
        push(last_block, bit_and(shift_right_zeros(bits, 8 * (7 - j)), 0xFF));
    }
    at = 0;
    while at < len(last_block) {
        sha512_block(h, w, last_block, at, k);
        at += SHA512_BLOCK;
    }

    let mutable out: [Int] = [];
    for i in 0..8 {
        for j in 0..8 {
            push(out, bit_and(shift_right_zeros(h[i], 8 * (7 - j)), 0xFF));
        }
    }
    return out;
}

function sha512_text(text: String) -> [Int] {
    return sha512(to_bytes(text));
}

// ============================================================================
// HMAC — RFC 2104, vectors from RFC 4231
// ============================================================================
//
// **Why HMAC exists and `sha256(key + message)` does not do**: SHA-256 is a Merkle-Damgård
// construction, so anyone holding `sha256(key + message)` and the length of the key can compute
// `sha256(key + message + extension)` **without knowing the key**. That is a length-extension
// forgery and it is a five-line attack. HMAC's two passes close it.
//
// The key path is the part that is got wrong. A key longer than the block size is **hashed first**
// and the digest becomes the key; a key shorter is **padded with zeros** to the block size. RFC
// 4231's cases 6 and 7 use a 131-byte key precisely to catch an implementation that skips the
// first rule, and both are in the fixture.
//
// This concatenates `ipad || message` into a new array, so a large message is copied once. For a
// large file, HMAC the digest rather than the file if the protocol allows it; a streaming form is
// the same later addition the header names.

function hmac_sha256(key: [Int], message: [Int]) -> [Int] {
    let mutable block_key: [Int] = [];
    if len(key) > SHA256_BLOCK {
        let shortened: [Int] = sha256(key);
        for i in 0..len(shortened) {
            push(block_key, shortened[i]);
        }
    } else {
        for i in 0..len(key) {
            push(block_key, key[i]);
        }
    }
    while len(block_key) < SHA256_BLOCK {
        push(block_key, 0);
    }

    let mutable inner: [Int] = [];
    for i in 0..SHA256_BLOCK {
        push(inner, bit_xor(block_key[i], 0x36));
    }
    for i in 0..len(message) {
        push(inner, message[i]);
    }
    let inner_digest: [Int] = sha256(inner);

    let mutable outer: [Int] = [];
    for i in 0..SHA256_BLOCK {
        push(outer, bit_xor(block_key[i], 0x5c));
    }
    for i in 0..len(inner_digest) {
        push(outer, inner_digest[i]);
    }
    return sha256(outer);
}

function hmac_sha256_text(key: String, message: String) -> [Int] {
    return hmac_sha256(to_bytes(key), to_bytes(message));
}

function hmac_sha512(key: [Int], message: [Int]) -> [Int] {
    let mutable block_key: [Int] = [];
    if len(key) > SHA512_BLOCK {
        let shortened: [Int] = sha512(key);
        for i in 0..len(shortened) {
            push(block_key, shortened[i]);
        }
    } else {
        for i in 0..len(key) {
            push(block_key, key[i]);
        }
    }
    while len(block_key) < SHA512_BLOCK {
        push(block_key, 0);
    }

    let mutable inner: [Int] = [];
    for i in 0..SHA512_BLOCK {
        push(inner, bit_xor(block_key[i], 0x36));
    }
    for i in 0..len(message) {
        push(inner, message[i]);
    }
    let inner_digest: [Int] = sha512(inner);

    let mutable outer: [Int] = [];
    for i in 0..SHA512_BLOCK {
        push(outer, bit_xor(block_key[i], 0x5c));
    }
    for i in 0..len(inner_digest) {
        push(outer, inner_digest[i]);
    }
    return sha512(outer);
}

function hmac_sha512_text(key: String, message: String) -> [Int] {
    return hmac_sha512(to_bytes(key), to_bytes(message));
}

// ============================================================================
// PBKDF2-HMAC-SHA256 — RFC 2898 / PKCS #5 v2.1
// ============================================================================
//
// **What it is for**: turning a password into a key, slowly. A password has far less entropy than
// a key, and `sha256` of one is tried a billion times a second on a GPU; `iterations` is the dial
// that makes each guess cost what it should. Also the standard way to stretch a passphrase into
// the bytes an encryption routine wants.
//
// **`iterations` is a policy decision and there is no default here on purpose.** A number baked
// into a library is a number nobody revisits, and this one has to rise as hardware does. OWASP's
// 2023 guidance for PBKDF2-HMAC-SHA256 is **600,000**; older systems hold data at 10,000, which
// was defensible when it was chosen and is not now. Pick a number, write down when you picked it.
//
// **This is not the strongest choice available.** PBKDF2 needs little memory, so custom hardware
// runs it far faster than a CPU does. Argon2id and scrypt resist that by design, and both are
// §E5 — bound, not built. PBKDF2 is here because it is buildable from SHA-256 alone, verifiable
// against published vectors, and enormously better than the storing-a-SHA-256 that its absence
// invites.
//
// **HMAC-SHA1 is not implemented**, which is why RFC 6070's vectors — all of them PBKDF2-HMAC-SHA1
// — cannot be used. The fixture uses the widely-published SHA-256 companion set (the "PBKDF2
// HMAC-SHA2 test vectors" that circulate alongside RFC 6070 and appear in most library test
// suites), and it also checks the construction against `hmac_sha256` directly: at one iteration
// the answer must be exactly `hmac_sha256(password, salt || 00000001)`, and at two it must be that
// xored with its own HMAC. Those two identities are the definition, and they hold independently of
// whether any remembered vector is right.
//
// No secret-dependent branching: the loop count comes from `iterations` and the lengths, never
// from the password or the digest.

function pbkdf2_sha256(password: [Int], salt: [Int], iterations: Int, length: Int) -> [Int]
    requires iterations >= 1
    requires length >= 1
{
    let mutable out: [Int] = [];
    let mutable index: Int = 1;
    while len(out) < length {
        // The salt for block `index` is `salt || INT(index)`, four bytes big-endian. Getting the
        // byte order wrong here gives a result that is self-consistent and matches nobody.
        let mutable seed: [Int] = [];
        for i in 0..len(salt) {
            push(seed, salt[i]);
        }
        for j in 0..4 {
            push(seed, bit_and(shift_right_zeros(index, 8 * (3 - j)), 0xFF));
        }

        // `accumulated` is the running xor and `previous` is the last U. **Both are copied element
        // by element rather than assigned**: an array is a handle, so `let previous = first` would
        // make the two names one array and the xor would eat its own input.
        let first: [Int] = hmac_sha256(password, seed);
        let mutable accumulated: [Int] = [];
        let mutable previous: [Int] = [];
        for i in 0..len(first) {
            push(accumulated, first[i]);
            push(previous, first[i]);
        }
        let mutable round: Int = 1;
        while round < iterations {
            let next: [Int] = hmac_sha256(password, previous);
            for i in 0..len(next) {
                accumulated[i] = bit_xor(accumulated[i], next[i]);
                previous[i] = next[i];
            }
            round += 1;
        }

        for i in 0..len(accumulated) {
            if len(out) < length {
                push(out, accumulated[i]);
            }
        }
        index += 1;
    }
    return out;
}

function pbkdf2_sha256_text(password: String, salt: String, iterations: Int, length: Int) -> [Int]
    requires iterations >= 1
    requires length >= 1
{
    return pbkdf2_sha256(to_bytes(password), to_bytes(salt), iterations, length);
}
