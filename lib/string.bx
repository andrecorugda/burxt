// ============================================================================
// lib/string.bx — Strings, beyond the four builtins.
//
//     use "lib/string.bx";
//
// A Burxt String is bytes, and the language gives you `len`, `byte_at`,
// `substring` and `+`. Everything here is written from those four, so nothing in
// this file can do something a program could not have done itself — which is the
// point of a standard library rather than a privileged one.
// ============================================================================

use "option.bx";

// Where `needle` first appears in `text`, or -1. The naive scan, deliberately:
// a compiler's lexer does not search, and a program that needs Boyer-Moore knows
// it does. Simple until measured.
function string_find(text: String, needle: String) -> Int {
    let n: Int = len(needle);
    if n == 0 {
        return 0;
    }
    let mutable i: Int = 0;
    while i + n <= len(text) {
        let mutable k: Int = 0;
        let mutable same: Bool = true;
        while k < n {
            if byte_at(text, i + k) != byte_at(needle, k) {
                same = false;
                k = n;
            } else {
                k += 1;
            }
        }
        if same {
            return i;
        }
        i += 1;
    }
    return 0 - 1;
}

function string_contains(text: String, needle: String) -> Bool {
    return string_find(text, needle) >= 0;
}

function string_starts_with(text: String, prefix: String) -> Bool {
    if len(prefix) > len(text) {
        return false;
    }
    let mutable i: Int = 0;
    while i < len(prefix) {
        if byte_at(text, i) != byte_at(prefix, i) {
            return false;
        }
        i += 1;
    }
    return true;
}

function string_ends_with(text: String, suffix: String) -> Bool {
    let n: Int = len(suffix);
    if n > len(text) {
        return false;
    }
    let base: Int = len(text) - n;
    let mutable i: Int = 0;
    while i < n {
        if byte_at(text, base + i) != byte_at(suffix, i) {
            return false;
        }
        i += 1;
    }
    return true;
}

// Whitespace removed from both ends: space, tab, newline, carriage return.
function string_trim(text: String) -> String {
    let mutable from: Int = 0;
    while from < len(text) && string_is_space(byte_at(text, from)) {
        from += 1;
    }
    let mutable to: Int = len(text);
    while to > from && string_is_space(byte_at(text, to - 1)) {
        to -= 1;
    }
    return substring(text, from, to - from);
}

function string_is_space(byte: Int) -> Bool {
    return byte == 32 || byte == 9 || byte == 10 || byte == 13;
}

// Split on a separator STRING. Answers a growable array, so the pieces are new Strings and they have
// to live somewhere.
//
// It took an `Int` until v0.0.188 — `string_split(text, 44)` for a comma — which meant a caller had to
// know ASCII codes, and `", "` and `"\r\n"` could not be split on at all. That is not an
// inconvenience, it is ordinary text handling out of reach: CSV with spaces after the commas, and any
// file written on Windows.
//
// One spelling per concept, so the byte form is gone rather than kept beside this. A separator is a
// string; that a one-character string is also a byte is not a second idea.
//
// An EMPTY separator answers the whole text as one piece rather than splitting into characters.
//
// ~~Burxt has no character type — a String is bytes — so "split into characters" is not a thing this
// could mean.~~ **That reason expired with A5 (v0.0.250).** A one-codepoint String is exactly what
// `char_at` answers, so "split into characters" now means something precise. The BEHAVIOUR here is
// unchanged and the decision is deliberately still open; what follows is the argument, not a ruling.
//
// The case for leaving it: an empty separator has **no forced answer**. It occurs between every pair
// of characters, and also at the start, at the end, and unboundedly often at each position — so
// "cut at every occurrence" does not determine a result. Python refuses `"abc".split("")` outright;
// JavaScript answers UTF-16 code units and cuts emoji in half. Neither is a spelling worth copying.
//
// And when there is more than one right answer, this project's habit is to make the caller pick by
// NAME — `divide_floor` against `divide_toward_zero`, `shift_right_zeros` against
// `shift_right_sign`, `string_to_upper_ascii` against a full mapping that does not exist yet. By
// that habit the codepoint split is a separate `string_chars(text) -> [String]`, six lines over
// `next_char`, and not a degenerate case of this one. It is not written, because which way this
// goes is not a call to make inside a comment.
//
// The one thing that would be wrong is silence: looping forever on a zero-width match.
function string_split(text: String, separator: String) -> [String] {
    let mutable pieces: [String] = [];
    let width: Int = len(separator);
    if width == 0 {
        let whole: Int = push(pieces, text);
        return pieces;
    }
    let mutable from: Int = 0;
    let mutable i: Int = 0;
    while i <= len(text) - width {
        if string_matches_at(text, separator, i) {
            let added: Int = push(pieces, substring(text, from, i - from));
            i += width;
            from = i;
        } else {
            i += 1;
        }
    }
    // The tail, always — so "a,b," answers three pieces, the last of them empty. A trailing separator
    // means an empty final field, which is what every CSV reader has to agree on.
    let last: Int = push(pieces, substring(text, from, len(text) - from));
    return pieces;
}

// Does `needle` sit at `at` in `text`? Compared in place, because `substring` would allocate once per
// position and a split has no business needing a region.
function string_matches_at(text: String, needle: String, at: Int) -> Bool {
    let width: Int = len(needle);
    if at < 0 || at + width > len(text) {
        return false;
    }
    let mutable k: Int = 0;
    while k < width {
        if byte_at(text, at + k) != byte_at(needle, k) {
            return false;
        }
        k += 1;
    }
    return true;
}

// Lines, on either ending. A CRLF file and an LF file split identically, which is the whole reason a
// multi-character separator had to exist: `"\r\n"` could not be written as a byte.
function string_lines(text: String) -> [String] {
    let mutable out: [String] = [];
    let pieces: [String] = string_split(text, "\n");
    let mutable i: Int = 0;
    while i < len(pieces) {
        let piece: String = pieces[i];
        // A bare `\r` before the newline belongs to the line ending, not to the line.
        if len(piece) > 0 && byte_at(piece, len(piece) - 1) == 13 {
            let added: Int = push(out, substring(piece, 0, len(piece) - 1));
        } else {
            let added: Int = push(out, piece);
        }
        i += 1;
    }
    return out;
}

// ---- Reading a number out of text ------------------------------------------
//
// Two functions, and the difference is whether a fallback is the right answer. That is the
// same pair `lib/map.bx` offers for a missing key — `get(key, fallback)` and `find(key)` — and
// it is deliberately NOT a `Result`: parsing a number is the most ordinary thing a program
// does with input, and making the ordinary case cost a `match` or a `?` would be the language
// charging you for its own strictness.
//
// It used to be one function returning a bare `Int`, and it answered **0** for anything it
// could not read. `"0"` and `"not a number"` were indistinguishable — a silent wrong answer, in
// the standard library of a language whose whole thesis is refusing them. Fixed in v0.0.152.

// The number, or the fallback you chose. Use this when a default is genuinely right — a
// missing count is zero, a missing page number is one.
//
//     let port: Int = string_to_int(configured, 8080);
function string_to_int(text: String, fallback: Int) -> Int {
    match string_parse_int(text) {
        None => { return fallback; }
        Some(n) => { return n; }
    }
}

// The number, or nothing — for when there is no sensible default and the program has to say
// what it does about bad input.
//
//     match string_parse_int(field) {
//         None    => { print("not a number: " + field); }
//         Some(n) => { print(n * 2); }
//     }
function string_parse_int(text: String) -> Option<Int> {
    if len(text) == 0 {
        return Option.None;
    }
    let mutable i: Int = 0;
    let mutable negative: Bool = false;
    if byte_at(text, 0) == 45 {
        negative = true;
        i = 1;
    }
    // `-` alone is not a number, which the old version read as 0.
    if i >= len(text) {
        return Option.None;
    }
    let mutable value: Int = 0;
    while i < len(text) {
        let b: Int = byte_at(text, i);
        if b < 48 || b > 57 {
            return Option.None;
        }
        value = value * 10 + (b - 48);
        i += 1;
    }
    if negative {
        return Option.Some(0 - value);
    }
    return Option.Some(value);
}

// The separator between each piece. The join a program would write, written once.
function string_join(pieces: [String], separator: String) -> String {
    if len(pieces) == 0 {
        return "";
    }
    let mutable out: String = pieces[0];
    let mutable i: Int = 1;
    while i < len(pieces) {
        out += separator + pieces[i];
        i += 1;
    }
    return out;
}

function string_repeat(text: String, times: Int) -> String {
    let mutable out: String = "";
    let mutable i: Int = 0;
    while i < times {
        out += text;
        i += 1;
    }
    return out;
}

// ============================================================================
// CODEPOINTS — roadmap A5, and it needed nothing from the compiler.
//
// `spec/A4.4` calls codepoint iteration its one remaining gap and `ROADMAP-1.0.md` files it under
// §A, compiler leverage. **It is not a compiler item.** Everything below is written from `byte_at`,
// `bit_and`, `substring` and `len` — the four things this file's header already promises — and both
// compilers accepted it unchanged on the first try. Measured before anything was touched, which is
// the only reason it is worth saying: A5 is a LIBRARY item that was mis-filed, and the four
// functions are the whole of it.
//
// `src/burxt-compiler/diag.bx` proved it first and its comment makes the argument: the question is
// not *"can I iterate codepoints"* but *"can I COUNT them"*, and in UTF-8 every byte after the first
// of a sequence matches `10xxxxxx`, so a codepoint count is the number of bytes that are **not**
// continuation bytes. No iterator, no char type, no new scalar.
//
// ---- the two decisions this obeys ------------------------------------------------------
//
// **No char type.** A single codepoint is a ONE-CODEPOINT STRING, not a new kind of value. So
// `char_at` answers a String and there is nothing new to teach `print`, `==`, `+` or a `match`
// about — which is the whole saving. `spec/ROADMAP-1.0.md`'s decisions list says *"no char type, no
// bare `s[i]`"*, and the second half is why there is no `s[i]` here either.
//
// **Explicit views rather than bare indexing.** `spec/A4.4` wants `.bytes()` / `.chars()` because
// bare indexing *"hides the silent-wrong-index class of bug"* — is `s[3]` the fourth byte or the
// fourth character? `len`/`byte_at` are the byte view and these are the codepoint view, and a
// reader can see which one they are in from the NAME rather than from the type.
//
// ---- how to walk, and why `next_char` exists ------------------------------------------
//
// There is no iterator protocol yet (A11), and half of one would be worse than none, so a walk is a
// plain `while`:
//
//     let mutable at: Int = 0;
//     while at < len(text) {
//         let ending: Int = next_char(text, at);
//         print(substring(text, at, ending - at));
//         at = ending;
//     }
//
// **`char_at` in a loop is O(n²) and this is not.** `char_at(s, i)` has to walk from the start to
// find the i'th codepoint, so counting up through it re-walks the prefix every time. `next_char`
// carries the position forward instead, which is what makes the other three cheap. Use `char_at`
// when you want ONE codepoint by position; use `next_char` when you want all of them.
//
// ---- what these assume about validity -------------------------------------------------
//
// `spec/A4.4` declares a String is UTF-8 and `spec/ROADMAP-1.0.md` §B5 records that the invariant is
// **declared and unenforced** at four entry points. That is not fixed here, so the honest statement
// is which of these rely on it:
//
//   * `char_count` and `char_at` ASSUME validity. On invalid bytes they answer something
//     well-defined but meaningless — a count of non-continuation bytes is not a codepoint count if
//     the bytes are not UTF-8.
//   * `next_char` assumes NOTHING and is total. An unexpected byte advances by one, which is the
//     standard resynchronisation, and the answer is clamped to `len(s)` so a truncated sequence at
//     the end cannot walk past it. **It never answers `at`**, which is the property a `while` loop
//     depends on: a walk cannot hang, whatever the bytes are.
//   * `is_valid_utf8` assumes nothing — deciding is its job.
// ============================================================================

// How many codepoints, not bytes. `char_count("héllo")` is 5 where `len` is 6.
//
// A continuation byte is `10xxxxxx`, so every byte that is not one begins a codepoint and the count
// is a single pass with no decoding. Assumes valid UTF-8: see the note above.
pure function char_count(text: String) -> Int {
    let mutable found: Int = 0;
    let mutable i: Int = 0;
    while i < len(text) {
        if bit_and(byte_at(text, i), 192) != 128 {
            found += 1;
        }
        i += 1;
    }
    return found;
}

// The byte offset one past the codepoint that starts at `at` — where the NEXT one begins.
//
// The width is in the leading byte and nowhere else, which is the property that makes UTF-8 walkable
// in one direction without a table: `0xxxxxxx` is one byte, `110xxxxx` two, `1110xxxx` three,
// `11110xxx` four.
//
// Total by construction, and both halves of that matter. It always advances at least one byte, so a
// `while at < len(text)` loop terminates on any input including bytes that are not UTF-8 at all; and
// it never answers past `len(text)`, so `substring(text, at, next_char(text, at) - at)` is in range
// even when the last sequence is truncated. An unexpected byte — a stray continuation, an `0xFF` —
// advances by one, which resynchronises rather than guessing.
pure function next_char(text: String, at: Int) -> Int {
    let stop: Int = len(text);
    if at >= stop {
        return stop;
    }
    let leading: Int = byte_at(text, at);
    let mutable ending: Int = at + 1;
    if bit_and(leading, 224) == 192 {
        ending = at + 2;
    }
    if bit_and(leading, 240) == 224 {
        ending = at + 3;
    }
    if bit_and(leading, 248) == 240 {
        ending = at + 4;
    }
    if ending > stop {
        return stop;
    }
    return ending;
}

// The `i`'th codepoint, as a one-codepoint String. There is no char type: see the header.
//
// A PRECONDITION rather than an empty String for an index out of range, which is this language's
// habit and the better answer here — an empty String would be a legal value that silently stands in
// for a mistake, and a caller comparing it against something would get `false` rather than a
// refusal. `requires` says the mistake out loud, at the call, naming the value.
//
// The second clause calls `char_count`, which is only possible because a contract clause may call a
// `pure` function — and that a `pure` FUNCTION may be called from a clause is older than A4. What A4
// added is the same for a method, so this composes without needing it.
//
// O(n) in `i`, so a loop counting up through it is O(n²). Use `next_char` to walk.
pure function char_at(text: String, i: Int) -> String
    requires i >= 0
    requires i < char_count(text)
{
    let mutable at: Int = 0;
    let mutable seen: Int = 0;
    while seen < i {
        at = next_char(text, at);
        seen += 1;
    }
    return substring(text, at, next_char(text, at) - at);
}

// Is every byte part of a well-formed UTF-8 sequence?
//
// The full rule, not the structural half. A checker that accepted overlong encodings and surrogates
// would be a blanket that reads like a rule — the shape that let `?` go unimplemented for its whole
// life — so the second byte's range depends on the leader, which is where the three exclusions live:
//
//   * **overlong**: `C0`/`C1` could only encode something a shorter sequence already can, and `E0`
//     and `F0` restrict the second byte for the same reason. Two spellings of one codepoint is how
//     a validator and a decoder come to disagree about a string.
//   * **surrogates**: `ED A0`..`ED BF` is U+D800..U+DFFF, which UTF-8 does not encode.
//   * **out of range**: past `F4 8F` is above U+10FFFF, which is not a codepoint.
//
// Assumes nothing. This is the function `spec/ROADMAP-1.0.md` §B5 would need if the declared-and-
// unenforced UTF-8 invariant were ever enforced at the four entry points — enforcing it is not done
// here, and having something to enforce it WITH is the part A5 delivers.
pure function is_valid_utf8(text: String) -> Bool {
    let stop: Int = len(text);
    let mutable i: Int = 0;
    while i < stop {
        let leading: Int = byte_at(text, i);
        let mutable width: Int = 0;
        let mutable low: Int = 128;
        let mutable high: Int = 191;
        if leading < 128 {
            width = 1;
        }
        if leading >= 194 && leading <= 223 {
            width = 2;
        }
        if leading == 224 {
            width = 3;
            low = 160;                               // no overlong three-byte form
        }
        if leading >= 225 && leading <= 236 {
            width = 3;
        }
        if leading == 237 {
            width = 3;
            high = 159;                              // no surrogate
        }
        if leading >= 238 && leading <= 239 {
            width = 3;
        }
        if leading == 240 {
            width = 4;
            low = 144;                               // no overlong four-byte form
        }
        if leading >= 241 && leading <= 243 {
            width = 4;
        }
        if leading == 244 {
            width = 4;
            high = 143;                              // nothing above U+10FFFF
        }
        if width == 0 {
            return false;                            // a continuation byte, or 192, 193, 245..255
        }
        if i + width > stop {
            return false;                            // truncated
        }
        let mutable c: Int = 1;
        while c < width {
            let byte: Int = byte_at(text, i + c);
            // The first continuation byte carries the leader's extra restriction; the rest are the
            // plain `10xxxxxx`.
            let mutable least: Int = 128;
            let mutable most: Int = 191;
            if c == 1 {
                least = low;
                most = high;
            }
            if byte < least || byte > most {
                return false;
            }
            c += 1;
        }
        i += width;
    }
    return true;
}

// A continuation byte — `10xxxxxx`, the second and later byte of a multi-byte sequence, and never
// the first. §D1p asks for it by name, and it is one line, but it is the line every other function
// in this section is built on: `char_count` counts bytes that are NOT this, and `next_char` reads a
// width only from bytes that are NOT this.
//
// Takes a BYTE, not a String, and so is spelled like `string_is_space` — the two are the same kind
// of question asked of the same kind of value.
pure function is_continuation(byte: Int) -> Bool {
    return bit_and(byte, 192) == 128;
}

// The codepoint at codepoint index `i`, as a number. `codepoint_at("é", 0)` is 233.
//
// The companion to `char_at`, which answers the same character as a one-codepoint String. Two
// functions rather than one because the two answers are used for different things: a String goes
// into output and a comparison, a number goes into a range test and arithmetic. Neither is
// derivable from the other without the decode below, so having only one would make every caller
// write it.
//
// The width comes from `next_char` rather than from the leading byte a second time, which is what
// makes this total: `next_char` clamps to `len(text)`, so no read below can go past the end even on
// a truncated final sequence. It ASSUMES valid UTF-8 for its ANSWER — a truncated three-byte
// sequence decodes as though it were the two bytes that are there, which is a well-defined number
// and not the codepoint anyone meant. Same standing as `char_count` and `char_at`; see the section
// header.
//
// O(n) in `i` for the same reason `char_at` is. Walk with `next_char` if you want all of them.
pure function codepoint_at(text: String, i: Int) -> Int
    requires i >= 0
    requires i < char_count(text)
{
    let mutable at: Int = 0;
    let mutable seen: Int = 0;
    while seen < i {
        at = next_char(text, at);
        seen += 1;
    }
    let ending: Int = next_char(text, at);
    let width: Int = ending - at;
    let leading: Int = byte_at(text, at);
    if width == 1 {
        return leading;
    }
    // The leading byte carries the top bits and each continuation carries six more. The masks are
    // the complement of the width marker: `110xxxxx` keeps 5 bits, `1110xxxx` keeps 4, `11110xxx`
    // keeps 3.
    if width == 2 {
        return shift_left(bit_and(leading, 31), 6)
             + bit_and(byte_at(text, at + 1), 63);
    }
    if width == 3 {
        return shift_left(bit_and(leading, 15), 12)
             + shift_left(bit_and(byte_at(text, at + 1), 63), 6)
             + bit_and(byte_at(text, at + 2), 63);
    }
    return shift_left(bit_and(leading, 7), 18)
         + shift_left(bit_and(byte_at(text, at + 1), 63), 12)
         + shift_left(bit_and(byte_at(text, at + 2), 63), 6)
         + bit_and(byte_at(text, at + 3), 63);
}

// Every byte, as numbers. §D1p asks for it, and the honest note is that its partner `from_bytes`
// is NOT here — see the gap recorded at the bottom of this file. Bytes come out of a String
// freely; getting them back in is the thing this language cannot do yet.
//
// `len` and `byte_at` already give a caller this one byte at a time, so this exists for the case
// where the bytes have to be held: passed to a function, sorted, hashed, compared as a whole.
function to_bytes(text: String) -> [Int] {
    let mutable out: [Int] = [];
    for i in 0..len(text) {
        let added: Int = push(out, byte_at(text, i));
    }
    return out;
}

// The CODEPOINT index of `of`, or None. The companion to `string_find`, which answers a BYTE offset.
//
// **Both exist because they answer different questions, and mixing them corrupts text.** A byte
// offset is what `substring` takes; a codepoint index is what `char_at` takes and what a human
// counting characters means. In `"héllo"` the `l` is at byte 3 and character 2, and handing 3 to
// `char_at` reads the wrong character while handing 2 to `substring` splits the `é` in half. The
// names are the only thing standing between a caller and that bug, which is why neither is called
// `index_of`.
//
// Matches only on a CODEPOINT BOUNDARY, and that is a real difference from `string_find` rather
// than an implementation detail: searching `"é"` for the single byte `0xA9` succeeds byte-wise and
// has no codepoint index to answer, so this walks boundaries and compares from each one. A needle
// that only occurs straddling a character is reported as absent, which is the truthful answer to
// the question actually asked.
//
// An EMPTY needle answers `Some(0)`, matching `string_find`'s 0 — every string contains the empty
// string, at the beginning.
function char_index(text: String, of: String) -> Option<Int> {
    if len(of) == 0 {
        return Option.Some(0);
    }
    let mutable at: Int = 0;
    let mutable index: Int = 0;
    while at < len(text) {
        if string_matches_at(text, of, at) {
            return Option.Some(index);
        }
        at = next_char(text, at);
        index += 1;
    }
    return Option.None;
}

// ---- reversing, which is what a byte-wise version gets wrong -----------------------------

// The text, codepoint by codepoint, backwards. **`string_reverse("aé中🙂")` is `"🙂中éa"`.**
//
// This is the function §D1a has asked for since the first audit, and the reason it needed A5 is
// that **a byte-wise reverse corrupts every multi-byte character.** Reversing the bytes of `"é"`
// (`C3 A9`) gives `A9 C3`, which is not a character at all — a continuation byte followed by a
// leader. The output is not merely wrong, it is not UTF-8, and every downstream reader of it is
// entitled to do something different with it. Whole codepoints move; their bytes do not.
//
// ---- the limit, which the roadmap's word "codepoint-aware" states exactly ----
//
// This reverses CODEPOINTS, not what a reader would call characters, and the difference is visible:
//
//   * `"e" + U+0301` (a combining acute) renders as `é` and is TWO codepoints. Reversed, the accent
//     lands on whatever now precedes it. Still valid UTF-8, still the wrong picture.
//   * An emoji built from a zero-width-joiner sequence, or a flag built from two regional
//     indicators, comes apart the same way.
//
// The fix is grapheme-cluster segmentation, which needs the Unicode break tables — a generated
// data file, not a library function, and the same class of thing full case mapping needs. It is not
// here and this is not pretending otherwise. What IS guaranteed: the output is valid UTF-8 whenever
// the input is, and reversing twice returns the original exactly. Both are checked in
// `tests/pass/string_codepoints.bx` on text with two-, three- and four-byte characters.
//
// ---- the cost ----
//
// Built in 4 KB chunks rather than one prepend per character, which is the idiom this project has
// paid for three times (v0.0.68, v0.0.77, v0.0.82) and `lib/os.bx` uses for the same reason: a
// String is immutable, so `out = piece + out` copies everything already collected on every
// character and turns a reverse into O(n²). The chunk bounds that copy to 4 KB.
pure function string_reverse(text: String) -> String allocates {
    let mutable done: String = "";
    let mutable chunk: String = "";
    let mutable at: Int = 0;
    while at < len(text) {
        let ending: Int = next_char(text, at);
        // PREPEND: the piece read last ends up first.
        chunk = substring(text, at, ending - at) + chunk;
        if len(chunk) >= 4096 {
            done = chunk + done;
            chunk = "";
        }
        at = ending;
    }
    return chunk + done;
}

// ---- case, and the name is the decision -------------------------------------------------
//
// **`_ascii` is not a shorthand, it is the promise.** These map `a`..`z` and `A`..`Z`, and pass
// every other byte through unchanged. Two measured examples, both in the fixture:
//
//     string_to_upper_ascii("Straße")  ->  "STRAßE"      the ß is not touched
//     string_to_lower_ascii("ÉCOLE")   ->  "École"       the É is not touched
//
// The second one is the whole argument in one line: it looks like it worked. A caller who tests
// with `"ECOLE"` sees `"ecole"` and ships, and the failure surfaces on somebody else's data.
//
// The name carries the limit for the same reason `divide_floor` and `shift_right_zeros` do: there
// is more than one right answer and the caller must pick. A function called `string_to_upper` that
// silently ignored every character outside ASCII would be a silent wrong answer in the standard
// library of a language whose whole thesis is refusing them — and it is the wrong answer that is
// hardest to notice, because it is correct on all the test data an English-speaking author thinks
// to write.
//
// What full Unicode case mapping would need, so the gap is sized rather than gestured at:
//
//   * ~1,400 generated mapping entries, which is a data file the build produces, not a function.
//   * **`ß` upper-cases to `SS`** — one codepoint becoming two, so the answer is not the same
//     length in characters and no in-place mapping can express it.
//   * **Locale**: Turkish `i` upper-cases to `İ` (dotted), not `I`, so there is no single correct
//     answer without knowing the language. A function with no locale argument cannot be right.
//
// That is a module with a generated table and a locale parameter, and it is a different decision
// from this one. `spec/ROADMAP-1.0.md` §D1a is satisfied by naming the limit today.
//
// ---- why a BYTE-wise loop is safe here, which is not obvious ----
//
// Every byte of a multi-byte sequence is >= 0x80 and every ASCII letter is < 0x80, so a byte-wise
// pass **cannot touch a non-ASCII character** — there is no byte inside `é` or `中` that could be
// mistaken for a letter. That is a designed property of UTF-8 and the reason these need no
// codepoint walk, unlike `string_reverse`. The fixture checks it on real non-ASCII text rather than
// asserting it here.

// `a`..`z` become `A`..`Z`. Every other byte, ASCII or not, is passed through unchanged.
pure function string_to_upper_ascii(text: String) -> String allocates {
    let mutable done: String = "";
    let mutable chunk: String = "";
    for i in 0..len(text) {
        let byte: Int = byte_at(text, i);
        if byte >= 97 && byte <= 122 {
            chunk += ascii_letter(byte - 32);
        } else {
            chunk += substring(text, i, 1);
        }
        if len(chunk) >= 4096 {
            done += chunk;
            chunk = "";
        }
    }
    return done + chunk;
}

// `A`..`Z` become `a`..`z`. Every other byte, ASCII or not, is passed through unchanged.
pure function string_to_lower_ascii(text: String) -> String allocates {
    let mutable done: String = "";
    let mutable chunk: String = "";
    for i in 0..len(text) {
        let byte: Int = byte_at(text, i);
        if byte >= 65 && byte <= 90 {
            chunk += ascii_letter(byte + 32);
        } else {
            chunk += substring(text, i, 1);
        }
        if len(chunk) >= 4096 {
            done += chunk;
            chunk = "";
        }
    }
    return done + chunk;
}

// The one-byte String for an ASCII LETTER code, by table lookup.
//
// A table rather than arithmetic, because **there is no way to build a String from a byte value in
// this language** — see the gap at the bottom of the file. `substring` of a literal is the only
// Int-to-String path there is, and it works here precisely because the 52 letters are the only
// bytes these two functions ever need to produce.
//
// `requires` rather than a fallback: a code outside the two letter runs is a caller mistake, and
// answering `"?"` for it is how `os_byte_as_string` came to destroy data silently (roadmap §B2).
pure function ascii_letter(code: Int) -> String
    requires code >= 65
    requires code <= 122
    requires code <= 90 || code >= 97
{
    let upper: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    if code <= 90 {
        return substring(upper, code - 65, 1);
    }
    let lower: String = "abcdefghijklmnopqrstuvwxyz";
    return substring(lower, code - 97, 1);
}

// ---- cheap classification, §D1c ---------------------------------------------------------
//
// All three answer a question about the WHOLE String and all three are true of the empty String,
// which is the vacuous answer and the one that composes: "every byte is a digit" is true when there
// are no bytes. A caller who means "a non-empty run of digits" checks the length too, and that is
// clearer written at the call than hidden in one of these.

// Is every byte below 128? Equivalently: is this text unchanged by any of the byte-wise functions
// above, and safe to treat as one byte per character?
pure function is_ascii(text: String) -> Bool {
    for i in 0..len(text) {
        if byte_at(text, i) >= 128 {
            return false;
        }
    }
    return true;
}

// Is every byte `0`..`9`? **Not a number check** — no sign, no digit grouping, no bounds. It says
// what its name says, and `string_parse_int` is the one that answers whether the text is an Int.
// Arabic-Indic and Devanagari digits are NOT digits here, which follows from every byte being ASCII
// and is the same limit `_ascii` names elsewhere.
pure function all_digits(text: String) -> Bool {
    for i in 0..len(text) {
        let byte: Int = byte_at(text, i);
        if byte < 48 || byte > 57 {
            return false;
        }
    }
    return true;
}

// Is every byte an ASCII letter? Same ASCII-only limit: `é` is not alphabetic to this function, and
// a full answer needs the Unicode category tables that full case mapping needs.
pure function is_alpha(text: String) -> Bool {
    for i in 0..len(text) {
        let byte: Int = byte_at(text, i);
        if !(byte >= 65 && byte <= 90) && !(byte >= 97 && byte <= 122) {
            return false;
        }
    }
    return true;
}

// ============================================================================
// THE GAP: `from_codepoint`, `from_bytes` and `from_byte` are NOT here.
//
// §D1p asks for all three and they are the reason `\uXXXX` in JSON still cannot decode (§B9). They
// are not missing because they are hard to write. **There is no way to turn a number into a byte of
// a String in this language**, and every step of that was measured on v0.0.252 rather than assumed:
//
//   1. **No builtin does it.** The complete list is `len` `byte_at` `push` `read_file` `to_string`
//      `old` `substring` `truncate` `write_file` `argument` `argument_count` `divide_floor`
//      `divide_toward_zero` `remainder` `write_bytes` `hash` `bit_and` `bit_or` `bit_xor` `bit_not`
//      `shift_left` `shift_right_zeros` `shift_right_sign` `c_is_null` `c_string_at` `c_bytes_at`.
//      Nothing there is Int-to-String. `to_string(233)` is `"233"`, three digit characters.
//   2. **No escape names a byte.** Burxt strings support `\\ \" \n \r \t \0 \{ \}` and nothing else
//      — there is no `\xNN` and no `\uXXXX`. Checked against the lexer's own refusal message.
//   3. **So `substring` of a LITERAL is the only Int-to-String path**, which is what
//      `ascii_letter` above and `os_byte_as_string` both do. It can only produce bytes that appear
//      literally in the source.
//   4. **A source file must be valid UTF-8** — a raw `0xC4` byte in a literal is refused by the
//      reader, not the lexer: *"cannot read p3.bx: stream did not contain valid UTF-8"*. So a byte
//      >= 0x80 can only reach a literal as part of a complete multi-byte character.
//
// That last point is what closes the door. Continuation bytes are cheap: the 64 ordinary letters
// `"ÀÁÂ...ÿ"` encode as `C3 80`..`C3 BF`, so one readable literal yields every byte `0x80`..`0xBF`
// at its odd offsets. **The LEAD bytes are the problem.** A codepoint's UTF-8 lead is `0xC2`..`0xF4`,
// each value requires its own character from its own block, and that is 51 characters — of which
// **six are unassigned codepoints** (`0xCC` is combining marks, `0xEE` is the Private Use Area, and
// `0xF1`..`0xF4` are four empty planes). Counted, not estimated.
//
// A 51-character table of mixed scripts and invisible codepoints in the standard library is a
// liability rather than a clever trick: a reviewer cannot read it, `git diff` shows mojibake, and
// an editor that normalises Unicode silently breaks `from_codepoint` for a whole plane. So it is
// **not written**, and the decision is recorded here rather than made silently by omission.
//
// **What would unblock it: one builtin, and the smallest useful one is `byte_string(n) -> String`**
// — a one-byte String for `0 <= n <= 255`. Everything else is ordinary Burxt on top of it:
// `from_codepoint` becomes the four-branch encoder that mirrors `codepoint_at` above,
// `from_bytes(xs)` becomes a fold, `from_byte` retires `os_byte_as_string` and its `"?"` (§B2), and
// JSON `\uXXXX` decodes. That is the whole cluster behind one function the compiler already has the
// machinery for — `substring` builds a String of length 1 today.
//
// Recorded, not worked around. Nothing here returns a sentinel or a `"?"` in place of a byte it
// cannot build.
//
// ---- how to check whether this is still true -------------------------------------------
//
// Measured on **v0.0.252**. NO ROADMAP ITEM covers the builtin; §D1p lists the three functions as
// though they were library work, and this note is the argument that one of them is not.
//
//     check 1: does a byte-building builtin exist? `grep is_reserved_name src/rust-compiler/typeck.rs`
//     check 2: `let s: String = "a\xC4b";`               — expect: unknown escape
//     check 3: a file containing a raw 0xC4 in a literal — expect: not valid UTF-8
//
// If check 1 turns up something new, delete this whole block and write the four-branch encoder.
// ============================================================================
