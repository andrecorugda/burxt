// ============================================================================
// lib/os.bx — the machine the program is running on.
//
//     use "lib/os.bx";
//
// Arguments, the clock, running a command, and exiting with a code. Each one wraps
// a C function whose signature Burxt can actually describe — ints and strings in,
// an int out. Anything returning a pointer is absent, and the guide's chapter on
// the C boundary says why.
// ============================================================================

use "option.bx";

external function system(command: String) -> CInt touches commands;
external function time(unused: Int) -> Int touches clock;
external function getchar() -> CInt touches input;
// The pointer wall's first customer (v0.0.196). `getenv` hands back a `char*` that C owns for the
// life of the process, so Burxt copies the bytes and never keeps the pointer — see `os_env`.
external function getenv(name: String) -> CPointer touches input;

// The arguments the program was started with. Index 0 is the program's own path,
// as it is everywhere else.
function os_arg_count() -> Int touches input {
    return argument_count();
}

function os_arg(index: Int) -> String touches input {
    return argument(index);
}

// Every argument after the program's own name.
function os_args() -> [String] touches input {
    let mutable all: [String] = [];
    let mutable i: Int = 1;
    while i < argument_count() {
        let added: Int = push(all, argument(i));
        i += 1;
    }
    return all;
}

// Seconds since 1970. Whole seconds, because that is what `time` answers — a
// finer clock needs `clock_gettime`, which fills a class through a pointer, and
// that is exactly what Burxt will not let C do yet.
function os_now() -> Int touches clock {
    return time(0);
}

// Run a command through the shell and answer its exit code. `system` reports a
// wait status; the exit code is its high byte.
function os_run(command: String) -> Int touches commands {
    return divide_floor(system(command), 256);
}

// Run a command and answer what it printed. The output travels through a file
// because a pipe would mean `popen`, which answers a pointer.
function os_capture(command: String) -> String touches commands, files {
    let scratch: String = "/tmp/burxt-os-capture";
    let status: Int = system(command + " > " + scratch + " 2>&1");
    return read_file(scratch);
}

// One byte of standard input, or -1 at the end. The whole of the input, a byte at
// a time, is what a program can do today — `fgets` needs a buffer it does not own.
function os_read_byte() -> Int touches input {
    return getchar();
}

// One line of standard input, without its newline, or None at end of input.
//
// The distinction from `os_read_all` is the whole reason this exists: `os_read_all` blocks until EOF,
// which never arrives for a SERVER. A protocol that frames its messages one per line — MCP over
// stdio, and most of the others — needs to answer the first request before the client has sent the
// second, so reading to EOF is not a slow version of this, it is a deadlock.
//
// A bare `\r` before the newline is dropped, so a CRLF client and an LF client are read identically.
// Nothing else is stripped: a line is its bytes.
//
// `None` at end of input rather than an empty String, because an empty LINE is a real thing a client
// can send and the two must be distinguishable. That is the same reason `string_parse_int` exists
// beside `string_to_int`.
function os_read_line() -> Option<String> touches input {
    let mutable chunk: String = "";
    let mutable text: String = "";
    let mutable any: Bool = false;
    let mutable b: Int = getchar();
    while b >= 0 && b != 10 {
        any = true;
        // `byte_as_string` and not the `os_byte_as_string` that used to be at the bottom of this
        // file: that one answered `"?"` for every byte >= 127, so **every non-ASCII character a
        // client sent arrived as a question mark** — the whole point of retiring it (§B2).
        chunk += byte_as_string(b);
        // In CHUNKS, because `text += one_byte` copies the whole String for every byte — the mistake
        // this project has paid for three times, and `os_read_all` right below carries the same note.
        if len(chunk) >= 4096 {
            text = text + chunk;
            chunk = "";
        }
        b = getchar();
    }
    if b < 0 && !any {
        return Option.None;                          // end of input, and nothing before it
    }
    let line: String = text + chunk;
    // A CRLF client's `\r` belongs to the framing, not to the message.
    if len(line) > 0 && byte_at(line, len(line) - 1) == 13 {
        return Option.Some(substring(line, 0, len(line) - 1));
    }
    return Option.Some(line);
}

function os_read_all() -> String touches input {
    let mutable text: String = "";
    let mutable chunk: String = "";
    let mutable b: Int = getchar();
    while b >= 0 {
        chunk += byte_as_string(b);
        // Appended in chunks, because `text += one_byte` copies the whole
        // String for every byte — the mistake this project has now paid for three
        // times, written down in the guide as a rule.
        if len(chunk) >= 4096 {
            text = text + chunk;
            chunk = "";
        }
        b = getchar();
    }
    return text + chunk;
}

// An environment variable, or a stated absence.
//
// `Option<String>` and not `String`, because **unset and empty are different facts.** `FOO=` sets FOO
// to the empty string; not mentioning FOO at all is a different thing, and a library that answered ""
// for both would make "is this configured" unanswerable. `getenv` distinguishes them by returning
// NULL, and this is where that distinction is preserved rather than flattened.
//
// `touches input` because the value came from outside the program. Whether reading the environment
// deserves an effect of its own is an open question — see spec/FAR-HORIZON-ROADMAP.md M2 — but
// `input` is honest today: it is a value the process was started with.
function os_env(name: String) -> Option<String> touches input {
    let found: CPointer = getenv(name);
    if c_is_null(found) {
        return Option.None;
    }
    // The copy is the pointer wall: after this line Burxt owns these bytes and the pointer is gone.
    return Option.Some(c_string_at(found));
}

// The same question with a stated fallback, for the common case where a missing setting has a
// sensible default. Separate from `os_env` rather than a parameter with a default, because Burxt has
// no default arguments — and because the two really are different questions.
function os_env_or(name: String, fallback: String) -> String touches input {
    return option_or(os_env(name), fallback);
}

// `os_byte_as_string(byte)` used to be DECLARED HERE, and it was roadmap §B2: a table of the
// printable ASCII bytes that answered **`"?"` for every byte >= 127**. It is gone, and the two
// readers above call the `byte_as_string` BUILTIN instead (§A13).
//
// **It was a silent data-destroying bug, in the only Int-to-character path the library had.** Every
// UTF-8 lead and continuation byte — every non-ASCII character in anything read from a pipe — came
// back as a question mark, with nothing anywhere saying so. `os_read_line` and `os_read_all` are
// exactly the functions a program reads real input with, so the damage landed on the data most
// likely to be someone's, and a caller had no way to tell a genuine `?` from a destroyed byte.
//
// Two things worth keeping about how it got there. It was **not written carelessly**: while there
// was no way to build a byte in this language, a table was the only mechanism available, and the
// three whitespace escapes it special-cased show someone thinking about the edges. What was wrong
// was the FALLBACK — `"?"` answers a question it could not answer. `ascii_letter` in
// `lib/string.bx` faced the identical wall and chose `requires` instead, which is why that one is
// still correct and this one had to go.
//
// And it had **no doc comment at all**, while the two orphaned lines of one sat above `os_env`,
// where a reader would credit them to the wrong function. A wrong answer with no documentation is
// the hardest kind to find, because there is nothing to disagree with the code.
//
// REMOVED rather than made correct, because correct would have been `return byte_as_string(byte);`
// — a second name for a builtin, carrying an `os_` prefix for something that has nothing to do with
// the operating system. `spec/ROADMAP-1.0.md` §D1p says "retires the lossy `os_byte_as_string`",
// and retiring it is what that means. A program calling it gets an unknown-function error naming
// the line, which is the outcome this language prefers to a silent redirection.
