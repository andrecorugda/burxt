// ============================================================================
// lib/vector.bx — vector similarity, EXACTLY.
//
//     use "lib/vector.bx";
//
// The same query returns byte-identical scores on every CPU, every target and every run — and the
// compiler stops rather than silently losing a digit. See spec/N9-VECTORS-EXACTLY.md.
//
// ---- Why that is not a claim any other vector store can make ----------------------------
//
// `f32` addition is **not associative**. `(a+b)+c` and `a+(b+c)` differ in the last bits, so a dot
// product's answer depends on the order the SIMD lanes happened to reduce in — which depends on the
// CPU, the compiler version and the thread count. Every production vector database therefore has
// scores that wobble in the last digits between machines, and nobody treats it as a bug because no
// alternative is available to them.
//
// Scaled-integer arithmetic IS associative and exact. The wobble is not reduced, it is absent.
//
// What that buys, and it is more than tidiness: a ranking that cannot silently reorder near-ties, a
// retrieval test that asserts a SCORE rather than a range, and an audit trail you can re-verify on
// different hardware a year later. Nobody can do the second one today, which is why RAG quality is
// measured statistically rather than pinned.
//
// ---- The scale, and why it is 7 ---------------------------------------------------------
//
// A component of an embedding lives in [-1, 1], so at scale S its unscaled integer is at most 10^S. A
// product of two lands at scale 2S. Summing D of them needs
//
//     D × 10^(2S)  <  2^63 ≈ 9.22 × 10^18
//
//     Decimal<6>  → products at 12  → ~9,200,000 dimensions
//     Decimal<7>  → products at 14  → ~92,000 dimensions      ← every real embedding size
//     Decimal<8>  → products at 16  → ~920 dimensions         ← 1536 OVERFLOWS
//
// So `Decimal<7>` in, `Decimal<14>` out, and the wall is a TRAP rather than a wrap: at scale 8 a
// 1536-dimension dot product answers
//
//     burxt runtime error: arithmetic overflow — the exact result no longer fits in the value range
//
// which is the property. This library either answers exactly or refuses to answer. There is no third
// outcome where it answers approximately without saying so.
//
// `Decimal<7>` also carries MORE component precision than `f32` does near 1.0 — f32's spacing there is
// about 6×10⁻⁸ — so exactness is close to free rather than bought.
//
// ---- What is NOT here yet, and why ------------------------------------------------------
//
// **`vector_normalise` is absent, but no longer blocked.** It used to be: dividing a `Decimal<7>`
// needs a rounding contract, so a normalised component is a `Decimal<7, RoundHalfEven>`, and `push`
// would not take a plain `Decimal<7>` into a contracted array — so neither the plain API nor the
// contracted one could be written. That second half turned out to be a bug rather than a rule, fixed
// at all eight declared positions in v0.0.194, and the division-based version now compiles.
//
// It is still not urgent. `vector_dot` and `vector_squared_distance` need no normalisation at all, and
// the major embedding providers already return unit-length vectors — so in the common case cosine IS
// the dot product. `vector_magnitude` is here, exact, for checking that.
//
// The open question is which TYPE it should answer, and it is a real one rather than a gap: a
// `[Decimal<7, RoundHalfEven>]` cannot be handed to `vector_dot` above, because dropping the contract
// at the element type of a whole slice is refused — and rightly, since a slice is aliasable and the
// callee could write a rounded value back. So a contracted return type would split this API in two.
// ============================================================================

use "option.bx";
use "result.bx";
use "string.bx";
use "json.bx";
use "files.bx";

// The dot product — the inner-product metric, and cosine similarity when both vectors are unit length.
//
// `requires len(a) == len(b)` is the dimension contract. It is not defensive: two vectors of different
// length have no dot product, and answering one anyway by stopping at the shorter is the class of
// quiet nonsense that a precondition exists to refuse.
pure function vector_dot(a: [Decimal<7>], b: [Decimal<7>]) -> Decimal<14>
    requires len(a) == len(b)
{
    let mutable total: Decimal<14> = 0.00000000000000;
    let mutable i: Int = 0;
    while i < len(a) {
        total = total + a[i] * b[i];
        i += 1;
    }
    return total;
}

// Squared Euclidean distance. **No square root**, and none needed: `√` is monotonic, so squared
// distance ranks identically to distance. Every nearest-neighbour search that only needs an ORDER can
// use this and stay exact.
pure function vector_squared_distance(a: [Decimal<7>], b: [Decimal<7>]) -> Decimal<14>
    requires len(a) == len(b)
{
    let mutable total: Decimal<14> = 0.00000000000000;
    let mutable i: Int = 0;
    while i < len(a) {
        let gap: Decimal<7> = a[i] - b[i];
        total = total + gap * gap;
        i += 1;
    }
    return total;
}

pure function vector_magnitude_squared(a: [Decimal<7>]) -> Decimal<14> {
    return vector_dot(a, a);
}

// The magnitude, floored to seven places — a stated contract rather than a hidden approximation, so
// the same input gives the same answer forever.
//
// Found by BINARY SEARCH over the scaled count, comparing squares, which is the whole trick: nothing
// here converts a Decimal to an Int, because Burxt has no way to do that (`as scaled` is FFI-only).
// `tick * n` builds a `Decimal<7>` from a count of ten-millionths — the same penny-times-a-count shape
// `lib/json.bx` uses one scale up — and `candidate * candidate` lands at scale 14, exactly where the
// target already is. So the comparison is between two exact values of the same type.
pure function vector_magnitude(a: [Decimal<7>]) -> Decimal<7> {
    return magnitude_of_squared(vector_magnitude_squared(a));
}

// The same search, asked about a squared value rather than an array — because `vector_normalise`
// needs the magnitude of a vector it never builds.
pure function magnitude_of_squared(squared: Decimal<14>) -> Decimal<7> {
    let tick: Decimal<7> = 0.0000001;
    let mutable low: Int = 0;
    let mutable high: Int = 1000000000;
    while low < high {
        let mid: Int = divide_floor(low + high + 1, 2);
        let candidate: Decimal<7> = tick * mid;
        if candidate * candidate <= squared {
            low = mid;
        } else {
            high = mid - 1;
        }
    }
    return tick * low;
}

// Is this vector unit length, to seven places? Worth asking rather than assuming, because "the
// provider returns normalised vectors" is a claim about someone else's code.
pure function vector_is_unit(a: [Decimal<7>]) -> Bool {
    return vector_magnitude(a) == 1.0000000;
}

// The unit vector in the same direction, at seven places — and **no division anywhere**.
//
// This is the function spec/N9 spent two versions calling blocked. The block was real but it was in
// the wrong place: dividing a `Decimal<7>` needs a rounding contract, so the obvious version answers
// `[Decimal<7, RoundHalfEven>]` — and that cannot be handed back to `vector_dot`, because dropping a
// contract at a slice's element type is refused. Rightly so: a slice is aliasable, and the callee
// could write a rounded value back into the caller's array. A contracted return type would have split
// this API in two, with every function needing a twin.
//
// So the same trick as `vector_magnitude` one level out: find each component's scaled COUNT by binary
// search, comparing products instead of forming a quotient. The condition
//
//     tick*n  <=  |c| / mag        is the same question as        (tick*n) * mag  <=  |c|
//
// and the right-hand form needs no division. Both sides land at scale 14 — `(tick*n) * mag` is a
// product of two `Decimal<7>`, and `|c| * 1.0000000` lifts the component to meet it — so the
// comparison is between two exact values of the same type.
//
// ---- the boost, which is the part that took a measurement to find --------------------
//
// The first version divided by `vector_magnitude(a)` directly and was wrong by 4e-5 on short vectors —
// 400 times worse than the scale suggests. The reason is that the magnitude is FLOORED to seven
// places, so its error is 1e-7 ABSOLUTE, and dividing by it makes that error RELATIVE to the
// magnitude: a vector of length 0.001 gets a 1e-4 error, and one of length 1 gets 1e-7.
//
// The fix needs no new precision, because **scaling a vector by ten does not change its direction**
// and is exact. So multiply until the magnitude is at least 1, measure it there, and divide the
// boosted components by the boosted magnitude — both boosted by the same factor, so the quotient is
// unchanged and the floor now costs 1e-7 relative instead of 1e-7 absolute.
//
// Nothing is built to do it: `squared * (boost * boost)` is the squared magnitude of the boosted
// vector, exactly, and `magnitude_of_squared` will measure a vector that was never assembled.
//
// ---- the rounding rule, stated because it is a promise ------------------------------
//
// Each component is the NEAREST seven-place value, with a tie going down (toward zero). It is applied
// to `|c|` and the sign restored afterwards, so a component and its negation round symmetrically —
// which flooring toward negative infinity would not do, and which matters because embedding
// components are half negative.
//
// ---- where the error is, honestly ---------------------------------------------------
//
// About 1.5e-7 per component: 1e-7 from the floored magnitude and up to 5e-8 from landing on the grid.
// Deterministic, which is the claim — the same input gives the same unit vector on every machine and
// every run, and a deterministic 1.5e-7 is a different kind of thing from f32's nondeterministic one.
//
// Measured over 399 two-dimensional vectors spanning three orders of magnitude, the boost is the
// difference between a worst case of **1.0000411** and one of **1.0000001** — and between 75 of them
// reading exactly unit and 290 of them doing so.
//
// A consequence worth knowing before it surprises you: **`vector_is_unit` sometimes answers false on a
// freshly normalised vector — about a quarter of the time — and that is the right answer.** It asks
// whether the magnitude reads exactly 1 at seven places, which is a window one grid step wide, and
// rounding components onto that same grid moves the magnitude by about one step. It is not a defect in
// either function; it is what "unit length on a finite grid" means, and no amount of care removes it.
// Use the result for `vector_dot`, which is what it is for; do not use `vector_is_unit` as an
// acceptance test after normalising.
//
// The precondition is the zero vector, which has no direction to point in. `vector_magnitude_squared`
// rather than `vector_magnitude` because it is one dot product against thirty binary-search steps,
// and it is exactly the right question: a vector is normalisable iff its squared magnitude is nonzero.
pure function vector_normalise(a: [Decimal<7>]) -> [Decimal<7>]
    requires vector_magnitude_squared(a) > 0.00000000000000
{
    let squared: Decimal<14> = vector_magnitude_squared(a);

    // Boost until the magnitude is at least 1, so that flooring it costs 1e-7 relative rather than
    // 1e-7 absolute. Ten million is the ceiling: the smallest nonzero squared magnitude is one unit
    // at scale 14, and 10^7 squared lifts exactly that to 1.
    let mutable boost: Int = 1;
    let mutable lifted: Decimal<14> = squared;
    while lifted < 1.00000000000000 && boost < 10000000 {
        boost = boost * 10;
        lifted = squared * (boost * boost);          // exact — recomputed, never compounded
    }

    let mag: Decimal<7> = magnitude_of_squared(lifted);
    let tick: Decimal<7> = 0.0000001;
    let one: Decimal<7> = 1.0000000;
    let zero: Decimal<7> = 0.0000000;
    let mutable out: [Decimal<7>] = [];
    let mutable i: Int = 0;
    while i < len(a) {
        let component: Decimal<7> = a[i];
        let negative: Bool = component < zero;
        let mutable size: Decimal<7> = component;
        if negative {
            size = zero - component;                 // subtraction never rounds
        }
        // The same boost on this side of the quotient, so the ratio is untouched.
        let target: Decimal<14> = (size * boost) * one;
        // A normalised component is at most 1, so ten million ticks is the whole range.
        let mutable low: Int = 0;
        let mutable high: Int = 10000000;
        while low < high {
            let mid: Int = divide_floor(low + high + 1, 2);
            if (tick * mid) * mag <= target {
                low = mid;
            } else {
                high = mid - 1;
            }
        }
        // `low` is the floor. Take the neighbour if it is strictly closer — a tie stays at the floor,
        // which is toward zero, because the sign is not back on yet.
        let mutable count: Int = low;
        if low < 10000000 {
            let below: Decimal<14> = target - (tick * low) * mag;
            let above: Decimal<14> = (tick * (low + 1)) * mag - target;
            if above < below {
                count = low + 1;
            }
        }
        if negative {
            let added: Int = push(out, tick * (0 - count));
        } else {
            let added: Int = push(out, tick * count);
        }
        i += 1;
    }
    return out;
}

// ---- searching ---------------------------------------------------------------

// One scored candidate. A class rather than two parallel arrays, because a score and the row it came
// from travelling together is a thing worth naming.
class Scored { at: Int, score: Decimal<14> }

// The `count` best matches by DOT PRODUCT, highest first.
//
// Brute force, and that is deliberate for this slice: it is exact by construction and it is the
// baseline any index has to be checked against. An approximate index may come later and may still
// score exactly — approximate CANDIDATE selection, exact SCORING — which is the split that keeps the
// claim while getting the speed.
//
// Insertion into a kept list rather than sort-then-take, so nothing needs a generic `sort` — and
// `xs[i] = v` does not work through a `[T]` today, which is what a generic sort would need.
function vector_top_dot(rows: [Row], query: [Decimal<7>], count: Int) -> [Scored]
    requires count > 0
{
    let mutable best: [Scored] = [];
    let mutable r: Int = 0;
    while r < len(rows) {
        let score: Decimal<14> = vector_dot(rows[r].values, query);
        // Where this one belongs: the first place its score beats.
        let mutable at: Int = 0;
        while at < len(best) && best[at].score >= score {
            at += 1;
        }
        if at < count {
            // Shift down from the end, then write. Concrete types throughout, so no generic
            // index assignment is involved.
            let mutable grown: [Scored] = [];
            let mutable k: Int = 0;
            while k < len(best) {
                let kept: Int = push(grown, best[k]);
                k += 1;
            }
            if len(grown) < count {
                let room: Int = push(grown, Scored { at: 0, score: 0.00000000000000 });
            }
            let mutable j: Int = len(grown) - 1;
            while j > at {
                grown[j] = grown[j - 1];
                j -= 1;
            }
            grown[at] = Scored { at: r, score: score };
            best = grown;
        }
        r += 1;
    }
    return best;
}

// A stored vector: an identifier and its components.
//
// Declared after the functions that use it on purpose — Burxt collects every declaration before
// checking any body, so ordering is a matter of what reads best rather than a constraint. `Row` reads
// best beside the store it belongs to.
class Row { id: String, values: [Decimal<7>] }

// ---- storing ------------------------------------------------------------------
//
// One JSON object per LINE — JSONL. Not one big array, and the reason is what a store actually needs:
// a line can be appended without rewriting the file, and a corrupt line costs one row rather than the
// whole corpus. It is also what every real vector store's export format looks like.
//
// Components cross as **quoted digit strings**, which is `lib/json.bx`'s position applied here: a JSON
// number reaches a JavaScript consumer as a double, and `0.1234567` stops being `0.1234567`. Writing
// exact vectors and then reading them back through a float would defeat the entire point of this file.
//
//     {"id":"east","values":["1.0000000","0.0000000","0.0000000"]}

// The digits of a `Decimal<7>` as a JSON string. `to_string` already renders every place, so this is
// the whole conversion.
function component_to_json(value: Decimal<7>) -> Json {
    return json_text(to_string(value));
}

// A `Decimal<7>` back from its digits, or None when they are not exactly that.
//
// **It never rounds.** `"0.12345678"` answers None rather than `0.1234568`, because a component
// arriving with more precision than the store holds is a question and not a rounding — the writer
// meant those digits. Same rule as `json_as_money`, one scale up.
//
// The reconstruction is a count of ten-millionths times one ten-millionth, exact by construction and
// needing no rounding contract, because that is what a scaled decimal already is.
function component_from_json(value: Json) -> Option<Decimal<7>> {
    let digits: String = option_or(json_digits(value), "");
    if len(digits) == 0 {
        return Option.None;
    }
    let mutable whole: String = digits;
    let mutable fraction: String = "";
    let dot: Int = string_find(digits, ".");
    if dot >= 0 {
        whole = substring(digits, 0, dot);
        fraction = substring(digits, dot + 1, len(digits) - dot - 1);
    }
    if len(fraction) > 7 {
        return Option.None;                          // finer than the store holds
    }
    while len(fraction) < 7 {
        fraction = fraction + "0";
    }
    let negative: Bool = string_starts_with(whole, "-");
    if negative {
        whole = substring(whole, 1, len(whole) - 1);
    }
    if len(whole) == 0 {
        whole = "0";
    }
    match string_parse_int(whole) {
        None => { return Option.None; }
        Some(units) => {
            match string_parse_int(fraction) {
                None => { return Option.None; }
                Some(part) => {
                    let tick: Decimal<7> = 0.0000001;
                    let ticks: Int = units * 10000000 + part;
                    if negative {
                        return Option.Some(tick * (0 - ticks));
                    }
                    return Option.Some(tick * ticks);
                }
            }
        }
    }
}

function vector_to_json(row: Row) -> Json {
    let mutable values: [Json] = [];
    let mutable i: Int = 0;
    while i < len(row.values) {
        let added: Int = push(values, component_to_json(row.values[i]));
        i += 1;
    }
    let mutable fields: [Field] = [];
    let a: Int = push(fields, json_field("id", json_text(row.id)));
    let b: Int = push(fields, json_field("values", json_list(values)));
    return json_object(fields);
}

// A row back from one JSON object. Every failure says which row and why — a store that skips a line it
// could not read is a store that quietly returns fewer results.
function vector_from_json(value: Json) -> Result<Row, String> {
    let id: String = option_or(json_as_text(option_or(json_at(value, "id"), json_null())), "");
    if len(id) == 0 {
        return Result.Error("a row needs a non-empty `id`");
    }
    match json_at(value, "values") {
        None => { return Result.Error("row `" + id + "` has no `values`"); }
        Some(listed) => {
            match listed {
                List(items) => {
                    let mutable out: [Decimal<7>] = [];
                    let mutable i: Int = 0;
                    while i < len(items) {
                        match component_from_json(items[i]) {
                            None => {
                                return Result.Error("row `" + id + "` component "
                                            + to_string(i + 1)
                                            + " is not an exact 7-place decimal");
                            }
                            Some(component) => {
                                let added: Int = push(out, component);
                            }
                        }
                        i += 1;
                    }
                    return Result.Ok(Row { id: id, values: out });
                }
                Null => { return Result.Error("row `" + id + "`: `values` must be a list"); }
                Truth(t) => { return Result.Error("row `" + id + "`: `values` must be a list"); }
                Number(d) => { return Result.Error("row `" + id + "`: `values` must be a list"); }
                Text(t) => { return Result.Error("row `" + id + "`: `values` must be a list"); }
                Object(f) => { return Result.Error("row `" + id + "`: `values` must be a list"); }
            }
        }
    }
}

// The whole store as JSONL text. Kept separate from writing it, so a caller can put it anywhere —
// stdout, a socket once there is one, a test's assertion.
function vector_store_render(rows: [Row]) -> String {
    let mutable out: String = "";
    let mutable i: Int = 0;
    while i < len(rows) {
        out = out + json_render(vector_to_json(rows[i])) + "\n";
        i += 1;
    }
    return out;
}

function vector_store_parse(text: String) -> Result<[Row], String> {
    let mutable rows: [Row] = [];
    let lines: [String] = string_lines(text);
    let mutable i: Int = 0;
    while i < len(lines) {
        let line: String = string_trim(lines[i]);
        if len(line) > 0 {
            match json_parse(line) {
                Error(why) => {
                    return Result.Error("line " + to_string(i + 1) + ": " + why);
                }
                Ok(value) => {
                    match vector_from_json(value) {
                        Error(why) => {
                            return Result.Error("line " + to_string(i + 1) + ": " + why);
                        }
                        Ok(row) => {
                            let added: Int = push(rows, row);
                        }
                    }
                }
            }
        }
        i += 1;
    }
    return Result.Ok(rows);
}

function vector_store_write(path: String, rows: [Row]) -> Int touches files {
    return file_write(path, vector_store_render(rows));
}

function vector_store_read(path: String) -> Result<[Row], String> touches files {
    return vector_store_parse(file_read(path));
}

// Append one row without rewriting the file, which is the reason the format is JSONL.
function vector_store_append(path: String, row: Row) -> Int touches files {
    return file_append(path, json_render(vector_to_json(row)) + "\n");
}
