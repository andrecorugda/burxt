// ============================================================================
// lib/json.bx — JSON, parsed and rendered, in ordinary Burxt.
//
//     use "lib/json.bx";
//
// Nothing here needs a compiler feature. It is the `enum` + `class` mutual recursion from
// docs/guide/03-types.md and the `Option`/`Result` from lib/, which is the same test `lib/map.bx`
// passed: if a JSON document had needed a keyword, the type system would not be real.
//
// ---- The one position this library takes ------------------------------------------------
//
// **A JSON number is its DIGITS, not a float.**
//
// JSON's own grammar says a number is arbitrary-precision decimal text. Every language then parses
// it into a `double` on the way in, which is where an exact `19.99` stops being exact — and it is
// the same abandonment `as scaled` exists to prevent at the C boundary. See
// spec/1.0/N1-BOUNDARY-EXACTNESS.md: real financial defects live at boundaries, not in arithmetic.
//
// So `Json.Number` holds the digits exactly as they were written, and turning them into a typed
// value is a separate, checked step that can fail — `json_as_int`, `json_as_money`. Nothing is
// rounded on the way in, because nothing on the way in knows what rounding you wanted.
//
// And going out, **money crosses as a quoted string**: `json_money($19.99)` renders `"19.99"`, not
// `19.99`. A JSON number reaches a JavaScript consumer as a double and loses the cent. A string
// reaches every consumer with all its digits. That costs one `JSON.parse` field being text on the
// far side, and it is the difference between exact and nearly.
// ============================================================================

use "option.bx";
use "result.bx";
use "string.bx";

// A JSON value.
//
// `List` holds a slice of itself and `Object` a slice of `Field`, which holds a `Json` — the two
// halves of one recursive shape. A slice is a pointer and a length, so neither is infinitely wide,
// which is why this works where an enum directly inside an enum does not.
enum Json {
    Null,
    Truth(Bool),
    // The digits AS WRITTEN. `1`, `-2`, `19.99` and `1e400` are all valid JSON numbers and all
    // survive here unchanged; ask for a typed value only when you know which type you want.
    Number(String),
    Text(String),
    List([Json]),
    Object([Field]),
}

// One member of an object. A class rather than a two-payload variant, because a name and a value
// travelling together is a thing worth naming — and because a variant may not carry an enum, while
// a class field may.
class Field { name: String, value: Json }

// ---- building ----------------------------------------------------------------
// Free functions rather than one overloaded constructor: Burxt has no overloading, and the name
// saying which kind you meant is what a reviewer reads.

function json_null() -> Json {
    return Json.Null;
}

function json_truth(value: Bool) -> Json {
    return Json.Truth(value);
}

function json_int(value: Int) -> Json {
    return Json.Number(to_string(value));
}

// Money, as a quoted string. See the header: this is the position, and it is deliberate.
function json_money(amount: Decimal<2>) -> Json {
    return Json.Text(to_string(amount));
}

function json_text(value: String) -> Json {
    return Json.Text(value);
}

function json_list(values: [Json]) -> Json {
    return Json.List(values);
}

function json_object(fields: [Field]) -> Json {
    return Json.Object(fields);
}

function json_field(name: String, value: Json) -> Field {
    return Field { name: name, value: value };
}

// ---- rendering ---------------------------------------------------------------

// A String with the six escapes JSON requires, and nothing else.
//
// Built in RUNS rather than a byte at a time: `out = out + one_byte` copies the whole String on
// every byte, which this project has paid for three times — the lexer was quadratic for eleven
// versions on exactly this shape. Everything from `copied` to here is appended in one slice.
function json_escape(text: String) -> String {
    let mutable out: String = "";
    let mutable copied: Int = 0;
    let mutable i: Int = 0;
    let n: Int = len(text);
    while i < n {
        let b: Int = byte_at(text, i);
        let mutable escape: String = "";
        if b == 34 { escape = "\\\""; }
        if b == 92 { escape = "\\\\"; }
        if b == 10 { escape = "\\n"; }
        if b == 13 { escape = "\\r"; }
        if b == 9 { escape = "\\t"; }
        if b == 8 { escape = "\\b"; }
        if b == 12 { escape = "\\f"; }
        if len(escape) > 0 {
            out = out + substring(text, copied, i - copied) + escape;
            copied = i + 1;
        }
        i += 1;
    }
    return out + substring(text, copied, n - copied);
}

// One JSON value as text, with no whitespace. Recursive, because the shape is.
function json_render(value: Json) -> String {
    match value {
        Null => { return "null"; }
        Truth(t) => {
            if t { return "true"; }
            return "false";
        }
        // Raw: the digits are already the answer, and quoting them would change the type on the wire.
        Number(digits) => { return digits; }
        Text(s) => { return "\"" + json_escape(s) + "\""; }
        List(items) => {
            let mutable out: String = "[";
            let mutable i: Int = 0;
            while i < len(items) {
                if i > 0 { out = out + ","; }
                out = out + json_render(items[i]);
                i += 1;
            }
            return out + "]";
        }
        Object(fields) => {
            let mutable out: String = "\{";
            let mutable i: Int = 0;
            while i < len(fields) {
                if i > 0 { out = out + ","; }
                let f: Field = fields[i];
                out = out + "\"" + json_escape(f.name) + "\":" + json_render(f.value);
                i += 1;
            }
            return out + "\}";
        }
    }
}

// ---- reading -----------------------------------------------------------------

// A member by name, or None. Linear, like every other lookup in this repository at this scale — an
// MCP request has single-digit field counts, and a map would allocate to save nothing.
function json_at(value: Json, name: String) -> Option<Json> {
    match value {
        Null => { return Option.None; }
        Truth(t) => { return Option.None; }
        Number(d) => { return Option.None; }
        Text(s) => { return Option.None; }
        List(items) => { return Option.None; }
        Object(fields) => {
            let mutable i: Int = 0;
            while i < len(fields) {
                let f: Field = fields[i];
                if f.name == name {
                    return Option.Some(f.value);
                }
                i += 1;
            }
            return Option.None;
        }
    }
}

function json_as_text(value: Json) -> Option<String> {
    match value {
        Null => { return Option.None; }
        Truth(t) => { return Option.None; }
        Number(d) => { return Option.None; }
        Text(s) => { return Option.Some(s); }
        List(items) => { return Option.None; }
        Object(fields) => { return Option.None; }
    }
}

// The digits of a number, whether it arrived as a JSON number or as a quoted string.
//
// Both, on purpose: an exact producer sends money as a string (see the header) and a careless one
// sends it as a number, and a server that reads only one of the two rejects half its callers for a
// difference that carries no information.
function json_digits(value: Json) -> Option<String> {
    match value {
        Null => { return Option.None; }
        Truth(t) => { return Option.None; }
        Number(d) => { return Option.Some(d); }
        Text(s) => { return Option.Some(s); }
        List(items) => { return Option.None; }
        Object(fields) => { return Option.None; }
    }
}

function json_as_int(value: Json) -> Option<Int> {
    let digits: String = option_or(json_digits(value), "");
    if len(digits) == 0 {
        return Option.None;
    }
    return string_parse_int(digits);
}

function json_as_truth(value: Json) -> Option<Bool> {
    match value {
        Null => { return Option.None; }
        Truth(t) => { return Option.Some(t); }
        Number(d) => { return Option.None; }
        Text(s) => { return Option.None; }
        List(items) => { return Option.None; }
        Object(fields) => { return Option.None; }
    }
}

// Money, at two places, or None when the digits are not exactly that.
//
// **It never rounds.** `"19.999"` answers None rather than `20.00`, because a value arriving from
// outside with more precision than you asked for is a question and not a rounding: the caller sent
// a third decimal place for a reason, and no default here can know what it was. `1.5` is fine —
// `1.50` loses nothing — and `1.567` is refused.
//
// The reconstruction is a count of pennies times a penny, which is exact by construction and needs
// no rounding contract, because that is literally what a scaled decimal already is.
function json_as_money(value: Json) -> Option<Decimal<2>> {
    let digits: String = option_or(json_digits(value), "");
    if len(digits) == 0 {
        return Option.None;
    }
    let dot: Int = string_find(digits, ".");
    let mutable whole_text: String = digits;
    let mutable fraction: String = "";
    if dot >= 0 {
        whole_text = substring(digits, 0, dot);
        fraction = substring(digits, dot + 1, len(digits) - dot - 1);
    }
    if len(fraction) > 2 {
        return Option.None;                          // more precision than Decimal<2> can hold
    }
    // "1.5" is 150 pennies, "1.50" is 150, "1" is 100. Padded rather than parsed twice.
    while len(fraction) < 2 {
        fraction = fraction + "0";
    }
    let negative: Bool = string_starts_with(whole_text, "-");
    if negative {
        whole_text = substring(whole_text, 1, len(whole_text) - 1);
    }
    if len(whole_text) == 0 {
        whole_text = "0";
    }
    match string_parse_int(whole_text) {
        None => { return Option.None; }
        Some(units) => {
            match string_parse_int(fraction) {
                None => { return Option.None; }
                Some(hundredths) => {
                    let penny: Decimal<2> = $0.01;
                    let mutable amount: Decimal<2> = penny * (units * 100 + hundredths);
                    if negative {
                        amount = $0.00 - amount;
                    }
                    return Option.Some(amount);
                }
            }
        }
    }
}

// ---- parsing -----------------------------------------------------------------

// Where the parser is. A class with `mutable self` methods, because Burxt has no writable
// parameters — the same constraint that made `lib/map.bx` method-based, and the same outcome: the
// cursor being a value you can name reads better than threading an index through twelve returns.
class Reader { text: String, at: Int }

function (mutable self: Reader) skip_space() -> Int {
    while self.at < len(self.text) && string_is_space(byte_at(self.text, self.at)) {
        self.at += 1;
    }
    return self.at;
}

function (self: Reader) peek() -> Int {
    if self.at >= len(self.text) {
        return -1;
    }
    return byte_at(self.text, self.at);
}

// Parse one value at the cursor. Recursive through `parse_list` and `parse_object`.
function (mutable self: Reader) parse_value() -> Result<Json, String> {
    let where: Int = self.skip_space();
    let b: Int = self.peek();
    if b < 0 {
        return Result.Error("the document ended where a value was expected");
    }
    if b == 123 {                                    // '{'
        return self.parse_object();
    }
    if b == 91 {                                     // '['
        return self.parse_list();
    }
    if b == 34 {                                     // '"'
        match self.parse_text() {
            Error(why) => { return Result.Error(why); }
            Ok(s) => { return Result.Ok(Json.Text(s)); }
        }
    }
    if self.word("true") { return Result.Ok(Json.Truth(true)); }
    if self.word("false") { return Result.Ok(Json.Truth(false)); }
    if self.word("null") { return Result.Ok(Json.Null); }
    if b == 45 || (b >= 48 && b <= 57) {             // '-' or a digit
        return self.parse_number();
    }
    return Result.Error("not a JSON value at byte " + to_string(self.at));
}

// Consume `word` if it is at the cursor. Answers whether it was.
function (mutable self: Reader) word(word: String) -> Bool {
    let n: Int = len(word);
    if self.at + n > len(self.text) {
        return false;
    }
    let mutable i: Int = 0;
    while i < n {
        if byte_at(self.text, self.at + i) != byte_at(word, i) {
            return false;
        }
        i += 1;
    }
    self.at += n;
    return true;
}

// A number, kept as the digits it was written with. Only the SHAPE is checked here — that it is a
// number at all — because deciding what type it should become is the caller's, and doing it here
// would be the silent conversion this file exists to avoid.
function (mutable self: Reader) parse_number() -> Result<Json, String> {
    let start: Int = self.at;
    if self.peek() == 45 {
        self.at += 1;
    }
    let mutable digits: Int = 0;
    while self.at < len(self.text) && is_json_digit(byte_at(self.text, self.at)) {
        self.at += 1;
        digits += 1;
    }
    if digits == 0 {
        return Result.Error("a number with no digits at byte " + to_string(start));
    }
    if self.peek() == 46 {                           // '.'
        self.at += 1;
        let mutable places: Int = 0;
        while self.at < len(self.text) && is_json_digit(byte_at(self.text, self.at)) {
            self.at += 1;
            places += 1;
        }
        if places == 0 {
            return Result.Error("a decimal point with no digits after it at byte "
                        + to_string(start));
        }
    }
    // An exponent is valid JSON and is kept verbatim like every other digit, so nothing is lost.
    // `json_as_money` will decline it, which is the right answer rather than a rounding.
    if self.peek() == 101 || self.peek() == 69 {     // 'e' or 'E'
        self.at += 1;
        if self.peek() == 43 || self.peek() == 45 {
            self.at += 1;
        }
        while self.at < len(self.text) && is_json_digit(byte_at(self.text, self.at)) {
            self.at += 1;
        }
    }
    return Result.Ok(Json.Number(substring(self.text, start, self.at - start)));
}

function is_json_digit(b: Int) -> Bool {
    return b >= 48 && b <= 57;
}

// One `\uXXXX`, with `self.at` sitting on the `u`. Answers the character and leaves `self.at`
// just past the escape. B9.
//
// **Surrogate pairs are the reason this is a function rather than four lines inline.** JSON is
// specified in terms of UTF-16, so every codepoint above U+FFFF is written as TWO escapes — an
// emoji is `😀`, never one escape. A decoder that treats each `\uXXXX` independently
// produces two half-characters, and `from_codepoint` refuses those outright (they are surrogates,
// and encoding one is CESU-8, which this library's own `is_valid_utf8` rejects). So the choice
// was never "handle pairs or ignore them" — it was "handle pairs or refuse every emoji in
// real-world JSON".
//
// A lone surrogate, high or low, is an error rather than U+FFFD. Substituting a replacement
// character is the same silent repair as the `"?"` that `os_byte_as_string` used to make: the
// caller asked for text and would get text, subtly not the text that was sent.
function (mutable self: Reader) parse_unicode_escape() -> Result<String, String> {
    match self.read_four_hex() {
        Error(why) => { return Result.Error(why); }
        Ok(first) => {
            // Not a surrogate: one escape, one character, done.
            if first < 55296 || first > 57343 {
                return Result.Ok(from_codepoint(first));
            }
            // A LOW surrogate arriving first has no high half to join.
            if first > 56319 {
                return Result.Error("a stray low surrogate at byte " + to_string(self.at));
            }
            // A high surrogate must be followed by `\u` and its low half.
            if self.at + 1 >= len(self.text)
                || byte_at(self.text, self.at) != 92
                || byte_at(self.text, self.at + 1) != 117 {
                return Result.Error("a high surrogate with no low half at byte "
                            + to_string(self.at));
            }
            self.at += 1;                                // the backslash
            match self.read_four_hex() {
                Error(why) => { return Result.Error(why); }
                Ok(second) => {
                    if second < 56320 || second > 57343 {
                        return Result.Error("a high surrogate followed by something that is not "
                                    + "a low surrogate at byte " + to_string(self.at));
                    }
                    // The UTF-16 pairing rule, spelled out rather than folded into constants.
                    let high: Int = first - 55296;
                    let low: Int = second - 56320;
                    return Result.Ok(from_codepoint(65536 + high * 1024 + low));
                }
            }
        }
    }
}

// The four hex digits of a `\uXXXX`, with `self.at` on the `u`. Leaves `self.at` past the digits.
function (mutable self: Reader) read_four_hex() -> Result<Int, String> {
    // Four, exactly. `string_parse_hex` would happily read `\u12` from `"\u12"` followed by a
    // quote, and JSON does not have a short form — accepting one would make this decoder read a
    // document no other decoder does.
    if self.at + 4 >= len(self.text) {
        return Result.Error("a \\u escape that runs off the end at byte " + to_string(self.at));
    }
    let digits: String = substring(self.text, self.at + 1, 4);
    if !all_hex_digits(digits) {
        return Result.Error("a \\u escape whose four characters are not hex at byte "
                    + to_string(self.at));
    }
    match string_parse_hex(digits) {
        None => { return Result.Error("a \\u escape that is not hex at byte "
                    + to_string(self.at)); }
        Some(value) => {
            self.at += 5;                                // the `u` and its four digits
            return Result.Ok(value);
        }
    }
}

// A quoted string, with the escapes undone.
function (mutable self: Reader) parse_text() -> Result<String, String> {
    self.at += 1;                                    // the opening quote
    let mutable out: String = "";
    let mutable copied: Int = self.at;
    while self.at < len(self.text) {
        let b: Int = byte_at(self.text, self.at);
        if b == 34 {                                 // the closing quote
            let answer: String = out + substring(self.text, copied, self.at - copied);
            self.at += 1;
            return Result.Ok(answer);
        }
        if b == 92 {                                 // a backslash
            out = out + substring(self.text, copied, self.at - copied);
            self.at += 1;
            let e: Int = self.peek();
            if e == 34 { out = out + "\""; }
            if e == 92 { out = out + "\\"; }
            if e == 110 { out = out + "\n"; }
            if e == 114 { out = out + "\r"; }
            if e == 116 { out = out + "\t"; }
            if e == 47 { out = out + "/"; }
            // B9. `\b` and `\f` are one codepoint each and were refused only because this slice
            // predated `from_codepoint` (A5). `from_codepoint` rather than a literal because it
            // is the function that promises a whole sequence or none.
            if e == 8 || e == 98 { out = out + from_codepoint(8); }
            if e == 102 { out = out + from_codepoint(12); }
            if e == 117 {                                // \uXXXX
                match self.parse_unicode_escape() {
                    Error(why) => { return Result.Error(why); }
                    Ok(decoded) => { out = out + decoded; }
                }
                copied = self.at;
                continue;
            }
            // Anything else is not a JSON escape, and it used to be SILENTLY DROPPED: none of
            // the arms above matched, so the backslash and the character after it were skipped
            // and nothing was appended. `"a\qb"` parsed as `"ab"`, with no error — a string
            // quietly missing a character, which is the exact wrong answer this language exists
            // to refuse, found while fixing the escapes that were refused honestly.
            if e != 34 && e != 92 && e != 110 && e != 114 && e != 116 && e != 47
                && e != 8 && e != 98 && e != 102 {
                return Result.Error("this is not a JSON escape at byte " + to_string(self.at));
            }
            self.at += 1;
            copied = self.at;
            continue;
        }
        self.at += 1;
    }
    return Result.Error("a string that never closes");
}

function (mutable self: Reader) parse_list() -> Result<Json, String> {
    self.at += 1;                                    // '['
    let mutable items: [Json] = [];
    let opened: Int = self.skip_space();
    if self.peek() == 93 {                           // ']' — empty
        self.at += 1;
        return Result.Ok(Json.List(items));
    }
    let mutable going: Bool = true;
    while going {
        match self.parse_value() {
            Error(why) => { return Result.Error(why); }
            Ok(item) => {
                let added: Int = push(items, item);
            }
        }
        let after: Int = self.skip_space();
        if self.peek() == 44 {                       // ','
            self.at += 1;
        } else {
            going = false;
        }
    }
    let closing: Int = self.skip_space();
    if self.peek() != 93 {
        return Result.Error("a list that never closes, at byte " + to_string(self.at));
    }
    self.at += 1;
    return Result.Ok(Json.List(items));
}

function (mutable self: Reader) parse_object() -> Result<Json, String> {
    self.at += 1;                                    // '{'
    let mutable fields: [Field] = [];
    let opened: Int = self.skip_space();
    if self.peek() == 125 {                          // '}' — empty
        self.at += 1;
        return Result.Ok(Json.Object(fields));
    }
    let mutable going: Bool = true;
    while going {
        let before: Int = self.skip_space();
        if self.peek() != 34 {
            return Result.Error("an object key must be a quoted string, at byte "
                        + to_string(self.at));
        }
        let mutable name: String = "";
        match self.parse_text() {
            Error(why) => { return Result.Error(why); }
            Ok(key) => { name = key; }
        }
        let between: Int = self.skip_space();
        if self.peek() != 58 {                       // ':'
            return Result.Error("a `:` must follow an object key, at byte " + to_string(self.at));
        }
        self.at += 1;
        match self.parse_value() {
            Error(why) => { return Result.Error(why); }
            Ok(value) => {
                let added: Int = push(fields, Field { name: name, value: value });
            }
        }
        let after: Int = self.skip_space();
        if self.peek() == 44 {                       // ','
            self.at += 1;
        } else {
            going = false;
        }
    }
    let closing: Int = self.skip_space();
    if self.peek() != 125 {
        return Result.Error("an object that never closes, at byte " + to_string(self.at));
    }
    self.at += 1;
    return Result.Ok(Json.Object(fields));
}

// One JSON document. Trailing whitespace is allowed; trailing anything else is not, because a
// second document where one was expected means the caller framed its input wrong and saying so
// beats parsing half of it.
function json_parse(text: String) -> Result<Json, String> {
    let mutable reader: Reader = Reader { text: text, at: 0 };
    match reader.parse_value() {
        Error(why) => { return Result.Error(why); }
        Ok(value) => {
            let rest: Int = reader.skip_space();
            if reader.at < len(text) {
                return Result.Error("unexpected text after the document, at byte "
                            + to_string(reader.at));
            }
            return Result.Ok(value);
        }
    }
}
