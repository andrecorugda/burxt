// ============================================================================
// scripts/site-reference.bx — Generate docs/reference/ by READING the compiler and the standard
// library.
//
//     burxt run scripts/site-reference.bx              # writes docs/reference/ and the search index
//     burxt run scripts/site-reference.bx -- --check   # exits 1 if anything on disk is out of date
//
// The reference this replaces was one hand-written page, and it had already rotted: it listed `record`
// as a keyword eleven versions after the language renamed it to `class`, and it called `for` and `is`
// "reserved but not yet used" ninety versions after `for x in xs` shipped. Its own header said
// "generated by reading the compiler, not by memory", which was true of the afternoon it was written
// and of no afternoon since.
//
// So this reads the compiler. Four sources, none of them a list kept here:
//
//   * `src/rust-compiler/lexer.rs` — the keyword table (`"word" => Token::…`) and `renamed_keyword`,
//     which is where the eight spellings that no longer compile live along with what each became.
//   * `src/rust-compiler/typeck.rs` — `is_reserved_name` for the names a program may not declare, and
//     the builtin→effect table for which of them reach the world.
//   * `src/rust-compiler/main.rs` — the usage block, which is the whole command-line surface. Two of
//     those commands, `review` and `mcp-schema`, are the most distinctive things in the language and
//     were documented nowhere on the site.
//   * `lib/*.bx` — every standard-library declaration, with the `//` prose already written above it.
//
// What is NOT scraped is each builtin's signature, because the typechecker states those in arity
// errors that carry `\{\}` placeholders and read as apologies rather than as declarations. Those are
// written out below — and then VERIFIED by compiling a real use of each one. A wrong signature here
// does not ship: the probe fails and this script exits non-zero naming the builtin. Every refusal
// quoted on the page is likewise captured by running the compiler, never typed.
//
// And the two lists are checked against each other. A builtin the compiler reserves and this file has
// no entry for is an error, so adding one to the language makes this fail until the reference knows
// about it.
//
// ---- this is a port of scripts/site-reference.py, and the bar is BYTE-IDENTICAL output ----------
//
// So every string that names the Python by filename **inside a generated page** still says
// `site-reference.py`. Those are the file's CONTENTS, not this program's identity, and changing one
// would be a diff. Whoever retires the Python changes them then. The `--check` remedy is the one
// exception, because it tells a human what to run and running the Python is no longer the answer.
//
// Six regular expressions had to become hand-written scanners, and each carries the reading of the
// pattern it replaces at its definition — the two row shapes in the usage block, the flag head, the
// keyword table, `renamed_keyword`, the declaration forms, and the banner. **A port of a regex goes
// wrong at the backtracking**, so where a pattern can only match one way that is written down, and
// where it genuinely backtracks the alternatives are tried in the order Python tries them.
//
// The heading rule is not here at all. `label`, `slug`, `headings` and `title_of` live in
// `scripts/nav-headings.bx` and are shared with `scripts/site-nav.bx`, because the search index and
// the sidebar have to agree byte for byte about the id a section carries — see that file's header.
//
// `ROOT` is FOUND rather than derived from `__file__`, which Burxt has no equivalent of; that is
// `repository_root`, also in `nav-headings.bx` and for the same reason.
// ============================================================================

use "nav-headings.bx";
use "../lib/string.bx";
use "../lib/array.bx";
use "../lib/files.bx";
use "../lib/path.bx";
use "../lib/os.bx";

// `https://github.com/andrecorugda/burxt/blob/main`, the base of every `[Source]` link.
pure function github() -> String {
    return "https://github.com/andrecorugda/burxt/blob/main";
}

// One builtin: what it is called, what the page claims about it, and the two programs that prove
// the claim. `probe` empty means there is nothing to compile — `exit` and `main` are reserved names
// rather than calls. `refuses` empty means the page quotes no refusal for it.
class Builtin {
    name: String,
    signature: String,
    answers: String,
    allocates: Bool,
    doc: String,
    probe: String,
    refuses: String,
}

// Two strings that travel together: a renamed keyword and its replacement, a builtin and its
// effect, a contextual marker and what it says, a flag and its explanation.
class Pair { left: String, right: String }

// One row of the command table, from one `eprintln!` in the usage block.
class Command { name: String, takes: String, what: String }

// One declaration in a standard-library module, with the `//` prose written above it.
//
// `receiver` empty means `kind` is not `method`. `section` is deliberately absent: the Python
// carried the last banner on every symbol and no page ever read it, so a field here would be a
// claim that something depends on it.
class Symbol {
    name: String,
    kind: String,
    receiver: String,
    mutates: Bool,
    signature: String,
    doc: String,
    line: Int,
}

class Module { name: String, path: String, title: String, blurb: String, symbols: [Symbol] }

// One generated page. A class rather than a map because the ORDER matters: `--check` names the
// stale pages in this order, and `index.md` comes first because the Python's dict does.
class Page { name: String, text: String }

// One row of the search index. `where` and `text` are the two lines a result shows under its name.
class Item { name: String, kind: String, url: String, where: String, text: String }

// What a declaration line turned out to be.
class TypeDecl { kind: String, name: String }
class FnDecl { name: String, mutates: Bool, receiver: String }
class Receiver { mutates: Bool, receiver: String, next: Int }

// ---- text, the way Python does it ------------------------------------------------------------

// Python's `str.strip()`: the six whitespace bytes, both ends.
//
// `string_trim` in the standard library removes four of them and not the vertical tab or the form
// feed. `is_regex_space` in `nav-headings.bx` is already Python's `\s` minus its Unicode part, which
// is the same six, so this is that predicate applied at both ends.
pure function strip_python(text: String) -> String {
    let mutable from: Int = 0;
    while from < len(text) && is_regex_space(byte_at(text, from)) {
        from += 1;
    }
    let mutable to: Int = len(text);
    while to > from && is_regex_space(byte_at(text, to - 1)) {
        to -= 1;
    }
    return substring(text, from, to - from);
}

// Python's `str.rstrip()`.
pure function rstrip_python(text: String) -> String {
    let mutable to: Int = len(text);
    while to > 0 && is_regex_space(byte_at(text, to - 1)) {
        to -= 1;
    }
    return substring(text, 0, to);
}

// `\s*` at `from`: where the whitespace run ends. Greedy with nothing to backtrack, in every
// pattern below — what follows a `\s*` in each of them is never whitespace.
pure function skip_space(text: String, from: Int) -> Int {
    let stop: Int = len(text);
    let mutable i: Int = from;
    while i < stop && is_regex_space(byte_at(text, i)) {
        i += 1;
    }
    return i;
}

// `text[:n]` — the first `n` CHARACTERS, not bytes.
//
// Python slices a `str` by character and the strings this cuts are full of em dashes, so a byte
// count would cut one in half and put a lone continuation byte on the page. Both call sites are a
// truncation for display: a symbol's first paragraph at 120 and a marker's explanation at 90.
pure function take_chars(text: String, n: Int) -> String {
    let stop: Int = len(text);
    let mutable at: Int = 0;
    let mutable taken: Int = 0;
    while at < stop && taken < n {
        at = next_char(text, at);
        taken += 1;
    }
    return substring(text, 0, at);
}

// The first token of a line, `line.split(" ")[0]`.
pure function first_word(line: String) -> String {
    let at: Int = string_find(line, " ");
    if at < 0 {
        return line;
    }
    return substring(line, 0, at);
}

// `text.split(marker, 1)[1]` — everything after the FIRST occurrence, or a refusal.
//
// Python raises `IndexError` when the marker is absent, which is a traceback rather than a sentence.
// Every caller here has a sentence to say instead, so the marker not being there is answered rather
// than thrown.
pure function after_first(text: String, marker: String) -> Option<String> {
    let at: Int = string_find(text, marker);
    if at < 0 {
        return Option.None;
    }
    let from: Int = at + len(marker);
    return Option.Some(substring(text, from, len(text) - from));
}

// `text.split(marker, 1)[0]` — everything before the first occurrence, or all of it.
pure function before_first(text: String, marker: String) -> String {
    let at: Int = string_find(text, marker);
    if at < 0 {
        return text;
    }
    return substring(text, 0, at);
}

// A file under the repository, or a refusal naming it. `read(*parts)` in the Python.
function read_repository(root: String, relative: String) -> String touches files {
    match file_read_maybe(root + "/" + relative) {
        Some(text) => {
            return text;
        }
        None => {
            die("cannot read " + relative);
            return "";
        }
    }
}

// ----------------------------------------------------------------------------------------------
// What the compiler knows
// ----------------------------------------------------------------------------------------------

// `re.match(r'^\s*"([A-Za-z_]+)"\s*=>\s*Token::', line)` — one row of the keyword table.
//
// Nothing in this pattern backtracks. `[A-Za-z_]+` is greedy and the byte after it must be `"`,
// which is in neither class, so a shorter run could never help; the same argument covers both
// `\s*`, since `=>` and `Token::` do not begin with whitespace.
pure function keyword_on(line: String) -> Option<String> {
    let stop: Int = len(line);
    let mutable i: Int = skip_space(line, 0);
    if i >= stop || byte_at(line, i) != 34 {                         // `"`
        return Option.None;
    }
    i += 1;
    let from: Int = i;
    while i < stop && (string_is_alpha(byte_at(line, i)) || byte_at(line, i) == 95) {
        i += 1;
    }
    if i == from {                                                   // `+` needs one
        return Option.None;
    }
    let word: String = substring(line, from, i - from);
    if i >= stop || byte_at(line, i) != 34 {
        return Option.None;
    }
    i = skip_space(line, i + 1);
    if !string_matches_at(line, "=>", i) {
        return Option.None;
    }
    i = skip_space(line, i + 2);
    if !string_matches_at(line, "Token::", i) {
        return Option.None;
    }
    return Option.Some(word);
}

// The keyword table, from `"word" => Token::Variant` in src/rust-compiler/lexer.rs.
function keywords(root: String) -> [String] touches files {
    let mutable lines: [String] = [];
    let read: Int = read_lines(root + "/src/rust-compiler/lexer.rs", lines);
    let mutable found: [String] = [];
    for line in lines {
        match keyword_on(line) {
            Some(word) => {
                let added: Int = push(found, word);
            }
            None => {}
        }
    }
    if len(found) < 20 {
        die("could not read the keyword table out of src/rust-compiler/lexer.rs — it moved");
    }
    return found;
}

// The spellings that no longer compile, and what each became, from `renamed_keyword`.
//
// `re.finditer(r'"([a-z]+)"\s*=>\s*\(\s*\n?\s*"([a-z]+)"', body)`. The `\n?` in the middle is
// redundant — `\s*` already crosses a newline — and it is there because half the arms wrap the tuple
// onto the next line. Nothing backtracks, by the argument in `keyword_on`, and `finditer` resumes
// after the whole match, which is what stops the second name opening a third.
function renamed(root: String) -> [Pair] touches files {
    let text: String = read_repository(root, "src/rust-compiler/lexer.rs");
    let mutable body: String = "";
    match after_first(text, "fn renamed_keyword") {
        Some(rest) => {
            body = before_first(rest, "_ => return None");
        }
        None => {
            die("could not read `renamed_keyword` out of src/rust-compiler/lexer.rs — it moved");
        }
    }
    let stop: Int = len(body);
    let mutable pairs: [Pair] = [];
    let mutable i: Int = 0;
    while i < stop {
        let mutable step: Int = 1;
        if byte_at(body, i) == 34 {                                  // `"`
            let old: Int = lower_word_end(body, i + 1);
            if old > i + 1 && old < stop && byte_at(body, old) == 34 {
                let mutable at: Int = skip_space(body, old + 1);
                if string_matches_at(body, "=>", at) {
                    at = skip_space(body, at + 2);
                    if at < stop && byte_at(body, at) == 40 {        // `(`
                        at = skip_space(body, at + 1);
                        if at < stop && byte_at(body, at) == 34 {
                            let fresh: Int = lower_word_end(body, at + 1);
                            if fresh > at + 1 && fresh < stop && byte_at(body, fresh) == 34 {
                                let added: Int = push(pairs, Pair {
                                    left: substring(body, i + 1, old - i - 1),
                                    right: substring(body, at + 1, fresh - at - 1),
                                });
                                step = fresh + 1 - i;
                            }
                        }
                    }
                }
            }
        }
        i += step;
    }
    if len(pairs) < 6 {
        die("could not read `renamed_keyword` out of src/rust-compiler/lexer.rs — it moved");
    }
    return pairs;
}

// Where a `[a-z]+` run starting at `from` ends.
pure function lower_word_end(text: String, from: Int) -> Int {
    let stop: Int = len(text);
    let mutable i: Int = from;
    while i < stop && string_is_lower(byte_at(text, i)) {
        i += 1;
    }
    return i;
}

// Where a `[a-z_]+` run starting at `from` ends.
pure function snake_word_end(text: String, from: Int) -> Int {
    let stop: Int = len(text);
    let mutable i: Int = from;
    while i < stop && (string_is_lower(byte_at(text, i)) || byte_at(text, i) == 95) {
        i += 1;
    }
    return i;
}

// The names a program may not declare, from `is_reserved_name` in src/rust-compiler/typeck.rs.
//
// `re.findall(r'"([a-z_]+)"', body)` over the body up to its first `\}`. The comments inside it hold
// no double quotes, which is why a pattern this blunt reads only the names.
function reserved(root: String) -> [String] touches files {
    let text: String = read_repository(root, "src/rust-compiler/typeck.rs");
    let mutable body: String = "";
    match after_first(text, "fn is_reserved_name") {
        Some(rest) => {
            body = before_first(rest, "\}");
        }
        None => {
            die("could not read `is_reserved_name` out of src/rust-compiler/typeck.rs — it moved");
        }
    }
    let stop: Int = len(body);
    let mutable found: [String] = [];
    let mutable i: Int = 0;
    while i < stop {
        let mutable step: Int = 1;
        if byte_at(body, i) == 34 {
            let end: Int = snake_word_end(body, i + 1);
            if end > i + 1 && end < stop && byte_at(body, end) == 34 {
                let added: Int = push(found, substring(body, i + 1, end - i - 1));
                step = end + 1 - i;
            }
        }
        i += step;
    }
    if len(found) < 10 {
        die("could not read `is_reserved_name` out of src/rust-compiler/typeck.rs — it moved");
    }
    return found;
}

// Which builtins reach the world, from the effect table in src/rust-compiler/typeck.rs.
//
// `re.finditer(r'\("([a-z_]+)",\s*Effect::([A-Za-z]+)\)', block)`, and the variant is lower-cased
// because the page prints it inside `touches …`.
function builtin_effects(root: String) -> [Pair] touches files {
    let text: String = read_repository(root, "src/rust-compiler/typeck.rs");
    let mutable block: String = "";
    match after_first(text, "for (builtin, effect) in [") {
        Some(rest) => {
            block = before_first(rest, "]");
        }
        None => {
            die("could not read the builtin effect table out of src/rust-compiler/typeck.rs — it moved");
        }
    }
    let stop: Int = len(block);
    let mutable out: [Pair] = [];
    let mutable i: Int = 0;
    while i < stop {
        let mutable step: Int = 1;
        if byte_at(block, i) == 40 && i + 1 < stop && byte_at(block, i + 1) == 34 {
            let name_end: Int = snake_word_end(block, i + 2);
            if name_end > i + 2 && name_end + 1 < stop && byte_at(block, name_end) == 34
                    && byte_at(block, name_end + 1) == 44 {          // `",`
                let mutable at: Int = skip_space(block, name_end + 2);
                if string_matches_at(block, "Effect::", at) {
                    at += 8;
                    let mutable end: Int = at;
                    while end < stop && string_is_alpha(byte_at(block, end)) {
                        end += 1;
                    }
                    if end > at && end < stop && byte_at(block, end) == 41 {   // `)`
                        let added: Int = push(out, Pair {
                            left: substring(block, i + 2, name_end - i - 2),
                            right: string_to_lower_ascii(substring(block, at, end - at)),
                        });
                        step = end + 1 - i;
                    }
                }
            }
        }
        i += step;
    }
    if len(out) == 0 {
        die("could not read the builtin effect table out of src/rust-compiler/typeck.rs — it moved");
    }
    return out;
}

// The effect a builtin carries, or empty. Linear, over five entries.
pure function effect_of(effects: [Pair], name: String) -> String {
    for pair in effects {
        if pair.left == name {
            return pair.right;
        }
    }
    return "";
}

// Just the top-level usage block, not the whole of `main.rs`.
//
// **Both scrapes below used to read the entire file, and that was a latent defect.** They walk
// `eprintln!`s and join lines that begin with whitespace onto the previous flag — so the FIRST
// `eprintln!` added anywhere later in `main.rs` gets absorbed into whatever flag came last. It was
// correct only because nobody had added one. `burxt fmt`'s own usage message did, and the published
// `--target` row grew two sentences about formatting.
//
// Bounded by the exit that ends the block, so a message written after it cannot reach the table.
function usage_block(root: String) -> String touches files {
    let text: String = read_repository(root, "src/rust-compiler/main.rs");
    let start: Int = string_find(text, "burxt \{\} — the Burxt compiler");
    if start < 0 {
        die("the usage block's first line moved; fix this bound rather than removing it");
        return "";
    }
    let end: Int = string_find_from(text, "std::process::exit(2);", start);
    if end < 0 {
        die("the usage block no longer ends in `exit(2)`; fix this bound rather than removing it");
        return "";
    }
    return substring(text, start, end - start);
}

// Every `eprintln!("…")` in the block whose string holds neither a `"` nor a newline, in order.
//
// Both patterns below are this scan plus a test on the first few bytes of what came out:
// `eprintln!\("(  burxt [^"\n]*)"\)` and `eprintln!\("(  (?:-|\s)[^"\n]*)"\)`. `[^"\n]*` is greedy
// and cannot contain the `"` that has to follow it, so the run reaches the first `"` or the first
// newline and there is no shorter run to fall back to — which is why one scan answers both.
//
// The `\)` matters. A call whose string ends `\"` — an escaped quote — stops the run early and then
// fails this test, so it is skipped rather than truncated. `--target`'s explanation contains `\'`,
// which is not a quote and travels through.
pure function eprintln_strings(block: String) -> [String] {
    let stop: Int = len(block);
    let mutable out: [String] = [];
    let mutable i: Int = 0;
    while i < stop {
        let mutable step: Int = 1;
        if string_matches_at(block, "eprintln!(\"", i) {
            let from: Int = i + 11;
            let mutable j: Int = from;
            while j < stop && byte_at(block, j) != 34 && byte_at(block, j) != 10 {
                j += 1;
            }
            if j + 1 < stop && byte_at(block, j) == 34 && byte_at(block, j + 1) == 41 {
                let added: Int = push(out, substring(block, from, j - from));
                step = j + 2 - i;
            }
        }
        i += step;
    }
    return out;
}

// One command row: `re.match(r"  burxt (\S+)\s+(.*?)\s\s+(.*)$", line)`, with the Python's fallback.
//
// **This is the one pattern here that really backtracks, and the order is load-bearing.** `(\S+)` is
// pinned: `\s+` after it needs whitespace, so the run can only be the whole non-space run. `\s+` is
// then greedy and gives ground one character at a time, and for each width the lazy `(.*?)` grows
// from nothing — so the FIRST answer Python finds is the longest `\s+` for which a run of two
// whitespace characters exists somewhere later. That is what turns
//
//     burxt lsp                                language server over stdio
//
// into an empty `takes` and a full description, rather than into a description that begins mid-word:
// every width down to two-less-than-all fails, and then `(.*?)` matches nothing and the two
// remaining spaces are the separator.
//
// The fallback `r"  burxt (\S+)\s\s+(.*)$"` is tried only when that whole search fails, exactly as
// the Python tries it, and a line matching neither is dropped — which the anti-vacuity guard in
// `commands` then notices.
pure function command_row(line: String) -> Option<Command> {
    let stop: Int = len(line);
    if !string_starts_with(line, "  burxt ") {
        return Option.None;
    }
    let mutable name_end: Int = 8;
    while name_end < stop && !is_regex_space(byte_at(line, name_end)) {
        name_end += 1;
    }
    if name_end == 8 {                                               // `\S+` needs one
        return Option.None;
    }
    let name: String = substring(line, 8, name_end - 8);
    let ws_end: Int = skip_space(line, name_end);
    if ws_end == name_end {                                          // `\s+` needs one
        return Option.None;
    }
    let mutable width: Int = ws_end - name_end;
    while width >= 1 {
        let from: Int = name_end + width;
        let mutable q: Int = from;
        while q <= stop {
            if q + 1 < stop && is_regex_space(byte_at(line, q))
                    && is_regex_space(byte_at(line, q + 1)) {
                let rest: Int = skip_space(line, q);
                return Option.Some(Command {
                    name: name,
                    takes: strip_python(substring(line, from, q - from)),
                    what: strip_python(substring(line, rest, stop - rest)),
                });
            }
            q += 1;
        }
        width -= 1;
    }
    if ws_end - name_end >= 2 {
        return Option.Some(Command {
            name: name,
            takes: "",
            what: strip_python(substring(line, ws_end, stop - ws_end)),
        });
    }
    return Option.None;
}

// The command line, from the usage block in src/rust-compiler/main.rs.
//
// One row per `eprintln!`, and a call that spans a raw newline is a mistake rather than a shape to
// accommodate. It used to be accommodated — `review` and `mcp-schema` shared one call — and the
// workaround silently produced a row whose description was the whole of the NEXT row. Refusing to
// cross a newline turns that from a wrong published table into a missing command, which the guard
// below then catches.
function commands(block: String) -> [Command] {
    let said: [String] = eprintln_strings(block);
    let mutable found: [Command] = [];
    for line in said {
        if string_starts_with(line, "  burxt ") {
            match command_row(line) {
                Some(row) => {
                    let added: Int = push(found, row);
                }
                None => {}
            }
        }
    }
    let mutable required: [String] = [];
    let listed: Int = push(required, "check");
    let listed_build: Int = push(required, "build");
    let listed_run: Int = push(required, "run");
    let listed_review: Int = push(required, "review");
    let listed_schema: Int = push(required, "mcp-schema");
    let listed_lsp: Int = push(required, "lsp");
    for must in required {
        let mutable seen: Bool = false;
        for row in found {
            if row.name == must {
                seen = true;
            }
        }
        if !seen {
            die("the usage block in src/rust-compiler/main.rs no longer lists `" + must
                + "`, or this scrape stopped reading it. Fix the scrape rather than dropping the "
                + "command: two of these are the most distinctive features in the language.");
        }
    }
    return found;
}

// `\s\s+(.*)$` after a flag's head, which ends at `head_end`. At least two whitespace characters,
// and `\s+` then swallows the whole run because `(.*)$` is happy to start anywhere.
pure function flag_tail(line: String, head_end: Int) -> Option<Pair> {
    let stop: Int = len(line);
    let rest: Int = skip_space(line, head_end);
    if rest - head_end < 2 {
        return Option.None;
    }
    return Option.Some(Pair {
        left: substring(line, 2, head_end - 2),
        right: strip_python(substring(line, rest, stop - rest)),
    });
}

// `re.match(r"  (-{1,2}[A-Za-z0-9-]+(?: <[^>]+>)?)\s\s+(.*)$", line)` — a flag and its first
// sentence.
//
// Two greedy things here can give ground, and both are tried the way Python tries them: `-{1,2}`
// takes two dashes before one, and the optional ` <argument>` is attempted before being skipped.
// Neither alternative is exercised by today's usage block — `--target <triple>` matches on the first
// attempt — and they are written out because the day a flag is spelled `--` followed by a dash is the
// day a missing alternative would silently drop a row.
//
// `[A-Za-z0-9-]+` is pinned: it stops at a character outside the class, and every continuation this
// pattern can have — a space or a second whitespace — is outside it too, so a shorter run only moves
// the same failure earlier.
pure function flag_head(line: String) -> Option<Pair> {
    let stop: Int = len(line);
    if !string_starts_with(line, "  ") {
        return Option.None;
    }
    let mutable available: Int = 0;
    while available < 2 && 2 + available < stop && byte_at(line, 2 + available) == 45 {
        available += 1;
    }
    let mutable dashes: Int = available;
    while dashes >= 1 {
        let from: Int = 2 + dashes;
        let mutable i: Int = from;
        while i < stop && (string_is_alnum(byte_at(line, i)) || byte_at(line, i) == 45) {
            i += 1;
        }
        if i > from {
            // `(?: <[^>]+>)?`, greedy: ` <` then at least one byte that is not `>`, then `>`.
            if i + 2 < stop && byte_at(line, i) == 32 && byte_at(line, i + 1) == 60
                    && byte_at(line, i + 2) != 62 {
                let close: Int = string_find_from(line, ">", i + 2);
                if close >= 0 {
                    match flag_tail(line, close + 1) {
                        Some(row) => {
                            return Option.Some(row);
                        }
                        None => {}
                    }
                }
            }
            match flag_tail(line, i) {
                Some(row) => {
                    return Option.Some(row);
                }
                None => {}
            }
        }
        dashes -= 1;
    }
    return Option.None;
}

// Does this captured string open the way the flag pattern needs — two spaces, then a `-` or another
// whitespace character? `(  (?:-|\s)[^"\n]*)`.
pure function is_flag_capture(line: String) -> Bool {
    if len(line) < 3 || !string_starts_with(line, "  ") {
        return false;
    }
    return byte_at(line, 2) == 45 || is_regex_space(byte_at(line, 2));
}

// The flags, from the same usage block.
//
// These were never published. `cli.md` listed nine commands and not one flag, so `-o` survived only
// in a hand-written sentence at the foot of the page and `--target` — the switch behind the
// identical-IR-on-every-target claim — appeared nowhere at all. C1 added `-g` and `-O0`, and rather
// than write two more rows by hand they are scraped, for the reason the commands are: a table
// maintained by hand drifts from the compiler and nobody notices until a reader does.
//
// A flag's explanation runs over several `eprintln!`s, continued by indentation. They are joined
// back into one paragraph here, so the page can say WHY a flag exists rather than only that it does
// — `-g` being off by default is a design decision, not a default worth guessing at.
function flags(block: String) -> [Pair] {
    let said: [String] = eprintln_strings(block);
    let mutable rows: [Pair] = [];
    let mutable head: String = "";
    let mutable body: String = "";
    let mutable open: Bool = false;
    for raw in said {
        if is_flag_capture(raw) {
            let line: String = string_replace(raw, "\\'", "'");
            match flag_head(line) {
                Some(row) => {
                    if open {
                        let added: Int = push(rows, Pair { left: head, right: body });
                    }
                    head = row.left;
                    body = row.right;
                    open = true;
                }
                None => {
                    // A continuation line: same flag, more sentence.
                    if open && string_starts_with(line, "    ") {
                        body = strip_python(body + " " + strip_python(line));
                    }
                }
            }
        }
    }
    if open {
        let added: Int = push(rows, Pair { left: head, right: body });
    }
    // The same anti-vacuity guard the commands have. A scrape that silently finds nothing would
    // publish an empty table, and an empty table reads as "this compiler takes no flags".
    let mutable required: [String] = [];
    let a: Int = push(required, "-o");
    let b: Int = push(required, "-g");
    let c: Int = push(required, "-O0");
    let d: Int = push(required, "--target");
    for must in required {
        let mutable seen: Bool = false;
        for row in rows {
            if first_word(row.left) == must {
                seen = true;
            }
        }
        if !seen {
            die("the usage block in src/rust-compiler/main.rs no longer documents `" + must
                + "`, or this scrape stopped reading it. Fix the scrape rather than dropping the flag.");
        }
    }
    return rows;
}

// ----------------------------------------------------------------------------------------------
// The standard library
// ----------------------------------------------------------------------------------------------

// A `//` run, as markdown. An indented line inside one is an example, and stays one.
//
// `line[2:]` on every line, so the `//` goes and one space of the usual `// ` stays — which is why
// the test for an example is four MORE spaces and why a fence keeps whatever the fifth space was.
// Both are the Python's arithmetic; a tidier split here would re-indent every code block in the
// reference.
pure function prose(lines: [String]) -> String {
    let mutable out: [String] = [];
    let mutable code: [String] = [];
    for line in lines {
        let body: String = substring(line, 2, len(line) - 2);
        if string_starts_with(body, "    ") {
            let added: Int = push(code, substring(body, 4, len(body) - 4));
            continue;
        }
        if len(code) > 0 {
            let fenced: Int = push(out, "```burxt\n" + rstrip_python(string_join(code, "\n"))
                    + "\n```");
            let cleared: Int = truncate(code, 0);
        }
        let added: Int = push(out, strip_python(body));
    }
    if len(code) > 0 {
        let fenced: Int = push(out, "```burxt\n" + rstrip_python(string_join(code, "\n")) + "\n```");
    }

    // Blank-separated paragraphs, with the fences kept whole.
    let mutable text: [String] = [];
    let mutable para: [String] = [];
    for piece in out {
        if string_starts_with(piece, "```") {
            if len(para) > 0 {
                let joined: Int = push(text, string_join(para, " "));
                let cleared: Int = truncate(para, 0);
            }
            let added: Int = push(text, piece);
        } else if len(piece) == 0 {
            if len(para) > 0 {
                let joined: Int = push(text, string_join(para, " "));
                let cleared: Int = truncate(para, 0);
            }
        } else {
            let added: Int = push(para, piece);
        }
    }
    if len(para) > 0 {
        let joined: Int = push(text, string_join(para, " "));
    }
    let mutable kept: [String] = [];
    for piece in text {
        if len(strip_python(piece)) > 0 {
            let added: Int = push(kept, piece);
        }
    }
    return string_join(kept, "\n\n");
}

// `re.match(r"^//\s*lib/<name>\.bx\s*[—-]\s*(.*)$", line)` — the banner at the top of the file.
//
// `[—-]` is a two-member class holding an em dash and a hyphen, and the em dash is one CHARACTER to
// Python and three bytes here. Nothing else in the pattern can begin with either byte, so testing
// the three-byte sequence and then the one byte answers what the class answers.
pure function banner_title(line: String, name: String) -> Option<String> {
    let stop: Int = len(line);
    if !string_starts_with(line, "//") {
        return Option.None;
    }
    let mutable i: Int = skip_space(line, 2);
    let head: String = "lib/" + name + ".bx";
    if !string_matches_at(line, head, i) {
        return Option.None;
    }
    i = skip_space(line, i + len(head));
    if string_matches_at(line, "—", i) {
        i += 3;
    } else if i < stop && byte_at(line, i) == 45 {
        i += 1;
    } else {
        return Option.None;
    }
    i = skip_space(line, i);
    // `m.group(1).strip().rstrip(".")`
    let rest: String = strip_python(substring(line, i, stop - i));
    let mutable to: Int = len(rest);
    while to > 0 && byte_at(rest, to - 1) == 46 {                    // `.`
        to -= 1;
    }
    return Option.Some(substring(rest, 0, to));
}

// `re.match(r'^//\s+use\s+"lib/', after)` — the banner shows the `use` line as an indented example.
// This page already renders that line itself, and `prose` would turn it into a second, identical
// fence.
pure function is_use_example(line: String) -> Bool {
    if !string_starts_with(line, "//") {
        return false;
    }
    let after_slashes: Int = skip_space(line, 2);
    if after_slashes == 2 {                                          // `\s+` needs one
        return false;
    }
    if !string_matches_at(line, "use", after_slashes) {
        return false;
    }
    let after_use: Int = skip_space(line, after_slashes + 3);
    if after_use == after_slashes + 3 {
        return false;
    }
    return string_matches_at(line, "\"lib/", after_use);
}

// `re.match(r"^//\s*-{2,}\s*(.*?)\s*-{2,}\s*$", raw)` — a section banner inside a module.
//
// Only whether it MATCHED is needed: the Python put the title on every symbol as `section` and no
// page ever read it. What the match does is reset the comment buffer, so a banner's own words cannot
// become the documentation of whatever is declared under it.
//
// Written as the condition for a match to exist rather than as a scan, because two greedy `-{2,}`
// with a lazy group between them backtrack against each other. A match exists exactly when there are
// two dashes after the leading whitespace, two more at the end after the trailing whitespace, and the
// two pairs do not overlap — everything between is `(.*?)`, which matches anything.
pure function is_section_banner(raw: String) -> Bool {
    if !string_starts_with(raw, "//") {
        return false;
    }
    let from: Int = skip_space(raw, 2);
    let to: Int = len(rstrip_python(raw));
    if from + 1 >= to || byte_at(raw, from) != 45 || byte_at(raw, from + 1) != 45 {
        return false;
    }
    if to - from < 4 {
        return false;
    }
    return byte_at(raw, to - 2) == 45 && byte_at(raw, to - 1) == 45;
}

// `raw.split(" \{")[0].rstrip().rstrip("\{").rstrip()` — a declaration line without its body.
pure function declaration_signature(raw: String) -> String {
    let mutable text: String = rstrip_python(before_first(raw, " \{"));
    let mutable to: Int = len(text);
    while to > 0 && byte_at(text, to - 1) == 123 {                   // `\{`
        to -= 1;
    }
    return rstrip_python(substring(text, 0, to));
}

// `re.match(r"^(?:public\s+)?(?P<kind>class|enum|interface)\s+(?P<name>[A-Z][A-Za-z0-9_]*)", raw)`.
//
// `(?:public\s+)?` is greedy, so it is tried first; a line beginning `public` cannot also begin with
// one of the three kind words, so the two attempts are disjoint and the order cannot matter. The
// `\s+` after the kind is what stops `classify` reading as `class`.
pure function type_decl(raw: String) -> Option<TypeDecl> {
    let mutable from: Int = 0;
    if string_starts_with(raw, "public") {
        let after: Int = skip_space(raw, 6);
        if after > 6 {
            from = after;
        }
    }
    match type_decl_at(raw, from) {
        Some(found) => {
            return Option.Some(found);
        }
        None => {}
    }
    if from == 0 {
        return Option.None;
    }
    return type_decl_at(raw, 0);
}

pure function type_decl_at(raw: String, from: Int) -> Option<TypeDecl> {
    let stop: Int = len(raw);
    let mutable kinds: [String] = [];
    let a: Int = push(kinds, "class");
    let b: Int = push(kinds, "enum");
    let c: Int = push(kinds, "interface");
    for kind in kinds {
        if string_matches_at(raw, kind, from) {
            let after: Int = skip_space(raw, from + len(kind));
            if after > from + len(kind) && after < stop && string_is_upper(byte_at(raw, after)) {
                let mutable i: Int = after + 1;
                while i < stop && (string_is_alnum(byte_at(raw, i)) || byte_at(raw, i) == 95) {
                    i += 1;
                }
                return Option.Some(TypeDecl {
                    kind: kind,
                    name: substring(raw, after, i - after),
                });
            }
        }
    }
    return Option.None;
}

// `\(\s*(?P<mut>mutable\s+)?self\s*:\s*(?P<recv>[^)]+?)\s*\)\s*` — a method's receiver.
//
// `[^)]+?` is lazy and cannot hold a `)`, so it ends at the first one; `\s*` before the `\)` then
// eats whatever whitespace sat in front of it, which makes the group the receiver type with its
// trailing space removed. Python's `.strip()` on the group removes the leading one.
pure function receiver_at(raw: String, at: Int) -> Option<Receiver> {
    let stop: Int = len(raw);
    if at >= stop || byte_at(raw, at) != 40 {                        // `(`
        return Option.None;
    }
    let mutable i: Int = skip_space(raw, at + 1);
    let mutable mutates: Bool = false;
    if string_matches_at(raw, "mutable", i) {
        let after: Int = skip_space(raw, i + 7);
        if after > i + 7 {
            mutates = true;
            i = after;
        }
    }
    if !string_matches_at(raw, "self", i) {
        return Option.None;
    }
    i = skip_space(raw, i + 4);
    if i >= stop || byte_at(raw, i) != 58 {                          // `:`
        return Option.None;
    }
    i = skip_space(raw, i + 1);
    let close: Int = string_find_from(raw, ")", i);
    if close < 0 || close <= i {                                     // `+?` needs one
        return Option.None;
    }
    return Option.Some(Receiver {
        mutates: mutates,
        receiver: strip_python(substring(raw, i, close - i)),
        next: skip_space(raw, close + 1),
    });
}

// The `function` forms:
//
//     ^(?:public\s+)?(?P<pure>pure\s+)?function\s+
//      (?:\(\s*(?P<mut>mutable\s+)?self\s*:\s*(?P<recv>[^)]+?)\s*\)\s*)?
//      (?P<name>[a-z_][A-Za-z0-9_]*)\s*(?P<rest>.*)$
//
// `pure` is captured by the Python and never read; `rest` likewise. Both are dropped here rather
// than carried, because a field nothing reads is a claim that something does.
pure function fn_decl(raw: String) -> Option<FnDecl> {
    let stop: Int = len(raw);
    let mutable i: Int = 0;
    if string_matches_at(raw, "public", i) {
        let after: Int = skip_space(raw, i + 6);
        if after > i + 6 {
            i = after;
        }
    }
    if string_matches_at(raw, "pure", i) {
        let after: Int = skip_space(raw, i + 4);
        if after > i + 4 {
            i = after;
        }
    }
    if !string_matches_at(raw, "function", i) {
        return Option.None;
    }
    let after_function: Int = skip_space(raw, i + 8);
    if after_function == i + 8 {                                     // `\s+` needs one
        return Option.None;
    }
    let mutable at: Int = after_function;
    let mutable mutates: Bool = false;
    let mutable receiver: String = "";
    match receiver_at(raw, at) {
        Some(found) => {
            mutates = found.mutates;
            receiver = found.receiver;
            at = found.next;
        }
        None => {}
    }
    if at >= stop {
        return Option.None;
    }
    let opening: Int = byte_at(raw, at);
    if !string_is_lower(opening) && opening != 95 {                  // `[a-z_]`
        return Option.None;
    }
    let from: Int = at;
    at += 1;
    while at < stop && (string_is_alnum(byte_at(raw, at)) || byte_at(raw, at) == 95) {
        at += 1;
    }
    return Option.Some(FnDecl {
        name: substring(raw, from, at - from),
        mutates: mutates,
        receiver: receiver,
    });
}

// The words that open a top-level declaration. Used only to notice that a line WAS one and this
// parser failed to read it — see the refusal in `module_of`. Add to this when the language grows a
// declaring word, which is the same moment the patterns above need to learn it.
pure function is_declaring_word(word: String) -> Bool {
    return word == "public" || word == "pure" || word == "function" || word == "class"
            || word == "enum" || word == "interface";
}

// Every declaration in lib/<name>.bx, with the prose written above it.
function module_of(root: String, name: String) -> Module touches files {
    let path: String = "lib/" + name + ".bx";
    let mutable lines: [String] = [];
    let read: Int = read_lines(root + "/" + path, lines);

    // The banner at the top of the file: `// lib/map.bx — a key-value table, in insertion order.`
    let mutable title: String = name;
    let mutable blurb_lines: [String] = [];
    let mutable scan: Int = len(lines);
    if scan > 40 {
        scan = 40;
    }
    let mutable i: Int = 0;
    while i < scan {
        match banner_title(lines[i], name) {
            Some(found) => {
                title = found;
                let mutable j: Int = i + 1;
                while j < len(lines) {
                    let after: String = lines[j];
                    if string_starts_with(after, "// ===") || !string_starts_with(after, "//") {
                        break;
                    }
                    if !is_use_example(after) {
                        let added: Int = push(blurb_lines, after);
                    }
                    j += 1;
                }
                break;
            }
            None => {}
        }
        i += 1;
    }

    let mutable symbols: [Symbol] = [];
    let mutable buffer: [String] = [];
    let mutable n: Int = 0;
    while n < len(lines) {
        let raw: String = rstrip_python(lines[n]);
        n += 1;
        if string_starts_with(raw, "// ===") {
            let cleared: Int = truncate(buffer, 0);
            continue;
        }
        if is_section_banner(raw) {
            let cleared: Int = truncate(buffer, 0);
            continue;
        }
        if string_starts_with(raw, "//") {
            let added: Int = push(buffer, raw);
            continue;
        }
        if len(raw) == 0 {
            // Prose separated from a declaration by a blank line is about the section, not the
            // declaration. Attributing it would put a paragraph about tombstones under `count`.
            let cleared: Int = truncate(buffer, 0);
            continue;
        }

        let signature: String = declaration_signature(raw);
        let kind: Option<TypeDecl> = type_decl(raw);
        let call: Option<FnDecl> = fn_decl(raw);

        // A declaration this parser cannot read is DROPPED, silently, and the page is regenerated
        // without it. That is worse than a crash, because `the_reference_is_not_stale` compares the
        // committed page against a fresh generation — so its remedy is *"regenerate it"*, and
        // following that instruction commits the deletion and turns the suite green. **A test whose
        // fix is to regenerate cannot catch a generator that loses things; it certifies whatever the
        // generator produced.**
        //
        // It has happened: `public` was added to the language and these patterns did not know the
        // word, so every symbol a package marked as its public API — the twelve types and five
        // functions a consumer needs — vanished from the reference while the docs kept the private
        // helpers. Caught by reading `-188` in a diffstat, which is not a mechanism.
        //
        // Declarations sit at column 0 (verified: `lib/` has no indented one), so a line that opens
        // with a declaring word and matches neither pattern is this parser failing to keep up with
        // the language. `if len(symbols) == 0` below already makes exactly this check at file
        // granularity — *"the parser needs fixing"* — and a file that loses eleven of twelve symbols
        // passes it. This is that check per line, which is where the information is.
        let mutable unread: Bool = is_declaring_word(first_word(raw));
        match kind {
            Some(found) => {
                unread = false;
            }
            None => {}
        }
        match call {
            Some(found) => {
                unread = false;
            }
            None => {}
        }
        if unread {
            die(path + ":" + to_string(n) + " — this parser could not read a declaration:\n"
                + "    " + raw + "\n"
                + "It would have been dropped from the reference and the page regenerated without "
                + "it. Teach DECL/TYPE_DECL the new form rather than deleting the line.");
        }

        match kind {
            Some(found) => {
                // A one-line `class Map<K, V> \{ entries: … \}` carries its fields in the signature.
                let mutable shown: String = signature;
                if string_ends_with(raw, "\}") {
                    shown = raw;
                }
                let added: Int = push(symbols, Symbol {
                    name: found.name,
                    kind: found.kind,
                    receiver: "",
                    mutates: false,
                    signature: shown,
                    doc: prose(buffer),
                    line: n,
                });
            }
            None => {
                match call {
                    Some(found) => {
                        let mutable shape: String = "function";
                        if len(found.receiver) > 0 {
                            shape = "method";
                        }
                        let added: Int = push(symbols, Symbol {
                            name: found.name,
                            kind: shape,
                            receiver: found.receiver,
                            mutates: found.mutates,
                            signature: signature,
                            doc: prose(buffer),
                            line: n,
                        });
                    }
                    None => {}
                }
            }
        }
        let cleared: Int = truncate(buffer, 0);
    }

    if len(symbols) == 0 {
        die("read no declarations out of " + path + " — the parser needs fixing");
    }
    return Module {
        name: name,
        path: path,
        title: title,
        blurb: prose(blurb_lines),
        symbols: symbols,
    };
}

// ----------------------------------------------------------------------------------------------
// The authored tables
// ----------------------------------------------------------------------------------------------

// The standard library, in reading order rather than alphabetical: absence before failure, the
// containers after the pieces they are built from, and the modules that reach outside the process
// last.
//
// **This list held seven names while `lib/` held twenty-two**, so the reference published at 1.0.0
// documented under a third of the standard library — `array`, `math`, `time`, `hash`, `secure`,
// `encoding`, `csv`, `path` and six more had no page at all. `the_reference_is_not_stale` did not
// notice, and could not: it regenerates what this list names and compares that, so a module absent
// from the list is a module the check has never heard of. A floor cannot see what it was not told
// about, which is the same lesson the fail ratchet has already taught this project once.
//
// `every_library_module_has_a_reference_page` in `tests/runner.rs` now derives the expected set from
// `lib/` itself, so adding a module to the library and forgetting the site is a failing test.
//
// A function rather than a top-level table, because a top-level `let` is invisible inside a function
// body and every reader of this is one.
function library_modules() -> [String] {
    let mutable out: [String] = [];
    push(out, "option");
    push(out, "result");
    push(out, "decimal");
    push(out, "string");
    push(out, "array");
    push(out, "set");
    push(out, "map");
    push(out, "math");
    push(out, "fn");
    push(out, "json");
    push(out, "csv");
    push(out, "html");
    push(out, "cgi");
    push(out, "encoding");
    push(out, "zip");
    push(out, "deflate");
    push(out, "inflate");
    // Added 2026-08-21, when the PNG codec left `scripts/editor-icons.bx` so a fixture could
    // reach the row filter no artwork uses.
    push(out, "png");
    push(out, "hash");
    push(out, "secure");
    push(out, "vector");
    push(out, "files");
    push(out, "path");
    push(out, "os");
    push(out, "net");
    push(out, "http");
    push(out, "tls");
    push(out, "time");
    push(out, "random");
    push(out, "log");
    push(out, "test");
    return out;
}

// The builtins.
//
// `signature` and `answers` are written here; `probe` is what proves them. Every probe is compiled,
// and a failing one stops this program — so a signature on the page is one the compiler accepted.
// `refuses`, where it is not empty, is a program whose refusal is quoted verbatim, because a
// builtin's limits are the interesting half and a paraphrase of an error message is how the guide
// once lied.
function builtins() -> [Builtin] {
    let mutable out: [Builtin] = [];

    // ---- eleven that were implemented and never documented, added by the 1.0 scan (roadmap B14).
    // The page claims to be generated from `is_reserved_name`, and nine of these were missing from
    // THAT list too — one omission showing up twice, which is what a single source of truth is for.

    push(out, Builtin {
        name: "print_error",
        signature: "print_error(value)",
        answers: "nothing",
        allocates: false,
        doc: "Writes one value and a newline to **standard error**. The same statement as `print` with a different destination, so the per-type formatting cannot fork — two statements would mean two formatters, and the first time one learned about a new type the other would print something else.",
        probe: "print_error(\"something went wrong\");\n",
        refuses: "",
    });

    push(out, Builtin {
        name: "print_exact",
        signature: "print_exact(value)",
        answers: "nothing",
        allocates: false,
        doc: "Writes one value to **standard output** and appends **nothing** — no newline. The same statement as `print` and `print_error`, so the per-type formatting cannot fork; the trailing newline is the only difference.\n\nIt exists for output whose length is declared before its bytes. Language Server Protocol framing is `Content-Length: N`, a blank line, and then exactly N bytes; so is CGI, and so is any protocol a program speaks down its own stdout. `print` cannot write that, and the routes that look like they can are a different stream: `file_write(\"/dev/stdout\", s)` and `write_bytes(\"/dev/stdout\", b)` come out reordered against `print`, and both truncate when stdout is a regular file rather than a pipe. An editor hands a language server a pipe, so that shape passes its own tests and destroys the output the moment anyone redirects it.\n\nInterpolation works, which is usually how a header is written: `print_exact(\"Content-Length: \{n\}\\r\\n\\r\\n\")`.\n\n**One limit, measured rather than assumed.** A String may hold a zero byte — `len(from_bytes([65, 0, 66]))` is 3 — and printing one stops at that byte, in `print_exact` exactly as in `print`, because both share the one formatter. So a declared length and a written length can disagree for text built out of arbitrary bytes. JSON cannot contain a raw zero byte, so protocol framing is unaffected; for anything that can, write the bytes with `write_bytes` rather than declaring a length you did not write. See `tests/limitations/`.",
        probe: "print_exact(\"Content-Length: 7\\r\\n\\r\\n\");\n",
        refuses: "",
    });

    push(out, Builtin {
        name: "bit_and",
        signature: "bit_and(a: Int, b: Int)",
        answers: "`Int`",
        allocates: false,
        doc: "Bitwise AND. **Named rather than an operator**, because `a & b == c` means `a & (b == c)` in C — a precedence table a reviewer has to remember is the opposite of what this language is for.",
        probe: "print(bit_and(12, 10));\n",
        refuses: "",
    });

    push(out, Builtin {
        name: "bit_or",
        signature: "bit_or(a: Int, b: Int)",
        answers: "`Int`",
        allocates: false,
        doc: "Bitwise OR.",
        probe: "print(bit_or(12, 10));\n",
        refuses: "",
    });

    push(out, Builtin {
        name: "bit_xor",
        signature: "bit_xor(a: Int, b: Int)",
        answers: "`Int`",
        allocates: false,
        doc: "Bitwise XOR.",
        probe: "print(bit_xor(12, 10));\n",
        refuses: "",
    });

    push(out, Builtin {
        name: "bit_not",
        signature: "bit_not(a: Int)",
        answers: "`Int`",
        allocates: false,
        doc: "Every bit flipped. `bit_not(0)` is `-1`, because an `Int` is signed and there is nowhere else for the top bit to go.",
        probe: "print(bit_not(0));\n",
        refuses: "",
    });

    push(out, Builtin {
        name: "shift_left",
        signature: "shift_left(x: Int, n: Int)",
        answers: "`Int`",
        allocates: false,
        doc: "Shifts left by `n`, which must be 0 to 63. Bits shifted past the top are **discarded** — the one place in this language where losing information is not an error, because it is what a shift is for. So it is **not** `x * 2^n`: multiplication traps on overflow and this does not.",
        probe: "print(shift_left(1, 10));\n",
        refuses: "",
    });

    push(out, Builtin {
        name: "shift_right_zeros",
        signature: "shift_right_zeros(x: Int, n: Int)",
        answers: "`Int`",
        allocates: false,
        doc: "Shifts right by `n`, filling with zeros — a logical shift. `shift_right_zeros(-1, 63)` is `1`. Two right shifts exist because on a negative value zero-fill and sign-fill give different answers, and one symbol cannot say which.",
        probe: "print(shift_right_zeros(0 - 1, 63));\n",
        refuses: "",
    });

    push(out, Builtin {
        name: "shift_right_sign",
        signature: "shift_right_sign(x: Int, n: Int)",
        answers: "`Int`",
        allocates: false,
        doc: "Shifts right by `n`, copying the sign bit — an arithmetic shift. `shift_right_sign(-1, 63)` is `-1`, and `shift_right_sign(x, n)` equals `divide_floor(x, 2^n)`.",
        probe: "print(shift_right_sign(0 - 1, 63));\n",
        refuses: "",
    });

    push(out, Builtin {
        name: "c_is_null",
        signature: "c_is_null(p: CPointer)",
        answers: "`Bool`",
        allocates: false,
        doc: "Did the C call fail? One of only **two** things that may be done with a `CPointer`. There is no `==` on one, no arithmetic and no printing — a pointer is a token to hand back to C, not a value to reason about.",
        probe: "external function strstr(a: String, b: String) -> CPointer;\n"
                + "print(c_is_null(strstr(\"ab\", \"b\")));\n",
        refuses: "",
    });

    push(out, Builtin {
        name: "c_string_at",
        signature: "c_string_at(p: CPointer)",
        answers: "`String`",
        allocates: true,
        doc: "Copies NUL-terminated bytes from C into a Burxt `String`. **The copy is the wall**: afterwards Burxt owns the bytes and the pointer is not kept, so who frees it stops being a question. A null pointer dies here rather than answering `\"\"` — unset and empty are different facts.",
        probe: "external function strstr(a: String, b: String) -> CPointer;\n"
                + "print(c_string_at(strstr(\"hello world\", \"world\")));\n",
        refuses: "",
    });

    push(out, Builtin {
        name: "c_bytes_at",
        signature: "c_bytes_at(p: CPointer, n: Int)",
        answers: "`[Int]`",
        allocates: true,
        doc: "Copies `n` bytes from C into a growable array, one byte per element, zero-extended so `0xFF` arrives as `255` rather than `-1`. The counterpart to `c_string_at`, and it is what makes OS entropy reachable: `/dev/urandom` is a character device, so `read_file` measures it and gets nothing. **Where the length comes from is the pointer wall's one soft edge** — `n` is your claim, and nothing in the type can check it. A null pointer and a negative count are refused.",
        probe: "external function strstr(a: String, b: String) -> CPointer;\n"
                + "let bytes: [Int] = c_bytes_at(strstr(\"hello\", \"llo\"), 3);\n"
                + "print(len(bytes));\n",
        refuses: "",
    });

    push(out, Builtin {
        name: "c_bytes_to",
        signature: "c_bytes_to(p: CPointer, bytes: [Int])",
        answers: "`Int` — how many it wrote",
        allocates: false,
        doc: "Writes an array of bytes into memory C owns, the mirror of `c_bytes_at`. It is what lets a program hand C a **struct**: `bind` wants a `sockaddr_in`, `nanosleep` wants a `timespec`, `setsockopt` wants a flag — all of them small, all of them by pointer, and until this existed Burxt could read C's memory and never write it. **The length is not a claim here**, it is `len(bytes)`; what stays yours is whether the destination is big enough, which belongs to C. A null pointer is refused, and a number outside `0..=255` **exits 70 rather than truncating** — `256` quietly becoming `0` is a corrupt port or a corrupt length prefix.",
        probe: "external function malloc(size: Int) -> CPointer;\n"
                + "let p: CPointer = malloc(4);\n"
                + "print(c_bytes_to(p, [2, 0, 31, 144]));",
        refuses: "",
    });

    push(out, Builtin {
        name: "print",
        signature: "print(value)",
        answers: "nothing",
        allocates: false,
        doc: "Writes one value and a newline. Takes an `Int`, a `Bool`, a `String` or a `Decimal<S>`, and an interpolated string goes out piece by piece with nothing built — which is why printing costs no memory.",
        probe: "print(\"x\");\n"
                + "print(1);\n"
                + "print(true);\n"
                + "print($1.50);\n",
        refuses: "",
    });

    push(out, Builtin {
        name: "len",
        signature: "len(xs) -> Int",
        answers: "how many elements, or how many BYTES of a `String`",
        allocates: false,
        doc: "On a `String` this counts bytes, not characters. That is deliberate and it is the same decision `byte_at` makes: the byte-versus-character question is one a program has to answer, and a name that hid it would answer it wrongly for somebody.",
        probe: "let xs: [Int; 3] = [1, 2, 3];\n"
                + "print(len(xs));\n"
                + "print(len(\"hello\"));\n",
        refuses: "",
    });

    push(out, Builtin {
        name: "byte_at",
        signature: "byte_at(s, i) -> Int",
        answers: "the byte at `i`",
        allocates: false,
        doc: "Bounds are always checked. The name says BYTE so that nothing has to guess whether an index into text means a byte or a character.",
        probe: "print(byte_at(\"hello\", 1));\n",
        refuses: "",
    });

    push(out, Builtin {
        name: "handle_of",
        signature: "handle_of(value) -> Handle<T>",
        answers: "a `Handle<T>` naming `value`, for a host to carry between calls",
        allocates: true,
        doc: "**A value a host can hold while Burxt is not running.** A browser calls in on every click, and between two calls there is nowhere for the application's state to be — so it crosses as text, comes back as `Json`, and something hand-validates it into a class. That surrenders the checking property exactly where a program works hardest.\n\n"
                + "`handle_of` files the value and answers an integer the host keeps. It is an **index into a table, never an address**: a pointer handed out is a pointer a host can invent, and a wrong one is type confusion with no diagnostic. The table costs a slot and a lookup, and buys three named refusals instead.\n\n"
                + "The value is COPIED into the region, because what outlives a call cannot live in a stack slot. Takes a class — the state a host carries — since a scalar has no place to point at.",
        probe: "class Counter \{ hits: Int \}\n"
                + "let h: Handle<Counter> = handle_of(Counter \{ hits: 1 \});\n"
                + "print(handle_value(h).hits);\n",
        refuses: "",
    });

    push(out, Builtin {
        name: "handle_value",
        signature: "handle_value(handle) -> T",
        answers: "the value the handle names",
        allocates: false,
        doc: "The other half of `handle_of`. **Three failures, three messages**, because a check that cannot tell them apart sends the reader to the wrong one:\n\n"
                + "- *never issued by this module* — the integer did not come from a call in here;\n- *replaced by a later call* — it did, and then something newer superseded it. The message names the generation the handle carried and the generation that is live, since the fix is to keep the handle the last call answered with;\n- *names a value of a different type, or came from a different module*.\n\n"
                + "The second is the one an index alone cannot catch, and the one that actually happens: a slot stays live across an update, so an index check passes and the host reads the wrong value silently. That is the use-after-free this exists to refuse.",
        probe: "class Counter \{ hits: Int \}\n"
                + "let h: Handle<Counter> = handle_of(Counter \{ hits: 7 \});\n"
                + "print(handle_value(h).hits);\n",
        refuses: "",
    });

    push(out, Builtin {
        name: "byte_as_string",
        signature: "byte_as_string(n) -> String",
        answers: "a one-byte `String` holding `n`",
        allocates: true,
        doc: "**The exact inverse of `byte_at`**: `byte_at(byte_as_string(n), 0)` is `n` for every one of the 256 values. `n` must be 0 to 255 — a literal outside that is refused when the program is compiled, and anything computed is checked when it runs.\n\n"
                + "It is the ONLY way to turn a number into text, and the reason it had to be a builtin rather than a library function: `substring` of a literal was the only Int-to-String path there was, and a source file must be valid UTF-8, so a byte above 127 could only be written down inside a complete multi-byte character. `to_string(233)` is a different conversion — three digit characters, `\"233\"`.\n\n"
                + "**It is also the one builtin that can build a `String` `is_valid_utf8` rejects.** `byte_as_string(0xC3)` on its own is a UTF-8 lead byte with no continuation after it. That is what it is FOR — assembling a sequence one byte at a time — but it means the caller owns the validity of what comes out. For text, use `from_codepoint` in `lib/string.bx`, which emits a whole character or refuses.\n\n"
                + "A zero byte is ORDINARY, not a terminator: a Burxt `String` carries its length in a header, so `byte_as_string(0)` has length 1 and the full 0..255 range needs no special case.",
        probe: "print(byte_as_string(65));\n"
                + "print(byte_at(byte_as_string(200), 0));\n"
                + "print(byte_as_string(195) + byte_as_string(169));\n",
        refuses: "print(byte_as_string(256));\n",
    });

    push(out, Builtin {
        name: "substring",
        signature: "substring(s, from, count) -> String",
        answers: "`count` bytes of `s`, starting at `from`",
        allocates: true,
        doc: "Builds a new String, so it needs somewhere to put it.",
        probe: "print(substring(\"hello\", 1, 3));\n",
        refuses: "",
    });

    push(out, Builtin {
        name: "to_string",
        signature: "to_string(value) -> String",
        answers: "the value, written out",
        allocates: true,
        doc: "Takes an `Int`, a `Bool` or a `Decimal<S>`. It shares its formatter with `print`, so the two can never disagree about what a number looks like. A `Bool` allocates nothing, because both answers are constants.\n\n"
                + "There is no way for a class of yours to have one: `to_string` is a builtin rather than an interface a type can implement, so a user type has no display form. That is a real gap rather than a decision.",
        probe: "print(to_string(42));\n"
                + "print(to_string($19.99));\n"
                + "print(to_string(true));\n",
        refuses: "let s: String = \"already text\";\n"
                + "print(to_string(s));\n",
    });

    push(out, Builtin {
        name: "push",
        signature: "push(xs, value) -> Int",
        answers: "the new length",
        allocates: true,
        doc: "Appends to a growable array. The array lives in a region, which is what makes growing it a bump rather than a reallocation someone has to own.",
        probe: "let mutable xs: [Int] = [];\n"
                + "print(push(xs, 1));\n",
        refuses: "",
    });

    push(out, Builtin {
        name: "truncate",
        signature: "truncate(xs, n) -> Int",
        answers: "the new length",
        allocates: false,
        doc: "Shortens a growable array to `n`. Nothing is freed — the region owns the storage, and it goes when the region does.",
        probe: "let mutable xs: [Int] = [];\n"
                + "push(xs, 1);\n"
                + "print(truncate(xs, 0));\n",
        refuses: "",
    });

    push(out, Builtin {
        name: "read_file",
        signature: "read_file(path) -> String",
        answers: "the whole file",
        allocates: true,
        doc: "Reaches the filesystem, so it is registered as `touches files` — a function that calls it must say so, and one that does not may not call it.",
        probe: "function load(path: String) -> String allocates touches files \{\n"
                + "    return read_file(path);\n"
                + "\}\n",
        refuses: "",
    });

    push(out, Builtin {
        name: "write_file",
        signature: "write_file(path, contents) -> Int",
        answers: "how many bytes went out",
        allocates: false,
        doc: "Replaces the file. Reaches the filesystem, so it carries `touches files`.",
        probe: "function save(path: String, text: String) -> Int touches files \{\n"
                + "    return write_file(path, text);\n"
                + "\}\n",
        refuses: "",
    });

    push(out, Builtin {
        name: "write_bytes",
        signature: "write_bytes(path, buffer) -> Int",
        answers: "how many bytes went out",
        allocates: false,
        doc: "Writes a growable `[Int]` where each element is one byte. For output that is not text — and a value outside 0–255 is a refusal rather than a truncation.",
        probe: "function dump(path: String, bytes: [Int]) -> Int touches files \{\n"
                + "    return write_bytes(path, bytes);\n"
                + "\}\n",
        refuses: "",
    });

    push(out, Builtin {
        name: "argument",
        signature: "argument(n) -> String",
        answers: "the nth command-line argument",
        allocates: false,
        doc: "Reads the command line, which is `touches input`.",
        probe: "function first() -> String touches input \{\n"
                + "    return argument(1);\n"
                + "\}\n",
        refuses: "",
    });

    push(out, Builtin {
        name: "argument_count",
        signature: "argument_count() -> Int",
        answers: "how many arguments there are",
        allocates: false,
        doc: "Reads the command line, which is `touches input`.",
        probe: "function how_many() -> Int touches input \{\n"
                + "    return argument_count();\n"
                + "\}\n",
        refuses: "",
    });

    push(out, Builtin {
        name: "divide_floor",
        signature: "divide_floor(a, b) -> Int",
        answers: "`a / b`, rounded toward negative infinity",
        allocates: false,
        doc: "`Int / Int` is refused, because the two reasonable answers for a negative numerator disagree and an operator cannot ask which you meant. This is one of them; `divide_toward_zero` is the other. Dividing by zero stops the program.",
        probe: "print(divide_floor(-7, 2));\n",
        refuses: "",
    });

    push(out, Builtin {
        name: "divide_toward_zero",
        signature: "divide_toward_zero(a, b) -> Int",
        answers: "`a / b`, rounded toward zero",
        allocates: false,
        doc: "What C and most CPUs do. The other half of the pair `Int / Int` refuses to guess between.",
        probe: "print(divide_toward_zero(-7, 2));\n",
        refuses: "",
    });

    push(out, Builtin {
        name: "remainder",
        signature: "remainder(a, b) -> Int",
        answers: "what is left over",
        allocates: false,
        doc: "Keeps the sign of its LEFT operand, like C's `%`. Worth knowing when the result indexes something: a negative index is a bounds failure, not a wrong answer.",
        probe: "print(remainder(7, 2));\n",
        refuses: "",
    });

    push(out, Builtin {
        name: "hash",
        signature: "hash(key) -> Int",
        answers: "a non-negative hash",
        allocates: false,
        doc: "Defined on the `Equatable` types — `Int`, `Bool`, `String`, `Decimal<S>` — which is exactly the set `==` works on. The sign bit is cleared, so it can index a table through `remainder` without producing a negative index. This is the only compiler support `lib/map.bx` needs.",
        probe: "print(hash(\"key\"));\n"
                + "print(hash(7));\n",
        refuses: "",
    });

    push(out, Builtin {
        name: "old",
        signature: "old(expression)",
        answers: "what the expression was BEFORE the body ran",
        allocates: false,
        doc: "Legal only inside an `ensures` clause, where it is what lets a postcondition talk about change rather than only about the answer.\n\n"
                + "One limit worth knowing, and it is the compiler's rather than the design's: an `ensures` on a method that returns a **class** is refused today. A class travels back through a hidden pointer into the caller's storage, and binding `result` to that needs care a scalar does not. Return a scalar, or drop the clause.",
        probe: "class Counter \{\n"
                + "    n: Int,\n"
                + "\n"
                + "    function (self) next() -> Int\n"
                + "        ensures result == old(self.n) + 1\n"
                + "    \{ return self.n + 1; \}\n"
                + "\}\n",
        refuses: "class Counter \{\n"
                + "    n: Int,\n"
                + "\n"
                + "    function (self) bumped() -> Counter\n"
                + "        ensures result.n == old(self.n) + 1\n"
                + "    \{ return Counter \{ n: self.n + 1 \}; \}\n"
                + "\}\n",
    });

    push(out, Builtin {
        name: "result",
        signature: "result",
        answers: "the value being returned",
        allocates: false,
        doc: "A name, not a call, and in scope only inside an `ensures` clause. A declaration that takes a parameter called `result` and also writes `result` in an `ensures` is refused for the collision rather than shadowed quietly.",
        probe: "function doubled(n: Int) -> Int\n"
                + "    ensures result == n * 2\n"
                + "\{ return n * 2; \}\n",
        refuses: "",
    });

    push(out, Builtin {
        name: "exit",
        signature: "exit(code)",
        answers: "nothing — the program ends",
        allocates: false,
        doc: "Reserved because the runtime calls libc's `exit` to end a program on a failed contract or a bounds violation. A program that shadowed it would change what a failure does.",
        probe: "",
        refuses: "",
    });

    push(out, Builtin {
        name: "main",
        signature: "main",
        answers: "nothing — it is not an entry point",
        allocates: false,
        doc: "Burxt has no entry point: the whole file is the program, and statements at the top level run in order. So a function called `main` would look like an entry point and not be one — a trap rather than a crash, which is the kind of thing this language refuses. The name is reserved so it cannot be set.",
        probe: "",
        refuses: "",
    });
    return out;
}

// The words recognised only where they appear. `left` is the marker, `right` is what it says.
function contextual_markers() -> [Pair] {
    let mutable out: [Pair] = [];
    push(out, Pair { left: "allocates",
                     right: "This "
                              + "function "
                              + "builds "
                              + "values "
                              + "in "
                              + "its "
                              + "CALLER's "
                              + "region. "
                              + "Optional "
                              + "and "
                              + "inferred "
                              + "since "
                              + "v0.0.142; "
                              + "writing "
                              + "it "
                              + "is "
                              + "still "
                              + "legal "
                              + "and "
                              + "still "
                              + "checked." });
    push(out, Pair { left: "requires",
                     right: "A "
                              + "precondition. "
                              + "Checked, "
                              + "and "
                              + "it "
                              + "names "
                              + "itself "
                              + "when "
                              + "it "
                              + "fails." });
    push(out, Pair { left: "ensures",
                     right: "A "
                              + "postcondition. "
                              + "`result` "
                              + "and "
                              + "`old(...)` "
                              + "are "
                              + "in "
                              + "scope "
                              + "inside "
                              + "one." });
    push(out, Pair { left: "decreases",
                     right: "A "
                              + "measure "
                              + "that "
                              + "must "
                              + "fall "
                              + "on "
                              + "every "
                              + "recursive "
                              + "call, "
                              + "so "
                              + "the "
                              + "recursion "
                              + "ends." });
    push(out, Pair { left: "touches",
                     right: "What "
                              + "the "
                              + "function "
                              + "may "
                              + "reach: "
                              + "`files`, "
                              + "`commands`, "
                              + "`clock`, "
                              + "`input`, "
                              + "`network`, "
                              + "`model`. "
                              + "It "
                              + "travels "
                              + "up "
                              + "the "
                              + "call "
                              + "chain." });
    push(out, Pair { left: "scaled",
                     right: "In "
                              + "`as "
                              + "scaled`, "
                              + "at "
                              + "the "
                              + "C "
                              + "boundary "
                              + "— "
                              + "the "
                              + "only "
                              + "conversion "
                              + "that "
                              + "moves "
                              + "a "
                              + "Decimal "
                              + "across "
                              + "it." });
    push(out, Pair { left: "it",
                     right: "The "
                              + "subject "
                              + "of "
                              + "a "
                              + "contract "
                              + "bracket: "
                              + "`Int "
                              + "[> "
                              + "0, "
                              + "<= "
                              + "it "
                              + "* "
                              + "2]`. "
                              + "Special "
                              + "ONLY "
                              + "inside "
                              + "a "
                              + "bracket." });
    return out;
}

// The tables that are a decision rather than a scrape. Operators, shorthands and runtime failures
// came across from the hand-written page they replace; they describe grammar, which does not have a
// table in the compiler to read.
//
// Each is one Python triple-quoted string, kept as its lines and rejoined, so a row is a line here
// exactly as it is a line there.
function operators_table() -> String {
    let mutable out: [String] = [];
    push(out, "");
    push(out, "| Operator | On | Notes |");
    push(out, "|---|---|---|");
    push(out, "| `+` `-` | Int, Decimal of the SAME scale, String (`+` only) | Scales must match. A rounding contract on one side is carried into the result; two different contracts are refused |");
    push(out, "| `*` | Int, Decimal × Int, Decimal × Decimal | Mixed Decimal scales need a rounding contract |");
    push(out, "| `/` | Decimal only | Always needs a rounding contract. `Int / Int` is refused — use `divide_floor` or `divide_toward_zero` |");
    push(out, "| `==` `!=` | Any two values of the same type | One equality, no coercion. Strings compare by bytes |");
    push(out, "| `<` `<=` `>` `>=` | Int, Decimal | Same type both sides. On String it is refused |");
    push(out, "| `&&` `\\|\\|` | Bool | Short-circuit: the right side runs only if it is needed |");
    push(out, "| `!` | Bool | |");
    push(out, "| unary `-` | Int, Decimal | Checked, like every other arithmetic |");
    push(out, "| `+=` `-=` `*=` | Anything the long form allows | `x += e` IS `x = x + e` by the time it is checked. Works on a name, a field and an array element. There is deliberately no `++` |");
    push(out, "| `?` | `Result<T, E>` | `f(x)?` returns the failure unchanged, or unwraps the success |");
    push(out, "");
    return string_join(out, "\n");
}

function shorthands_table() -> String {
    let mutable out: [String] = [];
    push(out, "");
    push(out, "| Written | Means |");
    push(out, "|---|---|");
    push(out, "| `$19.99` | `19.99` as a `Decimal<2>`. The `$` is documentation, not arithmetic |");
    push(out, "| `8.25%` | `0.0825` as a `Decimal<4>` — a percent is two scales finer than the number it is written as |");
    push(out, "| `\"total: \{amount\}\"` | `\"total: \" + to_string(amount)` — and inside a `print`, the pieces go out in order with nothing built |");
    push(out, "| `x += e` | `x = x + e`. Also `-=` and `*=`, on a name, a field, or `xs[i]` |");
    push(out, "| `P \{ x, y \}` | `P \{ x: x, y: y \}` — a field taking a variable of the same name |");
    push(out, "| `f();` | a call kept for its effect, with no binding |");
    push(out, "| `function (self) m()` | `function (self: Type) m()`, inside a block whose header already said which type |");
    push(out, "| `P \{ x: 1, \}` | a trailing comma, anywhere a list is written, so adding an item is a one-line diff |");
    push(out, "| `let x = e;` | `let x: T = e;` where `T` is `e`'s type. Arrays are the exception — a literal does not say fixed or growable |");
    push(out, "| `for x in xs \{ \}` | `let mutable i = 0; while i < len(xs) \{ let x = xs[i]; … \}` — `xs` must be a name or a field path |");
    push(out, "| `for i in 0..n \{ \}` | `let mutable i = 0; while i < n \{ … \}` — the end is **exclusive**, `i` is immutable, and both bounds are Ints evaluated once. There is no `..=`, and a range is not a value |");
    push(out, "| `f(x)?` | `match f(x) \{ Error(e) => return Error(e), Ok(v) => v \}` — the failure variant found by name, never converted |");
    push(out, "| `Int [> 0, <= n]` | `requires` clauses written on the value instead of under the signature |");
    push(out, "");
    return string_join(out, "\n");
}

function types_table() -> String {
    let mutable out: [String] = [];
    push(out, "");
    push(out, "| Type | What it is |");
    push(out, "|---|---|");
    push(out, "| `Int` | Signed 64-bit. **Traps** on overflow, never wraps |");
    push(out, "| `Bool` | `true` / `false`. No coercion to or from anything |");
    push(out, "| `String` | Bytes, NUL-terminated. `len` counts bytes |");
    push(out, "| `Decimal<S>` | An integer scaled by `10^S`, exact. `S` up to 18 |");
    push(out, "| `Decimal<S, R>` | The same, carrying a rounding contract: `RoundHalfEven` or `RoundHalfUp` |");
    push(out, "| `[T; N]` | Fixed array. The length is part of the type. Bounds always checked |");
    push(out, "| `[T]` | Growable array. Lives in a region. Bounds always checked |");
    push(out, "| `dynamic Named` | An interface object: a value plus the interface's method table |");
    push(out, "| `CInt`, `CDouble` | C's widths. Only in an `external function` signature |");
    push(out, "| `i32`, `u8`, `u32`, `u64` | Sized C integers, boundary-only. A value that does not fit **traps** at the call rather than wrapping. `u64` is checked against `Int`'s signed maximum, because Burxt has no wider integer to receive the top half |");
    push(out, "");
    return string_join(out, "\n");
}

// What a well-typed program can still do. These are not compile errors, and the difference is the
// thing the site keeps having to explain: an overflow is a program that STOPS, not one that is
// refused.
function failures_table() -> String {
    let mutable out: [String] = [];
    push(out, "");
    push(out, "| What happens | When |");
    push(out, "|---|---|");
    push(out, "| `arithmetic overflow — the exact result no longer fits in the value range` | `+` `-` `*` on an `Int` or a `Decimal` past its range |");
    push(out, "| an index out of range | `xs[i]` outside `0 .. len(xs) - 1` |");
    push(out, "| a broken precondition, quoted back with the clause that failed | a `requires` that does not hold at a call |");
    push(out, "| a broken postcondition | an `ensures` that does not hold at a return |");
    push(out, "| a `decreases` measure that did not decrease | a recursion that would not have ended |");
    push(out, "| dividing by zero | `divide_floor`, `divide_toward_zero`, `remainder` |");
    push(out, "| `cannot cross as a C double exactly` | a value going out through `CDouble` that a double cannot hold |");
    push(out, "");
    push(out, "Every one of them ends the program, and every one names itself. Nothing here is a warning, and");
    push(out, "nothing continues with a wrong value.");
    push(out, "");
    return string_join(out, "\n");
}


// ----------------------------------------------------------------------------------------------
// The prose around the tables, verbatim
// ----------------------------------------------------------------------------------------------
//
// One function per paragraph the pages state outright. They are the page's CONTENTS, so a name in
// here is a name on the live site.
//
// **These said `scripts/site-reference.py` until 2026-08-21, deliberately: the port's bar was
// byte-identical output, so the prose kept the old name and the comment here said "whoever retires
// the Python changes them then". The Python is retired — there is no `scripts/*.py` left in the
// tree — so they name this file now.** A byte-identical bar is worth keeping while it is proving a
// port; keeping it afterwards freezes a page that tells a reader to edit a file that is not there.

pure function index_description() -> String {
    return "Every keyword, builtin, operator and standard-library function — read out of the compiler "
            + "rather than from memory.";
}

pure function index_intro() -> String {
    return "Everything the language has. **Read out of the compiler**, not from memory: the keyword table "
            + "below comes from `src/rust-compiler/lexer.rs`, the reserved names from "
            + "`src/rust-compiler/typeck.rs`, the commands from `src/rust-compiler/main.rs`, and every "
            + "standard-library entry from the `//` prose written above the declaration itself. "
            + "`scripts/site-reference.bx` regenerates these pages and a test diffs them, so this cannot fall "
            + "behind the language again — which it had: the page this replaces still listed `record`, a "
            + "keyword renamed eleven versions earlier.\n";
}

pure function index_keywords_note(count: Int) -> String {
    return "The " + to_string(count) + " words the lexer knows. Every one of them is the word it "
            + "means: `function`, not `fn`; `mutable`, not `mut`.\n";
}

pure function index_markers_note() -> String {
    return "Recognised only where they appear — on a signature, inside a clause — so a variable may still "
            + "be called `ensures` anywhere else.\n";
}

pure function index_renamed_note() -> String {
    return "Reserved so the compiler can name the replacement rather than say *unexpected identifier*. Each "
            + "of these is an error that tells you the word to write instead.\n";
}

pure function index_shorthands_note() -> String {
    return "The whole list. Burxt has few on purpose, and each is sugar over something it already means "
            + "rather than a second way to mean it.\n";
}

pure function index_not_present() -> String {
    return "Block comments (`/* … */`) — line comments only, so there is no nesting rule to get wrong. "
            + "Multi-line string literals — a literal spanning lines makes its own indentation part of the "
            + "data, which is the one thing that surprises everybody about them; use `\\n` and `+`. `for i in "
            + "0..n` — a range is a second construct, and `while i < n` says it. `for x in text` — a String is "
            + "bytes, and `byte_at` says BYTE so the byte-versus-character question cannot hide. `x++` — an "
            + "expression with a side effect. `a ? b : c` — `if` as an expression would make it redundant. "
            + "Arrow functions — they are closures, and captured state needs an owner.\n";
}

pure function builtins_description() -> String {
    return "Every call the language owns: what it answers, whether it allocates, and what it refuses.";
}

pure function builtins_intro() -> String {
    return "The names a program may not declare, because the language already means something by them. The "
            + "list comes from `is_reserved_name` in `src/rust-compiler/typeck.rs`; every signature below was "
            + "**compiled** while this page was generated, so none of them is a signature the compiler would "
            + "reject.\n";
}

pure function builtins_allocates_note() -> String {
    return "*Allocates* means the call builds something, and a value has to be built somewhere. **It does "
            + "not mean you write `region`.** Since v0.0.146 a program has one from the moment it starts and "
            + "`allocates` is inferred, so every signature on this page compiles with no `region` in sight — "
            + "the probes that verified them have none. You reach for `region` to release EARLY, around a loop "
            + "body or a request, which is the whole of keeping a long-running program's memory flat. See "
            + "[Memory](../guide/04-memory.html).\n";
}

pure function cli_description() -> String {
    return "Every burxt command, including review and mcp-schema.";
}

pure function cli_intro() -> String {
    return "Read out of the usage block in `src/rust-compiler/main.rs`, so this cannot list a command the "
            + "compiler does not have. Two of them exist nowhere else in programming: `burxt review`, which "
            + "answers what a change did to what a program **promises**, and `burxt mcp-schema`, which derives "
            + "an MCP tool schema from the preconditions so the two cannot drift. Both are explained in [Tools "
            + "and agents](../guide/12-tools-and-agents.html).\n";
}

pure function cli_flags_note() -> String {
    return "Scraped from the same usage block. Flags may be written before or after the file, so `burxt "
            + "build -O0 -g pay.bx -o pay` and `burxt build pay.bx -O0 -g -o pay` are the same command.\n";
}

pure function cli_tail() -> String {
    return "**Everything after a bare `--` goes to the PROGRAM** — `burxt run parse.bx -- document.bmx` — "
            + "which is the only way to hand a compiled program an argument, and `os_args()` in `lib/os.bx` "
            + "reads them without the program's own name in front. Arguments after the source file that are "
            + "not flags go to the linker unchanged, so `burxt run pay.bx cside.o -lm` links the C you call.\n";
}


// ----------------------------------------------------------------------------------------------
// Running the compiler
// ----------------------------------------------------------------------------------------------

// Run the compiler on a program, and hand back everything it said.
//
// The file is named after the builtin rather than `probe.bx`, because the compiler's `-->` line ends
// up on the page and a reader should see `to_string.bx` there rather than the mechanics of this
// program.
//
// `cd` into the scratch directory rather than passing a path, so that the `-->` line names the stem
// and nothing else — a temporary directory in the middle of it would change on every run and make the
// page differ from itself.
function compiler_said(burxt: String, work: String, name: String, source: String) -> Capture
        touches commands, files, input {
    let stem: String = name + ".bx";
    let written: Int = file_write(work + "/" + stem, source);
    return os_capture_status("cd " + file_quote(work) + " && " + file_quote(burxt) + " check "
            + file_quote(stem));
}

// Everything the compiler said, minus its own `compiled X -> Y` line.
//
// The two streams are joined with nothing between them, which is what Python's `stdout + stderr`
// gives: a compiler that stops mid-line leaves its diagnostic on the end of that line.
pure function without_the_compiled_line(spoke: Capture) -> String {
    let lines: [String] = python_lines(spoke.output + spoke.errors);
    let mutable kept: [String] = [];
    for line in lines {
        if !string_starts_with(line, "compiled ") {
            let added: Int = push(kept, line);
        }
    }
    return strip_python(string_join(kept, "\n"));
}

// A Python list of names, spelled the way Python spells one, because both messages below quote it.
pure function as_python_list(names: [String]) -> String {
    return "['" + string_join(names, "', '") + "']";
}

// Compile a use of every builtin, and capture every refusal the page quotes.
//
// This is what makes the signatures above trustworthy rather than remembered. It also holds the two
// lists against each other: a name the compiler reserves and this file does not describe is an
// error, so adding a builtin to the language fails here until the reference knows about it.
//
// `refusals` is filled in step with `all`, one entry per builtin and empty where the page quotes
// nothing. A field on `Builtin` would be the obvious place and cannot be: a class has value
// semantics here, so writing to a copy pulled out of the array would leave the array unchanged.
function verify(root: String, burxt: String, work: String, all: [Builtin],
                mutable refusals: [String]) -> Int touches files, commands, input {
    let mutable described: [String] = [];
    for b in all {
        let added: Int = push(described, b.name);
    }
    // `print`, `print_error` and `print_exact` are KEYWORDS, so the lexer already makes them
    // unusable as
    // identifiers and `is_reserved_name` has no reason to list them. They are still builtins a
    // reader looks up, so they are described.
    let mutable owned: [String] = reserved(root);
    let with_print: Int = push(owned, "print");
    let with_print_error: Int = push(owned, "print_error");
    let with_print_exact: Int = push(owned, "print_exact");

    let mutable unknown: [String] = [];
    for name in owned {
        if !array_contains(described, name) {
            let added: Int = push(unknown, name);
        }
    }
    let ordered_unknown: Int = array_sort(unknown);
    if len(unknown) > 0 {
        die("the compiler reserves these names and scripts/site-reference.bx does not describe "
            + "them: " + as_python_list(unknown) + "\nAdd an entry to `builtins` — a builtin "
            + "missing from the reference is a builtin nobody can look up.");
    }
    let mutable stale: [String] = [];
    for name in described {
        if !array_contains(owned, name) {
            let added: Int = push(stale, name);
        }
    }
    let ordered_stale: Int = array_sort(stale);
    if len(stale) > 0 {
        die("scripts/site-reference.bx describes these and the compiler no longer reserves them: "
            + as_python_list(stale)
            + "\nThe reference would be documenting a language this repository does not have.");
    }

    for b in all {
        if len(b.probe) > 0 {
            let spoke: Capture = compiler_said(burxt, work, b.name, b.probe);
            if spoke.code != 0 {
                die("the signature written for `" + b.name + "` does not compile, so it is wrong:"
                    + "\n\n" + b.probe + "\n" + without_the_compiled_line(spoke));
            }
        }
        let mutable refusal: String = "";
        if len(b.refuses) > 0 {
            let spoke: Capture = compiler_said(burxt, work, b.name, b.refuses);
            if spoke.code == 0 {
                die("`" + b.name + "` was expected to refuse this and did not — the page would "
                    + "claim a limit the compiler does not have:\n\n" + b.refuses);
            }
            refusal = without_the_compiled_line(spoke);
        }
        let added: Int = push(refusals, refusal);
    }
    return len(refusals);
}

// ----------------------------------------------------------------------------------------------
// Rendering
// ----------------------------------------------------------------------------------------------

// The description is QUOTED, and that is not tidiness. `description: Every call the language owns:
// what it answers` has a colon in it, so YAML reads the first half as a key — and Jekyll silently
// dropped the page's whole front matter, shipping the site-wide description as this page's meta tag
// for as long as the page has existed. It renders fine, which is why nobody saw it.
//
// `_config.yml` is the same mistake and is FATAL there: it fails the Pages build outright, which is
// how this was found. `every_front_matter_and_config_is_parseable_yaml` guards both now.
pure function front_matter(title: String, description: String) -> String {
    return "---\nlayout: doc\ntitle: " + title + "\nsection: reference\ndescription: \""
            + description + "\"\n---\n\n";
}

// The id a heading will carry — and it is WRITTEN OUT, not guessed at.
//
// kramdown's own rule deletes underscores rather than turning them into hyphens, so the heading
// `to_string` gets the id `tostring`. Every link on these pages was pointing at `to-string`, which
// exists nowhere: a reader clicking `to_string` in the table of contents would have arrived at the
// top of the page, and search would have done the same. It looks like nothing going wrong, because
// the page does load.
//
// So the generated pages state their ids with an inline attribute list — `\{: #to-string\}` — and
// these are those ids. Nothing here depends on reproducing kramdown's algorithm.
//
// `re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")`, and every name it is given is ASCII.
pure function anchor(name: String) -> String {
    let lower: String = string_to_lower_ascii(name);
    let stop: Int = len(lower);
    let mutable pieces: [String] = [];
    let mutable i: Int = 0;
    while i < stop {
        let byte: Int = byte_at(lower, i);
        if string_is_lower(byte) || string_is_digit(byte) {
            let added: Int = push(pieces, substring(lower, i, 1));
            i += 1;
        } else {
            let added: Int = push(pieces, "-");
            while i < stop && !string_is_lower(byte_at(lower, i))
                    && !string_is_digit(byte_at(lower, i)) {
                i += 1;
            }
        }
    }
    // `.strip("-")`
    let joined: String = string_join_chunks(pieces);
    let end: Int = len(joined);
    let mutable from: Int = 0;
    while from < end && byte_at(joined, from) == 45 {
        from += 1;
    }
    let mutable to: Int = end;
    while to > from && byte_at(joined, to - 1) == 45 {
        to -= 1;
    }
    return substring(joined, from, to - from);
}

// A heading that CARRIES its id, so the anchor is a fact rather than a prediction.
pure function heading(level: Int, text: String, ident: String) -> String {
    return string_repeat("#", level) + " " + text + "\n\{: #" + ident + "\}\n";
}

pure function signature_block(signature: String) -> String {
    return "```burxt\n" + signature + "\n```";
}

// A banner line like `absence, made explicit` as a sentence.
//
// `text[0].upper()` uppercases the first CHARACTER, and every module title starts with an ASCII
// letter today; a title opening with anything else is left alone rather than half-converted.
pure function sentence(text: String) -> String {
    let mutable trimmed: String = strip_python(text);
    let mutable to: Int = len(trimmed);
    while to > 0 && byte_at(trimmed, to - 1) == 46 {                 // `.rstrip(".")`
        to -= 1;
    }
    let body: String = substring(trimmed, 0, to);
    if len(body) == 0 {
        return "";
    }
    let opening: Int = byte_at(body, 0);
    let mutable head: String = substring(body, 0, 1);
    if string_is_lower(opening) {
        head = string_to_upper_ascii(head);
    }
    return head + substring(body, 1, len(body) - 1) + ".";
}

// The module titles, so the index can say what each page is about. `MODULE_TITLES` in the Python,
// which is a module-level dict filled by `build` — a lookup here, over thirty entries.
pure function title_for(mods: [Module], name: String) -> String {
    for mod in mods {
        if mod.name == name {
            return mod.title;
        }
    }
    return "";
}

// The reference index.
function render_index(kw: [String], ren: [Pair], cmds: [Command], all: [Builtin], mods: [Module],
                      names: [String]) -> String {
    let mutable out: [String] = [];
    let head: Int = push(out, front_matter("Reference", index_description()));
    let title: Int = push(out, "# Reference\n");
    let intro: Int = push(out, index_intro());
    let opened: Int = push(out, "<ul class=\"pages\">");
    let builtins_row: Int = push(out, "<li><a href=\"builtins.html\"><span>Builtins</span> "
            + "<span class=\"what\">" + to_string(len(all))
            + " calls the language owns, and what each needs</span></a></li>");
    let cli_row: Int = push(out, "<li><a href=\"cli.html\"><span>The command line</span> "
            + "<span class=\"what\">" + to_string(len(cmds))
            + " commands, including <code>review</code> and "
            + "<code>mcp-schema</code></span></a></li>");
    for name in names {
        let row: Int = push(out, "<li><a href=\"" + name + ".html\"><span><code>lib/" + name
                + ".bx</code></span> <span class=\"what\">" + title_for(mods, name)
                + "</span></a></li>");
    }
    // Documented elsewhere, listed after the modules rather than inside them: this is a list of
    // what Burxt CONTAINS, and neither of these is contained. BMX is a specification Burxt
    // implements; star-burxt is a package a program depends on, the same as anybody else's.
    //
    // They are here anyway because a reader looking for "how do I build a page" comes to the
    // reference index first, and a list that answers "not here" by saying nothing is a list that
    // sends them away.
    //
    // Carrying their WORDMARKS rather than their names, because the mark says something the name
    // cannot: the `b` in each one is Burxt's own logo standing in for the letter — `[b]mx`,
    // `star-[b]` — so a reader seeing them beside `lib/` entries reads "related to this" without
    // being told. The bare `b` stays Burxt's alone; their file-type icons (a document, a gear) are
    // a different job and live in `assets/subprojects/`.
    let bmx: Int = push(out, "<li><a href=\"https://bmx.burxt-lang.org/\">"
            + "<span><img class=\"eco-mark\" src=\"../assets/bmx-wordmark.svg\" alt=\"BMX\"></span> "
            + "<span class=\"what\">the markup format — its own guide, spec and conformance "
            + "suite</span></a></li>");
    let star: Int = push(out, "<li><a href=\"https://star.burxt-lang.org/\">"
            + "<span><img class=\"eco-mark\" src=\"../assets/starb-wordmark.svg\" alt=\"star-burxt\">"
            + "</span> <span class=\"what\">a front-end framework written in Burxt — a package you "
            + "depend on, not part of the library</span></a></li>");
    let closed: Int = push(out, "</ul>\n");

    let keywords_head: Int = push(out, "## Keywords\n");
    let keywords_note: Int = push(out, index_keywords_note(len(kw)));
    let mutable rows: [String] = [];
    let bare: Int = push(rows, "| | | | |");
    let rule: Int = push(rows, "|---|---|---|---|");
    let mutable i: Int = 0;
    while i < len(kw) {
        let mutable cells: [String] = [];
        let mutable k: Int = 0;
        while k < 4 {
            if i + k < len(kw) {
                let added: Int = push(cells, "`" + kw[i + k] + "`");
            } else {
                let added: Int = push(cells, "");
            }
            k += 1;
        }
        let row: Int = push(rows, "| " + string_join(cells, " | ") + " |");
        i += 4;
    }
    let table: Int = push(out, string_join(rows, "\n") + "\n");

    let markers_head: Int = push(out, "## Contextual markers\n");
    let markers_note: Int = push(out, index_markers_note());
    let mutable marker_rows: [String] = [];
    let marker_head: Int = push(marker_rows, "| Marker | What it says |");
    let marker_rule: Int = push(marker_rows, "|---|---|");
    let markers: [Pair] = contextual_markers();
    for marker in markers {
        let row: Int = push(marker_rows, "| `" + marker.left + "` | " + marker.right + " |");
    }
    let marker_table: Int = push(out, string_join(marker_rows, "\n") + "\n");

    let renamed_head: Int = push(out, "## Spellings that do not compile\n");
    let renamed_note: Int = push(out, index_renamed_note());
    let mutable renamed_rows: [String] = [];
    let renamed_top: Int = push(renamed_rows, "| Written | Burxt spells it |");
    let renamed_rule: Int = push(renamed_rows, "|---|---|");
    for pair in ren {
        let row: Int = push(renamed_rows, "| `" + pair.left + "` | `" + pair.right + "` |");
    }
    let renamed_table: Int = push(out, string_join(renamed_rows, "\n") + "\n");

    let types: Int = push(out, "## Types\n" + types_table());
    let operators: Int = push(out, "## Operators\n" + operators_table());
    let shorthands_head: Int = push(out, "## Shorthands\n");
    let shorthands: Int = push(out, index_shorthands_note() + shorthands_table());
    let failures: Int = push(out, "## What stops a running program\n" + failures_table());

    let absent_head: Int = push(out, "## Not present, each for a reason\n");
    let absent: Int = push(out, index_not_present());
    return string_join(out, "\n") + "\n";
}

// The builtins page.
function render_builtins(all: [Builtin], refusals: [String], effects: [Pair]) -> String {
    let mutable out: [String] = [];
    let head: Int = push(out, front_matter("Builtins", builtins_description()));
    let title: Int = push(out, "# Builtins\n");
    let intro: Int = push(out, builtins_intro());
    let mutable rows: [String] = [];
    let top: Int = push(rows, "| Call | Answers | Allocates? | Reaches |");
    let rule: Int = push(rows, "|---|---|---|---|");
    for b in all {
        let effect: String = effect_of(effects, b.name);
        let mutable allocates: String = "no";
        if b.allocates {
            allocates = "**yes**";
        }
        let mutable reaches: String = "—";
        if len(effect) > 0 {
            reaches = "`touches " + effect + "`";
        }
        let row: Int = push(rows, "| [`" + b.name + "`](#" + anchor(b.name) + ") | " + b.answers
                + " | " + allocates + " | " + reaches + " |");
    }
    let table: Int = push(out, string_join(rows, "\n") + "\n");
    let note: Int = push(out, builtins_allocates_note());

    let mutable n: Int = 0;
    while n < len(all) {
        let b: Builtin = all[n];
        let head_row: Int = push(out, heading(2, "`" + b.name + "`", anchor(b.name)));
        let signature: Int = push(out, signature_block(b.signature));
        let blank: Int = push(out, "");
        let doc: Int = push(out, b.doc + "\n");
        let mutable facts: [String] = [];
        let answers: Int = push(facts, "**Answers** " + b.answers + ".");
        let mutable allocates: String = "no";
        if b.allocates {
            allocates = "yes";
        }
        let allocation: Int = push(facts, "**Allocates:** " + allocates + ".");
        let effect: String = effect_of(effects, b.name);
        if len(effect) > 0 {
            let carries: Int = push(facts, "**Carries** `touches " + effect
                    + "`, so a caller must declare it.");
        }
        let stated: Int = push(out, string_join(facts, " ") + "\n");
        if len(refusals[n]) > 0 {
            let lead: Int = push(out, "It refuses this:\n");
            let program: Int = push(out, "```burxt\n" + b.refuses + "```\n");
            let said: Int = push(out, "```\n" + refusals[n] + "\n```\n");
        }
        n += 1;
    }
    return string_join(out, "\n") + "\n";
}

// The command-line page.
function render_cli(cmds: [Command], flgs: [Pair]) -> String {
    let mutable out: [String] = [];
    let head: Int = push(out, front_matter("The command line", cli_description()));
    let title: Int = push(out, "# The command line\n");
    let intro: Int = push(out, cli_intro());
    let mutable rows: [String] = [];
    let top: Int = push(rows, "| Command | Takes | What it does |");
    let rule: Int = push(rows, "|---|---|---|");
    for row in cmds {
        let mutable takes: String = "—";
        if len(row.takes) > 0 {
            takes = "`" + row.takes + "`";
        }
        let added: Int = push(rows, "| `burxt " + row.name + "` | " + takes + " | " + row.what
                + " |");
    }
    let table: Int = push(out, string_join(rows, "\n") + "\n");
    let flags_head: Int = push(out, "## Flags\n");
    let flags_note: Int = push(out, cli_flags_note());
    let mutable flag_rows: [String] = [];
    let flag_top: Int = push(flag_rows, "| Flag | What it does |");
    let flag_rule: Int = push(flag_rows, "|---|---|");
    for flag in flgs {
        let added: Int = push(flag_rows, "| `" + flag.left + "` | " + flag.right + " |");
    }
    let flag_table: Int = push(out, string_join(flag_rows, "\n") + "\n");
    let closing: Int = push(out, cli_tail());
    return string_join(out, "\n") + "\n";
}

// One standard-library module's page.
function render_module(mod: Module) -> String {
    let mutable out: [String] = [];
    let head: Int = push(out, front_matter("lib/" + mod.name + ".bx", sentence(mod.title)));
    let title: Int = push(out, "# `lib/" + mod.name + ".bx`\n");
    let says: Int = push(out, sentence(mod.title) + "\n");
    let use_line: Int = push(out, "```burxt\nuse \"lib/" + mod.name + ".bx\";\n```\n");
    // A module that implements a format specified elsewhere points at that documentation FIRST.
    // This page is generated from the source and answers "what functions are there"; it cannot
    // answer "how do I write a document", and a reader who lands here looking for the second
    // should not have to find out that it lives somewhere else.
    if len(mod.blurb) > 0 {
        let blurb: Int = push(out, mod.blurb + "\n");
    }

    let mutable functions: [Symbol] = [];
    let mutable methods: [Symbol] = [];
    let mutable types: [Symbol] = [];
    for s in mod.symbols {
        if s.kind == "function" {
            let added: Int = push(functions, s);
        } else if s.kind == "method" {
            let added: Int = push(methods, s);
        } else {
            let added: Int = push(types, s);
        }
    }

    let contents: Int = push(out, heading(2, "What is in it", "what-is-in-it"));
    let mutable rows: [String] = [];
    let top: Int = push(rows, "| Name | Kind | What it answers |");
    let rule: Int = push(rows, "|---|---|---|");
    let mutable listed: [Symbol] = [];
    for s in types {
        let added: Int = push(listed, s);
    }
    for s in functions {
        let added: Int = push(listed, s);
    }
    for s in methods {
        let added: Int = push(listed, s);
    }
    for s in listed {
        let mutable first: String = "";
        if len(s.doc) > 0 {
            first = strip_python(before_first(s.doc, "\n\n"));
        }
        if string_starts_with(first, "```") {
            first = "";
        }
        let mutable shown: String = take_chars(first, 120);
        if len(shown) == 0 {
            shown = "—";
        }
        let mutable kind: String = s.kind;
        if s.kind == "method" {
            kind = "method on `" + before_first(s.receiver, "<") + "`";
        }
        let added: Int = push(rows, "| [`" + s.name + "`](#" + anchor(s.name) + ") | " + kind
                + " | " + shown + " |");
    }
    let table: Int = push(out, string_join(rows, "\n") + "\n");

    let mutable labels: [String] = [];
    let a: Int = push(labels, "Types");
    let b: Int = push(labels, "Functions");
    let c: Int = push(labels, "Methods");
    let mutable at: Int = 0;
    while at < len(labels) {
        let mutable group: [Symbol] = [];
        if at == 0 {
            group = types;
        } else if at == 1 {
            group = functions;
        } else {
            group = methods;
        }
        if len(group) > 0 {
            let head_row: Int = push(out, heading(2, labels[at], anchor(labels[at])));
            for s in group {
                let name_row: Int = push(out, heading(3, "`" + s.name + "`", anchor(s.name)));
                let signature: Int = push(out, signature_block(s.signature));
                let blank: Int = push(out, "");
                if len(s.doc) > 0 {
                    let doc: Int = push(out, s.doc + "\n");
                }
                if s.kind == "method" && s.mutates {
                    let note: Int = push(out,
                        "Takes `mutable self`, so it changes the value it is called on.\n");
                }
                let source: Int = push(out, "[Source](" + github() + "/" + mod.path + "#L"
                        + to_string(s.line) + ")\n");
            }
        }
        at += 1;
    }
    return string_join(out, "\n") + "\n";
}

// ----------------------------------------------------------------------------------------------
// The search index
// ----------------------------------------------------------------------------------------------
//
// **These four functions are `json.dumps`, and they exist because non-ASCII has to leave as
// `\uXXXX`.** `json_escape` in `lib/json.bx` writes the six escapes JSON requires and passes an em
// dash through as its three UTF-8 bytes, which is correct JSON and a different file — Python's
// `ensure_ascii` defaults to true, so the committed index holds thirteen `—`, and a version that
// let them through would rewrite the file it is supposed to be diffed against.
//
// `scripts/site-examples.bx` needed the same four for the same reason and has its own copy. That is
// two copies of an escaper, which is one more than there should be; they are not shared today because
// that program has a top-level `region` and cannot be `use`d. The right home is a third module beside
// `nav-headings.bx`, and it is a gap rather than a decision.

// The codepoint whose UTF-8 sequence STARTS at byte `at`.
//
// `codepoint_at` in the standard library takes a codepoint index and walks to it, so calling it once
// per character is O(n²). This is the same decode against a byte offset the caller already has.
pure function codepoint_from(text: String, at: Int) -> Int {
    let ending: Int = next_char(text, at);
    let width: Int = ending - at;
    let leading: Int = byte_at(text, at);
    if width == 1 {
        return leading;
    }
    if width == 2 {
        return shift_left(bit_and(leading, 31), 6)
                + bit_and(byte_at(text, at + 1), 63);
    }
    if width == 3 {
        return shift_left(bit_and(leading, 15), 12)
                + shift_left(bit_and(byte_at(text, at + 1), 63), 6)
                + bit_and(byte_at(text, at + 2), 63);
    }
    return shift_left(bit_and(leading, 7), 18)
            + shift_left(bit_and(byte_at(text, at + 1), 63), 12)
            + shift_left(bit_and(byte_at(text, at + 2), 63), 6)
            + bit_and(byte_at(text, at + 3), 63);
}

pure function unicode_escape(code: Int) -> String {
    return "\\u" + string_pad_start(string_int_to_hex(code), 4, "0");
}

// A String as a JSON string body with no byte above 126 left in it. A codepoint above the basic
// plane becomes a SURROGATE PAIR, because that is what a JSON escape can express and nothing in the
// format can name U+1F600 in one.
//
// Built in RUNS, like `json_escape` in `lib/json.bx` and for the same measured reason: appending one
// byte at a time to a String copies the whole String each time.
pure function json_ascii(text: String) -> String {
    let mutable pieces: [String] = [];
    let mutable copied: Int = 0;
    let mutable i: Int = 0;
    let n: Int = len(text);
    while i < n {
        let b: Int = byte_at(text, i);
        let ending: Int = next_char(text, i);
        let mutable escape: String = "";
        if b == 34 {
            escape = "\\\"";
        } else if b == 92 {
            escape = "\\\\";
        } else if b == 10 {
            escape = "\\n";
        } else if b == 13 {
            escape = "\\r";
        } else if b == 9 {
            escape = "\\t";
        } else if b == 8 {
            escape = "\\b";
        } else if b == 12 {
            escape = "\\f";
        } else if b < 32 || b > 126 {
            let code: Int = codepoint_from(text, i);
            if code > 65535 {
                let rest: Int = code - 65536;
                escape = unicode_escape(55296 + shift_right_zeros(rest, 10))
                        + unicode_escape(56320 + bit_and(rest, 1023));
            } else {
                escape = unicode_escape(code);
            }
        }
        if len(escape) > 0 {
            let head: Int = push(pieces, substring(text, copied, i - copied));
            let added: Int = push(pieces, escape);
            copied = ending;
        }
        i = ending;
    }
    let last: Int = push(pieces, substring(text, copied, n - copied));
    return string_join_chunks(pieces);
}

pure function json_quoted(text: String) -> String {
    return "\"" + json_ascii(text) + "\"";
}

// The index as `json.dumps(items, indent=1, sort_keys=True)` writes it: one space of indent per
// level, `": "` between a name and its value, and the five keys in alphabetical order — which is
// what `sort_keys` means and why they are not in the order a reader would put them.
pure function search_json(items: [Item]) -> String {
    if len(items) == 0 {
        return "[]";
    }
    let mutable pieces: [String] = [];
    let opened: Int = push(pieces, "[");
    let mutable i: Int = 0;
    while i < len(items) {
        let item: Item = items[i];
        let open_row: Int = push(pieces, "\n \{");
        let kind: Int = push(pieces, "\n  \"kind\": " + json_quoted(item.kind) + ",");
        let name: Int = push(pieces, "\n  \"name\": " + json_quoted(item.name) + ",");
        let text: Int = push(pieces, "\n  \"text\": " + json_quoted(item.text) + ",");
        let url: Int = push(pieces, "\n  \"url\": " + json_quoted(item.url) + ",");
        let where: Int = push(pieces, "\n  \"where\": " + json_quoted(item.where));
        let mutable close_row: String = "\n \}";
        if i + 1 < len(items) {
            close_row = "\n \},";
        }
        let closed: Int = push(pieces, close_row);
        i += 1;
    }
    let ended: Int = push(pieces, "\n]");
    return string_join_chunks(pieces);
}

// One row per thing anyone would type. `to_str` has to reach `to_string`, which is the specific
// complaint this whole page set answers.
function search_items(root: String, all: [Builtin], cmds: [Command], mods: [Module], kw: [String],
                      ren: [Pair]) -> [Item] touches files, commands, input {
    let mutable items: [Item] = [];
    for b in all {
        let added: Int = push(items, Item {
            name: b.name,
            kind: "builtin",
            url: "/reference/builtins.html#" + anchor(b.name),
            where: b.signature,
            text: b.answers,
        });
    }
    for row in cmds {
        let added: Int = push(items, Item {
            name: "burxt " + row.name,
            kind: "command",
            url: "/reference/cli.html",
            where: row.what,
            text: row.takes,
        });
    }
    for mod in mods {
        for s in mod.symbols {
            let added: Int = push(items, Item {
                name: s.name,
                kind: s.kind,
                url: "/reference/" + mod.name + ".html#" + anchor(s.name),
                where: s.signature,
                text: "lib/" + mod.name + ".bx",
            });
        }
    }
    for word in kw {
        let added: Int = push(items, Item {
            name: word,
            kind: "keyword",
            url: "/reference/#keywords",
            where: "keyword",
            text: "",
        });
    }
    for pair in ren {
        let added: Int = push(items, Item {
            name: pair.left,
            kind: "refused",
            url: "/reference/#spellings-that-do-not-compile",
            where: "Burxt spells this `" + pair.right + "`",
            text: "",
        });
    }
    let markers: [Pair] = contextual_markers();
    for marker in markers {
        let added: Int = push(items, Item {
            name: marker.left,
            kind: "marker",
            url: "/reference/#contextual-markers",
            where: take_chars(marker.right, 90),
            text: "",
        });
    }
    // Every guide heading, so search reaches the prose too. The ids come from the sidebar
    // generator's `headings`, so a search hit and a sidebar entry always point at the same place.
    let guide: String = root + "/docs/guide";
    let mutable pages: [String] = [];
    match file_list_directory(guide) {
        Some(names) => {
            for name in names {
                if is_numbered_guide_page(name) {
                    let added: Int = push(pages, name);
                }
            }
        }
        None => {
            die("there is no docs/guide to read the guide headings out of");
        }
    }
    let ordered: Int = array_sort(pages);
    for page in pages {
        let path: String = guide + "/" + page;
        let title: String = label(title_of(path));
        let mutable texts: [String] = [];
        let mutable ids: [String] = [];
        let found: Int = headings(path, texts, ids);
        let mutable i: Int = 0;
        while i < len(texts) {
            let added: Int = push(items, Item {
                name: label(texts[i]),
                kind: "guide",
                url: "/guide/" + substring(page, 0, len(page) - 3) + ".html#" + ids[i],
                where: title,
                text: "",
            });
            i += 1;
        }
    }
    return items;
}

// ----------------------------------------------------------------------------------------------
// The run
// ----------------------------------------------------------------------------------------------

// **Jekyll reads `\{\{` and `\{%` in the page body as Liquid, and a library that DOCUMENTS those
// characters takes the whole site build down.** It happened: `lib/bmx.bx`'s header says
// `` `\{\{ x` is an error, not text `` — describing BMX's own slot syntax — and the Pages build died
// with `Liquid syntax error (line 13): Variable '\{\{ x` ... ` on a page nobody had written by
// hand. Local `cargo test` cannot see it; there is no Ruby here, so Jekyll only ever runs on
// the remote, and the first symptom is a site that silently stops updating.
//
// Fixed at the EMITTER rather than in the one page, because the next library to mention a
// brace would reintroduce it — and because a generated file is the wrong place to keep a fix.
// These pages contain no intentional Liquid (checked), so wrapping each body in `\{% raw %\}`
// costs nothing. Front matter must stay outside it, and kramdown still runs inside: `raw`
// suppresses Liquid only, so `\{: #anchor\}` attribute lists are unaffected.
pure function page_of(name: String, text: String) -> Page {
    // `head, _, body = text.partition("---\n\n")`, which hands back the whole string and two empties
    // when the separator is absent.
    let at: Int = string_find(text, "---\n\n");
    let mutable head: String = text;
    let mutable body: String = "";
    if at >= 0 {
        head = substring(text, 0, at);
        body = substring(text, at + 5, len(text) - at - 5);
    }
    return Page { name: name, text: head + "---\n\n\{% raw %\}\n" + body + "\n\{% endraw %\}\n" };
}

// A scratch directory, or a refusal. `tempfile.mkdtemp(prefix="burxt-reference-")`, and
// `file_temp_directory` already puts `burxt-` in front of what it is given.
function scratch(prefix: String) -> String touches files, input {
    match file_temp_directory(prefix) {
        None => {
            die("cannot make a scratch directory for " + prefix);
            return "";
        }
        Some(directory) => {
            return directory;
        }
    }
}

// `BURXT` in the environment wins, so the test suite can hand over whatever profile cargo built.
// Falling back to the release build is right for a human typing this by hand. The same lesson
// `scripts/site-examples.bx` records: a release-only default meant this silently skipped in CI,
// which builds debug, for thirteen versions.
//
// An empty `BURXT` counts as absent, which is Python's `os.environ.get("BURXT") or …`: a variable
// exported without a value is a variable somebody meant to set, and honouring `""` would look for a
// compiler called nothing.
function compiler_path(root: String) -> String touches input {
    match os_env("BURXT") {
        None => {
            return path_join(root, "target/release/burxt");
        }
        Some(given) => {
            if len(given) == 0 {
                return path_join(root, "target/release/burxt");
            }
            return given;
        }
    }
}

pure function wants_check(args: [String]) -> Bool {
    let mutable i: Int = 0;
    while i < len(args) {
        if args[i] == "--check" {
            return true;
        }
        i += 1;
    }
    return false;
}

region site_reference {
    let root: String = repository_root();
    let burxt: String = compiler_path(root);
    if !file_exists(burxt) {
        die("build the compiler first: cargo build --release  (or set BURXT=<path>)");
    }

    let kw: [String] = keywords(root);
    let ren: [Pair] = renamed(root);
    let block: String = usage_block(root);
    let cmds: [Command] = commands(block);
    let effects: [Pair] = builtin_effects(root);

    // `use "lib/…"` resolves relative to the file, so the library has to travel with the probes.
    // A failure here is swallowed, exactly as the Python swallows `OSError`: no probe uses `use`
    // today, and a scratch directory that cannot hold a symlink is not a reason to stop.
    let work: String = scratch("reference");
    let linked: Int = os_run("ln -s " + file_quote(root + "/lib") + " " + file_quote(work + "/lib")
            + " 2>/dev/null");

    let all: [Builtin] = builtins();
    let mutable refusals: [String] = [];
    let verified: Int = verify(root, burxt, work, all, refusals);

    let names: [String] = library_modules();
    let mutable mods: [Module] = [];
    for name in names {
        let added: Int = push(mods, module_of(root, name));
    }

    // `index.md` first, because the Python's dict is built with it first and `--check` names the
    // stale pages in that order. Its list needs every module's title, so it is RENDERED after the
    // modules are read — which is what the Python's `pages["index.md"] = …` at the end is for.
    let mutable pages: [Page] = [];
    let index_page: Int = push(pages,
            page_of("index.md", render_index(kw, ren, cmds, all, mods, names)));
    let builtins_page: Int = push(pages,
            page_of("builtins.md", render_builtins(all, refusals, effects)));
    let cli_page: Int = push(pages, page_of("cli.md", render_cli(cmds, flags(block))));
    for mod in mods {
        let added: Int = push(pages, page_of(mod.name + ".md", render_module(mod)));
    }

    let items: [Item] = search_items(root, all, cmds, mods, kw, ren);
    let index: String = search_json(items) + "\n";
    let search_path: String = root + "/docs/assets/search.json";

    if wants_check(os_args()) {
        let mutable bad: [String] = [];
        for page in pages {
            let path: String = root + "/docs/reference/" + page.name;
            let mutable on_disk: String = "";
            if file_exists(path) {
                on_disk = file_read(path);
            }
            if on_disk != page.text {
                let added: Int = push(bad, "docs/reference/" + page.name);
            }
        }
        let mutable on_disk: String = "";
        if file_exists(search_path) {
            on_disk = file_read(search_path);
        }
        if on_disk != index {
            let added: Int = push(bad, "docs/assets/search.json");
        }
        if len(bad) > 0 {
            die("out of date: " + string_join(bad, ", ")
                + " — run: burxt run scripts/site-reference.bx");
        }
        print("docs/reference/ is current (" + to_string(len(pages)) + " pages, "
            + to_string(len(items)) + " search entries)");
    } else {
        let made: Bool = file_make_directory(root + "/docs/reference");
        for page in pages {
            let written: Int = file_write(root + "/docs/reference/" + page.name, page.text);
        }
        let written: Int = file_write(search_path, index);
        print("wrote docs/reference/ (" + to_string(len(pages))
            + " pages) and docs/assets/search.json (" + to_string(len(items)) + " entries)");
    }
}
